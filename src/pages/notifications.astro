---
import PageHeader from "../ui/components/PageHeader.astro";
import { actions } from 'astro:actions';
import AppLayout from '../ui/layouts/AppLayout.astro';
import ProviderUnavailableState from '../ui/components/feedback/ProviderUnavailableState.astro';
import Pagination from '../ui/components/data/Pagination.astro';
import AppliedFilters from '../ui/components/data/AppliedFilters.astro';
import { NotificationService } from '../shared/notifications/notification-service.js';
import { notificationDependencies } from '../shared/notifications/notification-dependencies.js';
import { notificationDestination } from '../shared/notifications/notification-destination.js';
import { formatDateTime } from '../shared/copy/format.js';
import { AppError } from '../shared/errors/app-error.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fnotifications');
const actionResult = Astro.getActionResult(actions.notifications.markOwnRead);
if (actionResult?.data?.ok)
  return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 303);
const markReadError = actionResult?.data && !actionResult.data.ok ? actionResult.data : undefined;
const unclassifiedActionError = actionResult?.error ? 'The service did not confirm whether this notification changed. Refresh the register before deciding whether to retry.' : undefined;
const unreadOnly = Astro.url.searchParams.get('unread') === '1';
const rawPage = Astro.url.searchParams.get('page') ?? '1';
const requestedPage = /^\d+$/.test(rawPage) ? Number(rawPage) : Number.NaN;
let result: Awaited<ReturnType<NotificationService['listOwnPage']>> | undefined;
let providerUnavailable = false;
let accessDenied = false;
let invalidPage = !Number.isSafeInteger(requestedPage) || requestedPage < 1;
if (!invalidPage) {
  try {
    result = await notificationDependencies().listOwn.listOwnPage(actor, unreadOnly, requestedPage);
  } catch (error) {
    if (error instanceof AppError && error.category === 'AUTHORIZATION') accessDenied = true;
    else if (error instanceof AppError && error.code === 'VALIDATION_INVALID_QUERY') invalidPage = true;
    else providerUnavailable = true;
  }
}
const notifications = result?.items ?? [];
const totalPages = Math.max(1, Math.ceil((result?.total ?? 0) / (result?.pageSize ?? 50)));
const currentPage = result?.page ?? 1;
const pageLabel = result && result.total > 0
  ? `Showing ${(currentPage - 1) * result.pageSize + 1}–${Math.min(currentPage * result.pageSize, result.total)} of ${result.total} notifications${unreadOnly ? ' that are unread' : ''}. Up to ${result.pageSize} are shown per page.`
  : '';
const pageBase = `/notifications${unreadOnly ? '?unread=1' : ''}`;
const markReadMessage = (reason: string) => reason === 'missing'
  ? 'This notification is no longer available or is not addressed to this account. Refresh the register to see the current list.'
  : reason === 'denied'
    ? 'Your account cannot change this notification. It was not changed.'
  : reason === 'provider'
    ? 'The notification service did not confirm the change. Refresh the register before trying again.'
    : reason === 'stale'
      ? 'This notification changed before the request finished. Refresh the register and review its current read state.'
    : 'The service did not confirm whether this notification changed. Refresh the register before deciding whether to retry.';
---
<AppLayout title="Notifications · QC Operations" locale="en" direction="ltr">
  <PageHeader title="Notifications" purpose="Only notifications addressed to your authenticated account are shown." />
  <!-- Source-bound UI: READ uses listOwnPage and its denied/unavailable/invalid/empty branches.
       FILTER uses the existing unread=1 links, resets page, and preserves unread in Pagination.
       READ pending is the server navigation; no client read state is simulated.
       EXPORT N/A: no export action or destination exists on this page.
       AUTH is the existing actor redirect / service permission denial, not a new control. -->
  <section class="notification-filters" aria-labelledby="notification-filters-title">
    <h2 id="notification-filters-title">Read state</h2>
    <nav aria-label="Notification filters" class="notif-filters">
      <a href="/notifications" aria-current={unreadOnly ? undefined : 'page'}>All</a>
      <a href="/notifications?unread=1" aria-current={unreadOnly ? 'page' : undefined}>Unread</a>
    </nav>
    <AppliedFilters
      filters={unreadOnly ? [{ label: 'Read state', value: 'Unread', href: '/notifications' }] : []}
      note="All notifications addressed to this account."
    />
  </section>
  <p id="mark-read-status" class="action-status" role={markReadError || unclassifiedActionError ? 'alert' : 'status'} aria-live="polite" aria-atomic="true" tabindex="-1">{markReadError ? markReadMessage(markReadError.reason) : unclassifiedActionError}</p>
  {providerUnavailable ? <ProviderUnavailableState title="Notifications are temporarily unavailable" description="The notification source did not confirm a result. No empty state or count is shown; refresh when the service is available." retryHref={Astro.url.pathname + Astro.url.search} /> : accessDenied ? <section class="empty" role="alert"><h2>Notifications are unavailable for this account</h2><p>Your account cannot read this notification register. Contact your administrator if you need access.</p></section> : invalidPage ? <section class="empty" role="alert"><h2>This page number is not valid</h2><p>Open the first page of the notification register to continue.</p><a href={pageBase}>Open page 1</a></section> : <section class="notification-register" aria-labelledby="notification-register-title">
    <div class="register-heading">
      <h2 id="notification-register-title">{unreadOnly ? 'Unread notifications' : 'All notifications'}</h2>
      <p id="notification-count" class="bounded-label" role="status" aria-live="polite">{result?.total === 0 ? (unreadOnly ? 'No unread notifications. Your notifications are still available in All notifications.' : 'No notifications have been sent to this account.') : pageLabel}</p>
    </div>
    {notifications.length ? <div class="table-scroll" role="region" aria-labelledby="notification-register-title" tabindex="0">
      <table class="notifications" aria-describedby="notification-count">
        <caption class="sr-only">Notifications addressed to your authenticated account</caption>
        <thead><tr><th scope="col">Notification</th><th scope="col">Severity</th><th scope="col">Received</th><th scope="col">Read state</th><th scope="col">Action</th></tr></thead>
        <tbody>{notifications.map((notification) => <tr class:list={{ unread: !notification.readAt }}>
          <th scope="row" class="notification-content">
            <a class="destination" href={notificationDestination(notification.subjectType, notification.subjectId)}>{notification.title}</a>
            <p class="notification-message">{notification.message}</p>
          </th>
          <td><span class="severity-label"><span class={`severity ${notification.severity.toLowerCase()}`} aria-hidden="true"></span>{notification.severity}</span></td>
          <td class="received">{formatDateTime(notification.createdAt)}</td>
          <td><span class="read-state">{notification.readAt ? 'Read' : 'Unread'}</span></td>
          <td>{!notification.readAt && <form class="read-form" method="POST" action={actions.notifications.markOwnRead} data-mark-read>
            <input type="hidden" name="notificationId" value={notification.id} />
            <button type="submit" aria-describedby="mark-read-status">Mark as read<span class="sr-only">: {notification.title}</span></button>
          </form>}</td>
        </tr>)}</tbody>
      </table>
    </div> : null}
    {result && result.total > result.pageSize && <Pagination page={result.page} totalPages={totalPages} total={result.total} itemLabel={unreadOnly ? 'unread notifications' : 'notifications'} baseUrl="/notifications" />}
  </section>}

</AppLayout>
<script>
  import { actions } from 'astro:actions';
  document.querySelectorAll<HTMLFormElement>('[data-mark-read]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.getAttribute('aria-busy') === 'true') return;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = document.getElementById('mark-read-status');
      const formData = new FormData(form);
      form.setAttribute('aria-busy', 'true');
      if (button) button.disabled = true;
      if (status) {
        status.setAttribute('role', 'status');
        status.textContent = 'Marking this notification as read…';
      }
      try {
        const result = await actions.notifications.markOwnRead(formData);
        if (result.data?.ok) {
          window.location.reload();
          return;
        }
        const reason = result.data?.reason;
        status?.setAttribute('role', 'alert');
        if (status) status.textContent = reason === 'missing'
          ? 'This notification is no longer available or is not addressed to this account. Refresh the register to see the current list.'
          : reason === 'denied'
            ? 'Your account cannot change this notification. It was not changed.'
            : reason === 'provider'
              ? 'The notification service did not confirm the change. Refresh the register before trying again.'
              : reason === 'stale'
                ? 'This notification changed before the request finished. Refresh the register and review its current read state.'
                : 'The service did not confirm whether this notification changed. Refresh the register before deciding whether to retry.';
        status?.focus();
      } catch {
        status?.setAttribute('role', 'alert');
        if (status) status.textContent = 'The service did not confirm whether this notification was changed. Refresh the register before deciding whether to retry.';
        status?.focus();
      } finally {
        form.removeAttribute('aria-busy');
        if (button) button.disabled = false;
      }
    });
  });
</script>
<style>
  .notification-filters {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    margin-block-end: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    min-inline-size: 0;
  }
  .notification-filters h2, .register-heading h2 { margin: 0; }
  .notif-filters { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .notif-filters a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    padding-inline: var(--space-4);
    border: 1px solid var(--control-border);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
  }
  .notif-filters a[aria-current='page'] {
    background: var(--surface-inset);
    border-color: var(--color-accent-primary);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-underline-offset: .25em;
  }
  .notification-register {
    min-inline-size: 0;
    background: var(--surface-register);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
  }
  .register-heading { display: grid; gap: var(--space-2); padding: var(--space-5); }
  .bounded-label { margin: 0; color: var(--text-muted); font-size: var(--font-size-sm); }
  .table-scroll { max-inline-size: 100%; overflow-x: auto; }
  .notifications { inline-size: 100%; min-inline-size: 54rem; border-collapse: collapse; table-layout: fixed; }
  .notifications th, .notifications td {
    padding: var(--space-4);
    border-block-end: 1px solid var(--color-border-subtle);
    text-align: start;
    vertical-align: top;
    overflow-wrap: anywhere;
    white-space: normal;
    line-height: 1.55;
    font-size: var(--font-size-sm);
  }
  .notifications thead th { background: var(--table-header-background); font-weight: var(--font-weight-semibold); }
  .notifications thead th:first-child { inline-size: 45%; }
  .notifications thead th:nth-child(2) { inline-size: 12%; }
  .notifications thead th:nth-child(3) { inline-size: 17%; }
  .notifications thead th:nth-child(4) { inline-size: 11%; }
  .notifications thead th:last-child { inline-size: 15%; }
  .notification-content { font-weight: var(--font-weight-normal); }
  .destination { display: flex; align-items: center; min-block-size: 44px; font-weight: var(--font-weight-semibold); }
  .notification-message { margin: var(--space-1) 0 0; color: var(--text-secondary); white-space: pre-wrap; }
  .notifications tbody tr:nth-child(even) { background: var(--surface-table-stripe); }
  .notifications .unread .read-state { font-weight: var(--font-weight-semibold); }
  .severity-label { display: inline-flex; align-items: baseline; gap: var(--space-2); }
  .severity { inline-size: 10px; block-size: 10px; flex: none; border-radius: 50%; background: var(--status-neutral); }
  .severity.warning { background: var(--status-warning); }
  .severity.critical { background: var(--status-danger); }
  .received { color: var(--text-secondary); font-variant-numeric: tabular-nums; }
  .read-form { margin: 0; }
  .read-form button {
    min-block-size: 44px;
    max-inline-size: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--control-border);
    border-radius: var(--radius-md);
    background: var(--surface-inset);
    color: var(--text-primary);
    font: inherit;
    overflow-wrap: anywhere;
    cursor: pointer;
  }
  .read-form button:disabled { opacity: var(--disabled-opacity); cursor: wait; }
  .action-status { margin: 0; color: var(--text-secondary); font-size: var(--font-size-sm); overflow-wrap: anywhere; }
  .action-status:not(:empty) { margin-block: var(--space-4); padding: var(--space-4); border: 1px solid var(--color-border-default); border-radius: var(--radius-md); background: var(--surface-panel); }
  .action-status[role='alert'] { color: var(--status-danger); }
  .empty { padding: var(--space-6); border: 1px dashed var(--color-border-default); border-radius: var(--radius-lg); color: var(--text-muted); }
  .empty h2 { color: var(--text-primary); }
  .empty a { display: inline-flex; align-items: center; min-block-size: 44px; }
  .notif-filters a:focus-visible, .destination:focus-visible, .read-form button:focus-visible, .table-scroll:focus-visible, .empty a:focus-visible, .action-status:focus {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  @media (max-width: 760px) {
    .notification-filters, .register-heading { padding: var(--space-4); }
  }
</style>
