<script>
  import { actions } from 'astro:actions';
  import { enhanceMutationForm } from '../../ui/forms/mutation-interaction.js';
  const form = document.querySelector<HTMLFormElement>('[data-owner-create-user]');
  if (form) {
    // A scope kind that names a collection needs its value before submit; the
    // valueless kinds never ask for one. The server re-validates either way.
    for (const checkbox of form.querySelectorAll<HTMLInputElement>('input[name="scopeKind"]')) {
      const valueInput = form.querySelector<HTMLInputElement>(
        `input[name="scopeValue-${checkbox.value}"]`,
      );
      const sync = () => {
        if (valueInput) valueInput.required = checkbox.checked;
      };
      checkbox.addEventListener('change', sync);
      sync();
    }
    enhanceMutationForm({
      form,
      progressText: 'Creating account…',
      copy: {
        VALIDATION_ERROR: 'The account was not created. Review the fields and try again.',
        CONFLICT_STALE:
          'An account with the same login identity may already exist. Your entries are preserved.',
        AUTHORIZATION_CHANGED:
          'Your authorization changed. Account creation requires the canonical owner session. Your entries are preserved.',
        DEPENDENCY_UNAVAILABLE:
          'A referenced record could not be found. Verify the entries and try again.',
        UNKNOWN_SAFE_ERROR: 'Account creation is unconfirmed. Check the account register and history before deciding whether to retry. Your entries are preserved.',
      },
      invoke: (data) => {
        const email = String(data.get('email') || '').trim();
        return actions.admin.createUser({
          loginIdentity: String(data.get('loginIdentity')),
          displayName: String(data.get('displayName')),
          ...(email ? { email } : {}),
          temporaryPassword: String(data.get('temporaryPassword')),
          roleCodes: data.getAll('roleCode').map(String),
          scopes: data.getAll('scopeKind').map((kind) => {
            const scopeKind = String(kind) as
              | 'OWN'
              | 'ASSIGNED'
              | 'TEAM'
              | 'DEPARTMENT'
              | 'SITE'
              | 'DOMAIN'
              | 'GLOBAL';
            const value = String(data.get(`scopeValue-${String(kind)}`) || '').trim();
            return value ? { kind: scopeKind, value } : { kind: scopeKind };
          }),
        }) as unknown as Promise<{ data?: { id?: string }; error?: unknown }>;
      },
      onSuccess: (outcome) => {
        if (outcome.recordId) window.location.href = `/admin/users/${outcome.recordId}`;
        else window.location.reload();
      },
    });
  }
</script>
