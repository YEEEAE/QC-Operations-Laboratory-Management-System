---
import PageHeader from "../../ui/components/PageHeader.astro";
import AppLayout from '../../ui/layouts/AppLayout.astro';
import {
  isNamedSystemOwner,
  isProtectedOwnerRoleGrant,
} from '../../shared/authorization/p05-authority.js';
import { controlCenterReadDependencies } from '../../modules/system-health/application/dependencies.js';
import { formatDateTime } from '../../shared/copy/format.js';
import { identityAdminReadDependencies } from '../../modules/identity/application/admin-dependencies.js';
import { administrationDependencies } from '../../modules/administration/application/dependencies.js';
import { auditQueryDependencies } from '../../shared/audit/audit-dependencies.js';
import { SCOPE_KINDS, scopeRequiresValue } from '../../shared/authorization/types.js';
import { hasAdminCapability } from '../../shared/authorization/admin-workspace.js';
import { roleLabel, stateLabel, uxVocabulary } from '../../shared/copy/ux-vocabulary.js';
import { pilotEnvironmentView } from '../../config/pilot.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
// Canonical-owner page: the middleware already returns 404 for non-owners; this
// defense-in-depth check keeps the page safe even if routing is bypassed.
if (!isNamedSystemOwner(actor)) return new Response(null, { status: 404 });
const canCreateUser = hasAdminCapability(actor, 'createUser');
const canAssignRoles = hasAdminCapability(actor, 'assignUserRole');
const canAssignScopes = hasAdminCapability(actor, 'assignUserScope');

type Overview = Awaited<
  ReturnType<ReturnType<typeof controlCenterReadDependencies>['overview']['execute']>
>;
type Users = Awaited<
  ReturnType<ReturnType<typeof identityAdminReadDependencies>['listUsers']['executePage']>
>;
type Roles = Awaited<
  ReturnType<ReturnType<typeof administrationDependencies>['listRoles']['execute']>
>;
type AuditResult = Awaited<ReturnType<ReturnType<typeof auditQueryDependencies>['list']['list']>>;

let overview: Overview | undefined;
try {
  overview = await controlCenterReadDependencies().overview.execute({ actor });
} catch {
  overview = undefined;
}

let users: Users | undefined;
let usersError = false;
let userAssignmentsUnavailable = false;
const roleSummary = new Map<string, string>();
const scopeSummary = new Map<string, string>();
try {
  const params = Astro.url.searchParams;
  const query = (params.get('q') ?? '').trim().slice(0, 120);
  const stateParam = params.get('state') ?? '';
  const stateFilter = stateParam === 'ACTIVE' || stateParam === 'INACTIVE' || stateParam === 'DISABLED' ? stateParam : undefined;
  const requestedPage = Number(params.get('page') ?? '1');
  const sortParam = params.get('sort') ?? 'loginIdentity';
  const sortBy = sortParam === 'displayName' || sortParam === 'state' || sortParam === 'lastLogin' ? sortParam : 'loginIdentity';
  const sortDirection = params.get('dir') === 'desc' ? 'desc' : 'asc';
  users = await identityAdminReadDependencies().listUsers.executePage({
    actor,
    filter: {
      query: query || undefined,
      accountState: stateFilter,
      page: Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1,
      pageSize: 10,
      sortBy,
      sortDirection,
    },
  });
} catch {
  usersError = true;
}
if (!usersError && users) {
  const auth = administrationDependencies();
  const userIds = users.items.map((user) => user.id);
  try {
    const [roles, scopes] = await Promise.all([
      auth.listUserRoles.executeForUsers({ actor, userIds }),
      auth.listUserScopes.executeForUsers({ actor, userIds }),
    ]);
    for (const row of roles) roleSummary.set(row.userId, row.codes.map((code) => `${roleLabel(code)} (${code})`).join(', ') || '—');
    for (const row of scopes) scopeSummary.set(row.userId, row.scopes.map((scope) => {
      const label = uxVocabulary.scopeKindLabels[scope.kind] ?? scope.kind;
      return scope.value ? `${label} (${scope.kind}: ${scope.value})` : `${label} (${scope.kind})`;
    }).join(', ') || '—');
    for (const user of users.items) {
      roleSummary.set(user.id, roleSummary.get(user.id) ?? '—');
      scopeSummary.set(user.id, scopeSummary.get(user.id) ?? '—');
    }
  } catch {
    userAssignmentsUnavailable = true;
  }
}

let roles: Roles = [];
let rolesError = false;
try {
  roles = await administrationDependencies().listRoles.execute({ actor });
} catch {
  rolesError = true;
}

let audit: AuditResult | undefined;
let auditUnavailable = false;
try {
  audit = await auditQueryDependencies().list.list(actor, { limit: 25 });
} catch {
  auditUnavailable = true;
}

// Server-rendered search/filter/sort/pagination — fully functional without client JS.
const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 120);
const stateParam = Astro.url.searchParams.get('state') ?? '';
const stateFilter = stateParam === 'ACTIVE' || stateParam === 'INACTIVE' || stateParam === 'DISABLED' ? stateParam : '';
const sortParam = Astro.url.searchParams.get('sort') ?? 'loginIdentity';
const sortKey = sortParam === 'displayName' || sortParam === 'state' || sortParam === 'lastLogin' ? sortParam : 'loginIdentity';
const sortDir = Astro.url.searchParams.get('dir') === 'desc' ? 'desc' : 'asc';
const pageSize = 10;
const totalPages = Math.max(1, Math.ceil((users?.total ?? 0) / pageSize));
const page = users?.page ?? 1;
const pageRows = users?.items ?? [];
const counts = { total: users?.total ?? 0 };

const pageParams = (overrides: Record<string, string>) => {
  const params = new URLSearchParams({
    q: query,
    state: stateFilter,
    sort: sortKey,
    dir: sortDir,
    ...overrides,
  });
  for (const [key, value] of [...params]) if (!value) params.delete(key);
  return `/system/control-center?${params.toString()}#accounts`;
};
const activeFilters = [
  ...(query ? [{ key: 'q', label: `Search: ${query}`, remove: pageParams({ q: '', page: '1' }) }] : []),
  ...(stateFilter
    ? [{ key: 'state', label: `State: ${stateLabel(stateFilter)}`, remove: pageParams({ state: '', page: '1' }) }]
    : []),
];
const sortLink = (key: string) =>
  pageParams({ sort: key, dir: sortKey === key && sortDir === 'asc' ? 'desc' : 'asc', page: '1' });

const statusClass = (status: string) =>
  status === 'HEALTHY' || status === 'READY' || status === 'VERIFIED'
    ? 'ok'
    : status === 'DEGRADED'
      ? 'warn'
      : status === 'UNKNOWN'
        ? 'unknown'
        : 'bad';
const generatedAt = overview ? formatDateTime(overview.generatedAt) : '—';
const pilotEnvironment = pilotEnvironmentView();
// Shared formatter contract: en-GB + Asia/Riyadh everywhere (no ad-hoc locale).
const formatDate = (value?: Date | string) => formatDateTime(value);
const migrationBlocker = (migration: Overview['migration']) =>
  !migration.sourceAvailable
    ? 'the shipped migration source could not be verified.'
    : migration.integrityMismatches.length > 0
      ? `ledger name/checksum mismatch at ${migration.integrityMismatches.join(', ')}.`
      : migration.pendingCount > 0
        ? `the database is at ${migration.appliedHead} while this build ships ${migration.buildHead}; pending migrations are not applied automatically.`
        : migration.drift
          ? `the database is at ${migration.appliedHead} while this release expects ${migration.expectedHead}.`
          : 'none modeled in this view.';
// UX-001: the console's most prominent indicator is release readiness, never a
// connectivity probe. The old connectivity badge at the top read as overall
// approval while QC acceptance stayed NOT VERIFIED and the release decision
// stayed NO-GO. Connectivity and migration facts stay in their own cards; this
// console never establishes release readiness.
const releaseBanner = {
  class: 'bad',
  title: overview ? 'Release readiness: NOT VERIFIED' : 'Release readiness: UNAVAILABLE',
};
---
<AppLayout title="Control center · System" locale="en" direction="ltr">
  <PageHeader><Fragment slot="heading"><h1>System control center</h1></Fragment>
      
      
      <p class="lede">Review member accounts and system operations.</p>
    <Fragment slot="actions"><span class={`banner ${releaseBanner.class}`}>{releaseBanner.title}</span></Fragment></PageHeader>

  <section class="panel" id="pilot-readiness" aria-labelledby="pilot-readiness-title">
    <h2 id="pilot-readiness-title">Staging and pilot readiness</h2>
    <p class="muted">Read-only configuration summary. These stages are independent; configuration does not prove verification or approval.</p>
    <dl class="readiness-facts">
      <div><dt>Runtime profile</dt><dd>{pilotEnvironment.profile.toUpperCase()} · {Astro.url.hostname}</dd></div>
      <div><dt>Neon branch label</dt><dd>{pilotEnvironment.branchLabel}</dd></div>
      {pilotEnvironment.isNonProductionProfile && <div><dt>Expected database identity allowlist</dt><dd>{pilotEnvironment.databaseIdentity}</dd></div>}
      {pilotEnvironment.isNonProductionProfile && <div><dt>Database identity verification</dt><dd>{pilotEnvironment.identityVerification}</dd></div>}
      {pilotEnvironment.isNonProductionProfile && <div><dt>Environment approval</dt><dd>{pilotEnvironment.identityApproval}</dd></div>}
      <div><dt>Implementation</dt><dd>{pilotEnvironment.stages.implementation}</dd></div>
      <div><dt>Configuration</dt><dd>{pilotEnvironment.stages.configuration}</dd></div>
      <div><dt>Verification</dt><dd>{pilotEnvironment.stages.verification}</dd></div>
      <div><dt>Approval</dt><dd>{pilotEnvironment.stages.approval}</dd></div>
      <div><dt>Pilot gate</dt><dd>{pilotEnvironment.enabled ? 'ENABLED' : 'DISABLED'}</dd></div>
      <div><dt>Shadow mode</dt><dd>{pilotEnvironment.shadowMode}</dd></div>
      <div><dt>File storage profile configuration</dt><dd>{pilotEnvironment.fileStorageConfigured ? 'CONFIGURED' : 'NOT CONFIGURED'}</dd></div>
      <div><dt>Real company master data</dt><dd>{pilotEnvironment.realMasterData}</dd></div>
      <div><dt>Scope</dt><dd>Site: {pilotEnvironment.scope.site ?? 'Not configured'} · Department: {pilotEnvironment.scope.department ?? 'Not configured'} · Line: {pilotEnvironment.scope.line ?? 'Not configured'} · Shift: {pilotEnvironment.scope.shift ?? 'Not configured'}</dd></div>
    </dl>
    <p class="muted">Configured identity is not verified identity, and neither state is approval. Connection hosts, database names, and credentials are intentionally hidden. The branch value is a label, not provider attestation.</p>
    <p class="muted">Release simulations never update Receiving release state or issue ERP/warehouse commands. Scope-linked master data onboarding is not implemented; follow the controlled PILOT-STAGING-OPERATIONS runbook before requesting approval.</p>
  </section>

  <section class="panel" id="accounts" aria-labelledby="accounts-title">
    <h2 id="accounts-title">Accounts</h2>
    <p class="muted">This global account register is available only to the canonical named SYSTEM_OWNER. A generic system-health permission does not grant access to this page or cross-company account, role, scope, or audit records. Company operational records must continue to use their owning domain's server-side tenant/scope authorization.</p>
    {
      usersError ? (
        <p class="muted" role="alert">The account register is temporarily unavailable.</p>
      ) : (
        <>
          {userAssignmentsUnavailable && <p class="muted" role="alert">Account role and scope assignments are temporarily unavailable; those relationship values are withheld.</p>}
          <form class="filters" role="search" aria-label="Filter accounts" method="get" action="/system/control-center">
            <label for="q">
              Search
              <input id="q" name="q" type="search" value={query} maxlength="120" placeholder="Login, name, or email" />
            </label>
            <label for="state">
              State
              <select id="state" name="state">
                <option value="" selected={stateFilter === ''}>All states</option>
                <option value="ACTIVE" selected={stateFilter === 'ACTIVE'}>{stateLabel('ACTIVE')}</option>
                <option value="INACTIVE" selected={stateFilter === 'INACTIVE'}>{stateLabel('INACTIVE')}</option>
                <option value="DISABLED" selected={stateFilter === 'DISABLED'}>{stateLabel('DISABLED')}</option>
              </select>
            </label>
            <input type="hidden" name="sort" value={sortKey} />
            <input type="hidden" name="dir" value={sortDir} />
            <button type="submit">Apply</button>
          </form>
          {activeFilters.length > 0 && <div class="active-filters" aria-label="Active account filters">
            <span class="filter-label">Filters</span>
            {activeFilters.map((filter) => <span class="filter-chip" data-filter-key={filter.key}>{filter.label}<a href={filter.remove} aria-label={`Remove ${filter.key} filter`}>×</a></span>)}
            <a class="clear-filters" href="/system/control-center#accounts">Clear all</a>
          </div>}
          <p class="register-count" role="status" aria-live="polite">
            {counts.total} matching {counts.total === 1 ? 'account' : 'accounts'}
          </p>
          {
            pageRows.length ? (
              <div class="table-wrap" role="region" aria-label="Account register" tabindex="0">
                <table>
                  <caption>
                    Member accounts — page {page} of {totalPages}
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col"><a href={sortLink('loginIdentity')}>Login identity</a></th>
                      <th scope="col"><a href={sortLink('displayName')}>Display name</a></th>
                      <th scope="col">Email</th>
                      <th scope="col"><a href={sortLink('state')}>State</a></th>
                      <th scope="col">Roles</th>
                      <th scope="col">Scopes</th>
                      <th scope="col"><a href={sortLink('lastLogin')}>Last login</a></th>
                      <th scope="col">Manage</th>
                    </tr>
                  </thead>
                  <tbody>
                    {pageRows.map((user) => (
                      <tr>
                        <th scope="row">
                          {user.loginIdentity}{' '}
                          {isProtectedOwnerRoleGrant(user.id, user.accountState, 'SYSTEM_OWNER') && (
                            <span class="pill protected">PROTECTED OWNER</span>
                          )}
                        </th>
                        <td>{user.displayName}</td>
                        <td>{user.email ?? '—'}</td>
                        <td>
                          <span
                            class={`pill ${
                              user.accountState === 'ACTIVE'
                                ? 'ok'
                                : user.accountState === 'DISABLED'
                                  ? 'bad'
                                  : 'warn'
                            }`}
                          >
                            {stateLabel(user.accountState)}
                          </span>
                        </td>
                        <td>{userAssignmentsUnavailable ? 'N/A — assignments unavailable' : roleSummary.get(user.id) ?? '—'}</td>
                        <td>{userAssignmentsUnavailable ? 'N/A — assignments unavailable' : scopeSummary.get(user.id) ?? '—'}</td>
                        <td>{formatDate(user.lastLoginAt)}</td>
                        <td><a href={`/admin/users/${user.id}`}>Open workspace</a></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="muted">No accounts match the current filter.</p>
            )
          }
          <nav class="pagination" aria-label="Accounts pages">
            {page > 1 ? (
              <a href={pageParams({ page: String(page - 1) })}>Previous</a>
            ) : (
              <span aria-disabled="true">Previous</span>
            )}
            <span>
              Page {page} / {totalPages}
            </span>
            {page < totalPages ? (
              <a href={pageParams({ page: String(page + 1) })}>Next</a>
            ) : (
              <span aria-disabled="true">Next</span>
            )}
          </nav>
        </>
      )
    }
  </section>

  <section class="panel" aria-labelledby="overview-title">
    <h2 id="overview-title">System overview</h2>
    {
      !overview ? (
        <p class="muted" role="status">
          Live status is temporarily unavailable. No connectivity or migration conclusion is available. Machine readiness remains at /api/health/ready.
        </p>
      ) : (
        <>
          <p class="muted">Overview generated {generatedAt} (Asia/Riyadh).</p>
          <p class="release-boundary"><strong>QC acceptance: NOT VERIFIED.</strong> Connectivity and migration posture do not establish QC completion, recovery acceptance, or production release approval.</p>
          <p class="muted">Core connectivity and release identity checks are separate diagnostics; neither is a production GO or RELEASED decision.</p>
          <div class="cards">
            <div class="card">
              <span class="card-label">Core connectivity</span>
              <span class={`pill ${statusClass(overview.coreStatus)}`}>{overview.coreStatus}</span>
              <small>Source: application probe checked {formatDate(overview.sourceCheckedAt.application)} and PostgreSQL probe checked {formatDate(overview.sourceCheckedAt.database)} (Asia/Riyadh).</small>
            </div>
            <div class="card">
              <span class="card-label">Application</span>
              <span class={`pill ${statusClass(overview.applicationStatus)}`}>{overview.applicationStatus}</span>
              <small>Source: application probe. Checked {formatDate(overview.sourceCheckedAt.application)} (Asia/Riyadh).</small>
            </div>
            <div class="card">
              <span class="card-label">PostgreSQL</span>
              <span class={`pill ${statusClass(overview.databaseStatus)}`}>{overview.databaseStatus}</span>
              <small>Source: PostgreSQL probe. Checked {formatDate(overview.sourceCheckedAt.database)} (Asia/Riyadh).</small>
            </div>
            <div class="card">
              <span class="card-label">Audit subsystem</span>
              <span class={`pill ${statusClass(overview.auditStatus)}`}>{overview.auditStatus}</span>
              <small>Source: audit readiness read. Checked {formatDate(overview.sourceCheckedAt.audit)} (Asia/Riyadh).</small>
            </div>
            <div class="card">
              <span class="card-label">Migration posture</span>
              <span class={`pill ${overview.migration.drift ? 'bad' : 'ok'}`}>
                {overview.migration.drift ? 'DRIFT DETECTED' : 'IN SYNC'}
              </span>
              <small>Source: database migration ledger and shipped migration files. Checked {formatDate(overview.sourceCheckedAt.migration)} (Asia/Riyadh).</small>
            </div>
          </div>
          <section class="evidence-block" aria-labelledby="release-identity-title">
            <h3 id="release-identity-title">Release identity evidence</h3>
            <p class="muted">Evidence source: dist/release-identity.json checked against the running server artifact SHA-256 and runtime metadata. This verification is not release readiness.</p>
            <dl>
              <div><dt>Identity verification</dt><dd class={overview.release.status === 'VERIFIED' ? 'good' : 'warn'}>{overview.release.status}</dd></div>
              <div><dt>Identity evidence read at</dt><dd>{generatedAt} (Asia/Riyadh)</dd></div>
              <div><dt>Release ID</dt><dd>{overview.release.releaseId ?? 'UNVERIFIED'}</dd></div>
              <div><dt>Build ID</dt><dd>{overview.release.buildId ?? 'UNVERIFIED'}</dd></div>
              <div><dt>Build timestamp</dt><dd>{formatDate(overview.release.buildTimestamp)}</dd></div>
              <div><dt>Git SHA</dt><dd>{overview.release.gitSha ?? 'UNVERIFIED'}</dd></div>
              <div><dt>Application version</dt><dd>{overview.release.applicationVersion ?? 'UNVERIFIED'}</dd></div>
              <div><dt>Environment</dt><dd>{overview.release.environment ?? 'UNVERIFIED'}</dd></div>
              <div><dt>Identity migration head</dt><dd>{overview.release.migrationHead ?? 'UNVERIFIED'}</dd></div>
            </dl>
          </section>
          <section class="evidence-block" aria-labelledby="migration-evidence-title">
            <h3 id="migration-evidence-title">Migration ledger</h3>
            <dl>
              <div><dt>Applied head — database ledger</dt><dd>{overview.migration.appliedHead}</dd></div>
              <div><dt>Shipped head — build files</dt><dd>{overview.migration.buildHead}</dd></div>
              <div><dt>Expected head — release identity or build</dt><dd>{overview.migration.expectedHead}</dd></div>
              <div><dt>Pending migrations</dt><dd>{overview.migration.pendingCount}</dd></div>
            </dl>
            <p class="muted">Open blockers: {migrationBlocker(overview.migration)} Core connectivity is not release approval; release gates and recovery evidence remain separate. Dependency and backup detail: <a href="/system/health">System health</a> · <a href="/system/backups">Backups</a></p>
          </section>
        </>
      )
    }
  </section>

  {canCreateUser ? <section class="panel" aria-labelledby="create-title">
    <h2 id="create-title">Create account</h2>
    <p class="muted">
      New accounts start ACTIVE with a temporary password that must be changed at first
      sign-in. Creation runs inside a single audited transaction.
    </p>
    <form class="form" method="post" action="/system/control-center" data-owner-create-user>
      <label for="loginIdentity">
        Login identity<span aria-hidden="true"> *</span>
        <input id="loginIdentity" name="loginIdentity" required maxlength="200" autocomplete="off" />
      </label>
      <label for="displayName">
        Display name<span aria-hidden="true"> *</span>
        <input id="displayName" name="displayName" required maxlength="200" autocomplete="off" />
      </label>
      <label for="email">
        Email (optional)
        <input id="email" name="email" type="email" maxlength="320" autocomplete="off" />
      </label>
      <label for="temporaryPassword">
        Temporary password<span aria-hidden="true"> *</span>
        <input id="temporaryPassword" name="temporaryPassword" type="password" required maxlength="512" autocomplete="new-password" />
      </label>
      {canAssignRoles ? <fieldset>
        <legend>Initial role grants</legend>
        {rolesError && (
          <p class="note">N/A — active role choices are withheld because the roles read is unavailable.</p>
        )}
        {roles
          .filter((role) => role.active)
          .map((role) => (
            <label class="check">
              <input type="checkbox" name="roleCode" value={role.code} /> {role.name} ({role.code})
            </label>
          ))}
      </fieldset> : <p class="note">You can create an account without initial roles. Role assignment requires its separate permission.</p>}
      {canAssignScopes ? <fieldset>
        <legend>Initial scopes (optional)</legend>
        <p class="note">
          Kinds that name a collection require a value; GLOBAL is a whole-system grant and takes
          none.
        </p>
        {SCOPE_KINDS.map((kind) => (
          <div class="scope-row">
            <label class="check">
              <input type="checkbox" name="scopeKind" value={kind} /> {uxVocabulary.scopeKindLabels[kind]} <span class="code">{kind}</span>
            </label>
            {scopeRequiresValue(kind) ? (
              <input
                name={`scopeValue-${kind}`}
                maxlength="200"
                placeholder={`${uxVocabulary.scopeKindLabels[kind]} value`}
                aria-label={`${uxVocabulary.scopeKindLabels[kind]} scope value`}
              />
            ) : (
              <span class="note">No value</span>
            )}
          </div>
        ))}
      </fieldset> : <p class="note">You can create an account without initial scopes. Scope assignment requires its separate permission.</p>}
      <div class="actions">
        <button type="submit">Create account</button>
      </div>
    </form>
  </section> : <section class="panel" aria-labelledby="create-title"><h2 id="create-title">Create account</h2><p class="note">Account creation requires its separate permission. You can still review the safe account and system projections above.</p></section>}

  <section class="panel" aria-labelledby="roles-title">
    <h2 id="roles-title">Roles &amp; permissions</h2>
    <p class="muted">
      Read view of canonical roles and grants. Administration happens in the governed
      workspaces; the canonical owner role and GLOBAL scope grants are protected at the
      persistence layer and can never be removed.
    </p>
    {
      rolesError ? (
        <p class="muted" role="alert">The role register is temporarily unavailable.</p>
      ) : (
        <div class="table-wrap" role="region" aria-label="Canonical roles register" tabindex="0">
          <table>
            <caption>Canonical roles</caption>
            <thead>
              <tr>
                <th scope="col">Role</th>
                <th scope="col">State</th>
                <th scope="col">Administration</th>
              </tr>
            </thead>
            <tbody>
              {roles.map((role) => (
                <tr>
                  <th scope="row"><a href={`/admin/roles/${role.id}`}>{role.name}</a><small class="code">{role.code}</small></th>
                  <td>
                    <span class={`pill ${role.active ? 'ok' : 'bad'}`}>
                      {stateLabel(role.active ? 'ACTIVE' : 'INACTIVE')}
                    </span>
                  </td>
                  <td><a href={`/admin/roles/${role.id}`}>Open role</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
    <p class="muted">
      Full matrices: <a href="/admin/roles">Roles</a> · <a href="/admin/permissions">Permissions</a>{' '}
      · <a href="/admin/scopes">Scopes</a>
    </p>
  </section>

  <section class="panel" aria-labelledby="config-title">
    <h2 id="config-title">System configuration</h2>
    <p class="muted">
      Secrets (database URLs, session secrets, provider credentials, encryption keys) are
      managed exclusively through the deployment provider environment and are never editable
      from the application. No persisted application-settings model is currently justified by
      the business rules; introducing one requires a forward migration, typed repository,
      validation, audit, and optimistic concurrency — none of which are invented here.
    </p>
  </section>

  <section class="panel" aria-labelledby="activity-title">
    <h2 id="activity-title">Recent administrative activity</h2>
    <p class="muted">
      Sanitized audit view — payloads and secret-bearing columns never leave the audit store.
    </p>
    {
      auditUnavailable ? (
        <p class="muted" role="alert">Administrative activity is temporarily unavailable. No conclusion about recorded history can be made.</p>
      ) : !audit || audit.events.length === 0 ? (
        <p class="muted">No audit events are visible.</p>
      ) : (
        <div class="table-wrap" role="region" aria-label="Recent administrative activity register" tabindex="0">
          <table>
            <caption>Latest {audit.events.length} of {audit.total} audit events</caption>
            <thead>
              <tr>
                <th scope="col">When</th>
                <th scope="col">Action</th>
                <th scope="col">Subject</th>
                <th scope="col">State change</th>
              </tr>
            </thead>
            <tbody>
              {audit.events.map((event) => (
                <tr>
                  <td>{formatDate(event.occurredAt)}</td>
                  <td><code>{event.action}</code></td>
                  <td>{event.subjectType}</td>
                  <td>
                    {event.oldState || event.newState
                      ? `${event.oldState ?? '—'} -> ${event.newState ?? '—'}`
                      : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
    <p class="muted">Full history with filters: <a href="/audit">Audit history</a></p>
  </section>
</AppLayout>
