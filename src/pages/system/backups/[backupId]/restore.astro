---
import AppLayout from '../../../../ui/layouts/AppLayout.astro';
import FormErrorSummary from '../../../../ui/components/FormErrorSummary.astro';
import { actions } from 'astro:actions';
import { field, toFormFailure, type FormFailure } from '../../../../ui/forms/mutation-post.js';
import { backupCatalogReadDependencies } from '../../../../modules/backup-recovery/application/dependencies.js';
import { isUuid } from '../../../../shared/id/uuid.js';
import { stateLabel } from '../../../../shared/copy/ux-vocabulary.js';
import { classifyReadFailure, providerUnavailableResponse } from '../../../../shared/errors/read-failure.js';
import { uuidv7 } from '../../../../shared/id/uuid.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const backupId = Astro.params.backupId ?? '';
if (!isUuid(backupId)) return Astro.redirect('/404');
let detail;
try {
  detail = await backupCatalogReadDependencies().get.execute({ actor, backupId });
} catch (error) {
  if (classifyReadFailure(error) === 'UNAVAILABLE') return providerUnavailableResponse('Backup details are temporarily unavailable', Astro.url.pathname + Astro.url.search);
  return Astro.redirect('/404');
}
if (!detail) return Astro.redirect('/404');
const { backup, restoreVerification, restorable, eligibilityVersion } = detail;
const catalogCheckedAt = new Date();
const canRequestDrill = actor.permissions.some((item) => item.active !== false && item.code === 'PERM-BKP-RESTORE-DRILL' && item.scopes.includes('GLOBAL'));
const canRequestProduction = actor.permissions.some((item) => item.active !== false && item.code === 'PERM-BKP-RESTORE-PRODUCTION' && item.scopes.includes('GLOBAL'));
const riyadh = (date: Date) => date.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' });
const verificationLabel =
  restoreVerification === 'VERIFIED'
    ? 'RESTORE VERIFIED'
    : restoreVerification === 'VERIFICATION_FAILED'
      ? 'RESTORE VERIFICATION FAILED'
      : restoreVerification === 'VERIFYING'
        ? 'RESTORE VERIFYING'
        : 'RESTORE NOT VERIFIED';
const productionBlocked = true; // Production restore authority/e-signature (RD-020, BKP-DD-014/016) unresolved: DENY.
let values = { restoreType: 'DRILL', targetEnvironment: 'test', reason: '', idempotencyKey: uuidv7() };
let failure: FormFailure | null = null;

// No-JavaScript baseline: submit the same server Action and preserve entered
// values after a known failure. The Action/use case reauthorizes the actor.
if (Astro.request.method === 'POST' && (canRequestDrill || canRequestProduction)) {
  const formData = await Astro.request.formData();
  values = {
    restoreType: field(formData, 'restoreType') || 'DRILL',
    targetEnvironment: field(formData, 'targetEnvironment') || 'test',
    reason: field(formData, 'reason'),
    idempotencyKey: field(formData, 'idempotencyKey'),
  };
  try {
    if (field(formData, 'confirmRestore') !== 'on') throw new Error('validation failed');
    const result = await Astro.callAction(actions.system.requestRestore, {
      backupId,
      restoreType: values.restoreType as 'DRILL' | 'PRODUCTION',
      targetEnvironment: values.targetEnvironment as 'local' | 'test' | 'staging' | 'production',
      reason: values.reason,
      expectedVersion: field(formData, 'expectedVersion'),
      idempotencyKey: values.idempotencyKey,
      confirmRestore: true,
    });
    if (!result.error) return Astro.redirect(`/system/backups/${backupId}`, 303);
    failure = toFormFailure(result.error, {
      entity: 'restore request', requiredFields: [], values,
      listHref: `/system/backups/${backupId}`, listLabel: 'backup details',
    });
  } catch (error) {
    failure = toFormFailure(error, {
      entity: 'restore request', requiredFields: [], values,
      listHref: `/system/backups/${backupId}`, listLabel: 'backup details',
    });
  }
}
---
<AppLayout title={`Restore request · ${riyadh(backup.requestedAt)} · QC Operations`} locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">Restore request</p><h1>Restore request</h1><p class="lede">This page records a controlled restore request. It never executes a restore: no recovery provider, production authority, or e-signature ceremony is approved in this baseline, so every recorded request stays planned.</p></div><a href={`/system/backups/${backup.id}`}>Back to backup</a></section>
  <section class="panel"><h2>Backup and recovery context</h2><dl>
    <div><dt>Internal backup reference</dt><dd><code>{backup.id}</code></dd></div>
    <div><dt>Backup job state</dt><dd>{stateLabel(backup.state)} — job result only, never restore evidence</dd></div>
    <div><dt>Backup artifact verified</dt><dd>{backup.state === 'VERIFIED' ? 'Yes' : 'No'}</dd></div>
    <div><dt>Integrity checksum</dt><dd>{backup.hasChecksum ? 'Recorded (value withheld)' : 'Not recorded'}</dd></div>
    <div><dt>Backup requested at</dt><dd>{riyadh(backup.requestedAt)} · Asia/Riyadh (UTC internally)</dd></div>
    <div><dt>Catalog record checked</dt><dd><time datetime={catalogCheckedAt.toISOString()}>{riyadh(catalogCheckedAt)} · Asia/Riyadh</time></dd></div>
    <div><dt>Restore verification</dt><dd class={restoreVerification === 'VERIFIED' ? 'good' : 'warn'}>{verificationLabel}</dd></div>
    <div><dt>Database schema version</dt><dd>{backup.databaseSchemaVersion ?? 'UNKNOWN'}</dd></div>
    <div><dt>Application version / Git SHA binding</dt><dd>Not recorded in catalog</dd></div>
    <div><dt>Known gaps</dt><dd>{restoreVerification !== 'VERIFIED' ? 'No verified restore exists for this backup set' : 'None recorded'}</dd></div>
    <div><dt>Display timezone</dt><dd>Asia/Riyadh — all recovery timestamps are shown with explicit timezone to prevent target ambiguity</dd></div>
  </dl></section>
  <section class="panel"><h2>Restore verification requirements</h2><p class="muted">This page can record a restore intent only. It has no provider executor or restore report, so these checks are not represented by evidence in this view. A real isolated drill must record each result:</p><dl><div><dt>Artifact bytes and checksum comparison</dt><dd class="warn">NOT RECORDED IN THIS VIEW</dd></div><div><dt>Restored schema and migration ledger</dt><dd class="warn">NOT RECORDED IN THIS VIEW</dd></div><div><dt>QC, audit, and business history</dt><dd class="warn">NOT RECORDED IN THIS VIEW</dd></div><div><dt>Linked evidence files and restored hashes</dt><dd class="warn">NOT RECORDED IN THIS VIEW</dd></div><div><dt>Application and authorization checks</dt><dd class="warn">NOT RECORDED IN THIS VIEW</dd></div><div><dt>RPO / RTO targets</dt><dd class="warn">NOT APPROVED</dd></div></dl><p>Next permitted step: request a DRILL and execute the approved procedure against an explicitly isolated disposable target. Production restore remains DENIED until its authority and recovery evidence are approved.</p></section>
  {!restorable && <section class="denied" role="alert"><h2>Restore request unavailable</h2><p>Only backup sets whose artifact exists and is verified can be selected as a recovery set candidate. This set is {stateLabel(backup.state)}.</p></section>}
  {restorable && !canRequestDrill && !canRequestProduction && <section class="denied" role="alert"><h2>Restore request unavailable</h2><p>Your account lacks an explicit restore permission. Role alone is not authorization, and Admin is not an automatic restore authority.</p></section>}
  {restorable && (canRequestDrill || canRequestProduction) && (
    <form class="decision" method="post" data-backup-id={backup.id}>
      <input type="hidden" name="expectedVersion" value={eligibilityVersion} />
      <input type="hidden" name="idempotencyKey" value={values.idempotencyKey} />
      {failure && <FormErrorSummary summary={failure.summary} recovery={failure.recovery ?? ''} errors={[]} listHref={`/system/backups/${backup.id}`} listLabel="backup details" />}
      <label for="restoreType">Restore type
        <select id="restoreType" name="restoreType">
          {canRequestDrill && <option value="DRILL" selected={values.restoreType === 'DRILL'}>Isolated drill — non-production target</option>}
          <option value="PRODUCTION" selected={values.restoreType === 'PRODUCTION'} disabled={productionBlocked}>Production restore — unavailable pending approval (RD-020)</option>
        </select>
      </label>
      <label for="targetEnvironment">Target environment
        <select id="targetEnvironment" name="targetEnvironment">
          <option value="test" selected={values.targetEnvironment === 'test'}>test</option>
          <option value="local" selected={values.targetEnvironment === 'local'}>local</option>
          <option value="staging" selected={values.targetEnvironment === 'staging'}>staging</option>
          <option value="production" disabled>production — isolated drill targets only</option>
        </select>
      </label>
      <label for="reason">Reason (required; saved as recovery evidence)
        <textarea id="reason" name="reason" rows="3" required minlength="3" maxlength="2000">{values.reason}</textarea>
      </label>
      <label class="confirm" for="confirmRestore"><input id="confirmRestore" name="confirmRestore" type="checkbox" required /> I understand this records a restore intent only, that no restore is executed by this system, and that the backup job state is not restore evidence.</label>
      <button type="submit" data-submit>Record restore request</button>
      <p class="muted">Each request must meet permission, scope, environment, backup-state, and policy requirements.</p>
    </form>
  )}
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  import { enhanceMutationForm } from '../../../../ui/forms/mutation-interaction.js';
  const form = document.querySelector<HTMLFormElement>('.decision');
  if (form) {
    if (!form.querySelector('[data-result]')) {
      const status = document.createElement('p');
      status.setAttribute('data-result', '');
      status.setAttribute('role', 'status');
      status.setAttribute('tabindex', '-1');
      status.className = 'muted';
      form.appendChild(status);
    }
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit && !submit.hasAttribute('data-submit')) submit.setAttribute('data-submit', '');
    enhanceMutationForm({
      form,
      progressText: 'Recording restore intent…',
      copy: {
        VALIDATION_ERROR: 'The restore intent was not recorded. Confirmation and a valid reason are required — review the fields and try again.',
        CONFLICT_STALE: 'This backup set changed while you were reviewing it. Refresh the backup detail and try again if still permitted.',
        AUTHORIZATION_CHANGED: 'Your authorization changed. Recording a restore intent needs the explicit drill/production restore permission. Your reason was kept.',
        DEPENDENCY_UNAVAILABLE: 'The backup set is no longer available as a recovery candidate. Refresh the backup detail before trying again.',
        UNKNOWN_SAFE_ERROR: 'The restore request result is unconfirmed. Your reason is kept. Check the backup and its request history before retrying.',
      },
      invoke: (data) => {
        const confirmed = data.get('confirmRestore') === 'on';
        if (!confirmed) {
          return Promise.resolve({
            error: { message: 'errors.validation_failed' },
          });
        }
        return actions.system.requestRestore({
          backupId: String(form.dataset.backupId),
          restoreType: String(data.get('restoreType') ?? 'DRILL') as 'DRILL' | 'PRODUCTION',
          targetEnvironment: String(data.get('targetEnvironment') ?? 'test') as 'local' | 'test' | 'staging' | 'production',
          reason: String(data.get('reason') ?? ''),
          expectedVersion: String(data.get('expectedVersion') ?? ''),
          idempotencyKey: String(data.get('idempotencyKey') ?? ''),
          confirmRestore: true,
        }) as unknown as Promise<{ data?: { id?: string }; error?: unknown }>;
      },
      onSuccess: () => { window.location.href = `/system/backups/${String(form.dataset.backupId)}`; },
    });
  }
</script>
<style>.page-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:start;margin-bottom:var(--space-6)}h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.muted{color:var(--text-muted);font-size:.86rem}.page-head a{color:var(--color-accent-primary-hover)}.panel,.decision,.denied{padding:var(--space-5);margin-bottom:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}.panel h2,.denied h2{margin-top:0;font-size:1rem}dl{display:grid;gap:var(--space-3);margin:0}dl div{display:flex;justify-content:space-between;gap:var(--space-4);border-bottom:1px solid var(--color-border-subtle);padding-bottom:.55rem}dt{color:var(--text-muted);font-size:.8rem}dd{margin:0;text-align:end;font-size:.8rem;max-width:55%;overflow-wrap:anywhere}.good{color:var(--status-success)}.warn{color:var(--status-warning)}code{overflow-wrap:anywhere;font-size:.72rem}.denied{border-inline-start:3px solid var(--status-error)}.decision{display:grid;gap:var(--space-4)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}select,textarea{width:100%;padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.confirm{display:flex;gap:.6rem;align-items:start;line-height:1.5}.confirm input{margin-top:.2rem}button{justify-self:start;min-height:var(--control-height);padding:.65rem 1.2rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}button:disabled{opacity:.6}@media(max-width:650px){.page-head{display:grid}dl div{display:grid;gap:.2rem}dd{text-align:start;max-width:none}}</style>
