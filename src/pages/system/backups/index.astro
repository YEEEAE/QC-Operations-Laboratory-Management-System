---
import PageHeader from "../../../ui/components/PageHeader.astro";
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import {
  backupCatalogReadDependencies,
  recoveryGovernanceReadDependencies,
} from '../../../modules/backup-recovery/application/dependencies.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import {
  RECOVERY_ENVIRONMENTS,
  formatRecoveryDuration,
  formatRecoveryObjective,
  recoveryDrillOutcomeLabel,
  recoveryEnvironmentLabel,
  recoveryPolicyStatusLabel,
  recoveryReadinessLabel,
  recoveryReadinessTone,
} from '../../../ui/backup-recovery/recovery-labels.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
let backups: Awaited<ReturnType<ReturnType<typeof backupCatalogReadDependencies>['list']['execute']>> = [];
let total = 0;
let pages = 1;
let providerUnavailable = false;
let catalogCheckedAt = new Date();
const states = ['REQUESTED', 'RUNNING', 'CREATED', 'VERIFYING', 'VERIFIED', 'FAILED', 'EXPIRED', 'DELETED'] as const;
const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
let page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const stateParam = Astro.url.searchParams.get('state');
const selectedState = states.find((state) => state === stateParam);
const pageSize = 25;
try {
  const result = await backupCatalogReadDependencies().list.executePage({
    actor,
    filter: { page, pageSize, ...(selectedState ? { states: [selectedState] } : {}) },
  });
  backups = result.items;
  total = result.total;
  page = result.page;
  pages = Math.max(1, Math.ceil(total / pageSize));
} catch {
  providerUnavailable = true;
} finally {
  catalogCheckedAt = new Date();
}
const riyadh = (date: Date) => date.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' });

// Governed recovery policy and service-level evidence. Read-only: this page
// never drafts, approves, backs up or restores. A failed governance read is
// shown as unavailable, never as an unconfigured-but-healthy posture.
let recoveryPosture: import('../../../modules/backup-recovery/application/get-recovery-posture.js').RecoveryPostureView | undefined;
let recoveryUnavailable = false;
try {
  recoveryPosture = await recoveryGovernanceReadDependencies().posture.execute({ actor });
} catch {
  recoveryUnavailable = true;
}
const recoveryReadiness = recoveryPosture?.readiness;
const policyInForce = recoveryPosture?.currentPolicy;
const boundaryByEnvironment = new Map(
  (recoveryPosture?.storageBoundaries ?? []).map(
    (boundary) => [boundary.environment, boundary] as const,
  ),
);
---
<AppLayout title="Backups · QC Operations" locale="en" direction="ltr">
  <PageHeader><Fragment slot="heading"><h1>Backups</h1></Fragment><p class="lede">Backup records. Restore verification is shown separately.</p></PageHeader>
  <p class="source-note">Evidence source: application backup catalog · Backup catalog {providerUnavailable ? 'read attempted' : 'read'} at <time datetime={catalogCheckedAt.toISOString()}>{riyadh(catalogCheckedAt)}</time> (Asia/Riyadh). Empty catalog, unavailable provider, and unverified recovery remain separate states.</p>
  <form class="filters" method="get" aria-label="Filter backup catalog">
    <label for="state">Backup job result<select id="state" name="state"><option value="">All states</option>{states.map((state) => <option value={state} selected={selectedState === state}>{stateLabel(state)}</option>)}</select></label>
    <button type="submit">Apply filter</button>
    {selectedState && <a href="/system/backups">Clear filter</a>}
  </form>
  {selectedState && <div class="active-filter" aria-label="Active filters"><span>Active filter</span><strong>Backup job result: {stateLabel(selectedState)}</strong></div>}
  {Boolean(stateParam && !selectedState) && <p class="filter-notice" role="status">The backup-state filter was not applied because its value is unsupported.</p>}
  {providerUnavailable ? <ProviderUnavailableState title="Backup catalog is temporarily unavailable" description="Recovery posture is withheld because the catalog provider did not confirm a response." retryHref="/system/backups" /> : backups.length ? <><div class="table-wrap" role="region" aria-label="Backup catalog" tabindex="0"><table><caption>{total} backup set{total === 1 ? '' : 's'}{selectedState ? ` in ${stateLabel(selectedState)}` : ''}; page {page} of {pages}</caption><thead><tr><th scope="col">Backup set</th><th scope="col">Backup job result</th><th scope="col">Artifact verified</th><th scope="col">Schema version</th><th scope="col">Requested (Asia/Riyadh)</th></tr></thead><tbody>{backups.map((item) => <tr><th scope="row"><a href={`/system/backups/${item.id}`}>Backup set · {riyadh(item.requestedAt)}</a></th><td><span class={`pill ${item.state === 'CREATED' || item.state === 'VERIFIED' ? 'ok' : item.state === 'FAILED' ? 'bad' : 'unknown'}`}>{stateLabel(item.state)}</span></td><td>{item.state === 'VERIFIED' ? 'Yes' : 'No'}</td><td>{item.databaseSchemaVersion ?? 'Not recorded'}</td><td>{riyadh(item.requestedAt)}</td></tr>)}</tbody></table></div>{pages > 1 && <nav class="pagination" aria-label="Backup catalog pages">{page > 1 ? <a rel="prev" href={`/system/backups?${new URLSearchParams({ ...(selectedState ? { state: selectedState } : {}), page: String(page - 1) })}`}>Previous page</a> : <span>Previous page</span>}<span aria-current="page">Page {page} of {pages}</span>{page < pages ? <a rel="next" href={`/system/backups?${new URLSearchParams({ ...(selectedState ? { state: selectedState } : {}), page: String(page + 1) })}`}>Next page</a> : <span>Next page</span>}</nav>}</> : <section class="empty"><h2>{selectedState ? 'No backup sets match this filter' : 'No backup sets are recorded'}</h2><p>No backup sets are recorded yet. An empty catalog is shown as an unknown recovery posture, never as a healthy state.</p></section>}
   <section class="notice" role="note"><strong>Restore requests</strong><span>A planned restore request is an intent, not an executed restore or recovery proof. Restore requests are recorded from a backup's detail page with a reason and confirmation. Opening a page never triggers a restore. Production restore stays denied until the recovery authority and e-signature policy are approved.</span></section>
   <section class="targets" aria-labelledby="recovery-targets"><h2 id="recovery-targets">Recovery objectives and service-level evidence</h2>
    {recoveryUnavailable ? <p role="status">Recovery policy and service-level evidence are unavailable because the source read did not return a confirmed result. No objective is inferred.</p> : recoveryReadiness ? <>
      <p class="readiness"><span class={`pill ${recoveryReadinessTone(recoveryReadiness.status)}`}>{recoveryReadinessLabel(recoveryReadiness.status)}</span> <span>{recoveryReadiness.reason}</span></p>
      <dl><div><dt>RPO objective</dt><dd>{formatRecoveryObjective(policyInForce?.rpoSeconds)}<small>{policyInForce ? `Policy revision ${policyInForce.revision}, approved ${policyInForce.approvedAt ? riyadh(policyInForce.approvedAt) : 'date not recorded'}.` : 'No approved policy is in force; no RPO is assumed.'}</small></dd></div><div><dt>RTO objective</dt><dd>{formatRecoveryObjective(policyInForce?.rtoSeconds)}<small>{policyInForce ? `Approval reference: ${policyInForce.approvalReference ?? 'not recorded'}.` : 'No approved policy is in force; no RTO is assumed.'}</small></dd></div><div><dt>Retention / immutable copies</dt><dd>{policyInForce?.retentionDays ? `${policyInForce.retentionDays} days` : 'Not approved'}<small>{policyInForce?.immutableBackupCopies ? `${policyInForce.immutableBackupCopies} immutable copies required.` : 'No retention duration or copy count is assumed.'}</small></dd></div><div><dt>Responsible person</dt><dd>{policyInForce?.responsiblePerson ?? 'Not recorded'}<small>{policyInForce?.policyReference ? `Source: ${policyInForce.policyReference}${policyInForce.policyRevision ? ` · ${policyInForce.policyRevision}` : ''}.` : 'No approved source is recorded.'}</small></dd></div><div><dt>Latest backup age</dt><dd>{formatRecoveryDuration(recoveryReadiness.backupAgeSeconds)}<small>{recoveryReadiness.latestBackup ? `Artifact ${recoveryReadiness.latestBackup.artifactVerified ? 'verified' : 'not verified'}; checksum ${recoveryReadiness.latestBackup.checksumRecorded ? 'recorded' : 'not recorded'}.` : 'No backup set is recorded.'}</small></dd></div><div><dt>Last drill outcome</dt><dd>{recoveryReadiness.lastDrill ? recoveryDrillOutcomeLabel(recoveryReadiness.lastDrill.outcome) : 'No drill recorded'}<small>{recoveryReadiness.drill ? 'A verified drill exists for the latest set.' : 'No verified drill is recorded; this is not a restore claim.'}</small></dd></div><div><dt>Observed restore time</dt><dd>{formatRecoveryDuration(recoveryReadiness.observedRestoreSeconds)}<small>From the last verified drill, when one exists.</small></dd></div><div><dt>Unresolved exceptions</dt><dd>{recoveryReadiness.unresolvedExceptionCount}<small>{recoveryReadiness.unresolvedExceptionCount ? 'Open recovery incidents remain exceptions.' : 'No open recovery incident is recorded.'}</small></dd></div></dl>
      {recoveryReadiness.unresolvedExceptions.length > 0 && <ul class="exceptions">{recoveryReadiness.unresolvedExceptions.map((exception) => <li><strong>{exception.reference}</strong> · {recoveryEnvironmentLabel(exception.environment)} · detected {riyadh(exception.detectedAt)}</li>)}</ul>}
      <p>Objectives come only from an approved policy version. A backup job, an artifact checksum or a historical drill is not current provider recovery evidence. Policy governance and incident evidence: <a href="/system/backups/policy">recovery policy</a>.</p>
    </> : <p role="status">Recovery objectives are not available.</p>}
   </section>
   <section class="coverage" aria-labelledby="storage-boundaries"><h2 id="storage-boundaries">Environment storage boundaries</h2><p class="muted">Recorded as non-secret identity labels. Bucket names, keys, endpoints and credentials are never shown or stored here; cross-environment object write is refused.</p><div class="table-scroll" role="region" aria-label="Recovery storage boundaries" tabindex="0"><table><caption>Latest recorded boundary per environment</caption><thead><tr><th scope="col">Environment</th><th scope="col">Boundary</th><th scope="col">Isolation</th><th scope="col">Cross-environment read</th></tr></thead><tbody>{RECOVERY_ENVIRONMENTS.map((environment) => { const boundary = boundaryByEnvironment.get(environment); return <tr><th scope="row">{recoveryEnvironmentLabel(environment)}</th><td>{boundary?.boundaryLabel ?? 'Not configured'}</td><td>{boundary ? boundary.isolationState.replaceAll('_', ' ').toLowerCase() : 'Not configured'}</td><td>{boundary ? (boundary.crossEnvironmentReadAllowed ? 'Allowed' : 'Not allowed') : 'Not configured'}</td></tr>; })}</tbody></table></div></section>
   <section class="coverage" aria-labelledby="policy-status"><h2 id="policy-status">Policy versions and exceptions</h2><dl><div><dt>Policy version</dt><dd>{recoveryPosture?.latestPolicy ? `Revision ${recoveryPosture.latestPolicy.revision} · ${recoveryPolicyStatusLabel(recoveryPosture.latestPolicy.status)}` : 'Not configured'}<small>New versions start pending approval. Only an approved version in force supplies objectives.</small></dd></div><div><dt>Open recovery incidents</dt><dd>{recoveryPosture?.unresolvedIncidents.length ?? 0}<small>Append-only incidents; closure is a separate record.</small></dd></div></dl><p>Governed policy, incident recording and the controlled restore boundary: <a href="/system/backups/policy">Recovery policy</a>.</p></section>
   <section class="coverage" aria-labelledby="recovery-coverage"><h2 id="recovery-coverage">Recovery coverage and ownership</h2><dl><div><dt>Scheduler</dt><dd>Not active<small>Read-only Render check on 23 Sep 2026 found no Cron service in this workspace.</small></dd></div><div><dt>Catalog</dt><dd>{providerUnavailable ? 'Unavailable' : `${total} recorded backup sets`}<small>Source: application backup catalog{!providerUnavailable && total === 0 ? '; empty is unknown, not healthy' : ''}.</small></dd></div><div><dt>Artifact storage</dt><dd>Not verified for deployed service<small>Adapter code does not prove live storage configuration or recoverability.</small></dd></div><div><dt>Retention</dt><dd>{policyInForce?.retentionDays ? `${policyInForce.retentionDays} days approved` : 'Not approved / not enforced'}<small>{policyInForce?.retentionDays ? 'Approved duration; enforcement and purge evidence are not verified here.' : 'No approved policy exists; no purge period is assumed.'}</small></dd></div><div><dt>Recovery owner</dt><dd>{policyInForce?.responsiblePerson ?? 'Not recorded'}<small>{policyInForce ? 'Named in the approved policy version.' : 'No approved policy names a recovery owner.'}</small></dd></div><div><dt>PITR / WAL</dt><dd>Unavailable on current plan / not verified<small>Read-only Render check on 23 Sep 2026 confirmed a Free PostgreSQL plan; WAL coverage evidence is absent.</small></dd></div><div><dt>Failure monitoring</dt><dd>Not verified<small>Provider alert configuration and delivery evidence are not recorded.</small></dd></div><div><dt>Response owner</dt><dd>Admin role (L3)<small>Named operator and on-call timing unresolved (PD-29); escalation: system owner yazeed.</small></dd></div></dl><p>Runbooks: Documents/RECOVERY-INCIDENT-RUNBOOK.md · Documents/RESTORE-DRILL-RUNBOOK.md</p></section>
</AppLayout>
<style>.source-note{color:var(--text-secondary);margin-block:0 var(--space-5)}.active-filter{display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-3);margin-block:0 var(--space-4);color:var(--text-secondary)}.active-filter strong{padding:var(--space-2) var(--space-3);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);color:var(--text-primary)}.filter-notice{color:var(--text-secondary)}.page-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:start;margin-bottom:var(--space-6)}h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.empty p{color:var(--text-muted);font-size:.86rem}.filters{display:flex;align-items:end;gap:var(--space-4);margin-bottom:var(--space-4);flex-wrap:wrap}.filters label{display:grid;gap:.35rem}.filters select,.filters button{min-height:max(var(--control-height),44px);padding:.45rem .7rem}.pagination{display:flex;justify-content:center;align-items:center;gap:var(--space-5);padding:var(--space-5)}.filters a,.pagination a,.table-wrap a{display:inline-flex;align-items:center;min-block-size:44px}.pagination span{color:var(--text-muted)}.table-wrap{max-inline-size:100%;overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);margin-bottom:var(--space-5)}table{width:100%;min-width:860px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted)}th,td{padding:.75rem;text-align:start;border-top:1px solid var(--color-border-subtle);font-size:.8rem;overflow-wrap:anywhere}th{font-weight:700}a{color:var(--color-accent-primary-hover)}.pill{padding:.2rem .55rem;border-radius:999px;font-size:var(--font-size-xs);font-weight:700}.pill.ok{color:var(--status-success);border:1px solid var(--status-success)}.pill.bad{color:var(--status-error);border:1px solid var(--status-error)}.pill.neutral,.pill.unknown{color:var(--text-muted);border:1px solid var(--color-border-strong)}.notice,.empty,.targets,.coverage{padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}.notice{display:grid;gap:.35rem;border-inline-start:3px solid var(--status-warning)}.notice span,.targets p,.coverage p{color:var(--text-muted);font-size:.85rem}.targets,.coverage{margin-top:var(--space-5)}.targets h2,.coverage h2{font-size:1rem;margin:0 0 var(--space-4)}.readiness{display:flex;align-items:start;gap:var(--space-3);flex-wrap:wrap;font-size:.86rem}.readiness .pill{border:1px solid currentColor;border-radius:999px;padding:.2rem .55rem;white-space:nowrap}.pill.ok{color:var(--status-success)}.pill.warn{color:var(--status-warning)}.pill.bad{color:var(--status-error)}.pill.unknown{color:var(--text-muted)}.exceptions{display:grid;gap:.35rem;padding-inline-start:1.2rem;font-size:.82rem}.table-scroll{max-inline-size:100%;overflow-x:auto}.table-scroll table{min-width:640px}.coverage .muted,.targets p{color:var(--text-muted);font-size:.85rem}dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:var(--space-5);margin:0}dt{color:var(--text-muted);font-size:var(--font-size-xs)}dd{font-weight:700;margin:.2rem 0 0}small{display:block;color:var(--text-muted);font-size:var(--font-size-xs);font-weight:400;margin-top:.2rem}.empty{text-align:center;padding:var(--space-8);border-style:dashed}@media(max-width:650px){.page-head,.filters{display:grid}dl{gap:var(--space-5)}}</style>
