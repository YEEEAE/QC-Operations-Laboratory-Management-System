---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import { backupCatalogReadDependencies } from '../../../modules/backup-recovery/application/dependencies.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
let backups: Awaited<ReturnType<ReturnType<typeof backupCatalogReadDependencies>['list']['execute']>> = [];
let providerUnavailable = false;
try {
  backups = await backupCatalogReadDependencies().list.execute({ actor, filter: { limit: 50 } });
} catch {
  providerUnavailable = true;
}
const jobLabel = (state: string) => (state === 'CREATED' || state === 'VERIFIED' ? 'SUCCEEDED' : state);
const riyadh = (date: Date) => date.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' });
---
<AppLayout title="Backups · QC Operations" locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">Backups</p><h1>Backups</h1><p class="lede">Recorded backup sets. A completed backup job is not the same as a verified restore — verification for each set is shown on its detail page.</p></div></section>
  {providerUnavailable ? <ProviderUnavailableState title="Backup catalog is temporarily unavailable" description="Recovery posture is withheld because the catalog provider did not confirm a response." /> : backups.length ? <div class="table-wrap"><table><caption>Backup sets in the controlled recovery catalog</caption><thead><tr><th scope="col">Backup</th><th scope="col">Backup job result</th><th scope="col">Artifact verified</th><th scope="col">Schema version</th><th scope="col">Requested (Asia/Riyadh)</th></tr></thead><tbody>{backups.map((item) => <tr><th scope="row"><a href={`/system/backups/${item.id}`}>{item.id}</a></th><td><span class={`pill ${item.state === 'CREATED' || item.state === 'VERIFIED' ? 'ok' : item.state === 'FAILED' ? 'bad' : 'unknown'}`}>{jobLabel(item.state)}</span></td><td>{item.state === 'VERIFIED' ? 'Yes' : 'No'}</td><td>{item.databaseSchemaVersion ?? '—'}</td><td>{riyadh(item.requestedAt)}</td></tr>)}</tbody></table></div> : <section class="empty"><h2>No backup sets are recorded</h2><p>No backup sets are recorded yet. An empty catalog is shown as an unknown recovery posture, never as a healthy state.</p></section>}
   <section class="notice" role="note"><strong>Restore requests</strong><span>Restore requests are recorded from a backup's detail page with a reason and confirmation. Opening a page never triggers a restore. Production restore stays denied until the recovery authority and e-signature policy are approved.</span></section>
   <section class="targets" aria-labelledby="recovery-targets"><h2 id="recovery-targets">Recovery objectives</h2><dl><div><dt>RPO objective</dt><dd>Not approved</dd><small>Reason: business owner decision PD-26 is open.</small></div><div><dt>RTO objective</dt><dd>Not approved</dd><small>Reason: business owner decision PD-27 is open.</small></div><div><dt>Measured recovery</dt><dd>Not measured</dd><small>No current isolated-drill timestamps are recorded.</small></div></dl><p>Objectives remain policy-dependent. A backup job or a historical drill is not current provider recovery evidence.</p></section>
   <section class="coverage" aria-labelledby="recovery-coverage"><h2 id="recovery-coverage">Recovery coverage and ownership</h2><dl><div><dt>Scheduler</dt><dd>Not active</dd><small>Read-only Render check on 23 Sep 2026 found no Cron service in this workspace.</small></div><div><dt>Catalog</dt><dd>{providerUnavailable ? 'Unavailable' : `${backups.length} recorded backup sets`}</dd><small>Source: application backup catalog{backups.length === 0 ? '; empty is unknown, not healthy' : ''}.</small></div><div><dt>Artifact storage</dt><dd>Not verified for deployed service</dd><small>Adapter code does not prove live storage configuration or recoverability.</small></div><div><dt>Retention</dt><dd>Not approved / not enforced</dd><small>QMS retention decisions PD-24/25 are open; no purge period is assumed.</small></div><div><dt>PITR / WAL</dt><dd>Unavailable on current plan / not verified</dd><small>Read-only Render check on 23 Sep 2026 confirmed a Free PostgreSQL plan; WAL coverage evidence is absent.</small></div><div><dt>Failure monitoring</dt><dd>Not verified</dd><small>Provider alert configuration and delivery evidence are not recorded.</small></div><div><dt>Response owner</dt><dd>Admin role (L3)</dd><small>Named operator and on-call timing unresolved (PD-29); escalation: system owner yazeed.</small></div></dl><p>Runbooks: Documents/RECOVERY-INCIDENT-RUNBOOK.md · Documents/RESTORE-DRILL-RUNBOOK.md</p></section>
</AppLayout>
<style>.page-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:start;margin-bottom:var(--space-6)}h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.empty p{color:var(--text-muted);font-size:.86rem}.table-wrap{overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);margin-bottom:var(--space-5)}table{width:100%;min-width:860px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted)}th,td{padding:.75rem;text-align:start;border-top:1px solid var(--color-border-subtle);font-size:.8rem}th{font-weight:700}a{color:var(--color-accent-primary-hover)}.pill{padding:.2rem .55rem;border-radius:999px;font-size:.7rem;font-weight:700;white-space:nowrap}.pill.ok{color:var(--status-success);border:1px solid var(--status-success)}.pill.bad{color:var(--status-error);border:1px solid var(--status-error)}.pill.neutral,.pill.unknown{color:var(--text-muted);border:1px solid var(--color-border-strong)}.notice,.empty,.targets,.coverage{padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}.notice{display:grid;gap:.35rem;border-inline-start:3px solid var(--status-warning)}.notice span,.targets p,.coverage p{color:var(--text-muted);font-size:.85rem}.targets,.coverage{margin-top:var(--space-5)}.targets h2,.coverage h2{font-size:1rem;margin:0 0 var(--space-4)}dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:var(--space-5);margin:0}dt{color:var(--text-muted);font-size:.72rem}dd{font-weight:700;margin:.2rem 0 0}small{display:block;color:var(--text-muted);font-size:.72rem;margin-top:.2rem}.empty{text-align:center;padding:var(--space-8);border-style:dashed}@media(max-width:650px){.page-head{display:grid}dl{gap:var(--space-5)}}</style>
