---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import { approvalsReadDependencies } from '../../modules/approvals/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const approval = await approvalsReadDependencies().get.execute({ actor, approvalId: Astro.params.approvalId ?? '' }).catch(() => undefined);
if (!approval) return Astro.redirect('/404');
const context = approval.subject.reviewContext;
const subjectLabel = String(context['documentNo'] ?? context['inspectionNo'] ?? context['labTestNo'] ?? context['calibrationNo'] ?? approval.approvalCase.subjectType);
---
<AppLayout title={`Approval · ${subjectLabel}`} locale="en" direction="ltr">
  <nav class="crumb"><a href="/approvals">My Approvals</a><span>/</span><span>{subjectLabel}</span></nav>
  <section class="head"><div><p class="eyebrow">UI-APR-002 · APPROVAL REVIEW WORKSPACE</p><h1>{subjectLabel}</h1><p>{approval.approvalCase.subjectType} · {approval.approvalCase.subjectId}</p></div><StatusBadge status="REVIEW" label={approval.workItem.state} /></section>
  <div class="grid"><section class="panel"><h2>Controlled subject snapshot</h2><dl><dt>Workflow</dt><dd>{approval.approvalCase.workflowType}</dd><dt>Version under review</dt><dd>{approval.subject.version.toString()}</dd><dt>Requested by</dt><dd>{approval.approvalCase.requestedBy}</dd><dt>State</dt><dd>{approval.subject.state}</dd><dt>Integrity reference</dt><dd>{approval.subject.snapshotHash ?? 'Not available from the owning domain'}</dd></dl></section><section class="panel"><h2>Review context</h2><dl>{Object.entries(context).map(([key, value]) => <><dt>{key}</dt><dd>{typeof value === 'string' || typeof value === 'number' ? String(value) : value ? 'Available' : 'Not available'}</dd></>)}</dl></section></div>
  <section class="panel decision"><h2>Controlled decision</h2><p>Decision meaning, reauthentication, permission, scope, state, version, and SoD are checked again by the server. A successful signature alone never changes the subject.</p><form data-approval-decision><input type="hidden" name="approvalId" value={approval.approvalCase.id} /><input type="hidden" name="workItemId" value={approval.workItem.id} /><input type="hidden" name="subjectVersion" value={approval.subject.version.toString()} /><label for="decision">Decision<select id="decision" name="decision"><option value="APPROVE">Approve</option><option value="RETURN">Return for correction</option><option value="REJECT">Reject</option></select></label><label for="reason">Reason / comments<textarea id="reason" name="reason" rows="4" maxlength="4000"></textarea></label><label for="reauthenticationSecret">Re-enter password if the approved workflow policy requires an e-signature<input id="reauthenticationSecret" name="reauthenticationSecret" type="password" autocomplete="current-password" /></label><button type="submit">Submit controlled decision</button><output data-result aria-live="polite"></output></form></section>
</AppLayout>
<script>
// @ts-expect-error Astro generates the action client module during the build.
import { actions } from 'astro:actions';
const form = document.querySelector<HTMLFormElement>('[data-approval-decision]');
form?.addEventListener('submit', async (event) => { event.preventDefault(); const button = form.querySelector<HTMLButtonElement>('button'); const output = form.querySelector<HTMLOutputElement>('[data-result]'); if (!button) return; button.disabled = true; if (output) output.textContent = 'Checking authorization and controlled evidence…'; const data = new FormData(form); const result = await actions.approvals.decide({ approvalId: String(data.get('approvalId')), workItemId: String(data.get('workItemId')), subjectVersion: BigInt(String(data.get('subjectVersion'))), decision: String(data.get('decision')) as 'APPROVE' | 'RETURN' | 'REJECT', reason: String(data.get('reason') ?? '') || undefined, reauthenticationSecret: String(data.get('reauthenticationSecret') ?? '') || undefined }); if (result.data) window.location.href = '/approvals'; else { button.disabled = false; if (output) output.textContent = 'The decision was not accepted. Reload the current record and try again if permitted.'; } });
</script>
<style>
  .crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,a{color:var(--color-accent-primary-hover)}.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.decision p{color:var(--text-muted);font-size:.85rem}.grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0 0 var(--space-4);font-size:1rem}dl{display:grid;grid-template-columns:minmax(150px,.6fr) 1fr;gap:.75rem;font-size:.82rem}dt{color:var(--text-muted)}dd{margin:0;overflow-wrap:anywhere;font-weight:600}.decision{margin-top:var(--space-4)}form{display:grid;gap:var(--space-4);max-width:720px}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.8rem}select,textarea,input{padding:.65rem;border:1px solid var(--border-default);border-radius:var(--radius-sm);background:var(--surface-page);color:inherit;font:inherit}button{width:max-content;min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}output{color:var(--text-muted);font-size:.8rem}@media(max-width:700px){.head{display:grid}.grid{grid-template-columns:1fr}dl{grid-template-columns:1fr}.panel{padding:var(--space-4)}}
</style>
