---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import OperationalState from '../../ui/components/feedback/OperationalState.astro';
import LoadingState from '../../ui/components/feedback/LoadingState.astro';
import StaleVersionState from '../../ui/components/feedback/StaleVersionState.astro';
import JourneyContextPanel from '../../ui/components/workflow/JourneyContextPanel.astro';
import HandoffTimeline from '../../ui/components/workflow/HandoffTimeline.astro';
import { isUuid } from '../../shared/id/uuid.js';
import { approvalsReadDependencies } from '../../modules/approvals/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
import { classifyReadFailure, providerUnavailableResponse } from '../../shared/errors/read-failure.js';
let approval: Awaited<ReturnType<ReturnType<typeof approvalsReadDependencies>['get']['execute']>> | undefined;
let readDenied = false;
if (isUuid(Astro.params.approvalId)) {
  try {
    approval = await approvalsReadDependencies().get.execute({ actor, approvalId: Astro.params.approvalId ?? '' });
  } catch (error) {
    const failure = classifyReadFailure(error);
    if (failure === 'UNAVAILABLE') {
      return providerUnavailableResponse('Approval details are temporarily unavailable', Astro.url.pathname + Astro.url.search);
    }
    readDenied = failure === 'DENIED';
  }
}
const readState = readDenied ? 'denied' : !approval ? 'missing' : undefined;
if (readState === 'denied') Astro.response.status = 403;
else if (readState === 'missing') Astro.response.status = 404;
if (readState) Astro.response.headers.set('Cache-Control', 'no-store');
const context = approval?.subject.reviewContext ?? {};
const humanSubjectType: Record<string, string> = {
  DOCUMENT_VERSION: 'Controlled document version',
  INSPECTION_REPORT: 'Inspection report',
  LAB_TEST: 'Laboratory test',
  CHANGE_REQUEST: 'Change request',
};
const subjectLabel = approval
  ? String(
      context['documentNo'] ??
        context['inspectionNo'] ??
        context['labTestNo'] ??
        context['calibrationNo'] ??
        context['changeNo'] ??
        humanSubjectType[approval.approvalCase.subjectType] ??
        'Controlled record',
    )
  : 'Approval review';
const humanize = (key: string): string =>
  key
    .replaceAll(/([a-z])([A-Z])/g, '$1 $2')
    .replaceAll(/[_-]+/g, ' ')
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
const contextLabel = (key: string): string => humanize(key);
const contextUuid = (key: string): string | undefined => typeof context[key] === 'string' && isUuid(context[key]) ? context[key] : undefined;
const subjectHref = contextUuid('documentId') ? `/documents/${contextUuid('documentId')}` : contextUuid('inspectionId') ? `/quarantine/inspections/${contextUuid('inspectionId')}` : contextUuid('labTestId') ? `/laboratory/tests/${contextUuid('labTestId')}` : contextUuid('calibrationId') ? `/assets/calibrations/${contextUuid('calibrationId')}` : undefined;
const availableDecisions = approval?.decisionCapabilities.filter((capability) => capability.state === 'AVAILABLE') ?? [];
const policyBlockedDecisions = approval?.decisionCapabilities.filter((capability) => capability.state === 'POLICY_BLOCKED') ?? [];
const approvalActionable = availableDecisions.length > 0;
const approvalNextAction = approvalActionable ? 'Submit a permitted controlled decision' : policyBlockedDecisions.length ? 'Decision blocked pending approved signature policy' : 'No permitted decision is available';
const approvalNextOwner = approvalActionable ? (approval?.workItem.assignedRoleRequirement ?? 'Assigned approver') : policyBlockedDecisions.length ? 'QMS signature-policy owner' : 'Owning domain';
const decisionLabel: Record<string, string> = { APPROVE: 'Approve', RETURN: 'Return for correction', REJECT: 'Reject' };
const hasRequiredSignature = availableDecisions.some((capability) => capability.signature === 'REQUIRED');
const approvalEvents = approval ? [
  { label: 'Approval requested', detail: approval.approvalCase.requestedAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' }), kind: 'business' as const },
  ...(approval.workItem.assignedAt ? [{ label: 'Approval work item assigned', detail: approval.workItem.assignedAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' }), kind: 'approval' as const }] : []),
  ...(approval.workItem.startedAt ? [{ label: 'Review started', detail: approval.workItem.startedAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' }), kind: 'approval' as const }] : []),
  { label: 'Source transition', detail: 'The owning domain applies the business transition after approval verification.', kind: 'business' as const },
] : [];
---
<AppLayout title={`Approval · ${subjectLabel}`} locale="en" direction="ltr">
  {!approval ? <OperationalState state={readState === 'denied' ? 'denied' : 'empty'} title={readState === 'denied' ? 'Approval is not available to this account' : 'Approval case not found'} description={readState === 'denied' ? 'Your account cannot read this assigned approval. Return to My approvals or check your approved assignment and permission.' : 'No approval case matches this request. Return to My approvals to choose a current item.'} actionLabel="Return to My approvals" actionHref="/approvals" /> : <div class="evidence-record">
  <nav class="crumb"><a href="/approvals">My approvals</a><span>/</span><span>{subjectLabel}</span></nav>
  <section class="head workspace-header"><div><p class="eyebrow">Approval review</p><h1>{subjectLabel}</h1><p>{humanSubjectType[approval.approvalCase.subjectType] ?? 'Controlled record'} · Current version {approval.subject.version.toString()}</p></div><StatusBadge status="REVIEW" label={approval.workItem.state} /></section>
  <JourneyContextPanel ownerDomain={approval.subject.domain ?? 'Reviews & Approvals'} currentState={`${approval.approvalCase.state} · Work item ${approval.workItem.state}`} nextAction={approvalNextAction} nextActionHref={subjectHref} nextOwner={approvalNextOwner} whyUnavailable={!approvalActionable ? policyBlockedDecisions.length ? 'policy: the required decision signature policy has no approved action-specific source' : 'authority or state: no supported decision is available to this actor for the current work item' : undefined} waitingOn={approvalActionable ? approvalNextOwner : policyBlockedDecisions.length ? 'QMS signature-policy owner' : 'Owning domain'} expectedEvent={approvalActionable ? 'Controlled decision' : 'Approved policy source or current owning-domain state'} controlledContext={`${humanSubjectType[approval.approvalCase.subjectType] ?? approval.approvalCase.subjectType} · version ${approval.subject.version.toString()}`} evidenceSummary={approval.subject.snapshotHash ? 'Controlled snapshot hash available' : 'Snapshot hash not available from owning domain'} auditHref={`/audit?subjectType=${encodeURIComponent(approval.approvalCase.subjectType)}&subjectId=${encodeURIComponent(approval.approvalCase.subjectId)}`} relatedLinks={subjectHref ? [{ label: subjectLabel, href: subjectHref, detail: 'Open owning-domain record' }] : [{ label: 'My approvals', href: '/approvals', detail: 'Approval queue' }]} />
  <HandoffTimeline events={approvalEvents} />
  <div class="grid"><section class="panel"><h2>Controlled subject snapshot</h2><dl><dt>Workflow</dt><dd>{humanize(approval.approvalCase.workflowType)}</dd><dt>Version under review</dt><dd>{approval.subject.version.toString()}</dd><dt>Requester</dt><dd>Recorded in the controlled audit trail</dd><dt>State</dt><dd>{humanize(approval.subject.state)}</dd><dt>Integrity reference</dt><dd>{approval.subject.snapshotHash ? 'Available in the controlled record' : 'Not available from the owning domain'}</dd></dl></section><section class="panel"><h2>Review context</h2><dl>{Object.entries(context).map(([key, value]) => <><dt>{contextLabel(key)}</dt><dd>{typeof value === 'string' || typeof value === 'number' ? String(value).match(/^[0-9a-f]{8}-[0-9a-f-]{27,}$/i) ? 'Available in the controlled record' : String(value) : value ? 'Available' : 'Not available'}</dd></>)}</dl></section></div>
  {approvalActionable ? <section class="panel decision"><h2>Controlled decision</h2><p>Only decisions supported by this subject's wired handler and currently authorized for your assignment, scope, state, version, and SoD are listed. A successful signature alone never changes the subject.</p><form method="post" data-approval-decision><input type="hidden" name="approvalId" value={approval.approvalCase.id} /><input type="hidden" name="workItemId" value={approval.workItem.id} /><input type="hidden" name="subjectVersion" value={approval.subject.version.toString()} /><label for="decision">Decision<select id="decision" name="decision">{availableDecisions.map((capability) => <option value={capability.decision}>{decisionLabel[capability.decision] ?? capability.decision}</option>)}</select></label><label for="reason">Reason / comments<span id="reason-help" class="hint">Required for Return or Reject when offered.</span><span id="reason-error" role="alert" hidden>Enter a reason before returning or rejecting.</span><textarea id="reason" name="reason" rows="4" maxlength="4000" aria-describedby="reason-help reason-error"></textarea></label>{hasRequiredSignature && <><p class="signing-meaning">{availableDecisions.filter((capability) => capability.signature === 'REQUIRED').map((capability) => capability.meaning).filter(Boolean).join(' ')}</p><label for="reauthenticationSecret">Re-enter your password to sign this decision<input id="reauthenticationSecret" name="reauthenticationSecret" type="password" autocomplete="current-password" aria-describedby="signature-help" /></label><span id="signature-help" class="hint">The password is used only to reauthenticate this signing action and is not retained.</span></>}<button type="submit" data-submit>Submit controlled decision</button><output data-result aria-live="polite" tabindex="-1"></output><a data-recovery hidden href={Astro.url.pathname}>Reload the current approval before retrying</a></form></section> : approval.workItem.state === 'PENDING' || approval.workItem.state === 'IN_PROGRESS' ? <section class="panel decision" role="status"><h2>{policyBlockedDecisions.length ? 'Decision unavailable' : 'Review only'}</h2>{policyBlockedDecisions.length ? <p>The action-specific electronic-signature policy has not been approved. This decision is blocked before reauthentication. Contact the QMS signature-policy owner. You can review the subject and its current version here; no password field or decision control is available.</p> : <p>No supported decision is currently authorized for your assignment and the subject's scope, state, version, and separation-of-duties rules. Review the subject or return to My approvals; do not retry with a password.</p>}</section> : null}
  <div data-loading-state hidden><LoadingState label="Checking authorization and controlled evidence" rows={3} /></div>
  <div data-stale-state hidden><StaleVersionState version={approval.subject.version.toString()} /></div>
  </div>
  }
</AppLayout>
<style>
  .evidence-record{max-width:1120px;margin-inline:auto}.grid{margin-top:var(--space-5)}.panel{border:0;border-block-start:1px solid var(--color-border-subtle);border-radius:0;background:transparent;padding-inline:0}.decision{border-block-start:3px solid var(--color-accent-primary);padding:var(--space-5);background:var(--surface-panel)}.decision h2{margin-bottom:var(--space-3)}.decision form{max-width:none;grid-template-columns:1fr 1fr}.decision form>label,.decision form>p,.decision form>span,.decision form>button,.decision form>output,.decision form>a{grid-column:1 / -1}.decision form>label:first-of-type{max-width:360px}.hint{color:var(--text-muted);font-size:.75rem}.signing-meaning{border-inline-start:3px solid var(--status-warning);padding:var(--space-3);background:var(--surface-page)}.eyebrow{letter-spacing:0}.head h1{overflow-wrap:anywhere}.head>div{min-width:0}.decision button{max-width:100%;white-space:normal}.crumb{flex-wrap:wrap}@media(max-width:700px){.decision form{grid-template-columns:1fr}.decision{padding:var(--space-4)}}
</style>
<script>
  import { actions } from 'astro:actions';
  import { classifyActionResult } from '../../ui/forms/mutation-interaction.js';
  const form = document.querySelector<HTMLFormElement>('[data-approval-decision]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || form.getAttribute('aria-busy') === 'true') return;
    const button = form.querySelector<HTMLButtonElement>('[data-submit], button[type="submit"]');
    const decision = form.querySelector<HTMLSelectElement>('#decision');
    const reason = form.querySelector<HTMLTextAreaElement>('#reason');
    const reasonError = form.querySelector<HTMLElement>('#reason-error');
    const secret = form.querySelector<HTMLInputElement>('#reauthenticationSecret');
    const requiresReason = decision?.value === 'RETURN' || decision?.value === 'REJECT';
    if (reason) reason.required = Boolean(requiresReason);
    if (requiresReason && !reason?.value.trim()) {
      reason?.setAttribute('aria-invalid', 'true');
      if (reasonError) reasonError.hidden = false;
      reason?.focus();
      return;
    }
    reason?.removeAttribute('aria-invalid');
    if (reasonError) reasonError.hidden = true;
    const output = form.querySelector<HTMLOutputElement>('[data-result]');
    form.setAttribute('aria-busy', 'true');
    const page = form.closest('.evidence-record');
    const loading = page?.querySelector<HTMLElement>('[data-loading-state]');
    const stale = page?.querySelector<HTMLElement>('[data-stale-state]');
    if (loading) loading.hidden = false;
    if (stale) stale.hidden = true;
    if (button) button.disabled = true;
    if (output) output.textContent = 'Checking authorization and controlled evidence…';
    try {
      const data = new FormData(form);
      const result = await actions.approvals.decide({ approvalId: String(data.get('approvalId')), workItemId: String(data.get('workItemId')), subjectVersion: BigInt(String(data.get('subjectVersion'))), decision: String(data.get('decision')) as 'APPROVE' | 'RETURN' | 'REJECT', reason: String(data.get('reason') ?? '') || undefined, reauthenticationSecret: String(data.get('reauthenticationSecret') ?? '') || undefined });
      const outcome = classifyActionResult(result as unknown as { data?: { id?: string }; error?: unknown });
      if (outcome.state === 'SUCCESS') { window.location.href = '/approvals'; return; }
      if (outcome.state === 'CONFLICT_STALE' && stale) stale.hidden = false;
      if (outcome.state === 'CONFLICT_STALE' || outcome.state === 'UNKNOWN_SAFE_ERROR') {
        form.dataset.recoveryRequired = 'true';
        const recovery = form.querySelector<HTMLAnchorElement>('[data-recovery]');
        if (recovery) recovery.hidden = false;
      }
      const copy: Record<string, string> = {
        VALIDATION_ERROR: 'The decision was not accepted. A reason is required for return/reject — review the fields and try again. Your entries are preserved.',
        CONFLICT_STALE: 'The record changed while you were reviewing it. Reload the current record and try again if permitted. Your reason was kept.',
        AUTHORIZATION_CHANGED: 'Your authorization changed. Check your approval permission and any signature requirement. Your entries remain on this page.',
        DEPENDENCY_UNAVAILABLE: 'The approval record is no longer available. Reload the record before trying again.',
        UNKNOWN_SAFE_ERROR: 'The result is unconfirmed. Your entries remain on this page. Check the record and its history before trying again.',
      };
      if (output) { output.textContent = copy[outcome.state] ?? copy.UNKNOWN_SAFE_ERROR; output.focus?.(); }
    } catch {
      form.dataset.recoveryRequired = 'true';
      const recovery = form.querySelector<HTMLAnchorElement>('[data-recovery]');
      if (recovery) recovery.hidden = false;
      if (output) { output.textContent = 'The result is unconfirmed. Your entries remain on this page. Check the record and its history before trying again.'; output.focus?.(); }
    } finally { if (secret) secret.value = ''; if (loading) loading.hidden = true; form.removeAttribute('aria-busy'); if (button) button.disabled = form.dataset.recoveryRequired === 'true'; }
  });
  form?.querySelector<HTMLSelectElement>('#decision')?.addEventListener('change', (event) => {
    const decision = event.currentTarget as HTMLSelectElement;
    const reason = form?.querySelector<HTMLTextAreaElement>('#reason');
    if (reason) reason.required = decision.value === 'RETURN' || decision.value === 'REJECT';
    reason?.removeAttribute('aria-invalid');
    const reasonError = form?.querySelector<HTMLElement>('#reason-error');
    if (reasonError) reasonError.hidden = true;
  });
</script>
<style>
  .crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,a{color:var(--color-accent-primary-hover)}.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.decision p{color:var(--text-muted);font-size:.85rem}.grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0 0 var(--space-4);font-size:1rem}dl{display:grid;grid-template-columns:minmax(150px,.6fr) 1fr;gap:.75rem;font-size:.82rem}dt{color:var(--text-muted)}dd{margin:0;overflow-wrap:anywhere;font-weight:600}.decision{margin-top:var(--space-4)}form{display:grid;gap:var(--space-4);max-width:720px}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.8rem}#reason-error{color:var(--text-danger)}select,textarea,input{padding:.65rem;border:1px solid var(--border-default);border-radius:var(--radius-sm);background:var(--surface-page);color:inherit;font:inherit}button{width:max-content;min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}output{color:var(--text-muted);font-size:.8rem}@media(max-width:700px){.head{display:grid}.grid{grid-template-columns:1fr}dl{grid-template-columns:1fr}.panel{padding:var(--space-4)}}
</style>
