---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import OperationalState from '../../ui/components/feedback/OperationalState.astro';
import LoadingState from '../../ui/components/feedback/LoadingState.astro';
import StaleVersionState from '../../ui/components/feedback/StaleVersionState.astro';
import JourneyContextPanel from '../../ui/components/workflow/JourneyContextPanel.astro';
import HandoffTimeline from '../../ui/components/workflow/HandoffTimeline.astro';
import { isUuid } from '../../shared/id/uuid.js';
import { approvalsReadDependencies } from '../../modules/approvals/application/dependencies.js';
import {
  OWNER_APPROVAL_DEFERRAL,
  isOwnerApprovalPath,
} from '../../modules/approvals/application/owner-approval-policy.js';
import { classifyReadFailure, providerUnavailableResponse } from '../../shared/errors/read-failure.js';
import { stateLabel } from '../../shared/copy/ux-vocabulary.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const ownerPath = isOwnerApprovalPath(actor);
let approval: Awaited<ReturnType<ReturnType<typeof approvalsReadDependencies>['get']['execute']>> | undefined;
let readDenied = false;
if (isUuid(Astro.params.approvalId)) {
  try {
    approval = await approvalsReadDependencies().get.execute({ actor, approvalId: Astro.params.approvalId ?? '' });
  } catch (error) {
    const failure = classifyReadFailure(error);
    if (failure === 'UNAVAILABLE') {
      return providerUnavailableResponse('Approval details are temporarily unavailable', Astro.url.pathname + Astro.url.search);
    }
    readDenied = failure === 'DENIED';
  }
}
const readState = readDenied ? 'denied' : !approval ? 'missing' : undefined;
if (readState === 'denied') Astro.response.status = 403;
else if (readState === 'missing') Astro.response.status = 404;
if (readState) Astro.response.headers.set('Cache-Control', 'no-store');
const context = approval?.subject.reviewContext ?? {};
const humanSubjectType: Record<string, string> = {
  DOCUMENT_VERSION: 'Controlled document version',
  INSPECTION_REPORT: 'Inspection report',
  LAB_TEST: 'Laboratory test',
  CHANGE_REQUEST: 'Change request',
};
const subjectLabel = approval
  ? String(
      context['documentNo'] ??
        context['inspectionNo'] ??
        context['labTestNo'] ??
        context['calibrationNo'] ??
        context['changeNo'] ??
        humanSubjectType[approval.approvalCase.subjectType] ??
        'Controlled record',
    )
  : 'Approval review';
const humanize = (key: string): string =>
  key
    .replaceAll(/([a-z])([A-Z])/g, '$1 $2')
    .replaceAll(/[_-]+/g, ' ')
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
const contextLabel = (key: string): string => humanize(key);
const contextUuid = (key: string): string | undefined => typeof context[key] === 'string' && isUuid(context[key]) ? context[key] : undefined;
const subjectHref = contextUuid('documentId') ? `/documents/${contextUuid('documentId')}` : contextUuid('inspectionId') ? `/quarantine/inspections/${contextUuid('inspectionId')}` : contextUuid('labTestId') ? `/laboratory/tests/${contextUuid('labTestId')}` : contextUuid('calibrationId') ? `/assets/calibrations/${contextUuid('calibrationId')}` : undefined;
const availableDecisions = approval?.decisionCapabilities.filter((capability) => capability.state === 'AVAILABLE') ?? [];
const policyBlockedDecisions = approval?.decisionCapabilities.filter((capability) => capability.state === 'POLICY_BLOCKED') ?? [];
const approvalActionable = availableDecisions.length > 0;
const approvalNextAction = approvalActionable ? (ownerPath ? 'Record your internal owner decision' : 'Submit a permitted controlled decision') : policyBlockedDecisions.length ? 'Decision blocked pending approved signature policy' : 'No permitted decision is available';
const approvalNextOwner = approvalActionable ? (ownerPath ? 'System Owner (yazeed)' : (approval?.workItem.assignedRoleRequirement ?? 'Assigned approver')) : policyBlockedDecisions.length ? 'QMS signature-policy owner' : 'Owning domain';
const decisionLabel: Record<string, string> = { APPROVE: 'Approve', RETURN: 'Return for correction', REJECT: 'Reject' };
const hasRequiredSignature = availableDecisions.some((capability) => capability.signature === 'REQUIRED');
const ownerSignatureDeferred = availableDecisions.some((capability) => capability.signatureDeferred === true);
const approvalEvents = approval ? [
  { label: 'Approval requested', detail: approval.approvalCase.requestedAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' }), kind: 'business' as const },
  ...(approval.workItem.assignedAt ? [{ label: 'Approval work item assigned', detail: approval.workItem.assignedAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' }), kind: 'approval' as const }] : []),
  ...(approval.workItem.startedAt ? [{ label: 'Review started', detail: approval.workItem.startedAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' }), kind: 'approval' as const }] : []),
  { label: 'Source transition', detail: 'The owning domain applies the business transition after approval verification.', kind: 'business' as const },
] : [];
const auditHref = approval
  ? `/audit?subjectType=${encodeURIComponent(approval.approvalCase.subjectType)}&subjectId=${encodeURIComponent(approval.approvalCase.subjectId)}`
  : '/audit';
const workItemState = stateLabel(approval?.workItem.state);
const caseState = stateLabel(approval?.approvalCase.state);
const subjectState = stateLabel(approval?.subject.state);
const requestedAt = approval?.approvalCase.requestedAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' });
const workItemCompletedAt = approval?.workItem.completedAt?.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' });
const workflowLabel = approval ? humanize(approval.approvalCase.workflowType) : '';
---
<AppLayout title={`Approval · ${subjectLabel}`} locale="en" direction="ltr">
  {!approval ? <OperationalState state={readState === 'denied' ? 'denied' : 'empty'} title={readState === 'denied' ? 'Approval is not available to this account' : 'Approval case not found'} description={readState === 'denied' ? 'Your account cannot read this assigned approval. Return to My approvals or check your approved assignment and permission.' : 'No approval case matches this request. Return to My approvals to choose a current item.'} actionLabel="Return to My approvals" actionHref="/approvals" /> : (
    <article class="evidence-record approval-record" data-record-id={approval.approvalCase.id} data-version={approval.subject.version.toString()}>
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/approvals">My approvals</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{subjectLabel}</span>
      </nav>

      <header class="record-head">
        <div class="record-identity">
          <p class="eyebrow">Approval review</p>
          <h1>{subjectLabel}</h1>
          <p class="record-lede">{humanSubjectType[approval.approvalCase.subjectType] ?? 'Controlled record'} · {humanize(approval.approvalCase.workflowType)}</p>
          <div class="record-meta">
            <StatusBadge status="REVIEW" label={`Work item: ${workItemState}`} />
            <span class="version-chip">Version <strong>{approval.subject.version.toString()}</strong></span>
          </div>
        </div>
      </header>

      <JourneyContextPanel recordReference={`${subjectLabel} · version ${approval.subject.version.toString()}`} ownerDomain={approval.subject.domain ?? 'Reviews & Approvals'} currentState={`${approval.approvalCase.state} · Work item ${approval.workItem.state}`} nextAction={approvalNextAction} nextActionHref={subjectHref} nextOwner={approvalNextOwner} whyUnavailable={!approvalActionable ? policyBlockedDecisions.length ? 'policy: the required decision signature policy has no approved action-specific source' : 'authority or state: no supported decision is available to this actor for the current work item' : undefined} waitingOn={approvalActionable ? approvalNextOwner : policyBlockedDecisions.length ? 'QMS signature-policy owner' : 'Owning domain'} expectedEvent={approvalActionable ? 'Controlled decision' : 'Approved policy source or current owning-domain state'} controlledContext={`${humanSubjectType[approval.approvalCase.subjectType] ?? approval.approvalCase.subjectType} · version ${approval.subject.version.toString()}`} evidenceSummary={approval.subject.snapshotHash ? 'Controlled snapshot hash available' : 'Snapshot hash not available from owning domain'} auditHref={auditHref} relatedLinks={subjectHref ? [{ label: subjectLabel, href: subjectHref, detail: 'Open owning-domain record' }] : [{ label: 'My approvals', href: '/approvals', detail: 'Approval queue' }]} />

      <div class="approval-layout">
        <div class="approval-main">
          <section class="panel" aria-labelledby="facts-title">
            <h2 id="facts-title">Recorded facts</h2>
            <p class="panel-note">Read-only values recorded by the owning domain and the approval case.</p>
            <dl class="facts-grid">
              <div><dt>Workflow</dt><dd class="long-value">{humanize(approval.approvalCase.workflowType)}</dd></div>
              <div><dt>Version under review</dt><dd class="numeric-value">{approval.subject.version.toString()}</dd></div>
              <div><dt>Requester</dt><dd>Recorded in the controlled audit trail</dd></div>
              <div><dt>Subject state</dt><dd>{subjectState}</dd></div>
              <div><dt>Work item</dt><dd>{workItemState} · Step {approval.workItem.stepNo.toString()}</dd></div>
              <div><dt>Approval case</dt><dd>{caseState}</dd></div>
              <div><dt>Requested</dt><dd class="numeric-value">{requestedAt}</dd></div>
              <div><dt>Work item completed</dt><dd class="numeric-value">{workItemCompletedAt ?? 'Not recorded'}</dd></div>
            </dl>
          </section>

          <section class="panel" aria-labelledby="context-title">
            <h2 id="context-title">Review context</h2>
            {Object.keys(context).length ? (
              <dl class="context-grid">
                {Object.entries(context).map(([key, value]) => (
                  <div>
                    <dt>{contextLabel(key)}</dt>
                    <dd>{typeof value === 'string' || typeof value === 'number' ? String(value).match(/^[0-9a-f]{8}-[0-9a-f-]{27,}$/i) ? 'Available in the controlled record' : String(value) : value ? 'Available' : 'Not available'}</dd>
                  </div>
                ))}
              </dl>
            ) : <p class="muted">No additional review context was supplied by the owning domain.</p>}
          </section>

          <section class="panel evidence" aria-labelledby="evidence-title">
            <h2 id="evidence-title">Evidence</h2>
            <p class="panel-note">Integrity and trace references recorded for this subject. This view does not create evidence.</p>
            <dl class="evidence-grid">
              <div><dt>Integrity reference</dt><dd>{approval.subject.snapshotHash ? 'Available in the controlled record' : 'Not available from the owning domain'}</dd></div>
              <div><dt>Evidence scope</dt><dd>{humanSubjectType[approval.approvalCase.subjectType] ?? 'Controlled record'} · version {approval.subject.version.toString()}</dd></div>
            </dl>
            <ul class="evidence-links">
              <li><a href={auditHref}>View audit history for this record</a></li>
              {subjectHref ? <li><a href={subjectHref}>Open the owning-domain record</a></li> : null}
            </ul>
          </section>

          <HandoffTimeline events={approvalEvents} />
        </div>

        <aside class="approval-rail" aria-label="Current action">
          <section class="panel decision" aria-labelledby="action-title">
            <h2 id="action-title">Current action</h2>
            <p class="panel-note">Recorded facts are read-only. A decision is offered only when the server resolves it for your account, assignment, scope, current version, and separation of duties.</p>
            {approvalActionable ? <><p class="decision-explain">Only decisions supported by this subject's wired handler and currently authorized for your assignment, scope, state, version, and SoD are listed. A successful signature alone never changes the subject.</p><form method="post" data-approval-decision><input type="hidden" name="approvalId" value={approval.approvalCase.id} /><input type="hidden" name="workItemId" value={approval.workItem.id} /><input type="hidden" name="subjectVersion" value={approval.subject.version.toString()} /><label for="decision">Decision<select id="decision" name="decision">{availableDecisions.map((capability) => <option value={capability.decision}>{decisionLabel[capability.decision] ?? capability.decision}</option>)}</select></label><label for="reason">Reason / comments<span id="reason-help" class="hint">Required for Return or Reject when offered.</span><span id="reason-error" role="alert" hidden>Enter a reason before returning or rejecting.</span><textarea id="reason" name="reason" rows="4" maxlength="4000" aria-describedby="reason-help reason-error"></textarea></label>{ownerPath && <p class="owner-decision-note" role="note">Owner-Controlled Internal Approval: your decision is recorded once, under your authenticated account, with its exact authority, resulting state and audit event. The electronic-signature ceremony is deferred by owner decision <code>{OWNER_APPROVAL_DEFERRAL.decisionId}</code> dated {OWNER_APPROVAL_DEFERRAL.decidedOn}; this record is not an electronic signature, no intermediate Supervisor or QCM approval is created, and an internal release decision never authorizes physical product release.</p>}{hasRequiredSignature && !ownerPath && <><p class="signing-meaning">{availableDecisions.filter((capability) => capability.signature === 'REQUIRED').map((capability) => capability.meaning).filter(Boolean).join(' ')}</p><label for="reauthenticationSecret">Re-enter your password to sign this decision<input id="reauthenticationSecret" name="reauthenticationSecret" type="password" autocomplete="current-password" aria-describedby="signature-help" /></label><span id="signature-help" class="hint">The password is used only to reauthenticate this signing action and is not retained.</span></>}{ownerPath && ownerSignatureDeferred && <span id="owner-help" class="hint">Signature ceremony deferred — no password re-entry is required for this internal owner decision.</span>}<button type="submit" data-submit>{ownerPath ? 'Approve as System Owner' : 'Submit controlled decision'}</button><div class="action-feedback"><div data-loading-state hidden><LoadingState label="Checking authorization and controlled evidence" rows={3} /></div><div data-stale-state hidden><StaleVersionState version={approval.subject.version.toString()} /></div><output data-result aria-live="polite" tabindex="-1"></output></div><a data-recovery hidden href={Astro.url.pathname}>Reload the current approval before retrying</a></form></> : approval.workItem.state === 'PENDING' || approval.workItem.state === 'IN_PROGRESS' ? <div class="blocked-action" role="status"><h3>{policyBlockedDecisions.length ? 'Decision unavailable' : 'Review only'}</h3>{policyBlockedDecisions.length ? <p>The action-specific electronic-signature policy has not been approved. This decision is blocked before reauthentication. Contact the QMS signature-policy owner. You can review the subject and its current version here; no password field or decision control is available.</p> : <p>No supported decision is currently authorized for your assignment and the subject's scope, state, version, and separation-of-duties rules. Review the subject or return to My approvals; do not retry with a password.</p>}</div> : <div class="blocked-action" role="status"><h3>No current action</h3><p>The work item is recorded as {workItemState}. No decision is available now; any further transition belongs to the owning domain.</p></div>}
          </section>
        </aside>
      </div>
    </article>
  )}
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  import { classifyActionResult } from '../../ui/forms/mutation-interaction.js';
  const form = document.querySelector<HTMLFormElement>('[data-approval-decision]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || form.getAttribute('aria-busy') === 'true') return;
    const button = form.querySelector<HTMLButtonElement>('[data-submit], button[type="submit"]');
    const decision = form.querySelector<HTMLSelectElement>('#decision');
    const reason = form.querySelector<HTMLTextAreaElement>('#reason');
    const reasonError = form.querySelector<HTMLElement>('#reason-error');
    const secret = form.querySelector<HTMLInputElement>('#reauthenticationSecret');
    const requiresReason = decision?.value === 'RETURN' || decision?.value === 'REJECT';
    if (reason) reason.required = Boolean(requiresReason);
    if (requiresReason && !reason?.value.trim()) {
      reason?.setAttribute('aria-invalid', 'true');
      if (reasonError) reasonError.hidden = false;
      reason?.focus();
      return;
    }
    reason?.removeAttribute('aria-invalid');
    if (reasonError) reasonError.hidden = true;
    const output = form.querySelector<HTMLOutputElement>('[data-result]');
    form.setAttribute('aria-busy', 'true');
    const page = form.closest('.evidence-record');
    const loading = page?.querySelector<HTMLElement>('[data-loading-state]');
    const stale = page?.querySelector<HTMLElement>('[data-stale-state]');
    if (loading) loading.hidden = false;
    if (stale) stale.hidden = true;
    if (button) button.disabled = true;
    if (output) output.textContent = 'Checking authorization and controlled evidence…';
    try {
      const data = new FormData(form);
      const result = await actions.approvals.decide({ approvalId: String(data.get('approvalId')), workItemId: String(data.get('workItemId')), subjectVersion: BigInt(String(data.get('subjectVersion'))), decision: String(data.get('decision')) as 'APPROVE' | 'RETURN' | 'REJECT', reason: String(data.get('reason') ?? '') || undefined, reauthenticationSecret: String(data.get('reauthenticationSecret') ?? '') || undefined });
      const outcome = classifyActionResult(result as unknown as { data?: { id?: string }; error?: unknown });
      if (outcome.state === 'SUCCESS') { window.location.href = '/approvals'; return; }
      if (outcome.state === 'CONFLICT_STALE' && stale) stale.hidden = false;
      if (outcome.state === 'CONFLICT_STALE' || outcome.state === 'UNKNOWN_SAFE_ERROR') {
        form.dataset.recoveryRequired = 'true';
        const recovery = form.querySelector<HTMLAnchorElement>('[data-recovery]');
        if (recovery) recovery.hidden = false;
      }
      const copy: Record<string, string> = {
        VALIDATION_ERROR: 'The decision was not accepted. A reason is required for return/reject — review the fields and try again. Your entries are preserved.',
        CONFLICT_STALE: 'The record changed while you were reviewing it. Reload the current record and try again if permitted. Your reason was kept.',
        AUTHORIZATION_CHANGED: 'Your authorization changed. Check your approval permission and any signature requirement. Your entries remain on this page.',
        DEPENDENCY_UNAVAILABLE: 'The approval record is no longer available. Reload the record before trying again.',
        UNKNOWN_SAFE_ERROR: 'The result is unconfirmed. Your entries remain on this page. Check the record and its history before trying again.',
      };
      if (output) { output.textContent = copy[outcome.state] ?? copy.UNKNOWN_SAFE_ERROR; output.focus?.(); }
    } catch {
      form.dataset.recoveryRequired = 'true';
      const recovery = form.querySelector<HTMLAnchorElement>('[data-recovery]');
      if (recovery) recovery.hidden = false;
      if (output) { output.textContent = 'The result is unconfirmed. Your entries remain on this page. Check the record and its history before trying again.'; output.focus?.(); }
    } finally { if (secret) secret.value = ''; if (loading) loading.hidden = true; form.removeAttribute('aria-busy'); if (button) button.disabled = form.dataset.recoveryRequired === 'true'; }
  });
  form?.querySelector<HTMLSelectElement>('#decision')?.addEventListener('change', (event) => {
    const decision = event.currentTarget as HTMLSelectElement;
    const reason = form?.querySelector<HTMLTextAreaElement>('#reason');
    if (reason) reason.required = decision.value === 'RETURN' || decision.value === 'REJECT';
    reason?.removeAttribute('aria-invalid');
    const reasonError = form?.querySelector<HTMLElement>('#reason-error');
    if (reasonError) reasonError.hidden = true;
  });
</script>
<style>
  .approval-record { max-inline-size: 1120px; margin-inline: auto; min-inline-size: 0; }
  .crumb { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-block-end: var(--space-4); color: var(--text-muted); font-size: var(--font-size-xs); }
  .crumb a { display: inline-flex; align-items: center; min-block-size: 44px; color: var(--color-accent-primary-hover); font-weight: 600; }
  .crumb span[aria-current='page'] { min-inline-size: 0; overflow-wrap: anywhere; }
  .record-head { margin-block-end: var(--space-5); padding: var(--space-5); border: 1px solid var(--border-default); border-radius: var(--radius-lg); background: var(--surface-panel); }
  .record-identity { min-inline-size: 0; }
  .record-head h1 { margin: var(--space-1) 0 var(--space-2); overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
  .eyebrow { margin: 0; color: var(--text-muted); font-size: var(--font-size-xs); font-weight: 700; letter-spacing: 0; text-transform: none; }
  .record-lede { margin: 0; color: var(--text-secondary); font-size: var(--font-size-sm); line-height: 1.5; overflow-wrap: anywhere; }
  .record-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-block-start: var(--space-4); }
  .version-chip { display: inline-flex; align-items: baseline; gap: var(--space-2); padding: var(--space-1) var(--space-3); border: 1px solid var(--color-border-default); border-radius: 999px; color: var(--text-muted); font-size: var(--font-size-xs); font-variant-numeric: tabular-nums; }
  .version-chip strong { color: var(--text-primary); font-size: var(--font-size-sm); }
  .approval-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 22rem); gap: var(--space-5); align-items: start; }
  .approval-main, .approval-rail { display: grid; gap: var(--space-5); align-content: start; min-inline-size: 0; }
  .panel { min-inline-size: 0; padding: var(--space-5); border: 1px solid var(--color-border-default); border-radius: var(--radius-lg); background: var(--surface-panel); }
  .panel h2 { margin: 0; font-size: var(--font-size-lg); }
  .panel-note { margin: var(--space-2) 0 0; max-inline-size: 65ch; color: var(--text-muted); font-size: var(--font-size-xs); line-height: 1.55; }
  .facts-grid, .context-grid, .evidence-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3) var(--space-4); margin: var(--space-4) 0 0; }
  .facts-grid > div, .context-grid > div, .evidence-grid > div { min-inline-size: 0; padding-block-start: var(--space-3); border-block-start: 1px solid var(--color-border-subtle); }
  dt { color: var(--text-muted); font-size: var(--font-size-xs); line-height: 1.4; }
  dd { margin: var(--space-1) 0 0; color: var(--text-primary); font-size: var(--font-size-sm); font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
  .long-value, .context-grid dd { word-break: normal; }
  .numeric-value { font-variant-numeric: tabular-nums; }
  .muted { margin: var(--space-3) 0 0; color: var(--text-muted); font-size: var(--font-size-sm); line-height: 1.5; }
  .evidence-links { display: grid; gap: var(--space-2); margin: var(--space-4) 0 0; padding: 0; list-style: none; }
  .evidence-links a { display: inline-flex; align-items: center; min-block-size: 44px; color: var(--color-accent-primary-hover); font-size: var(--font-size-sm); font-weight: 600; overflow-wrap: anywhere; }
  /* The shared journey strip inherits `overflow-wrap: anywhere` from the
     workspace; on narrow screens that breaks words such as PENDING mid-word.
     Break-word keeps whole words and still wraps unbreakable identifiers. */
  .approval-record [data-record-header] .record-state,
  .approval-record .journey-panel :where(.state-value, p, li, a) { overflow-wrap: break-word; word-break: normal; }
  .decision { border-block-start: 3px solid var(--color-accent-primary); }
  .decision-explain { margin: var(--space-3) 0 0; color: var(--text-secondary); font-size: var(--font-size-xs); line-height: 1.55; }
  .decision form { display: grid; gap: var(--space-4); margin-block-start: var(--space-4); }
  .decision label { display: grid; gap: var(--space-2); color: var(--text-secondary); font-size: var(--font-size-sm); }
  .decision select, .decision textarea, .decision input { inline-size: 100%; min-inline-size: 0; padding: var(--space-2) var(--space-3); border: 1px solid var(--control-border); border-radius: var(--radius-sm); background: var(--input-background); color: var(--text-primary); font: inherit; font-size: var(--font-size-sm); }
  .decision textarea { min-block-size: 6rem; resize: vertical; }
  .decision select, .decision input { min-block-size: 44px; }
  .decision :where(select, textarea, input):focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .decision input[aria-invalid='true'], .decision textarea[aria-invalid='true'], .decision select[aria-invalid='true'] { border-color: var(--border-invalid); }
  .hint { color: var(--text-muted); font-size: var(--font-size-xs); line-height: 1.45; }
  #reason-error { color: var(--text-danger); font-size: var(--font-size-xs); }
  .signing-meaning { margin: 0; padding: var(--space-3); border-inline-start: 3px solid var(--status-warning); background: var(--surface-inset); color: var(--text-secondary); font-size: var(--font-size-xs); line-height: 1.55; }
  .owner-decision-note { margin: 0; padding: var(--space-3); border-inline-start: 3px solid var(--color-accent-primary); background: var(--surface-inset); color: var(--text-secondary); font-size: var(--font-size-xs); line-height: 1.55; overflow-wrap: anywhere; }
  .owner-decision-note code { font-size: var(--font-size-xs); overflow-wrap: anywhere; }
  .decision button { inline-size: 100%; min-block-size: 44px; padding: var(--space-2) var(--space-4); border: 1px solid var(--color-accent-primary); border-radius: var(--radius-sm); background: var(--color-accent-primary); color: var(--text-on-accent); font: inherit; font-weight: 700; white-space: normal; cursor: pointer; }
