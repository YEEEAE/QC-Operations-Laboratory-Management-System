---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import { approvalsReadDependencies } from '../../modules/approvals/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fapprovals');
const approvals = await approvalsReadDependencies().list.execute({ actor }).catch(() => []);
---
<AppLayout title="My Approvals · QC Operations" locale="en" direction="ltr">
  <section class="head"><div><p class="eyebrow">UI-APR-001 · CONTROLLED WORK QUEUE</p><h1>My Approvals</h1><p>Only approval work items that are assigned, scoped, current, and actionable for your account are shown.</p></div><span class="count" aria-label={`${approvals.length} actionable approvals`}>{approvals.length}</span></section>
  {approvals.length ? <div class="table-wrap"><table><caption>Authorized approval work queue</caption><thead><tr><th scope="col">Subject</th><th scope="col">Workflow</th><th scope="col">Submitted by</th><th scope="col">Version</th><th scope="col">State</th><th scope="col">Action</th></tr></thead><tbody>{approvals.map((item) => <tr><th scope="row"><a href={`/approvals/${item.approvalCase.id}`}>{item.subject.reviewContext['documentNo'] ?? item.subject.reviewContext['inspectionNo'] ?? item.subject.reviewContext['labTestNo'] ?? item.approvalCase.subjectType}</a><small>{item.approvalCase.subjectType} · {item.approvalCase.subjectId}</small></th><td>{item.approvalCase.workflowType}</td><td>{item.approvalCase.requestedBy}</td><td>{item.subject.version.toString()}</td><td><StatusBadge status="REVIEW" label={item.workItem.state} /></td><td><a class="open" href={`/approvals/${item.approvalCase.id}`}>Open review</a></td></tr>)}</tbody></table></div> : <section class="empty"><h2>No actionable approvals</h2><p>Items outside your assignment, scope, current state, or version are intentionally excluded.</p></section>}
</AppLayout>
<style>
  .head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.empty p{color:var(--text-muted);font-size:.85rem}.count{min-width:3rem;min-height:3rem;display:grid;place-items:center;border:1px solid var(--color-accent-primary);border-radius:var(--radius-md);color:var(--color-accent-primary-hover);font-size:1.3rem;font-weight:800}.table-wrap{overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:900px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted);font-size:.8rem}th,td{padding:.85rem;text-align:start;border-top:1px solid var(--color-border-subtle);font-size:.8rem}th{font-weight:700}th small{display:block;margin-top:.25rem;color:var(--text-muted);font-weight:400;font-size:.7rem}a{color:var(--color-accent-primary-hover)}.open{font-weight:700}.empty{padding:var(--space-8);text-align:center;background:var(--surface-panel);border:1px dashed var(--color-border-strong);border-radius:var(--radius-lg)}.empty h2{margin:0 0 .5rem}@media(max-width:650px){.head{display:grid}}
</style>
