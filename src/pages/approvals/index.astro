---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import ProviderUnavailableState from '../../ui/components/feedback/ProviderUnavailableState.astro';
import OperationalState from '../../ui/components/feedback/OperationalState.astro';
import { approvalsReadDependencies } from '../../modules/approvals/application/dependencies.js';
import {
  stateLabel,
  workflowTypeLabel,
} from '../../shared/copy/ux-vocabulary.js';
import { identityAdminReadDependencies } from '../../modules/identity/application/admin-dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fapprovals');
let approvals: Awaited<ReturnType<ReturnType<typeof approvalsReadDependencies>['list']['execute']>> = [];
let providerUnavailable = false;
try { approvals = await approvalsReadDependencies().list.execute({ actor }); } catch { providerUnavailable = true; }
// The queue names the requester and subject type in human words, never a raw
// account identifier. Resolution is presentation-only and failure-tolerant.
let requesterNames = new Map<string, string>();
try {
  requesterNames = new Map(
    (await identityAdminReadDependencies().listUsers.execute({ actor })).map((user) => [
      user.id,
      user.displayName,
    ]),
  );
} catch {
  // Presentation-only; fall back to a named-account label below.
}
const requesterLabel = (requesterId: string | null | undefined) =>
  requesterId ? (requesterNames.get(requesterId) ?? 'Named account') : 'Not recorded';
---
<AppLayout title="My Approvals · QC Operations" locale="en" direction="ltr">
  <div class="scientific-register">
  <section class="head workspace-header"><div><p class="eyebrow">Approvals</p><h1>My Approvals</h1><p>Only approval work items that are assigned, scoped, current, and actionable for your account are shown.</p></div>{!providerUnavailable && <span class="count" aria-label={`${approvals.length} actionable approvals`}>{approvals.length}</span>}</section>
  {providerUnavailable ? <ProviderUnavailableState title="Approval queue is unavailable" description="The approvals provider did not return a confirmed actionable count, so the queue is not shown as empty." /> : approvals.length ? <div class="table-wrap"><table><caption>Authorized approval work queue</caption><thead><tr><th scope="col">Subject</th><th scope="col">Workflow</th><th scope="col">Submitted by</th><th scope="col">Version</th><th scope="col">State</th><th scope="col">Action</th></tr></thead><tbody>{approvals.map((item) => <tr><th scope="row"><a href={`/approvals/${item.approvalCase.id}`}>{item.subject.reviewContext['documentNo'] ?? item.subject.reviewContext['inspectionNo'] ?? item.subject.reviewContext['labTestNo'] ?? stateLabel(item.approvalCase.subjectType)}</a><small>{stateLabel(item.approvalCase.subjectType)} · {item.approvalCase.subjectId}</small></th><td>{workflowTypeLabel(item.approvalCase.workflowType)}</td><td>{requesterLabel(item.approvalCase.requestedBy)}</td><td>{item.subject.version.toString()}</td><td><StatusBadge status="REVIEW" label={stateLabel(item.workItem.state)} /></td><td><a class="open" href={`/approvals/${item.approvalCase.id}`}>Open review</a></td></tr>)}</tbody></table></div> : <OperationalState state="empty" title="No actionable approvals" description="Items outside your assignment, scope, current state, or version are intentionally excluded." />}
  </div>
</AppLayout>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.empty p{color:var(--text-muted);font-size:.85rem}.count{min-width:3rem;min-height:3rem;display:grid;place-items:center;border:1px solid var(--color-accent-primary);border-radius:var(--radius-md);color:var(--color-accent-primary-hover);font-size:1.3rem;font-weight:800}.table-wrap{overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:900px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted);font-size:.8rem}th,td{padding:.85rem;text-align:start;border-top:1px solid var(--color-border-subtle);font-size:.8rem}th{font-weight:700}th small{display:block;margin-top:.25rem;color:var(--text-muted);font-weight:400;font-size:.7rem}a{color:var(--color-accent-primary-hover)}.open{font-weight:700}.empty{padding:var(--space-8);text-align:center;background:var(--surface-panel);border:1px dashed var(--color-border-strong);border-radius:var(--radius-lg)}.empty h2{margin:0 0 .5rem}@media(max-width:650px){.head{display:grid}}</style>
