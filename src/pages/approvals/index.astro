---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import PageHeader from '../../ui/components/PageHeader.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import ProviderUnavailableState from '../../ui/components/feedback/ProviderUnavailableState.astro';
import OperationalState from '../../ui/components/feedback/OperationalState.astro';
import { approvalsReadDependencies } from '../../modules/approvals/application/dependencies.js';
import {
  stateLabel,
  workflowTypeLabel,
} from '../../shared/copy/ux-vocabulary.js';
import { identityAdminReadDependencies } from '../../modules/identity/application/admin-dependencies.js';
import { isOwnerApprovalPath } from '../../modules/approvals/application/owner-approval-policy.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fapprovals');
const ownerPath = isOwnerApprovalPath(actor);
let approvals: Awaited<ReturnType<ReturnType<typeof approvalsReadDependencies>['list']['execute']>> = [];
let providerUnavailable = false;
const approvalReads = approvalsReadDependencies();
try { approvals = await approvalReads.list.execute({ actor }); } catch { providerUnavailable = true; }
// The queue names the requester and subject type in human words, never a raw
// account identifier. Resolution is presentation-only and failure-tolerant.
let requesterNames = new Map<string, string>();
try {
  requesterNames = new Map(
    (await identityAdminReadDependencies().listUsers.execute({ actor })).map((user) => [
      user.id,
      user.displayName,
    ]),
  );
} catch {
  // Presentation-only; fall back to a named-account label below.
}
const requesterLabel = (requesterId: string | null | undefined) =>
  requesterId ? (requesterNames.get(requesterId) ?? 'Named account') : 'Not recorded';
const subjectTypeLabel: Record<string, string> = {
  DOCUMENT_VERSION: 'Controlled document version',
  INSPECTION_REPORT: 'Inspection report',
  LAB_TEST: 'Laboratory test',
  CHANGE_REQUEST: 'Change request',
};
const decisionStatus = (capabilities: typeof approvals[number]['decisionCapabilities']): { label: string; status: 'INFO' | 'WARNING'; reason: string } => {
  if (capabilities.some((item) => item.state === 'AVAILABLE')) return { label: 'Decision available', status: 'INFO', reason: 'Review the current subject before deciding.' };
  if (capabilities.some((item) => item.state === 'POLICY_BLOCKED')) return { label: 'Policy blocked', status: 'WARNING', reason: 'Signature policy unresolved; QMS signature-policy owner.' };
  if (capabilities.some((item) => item.state === 'STALE')) return { label: 'Version changed', status: 'WARNING', reason: 'Reload the current subject before review.' };
  if (capabilities.some((item) => item.state === 'NOT_AUTHORIZED')) return { label: 'Review only', status: 'INFO', reason: 'Current assignment, scope or separation-of-duties rules prevent a decision.' };
  if (capabilities.some((item) => item.state === 'UNSUPPORTED')) return { label: 'Review only', status: 'INFO', reason: 'The owning domain has no supported decision handler.' };
  return { label: 'No current decision', status: 'INFO', reason: 'The work item is not actionable in its current state.' };
};
const subjectLabel = (item: typeof approvals[number]) => {
  const context = item.subject.reviewContext;
  return String(
    context['documentNo'] ??
      context['inspectionNo'] ??
      context['labTestNo'] ??
      context['changeNo'] ??
      context['calibrationNo'] ??
      subjectTypeLabel[item.approvalCase.subjectType] ??
      'Controlled record',
  );
};
const workItemCountLabel = `${approvals.length} assigned approval work item${approvals.length === 1 ? '' : 's'}`;
---
<AppLayout title="My approvals · QC Operations" locale="en" direction="ltr">
  <div class="scientific-register approvals-register">
  <PageHeader title={ownerPath ? 'Owner approval command center' : 'My approvals'} purpose={ownerPath ? 'Every actionable controlled record is listed for your direct internal owner decision. Your approval is recorded once under your account; it is an internal owner approval, not an electronic signature, and it never authorizes physical product release.' : 'Assigned approval work is listed with its current decision status. Permission to review does not by itself make a decision available.'} />
  {ownerPath && <section class="policy-note owner-note" role="status"><h2>Owner-Controlled Internal Approval</h2><p>Signatures, handwritten signatures and mandatory internal multi-person approval are deferred by owner decision <code>{approvalReads.ownerApprovalDeferral.decisionId}</code> dated {approvalReads.ownerApprovalDeferral.decidedOn}. A decision you take here is a durable internal owner approval: it is recorded under your account with its authority, state change and audit event, it is not labelled as an electronic signature, and an internal release decision does not authorize physical product release.</p></section>}
  {approvalReads.decisionPolicyStatus === 'UNRESOLVED' && <section class="policy-note" role="status"><h2>Decision signing policy unresolved</h2><p>The approved signature requirements for generic approval decisions are not available yet. Any affected decision remains blocked before reauthentication. Contact the QMS signature-policy owner; review the subject and its current version, and do not enter a password for a blocked decision.</p></section>}
  {approvalReads.decisionPolicyStatus === 'PARTIAL' && <section class="policy-note" role="status"><h2>Some decisions now require a signature</h2><p>Change-request authorization requires an account-bound electronic signature with your password reauthentication. Other generic decision types still have no approved signature policy and remain blocked before reauthentication. Do not enter a password for a blocked decision.</p></section>}
  {providerUnavailable ? <ProviderUnavailableState title="Approval queue is unavailable" description="Approvals could not be loaded. The queue and count are unavailable; this does not mean no approvals are waiting." /> : (
    <section class="approvals-register-body" aria-labelledby="approvals-register-title">
      <h2 id="approvals-register-title" class="sr-only">Assigned approval work</h2>
      <p class="result-count" role="status">{workItemCountLabel}</p>
      {approvals.length ? (
        <>
          <div class="table-wrap" role="region" aria-label="Assigned approval work" tabindex="0">
            <table>
              <caption>Approval work assigned to your account or role and permitted for review. Work item state is recorded; decision availability is recalculated from the current server-side assignment, scope, version and policy checks.</caption>
              <thead>
                <tr>
                  <th scope="col">Subject</th>
                  <th scope="col">Workflow</th>
                  <th scope="col">Submitted by</th>
                  <th scope="col">Current version</th>
                  <th scope="col">Work item state</th>
                  <th scope="col">Decision availability</th>
                </tr>
              </thead>
              <tbody>
                {approvals.map((item) => {
                  const decision = decisionStatus(item.decisionCapabilities);
                  const subject = subjectLabel(item);
                  return (
                    <tr>
                      <th scope="row">
                        <a class="subject-link" href={`/approvals/${item.approvalCase.id}`}>{subject}</a>
                        <small class="subject-meta">{subjectTypeLabel[item.approvalCase.subjectType] ?? 'Controlled record'} · {stateLabel(item.approvalCase.state)}</small>
                      </th>
                      <td class="long-value">{workflowTypeLabel(item.approvalCase.workflowType)}</td>
                      <td class="long-value">{requesterLabel(item.approvalCase.requestedBy)}</td>
                      <td class="numeric-value">{item.subject.version.toString()}</td>
                      <td><StatusBadge status="REVIEW" label={stateLabel(item.workItem.state)} /></td>
                      <td class="decision-cell"><StatusBadge status={decision.status} label={decision.label} /><small class="decision-reason">{decision.reason}</small></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <ul class="approval-cards" aria-label="Assigned approval work">
            {approvals.map((item) => {
              const decision = decisionStatus(item.decisionCapabilities);
              const subject = subjectLabel(item);
              return (
                <li class="approval-card">
                  <article aria-labelledby={`approval-${item.approvalCase.id}-subject`}>
                    <h3 id={`approval-${item.approvalCase.id}-subject`}><a class="subject-link" href={`/approvals/${item.approvalCase.id}`}>{subject}</a></h3>
                    <p class="subject-meta">{subjectTypeLabel[item.approvalCase.subjectType] ?? 'Controlled record'} · {stateLabel(item.approvalCase.state)}</p>
                    <dl>
                      <div><dt>Workflow</dt><dd class="long-value">{workflowTypeLabel(item.approvalCase.workflowType)}</dd></div>
                      <div><dt>Submitted by</dt><dd class="long-value">{requesterLabel(item.approvalCase.requestedBy)}</dd></div>
                      <div><dt>Current version</dt><dd class="numeric-value">{item.subject.version.toString()}</dd></div>
                      <div><dt>Work item state</dt><dd><StatusBadge status="REVIEW" label={stateLabel(item.workItem.state)} /></dd></div>
                    </dl>
                    <div class="card-decision">
                      <p class="decision-label">Decision availability</p>
                      <StatusBadge status={decision.status} label={decision.label} />
                      <p class="decision-reason">{decision.reason}</p>
                    </div>
                  </article>
                </li>
              );
            })}
          </ul>
        </>
      ) : (
        <OperationalState state="empty" title="No assigned approval work" description={approvalReads.decisionPolicyStatus === 'UNRESOLVED' ? 'There are no approval work items currently visible to your account or role. Decision signing policy remains unresolved, so this empty list is not evidence that decisions are available.' : approvalReads.decisionPolicyStatus === 'PARTIAL' ? 'There are no approval work items currently visible to your account or role. Some decision types still have no approved signature policy, so this empty list is not evidence that every decision is available.' : 'There are no approval work items currently visible to your account or role.'} />
      )}
    </section>
  )}
  </div>
</AppLayout>
<style>
  .approvals-register { min-inline-size: 0; }
  .policy-note { margin-block-end: var(--space-5); padding: var(--space-4) var(--space-5); border: 1px solid var(--status-warning); border-inline-start-width: 4px; border-radius: var(--radius-md); background: var(--surface-panel); }
  .policy-note.owner-note { border-color: var(--color-accent-primary); }
  .policy-note h2 { margin: 0 0 var(--space-2); font-size: var(--font-size-md); }
  .policy-note p { margin: 0; max-inline-size: 78ch; color: var(--text-secondary); font-size: var(--font-size-xs); line-height: 1.55; overflow-wrap: anywhere; }
  .policy-note code { font-size: var(--font-size-xs); overflow-wrap: anywhere; }
  .approvals-register-body { min-inline-size: 0; }
  .result-count { margin: 0 0 var(--space-3); color: var(--text-secondary); font-size: var(--font-size-xs); line-height: 1.5; }
  .table-wrap { max-inline-size: 100%; overflow: auto; overscroll-behavior-inline: contain; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); background: var(--surface-panel); scrollbar-width: auto; }
  table { inline-size: 100%; min-inline-size: 56rem; border-collapse: collapse; background: var(--surface-panel); }
  caption { padding: var(--space-4) var(--space-4) var(--space-3); color: var(--text-secondary); text-align: start; font-size: var(--font-size-xs); line-height: 1.5; }
  th, td { padding: .8rem .75rem; border-block-start: 1px solid var(--color-border-subtle); text-align: start; vertical-align: top; }
  thead th { color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); white-space: nowrap; }
  tbody th { min-inline-size: 13rem; font-weight: var(--font-weight-semibold); }
  tbody tr:nth-child(even) { background: var(--surface-inset, var(--surface-page)); }
  .subject-link { display: inline-flex; align-items: center; min-block-size: 44px; color: var(--color-accent-primary-hover); font-weight: var(--font-weight-semibold); overflow-wrap: anywhere; word-break: normal; text-underline-offset: .18em; }
  .subject-meta { display: block; margin-block-start: var(--space-1); color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: var(--font-weight-regular); line-height: 1.45; overflow-wrap: anywhere; }
  .long-value { min-inline-size: 10rem; max-inline-size: 25rem; overflow-wrap: anywhere; word-break: normal; }
  .numeric-value { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .decision-cell { min-inline-size: 15rem; }
  .decision-reason { display: block; margin-block-start: var(--space-2); max-inline-size: 26rem; color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: var(--font-weight-regular); line-height: 1.5; overflow-wrap: anywhere; }
  .approval-cards { display: none; list-style: none; margin: 0; padding: 0; }
  .approval-card { padding: var(--space-4); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); background: var(--surface-panel); }
  .approval-card + .approval-card { margin-block-start: var(--space-3); }
  .approval-card h3 { margin: 0; font-size: var(--font-size-md); line-height: 1.35; }
  .approval-card .subject-link { font-size: inherit; }
  .approval-card .subject-meta { margin-block: var(--space-1) 0; }
  .approval-card dl { display: grid; gap: var(--space-2); margin: var(--space-4) 0 0; }
  .approval-card dl div { display: grid; grid-template-columns: minmax(7rem, .4fr) minmax(0, 1fr); gap: var(--space-3); padding-block-start: var(--space-2); border-block-start: 1px solid var(--color-border-subtle); }
  .approval-card dt { color: var(--text-secondary); font-size: var(--font-size-xs); }
  .approval-card dd { margin: 0; min-inline-size: 0; overflow-wrap: anywhere; word-break: normal; }
  .card-decision { margin-block-start: var(--space-4); padding-block-start: var(--space-3); border-block-start: 1px solid var(--color-border-subtle); }
  .decision-label { margin: 0 0 var(--space-2); color: var(--text-secondary); font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); }
  .card-decision .decision-reason { margin-block-start: var(--space-2); }
  .sr-only { position: absolute; inline-size: 1px; block-size: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  :where(.subject-link, .table-wrap):focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  @media (max-width: 900px) {
    .table-wrap { display: none; }
    .approval-cards { display: block; }
  }
  @media (max-width: 420px) {
    .approval-card dl div { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); }
  }
  @media (forced-colors: active) {
    .policy-note, .table-wrap, .approval-card, .card-decision { border-color: CanvasText; }
    :where(.subject-link, .table-wrap):focus-visible { outline: 2px solid Highlight; }
  }
  @media print {
    .table-wrap { display: block; overflow: visible; border-color: #333; }
    .approval-cards { display: none; }
    table { min-inline-size: 0; }
    .subject-link { color: #111; text-decoration: underline; }
  }
</style>
