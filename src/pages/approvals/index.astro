---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import PageHeader from '../../ui/components/PageHeader.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import ProviderUnavailableState from '../../ui/components/feedback/ProviderUnavailableState.astro';
import OperationalState from '../../ui/components/feedback/OperationalState.astro';
import { approvalsReadDependencies } from '../../modules/approvals/application/dependencies.js';
import {
  stateLabel,
  workflowTypeLabel,
} from '../../shared/copy/ux-vocabulary.js';
import { identityAdminReadDependencies } from '../../modules/identity/application/admin-dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fapprovals');
let approvals: Awaited<ReturnType<ReturnType<typeof approvalsReadDependencies>['list']['execute']>> = [];
let providerUnavailable = false;
const approvalReads = approvalsReadDependencies();
try { approvals = await approvalReads.list.execute({ actor }); } catch { providerUnavailable = true; }
// The queue names the requester and subject type in human words, never a raw
// account identifier. Resolution is presentation-only and failure-tolerant.
let requesterNames = new Map<string, string>();
try {
  requesterNames = new Map(
    (await identityAdminReadDependencies().listUsers.execute({ actor })).map((user) => [
      user.id,
      user.displayName,
    ]),
  );
} catch {
  // Presentation-only; fall back to a named-account label below.
}
const requesterLabel = (requesterId: string | null | undefined) =>
  requesterId ? (requesterNames.get(requesterId) ?? 'Named account') : 'Not recorded';
const subjectTypeLabel: Record<string, string> = {
  DOCUMENT_VERSION: 'Controlled document version',
  INSPECTION_REPORT: 'Inspection report',
  LAB_TEST: 'Laboratory test',
  CHANGE_REQUEST: 'Change request',
};
const decisionStatus = (capabilities: typeof approvals[number]['decisionCapabilities']): { label: string; status: 'INFO' | 'WARNING'; reason: string } => {
  if (capabilities.some((item) => item.state === 'AVAILABLE')) return { label: 'Decision available', status: 'INFO', reason: 'Review the current subject before deciding.' };
  if (capabilities.some((item) => item.state === 'POLICY_BLOCKED')) return { label: 'Policy blocked', status: 'WARNING', reason: 'Signature policy unresolved; QMS signature-policy owner.' };
  if (capabilities.some((item) => item.state === 'STALE')) return { label: 'Version changed', status: 'WARNING', reason: 'Reload the current subject before review.' };
  if (capabilities.some((item) => item.state === 'NOT_AUTHORIZED')) return { label: 'Review only', status: 'INFO', reason: 'Current assignment, scope or separation-of-duties rules prevent a decision.' };
  if (capabilities.some((item) => item.state === 'UNSUPPORTED')) return { label: 'Review only', status: 'INFO', reason: 'The owning domain has no supported decision handler.' };
  return { label: 'No current decision', status: 'INFO', reason: 'The work item is not actionable in its current state.' };
};
---
<AppLayout title="My approvals · QC Operations" locale="en" direction="ltr">
  <div class="scientific-register">
  <PageHeader title="My approvals" purpose="Assigned approval work is listed with its current decision status. Permission to review does not by itself make a decision available."><Fragment slot="actions">{!providerUnavailable && <span class="count" aria-label={`${approvals.length} assigned approval work items`}>{approvals.length}</span>}</Fragment></PageHeader>
  {approvalReads.decisionPolicyStatus === 'UNRESOLVED' && <section class="policy-note" role="status"><h2>Decision signing policy unresolved</h2><p>The approved signature requirements for generic approval decisions are not available yet. Any affected decision remains blocked before reauthentication. Contact the QMS signature-policy owner; review the subject and its current version, and do not enter a password for a blocked decision.</p></section>}
  {approvalReads.decisionPolicyStatus === 'PARTIAL' && <section class="policy-note" role="status"><h2>Some decisions now require a signature</h2><p>Change-request authorization requires an account-bound electronic signature with your password reauthentication. Other generic decision types still have no approved signature policy and remain blocked before reauthentication. Do not enter a password for a blocked decision.</p></section>}
  {providerUnavailable ? <ProviderUnavailableState title="Approval queue is unavailable" description="Approvals could not be loaded. The queue and count are unavailable; this does not mean no approvals are waiting." /> : approvals.length ? <div class="table-wrap" role="region" aria-label="Assigned approval work" tabindex="0"><table><caption>Approval work assigned to your account or role and permitted for review</caption><thead><tr><th scope="col">Subject</th><th scope="col">Workflow</th><th scope="col">Submitted by</th><th scope="col">Version</th><th scope="col">State</th><th scope="col">Decision status</th></tr></thead><tbody>{approvals.map((item) => { const decision = decisionStatus(item.decisionCapabilities); const context = item.subject.reviewContext; const subject = context['documentNo'] ?? context['inspectionNo'] ?? context['labTestNo'] ?? context['changeNo'] ?? context['calibrationNo'] ?? subjectTypeLabel[item.approvalCase.subjectType] ?? 'Controlled record'; return <tr><th scope="row"><a href={`/approvals/${item.approvalCase.id}`}>{subject}</a><small>{subjectTypeLabel[item.approvalCase.subjectType] ?? 'Controlled record'} · {stateLabel(item.approvalCase.state)}</small></th><td>{workflowTypeLabel(item.approvalCase.workflowType)}</td><td>{requesterLabel(item.approvalCase.requestedBy)}</td><td>{item.subject.version.toString()}</td><td><StatusBadge status="REVIEW" label={stateLabel(item.workItem.state)} /></td><td><StatusBadge status={decision.status} label={decision.label} /><small class="decision-reason">{decision.reason}</small></td></tr>; })}</tbody></table></div> : <OperationalState state="empty" title="No assigned approval work" description={approvalReads.decisionPolicyStatus === 'UNRESOLVED' ? 'There are no approval work items currently visible to your account or role. Decision signing policy remains unresolved, so this empty list is not evidence that decisions are available.' : approvalReads.decisionPolicyStatus === 'PARTIAL' ? 'There are no approval work items currently visible to your account or role. Some decision types still have no approved signature policy, so this empty list is not evidence that every decision is available.' : 'There are no approval work items currently visible to your account or role.'} />}
  </div>
</AppLayout>
<style>.decision-reason{display:block;margin-top:.4rem;color:var(--text-muted);font-size:.75rem;max-width:25rem}.eyebrow{letter-spacing:0}.policy-note{border:0;border-inline-start:3px solid var(--status-warning);border-radius:0;padding-block:var(--space-3)}.table-wrap{border-radius:4px}.head p:not(.eyebrow){max-width:48rem}</style>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.empty p{color:var(--text-muted);font-size:.85rem}.count{min-width:3rem;min-height:3rem;display:grid;place-items:center;border:1px solid var(--color-accent-primary);border-radius:var(--radius-md);color:var(--color-accent-primary-hover);font-size:1.3rem;font-weight:800}.policy-note{margin-bottom:var(--space-5);padding:var(--space-4) var(--space-5);border:1px solid var(--status-warning);border-inline-start-width:4px;border-radius:var(--radius-md);background:var(--surface-panel)}.policy-note h2{margin:0 0 .35rem;font-size:.95rem}.policy-note p{margin:0;color:var(--text-muted);font-size:.85rem}.table-wrap{overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:900px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted);font-size:.8rem}th,td{padding:.85rem;text-align:start;border-top:1px solid var(--color-border-subtle);font-size:.8rem}th{font-weight:700}th small{display:block;margin-top:.25rem;color:var(--text-muted);font-weight:400;font-size:.7rem}a{color:var(--color-accent-primary-hover)}.empty{padding:var(--space-8);text-align:center;background:var(--surface-panel);border:1px dashed var(--color-border-strong);border-radius:var(--radius-lg)}.empty h2{margin:0 0 .5rem}@media(max-width:650px){.head{display:grid}.table-wrap:focus-within{outline:2px solid var(--color-accent-primary);outline-offset:2px}}</style>
