---
import '../ui/styles/global.css';
import { actions } from 'astro:actions';
import { safeReturnTo } from '../shared/http/safe-return-to.js';
import { sessionRecoveryCopy, sessionRecoveryNotice } from '../shared/identity/session-recovery.js';
import AuthLayout from '../ui/layouts/AuthLayout.astro';
import QCLogin3DBackground from '../ui/components/QCLogin3DBackground.astro';
const returnTo = safeReturnTo(Astro.url.searchParams.get('returnTo'));
const actionResult = Astro.getActionResult(actions.login);
if (actionResult?.data?.ok) return Astro.redirect(safeReturnTo(actionResult.data.redirectTo), 303);
const error = Astro.url.searchParams.get('error') ?? actionResult?.error?.message;
const sessionNotice = sessionRecoveryNotice(Astro.url.searchParams.get('session'));
// F-12: English-only product interface. The locale query parameter is
// ignored so the page always renders English with lang="en" dir="ltr".
const copy = {
  application: 'QC Operations & Laboratory Management System',
  title: 'Sign in',
  description: 'Secure operational access',
  error: 'Sign-in could not be completed. Check your credentials and try again.',
  throttled: 'Too many sign-in attempts. Please try again later.',
  unavailable: 'Sign-in is temporarily unavailable. Please try again shortly.',
  identity: 'Login identity',
  password: 'Password',
  submit: 'Sign in',
};
---
<AuthLayout title="Sign in · QC Operations" locale="en" direction="ltr" systemBackground={false} transparent>
  <QCLogin3DBackground modelUrl="/assets/qc-medical-hero.glb" />
  <section class="login-panel login-content" aria-labelledby="login-title">
      <p>{copy.application}</p>
      <h1 id="login-title">{copy.title}</h1>
      <p>{copy.description}</p>
      {sessionNotice && <p id="session-recovery" role="status">{sessionRecoveryCopy(sessionNotice)}</p>}
      {error && <p id="form-error" role="alert">{error === 'AUTH_RATE_LIMITED' ? copy.throttled : error === 'AUTH_RATE_LIMIT_STORE_UNAVAILABLE' ? copy.unavailable : copy.error}</p>}
      <form class="login-form" method="POST" action={actions.login} aria-describedby={error ? 'form-error' : undefined}>
        <input type="hidden" name="returnTo" value={returnTo} />
        <label for="loginIdentity">{copy.identity}</label>
        <input id="loginIdentity" name="loginIdentity" type="text" autocomplete="username" required autofocus />
        <label for="password">{copy.password}</label>
        <div class="password-field">
          <input id="password" name="password" type="password" autocomplete="current-password" required />
          <button type="button" data-password-toggle aria-pressed="false" aria-controls="password" aria-label="Show password">Show</button>
        </div>
        <button type="submit">{copy.submit}</button>
      </form>
      <script>
        const toggle = document.querySelector<HTMLButtonElement>('[data-password-toggle]');
        const input = document.getElementById('password') as HTMLInputElement | null;
        toggle?.addEventListener('click', () => {
          if (!input || !toggle) return;
          const show = input.type === 'password';
          input.type = show ? 'text' : 'password';
          toggle.setAttribute('aria-pressed', String(show));
          toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
          toggle.textContent = show ? 'Hide' : 'Show';
        });
      </script>
  </section>
</AuthLayout>
<style>
  .login-panel { position: relative; z-index: 1; width: min(100%, 440px); padding: var(--space-8); background: var(--surface-panel); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); box-shadow: var(--shadow-2); }
  .login-panel > p:first-child { margin: 0 0 var(--space-6); color: var(--color-accent-primary-hover); font-size: .8rem; font-weight: 700; letter-spacing: .04em; }
  .login-panel h1 { margin: 0; font-size: 2rem; line-height: var(--line-height-tight); }
  .login-panel h1 + p { margin: var(--space-2) 0 var(--space-6); color: var(--text-secondary); }
  #form-error { padding: var(--space-3); border: 1px solid var(--status-danger); border-radius: var(--radius-sm); color: var(--status-danger); background: var(--status-danger-bg); }
  #session-recovery { padding: var(--space-3); border: 1px solid var(--status-review); border-radius: var(--radius-sm); color: var(--text-primary); background: var(--status-review-bg); }
  .login-form { display: grid; gap: var(--space-3); }
  .login-form label { font-weight: 600; }
  .login-form input:not([type="hidden"]) { width: 100%; min-height: 48px; padding-inline: var(--space-3); border: 1px solid var(--border-default); border-radius: var(--radius-sm); background: var(--surface-page); }
  .password-field { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2); align-items: center; }
  .password-field [data-password-toggle] { min-height: 48px; min-width: 72px; margin-top: 0; padding-inline: var(--space-3); border: 1px solid var(--border-default); border-radius: var(--radius-sm); background: var(--surface-raised); color: var(--text-primary); font-weight: 600; cursor: pointer; }
  .login-form button { min-height: 48px; margin-top: var(--space-2); padding-inline: var(--space-4); border: 1px solid var(--color-accent-primary); border-radius: var(--radius-sm); background: var(--color-accent-primary); color: var(--color-text-inverse); font-weight: 700; cursor: pointer; }
  .login-form button:hover { background: var(--color-accent-primary-hover); border-color: var(--color-accent-primary-hover); }
  .login-form button:active { transform: scale(.96); }
  @media (max-width: 520px) { .login-panel { padding: var(--space-5); } }
  @keyframes login-rise {
    from { opacity: 0; transform: translateY(10px); filter: blur(4px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .login-panel > p:first-child { animation: login-rise var(--motion-duration-fast) var(--motion-ease-standard) 0ms both; }
    .login-panel h1 { animation: login-rise var(--motion-duration-fast) var(--motion-ease-standard) 50ms both; }
    .login-panel h1 + p { animation: login-rise var(--motion-duration-fast) var(--motion-ease-standard) 90ms both; }
    #session-recovery,
    #form-error,
    .login-form { animation: login-rise var(--motion-duration-fast) var(--motion-ease-standard) 130ms both; }
  }
</style>
