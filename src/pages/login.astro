---
import { actions } from 'astro:actions';
const returnTo = Astro.url.searchParams.get('returnTo') ?? '/dashboard';
const error = Astro.url.searchParams.get('error');
---
<!doctype html>
<html lang="en" dir="ltr">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Sign in · QC Operations</title></head>
  <body>
    <main>
      <p>QC Operations &amp; Laboratory Management System</p>
      <h1>Sign in</h1>
      <p>Secure operational access</p>
      {error && <p id="form-error" role="alert">Sign-in could not be completed. Check your credentials and try again.</p>}
      <form method="POST" action={actions.server.login} aria-describedby={error ? 'form-error' : undefined}>
        <input type="hidden" name="returnTo" value={returnTo} />
        <label for="loginIdentity">Login identity</label>
        <input id="loginIdentity" name="loginIdentity" type="text" autocomplete="username" required autofocus />
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
        <button type="submit">Sign in</button>
      </form>
    </main>
  </body>
</html>
