---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import { AppError } from '../../shared/errors/app-error.js';
import {
  emptyReportDraft, reportDraftSchema, reportFields, reportTypes, sampleFields,
  type ReportDraftData, type ReportType,
} from '../../modules/laboratory/application/report-template-form.js';
import { getReportDraft, listReportDrafts, saveReportDraft } from '../../modules/laboratory/application/report-drafts.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Flaboratory%2Freport-templates');
const has = (code: string) => actor.accountState === 'ACTIVE' && actor.permissions.some((p) =>
  p.code === code && p.active !== false && (p.scopes.includes('GLOBAL') || p.scopes.includes('OWN')));
const canView = has('PERM-LAB-VIEW');
const canCreate = has('PERM-LAB-CREATE');
const requested = Astro.url.searchParams.get('type');
const type: ReportType = requested === 'PRESSURE_DECAY' ? 'PRESSURE_DECAY' : 'SUBATMOSPHERIC_AIR_LEAKAGE';
let data: ReportDraftData = emptyReportDraft(type);
let id = Astro.url.searchParams.get('draft') ?? '';
let version = 0n;
let error = '';
let draftStorageUnavailable = false;
let selectedDraftUnavailable = false;
const printMode = Astro.url.searchParams.get('print') === '1';
let drafts: Awaited<ReturnType<typeof listReportDrafts>> = [];

if (canView) {
  try {
    drafts = await listReportDrafts(actor);
  } catch {
    error = 'Saved drafts could not be loaded. Ask the system owner to check database readiness and whether migration 0039 is applied, then reload.';
    draftStorageUnavailable = true;
  }
  if (id && !draftStorageUnavailable) {
    try {
      const draft = await getReportDraft(actor, id);
      data = draft.data;
      version = draft.version;
    } catch {
      error = 'The selected draft is unavailable in your account.';
      selectedDraftUnavailable = true;
    }
  }
}

if (Astro.request.method === 'POST' && !draftStorageUnavailable && !selectedDraftUnavailable && canView && (id ? has('PERM-LAB-EDIT-DRAFT') : canCreate)) {
  const form = await Astro.request.formData();
  const text = (key: string) => String(form.get(key) ?? '').trim();
  const expectedNames = new Set([
    'version', 'reportType', 'connectorType', 'overallResult',
    ...reportFields.map(([key]) => key),
    ...Array.from({ length: 12 }, (_, index) => sampleFields.map(([key]) => `samples.${index}.${key}`)).flat(),
  ]);
  const submittedEntries = [...form.entries()];
  const submittedNames = submittedEntries.map(([key]) => key);
  const malformedForm =
    submittedEntries.some(([, value]) => typeof value !== 'string') ||
    submittedNames.some((key) => !expectedNames.has(key)) ||
    new Set(submittedNames).size !== submittedNames.length ||
    [...expectedNames].some((key) => !submittedNames.includes(key));
  const raw = {
    reportType: text('reportType'), connectorType: text('connectorType'),
    overallResult: text('overallResult'),
    ...Object.fromEntries(reportFields.map(([key]) => [key, text(key)])),
    samples: Array.from({ length: 12 }, (_, index) =>
      Object.fromEntries(sampleFields.map(([key]) => [key, text(`samples.${index}.${key}`)]))),
  };
  const parsed = reportDraftSchema.safeParse(raw);
  if (malformedForm || !parsed.success) {
    error = 'Check the report fields and try saving again.';
    data = raw as ReportDraftData;
  }
  else {
    data = parsed.data;
    try {
      const savedId = await saveReportDraft({
        actor, id: id || undefined,
        expectedVersion: id && /^\d+$/.test(text('version')) ? BigInt(text('version')) : undefined,
        data, requestId: Astro.locals.requestContext?.requestId ?? 'unknown',
      });
      return Astro.redirect(`/laboratory/report-templates?draft=${encodeURIComponent(savedId)}&saved=1`, 303);
    } catch (cause) {
      if (cause instanceof AppError && cause.category === 'AUTHORIZATION') {
        error = `You cannot save this draft. Ask the system owner to review your active ${id ? 'PERM-LAB-EDIT-DRAFT' : 'PERM-LAB-CREATE'} grant and OWN or GLOBAL scope. This does not grant review or approval authority.`;
      } else if (cause instanceof AppError && cause.code === 'CONFLICT_STALE_VERSION') {
        error = 'Another edit was saved first. Reload the latest draft before trying again; your current entries are still shown here.';
      } else {
        error = 'The draft could not be saved because draft storage is unavailable. Your entries are still shown here. Ask the system owner to check database readiness and migration 0039 before retrying.';
      }
    }
  }
}

const groups = [
  { title: 'Record identification', keys: ['companyName', 'recordCategory', 'documentNo', 'revision', 'documentDate', 'pageNo'] },
  { title: 'Sample identification', keys: ['productDescription', 'testingDate', 'sampleCount', 'lotNumber', 'testingArea'] },
  { title: 'Requirements', keys: ['mediumName', 'mediumUsed'] },
  { title: 'Connector assembly', keys: ['actualForce', 'torque', 'assemblyTime', 'assemblyAngle'] },
  { title: 'Environmental condition', keys: ['temperature', 'humidity'] },
  { title: 'Test conditions', keys: ['standardCondition', 'remainingDifference', 'timePreset'] },
  { title: 'Remarks and signoffs', keys: ['remarks', 'testedBy', 'reviewedBy', 'approvedBy'] },
] as const;
const labelOf = (key: string) => reportFields.find(([name]) => name === key)?.[1] ?? key;
---
<AppLayout title="Laboratory report templates" locale="en" direction="ltr">
  <div class="report-entry">
    <p><a href="/laboratory/tests">← Laboratory tests</a></p>
    <h1>Laboratory report templates</h1>
    <p>Enter the report as a draft. Recorded PASS / FAIL values and names are transcribed observations; they do not approve a controlled laboratory test.</p>
    {!canView ? <p role="alert">You are not authorized to view laboratory reports. Ask the system owner to review your active PERM-LAB-VIEW grant and OWN or GLOBAL scope.</p> : <>
      <nav aria-label="Choose report template" class="template-choices">
        {Object.entries(reportTypes).map(([key, title]) =>
          <a href={`/laboratory/report-templates?type=${key}`} aria-current={!id && data.reportType === key ? 'page' : undefined}>{title}</a>)}
      </nav>
      {drafts.length > 0 && <section aria-labelledby="saved-drafts"><h2 id="saved-drafts">Saved drafts</h2><ul class="draft-list">{drafts.map((draft) =>
        <li><a href={`/laboratory/report-templates?draft=${draft.id}`}><strong>{reportTypes[draft.report_type as ReportType]}</strong><span>{draft.form_data.lotNumber ? `Lot ${draft.form_data.lotNumber}` : 'Lot not recorded'} · {draft.form_data.productDescription || 'Item not recorded'} · Updated {draft.updated_at.toISOString().slice(0, 10)}</span></a></li>)}</ul></section>}
      {Astro.url.searchParams.get('saved') === '1' && <p role="status">Draft saved.</p>}
      {error && <p role="alert">{error}</p>}
      {id && data && <p class="draft-meta"><strong>Draft ID:</strong> {id} · <strong>Version:</strong> {version.toString()}</p>}
      {printMode && id && !draftStorageUnavailable && !selectedDraftUnavailable ? <>
        <div class="print-actions"><a href={`/laboratory/report-templates?draft=${encodeURIComponent(id)}`}>Back to draft</a><button type="button" data-print-report>Print report</button></div>
        <article class="print-report">
          <header><p>TRANSCRIPTION DRAFT · NOT AN APPROVED LABORATORY RESULT</p><h2>{reportTypes[data.reportType]}</h2><p>Draft ID: {id} · Version {version.toString()}</p></header>
          {groups.map((group) => <section><h3>{group.title}</h3><dl>{group.keys.map((key) => <div><dt>{labelOf(key)}</dt><dd>{data[key] || 'Not recorded'}</dd></div>)}</dl></section>)}
          <section><h3>Connector type</h3><p>{data.connectorType || 'Not recorded'}</p></section>
          <section><h3>Sample measurements</h3><div class="table-scroll"><table><caption>Recorded values for all 12 samples</caption><thead><tr><th scope="col">Sample no.</th>{sampleFields.map(([, label]) => <th scope="col">{label}</th>)}</tr></thead><tbody>{data.samples.map((sample, index) => <tr><th scope="row">{index + 1}</th>{sampleFields.map(([key]) => <td>{sample[key] || 'Not recorded'}</td>)}</tr>)}</tbody></table></div></section>
          <section><h3>Overall result entered on source report</h3><p>{data.overallResult || 'Not recorded'}</p></section>
          <p class="transcription-note">Tested By, Reviewed By, and Approved By are transcribed source text only. They are not electronic signatures or current approvals. This draft does not approve a laboratory test or release product.</p>
        </article>
      </> : !printMode && !draftStorageUnavailable && !selectedDraftUnavailable && (id ? has('PERM-LAB-EDIT-DRAFT') : canCreate) ? <form data-report-draft method="post" action={id ? `/laboratory/report-templates?draft=${encodeURIComponent(id)}` : '/laboratory/report-templates'}>
        <input type="hidden" name="version" value={version.toString()} />
        <input type="hidden" name="reportType" value={data.reportType} />
        <h2>{reportTypes[data.reportType]}</h2>
        {id && <p><a href={`/laboratory/report-templates?draft=${encodeURIComponent(id)}&print=1`}>Open print view</a></p>}
        <p class="dirty-state" data-dirty-label role="status" aria-live="polite"></p>
        {groups.map((group) => <fieldset><legend>{group.title}</legend><div class="field-grid">{group.keys.map((key) =>
          <label>{labelOf(key)}<input name={key} type="text" maxlength="2000" value={data[key]} /></label>)}</div></fieldset>)}
        <fieldset><legend>Connector configuration</legend><label>Transcribe the configuration shown on the source report<input name="connectorType" maxlength="500" value={data.connectorType} /></label></fieldset>
        <fieldset><legend>Test results · 12 samples</legend><p id="sample-transcription-help">Transcribe each value, unit, and decimal precision exactly as shown on the source report. No conversion, rounding, or scientific evaluation is applied.</p><div class="table-scroll"><table><caption>Measurements and result for each numbered sample</caption><thead><tr><th scope="col">Sample no.</th>{sampleFields.map(([, label]) => <th scope="col">{label}</th>)}</tr></thead><tbody>
          {data.samples.map((sample, index) => <tr><th scope="row">{index + 1}</th>{sampleFields.map(([key, label]) => <td><label class="sr-only" for={`sample-${index}-${key}`}>{label} for sample {index + 1}</label><input id={`sample-${index}-${key}`} name={`samples.${index}.${key}`} value={sample[key]} maxlength="500" /></td>)}</tr>)}
        </tbody></table></div></fieldset>
        <fieldset><legend>Overall result entered on the source report</legend><div class="radio-group">
          {[
            ['', 'Not recorded'], ['PASS', 'PASS'], ['FAIL', 'FAIL'],
            ['HOLD_FURTHER_EVALUATION', 'HOLD / FURTHER EVALUATION'],
          ].map(([value, label]) => <label><input type="radio" name="overallResult" value={value} checked={data.overallResult === value} />{label}</label>)}
        </div></fieldset>
        <button type="submit">Save draft</button>
      </form> : draftStorageUnavailable ? <p role="status">Draft editing is unavailable until draft storage is restored. Resolve the data-source error above and reload.</p> : selectedDraftUnavailable ? <p role="status">This draft is unavailable in your account scope. Ask the system owner to review PERM-LAB-VIEW and OWN or GLOBAL scope.</p> : <p role="status">You cannot {id ? 'edit this draft' : 'create a report draft'}. Ask the system owner to review your active {id ? 'PERM-LAB-EDIT-DRAFT' : 'PERM-LAB-CREATE'} grant and OWN or GLOBAL scope. This does not grant review or approval authority.</p>}
    </>}
  </div>
</AppLayout>
<script>
  import { guardUnsavedChanges } from '../../ui/forms/unsaved-changes';
  const form = document.querySelector<HTMLFormElement>('[data-report-draft]');
  if (form) {
    guardUnsavedChanges(form);
    const dirtyLabel = form.querySelector<HTMLElement>('[data-dirty-label]');
    const markDirty = () => { if (dirtyLabel) dirtyLabel.textContent = 'Unsaved changes'; };
    form.addEventListener('input', markDirty);
    form.addEventListener('change', markDirty);
  }
  document.querySelector<HTMLButtonElement>('[data-print-report]')?.addEventListener('click', () => window.print());
</script>
<style>
  .report-entry{max-width:78rem;margin-inline:auto;padding:1rem}.report-entry a{color:var(--color-accent-primary-hover)}
  .template-choices{display:flex;gap:1rem;flex-wrap:wrap;margin:1.5rem 0}.template-choices a{padding:.75rem;border:1px solid var(--border-default);border-radius:var(--radius-md)}
  .template-choices [aria-current]{border-color:var(--color-accent-primary);font-weight:700}
  form{display:grid;gap:1.25rem}fieldset{min-width:0;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:1rem}legend{font-weight:700;padding:0 .35rem}
  .field-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:1rem}.field-grid label{display:grid;gap:.35rem}
  input[type=text],input[type=date],select{width:100%;min-height:2.75rem;padding:.55rem;border:1px solid var(--border-default);border-radius:var(--radius-sm);background:var(--surface-panel);color:inherit;font:inherit}
  .radio-group{display:flex;gap:1rem;flex-wrap:wrap}.radio-group label{display:flex;align-items:center;gap:.4rem}
  .table-scroll{overflow-x:auto}table{border-collapse:collapse;min-width:1100px;width:100%}th,td{border:1px solid var(--border-default);padding:.35rem}th{text-align:start}td input{min-width:7rem}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  button{justify-self:start;min-height:2.75rem;padding:.65rem 1rem;background:var(--color-accent-primary);color:var(--color-text-inverse);border:0;border-radius:var(--radius-md);font:inherit;cursor:pointer}
  .draft-list{display:grid;gap:.5rem;padding-inline-start:1.25rem}.draft-list a{display:grid;gap:.2rem}.draft-list span,.draft-meta{color:var(--text-muted)}
  .print-actions{display:flex;gap:1rem;align-items:center;margin-block:1rem}.print-report{background:white;color:#111;padding:1rem}.print-report header{border-bottom:2px solid #111;margin-bottom:1rem}.print-report header>p:first-child,.transcription-note{font-weight:700}.print-report section{margin-block:1rem}.print-report dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem 1rem}.print-report dl div{display:grid;grid-template-columns:minmax(8rem,1fr) 2fr;border-bottom:1px solid #ccc}.print-report dt{font-weight:700}.print-report dd{margin:0}.dirty-state:empty{display:none}
  @page{size:landscape;margin:12mm}
  @media print{:global(.app-sidebar),:global(.app-topbar),:global(.skip-link){display:none!important}:global(.app-shell),:global(.app-workspace){display:block;min-height:0}:global(.app-main){width:auto;max-width:none;margin:0;padding:0;overflow:visible}.report-entry>p:first-child,.report-entry>h1,.report-entry>p:nth-of-type(2),nav,.draft-list,section[aria-labelledby="saved-drafts"],.draft-meta,.print-actions,form{display:none!important}.report-entry{max-width:none;padding:0}.print-report{padding:0}.table-scroll{overflow:visible}table{min-width:0;font-size:8pt}th,td{padding:.2rem}.print-report{break-inside:auto}.print-report section{break-inside:avoid}}
</style>
