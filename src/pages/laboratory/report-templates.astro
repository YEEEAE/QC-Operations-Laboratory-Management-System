---
import PageHeader from '../../ui/components/PageHeader.astro';
import AppLayout from '../../ui/layouts/AppLayout.astro';
import { AppError } from '../../shared/errors/app-error.js';
import {
  emptyReportDraft, reportDraftSchema, reportFields, reportTypes, sampleFields,
  type ReportDraftData, type ReportType,
} from '../../modules/laboratory/application/report-template-form.js';
import { getReportDraft, listReportDrafts, saveReportDraft } from '../../modules/laboratory/application/report-drafts.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Flaboratory%2Freport-templates');
const has = (code: string) => actor.accountState === 'ACTIVE' && actor.permissions.some((p) =>
  p.code === code && p.active !== false && (p.scopes.includes('GLOBAL') || p.scopes.includes('OWN')));
const canView = has('PERM-LAB-VIEW');
const canCreate = has('PERM-LAB-CREATE');
const requested = Astro.url.searchParams.get('type');
const type: ReportType = requested === 'PRESSURE_DECAY' ? 'PRESSURE_DECAY' : 'SUBATMOSPHERIC_AIR_LEAKAGE';
let data: ReportDraftData = emptyReportDraft(type);
let id = Astro.url.searchParams.get('draft') ?? '';
let version = 0n;
let submittedVersion: string | undefined;
let error = '';
let draftStorageUnavailable = false;
let selectedDraftUnavailable = false;
const printMode = Astro.url.searchParams.get('print') === '1';
let drafts: Awaited<ReturnType<typeof listReportDrafts>> = [];

if (canView) {
  try {
    drafts = await listReportDrafts(actor);
  } catch {
    error = 'Saved drafts could not be loaded. Ask the system owner to restore access, then reload.';
    draftStorageUnavailable = true;
  }
  if (id && !draftStorageUnavailable) {
    try {
      const draft = await getReportDraft(actor, id);
      data = draft.data;
      version = draft.version;
    } catch {
      error = 'The selected draft is unavailable in your account.';
      selectedDraftUnavailable = true;
    }
  }
}

if (Astro.request.method === 'POST' && !draftStorageUnavailable && !selectedDraftUnavailable && canView && (id ? has('PERM-LAB-EDIT-DRAFT') : canCreate)) {
  const form = await Astro.request.formData();
  const text = (key: string) => String(form.get(key) ?? '');
  // Retain the opened version after any failed POST. A fresh read must never
  // silently authorize resubmitting old entries against a newer saved draft.
  submittedVersion = text('version');
  const expectedNames = new Set([
    'version', 'reportType', 'connectorType', 'overallResult',
    ...reportFields.map(([key]) => key),
    ...Array.from({ length: 12 }, (_, index) => sampleFields.map(([key]) => `samples.${index}.${key}`)).flat(),
  ]);
  const submittedEntries = [...form.entries()];
  const submittedNames = submittedEntries.map(([key]) => key);
  const malformedForm =
    submittedEntries.some(([, value]) => typeof value !== 'string') ||
    submittedNames.some((key) => !expectedNames.has(key)) ||
    new Set(submittedNames).size !== submittedNames.length ||
    [...expectedNames].some((key) => !submittedNames.includes(key));
  const raw = {
    reportType: text('reportType'), connectorType: text('connectorType'),
    overallResult: text('overallResult'),
    ...Object.fromEntries(reportFields.map(([key]) => [key, text(key)])),
    samples: Array.from({ length: 12 }, (_, index) =>
      Object.fromEntries(sampleFields.map(([key]) => [key, text(`samples.${index}.${key}`)]))),
  };
  const parsed = reportDraftSchema.safeParse(raw);
  if (malformedForm || !parsed.success) {
    error = 'Check the report fields and try saving again.';
    data = raw as ReportDraftData;
  }
  else {
    data = parsed.data;
    try {
      const savedId = await saveReportDraft({
        actor, id: id || undefined,
        expectedVersion: id && /^\d+$/.test(text('version')) ? BigInt(text('version')) : undefined,
        data, requestId: Astro.locals.requestContext?.requestId ?? 'unknown',
      });
      return Astro.redirect(`/laboratory/report-templates?draft=${encodeURIComponent(savedId)}&saved=1`, 303);
    } catch (cause) {
      if (cause instanceof AppError && cause.category === 'AUTHORIZATION') {
        error = `You cannot save this draft. Ask the system owner to review your active ${id ? 'PERM-LAB-EDIT-DRAFT' : 'PERM-LAB-CREATE'} grant and OWN or GLOBAL scope. This does not grant review or approval authority.`;
      } else if (cause instanceof AppError && cause.code === 'CONFLICT_STALE_VERSION') {
        error = 'Another edit was saved first. Reload the latest draft before trying again; your current entries are still shown here.';
      } else {
        error = 'The save result could not be confirmed. Your entries are still shown here. Check saved drafts before retrying. If drafts are unavailable, contact the system owner.';
      }
    }
  }
}

const groups = [
  { title: 'Record identification', keys: ['companyName', 'recordCategory', 'documentNo', 'revision', 'documentDate', 'pageNo'] },
  { title: 'Sample identification', keys: ['productDescription', 'testingDate', 'sampleCount', 'lotNumber', 'testingArea'] },
  { title: 'Requirements', keys: ['mediumName', 'mediumUsed'] },
  { title: 'Connector assembly', keys: ['actualForce', 'torque', 'assemblyTime', 'assemblyAngle'] },
  { title: 'Environmental condition', keys: ['temperature', 'humidity'] },
  { title: 'Test conditions', keys: ['standardCondition', 'remainingDifference', 'timePreset'] },
  { title: 'Remarks and signoffs', keys: ['remarks', 'testedBy', 'reviewedBy', 'approvedBy'] },
] as const;
const labelOf = (key: string) => reportFields.find(([name]) => name === key)?.[1] ?? key;
const savedNotice = Astro.url.searchParams.get('saved') === '1';
const draftTypeLabel = (reportType: string) => reportTypes[reportType as ReportType] ?? reportType;
const printReportVisible = printMode && Boolean(id) && !draftStorageUnavailable && !selectedDraftUnavailable;
// No paged read exists for saved drafts: listReportDrafts returns one read of
// at most 50 rows, newest first. A pager would have to invent a total, so the
// register states its bound instead of rendering pagination. This surface also
// has no export and no client-side pending state in source: writes are a native
// POST followed by a 303. None of those states is simulated.
const draftCountText = `Showing ${drafts.length} saved draft${drafts.length === 1 ? '' : 's'} in your authorized scope. This single read returns up to 50 drafts, newest first; no paging is available.`;
---

<AppLayout title="Laboratory report templates" locale="en" direction="ltr">
  <div class="report-workspace" data-print-mode={printReportVisible ? 'true' : undefined}>
    <div class="page-head">
      <PageHeader
        section="Laboratory"
        purpose="Enter the report as a draft. Recorded PASS / FAIL values and names are transcribed observations; they do not approve a controlled laboratory test."
      >
        <Fragment slot="heading"><h1>Laboratory report templates</h1></Fragment>
        <Fragment slot="actions"><a class="button secondary" href="/laboratory/tests">Back to laboratory tests</a></Fragment>
      </PageHeader>
    </div>

    {!canView ? (
      <div class="feedback-region" aria-label="Laboratory report access">
        <p class="feedback feedback--error" role="alert">You are not authorized to view laboratory reports. Ask the system owner to review your active PERM-LAB-VIEW grant and OWN or GLOBAL scope.</p>
      </div>
    ) : <>
      <section class="filter-panel" aria-labelledby="template-filter-heading">
        <h2 id="template-filter-heading">Report template</h2>
        <p class="filter-help">Choose the source template you are transcribing. This changes the entry fields below; it does not filter the saved drafts register.</p>
        <nav aria-label="Report template" class="template-choices">
          {Object.entries(reportTypes).map(([key, title]) =>
            <a
              class="button secondary"
              href={`/laboratory/report-templates?type=${key}`}
              aria-current={!id && data.reportType === key ? 'page' : undefined}
            >{title}</a>)}
        </nav>
        <div class="applied-filters" role="group" aria-label="Applied template filter">
          <span class="applied-label">Applied filter</span>
          <span class="applied-chip">
            <span class="chip-label">Template</span>
            <span class="chip-value">{reportTypes[data.reportType]}</span>
          </span>
          <span class="filter-note">The template choice is required; there is no all-template view. Opening a saved draft uses that draft's template.</span>
        </div>
      </section>

      {(savedNotice || error) && (
        <div class="feedback-region" aria-label="Draft save status">
          {savedNotice && <p class="feedback feedback--success" role="status">Draft saved.</p>}
          {error && <p class="feedback feedback--error" role="alert">{error}</p>}
        </div>
      )}

      <section class="register" aria-labelledby="saved-drafts">
        <div class="register-heading">
          <div>
            <h2 id="saved-drafts">Saved drafts</h2>
            <p class="register-note">Drafts are transcription records only. Open a draft from its template name. Opening a draft does not submit, review, approve, or release a laboratory test.</p>
          </div>
          {!draftStorageUnavailable && drafts.length > 0 && (
            <p class="result-count" role="status" aria-live="polite">{draftCountText}</p>
          )}
        </div>
        {draftStorageUnavailable ? (
          <p class="register-placeholder" role="status">Saved drafts are unavailable; no draft count or rows are shown for this request.</p>
        ) : drafts.length ? (
          <div class="table-wrap" role="region" aria-label="Saved report drafts" tabindex="0">
            <table>
              <caption>Saved laboratory report drafts in your authorized scope, newest first</caption>
              <thead>
                <tr>
                  <th scope="col">Template</th>
                  <th scope="col">Lot</th>
                  <th scope="col">Item</th>
                  <th scope="col">Updated</th>
                  <th scope="col">Version</th>
                  <th scope="col">Draft ID</th>
                </tr>
              </thead>
              <tbody>
                {drafts.map((draft) => (
                  <tr>
                    <th scope="row">
                      <a
                        class="row-link"
                        href={`/laboratory/report-templates?draft=${encodeURIComponent(draft.id)}`}
                        aria-current={draft.id === id ? 'page' : undefined}
                      >{draftTypeLabel(draft.report_type)}</a>
                    </th>
                    <td>{draft.form_data.lotNumber || 'Not recorded'}</td>
                    <td class="cell-long">{draft.form_data.productDescription || 'Not recorded'}</td>
                    <td class="cell-numeric">
                      <time datetime={draft.updated_at.toISOString()}>{draft.updated_at.toISOString().slice(0, 10)}</time>
                    </td>
                    <td class="cell-numeric">{draft.version.toString()}</td>
                    <td class="cell-id"><code>{draft.id}</code></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="register-placeholder" role="status">No saved drafts in your authorized scope. A draft appears here after you save one.</p>
        )}
      </section>

      <section class="entry-panel" aria-labelledby="draft-entry-heading">
        <header class="entry-header">
          <div>
            <p class="entry-kicker">{printReportVisible ? 'Print preview' : 'Draft entry'}</p>
            <h2 id="draft-entry-heading">{reportTypes[data.reportType]}</h2>
            <p class="entry-note">Transcribe each value exactly as recorded on the source report. No calculation, rounding, unit conversion, or scientific evaluation is applied.</p>
            <p class="entry-note">This instrument report is a transcription record. In-process checks belong to their separately controlled work-instruction workflow.</p>
            <p class="source-review-note">Tested By, Reviewed By, and Approved By are transcribed source text only. They are not electronic signatures or current approvals.</p>
          </div>
          {id && !draftStorageUnavailable && !selectedDraftUnavailable && (
            <div class="draft-meta">
              <p><strong>Draft ID:</strong> <code>{id}</code></p>
              <p><strong>Version:</strong> <span>{version.toString()}</span></p>
            </div>
          )}
        </header>
        {id && !draftStorageUnavailable && !selectedDraftUnavailable && has('PERM-LAB-EDIT-DRAFT') && !printReportVisible && (
          <p class="entry-links"><a class="button secondary" href={`/laboratory/report-templates?draft=${encodeURIComponent(id)}&print=1`}>Open print view</a></p>
        )}

        {printReportVisible ? <>
          <div class="print-actions"><a href={`/laboratory/report-templates?draft=${encodeURIComponent(id)}`}>Back to draft</a><button type="button" data-print-report>Print report</button></div>
          <article class="print-report">
            <header><p>TRANSCRIPTION DRAFT · NOT AN APPROVED LABORATORY RESULT</p><h2>{reportTypes[data.reportType]}</h2><p>Draft ID: {id} · Version {version.toString()}</p></header>
            {groups.map((group) => <section><h3>{group.title}</h3><dl>{group.keys.map((key) => <div><dt>{labelOf(key)}</dt><dd>{data[key] || 'Not recorded'}</dd></div>)}</dl></section>)}
            <section><h3>Connector type</h3><p>{data.connectorType || 'Not recorded'}</p></section>
            <section><h3>Sample measurements</h3><div class="table-scroll"><table><caption>Recorded values for all 12 samples</caption><thead><tr><th scope="col">Sample no.</th>{sampleFields.map(([, label]) => <th scope="col">{label}</th>)}</tr></thead><tbody>{data.samples.map((sample, index) => <tr><th scope="row">{index + 1}</th>{sampleFields.map(([key]) => <td>{sample[key] || 'Not recorded'}</td>)}</tr>)}</tbody></table></div></section>
            <section><h3>Overall result entered on source report</h3><p>{data.overallResult || 'Not recorded'}</p></section>
            <p class="transcription-note">Tested By, Reviewed By, and Approved By are transcribed source text only. They are not electronic signatures or current approvals. This draft does not approve a laboratory test or release product.</p>
          </article>
        </> : !printMode && !draftStorageUnavailable && !selectedDraftUnavailable && (id ? has('PERM-LAB-EDIT-DRAFT') : canCreate) ? <form data-report-draft aria-labelledby="draft-entry-heading" method="post" action={id ? `/laboratory/report-templates?draft=${encodeURIComponent(id)}` : '/laboratory/report-templates'}>
          <input type="hidden" name="version" value={submittedVersion ?? version.toString()} />
          <input type="hidden" name="reportType" value={data.reportType} />
          <p class="dirty-state" data-dirty-label role="status" aria-live="polite"></p>
          {groups.map((group) => <fieldset><legend>{group.title}</legend><div class="field-grid">{group.keys.map((key) =>
            <label><span class="field-label">{labelOf(key)}</span><input name={key} type="text" maxlength="2000" value={data[key]} /></label>)}</div></fieldset>)}
          <fieldset><legend>Connector configuration</legend><label><span class="field-label">Transcribe the configuration shown on the source report</span><input name="connectorType" type="text" maxlength="500" value={data.connectorType} /></label></fieldset>
          <fieldset aria-describedby="sample-transcription-help"><legend>Test results · 12 samples</legend><p id="sample-transcription-help">Transcribe each value, unit, and decimal precision exactly as shown on the source report. No conversion, rounding, or scientific evaluation is applied.</p><div class="table-scroll" role="region" aria-label="Sample measurement fields" tabindex="0"><table><caption>Measurements and result for each numbered sample</caption><thead><tr><th scope="col">Sample no.</th>{sampleFields.map(([, label]) => <th scope="col">{label}</th>)}</tr></thead><tbody>
            {data.samples.map((sample, index) => <tr><th scope="row">{index + 1}</th>{sampleFields.map(([key, label]) => <td><label class="sr-only" for={`sample-${index}-${key}`}>{label} for sample {index + 1}</label><input id={`sample-${index}-${key}`} name={`samples.${index}.${key}`} type="text" value={sample[key]} maxlength="500" /></td>)}</tr>)}
          </tbody></table></div></fieldset>
          <fieldset><legend>Overall result entered on the source report</legend><div class="radio-group">
            {[
              ['', 'Not recorded'], ['PASS', 'PASS'], ['FAIL', 'FAIL'],
              ['HOLD_FURTHER_EVALUATION', 'HOLD / FURTHER EVALUATION'],
            ].map(([value, label]) => <label><input type="radio" name="overallResult" value={value} checked={data.overallResult === value} />{label}</label>)}
          </div></fieldset>
          <div class="form-actions">
            <button type="submit">Save draft</button>
            <p class="form-note">Saving stores or updates a DRAFT only. It does not submit, review, approve, or release the report.</p>
          </div>
        </form> : draftStorageUnavailable ? <p class="availability-note" role="status">Draft editing is unavailable until draft storage is restored. Resolve the data-source error above and reload.</p> : selectedDraftUnavailable ? <p class="availability-note" role="status">This draft is unavailable in your account scope. Ask the system owner to review PERM-LAB-VIEW and OWN or GLOBAL scope.</p> : <p class="availability-note" role="status">You cannot {id ? 'edit this draft' : 'create a report draft'}. Ask the system owner to review your active {id ? 'PERM-LAB-EDIT-DRAFT' : 'PERM-LAB-CREATE'} grant and OWN or GLOBAL scope. This does not grant review or approval authority.</p>}
      </section>
    </>}
  </div>
</AppLayout>
<script>
  import { guardUnsavedChanges } from '../../ui/forms/unsaved-changes';
  const form = document.querySelector<HTMLFormElement>('[data-report-draft]');
  if (form) {
    guardUnsavedChanges(form);
    const dirtyLabel = form.querySelector<HTMLElement>('[data-dirty-label]');
    const markDirty = () => { if (dirtyLabel) dirtyLabel.textContent = 'Unsaved changes'; };
    form.addEventListener('input', markDirty);
    form.addEventListener('change', markDirty);
  }
  document.querySelector<HTMLButtonElement>('[data-print-report]')?.addEventListener('click', () => window.print());
</script>
<style>
  .report-workspace{min-inline-size:0}
  .page-head{min-inline-size:0}
  .button{display:inline-flex;align-items:center;justify-content:center;min-block-size:44px;max-inline-size:100%;padding:var(--space-2) var(--space-4);border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:var(--text-on-accent);font:inherit;font-weight:var(--font-weight-semibold);text-align:center;text-decoration:none;cursor:pointer}
  .button.secondary{background:var(--surface-raised);border-color:var(--control-border);color:var(--text-primary)}
  .button:hover{background:var(--color-accent-primary-hover);border-color:var(--color-accent-primary-hover)}
  .button.secondary:hover{background:var(--color-surface-hover);border-color:var(--control-border)}
  .feedback-region{display:grid;gap:var(--space-2);margin-block-end:var(--space-4)}
  .feedback-region:empty{display:none}
  .feedback{margin:0;padding:var(--space-3) var(--space-4);border:1px solid var(--border-default);border-inline-start:4px solid var(--color-border-strong);border-radius:var(--radius-sm);background:var(--surface-panel);color:var(--text-primary);font-size:var(--font-size-sm);line-height:1.5}
  .feedback--success{border-inline-start-color:var(--status-success)}
  .feedback--error{border-inline-start-color:var(--status-danger)}
  .filter-panel{margin-block-end:var(--space-4);padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--border-default);border-radius:var(--card-radius);min-inline-size:0}
  .filter-panel h2{margin:0;color:var(--text-primary);font-size:var(--font-size-md)}
  .filter-help{margin:var(--space-1) 0 var(--space-4);max-inline-size:78ch;color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.5}
  .template-choices{display:flex;flex-wrap:wrap;gap:var(--space-3);margin:0}
  .template-choices a{flex:0 1 auto;text-align:start}
  .template-choices a[aria-current='page']{box-shadow:inset 0 0 0 2px var(--color-accent-primary);font-weight:var(--font-weight-bold)}
  .applied-filters{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-2) var(--space-3);margin-block-start:var(--space-4);color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.5}
  .applied-label{font-weight:var(--font-weight-semibold)}
  .applied-chip{display:inline-flex;flex-wrap:wrap;align-items:center;gap:6px;min-block-size:32px;max-inline-size:100%;padding-inline:10px;border:1px solid var(--border-default);border-radius:999px;background:var(--surface-raised);color:var(--text-primary)}
  .chip-label{color:var(--text-muted)}
  .chip-value{min-inline-size:0;overflow-wrap:anywhere;font-weight:var(--font-weight-semibold)}
  .filter-note{min-inline-size:0;max-inline-size:70ch;color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.5}
  .register{margin-block-end:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--card-radius);overflow:hidden;min-inline-size:0}
  .register-heading{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:var(--space-3) var(--space-5);padding:var(--space-5) var(--space-5) var(--space-3)}
  .register-heading h2{margin:0;color:var(--text-primary);font-size:var(--font-size-lg)}
  .register-note{margin:var(--space-1) 0 0;max-inline-size:75ch;color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.5}
  .result-count{margin:0;max-inline-size:100%;color:var(--text-secondary);font-size:var(--font-size-xs);line-height:1.5}
  .table-wrap{max-inline-size:100%;overflow-x:auto;border-block-start:1px solid var(--color-border-subtle)}
  .table-wrap:focus-visible{outline:2px solid var(--color-accent-primary);outline-offset:-2px}
  table{inline-size:100%;min-inline-size:62rem;border-collapse:collapse;background:var(--surface-panel)}
  caption{padding:var(--space-4) var(--space-5);color:var(--text-muted);text-align:start;font-size:var(--font-size-xs);line-height:1.5}
  th,td{padding:var(--space-3) var(--space-4);border-block-start:1px solid var(--color-border-subtle);text-align:start;vertical-align:top;font-size:var(--font-size-sm);overflow-wrap:anywhere;word-break:normal}
  thead th{background:var(--table-header-background);color:var(--text-primary);font-size:var(--font-size-xs);font-weight:var(--font-weight-semibold);white-space:nowrap}
  tbody tr:nth-child(even){background:var(--table-stripe-background)}
  .row-link{display:inline-flex;align-items:center;min-block-size:44px;font-weight:var(--font-weight-semibold);overflow-wrap:anywhere;white-space:normal}
  .cell-long{min-inline-size:16rem;white-space:normal}
  .cell-numeric{min-inline-size:5rem;font-variant-numeric:tabular-nums;white-space:nowrap}
  .cell-id{min-inline-size:20rem;font-size:var(--font-size-xs);font-variant-numeric:tabular-nums;overflow-wrap:anywhere;word-break:break-word;white-space:normal}
  .cell-id code{font-family:var(--font-mono)}
  .register-placeholder{margin:0;padding:var(--space-6) var(--space-5);border-block-start:1px solid var(--color-border-subtle);color:var(--text-muted);font-size:var(--font-size-sm);line-height:1.5}
  .entry-panel{min-inline-size:0;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--card-radius)}
  .entry-header{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:var(--space-4);margin-block-end:var(--space-5);padding-block-end:var(--space-4);border-block-end:1px solid var(--color-border-subtle)}
  .entry-kicker{margin:0;color:var(--text-muted);font-size:var(--font-size-xs);font-weight:var(--font-weight-semibold);letter-spacing:.08em;text-transform:uppercase}
  .entry-header h2{margin:var(--space-1) 0 0;color:var(--text-primary);font-size:var(--font-size-xl);overflow-wrap:anywhere}
  .entry-note{margin:var(--space-2) 0 0;max-inline-size:80ch;color:var(--text-secondary);font-size:var(--font-size-sm);line-height:1.5}
  .source-review-note{margin:var(--space-2) 0 0;max-inline-size:80ch;color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.5}
  .draft-meta{display:grid;gap:var(--space-1);max-inline-size:100%;margin:0;padding:var(--space-3);background:var(--surface-raised);border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm);font-size:var(--font-size-xs)}
  .draft-meta p{display:flex;flex-wrap:wrap;gap:var(--space-2);margin:0;min-inline-size:0}
  .draft-meta code{font-family:var(--font-mono);overflow-wrap:anywhere;word-break:break-word}
  .entry-links{margin:0 0 var(--space-4)}
