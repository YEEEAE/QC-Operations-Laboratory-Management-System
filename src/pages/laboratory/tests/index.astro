---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import { laboratoryReadDependencies } from '../../../modules/laboratory/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Flaboratory%2Ftests');
let tests: Awaited<ReturnType<ReturnType<typeof laboratoryReadDependencies>['list']['execute']>> = [];
let providerUnavailable = false;
try { tests = await laboratoryReadDependencies().list.execute(actor); } catch { providerUnavailable = true; }
---
<AppLayout title="Laboratory Tests · QC Operations" locale="en" direction="ltr">
  <section class="head"><div><p class="eyebrow">CONTROLLED LABORATORY</p><h1>Laboratory tests</h1><p class="lede">Review method, sample, result, execution, and approval context without editing controlled history.</p></div><a class="button" href="/laboratory/tests/new">Create laboratory test</a></section>
  {providerUnavailable ? <ProviderUnavailableState title="Laboratory data is temporarily unavailable" description="No test count or result state is shown because the laboratory provider did not confirm a response." /> : tests.length ? <div class="table-wrap"><table><caption>{tests.length} authorized laboratory test{tests.length === 1 ? '' : 's'}</caption><thead><tr><th scope="col">Test ID</th><th scope="col">Sample</th><th scope="col">Method / version</th><th scope="col">State</th><th scope="col">Official result</th><th scope="col">Executor</th><th scope="col">Version</th></tr></thead><tbody>{tests.map((test) => <tr><th scope="row"><a href={`/laboratory/tests/${test.id}`}>{test.labTestNo}</a></th><td>{test.samples.map((sample) => sample.identifier).join(', ') || 'Not recorded'}</td><td>{test.context.methodReference} · v{test.context.versionNo}</td><td>{test.state}</td><td>{test.scientificResult ?? 'Not determined'}</td><td>{test.authorId}</td><td>{test.version.toString()}</td></tr>)}</tbody></table></div> : <section class="empty"><h2>No laboratory tests in this view</h2><p>No authorized tests are available.</p></section>}
</AppLayout>
<style>.head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-5);margin-bottom:var(--space-6)}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede{color:var(--text-muted);font-size:.85rem}.button{display:inline-flex;align-items:center;min-height:var(--control-height);padding:.7rem 1rem;background:var(--color-accent-primary);color:var(--color-text-inverse);border-radius:var(--radius-md);text-decoration:none;font-weight:700}.table-wrap{max-width:100%;overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:1000px;background:var(--surface-panel);border-collapse:collapse}caption{text-align:start;padding:var(--space-4);color:var(--text-muted)}th,td{padding:.75rem;border-top:1px solid var(--color-border-subtle);text-align:start;vertical-align:top;font-size:.8rem}th{font-weight:700}a{color:var(--color-accent-primary-hover)}.empty{padding:var(--space-8);text-align:center;background:var(--surface-panel);border:1px dashed var(--color-border-strong);border-radius:var(--radius-lg)}.empty h2{margin:0 0 .5rem}@media(max-width:650px){.head{display:grid}.button{width:max-content}}</style>
