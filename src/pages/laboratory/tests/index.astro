---
import AppLayout from '../../../ui/layouts/AppLayout.astro'; import { laboratoryReadDependencies } from '../../../modules/laboratory/application/dependencies.js';
const actor=Astro.locals.actor;if(!actor)return Astro.redirect('/login?returnTo=%2Flaboratory%2Ftests');const tests=await laboratoryReadDependencies().list.execute(actor);
---
<AppLayout title="Laboratory Tests · QC Operations"><section class="head"><div><p>CONTROLLED LABORATORY</p><h1>Laboratory tests</h1></div><a href="/laboratory/tests/new">Create laboratory test</a></section><table><caption>Authorized laboratory tests</caption><thead><tr><th>Test ID</th><th>State</th><th>Official result</th><th>Version</th></tr></thead><tbody>{tests.map(test=><tr><th><a href={`/laboratory/tests/${test.id}`}>{test.labTestNo}</a></th><td>{test.state}</td><td>{test.scientificResult??'Not determined'}</td><td>{test.version.toString()}</td></tr>)}</tbody></table></AppLayout>
<style>.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem}.head p{font-size:.75rem;color:var(--text-muted)}a{color:var(--color-accent-primary-hover)}.head>a{padding:.7rem;background:var(--color-accent-primary);color:#fff;border-radius:var(--radius-md);text-decoration:none}table{width:100%;background:var(--surface-panel);border-collapse:collapse}th,td{padding:.75rem;border-top:1px solid var(--color-border-subtle);text-align:start}</style>
