---
import AppLayout from '../../../../../ui/layouts/AppLayout.astro';
import PageHeader from '../../../../../ui/components/PageHeader.astro';
import { actions } from 'astro:actions';
import { laboratoryReadDependencies } from '../../../../../modules/laboratory/application/dependencies.js';
import { uuidv7 } from '../../../../../shared/id/uuid.js';
import { classifyReadFailure, providerUnavailableResponse } from '../../../../../shared/errors/read-failure.js';
import { field } from '../../../../../ui/forms/mutation-post.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const originalId = Astro.params.labTestId ?? '';
let original;
try {
  original = await laboratoryReadDependencies().get.execute({ actor, id: originalId });
} catch (error) {
  if (classifyReadFailure(error) === 'UNAVAILABLE') return providerUnavailableResponse('Original laboratory test is temporarily unavailable', Astro.url.pathname);
  return Astro.redirect('/404');
}
const originalHref = `/laboratory/tests/${original.id}`;
const canRequest = actor.accountState === 'ACTIVE' && actor.permissions.some((p) => p.code === 'PERM-LAB-CREATE' && p.active !== false);
let reason = '';
let investigation = '';
let requestKey = uuidv7();
let errorMessage = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  reason = field(form, 'reason');
  investigation = field(form, 'investigation');
  requestKey = field(form, 'requestKey') || requestKey;
  try {
    const result = await Astro.callAction(actions.laboratory.requestRetest, {
      originalId: original.id,
      expectedVersion: field(form, 'expectedVersion'),
      reason,
      investigation,
      requestKey: field(form, 'requestKey'),
    });
    if (result.error) errorMessage = 'The request was not accepted. Review the current test version and your access before trying again.';
    else if (result.data?.id) return Astro.redirect(`/laboratory/retests/${result.data.id}`, 303);
    else errorMessage = 'The request result could not be confirmed. Check the retest register before retrying.';
  } catch {
    errorMessage = 'The request could not be saved. Your entries are still shown; refresh the original test before retrying.';
  }
}
---
<AppLayout title="Request a laboratory retest" locale="en" direction="ltr">
  <main class="workspace">
    <PageHeader section="Laboratory">
      <Fragment slot="heading"><h1>Request a retest</h1></Fragment>
      <p class="lede">The request starts an investigation and internal decision. It does not change the original result or release state.</p>
      <Fragment slot="actions"><a href={originalHref}>Open original test</a></Fragment>
    </PageHeader>
    <section class="panel" aria-labelledby="original-heading">
      <h2 id="original-heading">Original test — read only</h2>
      <dl><div><dt>Test number</dt><dd>{original.labTestNo}</dd></div><div><dt>Version</dt><dd>{original.version.toString()}</dd></div><div><dt>Workflow state</dt><dd>{original.state}</dd></div><div><dt>Scientific result</dt><dd>{original.scientificResult ?? 'Not recorded'}</dd></div><div><dt>Method</dt><dd>{original.context.methodReference}</dd></div><div><dt>Source hash</dt><dd><code>{original.context.contentHash}</code></dd></div></dl>
      <p>Original measurements, result, and signatures remain unchanged.</p>
    </section>
    {canRequest ? (
      <form method="post" class="panel form">
        <input type="hidden" name="expectedVersion" value={original.version.toString()} />
        <input type="hidden" name="requestKey" value={requestKey} />
        {errorMessage && <p class="feedback" role="alert" tabindex="-1">{errorMessage}</p>}
        <div class="field"><label for="reason">Reason for requesting a retest</label><textarea id="reason" name="reason" required rows="3">{reason}</textarea></div>
        <div class="field"><label for="investigation">Investigation and evidence</label><p id="investigation-help">Record the investigation and evidence supporting this request. Do not enter a proposed PASS or final disposition.</p><textarea id="investigation" name="investigation" required rows="6" aria-describedby="investigation-help">{investigation}</textarea></div>
        <p class="blocker"><strong>Method decision required:</strong> the current controlled method source does not establish retest eligibility, test-number allocation, or conflicting-result disposition. A saved request stays pending those source rules.</p>
        <div class="actions"><button type="submit">Save retest request</button><a href={originalHref}>Cancel</a></div>
      </form>
    ) : <p class="blocker" role="status">Request permission is not available for this account.</p>}
  </main>
</AppLayout>
<style>
  .workspace{display:grid;gap:var(--space-5);min-inline-size:0}.lede{color:var(--text-muted)}.panel{max-inline-size:64rem;padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}h2{margin-block:0 var(--space-4);font-size:var(--font-size-lg)}dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr));gap:var(--space-3);margin:0}dt{color:var(--text-muted);font-size:var(--font-size-xs)}dd{margin:var(--space-1) 0 0;overflow-wrap:anywhere}code{font-size:var(--font-size-xs);overflow-wrap:anywhere}.form{display:grid;gap:var(--space-4)}.field{display:grid;gap:var(--space-2)}label{font-weight:var(--font-weight-semibold)}textarea{inline-size:100%;box-sizing:border-box;min-block-size:6rem;padding:var(--space-3);border:1px solid var(--control-border);border-radius:var(--radius-sm);background:var(--surface-inset);color:var(--text-primary);font:inherit;resize:vertical}.blocker,.feedback{padding:var(--space-3);border-inline-start:3px solid var(--status-warning);background:var(--surface-inset)}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-3)}button,.actions a{min-block-size:44px;padding:var(--space-2) var(--space-4);font:inherit}.actions button{border:0;border-radius:var(--radius-sm);background:var(--color-accent-primary);color:var(--text-on-accent)}:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}@media(max-width:600px){.panel{padding:var(--space-4)}.actions>*{inline-size:100%}}
</style>
