---
import { laboratoryActionDependencies } from '../../../../modules/laboratory/application/dependencies.js';
import { bulkMeasurementPreviewForm } from '../../../../modules/laboratory/application/measurement-bulk-preview.js';
import { authorizeLab } from '../../../../modules/laboratory/application/lab-authorization.js';
import { decodeMeasurementPost } from '../../../../modules/laboratory/application/measurement-post.js';
import { parseExpectedVersionField } from '../../../../ui/forms/mutation-post.js';
import { AppError } from '../../../../shared/errors/app-error.js';
import PageHeader from '../../../../ui/components/PageHeader.astro';
import AppLayout from '../../../../ui/layouts/AppLayout.astro';
import { classifyReadFailure, providerUnavailableResponse } from '../../../../shared/errors/read-failure.js';
import JourneyContextPanel from '../../../../ui/components/workflow/JourneyContextPanel.astro';
import { laboratoryReadDependencies } from '../../../../modules/laboratory/application/dependencies.js';
import { assetsReadDependencies } from '../../../../modules/assets/application/dependencies.js';
import { equipmentEligibilityOptionLabel } from '../../../../ui/forms/equipment-eligibility.js';
import { entryParameters } from '../../../../modules/laboratory/application/lab-presentation.js';
import { stateLabel } from '../../../../shared/copy/ux-vocabulary.js';

const actor = Astro.locals.actor;
if (!actor)
  return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
let test;
try {
  test = await laboratoryReadDependencies().get.execute({ actor, id: Astro.params.labTestId ?? '' });
} catch (error) {
  if (classifyReadFailure(error) === 'UNAVAILABLE') return providerUnavailableResponse('Laboratory test details are temporarily unavailable', Astro.url.pathname + Astro.url.search);
  return Astro.redirect('/404');
}
let submitted: FormData | undefined;
let saveError: string | undefined;
let bulkRows = '';
let bulkPreviewReady = false;
let openedVersion = test.version.toString();
if (Astro.request.method === 'POST') {
  try {
    submitted = await Astro.request.formData();
    openedVersion = String(submitted.get('expectedVersion') ?? '');
    const expectedVersion = parseExpectedVersionField(openedVersion);
    if (submitted.get('intent') === 'preview-bulk') {
      authorizeLab(actor, test, 'PERM-LAB-EDIT-DRAFT', 'SAVE', expectedVersion);
      authorizeLab(actor, test, 'PERM-LAB-ENTER-MEASUREMENT', 'SAVE', expectedVersion);
      bulkRows = String(submitted.get('bulkRows') ?? '');
      if (test.state !== 'DRAFT' || [...submitted.keys()].some((key) => !['expectedVersion', 'intent', 'bulkRows'].includes(key) || submitted!.getAll(key).length !== 1))
        throw new AppError('VALIDATION_FAILED');
      submitted = bulkMeasurementPreviewForm(test, bulkRows, openedVersion);
      bulkPreviewReady = true;
    } else {
    if (submitted.get('intent') !== 'save') throw new AppError('VALIDATION_FAILED');
    const measurements = decodeMeasurementPost(test, submitted);
    await laboratoryActionDependencies().saveMeasurements.execute({
      actor, id: test.id, expectedVersion, samples: test.samples, measurements,
      requestId: Astro.locals.requestContext?.requestId ?? 'unknown',
    });
    return Astro.redirect(Astro.url.pathname, 303);
    }
  } catch (error) {
    Astro.response.status = error instanceof AppError && error.category === 'AUTHORIZATION' ? 403
      : error instanceof AppError && error.code === 'CONFLICT_STALE_VERSION' ? 409 : 400;
    if (bulkRows) submitted = undefined;
    saveError = error instanceof AppError && error.code === 'CONFLICT_STALE_VERSION'
      ? 'This record changed. Your entries are kept below. Check the current record and refresh before saving again.'
      : 'Observations were not confirmed as saved. Your entries are kept below. Check the values, access, current record and history before trying again.';
  }
}
const stateEditable = test.state === 'DRAFT';
const hasPermission = (code: string) =>
  actor.permissions.some((permission) => permission.code === code && permission.active !== false);
const canEdit = stateEditable && hasPermission('PERM-LAB-EDIT-DRAFT');
const canSubmit = canEdit && hasPermission('PERM-LAB-SUBMIT');

// QC-100-FINAL-038 R1/R2: the entry grid is built from the frozen controlled
// context — units, precision guidance, approved criteria and sample
// identifiers are rendered, never re-typed. The server still validates every
// value against the same controlled context on save.
const parameters = entryParameters(test);
const requiredParameterCount = parameters.filter((parameter) => parameter.required).length;
const measurementOf = (sampleId: string, parameterId: string) =>
  test.measurements.find((m) => m.sampleId === sampleId && m.parameterId === parameterId);
const cellValue = (sampleId: string, parameterId: string): string => {
  if (submitted) return String(submitted.get(`value-${sampleId}:${parameterId}`) ?? '');
  const raw = measurementOf(sampleId, parameterId)?.raw;
  if (raw === null || raw === undefined) return '';
  return typeof raw === 'boolean' ? String(raw) : raw;
};
const documents = test.context.documents;
const equipment = await laboratoryReadDependencies().equipmentUsage.listForTest(test.id);
let equipmentOptions: { id: string; calibrationId: string; label: string; eligible: boolean }[] = [];
let equipmentSourceError = false;
const canViewEquipment =
  hasPermission('PERM-EQP-VIEW') &&
  hasPermission('PERM-CAL-VIEW') &&
  hasPermission('PERM-MNT-VIEW');
if (canEdit && canViewEquipment) {
  try {
    const assets = assetsReadDependencies();
    const items = await assets.equipment.list.execute({ actor });
    equipmentOptions = await Promise.all(items.map(async (item) => {
      const assessment = await assets.equipment.assessEligibility.assess(actor, item.id);
      return {
        id: item.id,
        calibrationId: item.currentCalibrationId ?? '',
        label: equipmentEligibilityOptionLabel(`${item.equipmentNo} · ${item.name}`, assessment),
        eligible: assessment.eligible,
      };
    }));
  } catch {
    equipmentSourceError = true;
  }
}
const savedFeedback =
  saveError ??
  (bulkPreviewReady
    ? 'Bulk observations validated for preview. Review the values and remarks below before saving. No observations have been saved.'
    : 'The server confirms each save. Your entries stay on this page until a save is confirmed.');
---

<AppLayout title={`Execute ${test.labTestNo}`} locale="en" direction="ltr">
  <div class="execute-page">
    <PageHeader>
      <Fragment slot="heading">
        <h1>Laboratory execution</h1>
      </Fragment>
      <p class="record-meta">
        <span>{test.labTestNo}</span>
        <span class="meta-separator" aria-hidden="true">·</span>
        <span>{test.context.methodReference}</span>
        <span class="meta-separator" aria-hidden="true">·</span>
        <span>Record version <span class="numeric">{test.version.toString()}</span></span>
        <span class="meta-separator" aria-hidden="true">·</span>
        <span>Template version <span class="numeric">{test.context.versionNo}</span></span>
      </p>
      <Fragment slot="actions">
        <span class="state" data-state={test.state}>{stateLabel(test.state)}</span>
      </Fragment>
    </PageHeader>

    <JourneyContextPanel
      ownerDomain="Laboratory"
      recordReference={`${test.labTestNo} · version ${test.version.toString()}`}
      currentState={stateLabel(test.state)}
      nextAction={canEdit ? canSubmit ? 'Save observations or submit for review' : 'Save observations' : 'Read-only'}
      nextOwner={canEdit ? 'Laboratory executor' : undefined}
      whyUnavailable={!canEdit ? stateEditable ? 'permission: draft editing is not available to this account' : 'state: this record is not editable in its current state' : undefined}
      controlledContext={`${test.samples.length} sample(s) · ${test.context.methodReference} · version ${test.context.versionNo} · source ${test.context.sourceReference}`}
      evidenceSummary={`${test.measurements.length} raw measurement(s) · ${equipment.length} equipment/calibration usage snapshot(s)`}
      auditHref={`/audit?subjectType=LAB_TEST&subjectId=${encodeURIComponent(test.id)}`}
      relatedLinks={[{ label: 'Laboratory test record', href: `/laboratory/tests/${test.id}`, detail: 'Read-only record overview' }]}
    />

    {
      !canEdit ? (
        <section class="panel" aria-labelledby="read-only-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Execution access</p>
              <h2 id="read-only-heading">This record is read-only</h2>
            </div>
            <span class="section-index" aria-hidden="true">01</span>
          </div>
          {saveError ? (
            <p role="alert" class="feedback">
              {saveError} <a href={Astro.url.pathname}>Refresh record</a>
            </p>
          ) : null}
          <p role="status" class="notice">
            This record is read-only. {stateEditable
              ? 'Your account lacks the explicit draft-edit permission.'
              : 'This state cannot be edited here; returned records need a controlled resume before editing.'}
          </p>
          <p class="muted">
            Execution stays read-only until the record is editable in its current state and the
            account holds the explicit draft-edit permission. Page visibility never grants
            authority, and nothing on this page is recorded until the server accepts it.
          </p>
        </section>
      ) : (
        <>
          <section class="panel" aria-labelledby="observations-heading">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Draft entry</p>
                <h2 id="observations-heading">Raw observations</h2>
              </div>
              <span class="section-index" aria-hidden="true">01</span>
            </div>
            <p class="section-intro">
              Raw values are validated on the server against the controlled method. Units and
              approved criteria below come from the frozen method context — enter each value in the
              unit shown. The browser collects raw inputs only; the official result is returned by
              the server.
            </p>

            <div class="samples-block">
              <div class="samples-heading">
                <h3>Samples in this record</h3>
                <p class="samples-meta">
                  <span class="numeric">{test.samples.length}</span> sample(s) in recorded order ·
                  <span class="numeric"> {parameters.length}</span> controlled parameter(s) ·
                  <span class="numeric"> {requiredParameterCount}</span> required
                </p>
              </div>
              <ul class="samples">
                {test.samples.map((sample) => (
                  <li>{sample.identifier}</li>
                ))}
              </ul>
              <p class="muted">
                Sample identifiers, their order and the indicated units are frozen with this record.
                This page does not add, remove, rename or reorder samples.
              </p>
            </div>

            <details class="bulk-entry">
              <summary>Paste observations from Excel</summary>
              <div class="bulk-body">
                <p>
                  Copy five columns with this exact header: Sample, Parameter, Value, Unit, Remarks.
                  Use the sample identifiers below and the parameter codes shown in the table. Leave
                  Unit empty for a unitless parameter; Boolean values use true or false.
                </p>
                <p>
                  Preview keeps other saved observations. Review the entire entry form, then choose
                  Save observations. Preview does not save data.
                </p>
                <form method="post" action={Astro.url.pathname}>
                  <input type="hidden" name="expectedVersion" value={openedVersion} />
                  <input type="hidden" name="intent" value="preview-bulk" />
                  <label for="bulkRows">Excel clipboard rows</label>
                  <textarea id="bulkRows" name="bulkRows" rows="8" required>{bulkRows}</textarea>
                  <p class="field-help">
                    Tab-separated rows only. A value must use the unit shown for its parameter; a
                    blank value cannot carry remarks.
                  </p>
                  <div class="action-row">
                    <button type="submit" class="action-secondary">Preview observations</button>
                  </div>
                </form>
              </div>
            </details>

            <form method="post" action={Astro.url.pathname} data-lab-measurements data-expected-version={openedVersion}>
              <input type="hidden" name="expectedVersion" value={openedVersion} />
              <input type="hidden" name="intent" value="save" />
              {test.samples.map((sample) => (
                <input
                  type="hidden"
                  data-sample
                  data-sample-id={sample.id}
                  value={sample.identifier}
                />
              ))}
              <div class="table-scroll" role="region" aria-label="Controlled measurement entry" tabindex="0">
                <table class="measurements">
                  <caption>Controlled measurement entry for {test.labTestNo}</caption>
                  <thead>
                    <tr>
                      <th scope="col">Sample</th>
                      {parameters.map((parameter) => (
                        <th scope="col">
                          <span class="param-title">
                            {parameter.label}
                            {parameter.required ? <span aria-hidden="true"> *</span> : null}
                          </span>
                          <span class="param-meta">Code: {parameter.code}</span>
                          {parameter.unit ? <span class="unit"> ({parameter.unit})</span> : null}
                          <span class="param-meta">
                            {parameter.criteriaText}
                            {parameter.precisionGuidance ? ` · Precision: ${parameter.precisionGuidance}` : null}
                            {` · Source: ${parameter.sourceReference}`}
                          </span>
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {test.samples.map((sample) => (
                      <tr>
                        <th scope="row">{sample.identifier}</th>
                        {parameters.map((parameter) => (
                          <td>
                            {parameter.dataType === 'BOOLEAN' ? (
                              <select
                                name={`value-${sample.id}:${parameter.id}`}
                                data-measurement
                                data-sample-id={sample.id}
                                data-parameter-id={parameter.id}
                                data-data-type={parameter.dataType}
                                data-unit={parameter.unit ?? ''}
                                aria-label={`${parameter.label} for sample ${sample.identifier}`}
                              >
                                <option value="" selected={cellValue(sample.id, parameter.id) === ''}>
                                  —
                                </option>
                                <option value="true" selected={cellValue(sample.id, parameter.id) === 'true'}>
                                  Yes
                                </option>
                                <option value="false" selected={cellValue(sample.id, parameter.id) === 'false'}>
                                  No
                                </option>
                              </select>
                            ) : (
                              <input
                                type="text"
                                inputmode={parameter.dataType === 'NUMERIC' ? 'decimal' : undefined}
                                name={`value-${sample.id}:${parameter.id}`}
                                data-measurement
                                data-sample-id={sample.id}
                                data-parameter-id={parameter.id}
                                data-data-type={parameter.dataType}
                                data-unit={parameter.unit ?? ''}
                                value={cellValue(sample.id, parameter.id)}
                                aria-label={`${parameter.label}${parameter.unit ? ` (${parameter.unit})` : ''} for sample ${sample.identifier}`}
                              />
                            )}
                            <label class="measurement-remarks">
                              Remarks
                              <textarea
                                name={`remarks-${sample.id}:${parameter.id}`}
                                data-measurement-remarks
                                data-sample-id={sample.id}
                                data-parameter-id={parameter.id}
                                rows="2"
                                aria-label={`Remarks for ${parameter.label} for sample ${sample.identifier}`}
                              >{submitted ? String(submitted.get(`remarks-${sample.id}:${parameter.id}`) ?? '') : measurementOf(sample.id, parameter.id)?.remarks ?? ''}</textarea>
                            </label>
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <p data-save-result role={saveError ? 'alert' : 'status'} tabindex="-1" class="feedback">
                {savedFeedback}
                {saveError ? <a href={Astro.url.pathname}> Refresh record</a> : null}
              </p>
              <div class="action-row">
                <button type="submit" data-save-measurements class="action-primary">Save observations</button>
                <span class="action-hint">
                  Saves the draft only. Submission for review is a separate, authorized step below.
                </span>
              </div>
            </form>
          </section>

          <section class="panel" aria-labelledby="submission-heading">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Workflow</p>
                <h2 id="submission-heading">Submit for review</h2>
              </div>
              <span class="section-index" aria-hidden="true">02</span>
            </div>
            <p class="section-intro">
              Submission checks the frozen sources, required context and recorded equipment on the
              server. Saving observations does not submit the test, and submission does not set the
              official result.
            </p>
            {
              canSubmit ? (
                <button type="button" class="action-primary" data-submit data-expected-version={test.version.toString()}>
                  Submit for review
                </button>
              ) : (
                <p class="muted">
                  Submission is unavailable because your account lacks the explicit laboratory
                  submission permission.
                </p>
              )
            }
            <p data-result role="status" tabindex="-1" class="feedback">
              The record reloads only after the server accepts the submission; any pending or
              blocked state is reported here.
            </p>
          </section>

          <section class="panel" aria-labelledby="equipment-use-heading">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Run evidence</p>
                <h2 id="equipment-use-heading">Equipment used for a run</h2>
              </div>
              <span class="section-index" aria-hidden="true">03</span>
            </div>
            <p class="section-intro">
              Choose a run and equipment. Eligibility and calibration are checked before recording;
              their details are preserved at the time of use.
            </p>
            {
              canViewEquipment ? equipmentSourceError ? (
                <p role="status" class="notice">
                  The authorized equipment source is temporarily unavailable. No equipment usage was
                  recorded.
                </p>
              ) : equipmentOptions.length ? (
                <form data-record-equipment data-expected-version={test.version.toString()}>
                  <div class="equipment-grid">
                    <div class="equipment-field">
                      <label for="equipmentBatchId">Run</label>
                      <select id="equipmentBatchId" name="batchId" required>
                        <option value="">Select a run…</option>
                        {(test.batches ?? []).map((batch) => <option value={batch.id}>{batch.batchNo}{batch.label ? ` · ${batch.label}` : ''}</option>)}
                      </select>
                    </div>
                    <div class="equipment-field">
                      <label for="equipmentChoice">Equipment</label>
                      <select id="equipmentChoice" name="equipmentId" required>
                        <option value="">Select equipment…</option>
                        {equipmentOptions.map((item) => <option value={item.id} data-calibration-id={item.calibrationId} disabled={!item.eligible}>{item.label}</option>)}
                      </select>
                      <p class="field-help">
                        Ineligible or unavailable equipment stays disabled. Eligibility is decided by
                        the server, not by the browser.
                      </p>
                    </div>
                  </div>
                  <div class="action-row">
                    <button type="submit" class="action-secondary" data-record-equipment-button>Record equipment use</button>
                  </div>
                  <p data-equipment-result role="status" tabindex="-1" class="feedback">
                    Recorded usage appears in the frozen context below after the server confirms it.
                  </p>
                </form>
              ) : (
                <p class="muted">No equipment is available in your authorized scope. Ask an authorized equipment owner to confirm the record.</p>
              ) : (
                <p role="status" class="notice">Equipment selection is unavailable because your account lacks explicit equipment, calibration, or maintenance view permission.</p>
              )
            }
          </section>
        </>
      )
    }

    <aside class="panel context-panel" aria-labelledby="frozen-context-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Read-only context</p>
          <h2 id="frozen-context-heading">Frozen context</h2>
        </div>
        <span class="section-index" aria-hidden="true">04</span>
      </div>

      <div class="context-grid">
        <section class="context-block result-block" aria-labelledby="official-result-heading">
          <h3 id="official-result-heading">Official result from server</h3>
          <p class="result-value" data-scientific-result={test.scientificResult ?? 'NOT_DETERMINED'}>
            <strong>{test.scientificResult ?? 'Not determined by the server yet'}</strong>
          </p>
          <p class="muted">
            The official result is set only by the server-side approved evaluation source. It is
            independent of workflow state, and this page does not evaluate measurements, criteria,
            limits or units.
          </p>
        </section>

        <section class="context-block" aria-labelledby="controlled-source-heading">
          <h3 id="controlled-source-heading">Controlled source</h3>
          <dl class="facts-grid">
            <div><dt>Method</dt><dd>{test.context.methodReference}</dd></div>
            <div><dt>Template version</dt><dd>{test.context.versionNo}</dd></div>
            <div><dt>Criteria source</dt><dd>{test.context.sourceReference || 'Not supplied by record source'}</dd></div>
            <div><dt>Result source</dt><dd>{test.context.sourceReference || 'Not supplied by record source'}</dd></div>
          </dl>
        </section>

        <section class="context-block" aria-labelledby="controlled-documents-heading">
          <h3 id="controlled-documents-heading">Controlled documents</h3>
          {
            documents.length ? (
              <ul class="context-list">
                {documents.map((document) => (
                  <li>
                    <span>
                      {String(document.snapshot.documentNo ?? '')} — {String(document.snapshot.title ?? '')}
                      {document.snapshot.revision ? ` (rev. ${String(document.snapshot.revision)})` : ''}
                    </span>
                    <span class="context-meta">{document.usageType}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="muted">No controlled documents are linked to this method context.</p>
            )
          }
        </section>

        <section class="context-block" aria-labelledby="equipment-records-heading">
          <h3 id="equipment-records-heading">Equipment records</h3>
          {
            equipment.length ? (
              <ul class="context-list equipment-records">
                {equipment.map((item) => (
                  <li>
                    <span>
                      <strong>{String(item.equipmentSnapshot.equipmentNo ?? item.equipmentId)}</strong> · used at {item.usedAt}
                      {item.usageRole ? ` · ${item.usageRole}` : ''}
                    </span>
                    <dl class="snapshot-facts">
                      <div><dt>Calibration record</dt><dd>{item.calibrationRecordId || 'Not supplied by source'}</dd></div>
                      <div><dt>Calibration snapshot at use</dt><dd><pre>{JSON.stringify(item.calibrationSnapshot, null, 2)}</pre></dd></div>
                      <div><dt>Equipment snapshot at use</dt><dd><pre>{JSON.stringify(item.equipmentSnapshot, null, 2)}</pre></dd></div>
                    </dl>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="muted">
                No equipment is recorded for this test yet. Record the equipment used for each run
                above; eligibility is checked before recording.
              </p>
            )
          }
        </section>
      </div>
    </aside>
  </div>
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  import { measurementInputValue } from '../../../../modules/laboratory/application/measurement-input';
  import { guardUnsavedChanges, FORM_COMMITTED_EVENT } from '../../../../ui/forms/unsaved-changes';

  const labId = location.pathname.split('/')[3] || '';
  const form = document.querySelector<HTMLFormElement>('form[data-lab-measurements]');
  const saveOut = document.querySelector<HTMLElement>('[data-save-result]');
  if (form) guardUnsavedChanges(form);

  // Field adjacency: a value marked invalid is cleared as soon as the operator
  // edits that point, so the state never outlives the corrected input.
  form?.addEventListener('input', (event) => {
    const target = event.target;
    if (target instanceof HTMLElement && target.matches('[data-measurement]'))
      target.removeAttribute('aria-invalid');
  });
  form?.addEventListener('change', (event) => {
    const target = event.target;
    if (target instanceof HTMLElement && target.matches('[data-measurement]'))
      target.removeAttribute('aria-invalid');
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (form.getAttribute('aria-busy') === 'true') return;
    const button = form.querySelector<HTMLButtonElement>('[data-save-measurements]');
    if (button) button.disabled = true;
    form.setAttribute('aria-busy', 'true');
    if (saveOut) {
      saveOut.setAttribute('role', 'status');
      saveOut.textContent = 'Saving observations…';
    }
    const samples = Array.from(form.querySelectorAll<HTMLInputElement>('[data-sample]')).map(
      (el) => ({ id: el.dataset.sampleId ?? '', identifier: el.value }),
    );
    const remarksByPoint = new Map(
      Array.from(form.querySelectorAll<HTMLTextAreaElement>('[data-measurement-remarks]')).map(
        (el) => [`${el.dataset.sampleId ?? ''}:${el.dataset.parameterId ?? ''}`, el.value],
      ),
    );
    const entries = Array.from(form.querySelectorAll<HTMLElement>('[data-measurement]'));
    const invalidEntry = entries.find((el) => {
      const element = el as HTMLInputElement | HTMLSelectElement;
      const key = `${element.dataset.sampleId ?? ''}:${element.dataset.parameterId ?? ''}`;
      return element.value === '' && Boolean((remarksByPoint.get(key) ?? '').trim());
    }) as HTMLInputElement | HTMLSelectElement | undefined;
    if (invalidEntry) {
      if (saveOut)
        saveOut.textContent =
          'Enter a value before saving its remarks. A blank value is not a recorded result.';
      invalidEntry.setAttribute('aria-invalid', 'true');
      invalidEntry.focus();
      if (button) button.disabled = false;
      form.removeAttribute('aria-busy');
      return;
    }
    const measurements = entries
      .map((el) => {
        const element = el as HTMLInputElement | HTMLSelectElement;
        const value = element.value;
        if (value === '') return null;
        const remark = remarksByPoint.get(
          `${element.dataset.sampleId ?? ''}:${element.dataset.parameterId ?? ''}`,
        );
        return {
          sampleId: element.dataset.sampleId ?? '',
          parameterId: element.dataset.parameterId ?? '',
          raw: measurementInputValue(
            element.dataset.dataType as 'NUMERIC' | 'TEXT' | 'BOOLEAN',
            value,
          ),
          unit: element.dataset.unit ? element.dataset.unit : null,
          ...(remark ? { remarks: remark } : {}),
        };
      })
      .filter((m) => m !== null);
    try {
      const result = await actions.laboratory.saveMeasurements({
        id: labId,
        expectedVersion: BigInt(form.dataset.expectedVersion || '0'),
        samples,
        measurements,
      });
      if (result.data) {
        form.dispatchEvent(new CustomEvent(FORM_COMMITTED_EVENT));
        location.reload();
      } else {
        if (saveOut) {
          saveOut.textContent =
            'Observations were not saved. Check every required value uses the unit shown and the record has not changed — refresh and try again if permitted.';
          saveOut.focus?.();
        }
        if (button) button.disabled = false;
      }
    } catch {
      if (saveOut) {
        saveOut.textContent =
          'The service did not confirm the result. Your entries are kept on this page. Refresh the record and its history before deciding whether to try again.';
        saveOut.focus?.();
      }
      if (button) button.disabled = false;
    } finally {
      form.removeAttribute('aria-busy');
    }
  });

  const btn = document.querySelector<HTMLButtonElement>('[data-submit]');
  const el = document.querySelector<HTMLElement>('[data-result]');
  btn?.addEventListener('click', async () => {
    if (!btn || btn.disabled || btn.closest('[aria-busy="true"]')) return;
    btn.disabled = true;
    btn.setAttribute('aria-busy', 'true');
    if (el) el.textContent = 'Submitting for review…';
    try {
      const result = await actions.laboratory.submit({
        id: labId,
        expectedVersion: BigInt(btn.dataset.expectedVersion || '0'),
      });
      if (result.data) location.reload();
      else {
        if (el) {
          el.textContent =
            'Submission is blocked until controlled sources and required context are verified, or the record changed — refresh and try again if permitted.';
          el.focus?.();
        }
        btn.disabled = false;
      }
    } catch {
      if (el) {
        el.textContent =
          'The service did not confirm the result. Refresh the test and its result history before deciding whether to try again.';
        el.focus?.();
      }
      btn.disabled = false;
    } finally {
      btn.removeAttribute('aria-busy');
    }
  });

  const equipmentForm = document.querySelector<HTMLFormElement>('form[data-record-equipment]');
  const equipmentResult = document.querySelector<HTMLElement>('[data-equipment-result]');
  equipmentForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = equipmentForm.querySelector<HTMLButtonElement>('[data-record-equipment-button]');
    const selected = equipmentForm.querySelector<HTMLSelectElement>('#equipmentChoice')?.selectedOptions[0];
    const equipmentId = selected?.value ?? '';
    const calibrationRecordId = selected?.dataset.calibrationId ?? '';
    const batchId = equipmentForm.querySelector<HTMLSelectElement>('#equipmentBatchId')?.value ?? '';
    if (!button || button.disabled || !equipmentId || !calibrationRecordId || !batchId) return;
    button.disabled = true;
    equipmentForm.setAttribute('aria-busy', 'true');
    if (equipmentResult) equipmentResult.textContent = 'Checking eligibility and recording equipment use…';
    try {
      const result = await actions.laboratory.recordRunEquipment({
        id: labId,
        expectedVersion: BigInt(equipmentForm.dataset.expectedVersion || '0'),
        batchId,
        usage: { equipmentId, calibrationRecordId, usageRole: 'MEASUREMENT' },
      });
      if (result.data) location.reload();
      else {
        if (equipmentResult) {
          equipmentResult.textContent = 'Equipment use was not recorded. The equipment may no longer be eligible or the record may have changed. Refresh and choose an eligible record.';
          equipmentResult.focus?.();
        }
        button.disabled = false;
      }
    } catch {
      if (equipmentResult) {
        equipmentResult.textContent = 'The equipment-use result could not be confirmed. Check the test and its history before retrying.';
        equipmentResult.focus?.();
      }
      button.disabled = false;
    } finally {
      equipmentForm.removeAttribute('aria-busy');
    }
  });
</script>
