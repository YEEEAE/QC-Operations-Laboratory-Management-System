---
import AppLayout from '../../../../ui/layouts/AppLayout.astro'; import { laboratoryReadDependencies } from '../../../../modules/laboratory/application/dependencies.js';const actor=Astro.locals.actor;if(!actor)return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);let test;try{test=await laboratoryReadDependencies().get.execute({actor,id:Astro.params.labTestId??''});}catch{return Astro.redirect('/404');}const editable=test.state==='DRAFT';
---
<AppLayout title={`Execute ${test.labTestNo}`}><h1>Laboratory execution</h1><p>{test.labTestNo} · {test.context.methodReference} · Version {test.version.toString()}</p>{!editable?<p role="status">This record is read-only. Returned records need a controlled resume before editing.</p>:<section><h2>Raw observations</h2><p>Raw values, units, precision guidance, and acceptance criteria are validated on the server from the controlled method.</p><p>Samples: {test.samples.length}; measurements: {test.measurements.length}</p><button data-submit>Submit for review</button><p data-result role="status"></p></section>}<aside><h2>Frozen context</h2><p>Criteria source: {test.context.sourceReference}</p><p>Equipment records: {test.context.equipment.length}</p><p>Controlled documents: {test.context.documents.length}</p></aside></AppLayout>
<script>import{actions}from'astro:actions';document.querySelector('[data-submit]')?.addEventListener('click',async()=>{const result=await actions.laboratory.submit({id:location.pathname.split('/')[3]||'',expectedVersion:BigInt('{test.version.toString()}')});const el=document.querySelector('[data-result]');if(result.data)location.reload();else if(el)el.textContent='Submission is blocked until controlled sources and required context are verified.';});</script><style>section,aside{padding:1rem;margin-top:1rem;background:var(--surface-panel);border:1px solid var(--color-border-subtle)}button{padding:.7rem;background:var(--color-accent-primary);color:white;border:0;border-radius:var(--radius-md)}</style>
