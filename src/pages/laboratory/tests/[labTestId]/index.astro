---
import AppLayout from '../../../../ui/layouts/AppLayout.astro'; import JourneyContextPanel from '../../../../ui/components/workflow/JourneyContextPanel.astro'; import { laboratoryReadDependencies } from '../../../../modules/laboratory/application/dependencies.js';const actor=Astro.locals.actor;if(!actor)return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);let test;try{test=await laboratoryReadDependencies().get.execute({actor,id:Astro.params.labTestId??''});}catch{return Astro.redirect('/404');}
const hasPermission = (code: string) => actor.permissions.some((permission) => permission.code === code && permission.active !== false);
const canExecute = test.state === 'DRAFT' && hasPermission('PERM-LAB-EDIT-DRAFT');
const canReview = ['SUBMITTED', 'UNDER_REVIEW'].includes(test.state) && hasPermission('PERM-LAB-REVIEW') && hasPermission('PERM-APR-REVIEW');
---
<AppLayout title={`${test.labTestNo} · Laboratory`}><h1>{test.labTestNo}</h1><p>State: <strong>{test.state}</strong> · Official result: <strong>{test.scientificResult??'Not determined'}</strong> · Version {test.version.toString()}</p><JourneyContextPanel ownerDomain="Laboratory" currentState={`${test.state} · Result ${test.scientificResult ?? 'NOT_DETERMINED'}`} nextAction={canExecute ? 'Open execution workspace' : canReview ? 'Open review workspace' : 'No laboratory action is available'} nextActionHref={canExecute ? `/laboratory/tests/${test.id}/execute` : canReview ? `/laboratory/tests/${test.id}/review` : undefined} nextOwner={test.state === 'DRAFT' ? 'Laboratory executor' : ['SUBMITTED', 'UNDER_REVIEW'].includes(test.state) ? 'Laboratory reviewer' : undefined} whyUnavailable={!canExecute && test.state === 'DRAFT' ? 'permission: draft editing is not available to this account' : !canReview && ['SUBMITTED', 'UNDER_REVIEW'].includes(test.state) ? 'permission/state: review is unavailable for this account or current state' : undefined} waitingOn={test.state === 'SUBMITTED' ? 'Laboratory reviewer' : test.state === 'UNDER_REVIEW' ? 'Approval decision' : undefined} expectedEvent={test.state === 'DRAFT' ? 'Submit test for review' : test.state === 'SUBMITTED' ? 'Begin review' : test.state === 'UNDER_REVIEW' ? 'Approve or return' : undefined} controlledContext={`${test.context.methodReference} · template ${test.context.versionNo} · source ${test.context.sourceReference}`} evidenceSummary={`${test.measurements.length} measurements · controlled equipment/calibration context preserved`} auditHref={`/audit?subjectType=LAB_TEST&subjectId=${encodeURIComponent(test.id)}`} relatedLinks={[{ label: 'Laboratory register', href: '/laboratory/tests', detail: 'Laboratory-owned records' }]} /><section><h2>Controlled context</h2><dl><dt>Method</dt><dd>{test.context.methodReference}</dd><dt>Template version</dt><dd>{test.context.versionNo}</dd><dt>Source</dt><dd>{test.context.sourceReference}</dd></dl></section><section class="next"><h2>Next workspace</h2>{canExecute ? <a href={`/laboratory/tests/${test.id}/execute`}>Open execution workspace</a> : <p>Execution is read-only: the current state or your account does not allow draft editing.</p>}{canReview ? <a href={`/laboratory/tests/${test.id}/review`}>Open review workspace</a> : <p>Review is unavailable for the current state or account. Page visibility does not grant review authority.</p>}<p>Retest is currently unavailable until the approved laboratory retest policy defines its authority and sequence. The original test remains unchanged.</p></section></AppLayout><style>section{padding:1rem;background:var(--surface-panel);border:1px solid var(--color-border-subtle)}dl{display:grid;grid-template-columns:auto 1fr;gap:.5rem 1rem}dd{margin:0}.next{display:grid;gap:.6rem;margin-top:1rem}.next p{margin:0;color:var(--text-muted)}a{color:var(--color-accent-primary-hover)}</style>
