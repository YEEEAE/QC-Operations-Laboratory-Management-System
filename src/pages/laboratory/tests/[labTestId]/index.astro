---
import AppLayout from '../../../../ui/layouts/AppLayout.astro'; import { laboratoryReadDependencies } from '../../../../modules/laboratory/application/dependencies.js';const actor=Astro.locals.actor;if(!actor)return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);let test;try{test=await laboratoryReadDependencies().get.execute({actor,id:Astro.params.labTestId??''});}catch{return Astro.redirect('/404');}
---
<AppLayout title={`${test.labTestNo} · Laboratory`}><h1>{test.labTestNo}</h1><p>State: <strong>{test.state}</strong> · Official result: <strong>{test.scientificResult??'Not determined'}</strong> · Version {test.version.toString()}</p><section><h2>Controlled context</h2><dl><dt>Method</dt><dd>{test.context.methodReference}</dd><dt>Template version</dt><dd>{test.context.versionNo}</dd><dt>Source</dt><dd>{test.context.sourceReference}</dd></dl></section><p><a href={`/laboratory/tests/${test.id}/execute`}>Execution workspace</a> · <a href={`/laboratory/tests/${test.id}/review`}>Review workspace</a> · <a href={`/laboratory/tests/${test.id}/retests/new`}>Retest</a></p></AppLayout><style>section{padding:1rem;background:var(--surface-panel);border:1px solid var(--color-border-subtle)}dl{display:grid;grid-template-columns:auto 1fr;gap:.5rem 1rem}dd{margin:0}a{color:var(--color-accent-primary-hover)}</style>
