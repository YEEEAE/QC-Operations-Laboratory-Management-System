---
import AppLayout from '../../../ui/layouts/AppLayout.astro';const actor=Astro.locals.actor;if(!actor)return Astro.redirect('/login?returnTo=%2Flaboratory%2Ftests%2Fnew');const allowed=actor.permissions.some(p=>p.code==='PERM-LAB-CREATE'&&p.active!==false);
---
<AppLayout title="Create laboratory test">{allowed?<form data-lab-create><h1>Create laboratory test</h1><label>Controlled template version ID<input name="templateVersionId" required /></label><label>Approved laboratory test number<input name="labTestNo" required /></label><button>Save controlled draft</button><p data-result role="status"></p></form>:<p>You are not authorized to create laboratory tests.</p>}</AppLayout>
<script>import {actions} from 'astro:actions';document.querySelector('form[data-lab-create]')?.addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const data=new FormData(form);const result=await actions.laboratory.create({templateVersionId:String(data.get('templateVersionId')),labTestNo:String(data.get('labTestNo'))});if(result.data)location.href='/laboratory/tests/'+result.data.id;else form.querySelector('[data-result]')!.textContent='The controlled source is unavailable or this action is not authorized.';});</script>
<style>form{display:grid;gap:1rem;max-width:40rem}label{display:grid;gap:.4rem}input,button{padding:.7rem;font:inherit}button{background:var(--color-accent-primary);color:#fff;border:0;border-radius:var(--radius-md)}</style>
