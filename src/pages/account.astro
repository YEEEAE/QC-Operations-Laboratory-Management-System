---
import PageHeader from "../ui/components/PageHeader.astro";
import { actions } from 'astro:actions';
import AppLayout from '../ui/layouts/AppLayout.astro';
import { GetAccountUseCase } from '../modules/identity/application/get-account.js';
import { identityDependencies } from '../modules/identity/application/identity-dependencies.js';
import { stateLabel } from '../shared/copy/ux-vocabulary.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const account = await new GetAccountUseCase(identityDependencies().users).execute(actor);
const actionResult = Astro.getActionResult(actions.account.changePassword);
if (actionResult?.data?.ok) return Astro.redirect(actionResult.data.redirectTo, 303);
const changeError = actionResult?.data && !actionResult.data.ok ? actionResult.data : undefined;
const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.ok) return Astro.redirect(logoutResult.data.redirectTo, 303);
const logoutError = logoutResult?.error;
const currentPasswordError = changeError?.fieldErrors?.currentPassword?.[0];
const newPasswordError = changeError?.fieldErrors?.newPassword?.[0];
---
<AppLayout title="Account · QC Operations" locale="en" direction="ltr">
  <PageHeader><Fragment slot="heading"><h1>Account</h1></Fragment>
      
      
      <p class="lede">Manage your password and session.</p>
    </PageHeader>
  {
    account && (
      <>
        <div class="account-overview">
        <section class="panel account-panel account-information" aria-labelledby="account-info">
          <h2 id="account-info">Account information</h2>
          <dl class="summary">
            <div class="account-fact">
              <dt>Login identity</dt>
              <dd>{account.loginIdentity}</dd>
            </div>
            <div class="account-fact">
              <dt>Display name</dt>
              <dd>{account.displayName}</dd>
            </div>
            <div class="account-fact">
              <dt>Email</dt>
              <dd>{account.email ?? 'Not provided'}</dd>
            </div>
            <div class="account-fact">
              <dt>State</dt>
              <dd>{stateLabel(account.accountState)}</dd>
            </div>
          </dl>
          <p class="muted">
            Role and scope grants are visible to administrators in the member register.
          </p>
          <p class="muted">
            If your login identity, display name, or email is wrong, ask an administrator to correct it in the member register. Profile changes are controlled and audited; this page does not delete account history.
          </p>
        </section>
        <section class="panel account-panel" aria-labelledby="security">
          <h2 id="security">Password and security</h2>
          <form class="form account-form" method="POST" action={actions.account.changePassword}>
            {changeError?.formError && <p role="alert" id="password-form-error" tabindex="-1">{changeError.formError === 'missing' ? 'This account is no longer available for password changes. Sign in again or contact an administrator.' : changeError.formError === 'denied' ? 'You no longer have permission to change this password. Contact an administrator.' : changeError.formError === 'stale' ? 'Account security details changed before this request completed. Reload the page before trying again.' : changeError.formError === 'provider' ? 'The password change is unconfirmed. Contact an administrator before submitting it again.' : 'We could not confirm whether the password change completed. Do not submit it again yet. Contact an administrator for help.'}</p>}
            <div class="field">
              <label for="currentPassword">Current password</label>
              <div class="password-field">
                <input
                  id="currentPassword"
                  name="currentPassword"
                  type="password"
                  autocomplete="current-password"
                  required
                  aria-invalid={currentPasswordError ? 'true' : undefined}
                  aria-describedby={currentPasswordError ? 'currentPassword-error' : 'password-change-hint'}
                />
                <button
                  type="button"
                  data-password-toggle
                  aria-pressed="false"
                  aria-controls="currentPassword"
                  aria-label="Show current password"
                >
                  Show
                </button>
              </div>
              {currentPasswordError && <p class="field-error" id="currentPassword-error" tabindex="-1">The current password is incorrect. Check it and try again.</p>}
            </div>
            <div class="field">
              <label for="newPassword">New password</label>
              <div class="password-field">
                <input
                  id="newPassword"
                  name="newPassword"
                  type="password"
                  autocomplete="new-password"
                  required
                  aria-invalid={newPasswordError ? 'true' : undefined}
                  aria-describedby={newPasswordError ? 'newPassword-error' : 'password-change-hint'}
                />
                <button
                  type="button"
                  data-password-toggle-new
                  aria-pressed="false"
                  aria-controls="newPassword"
                  aria-label="Show new password"
                >
                  Show
                </button>
              </div>
              {newPasswordError && <p class="field-error" id="newPassword-error" tabindex="-1">Enter a new password.</p>}
            </div>
            <p class="hint" id="password-change-hint">Changing your password ends all active sessions, including this one. You will need to sign in again.</p>
            <div class="actions">
              <button type="submit" data-submit>Change password</button>
            </div>
            <p role="status" aria-live="polite" data-result tabindex="-1" class="status"></p>
          </form>
        </section>
        <section class="panel account-panel" aria-labelledby="session">
          <h2 id="session">Session</h2>
          <p class="muted">
            Signing out ends this browser session. Sessions revoked by an administrator end
            immediately on their next request.
          </p>
          {logoutError && <p role="alert" id="logout-error" tabindex="-1">We could not confirm that you were signed out. Check your session before continuing.</p>}
          <form method="POST" action={actions.logout} data-logout-form aria-describedby={logoutError ? 'logout-error' : undefined}>
            <button type="submit" class="secondary" data-logout-submit>Sign out</button>
            <p role="status" aria-live="polite" data-logout-pending class="status"></p>
          </form>
        </section>
        </div>
      </>
    )
  }
</AppLayout>
<script>
  const wire = (selector: string, inputId: string) => {
    const toggle = document.querySelector<HTMLButtonElement>(selector);
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    toggle?.addEventListener('click', () => {
      if (!input || !toggle) return;
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      toggle.setAttribute('aria-pressed', String(show));
      toggle.setAttribute('aria-label', show ? 'Hide current password' : 'Show current password');
      toggle.textContent = show ? 'Hide' : 'Show';
    });
  };
  wire('[data-password-toggle]', 'currentPassword');
  const newPasswordToggle = document.querySelector<HTMLButtonElement>('[data-password-toggle-new]');
  const newPasswordInput = document.getElementById('newPassword') as HTMLInputElement | null;
  newPasswordToggle?.addEventListener('click', () => {
    if (!newPasswordInput || !newPasswordToggle) return;
    const show = newPasswordInput.type === 'password';
    newPasswordInput.type = show ? 'text' : 'password';
    newPasswordToggle.setAttribute('aria-pressed', String(show));
    newPasswordToggle.setAttribute('aria-label', show ? 'Hide new password' : 'Show new password');
    newPasswordToggle.textContent = show ? 'Hide' : 'Show';
  });
  document.querySelector<HTMLElement>('#password-form-error, .field-error')?.focus();
  document.querySelector<HTMLElement>('#logout-error')?.focus();
  const form = document.querySelector<HTMLFormElement>('form[action*="changePassword"]');
  form?.addEventListener('submit', (event: Event) => {
    if (form.getAttribute('aria-busy') === 'true') {
      event.preventDefault();
      return;
    }
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const output = form.querySelector<HTMLElement>('[data-result]');
    form.setAttribute('aria-busy', 'true');
    if (submit) submit.disabled = true;
    if (output) output.textContent = 'Changing password…';
  });
  const logoutForm = document.querySelector<HTMLFormElement>('[data-logout-form]');
  logoutForm?.addEventListener('submit', (event: Event) => {
    if (logoutForm.getAttribute('aria-busy') === 'true') {
      event.preventDefault();
      return;
    }
    logoutForm.setAttribute('aria-busy', 'true');
    const submit = logoutForm.querySelector<HTMLButtonElement>('[data-logout-submit]');
    const output = logoutForm.querySelector<HTMLElement>('[data-logout-pending]');
    if (submit) submit.disabled = true;
    if (output) output.textContent = 'Signing out…';
  });
</script>
<style>
  .account-overview{display:grid;gap:var(--space-5);inline-size:100%;max-inline-size:800px}
  .account-panel{min-inline-size:0;margin:0;padding:var(--space-6);background:var(--surface-panel);border:1px solid var(--color-border-default);border-radius:var(--radius-lg);box-shadow:var(--shadow-1)}
  .account-panel h2{margin:0 0 var(--space-4);font-size:1.0625rem}
  .lede,.muted,.hint{color:var(--text-muted);font-size:.85rem;line-height:1.55}
  .summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-3);margin:0 0 var(--space-4)}
  .account-fact{min-inline-size:0;padding:var(--space-3);border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm);background:var(--surface-inset)}
  .summary dt{margin:0 0 .25rem;color:var(--text-muted);font-size:.8rem}
  .summary dd{margin:0;font-size:.9rem;overflow-wrap:anywhere}
  .account-information .muted{margin:var(--space-3) 0 0}
  .account-form{display:grid;gap:var(--space-4);max-inline-size:38rem}
  .field{display:grid;gap:.4rem;min-inline-size:0}
  label{font-size:.875rem;font-weight:600}
  .password-field{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--space-2);align-items:center}
  input{min-block-size:44px;min-inline-size:0;width:100%;padding-inline:var(--space-3);background:var(--surface-inset);border:1px solid var(--control-border);border-radius:var(--radius-sm);color:var(--text-primary);font:inherit}
  button{min-block-size:44px;min-inline-size:44px;padding-inline:var(--space-4);border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:var(--text-on-accent);font:inherit;font-weight:700;cursor:pointer}
  .password-field button{padding-inline:var(--space-3);background:var(--surface-raised);border-color:var(--control-border);color:var(--text-primary);font-weight:600}
  button.secondary{background:var(--surface-raised);border-color:var(--control-border);color:var(--text-primary)}
  .actions{display:flex;gap:var(--space-3);flex-wrap:wrap}
  .status{min-block-size:1.4em;margin:0;color:var(--text-secondary);font-size:.85rem}
  .field-error,#password-form-error,#logout-error{margin:0;color:var(--text-danger);font-size:.875rem}
  input[aria-invalid="true"]{border-color:var(--border-invalid)}
  .account-panel :where(button,input):focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}
  @media(max-width:520px){.account-panel{padding:var(--space-4)}.summary{grid-template-columns:minmax(0,1fr)}}
  @media(forced-colors:active){.account-panel,.account-fact{border:1px solid CanvasText;box-shadow:none}.account-panel :where(button,input):focus-visible{outline-color:Highlight}}
</style>
