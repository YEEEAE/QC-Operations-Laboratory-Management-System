---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import FormErrorSummary from '../../ui/components/FormErrorSummary.astro';
import { actions } from 'astro:actions';
import {
  detailHref,
  extractDetailId,
  field,
  toFormFailure,
  type FormFailure,
} from '../../ui/forms/mutation-post.js';
import { safeListHref } from '../../ui/forms/entity-select.js';
import { DOCUMENT_TYPE_OPTIONS } from '../../modules/documents/application/document-vocabulary.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fdocuments%2Fnew');
const canCreate = actor.permissions.some((permission) => permission.code === 'PERM-DOC-CREATE' && permission.active !== false);

const LIST_HREF = '/documents';
// Safe list return context (F-09): Cancel/back preserve a benign list filter
// when the operator arrived with one; anything else falls back to the list.
const returnHref = safeListHref(Astro.url.searchParams.get('returnTo'), LIST_HREF);
const REQUIRED_FIELDS = [
  { name: 'documentNo', label: 'Document code' },
  { name: 'documentType', label: 'Document type' },
  { name: 'title', label: 'Title' },
] as const;

let values = { documentNo: '', documentType: '', title: '' };
let failure: FormFailure | null = null;

// POST baseline (F-05): without JavaScript the form performs a real POST to
// this page. The same Astro Action — with the same server-side
// reauthorization — runs via Astro.callAction. No business payload enters
// the URL: input travels in the POST body, success redirects (303) to the
// new record only.
if (Astro.request.method === 'POST' && canCreate) {
  const formData = await Astro.request.formData();
  values = {
    documentNo: field(formData, 'documentNo'),
    documentType: field(formData, 'documentType'),
    title: field(formData, 'title'),
  };
  try {
    const data = await Astro.callAction(actions.documents.create, {
      documentNo: values.documentNo,
      documentType: values.documentType,
      title: values.title,
    });
    const id = extractDetailId(data);
    if (id) return Astro.redirect(detailHref(LIST_HREF, id), 303);
    failure = {
      kind: 'unknown',
      summary: 'The document was received but no record reference came back.',
      recovery: 'Check the document library before trying again to avoid a duplicate.',
      fieldErrors: {},
      firstInvalidField: null,
    };
  } catch (error) {
    failure = toFormFailure(error, {
      entity: 'Controlled document',
      requiredFields: REQUIRED_FIELDS,
      values,
      listHref: LIST_HREF,
      listLabel: 'library',
    });
  }
}

const describedBy = (name: keyof typeof values): string | undefined =>
  failure?.fieldErrors[name] ? `${name}-error` : undefined;
const invalid = (name: keyof typeof values): 'true' | undefined =>
  failure?.fieldErrors[name] ? 'true' : undefined;
---
<AppLayout title="New Controlled Document · QC Operations" locale="en" direction="ltr">
  <section class="head"><div><p class="eyebrow">UI-DOC-NEW · CATALOG ENTRY</p><h1>New controlled document</h1><p>Creates a document identity in the catalog. It does not approve or make content effective.</p></div><a href={returnHref}>Back to library</a></section>
  {canCreate ? <form class="form" method="post" data-action="documents.create">{failure && <FormErrorSummary summary={failure.summary} recovery={failure.recovery} listHref={returnHref} listLabel="library" />}<fieldset><legend>Document identity</legend><div class="fields"><div><label for="documentNo">Document code<span class="hint" id="documentNo-help">Use the code from your approved source. The technical record identifier is generated server-side.</span><input id="documentNo" name="documentNo" required value={values.documentNo} aria-invalid={invalid('documentNo')} aria-describedby={failure?.fieldErrors.documentNo ? 'documentNo-error documentNo-help' : 'documentNo-help'} /></label>{failure?.fieldErrors.documentNo && <p class="field-error" id="documentNo-error">{failure.fieldErrors.documentNo}</p>}</div><div><label for="documentType">Document type<span class="hint" id="documentType-help">Controlled catalog vocabulary from the documents domain.</span><select id="documentType" name="documentType" required aria-invalid={invalid('documentType')} aria-describedby={failure?.fieldErrors.documentType ? 'documentType-error documentType-help' : 'documentType-help'}><option value="">Select document type…</option>{DOCUMENT_TYPE_OPTIONS.map((option)=><option value={option} selected={option===values.documentType}>{option}</option>)}</select></label>{failure?.fieldErrors.documentType && <p class="field-error" id="documentType-error">{failure.fieldErrors.documentType}</p>}</div><div><label for="title">Title<input id="title" name="title" required value={values.title} aria-invalid={invalid('title')} aria-describedby={describedBy('title')} /></label>{failure?.fieldErrors.title && <p class="field-error" id="title-error">{failure.fieldErrors.title}</p>}</div></div></fieldset><div class="actions"><a href={returnHref}>Cancel</a><button type="submit" data-submit>Create catalog entry</button></div><p role="status" data-result></p></form> : <section class="denied" role="alert"><h2>Creation unavailable</h2><p>Your account does not have the explicit document create permission.</p></section>}
</AppLayout>
<script>
import { actions } from 'astro:actions'; const form=document.querySelector<HTMLFormElement>('[data-action="documents.create"]'); form?.addEventListener('submit',async(event)=>{event.preventDefault();const data=new FormData(form);const submit=form.querySelector<HTMLButtonElement>('[data-submit]');const output=form.querySelector<HTMLElement>('[data-result]');if(submit)submit.disabled=true;form.setAttribute('aria-busy','true');if(output)output.textContent='Saving…';try{const result=await actions.documents.create({documentNo:String(data.get('documentNo')),documentType:String(data.get('documentType')),title:String(data.get('title'))});if(result.data&&typeof result.data.id==='string'){window.location.href=`/documents/${result.data.id}`;return;}if(output)output.textContent='Unable to create this document. Review the fields and try again.';const firstInvalid=form.querySelector<HTMLElement>('select:invalid,input:invalid');(firstInvalid??output)?.focus?.();}catch{if(output)output.textContent='The service is temporarily unavailable. Your entries are kept — try again.';}finally{if(submit)submit.disabled=false;form.removeAttribute('aria-busy');}});
</script>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.denied p{color:var(--text-muted);font-size:.85rem}.hint{color:var(--text-muted);font-size:.78rem}.head a,.actions a{color:var(--color-accent-primary-hover)}.form{max-width:900px;display:grid;gap:var(--space-5)}fieldset{padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}legend{padding-inline:.5rem;font-weight:700}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}.fields>div{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}.fields>div:last-child{grid-column:1/-1}label{display:grid;gap:.4rem}input,select{min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}input[aria-invalid="true"],select[aria-invalid="true"]{border-color:var(--status-danger)}.field-error{margin:0;color:var(--status-danger);font-size:.8rem}.actions{display:flex;justify-content:flex-end;gap:var(--space-3);align-items:center}.actions button{min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}button[disabled]{opacity:.6}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}@media(max-width:650px){.head{display:grid}.fields{grid-template-columns:1fr}.fields>div:last-child{grid-column:auto}.actions{justify-content:stretch;display:grid}}
</style>
