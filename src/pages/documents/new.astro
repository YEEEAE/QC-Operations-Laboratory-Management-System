---
import AppLayout from '../../ui/layouts/AppLayout.astro';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fdocuments%2Fnew');
const canCreate = actor.permissions.some((permission) => permission.code === 'PERM-DOC-CREATE' && permission.active !== false);
---
<AppLayout title="New Controlled Document · QC Operations" locale="en" direction="ltr">
  <section class="head"><div><p class="eyebrow">UI-DOC-NEW · CATALOG ENTRY</p><h1>New controlled document</h1><p>Creates a document identity in the catalog. It does not approve or make content effective.</p></div><a href="/documents">Back to library</a></section>
  {canCreate ? <form class="form" data-action="documents.create"><fieldset><legend>Document identity</legend><div class="fields"><label for="documentNo">Document code<input id="documentNo" name="documentNo" required /></label><label for="documentType">Document type<input id="documentType" name="documentType" placeholder="WI or SOP" required /></label><label for="title">Title<input id="title" name="title" required /></label></div></fieldset><div class="actions"><a href="/documents">Cancel</a><button type="submit">Create catalog entry</button></div></form> : <section class="denied" role="alert"><h2>Creation unavailable</h2><p>Your account does not have the explicit document create permission.</p></section>}
</AppLayout>
<script>
// @ts-expect-error Astro generates the action client module during the build.
import { actions } from 'astro:actions'; const form=document.querySelector<HTMLFormElement>('[data-action="documents.create"]'); form?.addEventListener('submit',async(event)=>{event.preventDefault();const data=new FormData(form);const result=await actions.documents.create({documentNo:String(data.get('documentNo')),documentType:String(data.get('documentType')),title:String(data.get('title'))});if(result.data)window.location.href=`/documents/${result.data.id}`;else form.setAttribute('aria-invalid','true');});
</script>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.denied p{color:var(--text-muted);font-size:.85rem}.head a,.actions a{color:var(--color-accent-primary-hover)}.form{max-width:900px;display:grid;gap:var(--space-5)}fieldset{padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}legend{padding-inline:.5rem;font-weight:700}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}.fields label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}.fields label:last-child{grid-column:1/-1}input{min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.actions{display:flex;justify-content:flex-end;gap:var(--space-3);align-items:center}.actions button{min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}@media(max-width:650px){.head{display:grid}.fields{grid-template-columns:1fr}.fields label:last-child{grid-column:auto}.actions{justify-content:stretch;display:grid}}
</style>
