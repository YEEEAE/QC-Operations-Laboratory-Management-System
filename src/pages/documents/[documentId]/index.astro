---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../../ui/components/StatusBadge.astro';
import { documentsReadDependencies } from '../../../modules/documents/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const document = await documentsReadDependencies().get.execute({ actor, documentId: Astro.params.documentId ?? '' }).catch(() => undefined);
if (!document) return Astro.redirect('/404');
const effective = document.versions.find((version) => version.state === 'EFFECTIVE');
const canCreateVersion = actor.permissions.some((permission) => ['PERM-DOC-CREATE','PERM-DOC-REVISE'].includes(permission.code) && permission.active !== false);
---
<AppLayout title={`${document.documentNo} · Controlled Documents`} locale="en" direction="ltr">
  <nav class="crumb"><a href="/documents">Controlled Documents</a><span>/</span><span>{document.documentNo}</span></nav>
  <section class="head"><div><p class="eyebrow">UI-DOC-002 · CONTROLLED DOCUMENT WORKSPACE</p><h1>{document.title}</h1><p>{document.documentNo} · {document.documentType} · Identity version {document.version.toString()}</p></div>{effective ? <StatusBadge status="APPROVED" label={`EFFECTIVE · Rev ${effective.revision}`} /> : <StatusBadge status="DRAFT" label="NO EFFECTIVE VERSION" />}</section>
  <section class="overview"><div><span>Current effective version</span><strong>{effective?.revision ?? 'None'}</strong></div><div><span>Owner</span><strong>{document.ownerId ?? document.createdBy}</strong></div><div><span>Active identity</span><strong>{document.active ? 'Yes' : 'No'}</strong></div></section>
  <section class="panel"><div class="panel-head"><div><p class="eyebrow">VERSION HISTORY</p><h2>Controlled versions</h2></div>{canCreateVersion && <a class="button" href={`/documents/${document.id}/versions/new`}>Create revision</a>}</div>{document.versions.length ? <div class="table-wrap"><table><caption>Historical versions are retained; approved versions are read-only.</caption><thead><tr><th scope="col">Revision</th><th scope="col">State</th><th scope="col">Created</th><th scope="col">Approved</th><th scope="col">Effective</th><th scope="col">Author</th></tr></thead><tbody>{document.versions.map((version) => <tr><th scope="row"><a href={`/documents/${document.id}/versions/${version.id}`}>{version.revision}</a></th><td><StatusBadge status={version.state === 'IN_REVIEW' ? 'REVIEW' : version.state === 'EFFECTIVE' ? 'APPROVED' : version.state === 'SUPERSEDED' ? 'SUPERSEDED' : version.state === 'VOID' ? 'VOID' : 'DRAFT'} label={version.state} /></td><td>{version.createdAt.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})}</td><td>{version.approvedAt?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'}) ?? '—'}</td><td>{version.effectiveAt?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'}) ?? '—'}</td><td>{version.createdBy}</td></tr>)}</tbody></table></div> : <p class="muted">No controlled version exists yet. The identity is catalog-only.</p>}</section>
  <section class="panel"><h2>Control boundary</h2><p class="muted">The current effective version is read from the authorized document read model. Creating a revision never edits an approved or superseded version in place.</p></section>
</AppLayout>
<style>.crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,a{color:var(--color-accent-primary-hover)}.head,.panel-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.head{margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.muted{color:var(--text-muted);font-size:.85rem}.overview{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3);margin-bottom:var(--space-5)}.overview>div{display:grid;gap:.4rem;padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md)}.overview span{color:var(--text-muted);font-size:.75rem}.overview strong{font-size:1rem}.panel{padding:var(--space-5);margin-top:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0;font-size:1rem}.button{display:inline-flex;align-items:center;min-height:var(--control-height);padding:.6rem 1rem;background:var(--color-accent-primary);color:#fff;text-decoration:none;border-radius:var(--radius-sm);font-weight:700}.table-wrap{overflow-x:auto}table{width:100%;min-width:820px;border-collapse:collapse;margin-top:var(--space-4)}caption{text-align:start;color:var(--text-muted);font-size:.75rem;padding-block-end:.5rem}th,td{padding:.75rem .4rem;text-align:start;border-top:1px solid var(--color-border-subtle);font-size:.8rem}th{font-weight:700}@media(max-width:650px){.head,.panel-head{display:grid}.overview{grid-template-columns:1fr}.button{width:max-content}}
</style>
