---
import AppLayout from '../../../../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../../../../ui/components/StatusBadge.astro';
import { documentsReadDependencies } from '../../../../../modules/documents/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const document = await documentsReadDependencies().get.execute({ actor, documentId: Astro.params.documentId ?? '' }).catch(() => undefined);
const version = document?.versions.find((item) => item.id === Astro.params.versionId);
if (!document || !version) return Astro.redirect('/404');
const canReview = actor.permissions.some((permission) => permission.code === 'PERM-DOC-REVIEW' && permission.active !== false) && actor.permissions.some((permission) => permission.code === 'PERM-APR-REVIEW' && permission.active !== false);
const canApprove = actor.permissions.some((permission) => permission.code === 'PERM-DOC-APPROVE' && permission.active !== false) && actor.permissions.some((permission) => permission.code === 'PERM-APR-APPROVE' && permission.active !== false);
---
<AppLayout title={`Review · ${document.documentNo} Rev ${version.revision}`} locale="en" direction="ltr"><nav class="crumb"><a href="/documents">Controlled Documents</a><span>/</span><a href={`/documents/${document.id}`}>{document.documentNo}</a><span>/</span><span>Review</span></nav><section class="head"><div><p class="eyebrow">UI-DOC-004 · CONTROLLED REVIEW WORKSPACE</p><h1>Review revision {version.revision}</h1><p>{document.title} · {document.documentNo} · Record version {version.version.toString()}</p></div><StatusBadge status="REVIEW" label={version.state} /></section><section class="compare"><div><span>Proposed revision</span><strong>{version.revision}</strong><small>{version.contentHash ?? 'Content hash missing'}</small></div><div><span>Previous controlled context</span><strong>{document.versions.find((item) => item.state === 'EFFECTIVE')?.revision ?? 'No effective version'}</strong><small>Existing history remains unchanged.</small></div></section><section class="panel"><h2>Review checklist</h2><ul><li>Confirm the exact version and content hash under review.</li><li>Review the change summary and linked Files capability records.</li><li>Approval is a separate controlled action and is never granted by opening this page.</li></ul><p class="muted">Scientific, effective-date, and approval authority policies remain server-controlled.</p></section><section class="actions">{canReview && version.state === 'IN_REVIEW' && <button class="button controlled" data-review-version={version.id} data-expected-version={version.version.toString()}>Record review</button>}{canApprove && version.state === 'IN_REVIEW' && <button class="button" data-approve-version={version.id} data-expected-version={version.version.toString()}>Approve revision</button>}<a href={`/documents/${document.id}/versions/${version.id}`}>Back to version</a></section></AppLayout>
<script>
// @ts-expect-error Astro generates the action client module during the build.
import { actions } from 'astro:actions'; const review=document.querySelector<HTMLButtonElement>('[data-review-version]'); review?.addEventListener('click',async()=>{review.disabled=true;const result=await actions.documents.review({versionId:review.dataset.reviewVersion!,expectedVersion:BigInt(review.dataset.expectedVersion!)});if(result.data)window.location.reload();else review.disabled=false;}); const approve=document.querySelector<HTMLButtonElement>('[data-approve-version]'); approve?.addEventListener('click',async()=>{approve.disabled=true;const result=await actions.documents.approve({versionId:approve.dataset.approveVersion!,expectedVersion:BigInt(approve.dataset.expectedVersion!)});if(result.data)window.location.reload();else approve.disabled=false;});
</script>
<style>.crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,a{color:var(--color-accent-primary-hover)}.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.muted{color:var(--text-muted);font-size:.85rem}.compare{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4)}.compare>div{display:grid;gap:.4rem;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.compare span,.compare small{color:var(--text-muted);font-size:.78rem}.compare strong{font-size:1.5rem}.panel{padding:var(--space-5);margin-top:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0}.panel li,.panel p{color:var(--text-muted);font-size:.85rem;line-height:1.6}.actions{display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-5)}.button{min-height:var(--control-height);padding:.6rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.button.controlled{background:var(--status-review-bg);border-color:var(--status-review)}@media(max-width:650px){.head,.actions{display:grid}.compare{grid-template-columns:1fr}}
</style>
