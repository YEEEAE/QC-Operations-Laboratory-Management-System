---
import PageHeader from "../../../../../ui/components/PageHeader.astro";
import AppLayout from '../../../../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../../../../ui/components/StatusBadge.astro';
import { documentsReadDependencies } from '../../../../../modules/documents/application/dependencies.js';
import { stateLabel } from '../../../../../shared/copy/ux-vocabulary.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
import { classifyReadFailure, providerUnavailableResponse } from '../../../../../shared/errors/read-failure.js';
let document: Awaited<ReturnType<ReturnType<typeof documentsReadDependencies>['get']['execute']>> | undefined;
try {
  document = await documentsReadDependencies().get.execute({ actor, documentId: Astro.params.documentId ?? '' });
} catch (error) {
  if (classifyReadFailure(error) === 'UNAVAILABLE') {
    return providerUnavailableResponse('Document details are temporarily unavailable', Astro.url.pathname + Astro.url.search);
  }
}
const version = document?.versions.find((item) => item.id === Astro.params.versionId);
if (!document || !version) return Astro.redirect('/404');
const canReview = actor.permissions.some((permission) => permission.code === 'PERM-DOC-REVIEW' && permission.active !== false) && actor.permissions.some((permission) => permission.code === 'PERM-APR-REVIEW' && permission.active !== false);
---
<AppLayout title={`Review · ${document.documentNo} Rev ${version.revision}`} locale="en" direction="ltr"><nav class="crumb"><a href="/documents">Controlled documents</a><span>/</span><a href={`/documents/${document.id}`}>{document.documentNo}</a><span>/</span><span>Review</span></nav><PageHeader><Fragment slot="heading"><h1>Review revision {version.revision}</h1></Fragment><p>{document.title} · {document.documentNo} · Record version {version.version.toString()}</p><Fragment slot="actions"><StatusBadge status="REVIEW" label={stateLabel(version.state)} /></Fragment></PageHeader><section class="compare"><div><span>Proposed revision</span><strong>{version.revision}</strong><small>Server source fingerprint: {version.contentHash ?? 'Not available'}</small><ul>{version.files.map((file)=><li>{file.originalFilename} · SHA-256 {file.sha256}</li>)}</ul></div><div><span>Previous controlled context</span><strong>{document.versions.find((item) => item.state === 'EFFECTIVE')?.revision ?? 'No effective version'}</strong><small>Existing history remains unchanged.</small></div></section><section class="panel"><h2>Review checklist</h2><ul><li>Confirm the exact revision, bound source files, and server-derived fingerprint.</li><li>Review the change summary and each linked file.</li><li>Approval requires an approved document-control authority and a version-bound electronic signature; an approver name alone is not a signature.</li></ul><p class="muted">Approval is unavailable until the required authority and signature sources are approved. Effectivity also remains deny-by-default until its effective-date policy is approved.</p></section><section class="actions">{canReview && version.state === 'IN_REVIEW' && <button class="button controlled" data-review-version={version.id} data-expected-version={version.version.toString()}>Record review</button>}<a href={`/documents/${document.id}/versions/${version.id}`}>Back to version</a></section></AppLayout>
<script>
  import { actions } from 'astro:actions';
  const section = document.querySelector<HTMLElement>('.actions');
  const status = document.createElement('p');
  status.setAttribute('data-result',''); status.setAttribute('role','status'); status.setAttribute('tabindex','-1');
  section?.appendChild(status);
  const guard = (b: HTMLButtonElement): boolean => b.disabled || !!b.closest('[aria-busy="true"]');
  const run = async (b: HTMLButtonElement, call: () => Promise<{ error?: unknown; data?: unknown }>, label: string) => {
    if (guard(b)) return;
    b.disabled = true; section?.setAttribute('aria-busy','true');
    status.textContent = label;
    try {
      const result = await call();
      if (result.data) { window.location.reload(); return; }
      status.textContent = 'The action was not accepted. Refresh the version and check its current state and your permissions before trying again.';
      status.focus?.();
    } catch { status.textContent = 'The service did not confirm the result. Refresh this version and its history before deciding whether to try again.'; status.focus?.(); }
    finally { b.disabled = false; section?.removeAttribute('aria-busy'); }
  };
  const review=document.querySelector<HTMLButtonElement>('[data-review-version]');
  review?.addEventListener('click',()=>void run(review,()=>actions.documents.review({versionId:review.dataset.reviewVersion!,expectedVersion:BigInt(review.dataset.expectedVersion!)}),'Recording review…'));
  const approve=document.querySelector<HTMLButtonElement>('[data-approve-version]');
  approve?.addEventListener('click',()=>void run(approve,()=>actions.documents.approve({versionId:approve.dataset.approveVersion!,expectedVersion:BigInt(approve.dataset.expectedVersion!)}),'Recording approval…'));
</script>
<style>.crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,a{color:var(--color-accent-primary-hover)}.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.muted{color:var(--text-muted);font-size:.85rem}.compare{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4)}.compare>div{display:grid;gap:.4rem;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.compare span,.compare small{color:var(--text-muted);font-size:.78rem}.compare strong{font-size:1.5rem}.panel{padding:var(--space-5);margin-top:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0}.panel li,.panel p{color:var(--text-muted);font-size:.85rem;line-height:1.6}.actions{display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-5)}.button{min-height:var(--control-height);padding:.6rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.button.controlled{background:var(--status-review-bg);border-color:var(--status-review)}@media(max-width:650px){.head,.actions{display:grid}.compare{grid-template-columns:1fr}}
</style>
