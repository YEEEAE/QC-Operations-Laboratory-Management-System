---
import AppLayout from '../../../../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../../../../ui/components/StatusBadge.astro';
import JourneyContextPanel from '../../../../../ui/components/workflow/JourneyContextPanel.astro';
import { documentsReadDependencies } from '../../../../../modules/documents/application/dependencies.js';
import { approvalsReadDependencies } from '../../../../../modules/approvals/application/dependencies.js';
import { stateLabel } from '../../../../../shared/copy/ux-vocabulary.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
import { classifyReadFailure, providerUnavailableResponse } from '../../../../../shared/errors/read-failure.js';
let document: Awaited<ReturnType<ReturnType<typeof documentsReadDependencies>['get']['execute']>> | undefined;
try {
  document = await documentsReadDependencies().get.execute({ actor, documentId: Astro.params.documentId ?? '' });
} catch (error) {
  if (classifyReadFailure(error) === 'UNAVAILABLE') {
    return providerUnavailableResponse('Document details are temporarily unavailable', Astro.url.pathname + Astro.url.search);
  }
}
const version = document?.versions.find((item) => item.id === Astro.params.versionId);
if (!document || !version) return Astro.redirect('/404');
let approvalEvidence;
try {
  approvalEvidence = await approvalsReadDependencies().documentEvidence.execute(version.id);
} catch {
  return providerUnavailableResponse('Approval evidence is temporarily unavailable', Astro.url.pathname + Astro.url.search);
}
const editable = version.state === 'DRAFT' && actor.permissions.some((permission) => permission.code === 'PERM-DOC-EDIT-DRAFT' && permission.active !== false);
const canSubmit = version.state === 'DRAFT' && actor.permissions.some((permission) => permission.code === 'PERM-DOC-SUBMIT' && permission.active !== false);
const canReview = version.state === 'IN_REVIEW' && actor.permissions.some((permission) => permission.code === 'PERM-DOC-REVIEW' && permission.active !== false);
const nextAction = version.state === 'DRAFT' ? editable ? 'Edit draft' : canSubmit ? 'Submit for review' : undefined : version.state === 'IN_REVIEW' ? canReview ? 'Open review workspace' : 'Awaiting reviewer' : version.state === 'APPROVED' ? 'Awaiting an approved activation policy' : version.state === 'EFFECTIVE' ? 'Create a new revision through Change Request when needed' : undefined;
const nextOwner = version.state === 'DRAFT' ? 'Document author' : version.state === 'IN_REVIEW' ? 'Document reviewer' : version.state === 'APPROVED' ? 'Document owner / effective-date owner' : version.state === 'EFFECTIVE' ? 'Authorized change requester' : undefined;
---
<AppLayout title={`${document.documentNo} · Rev ${version.revision}`} locale="en" direction="ltr"><nav class="crumb"><a href="/documents">Controlled documents</a><span>/</span><a href={`/documents/${document.id}`}>{document.documentNo}</a><span>/</span><span>Rev {version.revision}</span></nav><section class="head"><div><p class="eyebrow">Version</p><h1>{document.title}</h1><p>{document.documentNo} · Revision {version.revision} · Record version {version.version.toString()}</p></div><StatusBadge status={version.state === 'IN_REVIEW' ? 'REVIEW' : version.state === 'EFFECTIVE' ? 'APPROVED' : version.state === 'SUPERSEDED' ? 'SUPERSEDED' : version.state === 'VOID' ? 'VOID' : 'DRAFT'} label={stateLabel(version.state)} /></section><section class="facts"><div><span>Lifecycle state</span><strong>{stateLabel(version.state)}</strong></div><div><span>Server source fingerprint</span><strong>{version.sourceBindingVerified ? version.contentHash ?? 'Not available' : 'Unverified historical value'}</strong></div><div><span>Created by</span><strong>{version.createdBy}</strong></div><div><span>Approved at</span><strong>{version.approvedAt?.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'}) ?? 'Not approved'}</strong></div></section><JourneyContextPanel ownerDomain="Controlled documents" recordReference={`${document.documentNo} · Rev ${version.revision} · version ${version.version.toString()}`} currentState={stateLabel(version.state)} nextAction={nextAction} nextActionHref={version.state === 'DRAFT' && editable ? `/documents/${document.id}/versions/${version.id}/edit` : version.state === 'IN_REVIEW' && canReview ? `/documents/${document.id}/versions/${version.id}/review` : undefined} nextOwner={nextOwner} whyUnavailable={version.state === 'APPROVED' ? 'The policy for making a version effective is not yet approved.' : version.state === 'EFFECTIVE' ? 'Approved content cannot be edited. Use a new revision or change request.' : version.state === 'IN_REVIEW' && !canReview ? 'Review requires PERM-DOC-REVIEW.' : undefined} waitingOn={version.state === 'IN_REVIEW' ? 'Reviewer' : version.state === 'APPROVED' ? 'Effective-date policy or document owner' : undefined} expectedEvent={version.state === 'DRAFT' ? 'Submit for review' : version.state === 'IN_REVIEW' ? 'Review decision' : version.state === 'APPROVED' ? 'Make version effective' : version.state === 'EFFECTIVE' ? 'Controlled change request' : undefined} controlledContext={`${document.documentNo} · revision ${version.revision} · record version ${version.version.toString()}`} evidenceSummary={`Server source fingerprint ${version.sourceBindingVerified ? version.contentHash ?? 'not available' : 'unverified historical value'} · ${version.files.length} linked file(s)`} auditHref={`/audit?subjectType=DOCUMENT_VERSION&subjectId=${encodeURIComponent(version.id)}`} relatedLinks={[{ label: 'Document history', href: `/documents/${document.id}`, detail: 'Identity and version chain' }, { label: 'Document register', href: '/documents', detail: 'Controlled documents' }]} />{(editable || canSubmit || canReview) && <section class="actions">{editable && <a class="button secondary" href={`/documents/${document.id}/versions/${version.id}/edit`}>Edit draft</a>}{canSubmit && <button class="button" data-submit-version={version.id} data-expected-version={version.version.toString()}>Submit for review</button>}{canReview && <a class="button controlled" href={`/documents/${document.id}/versions/${version.id}/review`}>Open review workspace</a>}</section>}<section class="panel"><h2>Attachments</h2>{version.files.length ? <table><caption>Files linked to this version</caption><thead><tr><th scope="col">Source file</th><th scope="col">Role</th><th scope="col">SHA-256</th><th scope="col">Linked at</th></tr></thead><tbody>{version.files.map((file)=><tr><th scope="row">{file.originalFilename}</th><td>{file.fileRole}</td><td><code>{file.sha256}</code></td><td>{file.linkedAt.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})}</td></tr>)}</tbody></table> : <p class="muted">No registered source file is linked to this version.</p>}</section><section class="panel"><h2>Change summary</h2><p class="muted">{version.changeSummary ?? 'No change summary supplied.'}</p><p class="muted">Approved, effective, superseded, and void versions are read-only historical records.</p></section><section class="panel" aria-label="Approval evidence"><h2>Recorded authorization</h2>{approvalEvidence.length ? <><p class="muted">These entries come from saved workflow decisions or document transition audit events for this revision. A role requirement names the assigned approval step, not the person's historical role.</p><div class="table-wrap"><table><caption>Decision and electronic signature evidence</caption><thead><tr><th scope="col">Decision</th><th scope="col">Actor</th><th scope="col">Assigned role requirement</th><th scope="col">Recorded at</th><th scope="col">Version at decision</th><th scope="col">Evidence</th></tr></thead><tbody>{approvalEvidence.map((evidence) => <tr><td>{evidence.decision}</td><td>{evidence.actorName}<br /><small>{evidence.actorId}</small></td><td>{evidence.assignedRoleRequirement ?? 'Named account assignment'}</td><td>{evidence.decidedAt.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})}</td><td>{evidence.source === 'WORKFLOW_DECISION' ? evidence.subjectVersion.toString() : 'See document transition audit'}</td><td>{evidence.signatureId ? <>Electronically signed<br /><small>{evidence.signatureMeaning}</small><br /><code>{evidence.signatureId}</code></> : <>{evidence.source === 'WORKFLOW_DECISION' ? 'Decision recorded' : 'Document transition recorded'}<br /><code>{evidence.decisionId}</code></>}</td></tr>)}</tbody></table></div></> : <p class="muted">No approval or authorization event is recorded for this revision.</p>}</section></AppLayout>
<script>
  import { actions } from 'astro:actions';
  const section=document.querySelector<HTMLElement>('.actions');
  const status=document.createElement('p');
  status.setAttribute('data-result','');status.setAttribute('role','status');status.setAttribute('tabindex','-1');
  section?.appendChild(status);
  document.querySelector<HTMLButtonElement>('[data-submit-version]')?.addEventListener('click',async(event)=>{const button=event.currentTarget as HTMLButtonElement;if(button.disabled||button.closest('[aria-busy="true"]'))return;button.disabled=true;section?.setAttribute('aria-busy','true');status.textContent='Submitting for review…';try{const result=await actions.documents.submit({versionId:button.dataset.submitVersion!,expectedVersion:BigInt(button.dataset.expectedVersion!)});if(result.data)window.location.reload();else{status.textContent='Submission was not accepted. Refresh the version and check its current state and your permissions before trying again.';status.focus?.();button.disabled=false;}}catch{status.textContent='The service did not confirm the result. Refresh this version and its history before deciding whether to try again.';status.focus?.();button.disabled=false;}finally{section?.removeAttribute('aria-busy');}});
</script>
<style>.crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,a{color:var(--color-accent-primary-hover)}.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.muted{color:var(--text-muted);font-size:.85rem}.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-3);margin-bottom:var(--space-5)}.facts>div{display:grid;gap:.35rem;padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md)}.facts span{color:var(--text-muted);font-size:.75rem}.facts strong{font-size:.82rem;word-break:break-word}.actions{display:flex;gap:var(--space-3);align-items:center;margin-bottom:var(--space-5)}.button{min-height:var(--control-height);padding:.6rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;text-decoration:none;font:inherit;font-weight:700}.button.secondary{background:var(--surface-raised);border-color:var(--border-default);color:var(--text-primary)}.button.controlled{background:var(--status-review-bg);border-color:var(--status-review)}.panel{padding:var(--space-5);margin-top:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0;font-size:1rem}.panel p{line-height:1.55}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;margin-top:var(--space-4)}caption{text-align:start;color:var(--text-muted);font-size:.75rem;padding-bottom:.5rem}th,td{padding:.75rem .4rem;text-align:start;border-top:1px solid var(--color-border-subtle);font-size:.8rem}th{font-weight:700}@media(max-width:650px){.head{display:grid}.facts{grid-template-columns:repeat(2,1fr)}.actions{display:grid;justify-content:stretch}.button{width:max-content}}@media(max-width:420px){.facts{grid-template-columns:1fr}}
</style>
