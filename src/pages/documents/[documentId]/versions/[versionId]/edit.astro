---
import PageHeader from "../../../../../ui/components/PageHeader.astro";
import AppLayout from '../../../../../ui/layouts/AppLayout.astro';
import { documentsReadDependencies } from '../../../../../modules/documents/application/dependencies.js';
import { actions } from 'astro:actions';
import FormErrorSummary from '../../../../../ui/components/FormErrorSummary.astro';
import { stateLabel } from '../../../../../shared/copy/ux-vocabulary.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
import { classifyReadFailure, providerUnavailableResponse } from '../../../../../shared/errors/read-failure.js';
let document: Awaited<ReturnType<ReturnType<typeof documentsReadDependencies>['get']['execute']>> | undefined;
try {
  document = await documentsReadDependencies().get.execute({ actor, documentId: Astro.params.documentId ?? '' });
} catch (error) {
  if (classifyReadFailure(error) === 'UNAVAILABLE') return providerUnavailableResponse('Document details are temporarily unavailable', Astro.url.pathname + Astro.url.search);
}
const version = document?.versions.find((item) => item.id === Astro.params.versionId);
if (!document || !version) return Astro.redirect('/404');
const canEdit = version.state === 'DRAFT' && actor.permissions.some((permission) => permission.code === 'PERM-DOC-EDIT-DRAFT' && permission.active !== false);
const submitted = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
const values = { revision: String(submitted?.get('revision') ?? version.revision), changeSummary: String(submitted?.get('changeSummary') ?? version.changeSummary ?? '') };
const submittedExpectedVersion = String(submitted?.get('expectedVersion') ?? version.version.toString());
const submittedContentHash = String(submitted?.get('expectedContentHash') ?? version.contentHash ?? '');
let failure: { summary: string; recovery: string; kind: 'validation'|'denied'|'unavailable'|'stale'|'unknown' } | undefined;
if (submitted) {
  try {
    if (!/^[1-9]\d*$/.test(submittedExpectedVersion) || !/^[0-9a-f]{64}$/i.test(submittedContentHash)) {
      failure = { kind: 'validation', summary: 'The draft was not saved because its opened version information is invalid.', recovery: 'Reload the version, then enter your changes again.' };
    } else {
      const result = await Astro.callAction(actions.documents.updateDraft, { versionId: version.id, expectedVersion: BigInt(submittedExpectedVersion), expectedContentHash: submittedContentHash, revision: values.revision, changeSummary: values.changeSummary || undefined });
      if (result.data) return Astro.redirect(`/documents/${document.id}/versions/${version.id}`, 303);
      const code = `${String(result.error?.code ?? '')} ${String(result.error?.message ?? '')}`.toUpperCase();
      const kind = /AUTH|PERMISSION|FORBIDDEN/.test(code) ? 'denied'
        : /STALE|CONFLICT/.test(code) ? 'stale'
          : /VALIDATION|INVALID|REQUIRED/.test(code) ? 'validation'
            : /UNAVAILABLE|INTERNAL|PROVIDER/.test(code) ? 'unavailable' : 'unknown';
      failure = kind === 'denied' ? { kind, summary: 'The draft was not changed because permission is no longer available.', recovery: 'Return to the version and ask a document controller to review your access.' }
        : kind === 'stale' ? { kind, summary: 'This draft changed after you opened it.', recovery: 'Reload the version to review the current draft before editing again.' }
          : kind === 'validation' ? { kind, summary: 'The draft was not saved because a required value is invalid.', recovery: 'Correct the highlighted revision reference and try again.' }
            : kind === 'unavailable' ? { kind, summary: 'The document service is temporarily unavailable.', recovery: 'Your entries remain here. Retry when the service is available.' }
              : { kind, summary: 'The save result could not be confirmed.', recovery: 'Check the version history before trying again.' };
    }
  } catch {
    failure = { kind: 'unknown', summary: 'The save result could not be confirmed.', recovery: 'Check the version history before trying again.' };
  }
}
---
<AppLayout title={`Edit draft · ${document.documentNo}`} locale="en" direction="ltr">
  <div class="edit-draft">
    <PageHeader purpose={`Updates the revision reference or change summary of draft revision ${version.revision} for ${document.documentNo}. Source files and the server source fingerprint are read-only.`}>
      <Fragment slot="heading"><h1>Edit draft revision {version.revision}</h1></Fragment>
      <p class="record-meta">
        <span class="record-title">{document.title}</span>
        <span><span class="meta-label">Document number</span> <span class="identifier">{document.documentNo}</span></span>
        <span><span class="meta-label">Document type</span> {document.documentType}</span>
        <span><span class="meta-label">Lifecycle state</span> {stateLabel(version.state)}</span>
        <span>
          <span class="meta-label">Record version</span>
          <strong class="numeric">{version.version.toString()}</strong>
        </span>
      </p>
      <Fragment slot="actions"><a href={`/documents/${document.id}/versions/${version.id}`}>Back to version</a></Fragment>
    </PageHeader>

    {canEdit || (submitted && failure) ? <form class="form" method="post" data-action="documents.updateDraft" data-document-id={document.id} data-version-id={version.id} data-expected-version={submittedExpectedVersion}>
      <input type="hidden" name="expectedVersion" value={submittedExpectedVersion} />
      <input type="hidden" name="expectedContentHash" value={submittedContentHash} />

      {failure && <FormErrorSummary summary={failure.summary} recovery={failure.recovery} errors={failure.kind === 'validation' ? [{fieldId:'revision',message:'Enter the revision reference assigned by Document Control.'}] : []} listHref={`/documents/${document.id}/versions/${version.id}`} listLabel="version" />}

      <fieldset>
        <legend>Draft details</legend>
        <p class="section-note">Only the revision reference and change summary are editable. Saving does not approve the revision or make it effective; approval and effectivity are separate recorded transitions.</p>
        <div class="field-grid">
          <div class="field">
            <label for="revision">Revision reference</label>
            <p class="hint" id="revision-help">Changing the revision recalculates its source fingerprint on the server.</p>
            <input id="revision" name="revision" value={values.revision} required aria-describedby={failure?.kind === 'validation' ? 'revision-help revision-error' : 'revision-help'} aria-invalid={failure?.kind === 'validation' ? 'true' : undefined} />
            {failure?.kind === 'validation' && <p id="revision-error" class="field-error">A revision reference is required.</p>}
          </div>
          <div class="field">
            <label for="changeSummary">Change summary</label>
            <p class="hint" id="changeSummary-help">Optional. Describe what changed in this revision.</p>
            <textarea id="changeSummary" name="changeSummary" rows="4" aria-describedby="changeSummary-help">{values.changeSummary}</textarea>
          </div>
        </div>
      </fieldset>

      <section class="source-binding" aria-labelledby="source-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Recorded source</p>
            <h2 id="source-title">Bound source files</h2>
          </div>
        </div>
        {version.files.length
          ? <ul>{version.files.map((file) => <li><strong>{file.originalFilename}</strong><span>{file.sizeBytes.toLocaleString('en-US')} bytes · SHA-256 {file.sha256}</span></li>)}</ul>
          : <p class="hint">This draft has no registered source files. It cannot be submitted.</p>}
        <p class="fingerprint">Server source fingerprint: <span class="identifier">{version.contentHash ?? 'Not available'}</span></p>
      </section>

      <p class="note">Only draft metadata is editable. Source file links are fixed when this draft is created; the server rechecks the record version and source fingerprint when the draft is saved.</p>

      <div class="actions">
        <a class="secondary" href={`/documents/${document.id}/versions/${version.id}`}>Cancel</a>
        <button type="submit" data-submit disabled={!canEdit}>Save draft</button>
      </div>
      <p class="result-status" data-result role="status" aria-live="polite" tabindex="-1"></p>
    </form> : <section class="denied" role="alert">
      <h2>Draft editing unavailable</h2>
      <p>Only draft versions are editable. Editing requires PERM-DOC-EDIT-DRAFT.</p>
    </section>}
  </div>
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  import { enhanceClassifiedForm } from '../../../../../ui/forms/enhance-with-classification';
  import { guardUnsavedChanges } from '../../../../../ui/forms/unsaved-changes';
  const form=document.querySelector<HTMLFormElement>('[data-action="documents.updateDraft"]');
  if(form){
    enhanceClassifiedForm(form,{
      invoke:(payload)=>actions.documents.updateDraft(payload as Parameters<typeof actions.documents.updateDraft>[0]),
      payload:(data)=>({versionId:form.dataset.versionId!,expectedVersion:BigInt(form.dataset.expectedVersion!),expectedContentHash:String(data.get('expectedContentHash') ?? ''),revision:String(data.get('revision')),changeSummary:String(data.get('changeSummary')||'')||undefined}),
      progressText:'Saving draft…',
      detailBaseHref:`/documents/${form.dataset.documentId}/versions`,
    });
    guardUnsavedChanges(form);
  }
</script>
<style>
  .edit-draft { min-inline-size: 0; }

  .record-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
  }
  .record-meta > span { min-inline-size: 0; overflow-wrap: anywhere; }
  .record-title {
    flex-basis: 100%;
    color: var(--text-primary);
    font-size: var(--font-size-md);
    font-weight: 600;
  }
  .meta-label { color: var(--text-muted); font-weight: 600; }
  .numeric { font-variant-numeric: tabular-nums; }

  .form {
    inline-size: min(100%, 56rem);
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }
  fieldset {
    min-inline-size: 0;
    margin: 0;
    padding: clamp(var(--space-4), 3vw, var(--space-6));
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-panel);
  }
  legend {
    padding-inline: 0.5rem;
    color: var(--text-primary);
    font-size: var(--font-size-lg);
    font-weight: 700;
  }
  .section-note {
    margin: 0 0 var(--space-4);
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    overflow-wrap: anywhere;
  }
  .field-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  .field { min-inline-size: 0; }
  label {
    display: block;
    color: var(--text-primary);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }
  .hint {
    margin: 0 0 var(--space-2);
    color: var(--text-secondary);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-normal);
    overflow-wrap: anywhere;
  }
  .field .hint { margin-block-start: var(--space-1); }
  input:not([type='hidden']),
  textarea {
    box-sizing: border-box;
    inline-size: 100%;
    padding: 0.65rem 0.75rem;
  }
  textarea { min-block-size: 8.75rem; resize: vertical; }
  .field-error {
    margin: var(--space-2) 0 0;
    color: var(--status-danger);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
  }

  .source-binding {
    display: grid;
    gap: var(--space-3);
    min-inline-size: 0;
    padding: clamp(var(--space-4), 3vw, var(--space-5));
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-panel);
  }
  .section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    min-inline-size: 0;
  }
  .eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
  }
  .source-binding h2 {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-tight);
    overflow-wrap: anywhere;
  }
  .source-binding ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .source-binding li {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    overflow-wrap: anywhere;
  }
  .source-binding li strong { font-weight: 600; overflow-wrap: anywhere; }
  .source-binding li span {
    color: var(--text-secondary);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-normal);
    overflow-wrap: anywhere;
  }
  .fingerprint {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    overflow-wrap: anywhere;
  }
  .identifier { font-family: var(--font-mono); overflow-wrap: anywhere; }
  .note {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    overflow-wrap: anywhere;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
  }
  .actions .secondary,
  .actions button {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: max(var(--control-height), 44px);
    padding: 0.65rem 1rem;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    font: inherit;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }
  .actions .secondary {
    background: var(--surface-raised);
    color: var(--text-primary);
  }
  .actions button {
    border-color: var(--color-accent-primary);
    background: var(--color-accent-primary);
    color: var(--text-on-accent);
  }
  button[disabled] { opacity: 0.6; cursor: not-allowed; }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .result-status {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    overflow-wrap: anywhere;
  }
  .result-status:empty { min-block-size: 0; }
  .result-status:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .denied {
    max-inline-size: 56rem;
    padding: var(--space-6);
    border: 1px solid var(--color-border-subtle);
    border-inline-start: 3px solid var(--status-warning);
    border-radius: var(--radius-lg);
    background: var(--surface-panel);
  }
  .denied h2 {
    margin: 0 0 var(--space-2);
    color: var(--text-primary);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-tight);
  }
  .denied p {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    overflow-wrap: anywhere;
  }

  @media (min-width: 64rem) {
    .field-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 40rem) {
    .actions { display: grid; grid-template-columns: 1fr; }
    .actions > * { inline-size: 100%; }
  }
  @media (forced-colors: active) {
    fieldset,
    .source-binding,
    .denied,
    .source-binding li,
    input:not([type='hidden']),
    textarea,
    .actions .secondary,
    .actions button {
      border: 1px solid ButtonText;
    }
    .field-error { color: CanvasText; }
  }
</style>
