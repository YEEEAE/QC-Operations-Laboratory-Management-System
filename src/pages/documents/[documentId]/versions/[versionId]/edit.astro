---
import AppLayout from '../../../../../ui/layouts/AppLayout.astro';
import { documentsReadDependencies } from '../../../../../modules/documents/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const document = await documentsReadDependencies().get.execute({ actor, documentId: Astro.params.documentId ?? '' }).catch(() => undefined);
const version = document?.versions.find((item) => item.id === Astro.params.versionId);
if (!document || !version) return Astro.redirect('/404');
const canEdit = version.state === 'DRAFT' && actor.permissions.some((permission) => permission.code === 'PERM-DOC-EDIT-DRAFT' && permission.active !== false);
---
<AppLayout title={`Edit Draft · ${document.documentNo}`} locale="en" direction="ltr"><section class="head"><div><p class="eyebrow">UI-DOC-003 · DRAFT EDITOR</p><h1>Edit Draft revision {version.revision}</h1><p>{document.documentNo} · Record version {version.version.toString()}</p></div><a href={`/documents/${document.id}/versions/${version.id}`}>Back to version</a></section>{canEdit ? <form class="form" data-action="documents.updateDraft" data-document-id={document.id} data-version-id={version.id} data-expected-version={version.version.toString()}><label for="revision">Revision reference<input id="revision" name="revision" value={version.revision} required /></label><label for="changeSummary">Change summary<textarea id="changeSummary" name="changeSummary">{version.changeSummary ?? ''}</textarea></label><label for="contentHash">Controlled content hash<input id="contentHash" name="contentHash" value={version.contentHash ?? ''} /></label><p class="hint">Only Draft versions are editable. Approved and historical versions remain immutable.</p><button type="submit">Save Draft</button></form> : <section class="denied" role="alert"><h2>Draft editing unavailable</h2><p>This version is controlled or your account lacks the explicit edit permission.</p></section>}</AppLayout>
<script>
// @ts-expect-error Astro generates the action client module during the build.
import { actions } from 'astro:actions'; const form=document.querySelector<HTMLFormElement>('[data-action="documents.updateDraft"]'); form?.addEventListener('submit',async(event)=>{event.preventDefault();const data=new FormData(form);const result=await actions.documents.updateDraft({versionId:form.dataset.versionId!,expectedVersion:BigInt(form.dataset.expectedVersion!),revision:String(data.get('revision')),changeSummary:String(data.get('changeSummary')||'')||undefined,contentHash:String(data.get('contentHash')||'')||undefined});if(result.data)window.location.href=`/documents/${form.dataset.documentId}/versions/${form.dataset.versionId}`;else form.setAttribute('aria-invalid','true');});
</script>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.hint,.denied p{color:var(--text-muted);font-size:.85rem}.head a{color:var(--color-accent-primary-hover)}.form{max-width:820px;display:grid;gap:var(--space-4);padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}input,textarea{min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}textarea{min-height:140px;resize:vertical}.hint{line-height:1.5}.form button{width:max-content;min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}@media(max-width:650px){.head{display:grid}}
</style>
