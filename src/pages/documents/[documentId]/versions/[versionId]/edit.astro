---
import AppLayout from '../../../../../ui/layouts/AppLayout.astro';
import { documentsReadDependencies } from '../../../../../modules/documents/application/dependencies.js';
import { actions } from 'astro:actions';
import FormErrorSummary from '../../../../../ui/components/FormErrorSummary.astro';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
import { classifyReadFailure, providerUnavailableResponse } from '../../../../../shared/errors/read-failure.js';
let document: Awaited<ReturnType<ReturnType<typeof documentsReadDependencies>['get']['execute']>> | undefined;
try {
  document = await documentsReadDependencies().get.execute({ actor, documentId: Astro.params.documentId ?? '' });
} catch (error) {
  if (classifyReadFailure(error) === 'UNAVAILABLE') return providerUnavailableResponse('Document details are temporarily unavailable', Astro.url.pathname + Astro.url.search);
}
const version = document?.versions.find((item) => item.id === Astro.params.versionId);
if (!document || !version) return Astro.redirect('/404');
const canEdit = version.state === 'DRAFT' && actor.permissions.some((permission) => permission.code === 'PERM-DOC-EDIT-DRAFT' && permission.active !== false);
const submitted = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
const values = { revision: String(submitted?.get('revision') ?? version.revision), changeSummary: String(submitted?.get('changeSummary') ?? version.changeSummary ?? '') };
let failure: { summary: string; recovery: string; kind: 'validation'|'denied'|'unavailable'|'stale'|'unknown' } | undefined;
if (submitted && canEdit) {
  const result = await Astro.callAction(actions.documents.updateDraft, { versionId: version.id, expectedVersion: version.version, revision: values.revision, changeSummary: values.changeSummary || undefined });
  if (result.data) return Astro.redirect(`/documents/${document.id}/versions/${version.id}`, 303);
  const code = `${String(result.error?.code ?? '')} ${String(result.error?.message ?? '')}`.toUpperCase();
  const kind = /AUTH|PERMISSION|FORBIDDEN/.test(code) ? 'denied'
    : /STALE|CONFLICT/.test(code) ? 'stale'
      : /VALIDATION|INVALID|REQUIRED/.test(code) ? 'validation'
        : /UNAVAILABLE|INTERNAL|PROVIDER/.test(code) ? 'unavailable' : 'unknown';
  failure = kind === 'denied' ? { kind, summary: 'The draft was not changed because permission is no longer available.', recovery: 'Return to the version and ask a document controller to review your access.' }
    : kind === 'stale' ? { kind, summary: 'This draft changed after you opened it.', recovery: 'Reload the version to review the current draft before editing again.' }
      : kind === 'validation' ? { kind, summary: 'The draft was not saved because a required value is invalid.', recovery: 'Correct the highlighted revision reference and try again.' }
        : kind === 'unavailable' ? { kind, summary: 'The document service is temporarily unavailable.', recovery: 'Your entries remain here. Retry when the service is available.' }
          : { kind, summary: 'The save result could not be confirmed.', recovery: 'Check the version history before trying again.' };
}
---
<AppLayout title={`Edit draft · ${document.documentNo}`} locale="en" direction="ltr">
  <section class="head"><div><p class="eyebrow">Edit draft</p><h1>Edit draft revision {version.revision}</h1><p>{document.documentNo} · Record version {version.version.toString()}</p></div><a href={`/documents/${document.id}/versions/${version.id}`}>Back to version</a></section>
  {canEdit ? <form class="form" method="post" data-action="documents.updateDraft" data-document-id={document.id} data-version-id={version.id} data-expected-version={version.version.toString()}>
    {failure && <FormErrorSummary summary={failure.summary} recovery={failure.recovery} errors={failure.kind === 'validation' ? [{fieldId:'revision',message:'Enter the revision reference assigned by Document Control.'}] : []} listHref={`/documents/${document.id}/versions/${version.id}`} listLabel="version" />}
    <label for="revision">Revision reference<input id="revision" name="revision" value={values.revision} required aria-describedby={failure?.kind === 'validation' ? 'revision-help revision-error' : 'revision-help'} aria-invalid={failure?.kind === 'validation' ? 'true' : undefined} /></label>
    <p class="hint" id="revision-help">Changing the revision recalculates its source fingerprint on the server.</p>
    {failure?.kind === 'validation' && <p id="revision-error" class="field-error">A revision reference is required.</p>}
    <label for="changeSummary">Change summary<textarea id="changeSummary" name="changeSummary">{values.changeSummary}</textarea></label>
    <section class="source-binding" aria-labelledby="source-title"><h2 id="source-title">Bound source files</h2>
      {version.files.length ? <ul>{version.files.map((file)=><li><strong>{file.originalFilename}</strong><span>{file.sizeBytes.toLocaleString('en-US')} bytes · SHA-256 {file.sha256}</span></li>)}</ul> : <p class="hint">This draft has no registered source files. It cannot be submitted.</p>}
      <p class="hint">Server source fingerprint: {version.contentHash ?? 'Not available'}</p>
    </section>
    <p class="hint">Only draft metadata is editable. Source file links are fixed when this draft is created.</p>
    <button type="submit" data-submit>Save draft</button><p data-result role="status" aria-live="polite" tabindex="-1"></p>
  </form> : <section class="denied" role="alert"><h2>Draft editing unavailable</h2><p>Only draft versions are editable. Editing requires PERM-DOC-EDIT-DRAFT.</p></section>}
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  import { enhanceClassifiedForm } from '../../../../../ui/forms/enhance-with-classification';
  import { guardUnsavedChanges } from '../../../../../ui/forms/unsaved-changes';
  const form=document.querySelector<HTMLFormElement>('[data-action="documents.updateDraft"]');
  if(form){
    enhanceClassifiedForm(form,{
      invoke:(payload)=>actions.documents.updateDraft(payload as Parameters<typeof actions.documents.updateDraft>[0]),
      payload:(data)=>({versionId:form.dataset.versionId!,expectedVersion:BigInt(form.dataset.expectedVersion!),revision:String(data.get('revision')),changeSummary:String(data.get('changeSummary')||'')||undefined}),
      progressText:'Saving draft…',
      detailBaseHref:`/documents/${form.dataset.documentId}/versions`,
    });
    guardUnsavedChanges(form);
  }
</script>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.hint,.denied p{color:var(--text-muted);font-size:.85rem}.head a{color:var(--color-accent-primary-hover)}.form{max-width:820px;display:grid;gap:var(--space-4);padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}input,textarea{min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}textarea{min-height:140px;resize:vertical}.hint{line-height:1.5}.source-binding{display:grid;gap:var(--space-3);padding:var(--space-4);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md);background:var(--surface-raised)}.source-binding h2{font-size:1rem;margin:0}.source-binding ul{list-style:none;margin:0;padding:0;display:grid;gap:var(--space-2)}.source-binding li{display:grid;gap:.25rem;overflow-wrap:anywhere}.source-binding li span{color:var(--text-muted);font-size:.8rem}.form button{width:max-content;min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}@media(max-width:650px){.head{display:grid}}</style>
