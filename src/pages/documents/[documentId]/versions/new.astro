---
import AppLayout from '../../../../ui/layouts/AppLayout.astro';
import { documentsReadDependencies } from '../../../../modules/documents/application/dependencies.js';
import { actions } from 'astro:actions';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const document = await documentsReadDependencies().get.execute({ actor, documentId: Astro.params.documentId ?? '' }).catch(() => undefined);
if (!document) return Astro.redirect('/404');
const canCreate = actor.permissions.some((permission) => ['PERM-DOC-CREATE','PERM-DOC-REVISE'].includes(permission.code) && permission.active !== false);
const formData = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
const values = {
  revision: String(formData?.get('revision') ?? ''),
  changeSummary: String(formData?.get('changeSummary') ?? ''),
  contentHash: String(formData?.get('contentHash') ?? ''),
};
let failure: string | undefined;
let failureKind: string | undefined;
if (formData && canCreate) {
  const result = await Astro.callAction(actions.documents.createVersion, {
    documentId: document.id,
    revision: values.revision,
    changeSummary: values.changeSummary || undefined,
    contentHash: values.contentHash || undefined,
  });
  if (result.data) return Astro.redirect(`/documents/${document.id}/versions/${result.data.id}`, 303);
  const code = String(result.error?.code ?? result.error?.message ?? '').toUpperCase();
  failureKind = /CONFLICT|STALE/.test(code) ? 'conflict' : /AUTH|PERMISSION/.test(code) ? 'authorization' : /VALIDATION|INVALID|REQUIRED/.test(code) ? 'validation' : 'unavailable';
  failure = failureKind === 'conflict'
    ? 'The document changed while you were preparing this revision. Nothing was submitted. Review the current version history, then start a new revision if it is still needed.'
    : failureKind === 'authorization'
      ? 'This revision was not created because your access is no longer available. Your entries are preserved; return to the document or contact an administrator.'
      : failureKind === 'validation'
        ? 'The revision was not created because one or more values did not meet the document rules. Check the fields below and correct them.'
        : 'The revision could not be created because the service is unavailable. Nothing was submitted; your entries are preserved below.';
}
---
<AppLayout title={`New revision · ${document.documentNo}`} locale="en" direction="ltr"><section class="head"><div><p class="eyebrow">New version</p><h1>New controlled version</h1><p>{document.documentNo} · Creating a new draft leaves existing controlled history unchanged.</p></div><a href={`/documents/${document.id}`}>Back to document</a></section>{canCreate ? <form class="form" method="post" data-action="documents.createVersion" data-document-id={document.id}>{failure && <section class="error-summary" role="alert" tabindex="-1"><h2>Revision not created</h2><p>{failure}</p><ul>{failureKind === 'validation' ? <li><a href="#revision">Check the revision reference</a></li> : null}<li><a href="#revision">Review your preserved entries</a></li></ul></section>}<fieldset><legend>Draft version</legend><label for="revision">Revision reference<input id="revision" name="revision" required value={values.revision} aria-invalid={failureKind === 'validation' ? 'true' : undefined} aria-describedby={failureKind === 'validation' ? 'revision-error' : undefined} /></label>{failureKind === 'validation' ? <p class="field-error" id="revision-error">Enter a revision reference accepted by the controlled document rules.</p> : null}<label for="changeSummary">Change summary<textarea id="changeSummary" name="changeSummary">{values.changeSummary}</textarea></label><label for="contentHash">Controlled content hash<input id="contentHash" name="contentHash" value={values.contentHash} placeholder="Provide before approval" /></label><p class="hint">Binary files are uploaded through the Files capability and linked by file ID; this editor never writes object storage directly.</p></fieldset><div class="actions"><a href={`/documents/${document.id}`}>Cancel</a><button type="submit" data-submit>Create draft version</button></div><p data-result role="status" aria-live="polite" tabindex="-1"></p></form> : <section class="denied" role="alert"><h2>Revision unavailable</h2><p>Your account does not have an explicit create/revise permission for this workflow.</p></section>}</AppLayout>
<script>
  import { actions } from 'astro:actions';
  const form=document.querySelector<HTMLFormElement>('[data-action="documents.createVersion"]');
  if(form){
    form.setAttribute('method','post');
    const status=form.querySelector<HTMLElement>('[data-result]');
    const submit=form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if(submit&&!submit.hasAttribute('data-submit'))submit.setAttribute('data-submit','');
    form.addEventListener('submit',async(event)=>{event.preventDefault();if(form.getAttribute('aria-busy')==='true')return;form.setAttribute('aria-busy','true');if(submit)submit.disabled=true;if(status)status.textContent='Creating draft version…';try{const data=new FormData(form);const result=await actions.documents.createVersion({documentId:form.dataset.documentId!,revision:String(data.get('revision')),changeSummary:String(data.get('changeSummary')||'')||undefined,contentHash:String(data.get('contentHash')||'')||undefined});if(result.data){window.location.href=`/documents/${form.dataset.documentId}/versions/${result.data.id}`;return;}if(status){status.textContent='The revision was not created. Review the fields, current document access, and revision rules; no automatic resubmission occurred.';status.focus?.();}}catch{if(status){status.textContent='The service is temporarily unavailable. Nothing was submitted again; your entries are preserved.';status.focus?.();}}finally{form.removeAttribute('aria-busy');if(submit)submit.disabled=false;}});
  }
</script>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.hint,.denied p{color:var(--text-muted);font-size:.85rem}.head a,.actions a{color:var(--color-accent-primary-hover)}.form{max-width:840px;display:grid;gap:var(--space-5)}fieldset{display:grid;gap:var(--space-4);padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}legend{padding-inline:.5rem;font-weight:700}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}input,textarea{min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}textarea{min-height:130px;resize:vertical}.hint{margin:0;line-height:1.5}.actions{display:flex;justify-content:flex-end;gap:var(--space-3);align-items:center}.actions button{min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}@media(max-width:650px){.head{display:grid}.actions{display:grid;justify-content:stretch}}
</style>
