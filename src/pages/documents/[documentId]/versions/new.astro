---
import AppLayout from '../../../../ui/layouts/AppLayout.astro';
import { documentsReadDependencies } from '../../../../modules/documents/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const document = await documentsReadDependencies().get.execute({ actor, documentId: Astro.params.documentId ?? '' }).catch(() => undefined);
if (!document) return Astro.redirect('/404');
const canCreate = actor.permissions.some((permission) => ['PERM-DOC-CREATE','PERM-DOC-REVISE'].includes(permission.code) && permission.active !== false);
---
<AppLayout title={`New Revision · ${document.documentNo}`} locale="en" direction="ltr"><section class="head"><div><p class="eyebrow">UI-DOC-003 · VERSION EDITOR</p><h1>New controlled version</h1><p>{document.documentNo} · Creating a new Draft leaves existing controlled history unchanged.</p></div><a href={`/documents/${document.id}`}>Back to document</a></section>{canCreate ? <form class="form" data-action="documents.createVersion" data-document-id={document.id}><fieldset><legend>Draft version</legend><label for="revision">Revision reference<input id="revision" name="revision" required /></label><label for="changeSummary">Change summary<textarea id="changeSummary" name="changeSummary"></textarea></label><label for="contentHash">Controlled content hash<input id="contentHash" name="contentHash" placeholder="Provide before approval" /></label><p class="hint">Binary files are uploaded through the Files capability and linked by file ID; this editor never writes object storage directly.</p></fieldset><div class="actions"><a href={`/documents/${document.id}`}>Cancel</a><button type="submit">Create Draft version</button></div></form> : <section class="denied" role="alert"><h2>Revision unavailable</h2><p>Your account does not have an explicit create/revise permission for this workflow.</p></section>}</AppLayout>
<script>
// @ts-expect-error Astro generates the action client module during the build.
import { actions } from 'astro:actions'; const form=document.querySelector<HTMLFormElement>('[data-action="documents.createVersion"]'); form?.addEventListener('submit',async(event)=>{event.preventDefault();const data=new FormData(form);const result=await actions.documents.createVersion({documentId:form.dataset.documentId!,revision:String(data.get('revision')),changeSummary:String(data.get('changeSummary')||'')||undefined,contentHash:String(data.get('contentHash')||'')||undefined});if(result.data)window.location.href=`/documents/${form.dataset.documentId}/versions/${result.data.id}`;else form.setAttribute('aria-invalid','true');});
</script>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.head p:not(.eyebrow),.hint,.denied p{color:var(--text-muted);font-size:.85rem}.head a,.actions a{color:var(--color-accent-primary-hover)}.form{max-width:840px;display:grid;gap:var(--space-5)}fieldset{display:grid;gap:var(--space-4);padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}legend{padding-inline:.5rem;font-weight:700}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}input,textarea{min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}textarea{min-height:130px;resize:vertical}.hint{margin:0;line-height:1.5}.actions{display:flex;justify-content:flex-end;gap:var(--space-3);align-items:center}.actions button{min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}@media(max-width:650px){.head{display:grid}.actions{display:grid;justify-content:stretch}}
</style>
