---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import KpiCard from '../../ui/charts/KpiCard.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import ProviderUnavailableState from '../../ui/components/feedback/ProviderUnavailableState.astro';
import { dashboardDependencies } from '../../modules/dashboard/application/dependencies.js';
import { GetDashboardUseCase } from '../../modules/dashboard/application/get-dashboard.js';
import { describeActorScope } from '../../shared/authorization/scope-description.js';
import { formatDateTime } from '../../shared/copy/format.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fdashboard');
// The scope row is derived from the authenticated actor, never a static label
// (P2-6). On provider failure it degrades to the same derived value.
let dashboard = { generatedAt: new Date(), scopeLabel: describeActorScope(actor), metrics: [], attention: [], activity: [] } as Awaited<ReturnType<GetDashboardUseCase['execute']>>;
let providerUnavailable = false;
try { dashboard = await dashboardDependencies().get.execute(actor); } catch { providerUnavailable = true; }
---
<AppLayout title="Dashboard · QC Operations" locale="en" direction="ltr" scope={dashboard.scopeLabel}>
  <section class="page-head"><div><p class="eyebrow">QC OPERATIONAL COMMAND CENTER</p><h1>Dashboard</h1><p class="lede">What needs your attention right now.</p></div><p class="snapshot" aria-live="polite"><time datetime={dashboard.generatedAt.toISOString()}>Server snapshot · {formatDateTime(dashboard.generatedAt)}</time><a href="/dashboard">Refresh</a></p></section>
  {providerUnavailable && <ProviderUnavailableState title="Dashboard data is unavailable" description="The operational read provider did not return a confirmed snapshot. KPI values and attention counts are withheld." />}
  {!providerUnavailable && <section class="kpis" aria-label="Operational key performance indicators">{dashboard.metrics.map((metric) => <KpiCard label={metric.label} value={metric.value} unit={metric.unit} definition={metric.definition} source={metric.source} timeRange={metric.timeRange} href={metric.href} drilldownLabel={metric.drilldownLabel} tone={metric.tone} />)}</section>}
  <section class="dashboard-grid">
    <div class="main-column"><section class="panel priority-panel" aria-labelledby="attention-title"><div class="panel-head"><div><p class="eyebrow">On hold</p><h2 id="attention-title">Receiving items on HOLD</h2><p class="panel-intro">The eight most recently updated receiving items you recorded that are on HOLD. Open a record to see its current state and next permitted action; the review queue itself is in Approvals.</p></div><a href="/quarantine/receiving?inspectionResult=HOLD">See all HOLD items</a></div>{providerUnavailable ? <p class="empty">Attention data is unavailable. No queue count or empty-state claim is shown.</p> : dashboard.attention.length ? <ul class="attention-list">{dashboard.attention.map((item) => <li><a href={item.href}><span><strong>{item.title}</strong><small>{item.summary}</small></span><StatusBadge status={item.severity === 'CRITICAL' ? 'FAIL' : item.severity === 'WARNING' ? 'HOLD' : 'REVIEW'} label={item.state} /></a></li>)}</ul> : <p class="empty">Nothing you recorded is on HOLD right now.</p>}</section></div>
    <aside class="side-column"><section class="panel" aria-labelledby="activity-title"><div class="panel-head"><div><p class="eyebrow">RECENT ACTIVITY</p><h2 id="activity-title">Audit-aware timeline</h2></div><a href="/audit">Open history</a></div>{providerUnavailable ? <p class="empty">Activity data is unavailable. History is still available from the audit register.</p> : dashboard.activity.length ? <ol class="activity">{dashboard.activity.map((item) => <li><time datetime={item.occurredAt.toISOString()}>{item.occurredAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' })}</time><strong>{item.action}</strong><span>{item.summary}</span></li>)}</ol> : <p class="empty">No recent authorized activity in this scope.</p>}</section><section class="panel coverage" aria-labelledby="coverage-title"><div class="panel-head"><div><p class="eyebrow">DATA COVERAGE</p><h2 id="coverage-title">What this snapshot can answer</h2></div></div><ul><li><strong>Available now</strong><span>Review queue, HOLD, PASS, released state, and your recent activity.</span></li><li><strong>Not supplied</strong><span>Overdue due dates, calibration risk, laboratory workload, blocked reasons, and trend series.</span></li></ul><p class="empty">No trend series is available for this scope. Nothing is plotted until a server-defined series is available.</p></section><section class="panel note"><strong>PASS and Released are separate</strong><p>A scientific PASS does not change the release system state. Follow the controlled workflow for release decisions.</p></section></aside>
  </section>
</AppLayout>
<style>
  .page-head,.topline,.panel-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.page-head{margin-bottom:var(--space-6)}.page-head h1{margin:.2rem 0 .4rem;font-size:clamp(1.8rem,3vw,2.5rem)}.eyebrow{margin:0;color:var(--text-muted);font-size:.75rem;letter-spacing:.12em;font-weight:700}.lede,.page-head time,.panel p,.empty{color:var(--text-muted);font-size:.85rem}.snapshot{display:grid;gap:.25rem;justify-items:end;padding-top:var(--space-2);text-align:end}.snapshot a{font-size:.8rem;font-weight:600}.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-4);margin-bottom:var(--space-5)}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.8fr);gap:var(--space-5)}.main-column,.side-column{display:grid;gap:var(--space-5);align-content:start}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:.3rem 0 0;font-size:1rem}.panel-head a{color:var(--color-accent-primary-hover);font-size:.8rem;white-space:nowrap}.panel-intro{margin:.45rem 0 0}.attention-list,.activity,.coverage ul{list-style:none;margin:var(--space-4) 0 0;padding:0}.attention-list li{border-block-start:1px solid var(--color-border-subtle)}.attention-list a{display:flex;justify-content:space-between;align-items:center;gap:var(--space-4);padding:var(--space-3) 0;color:inherit;text-decoration:none}.attention-list strong,.attention-list small,.activity strong,.activity span,.coverage strong,.coverage span{display:block}.attention-list small{margin-top:4px;color:var(--text-muted);font-size:.75rem}.activity li,.coverage li{display:grid;gap:4px;padding:var(--space-3) 0;border-block-start:1px solid var(--color-border-subtle)}.activity time{color:var(--text-muted);font-size:.7rem}.activity span,.coverage span{color:var(--text-secondary);font-size:.8rem}.coverage strong{font-size:.78rem}.coverage li:first-child strong{color:var(--status-approved)}.coverage li:last-child strong{color:var(--status-warning)}.note{border-inline-start:3px solid var(--status-warning)}.note p{margin-bottom:0}.scope{color:var(--text-muted);font-size:.75rem}@media(max-width:900px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-grid{grid-template-columns:1fr}}@media(max-width:520px){.kpis{grid-template-columns:1fr}.page-head{display:block}.page-head time{display:block;text-align:start;margin-top:var(--space-3)}.panel{padding:var(--space-4)}.panel-head{flex-wrap:wrap}}
</style>
