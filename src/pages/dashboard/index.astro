---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import KpiCard from '../../ui/charts/KpiCard.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import { getDatabase } from '../../shared/database/database.js';
import { PostgresDashboardQuery } from '../../modules/dashboard/infrastructure/postgres-dashboard-query.js';
import { GetDashboardUseCase } from '../../modules/dashboard/application/get-dashboard.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fdashboard');
let dashboard = { generatedAt: new Date(), scopeLabel: 'Authorized operational scope', metrics: [], attention: [], activity: [] } as Awaited<ReturnType<GetDashboardUseCase['execute']>>;
try { dashboard = await new GetDashboardUseCase(new PostgresDashboardQuery(getDatabase())).execute(actor); } catch { /* render a safe empty state when the read provider is unavailable */ }
---
<AppLayout title="Dashboard · QC Operations" locale="en" direction="ltr">
  <Fragment slot="topbar"><div class="topline"><span>QC Operational Command Center</span><span class="scope">{dashboard.scopeLabel}</span></div></Fragment>
  <section class="page-head"><div><p class="eyebrow">OVERVIEW</p><h1>Dashboard</h1><p class="lede">Authorized work that needs attention, in your current operational scope.</p></div><time datetime={dashboard.generatedAt.toISOString()}>Snapshot {dashboard.generatedAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' })}</time></section>
  <section class="kpis" aria-label="Operational key performance indicators">{dashboard.metrics.map((metric) => <KpiCard label={metric.label} value={metric.value} definition={metric.definition} href={metric.href} tone={metric.tone} freshness="current snapshot" />)}</section>
  <section class="dashboard-grid">
    <div class="main-column"><section class="panel" aria-labelledby="trend-title"><div class="panel-head"><div><p class="eyebrow">TREND CONTEXT</p><h2 id="trend-title">Operational trend</h2></div></div><p class="empty">No trend series was supplied by the authorized read model for this snapshot.</p></section><section class="panel" aria-labelledby="attention-title"><div class="panel-head"><div><p class="eyebrow">ATTENTION REQUIRED</p><h2 id="attention-title">Items needing a decision or follow-up</h2></div><a href="/approvals">Open queue</a></div>{dashboard.attention.length ? <ul class="attention-list">{dashboard.attention.map((item) => <li><a href={item.href}><span><strong>{item.title}</strong><small>{item.summary}</small></span><StatusBadge status={item.severity === 'CRITICAL' ? 'FAIL' : item.severity === 'WARNING' ? 'HOLD' : 'REVIEW'} label={item.state} /></a></li>)}</ul> : <p class="empty">No authorized attention items in this snapshot.</p>}</section></div>
    <aside class="side-column"><section class="panel" aria-labelledby="activity-title"><div class="panel-head"><div><p class="eyebrow">RECENT ACTIVITY</p><h2 id="activity-title">Audit-aware timeline</h2></div><a href="/audit">History</a></div>{dashboard.activity.length ? <ol class="activity">{dashboard.activity.map((item) => <li><time datetime={item.occurredAt.toISOString()}>{item.occurredAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' })}</time><strong>{item.action}</strong><span>{item.summary}</span></li>)}</ol> : <p class="empty">No recent authorized activity.</p>}</section><section class="panel note"><strong>PASS and Released are separate</strong><p>A scientific PASS does not change the release system state. Follow the controlled workflow for release decisions.</p></section></aside>
  </section>
</AppLayout>
<style>
  .page-head,.topline,.panel-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.page-head{margin-bottom:var(--space-6)}.page-head h1{margin:.2rem 0 .4rem;font-size:clamp(1.8rem,3vw,2.5rem)}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.page-head time,.panel p,.empty{color:var(--text-muted);font-size:.85rem}.page-head time{padding-top:var(--space-2);text-align:end}.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-4);margin-bottom:var(--space-5)}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.8fr);gap:var(--space-5)}.main-column,.side-column{display:grid;gap:var(--space-5);align-content:start}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:.3rem 0 0;font-size:1rem}.panel-head a{color:var(--color-accent-primary-hover);font-size:.8rem}.attention-list,.activity{list-style:none;margin:var(--space-4) 0 0;padding:0}.attention-list li{border-block-start:1px solid var(--color-border-subtle)}.attention-list a{display:flex;justify-content:space-between;align-items:center;gap:var(--space-4);padding:var(--space-3) 0;color:inherit;text-decoration:none}.attention-list strong,.attention-list small,.activity strong,.activity span{display:block}.attention-list small{margin-top:4px;color:var(--text-muted);font-size:.75rem}.activity li{display:grid;gap:4px;padding:var(--space-3) 0;border-block-start:1px solid var(--color-border-subtle)}.activity time{color:var(--text-muted);font-size:.7rem}.activity span{color:var(--text-secondary);font-size:.8rem}.note{border-inline-start:3px solid var(--status-warning)}.note p{margin-bottom:0}.scope{color:var(--text-muted);font-size:.75rem}@media(max-width:900px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-grid{grid-template-columns:1fr}}@media(max-width:520px){.kpis{grid-template-columns:1fr}.page-head{display:block}.page-head time{display:block;text-align:start;margin-top:var(--space-3)}.panel{padding:var(--space-4)}}
</style>
