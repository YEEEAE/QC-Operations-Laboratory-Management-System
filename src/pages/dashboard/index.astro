---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import KpiCard from '../../ui/charts/KpiCard.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import ProviderUnavailableState from '../../ui/components/feedback/ProviderUnavailableState.astro';
import Chart from '../../ui/charts/Chart.astro';
import { dashboardDependencies } from '../../modules/dashboard/application/dependencies.js';
import { GetDashboardUseCase } from '../../modules/dashboard/application/get-dashboard.js';
import { emptyDashboard } from '../../modules/dashboard/application/dashboard-empty.js';
import { AppError } from '../../shared/errors/app-error.js';
import { formatDateTime } from '../../shared/copy/format.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fdashboard');
// Nothing numeric is rendered until the server confirms a snapshot: the held
// value carries explicit "not available" states instead of zeros (P2-6 keeps
// the scope row server-derived even on failure).
let dashboard = emptyDashboard(actor);
// An authorization failure is not a provider outage (audit baseline #12): the
// account lacks DASH view/management, so no count is withheld-and-retried — it
// is never allowed at all. Only a genuine read failure is "unavailable".
let providerUnavailable = false;
let accessDenied = false;
try {
  dashboard = await dashboardDependencies().get.execute(actor);
} catch (error) {
  if (error instanceof AppError && error.category === 'AUTHORIZATION') accessDenied = true;
  else providerUnavailable = true;
}
---
<AppLayout title="Dashboard · QC Operations" locale="en" direction="ltr" scope={dashboard.scopeLabel}>
  <section class="page-head"><div><p class="eyebrow">QC OPERATIONAL COMMAND CENTER</p><h1>Dashboard</h1><p class="lede">What needs your attention now, what changed, what is waiting, and where the bottlenecks are. Every number below is read from a server register and links to the same filter it was counted with.</p></div><p class="snapshot" aria-live="polite"><time datetime={dashboard.generatedAt.toISOString()}>Server snapshot · {formatDateTime(dashboard.generatedAt)}</time><a href="/dashboard">Refresh</a></p></section>
  {accessDenied && <section class="denied" role="alert"><h2>Your account cannot open the dashboard</h2><p>Viewing operational decision data needs the dashboard permission. Your authorization was not changed by this request.</p><a href="/tasks">Go to your tasks</a></section>}
  {providerUnavailable && <ProviderUnavailableState title="Dashboard data is unavailable" description="At least one operational read provider did not return a confirmed snapshot. Every count, stage and queue is withheld instead of being shown as zero." />}
  {!accessDenied && !providerUnavailable && <section class="kpis" aria-label="Operational action counts">{dashboard.metrics.map((metric) => <KpiCard label={metric.label} value={metric.value} unavailableMessage={metric.unavailable?.message} unit={metric.unit} definition={metric.definition} source={metric.source} timeRange={metric.timeRange} numerator={metric.numerator} state={metric.state} actorScope={metric.actorScope} href={metric.unavailable ? undefined : metric.href} drilldownLabel={metric.drilldownLabel} tone={metric.tone} />)}</section>}
  {!accessDenied && <section class="dashboard-grid">
    <div class="main-column">
      <section class="panel flow-panel" aria-labelledby="flow-title">
        <div class="panel-head"><div><p class="eyebrow">Bottlenecks</p><h2 id="flow-title">{dashboard.flow.title}</h2><p class="panel-intro">{providerUnavailable ? 'The pipeline could not be read.' : dashboard.flow.summary}</p></div><span class="panel-links"><a href={dashboard.flow.sourceHref}>Open the receiving register</a></span></div>
        {providerUnavailable ? <p class="empty">Stage counts are withheld because the snapshot was not confirmed.</p> : dashboard.flow.state === 'AVAILABLE' ? <>
          <ol class="flow">{dashboard.flow.stages.map((stage, index) => <li class={'flow-stage flow-' + stage.tone}><a href={stage.href}><span class="flow-step">Stage {index + 1}</span><strong>{stage.label}</strong><span class="flow-value">{stage.value}<small>records</small></span><small class="flow-condition">{stage.state}</small></a></li>)}</ol>
          <dl class="flow-contract"><div><dt>Source</dt><dd>{dashboard.flow.source}</dd></div><div><dt>Scope</dt><dd>{dashboard.flow.actorScope}</dd></div><div><dt>Window</dt><dd>{dashboard.flow.windowLabel}</dd></div></dl>
        </> : <p class="empty" role="status">{dashboard.flow.message}</p>}
      </section>
      <section class="panel priority-panel" aria-labelledby="attention-title">
        <div class="panel-head"><div><p class="eyebrow">Decisions</p><h2 id="attention-title">Needs your attention</h2><p class="panel-intro">Open items you can act on now, each from a real register, with why it is waiting, how long it has been waiting and a direct link to the record.</p></div><span class="panel-links"><a href="/approvals">Open my approvals</a><a href="/tasks?assignee=mine&due=overdue">Open my overdue tasks</a></span></div>
        {providerUnavailable ? <p class="empty">Attention data is unavailable. No queue count or empty-state claim is shown.</p> : dashboard.attention.length ? <ul class="attention-list">{dashboard.attention.map((item) => <li><a href={item.href}><span><strong>{item.title}</strong><small>{item.reason}</small><small class="attention-age">{item.ageLabel} · {item.state}</small></span><StatusBadge status={item.severity} /></a></li>)}</ul> : <p class="empty">No readable source has an open item for you right now.</p>}
        {!providerUnavailable && <details class="sources"><summary>Sources behind this queue</summary><ul>{dashboard.attentionSources.map((source) => <li class={source.state === 'AVAILABLE' ? 'source-ok' : 'source-denied'}><strong>{source.label}</strong><span>{source.state === 'AVAILABLE' ? 'Read from its own register.' : source.message}</span></li>)}</ul></details>}
      </section>
      {dashboard.series.state === 'AVAILABLE' ? <Chart title={dashboard.series.title} summary={dashboard.series.summary} points={[...dashboard.series.points]} unit={dashboard.series.unit} sourceHref={dashboard.series.sourceHref} sourceLabel="Open the receiving register" meta={[{ label: 'Source', value: dashboard.series.source }, { label: 'Unit', value: dashboard.series.unit }, { label: 'Grain', value: dashboard.series.grain }, { label: 'Counts', value: dashboard.series.numerator }, { label: 'Scope', value: dashboard.series.actorScope }, { label: 'Period', value: dashboard.series.windowLabel }, { label: 'Zero', value: dashboard.series.zeroPolicy }, { label: 'Freshness', value: formatDateTime(dashboard.generatedAt) }]} /> : <section class="panel series-state" aria-labelledby="series-title"><div class="panel-head"><div><p class="eyebrow">Trend</p><h2 id="series-title">{dashboard.series.title}</h2></div><a href={dashboard.series.sourceHref}>Open the receiving register</a></div><p class="empty" role="status">{dashboard.series.message}</p><dl class="series-contract"><div><dt>Source</dt><dd>{dashboard.series.source}</dd></div><div><dt>Unit</dt><dd>{dashboard.series.unit}</dd></div><div><dt>Grain</dt><dd>{dashboard.series.grain}</dd></div><div><dt>Counts</dt><dd>{dashboard.series.numerator}</dd></div><div><dt>Scope</dt><dd>{dashboard.series.actorScope}</dd></div><div><dt>Period</dt><dd>{dashboard.series.windowLabel}</dd></div><div><dt>Freshness</dt><dd>{formatDateTime(dashboard.generatedAt)}</dd></div></dl></section>}
    </div>
    <aside class="side-column">
      <section class="panel" aria-labelledby="activity-title"><div class="panel-head"><div><p class="eyebrow">What changed</p><h2 id="activity-title">Your recent recorded events</h2><p class="panel-intro">Only events recorded against your own account, newest first.</p></div><a href="/audit">Open history</a></div>{providerUnavailable ? <p class="empty">Activity data is unavailable. History is still available from the audit register.</p> : dashboard.activity.length ? <ol class="activity">{dashboard.activity.map((item) => <li><time datetime={item.occurredAt.toISOString()}>{formatDateTime(item.occurredAt)}</time><strong>{item.action}</strong><span>{item.summary}</span></li>)}</ol> : <p class="empty">No recorded event for your account yet.</p>}</section>
      <section class="panel coverage" aria-labelledby="coverage-title"><div class="panel-head"><div><p class="eyebrow">Data coverage</p><h2 id="coverage-title">What this snapshot can answer</h2></div></div>{providerUnavailable ? <p class="empty">The snapshot was not confirmed, so no coverage statement is made.</p> : <ul>{dashboard.coverage.map((item) => <li class={item.state === 'AVAILABLE' ? 'coverage-available' : 'coverage-missing'}><strong>{item.label}</strong><span>{item.reason}</span></li>)}</ul>}<p class="empty">A chart is drawn only from an approved server series. Every other panel states its own source, scope and window, or says honestly why nothing is shown.</p></section>
      <section class="panel note"><strong>PASS and Released are separate</strong><p>A scientific PASS does not change the release system state. Follow the controlled workflow for release decisions.</p></section>
    </aside>
  </section>}
</AppLayout>
<style>
  .page-head,.topline,.panel-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.page-head{margin-bottom:var(--space-6)}.page-head h1{margin:.2rem 0 .4rem;font-size:clamp(1.8rem,3vw,2.5rem)}.eyebrow{margin:0;color:var(--text-muted);font-size:var(--font-size-xs);letter-spacing:.1em;font-weight:700}.lede,.page-head time,.panel p,.empty{color:var(--text-muted);font-size:var(--font-size-sm)}.snapshot{display:grid;gap:.25rem;justify-items:end;padding-top:var(--space-2);text-align:end}.snapshot a{font-size:var(--font-size-xs);font-weight:600}.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(196px,1fr));gap:var(--space-4);margin-bottom:var(--space-5)}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.8fr);gap:var(--space-5)}.main-column,.side-column{display:grid;gap:var(--space-5);align-content:start}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:.3rem 0 0;font-size:1rem}.panel-head a{color:var(--color-accent-primary-hover);font-size:var(--font-size-xs);white-space:nowrap}.panel-links{display:flex;flex-wrap:wrap;gap:var(--space-3);justify-content:flex-end}.panel-intro{margin:.45rem 0 0}.attention-list,.activity,.coverage ul,.flow,.sources ul{list-style:none;margin:var(--space-4) 0 0;padding:0}.attention-list li{border-block-start:1px solid var(--color-border-subtle)}.attention-list a{display:flex;justify-content:space-between;align-items:center;gap:var(--space-4);padding:var(--space-3) 0;color:inherit;text-decoration:none}.attention-list strong,.attention-list small,.activity strong,.activity span,.coverage strong,.coverage span,.sources strong,.sources span{display:block}.attention-list small{margin-top:4px;color:var(--text-muted);font-size:var(--font-size-xs)}.attention-list .attention-age{color:var(--text-secondary);font-weight:600}.activity li,.coverage li,.sources li{display:grid;gap:4px;padding:var(--space-3) 0;border-block-start:1px solid var(--color-border-subtle)}.activity time{color:var(--text-muted);font-size:var(--font-size-xs)}.activity span,.coverage span,.sources span{color:var(--text-secondary);font-size:var(--font-size-sm)}.coverage strong,.sources strong{font-size:var(--font-size-xs)}.coverage-available strong{color:var(--status-approved)}.coverage-missing strong{color:var(--status-warning)}.sources summary{min-block-size:44px;display:flex;align-items:center;color:var(--color-accent-primary-hover);font-size:var(--font-size-xs);cursor:pointer}.sources .source-denied strong{color:var(--status-warning)}.sources span{font-size:var(--font-size-xs)}.flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:var(--space-3);counter-reset:stage}.flow-stage{min-width:0}.flow-stage a{display:grid;gap:2px;height:100%;min-block-size:120px;padding:var(--space-3);background:var(--surface-raised);border:1px solid var(--color-border-subtle);border-block-start:3px solid var(--color-border-default);border-radius:var(--radius-sm);color:inherit;text-decoration:none}.flow-stage a:hover,.flow-stage a:focus-visible{border-color:var(--color-accent-primary)}.flow-danger a{border-block-start-color:var(--status-danger)}.flow-warning a{border-block-start-color:var(--status-warning)}.flow-success a{border-block-start-color:var(--status-approved)}.flow-step{color:var(--text-muted);font-size:var(--font-size-xs);letter-spacing:.08em;text-transform:uppercase}.flow-stage strong{color:var(--text-primary);font-size:var(--font-size-sm)}.flow-value{color:var(--color-accent-primary-hover);font-size:24px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}.flow-value small{margin-inline-start:4px;color:var(--text-muted);font-size:var(--font-size-xs);font-weight:400}.flow-condition{color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.4}.flow-contract{display:grid;gap:2px;margin:var(--space-3) 0 0;color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.45}.flow-contract div{display:grid;grid-template-columns:auto 1fr;gap:2px var(--space-2)}.flow-contract dt{color:var(--text-secondary);font-weight:700}.flow-contract dd{margin:0;min-width:0;overflow-wrap:anywhere}.note{border-inline-start:3px solid var(--status-warning)}.note p{margin-bottom:0}.denied{margin-bottom:var(--space-5);padding:var(--space-5);background:var(--status-warning-bg);border:1px solid var(--status-warning);border-radius:var(--radius-lg)}.series-state .panel-head{margin-bottom:var(--space-3)}.series-contract{display:grid;gap:2px;margin:var(--space-3) 0 0;color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.45}.series-contract div{display:grid;grid-template-columns:auto 1fr;gap:2px var(--space-2)}.series-contract dt{color:var(--text-secondary);font-weight:700}.series-contract dd{margin:0;min-width:0;overflow-wrap:anywhere}.denied h2{margin:0 0 var(--space-2)}.denied p{margin:0 0 var(--space-3)}@media(max-width:900px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-grid{grid-template-columns:1fr}}@media(max-width:520px){.kpis{grid-template-columns:1fr}.page-head{display:block}.page-head time{display:block;text-align:start;margin-top:var(--space-3)}.panel{padding:var(--space-4)}.panel-head{flex-wrap:wrap}.panel-links{justify-content:flex-start}}
</style>
