---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import PageHeader from '../../ui/components/PageHeader.astro';
import DashboardCounts from '../../ui/components/dashboard/DashboardCounts.astro';
import { dashboardStartAction } from '../../ui/components/dashboard/start-action.js';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import ProviderUnavailableState from '../../ui/components/feedback/ProviderUnavailableState.astro';
import Chart from '../../ui/charts/Chart.astro';
import { dashboardDependencies } from '../../modules/dashboard/application/dependencies.js';
import { GetDashboardUseCase } from '../../modules/dashboard/application/get-dashboard.js';
import { emptyDashboard } from '../../modules/dashboard/application/dashboard-empty.js';
import {
  dashboardActivityActionLabel,
  dashboardActivitySubjectLabel,
  dedupeDashboardActivity,
} from '../../modules/dashboard/application/dashboard-presentation.js';
import { AppError } from '../../shared/errors/app-error.js';
import { formatDateTime } from '../../shared/copy/format.js';
import { visibleNavigation, visibleNavigationUtilities } from '../../ui/navigation/navigation.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fdashboard');
// Nothing numeric is rendered until the server confirms a snapshot: the held
// value carries explicit "not available" states instead of zeros (P2-6 keeps
// the scope row server-derived even on failure).
let dashboard = emptyDashboard(actor);
// An authorization failure is not a provider outage (audit baseline #12): the
// account lacks DASH view/management, so no count is withheld-and-retried — it
// is never allowed at all. Only a genuine read failure is "unavailable".
let providerUnavailable = false;
let accessDenied = false;
try {
  dashboard = await dashboardDependencies().get.execute(actor);
} catch (error) {
  if (error instanceof AppError && error.category === 'AUTHORIZATION') accessDenied = true;
  else providerUnavailable = true;
}
// Deduplicate only by the immutable audit event identity. Distinct events with
// the same title or reason remain visible in the audit-derived timeline.
const activity = dedupeDashboardActivity(dashboard.activity);
const startAction = !accessDenied && !providerUnavailable ? dashboardStartAction(actor, dashboard) : undefined;
const emptyFlow = dashboard.flow.state === 'AVAILABLE' && dashboard.flow.stages.length > 0 && dashboard.flow.stages.every((stage) => stage.value === 0);
const departments = visibleNavigation(actor);
const departmentTools = visibleNavigationUtilities(actor);
---
<AppLayout title="Dashboard · QC Operations" locale="en" direction="ltr" scope={dashboard.scopeLabel}>
  <div class="decision-room">
  <PageHeader title="Dashboard"><p slot="actions" class="snapshot" aria-live="polite">{!providerUnavailable && !accessDenied && <time datetime={dashboard.generatedAt.toISOString()}>Server snapshot · {formatDateTime(dashboard.generatedAt)}</time>}<a href="/dashboard">Refresh</a></p></PageHeader>
  {accessDenied && <section class="denied" role="alert"><h2>Your account cannot open the dashboard</h2><p>Viewing operational decision data needs the dashboard permission. Your authorization was not changed by this request.</p><a href="/tasks">Go to your tasks</a></section>}
  {providerUnavailable && <ProviderUnavailableState title="Dashboard data is unavailable" description="Dashboard data could not be loaded. Counts, stages and queues are not shown." />}
  {!accessDenied && <section class="panel priority-panel" aria-labelledby="attention-title">
    <div class="panel-head"><div><p class="eyebrow">Decisions</p><h2 id="attention-title">Needs your attention</h2></div><span class="panel-links"><a href="/approvals">Open my approvals</a><a href="/tasks?assignee=mine&amp;due=overdue">Open my overdue tasks</a></span></div>
    {providerUnavailable ? <p class="empty" role="status">Attention data is unavailable. No records or count are shown.</p> : dashboard.attention.length ? <ul class="attention-list">{dashboard.attention.map((item) => <li><a href={item.href}><span><strong>{item.title}</strong><small>{item.reason}</small><small class="attention-age">{item.ageLabel} · {item.state}</small></span><StatusBadge status={item.severity} /></a></li>)}</ul> : <p class="empty" role="status">No readable source has an open item for you right now.</p>}
    {!providerUnavailable && <details class="sources"><summary>Sources behind this queue</summary><ul>{dashboard.attentionSources.map((source) => <li class={source.state === 'AVAILABLE' ? 'source-ok' : 'source-denied'}><strong>{source.label}</strong><span>{source.state === 'AVAILABLE' ? 'Read from its own register.' : source.message}</span></li>)}</ul></details>}
  </section>}
  {!accessDenied && <section class="panel workflow-access" aria-labelledby="workflow-access-title">
    <div class="panel-head"><div><p class="eyebrow">Decision queues</p><h2 id="workflow-access-title">Work queues</h2></div></div>
    {startAction && <p class="panel-intro">No current work is recorded in these queues. <a href={startAction.href}>{startAction.label}</a>.</p>}
    <ol>
      <li><a href="/approvals">Review and approval work items</a><span>Open your authorized approval queue</span></li>
      <li><a href="/documents?review=mine">Documents awaiting my review</a><span>Active versions awaiting your review, excluding versions you authored</span></li>
      <li><a href="/quarantine/receiving?state=HOLD">Receiving HOLD</a><span>Receiving workflow state is HOLD</span></li>
      <li><a href="/quarantine/inspections?state=SUBMITTED">Inspection review</a><span>Open submitted inspection reports</span></li>
      <li><a href="/laboratory/tests?state=SUBMITTED">Laboratory review</a><span>Open submitted laboratory tests</span></li>
      <li><a href="/quarantine/receiving?inspectionResult=PASS&amp;releaseState=NOT_RELEASED">PASS, not released</a><span>Inspection result is PASS; release system state is NOT_RELEASED</span></li>
    </ol>
  </section>}
  {!accessDenied && !providerUnavailable && departments.length > 0 && <section class="panel departments" aria-labelledby="departments-title">
    <div class="panel-head"><div><p class="eyebrow">Departments</p><h2 id="departments-title">Operational areas</h2><p class="panel-intro">Every area you may open, filtered by your current authorization. Navigation stays in the sidebar; this is discoverability, not a second navigation.</p></div></div>
    <ul class="department-grid">{departments.map((group) => <li><h3>{group.label}</h3><ul>{group.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></li>)}{departmentTools.length > 0 && <li><h3>Workspace tools</h3><ul>{departmentTools.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></li>}</ul>
  </section>}
  {!accessDenied && !providerUnavailable && <DashboardCounts metrics={dashboard.metrics} />}
  {!accessDenied && <section class="dashboard-grid">
    <div class="main-column">
      <section class="panel flow-panel" aria-labelledby="flow-title">
        <div class="panel-head"><div><p class="eyebrow">Bottlenecks</p><h2 id="flow-title">{dashboard.flow.title}</h2><p class="panel-intro">{providerUnavailable ? 'The pipeline could not be read.' : dashboard.flow.summary}</p></div><span class="panel-links"><a href={dashboard.flow.sourceHref}>Open the receiving register</a></span></div>
        {providerUnavailable ? <p class="empty">Stage counts are withheld because the snapshot was not confirmed.</p> : dashboard.flow.state === 'AVAILABLE' ? <>
          <ol class:list={['flow', { 'flow-empty': emptyFlow }]}>{dashboard.flow.stages.map((stage, index) => <li class={'flow-stage flow-' + stage.tone}><a href={stage.href}><span class="flow-step">Stage {index + 1}</span><strong>{stage.label}</strong><span class="flow-value">{stage.value}<small>records</small></span><small class="flow-condition">{stage.state}</small></a></li>)}</ol>
          <dl class="flow-contract"><div><dt>Source</dt><dd>{dashboard.flow.source}</dd></div><div><dt>Scope</dt><dd>{dashboard.flow.actorScope}</dd></div><div><dt>Window</dt><dd>{dashboard.flow.windowLabel}</dd></div></dl>
        </> : <p class="empty" role="status">{dashboard.flow.message}</p>}
      </section>
      {dashboard.series.state === 'AVAILABLE' ? <Chart title={dashboard.series.title} summary={dashboard.series.summary} points={[...dashboard.series.points]} unit={dashboard.series.unit} sourceHref={dashboard.series.sourceHref} sourceLabel="Open the receiving register" meta={[{ label: 'Source', value: dashboard.series.source }, { label: 'Unit', value: dashboard.series.unit }, { label: 'Grain', value: dashboard.series.grain }, { label: 'Counts', value: dashboard.series.numerator }, { label: 'Scope', value: dashboard.series.actorScope }, { label: 'Period', value: dashboard.series.windowLabel }, { label: 'Zero', value: dashboard.series.zeroPolicy }, { label: 'Freshness', value: formatDateTime(dashboard.generatedAt) }]} /> : <section class="panel series-state" aria-labelledby="series-title"><div class="panel-head"><div><p class="eyebrow">Trend</p><h2 id="series-title">{dashboard.series.title}</h2></div><a href={dashboard.series.sourceHref}>Open the receiving register</a></div><p class="empty" role="status">{dashboard.series.message}</p><dl class="series-contract"><div><dt>Source</dt><dd>{dashboard.series.source}</dd></div><div><dt>Unit</dt><dd>{dashboard.series.unit}</dd></div><div><dt>Grain</dt><dd>{dashboard.series.grain}</dd></div><div><dt>Counts</dt><dd>{dashboard.series.numerator}</dd></div><div><dt>Scope</dt><dd>{dashboard.series.actorScope}</dd></div><div><dt>Period</dt><dd>{dashboard.series.windowLabel}</dd></div><div><dt>Freshness</dt><dd>{formatDateTime(dashboard.generatedAt)}</dd></div></dl></section>}
    </div>
    <aside class="side-column">
      <section class="panel" aria-labelledby="activity-title"><div class="panel-head"><div><p class="eyebrow">What changed</p><h2 id="activity-title">Recent activity</h2><p class="panel-intro">Your account activity, newest first. The audit history retains every event.</p></div><a href="/audit">Open history</a></div>{providerUnavailable ? <p class="empty">Activity data is unavailable. Check the audit register for history.</p> : activity.length ? <ol class="activity">{activity.map((item) => <li><time datetime={item.occurredAt.toISOString()}>{formatDateTime(item.occurredAt)}</time><strong>{dashboardActivityActionLabel(item.action)}</strong><span>{dashboardActivitySubjectLabel(item.subjectType)}{item.summary ? ` · ${item.summary}` : ' · Recorded in the audit history'}</span></li>)}</ol> : <p class="empty">No recorded event for your account yet.</p>}</section>
      <details class="panel coverage"><summary id="coverage-title">Data coverage · What this snapshot can answer</summary>{providerUnavailable ? <p class="empty">The snapshot was not confirmed, so no coverage statement is made.</p> : <ul>{dashboard.coverage.map((item) => <li class={item.state === 'AVAILABLE' ? 'coverage-available' : 'coverage-missing'}><strong>{item.label}</strong><span>{item.reason}</span></li>)}</ul>}<p class="empty">Source, scope and period are listed with each dataset.</p></details>
      <section class="panel note"><strong>PASS and RELEASED are separate</strong><p>A scientific PASS does not change the release system state. Follow the controlled workflow for release decisions.</p></section>
    </aside>
  </section>}
  </div>
</AppLayout>
<style>
  .page-head,.topline,.panel-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.page-head{margin-bottom:var(--space-6)}.page-head h1{margin:.2rem 0 .4rem;font-size:clamp(1.8rem,3vw,2.5rem)}.eyebrow{margin:0;color:var(--text-muted);font-size:var(--font-size-xs);letter-spacing:.1em;font-weight:700}.lede,.page-head time,.panel p,.empty{color:var(--text-muted);font-size:var(--font-size-sm)}.snapshot{display:grid;gap:.25rem;justify-items:end;padding-top:var(--space-2);text-align:end}.snapshot a{font-size:var(--font-size-xs);font-weight:600}.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(196px,1fr));gap:var(--space-4);margin-bottom:var(--space-5)}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.8fr);gap:var(--space-5)}.main-column,.side-column{display:grid;gap:var(--space-5);align-content:start}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:.3rem 0 0;font-size:1rem}.panel-head a{color:var(--color-accent-primary-hover);font-size:var(--font-size-xs);white-space:nowrap}.panel-links{display:flex;flex-wrap:wrap;gap:var(--space-3);justify-content:flex-end}.panel-intro{margin:.45rem 0 0}.attention-list,.activity,.coverage ul,.flow,.sources ul{list-style:none;margin:var(--space-4) 0 0;padding:0}.attention-list li{border-block-start:1px solid var(--color-border-subtle)}.attention-list a{display:flex;justify-content:space-between;align-items:center;gap:var(--space-4);padding:var(--space-3) 0;color:inherit;text-decoration:none}.attention-list strong,.attention-list small,.activity strong,.activity span,.coverage strong,.coverage span,.sources strong,.sources span{display:block}.attention-list small{margin-top:4px;color:var(--text-muted);font-size:var(--font-size-xs)}.attention-list .attention-age{color:var(--text-secondary);font-weight:600}.activity li,.coverage li,.sources li{display:grid;gap:4px;padding:var(--space-3) 0;border-block-start:1px solid var(--color-border-subtle)}.activity time{color:var(--text-muted);font-size:var(--font-size-xs)}.activity span,.coverage span,.sources span{color:var(--text-secondary);font-size:var(--font-size-sm)}.coverage strong,.sources strong{font-size:var(--font-size-xs)}.coverage-available strong{color:var(--status-approved)}.coverage-missing strong{color:var(--status-warning)}.sources summary{min-block-size:44px;display:flex;align-items:center;color:var(--color-accent-primary-hover);font-size:var(--font-size-xs);cursor:pointer}.sources .source-denied strong{color:var(--status-warning)}.sources span{font-size:var(--font-size-xs)}.flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:var(--space-3);counter-reset:stage}.flow-stage{position:relative;min-width:0}.flow-stage a{display:grid;gap:2px;height:100%;min-block-size:120px;padding:var(--space-3);background:var(--surface-raised);border:1px solid var(--color-border-subtle);border-block-start:3px solid var(--color-border-default);border-radius:var(--radius-sm);color:inherit;text-decoration:none;box-shadow:var(--shadow-1)}.flow-stage a:hover,.flow-stage a:focus-visible{border-color:var(--color-accent-primary)}.flow-danger a{border-block-start-color:var(--status-danger)}.flow-warning a{border-block-start-color:var(--status-warning)} .flow-success a{border-block-start-color:var(--status-approved)}
  /* Dashboard pipeline: a restrained physical connection between valid stages.
     It is decorative (aria-hidden text remains in the ordered list) and collapses
     naturally at tablet/mobile widths without hiding a workflow step. */
  @media(min-width:1100px){
    .flow-stage:not(:last-child)::after{content:"";position:absolute;inset-inline-end:calc(var(--space-3) * -1 - 4px);inset-block-start:50%;z-index:1;inline-size:8px;block-size:8px;border-block-start:1px solid var(--color-border-strong);border-inline-end:1px solid var(--color-border-strong);transform:translateY(-50%) rotate(45deg);pointer-events:none}
  }
  @media(hover:hover) and (prefers-reduced-motion:no-preference){
    .flow-stage a{transition:transform var(--motion-fast) ease,box-shadow var(--motion-fast) ease}
    .flow-stage a:hover,.flow-stage a:focus-visible{transform:perspective(850px) rotateX(1deg) translateY(-2px);box-shadow:var(--shadow-2)}
  }
  @media(prefers-reduced-motion:reduce){.flow-stage a{transform:none!important;transition:none!important}}
  @media(forced-colors:active){.flow-stage:not(:last-child)::after{border-color:CanvasText}.flow-stage a{box-shadow:none}}
.flow-step{color:var(--text-muted);font-size:var(--font-size-xs);letter-spacing:.08em;text-transform:uppercase}.flow-stage strong{color:var(--text-primary);font-size:var(--font-size-sm)}.flow-value{color:var(--color-accent-primary-hover);font-size:24px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}.flow-value small{margin-inline-start:4px;color:var(--text-muted);font-size:var(--font-size-xs);font-weight:400}.flow-condition{color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.4}.flow-contract{display:grid;gap:2px;margin:var(--space-3) 0 0;color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.45}.flow-contract div{display:grid;grid-template-columns:auto 1fr;gap:2px var(--space-2)}.flow-contract dt{color:var(--text-secondary);font-weight:700}.flow-contract dd{margin:0;min-width:0;overflow-wrap:anywhere}.note{border-inline-start:3px solid var(--status-warning)}.note p{margin-bottom:0}.denied{margin-bottom:var(--space-5);padding:var(--space-5);background:var(--status-warning-bg);border:1px solid var(--status-warning);border-radius:var(--radius-lg)}.series-state .panel-head{margin-bottom:var(--space-3)}.series-contract{display:grid;gap:2px;margin:var(--space-3) 0 0;color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.45}.series-contract div{display:grid;grid-template-columns:auto 1fr;gap:2px var(--space-2)}.series-contract dt{color:var(--text-secondary);font-weight:700}.series-contract dd{margin:0;min-width:0;overflow-wrap:anywhere}.denied h2{margin:0 0 var(--space-2)}.denied p{margin:0 0 var(--space-3)}@media(max-width:900px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-grid{grid-template-columns:1fr}}@media(max-width:520px){.kpis{grid-template-columns:1fr}.page-head{display:block}.page-head time{display:block;text-align:start;margin-top:var(--space-3)}.panel{padding:var(--space-4)}.panel-head{flex-wrap:wrap}.panel-links{justify-content:flex-start}}
.workflow-access ol{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:var(--space-3);padding:0;margin:var(--space-4) 0 0;list-style:none}.workflow-access li{display:grid;gap:.25rem;padding:var(--space-3);background:var(--surface-raised);border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}.workflow-access li a{font-weight:700;color:var(--color-accent-primary-hover)}.workflow-access li span{color:var(--text-muted);font-size:var(--font-size-xs)}
 </style>
<style>
  /* CA-P-DASHBOARD: overview presentation only. Keep DOM/source order and all
     server-owned contracts intact; no selector reaches the workspace Sidebar. */
  .decision-room { display:grid; gap:var(--space-5); min-inline-size:0; }
  .decision-room > :global(*) { min-inline-size:0; margin-block:0; }
  .decision-room > :global(.page-header) { padding-block-end:var(--space-5); }
  .snapshot { margin:0; gap:var(--space-2); padding:0; max-inline-size:38ch; }
  .snapshot time { font-size:var(--font-size-xs); color:var(--text-muted); }
  .snapshot a { padding-inline:var(--space-4); border:1px solid var(--control-border); border-radius:var(--radius-sm); text-decoration:none; }
  .decision-room .panel { padding:clamp(1rem,2vw,1.5rem); background:var(--surface-panel); border:1px solid var(--color-border-default); border-radius:var(--radius-lg); box-shadow:var(--shadow-1); }
  .panel-head { flex-wrap:wrap; gap:var(--space-3); }
  .panel-head > div { min-inline-size:0; flex:1 1 15rem; }
  .panel h2 { font-size:var(--font-size-md); line-height:1.5; }
  .panel-intro { line-height:1.625; max-inline-size:70ch; }
  .panel-links { justify-content:flex-start; gap:var(--space-2) var(--space-4); }
  .decision-room a { min-inline-size:44px; }
  .panel-head a,.snapshot a,.workflow-access li a,.panel-intro a,.denied a { display:inline-flex; align-items:center; min-block-size:44px; white-space:normal; }
  .decision-room :is(a,summary):focus-visible { outline:2px solid var(--focus-ring); outline-offset:2px; border-radius:var(--radius-sm); }
  .decision-room summary { min-block-size:44px; align-content:center; cursor:pointer; font-size:var(--font-size-sm); line-height:1.5; }
  .attention-list a { min-block-size:64px; padding:var(--space-3) var(--space-2); flex-wrap:wrap; }
  .attention-list a > span:first-child { min-inline-size:0; flex:1 1 15rem; }
  .attention-list strong { line-height:1.5; }
  .attention-list :global(.status-badge) { flex:none; }
  .workflow-access ol,.departments .department-grid { grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr)); gap:var(--space-3); }
  .departments .department-grid { display:grid; list-style:none; margin:var(--space-4) 0 0; padding:0; }
  .departments h3 { margin:0 0 var(--space-2); font-size:var(--font-size-sm); color:var(--text-primary); }
  .departments ul ul { list-style:none; margin:0; padding:0; display:grid; gap:var(--space-1); }
  .departments ul ul a { align-items:center; min-block-size:44px; color:var(--color-accent-primary-hover); font-size:var(--font-size-sm); font-weight:600; text-decoration:none; }
  .departments ul ul a:hover { text-decoration:underline; }
  .workflow-access li { border:1px solid var(--color-border-subtle); border-inline-start:2px solid var(--color-accent-primary); background:var(--surface-inset); border-radius:var(--radius-sm); }
  .workflow-access li span { line-height:1.5; }
  .departments .department-grid > li { background:var(--surface-inset); padding:var(--space-4); border:1px solid var(--color-border-subtle); border-radius:var(--radius-md); }
  .departments ul ul a { display:flex; }
  .dashboard-grid { grid-template-columns:minmax(0,1fr); gap:var(--space-5); }
  .main-column,.side-column { min-inline-size:0; gap:var(--space-5); }
  /* Match visual and keyboard/reading order; the flow precedes the chart in DOM. */
  .main-column :global(.chart),.main-column .series-state { order:0; }
  .flow { grid-template-columns:repeat(auto-fit,minmax(min(100%,10.5rem),1fr)); gap:var(--space-3); }
  .flow-stage:not(:last-child)::after { content:none; }
  .flow-stage a { min-block-size:132px; gap:var(--space-2); background:var(--surface-inset); box-shadow:none; }
  .flow-stage a:hover,.flow-stage a:focus-visible { transform:none; box-shadow:none; }
  .flow-empty { gap:var(--space-3); border:0; }
  .flow-empty .flow-stage a { min-block-size:100px; padding:var(--space-3); border:1px solid var(--color-border-subtle); border-radius:var(--radius-sm); background:var(--surface-inset); }
  .flow-contract,.series-contract { gap:var(--space-2); margin-block-start:var(--space-4); }
  .flow-contract div,.series-contract div { grid-template-columns:minmax(0,5rem) minmax(0,1fr); }
  .activity li { gap:var(--space-2); }
  .activity strong { font-size:var(--font-size-sm); }
  .note { border-inline-start:3px solid var(--status-warning)!important; }
  /* Scope fixes for the existing nested primitives without changing other pages. */
  .decision-room :global(.dashboard-counts) { margin-block:0; }
  .decision-room :global(.kpi) { min-inline-size:0; transform:none; }
  .decision-room :global(.kpis) { grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr)); }
  .decision-room :global(.chart-head) { flex-wrap:wrap; }
  .decision-room :global(.chart-head a) { display:inline-flex; align-items:center; min-block-size:44px; }
  .decision-room :global(.definition-meta strong) { font-size:inherit; line-height:inherit; }
  @media(min-width:1280px) {
    .dashboard-grid { grid-template-columns:minmax(0,1.65fr) minmax(0,1fr); }
  }
  @media(max-width:520px) {
    .snapshot { justify-items:start; text-align:start; }
    .panel-links { display:grid; inline-size:100%; }
    .flow-contract div,.series-contract div { grid-template-columns:minmax(0,1fr); gap:var(--space-1); }
  }
  @media(forced-colors:active) {
    .decision-room .panel,.workflow-access li,.departments .department-grid > li,.flow-stage a { border-color:CanvasText; box-shadow:none; }
    .decision-room :is(a,summary):focus-visible { outline-color:Highlight; }
  }
  @media print {
    .decision-room,.dashboard-grid,.main-column,.side-column { display:block; }
    .decision-room .panel { margin-block:var(--space-4); break-inside:avoid; }
  }
</style>
