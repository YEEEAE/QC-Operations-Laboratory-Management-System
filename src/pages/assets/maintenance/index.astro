---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import AppliedFilters from '../../../ui/components/data/AppliedFilters.astro';
import EmptyTableState from '../../../ui/components/data/EmptyTableState.astro';
import FilterBar from '../../../ui/components/data/FilterBar.astro';
import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { formatDate } from '../../../shared/copy/format.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fassets%2Fmaintenance');
const canCreate = actor.permissions.some((permission) => permission.active !== false && permission.code === 'PERM-MNT-CREATE');
const states = ['DRAFT', 'PLANNED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED', 'VOID'] as const;
const params = Astro.url.searchParams;
const requested = params.get('state');
const state = states.find((value) => value === requested);
const equipmentId = params.get('equipmentId') || undefined;
const search = params.get('q')?.slice(0, 200) || undefined;
let records: readonly import('../../../modules/assets/maintenance/domain/maintenance.js').MaintenanceRecord[] =
  [];
let providerUnavailable = false;
try {
  records = await assetsReadDependencies().maintenance.list.execute({
    actor,
    filter: { state, equipmentId, search },
  });
} catch {
  providerUnavailable = true;
}
const chipHref = (drop: string) => {
  const next = new URLSearchParams(params);
  next.delete(drop);
  const query = next.toString();
  return `/assets/maintenance${query ? `?${query}` : ''}`;
};
const appliedFilters = [
  state && { label: 'State', value: stateLabel(state), href: chipHref('state') },
  equipmentId && { label: 'Equipment', value: equipmentId, href: chipHref('equipmentId') },
  search && { label: 'Search', value: search, href: chipHref('q') },
].filter((chip): chip is { label: string; value: string; href: string } => Boolean(chip));
const hasFilters = appliedFilters.length > 0;
---

<AppLayout title="Maintenance · Assets" locale="en" direction="ltr">
  <section class="head">
    <div>
      <p class="eyebrow">Maintenance</p>
      <h1>Maintenance</h1>
      <p>
        Preserve work history and show equipment impact explicitly. Completion does not prove
        calibration.
      </p>
    </div>
    {canCreate && <a class="button" href="/assets/maintenance/new">Add maintenance record</a>}
  </section>
  <FilterBar clearHref={hasFilters ? '/assets/maintenance' : undefined}>
    <label for="q">Search<input id="q" name="q" value={search ?? ''} maxlength="200" /></label>
    <label for="state">State<select id="state" name="state">
        <option value="">All states</option>
        {
          states.map((value) => (
            <option value={value} selected={state === value}>
              {stateLabel(value)}
            </option>
          ))
        }
      </select></label>
    {equipmentId && <input type="hidden" name="equipmentId" value={equipmentId} />}
  </FilterBar>
  <AppliedFilters
    filters={appliedFilters}
    clearHref={hasFilters ? '/assets/maintenance' : undefined}
    note="Showing every maintenance record in your authorized scope."
  />
  {
    providerUnavailable ? (
      <ProviderUnavailableState
        title="Maintenance data is unavailable"
        description="The maintenance read provider did not return a confirmed result, so the register is not treated as empty."
        retryHref="/assets/maintenance"
      />
    ) : records.length ? (
      <div class="table-wrap">
        <table>
          <caption>
            {records.length} authorized maintenance record{records.length === 1 ? '' : 's'}
            {hasFilters ? ' matching the current filters' : ''}
          </caption>
          <thead>
            <tr>
              <th scope="col">Maintenance number</th>
              <th scope="col">Equipment</th>
              <th scope="col">Type</th>
              <th scope="col">State</th>
              <th scope="col">Scheduled</th>
              <th scope="col">Completed</th>
            </tr>
          </thead>
          <tbody>
            {records.map((record) => (
              <tr>
                <th scope="row">
                  <a href={`/assets/maintenance/${record.id}`}>{record.maintenanceNo}</a>
                </th>
                <td>
                  <a href={`/assets/equipment/${record.equipmentId}`}>{record.equipmentId}</a>
                </td>
                <td>{record.maintenanceType ?? 'Not specified'}</td>
                <td>
                  <span class="state">{stateLabel(record.state)}</span>
                </td>
                <td>{record.plannedAt ? formatDate(record.plannedAt) : 'Not scheduled'}</td>
                <td>{record.completedAt ? formatDate(record.completedAt) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : hasFilters ? (
      <EmptyTableState
        title="No maintenance records match these filters"
        description="Nothing in your authorized scope matches the selected filters."
        clearHref="/assets/maintenance"
      />
    ) : (
      <EmptyTableState
        title="No maintenance records yet"
        description="No maintenance record exists in your authorized scope. Create the first draft to start the work history."
        actionLabel={canCreate ? 'Add maintenance record' : undefined}
        actionHref={canCreate ? '/assets/maintenance/new' : undefined}
      />
    )
  }
</AppLayout>
<style>
  .head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:var(--font-size-xs);letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow){color:var(--text-muted);font-size:var(--font-size-sm)}.button{display:inline-flex;align-items:center;justify-content:center;min-height:var(--control-height);padding-inline:1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:var(--color-text-inverse);text-decoration:none;font-weight:var(--font-weight-bold)}.table-wrap{overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:900px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted);font-size:var(--font-size-xs)}th,td{padding:.85rem;border-top:1px solid var(--color-border-subtle);text-align:start;font-size:var(--font-size-sm)}th{font-weight:var(--font-weight-semibold)}a{color:var(--color-accent-primary-hover)}.state{display:inline-flex;padding:.28rem .5rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:var(--font-size-xs);font-weight:var(--font-weight-semibold)}@media(max-width:650px){.head{display:grid}.button{width:max-content}}</style>
