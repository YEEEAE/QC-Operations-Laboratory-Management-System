---
import AppLayout from '../../../ui/layouts/AppLayout.astro'; import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js';
const actor=Astro.locals.actor;if(!actor)return Astro.redirect('/login?returnTo=%2Fassets%2Fmaintenance');const states=['DRAFT','PLANNED','IN_PROGRESS','COMPLETED','CANCELLED','VOID'] as const;const requested=Astro.url.searchParams.get('state');const state=states.find((value)=>value===requested);const equipmentId=Astro.url.searchParams.get('equipmentId')||undefined;const search=Astro.url.searchParams.get('q')?.slice(0,200)||undefined;let records: readonly import('../../../modules/assets/maintenance/domain/maintenance.js').MaintenanceRecord[] = [];try{records=await assetsReadDependencies().maintenance.list.execute({actor,filter:{state,equipmentId,search}});}catch{/* safe empty state */}
---
<AppLayout title="Maintenance · Assets" locale="en" direction="ltr"><section class="head"><div><p class="eyebrow">UI-MNT-001 · T2 LIST</p><h1>Maintenance</h1><p>Preserve work history and show equipment impact explicitly. Completion does not prove calibration.</p></div><a class="button" href="/assets/maintenance/new">Add maintenance record</a></section><form class="filters" method="get"><label for="q">Search<input id="q" name="q" value={search??''} maxlength="200" /></label><label for="state">State<select id="state" name="state"><option value="">All states</option>{states.map((value)=><option value={value} selected={state===value}>{value}</option>)}</select></label>{equipmentId?<input type="hidden" name="equipmentId" value={equipmentId}/>:null}<button class="button secondary" type="submit">Filter</button></form>{records.length?<div class="table-wrap"><table><caption>{records.length} authorized maintenance record{records.length===1?'':'s'}</caption><thead><tr><th scope="col">Maintenance ID</th><th scope="col">Equipment</th><th scope="col">Type</th><th scope="col">State</th><th scope="col">Scheduled</th><th scope="col">Completed</th></tr></thead><tbody>{records.map((record)=><tr><th scope="row"><a href={`/assets/maintenance/${record.id}`}>{record.maintenanceNo}</a></th><td><a href={`/assets/equipment/${record.equipmentId}`}>{record.equipmentId}</a></td><td>{record.maintenanceType??'Not specified'}</td><td><span class="state">{record.state}</span></td><td>{record.plannedAt?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})??'Not scheduled'}</td><td>{record.completedAt?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})??'—'}</td></tr>)}</tbody></table></div>:<section class="empty"><h2>No maintenance records in this view</h2><p>There are no authorized records matching the selected filters.</p><a href="/assets/maintenance/new">Create a draft record</a></section>}</AppLayout>
<style>.head,.filters{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-end}.head{align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.empty p{color:var(--text-muted);font-size:.85rem}.button{display:inline-flex;align-items:center;min-height:var(--control-height);padding-inline:1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;text-decoration:none;font-weight:700}.secondary{background:var(--surface-raised);border-color:var(--border-default);color:var(--text-primary)}.filters{justify-content:flex-start;margin-bottom:var(--space-5)}label{display:grid;gap:.35rem;color:var(--text-secondary);font-size:.8rem}input,select{min-height:var(--control-height);padding:.55rem .7rem;background:var(--surface-panel);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.table-wrap{overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:900px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted);font-size:.8rem}th,td{padding:.85rem;border-top:1px solid var(--color-border-subtle);text-align:start;font-size:.8rem}th{font-weight:700}a{color:var(--color-accent-primary-hover)}.state{display:inline-flex;padding:.28rem .5rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:.7rem;font-weight:700}.empty{margin-top:var(--space-5);padding:var(--space-8);text-align:center;background:var(--surface-panel);border:1px dashed var(--color-border-strong);border-radius:var(--radius-lg)}.empty h2{margin:0 0 .5rem;font-size:1.1rem}.empty a{font-weight:700}@media(max-width:650px){.head,.filters{display:grid}.button{width:max-content}}
</style>
