---
import AppLayout from '../../../ui/layouts/AppLayout.astro'; import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js';
const actor=Astro.locals.actor;if(!actor)return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);let record;try{record=await assetsReadDependencies().maintenance.get.execute({actor,maintenanceId:Astro.params.maintenanceId??''});}catch{return Astro.redirect('/404')}if(!record)return Astro.redirect('/404');
---
<AppLayout title={`${record.maintenanceNo} · Maintenance`} locale="en" direction="ltr"><div class="crumb"><a href="/assets">Assets</a><span>/</span><a href="/assets/maintenance">Maintenance</a><span>/</span><span>{record.maintenanceNo}</span></div><section class="head"><div><p class="eyebrow">UI-MNT-002 · T7 RECORD WORKSPACE</p><h1>{record.maintenanceNo}</h1><p>Equipment <a href={`/assets/equipment/${record.equipmentId}`}>{record.equipmentId}</a> · Version {record.version.toString()}</p></div><span class="state">{record.state}</span></section><div class="grid"><section class="panel"><h2>Maintenance summary</h2><dl><div><dt>Description</dt><dd>{record.description}</dd></div><div><dt>Type</dt><dd>{record.maintenanceType??'Not specified'}</dd></div><div><dt>Equipment</dt><dd><a href={`/assets/equipment/${record.equipmentId}`}>{record.equipmentId}</a></dd></div><div><dt>Provider</dt><dd>{record.provider??'Not supplied'}</dd></div><div><dt>Performed by</dt><dd>{record.performedBy??'Not supplied'}</dd></div></dl></section><section class="panel"><h2>Execution timeline</h2><dl><div><dt>Planned</dt><dd>{record.plannedAt?.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})??'Not scheduled'}</dd></div><div><dt>Started</dt><dd>{record.startedAt?.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})??'Not started'}</dd></div><div><dt>Completed</dt><dd>{record.completedAt?.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})??'Not completed'}</dd></div><div><dt>Result</dt><dd>{record.result??'Not supplied'}</dd></div></dl></section></div><section class="panel history"><h2>Equipment state impact</h2><p>Starting maintenance can set the equipment state to UNDER_MAINTENANCE transactionally. Completion does not automatically return equipment to service or establish calibration validity; those are separate controlled decisions.</p><p class="muted">Created by {record.createdBy} · Updated {record.updatedAt.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})}</p></section></AppLayout>
<style>.crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,.head a{color:var(--color-accent-primary-hover)}.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.muted,.history p{color:var(--text-muted);font-size:.85rem}.state{padding:.45rem .7rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:.75rem;font-weight:700}.grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0;font-size:1rem}dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin:var(--space-5) 0 0}dt{color:var(--text-muted);font-size:.75rem}dd{margin:.3rem 0 0;font-weight:700;font-size:.86rem}.history{margin-top:var(--space-5)}.history p{line-height:1.6}@media(max-width:700px){.head{display:grid}.grid{grid-template-columns:1fr}dl{grid-template-columns:1fr}}
</style>
