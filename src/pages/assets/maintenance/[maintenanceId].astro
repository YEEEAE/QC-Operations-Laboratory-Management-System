---
import PageHeader from "../../../ui/components/PageHeader.astro";
import AppLayout from '../../../ui/layouts/AppLayout.astro'; import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro'; import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js'; import { stateLabel } from '../../../shared/copy/ux-vocabulary.js'; import JourneyContextPanel from '../../../ui/components/workflow/JourneyContextPanel.astro'; import AssetActionRail from '../../../ui/components/workflow/AssetActionRail.astro'; import { classifyReadFailure, providerUnavailableResponse } from '../../../shared/errors/read-failure.js';
const actor=Astro.locals.actor;if(!actor)return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);const read=assetsReadDependencies();let record;let history: readonly import('../../../modules/assets/maintenance/ports/repository.js').MaintenanceHistory[]=[];let historyUnavailable=false;try{record=await read.maintenance.get.execute({actor,maintenanceId:Astro.params.maintenanceId??''});}catch(error){if(classifyReadFailure(error)==='UNAVAILABLE')return providerUnavailableResponse('Maintenance details are temporarily unavailable',Astro.url.pathname+Astro.url.search);return Astro.redirect('/404')}if(!record)return Astro.redirect('/404');let equipmentLabel = 'Equipment record';try{const equipment = await read.equipment.get.execute({actor,equipmentId:record.equipmentId});if(equipment)equipmentLabel = `${equipment.equipmentNo} · ${equipment.name}`;}catch{}try{history=await read.maintenance.history.execute({actor,maintenanceId:record.id});}catch{historyUnavailable=true;}
---
<AppLayout title={`${record.maintenanceNo} · Maintenance`} locale="en" direction="ltr"><div class="crumb"><a href="/assets">Assets</a><span>/</span><a href="/assets/maintenance">Maintenance</a><span>/</span><span>{record.maintenanceNo}</span></div><PageHeader><Fragment slot="heading"><h1>{record.maintenanceNo}</h1></Fragment><p>Equipment <a href={`/assets/equipment/${record.equipmentId}`}>{equipmentLabel}</a> · Version {record.version.toString()}</p><Fragment slot="actions"><span class="state">{stateLabel(record.state)}</span></Fragment></PageHeader><JourneyContextPanel ownerDomain="Equipment & Maintenance" recordReference={`${record.maintenanceNo} · version ${record.version.toString()}`} currentState={record.state} nextAction={record.state === 'DRAFT' ? 'Plan maintenance' : record.state === 'PLANNED' ? 'Start or cancel maintenance' : record.state === 'IN_PROGRESS' ? 'Complete maintenance' : undefined} nextOwner={record.state === 'IN_PROGRESS' ? 'Maintenance owner' : undefined} waitingOn={record.state === 'PLANNED' ? 'Maintenance start' : record.state === 'IN_PROGRESS' ? 'Maintenance completion' : undefined} expectedEvent={record.state === 'DRAFT' ? 'Plan work' : record.state === 'PLANNED' ? 'Start work' : record.state === 'IN_PROGRESS' ? 'Complete work' : undefined} controlledContext={`${equipmentLabel} · ${record.maintenanceType ?? 'type not supplied'}`} evidenceSummary={`${record.description} · downtime ${record.downtimeMinutes === undefined ? 'open or not recorded' : `${record.downtimeMinutes} minutes`}`} auditHref={`/audit?subjectType=MAINTENANCE_RECORD&subjectId=${encodeURIComponent(record.id)}`} relatedLinks={[{label: equipmentLabel, href: `/assets/equipment/${record.equipmentId}`, detail: 'Equipment-owned status'}, {label: 'Maintenance register', href: '/assets/maintenance', detail: 'Equipment maintenance records'}]} /><AssetActionRail kind="maintenance" record={record} actor={actor} returnTo={Astro.url.pathname + Astro.url.search} /><div class="grid"><section class="panel"><h2>Maintenance summary</h2><dl><div><dt>Description</dt><dd>{record.description}</dd></div><div><dt>Type</dt><dd>{record.maintenanceType??'Not specified'}</dd></div><div><dt>Equipment</dt><dd><a href={`/assets/equipment/${record.equipmentId}`}>{equipmentLabel}</a></dd></div><div><dt>Provider</dt><dd>{record.provider??'Not supplied'}</dd></div><div><dt>Performed by</dt><dd>{record.performedBy??'Not supplied'}</dd></div><div><dt>Downtime</dt><dd>{record.downtimeMinutes === undefined ? 'Open or not recorded' : `${record.downtimeMinutes} minutes`}</dd></div></dl></section><section class="panel"><h2>Execution timeline</h2><dl><div><dt>Planned</dt><dd>{record.plannedAt?.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})??'Not scheduled'}</dd></div><div><dt>Started</dt><dd>{record.startedAt?.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})??'Not started'}</dd></div><div><dt>Completed</dt><dd>{record.completedAt?.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})??'Not completed'}</dd></div><div><dt>Result</dt><dd>{record.result??'Not supplied'}</dd></div></dl></section></div><section class="panel history"><h2>Immutable history</h2>{historyUnavailable ? <ProviderUnavailableState title="Maintenance history is unavailable" description="The maintenance record is shown, but its history could not be confirmed." retryHref={Astro.url.pathname + Astro.url.search} /> : history.length ? <table><caption>Append-only maintenance state history</caption><thead><tr><th scope="col">Action</th><th scope="col">State</th><th scope="col">Version</th><th scope="col">Changed</th></tr></thead><tbody>{history.map((item)=><tr><th scope="row">{item.action}</th><td>{stateLabel(item.state)}</td><td>{item.recordVersion.toString()}</td><td>{item.changedAt.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})}</td></tr>)}</tbody></table> : <p class="muted">No maintenance history entries are visible in your authorized scope.</p>}<p>Starting maintenance can put the equipment under maintenance. Completion does not return equipment to service or prove calibration; those are separate controlled decisions.</p><p class="muted">Created by {record.createdBy} · Updated {record.updatedAt.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})}</p></section></AppLayout>
<style>.crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,.head a{color:var(--color-accent-primary-hover)}.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.muted,.history p{color:var(--text-muted);font-size:.85rem}.state{padding:.45rem .7rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:.75rem;font-weight:700}.grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0;font-size:1rem}dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin:var(--space-5) 0 0}dt{color:var(--text-muted);font-size:.75rem}dd{margin:.3rem 0 0;font-weight:700;font-size:.86rem}.history{margin-top:var(--space-5)}.history p{line-height:1.6}@media(max-width:700px){.head{display:grid}.grid{grid-template-columns:1fr}dl{grid-template-columns:1fr}}
</style>
