---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import FormErrorSummary from '../../../ui/components/FormErrorSummary.astro';
import { actions } from 'astro:actions';
import {
  detailHref,
  extractDetailId,
  field,
  optionalField,
  toFormFailure,
  type FormFailure,
} from '../../../ui/forms/mutation-post.js';
import {
  resolvePreselectedId,
  safeListHref,
  toSelectOptions,
} from '../../../ui/forms/entity-select.js';
import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js';

const actor=Astro.locals.actor;if(!actor)return Astro.redirect('/login?returnTo=%2Fassets%2Fmaintenance%2Fnew');const canCreate=actor.permissions.some((permission)=>permission.code==='PERM-MNT-CREATE');

const LIST_HREF = '/assets/maintenance';
// Safe list return context (F-09): Cancel/back preserve a benign list filter
// when the operator arrived with one; anything else falls back to the list.
const returnHref = safeListHref(Astro.url.searchParams.get('returnTo'), LIST_HREF);
const REQUIRED_FIELDS = [
  { name: 'maintenanceNo', label: 'Maintenance ID' },
  { name: 'equipmentId', label: 'Equipment' },
  { name: 'description', label: 'Description' },
] as const;

// Authorized selector source (F-06): equipment in the operator's authorized
// scope, loaded server-side through the application use case (which requires
// PERM-EQP-VIEW). The UUID travels only as the selected option value; the
// operator always sees the human-readable equipment number + name.
let equipmentOptions: { value: string; label: string }[] = [];
let equipmentError = false;
if (canCreate) {
  try {
    const equipment = await assetsReadDependencies().equipment.list.execute({ actor });
    equipmentOptions = toSelectOptions(
      equipment.map((item) => ({ id: item.id, label: `${item.equipmentNo} · ${item.name}` })),
    );
  } catch {
    // Fail closed into an error state below: the form stays submittable so
    // entries are preserved, and the server still validates the equipment
    // reference on submit. No unauthorized equipment detail is disclosed.
    equipmentError = true;
  }
}

// Contextual preselection (e.g. `?equipmentId=…` from an equipment
// workspace): honored only when still authorized, otherwise surfaced as a
// stale-selection warning that requires an explicit operator choice.
const preselected = resolvePreselectedId(
  Astro.url.searchParams.get('equipmentId'),
  equipmentOptions,
);

let values = { maintenanceNo: '', equipmentId: preselected.id, maintenanceType: '', plannedAt: '', description: '', performedBy: '', provider: '' };
let failure: FormFailure | null = null;
let staleSelection = preselected.stale;

// POST baseline (F-05): without JavaScript the form performs a real POST to
// this page. The same Astro Action — with the same server-side
// reauthorization — runs via Astro.callAction. No business payload enters
// the URL: input travels in the POST body, success redirects (303) to the
// new record only.
if (Astro.request.method === 'POST' && canCreate) {
  const formData = await Astro.request.formData();
  const plannedRaw = field(formData, 'plannedAt');
  values = {
    maintenanceNo: field(formData, 'maintenanceNo'),
    equipmentId: field(formData, 'equipmentId'),
    maintenanceType: field(formData, 'maintenanceType'),
    plannedAt: plannedRaw,
    description: field(formData, 'description'),
    performedBy: field(formData, 'performedBy'),
    provider: field(formData, 'provider'),
  };
  // A posted id outside the authorized selector list is never trusted: the
  // server still validates the equipment reference, and the operator gets a
  // dependency recovery pointing back at the authorized list.
  staleSelection = values.equipmentId
    ? !equipmentOptions.some((option) => option.value === values.equipmentId)
    : false;
  try {
    const data = await Astro.callAction(actions.assets.createMaintenance, {
      maintenanceNo: values.maintenanceNo,
      equipmentId: values.equipmentId,
      maintenanceType: optionalField(formData, 'maintenanceType'),
      description: values.description,
      ...(plannedRaw ? { plannedAt: new Date(plannedRaw) } : {}),
      performedBy: optionalField(formData, 'performedBy'),
      provider: optionalField(formData, 'provider'),
    });
    const id = extractDetailId(data);
    if (id) return Astro.redirect(detailHref(LIST_HREF, id), 303);
    failure = {
      kind: 'unknown',
      summary: 'The maintenance record was received but no record reference came back.',
      recovery: 'Check the maintenance register before trying again to avoid a duplicate.',
      fieldErrors: {},
      firstInvalidField: null,
    };
  } catch (error) {
    failure = toFormFailure(error, {
      entity: 'Maintenance record',
      requiredFields: REQUIRED_FIELDS,
      values,
      listHref: LIST_HREF,
      listLabel: 'maintenance',
    });
  }
}

const describedBy = (name: keyof typeof values): string | undefined =>
  failure?.fieldErrors[name] ? `${name}-error` : undefined;
const invalid = (name: keyof typeof values): 'true' | undefined =>
  failure?.fieldErrors[name] ? 'true' : undefined;
---
<AppLayout title="New Maintenance · Assets" locale="en" direction="ltr"><section class="head"><div><p class="eyebrow">T3 CONTROLLED MAINTENANCE</p><h1>New maintenance record</h1><p>Maintenance is linked to equipment. Starting work may put equipment UNDER_MAINTENANCE; completion does not certify calibration.</p></div><a href={returnHref}>Back to maintenance</a></section>{canCreate?<form class="form" method="post" data-action="assets.createMaintenance">{failure && <FormErrorSummary summary={failure.summary} recovery={failure.recovery} listHref={returnHref} listLabel="maintenance" />}<fieldset><legend>Maintenance identity</legend><div class="fields"><div><label for="maintenanceNo">Maintenance ID<span class="hint" id="maintenanceNo-help">Use the maintenance number from your approved source. The technical record identifier is generated server-side.</span><input id="maintenanceNo" name="maintenanceNo" required value={values.maintenanceNo} aria-invalid={invalid('maintenanceNo')} aria-describedby={failure?.fieldErrors.maintenanceNo ? 'maintenanceNo-error maintenanceNo-help' : 'maintenanceNo-help'} /></label>{failure?.fieldErrors.maintenanceNo && <p class="field-error" id="maintenanceNo-error">{failure.fieldErrors.maintenanceNo}</p>}</div><div><label for="equipmentId">Equipment<span class="hint" id="equipmentId-help">Choose from equipment in your authorized scope. The technical identifier is kept automatically after selection. <a href="/assets/equipment/new">New equipment</a></span><select id="equipmentId" name="equipmentId" required aria-invalid={invalid('equipmentId')} aria-describedby={failure?.fieldErrors.equipmentId ? 'equipmentId-error equipmentId-help' : 'equipmentId-help'}><option value="">Select equipment…</option>{equipmentOptions.map((option)=><option value={option.value} selected={option.value===values.equipmentId}>{option.label}</option>)}</select></label>{staleSelection && <p class="field-warning" role="status">The previously linked equipment is no longer available in your authorized scope. Choose the equipment explicitly.</p>}{equipmentError && <p class="field-warning" role="status">The authorized equipment list is temporarily unavailable. Your entries are kept — you can try again, or return to the list.</p>}{!equipmentError && equipmentOptions.length===0 && <p class="field-warning" role="status">No equipment is available in your authorized scope. <a href="/assets/equipment/new">Create the equipment first</a>, then return here.</p>}{failure?.fieldErrors.equipmentId && <p class="field-error" id="equipmentId-error">{failure.fieldErrors.equipmentId}</p>}</div><div><label for="maintenanceType">Type<input id="maintenanceType" name="maintenanceType" value={values.maintenanceType} /></label></div><div><label for="plannedAt">Scheduled date<input id="plannedAt" name="plannedAt" type="datetime-local" value={values.plannedAt} /></label></div><div class="wide"><label for="description">Description<textarea id="description" name="description" required aria-invalid={invalid('description')} aria-describedby={describedBy('description')}>{values.description}</textarea></label>{failure?.fieldErrors.description && <p class="field-error" id="description-error">{failure.fieldErrors.description}</p>}</div><div><label for="performedBy">Performed by<input id="performedBy" name="performedBy" value={values.performedBy} /></label></div><div><label for="provider">Provider<input id="provider" name="provider" value={values.provider} /></label></div></div></fieldset><div class="actions"><a class="secondary" href={returnHref}>Cancel</a><button type="submit" data-submit>Create draft</button></div><p role="status" data-result></p></form>:<section class="denied" role="alert"><h2>Creation is not available</h2><p>Your account does not have the explicit Maintenance create permission.</p></section>}</AppLayout>
<script>
import{actions}from'astro:actions';const form=document.querySelector<HTMLFormElement>('[data-action="assets.createMaintenance"]');form?.addEventListener('submit',async(event)=>{event.preventDefault();const data=new FormData(form);const submit=form.querySelector<HTMLButtonElement>('[data-submit]');const output=form.querySelector<HTMLElement>('[data-result]');if(submit)submit.disabled=true;form.setAttribute('aria-busy','true');if(output)output.textContent='Saving…';try{const planned=String(data.get('plannedAt')||'');const result=await actions.assets.createMaintenance({maintenanceNo:String(data.get('maintenanceNo')),equipmentId:String(data.get('equipmentId')),maintenanceType:String(data.get('maintenanceType')||'')||undefined,description:String(data.get('description')),plannedAt:planned?new Date(planned):undefined,performedBy:String(data.get('performedBy')||'')||undefined,provider:String(data.get('provider')||'')||undefined});if(result.data&&typeof result.data.id==='string'){window.location.href=`/assets/maintenance/${result.data.id}`;return;}if(output)output.textContent='Unable to create this maintenance record. Review the fields and try again.';const firstInvalid=form.querySelector<HTMLElement>('select:invalid,input:invalid,textarea:invalid');(firstInvalid??output)?.focus?.();}catch{if(output)output.textContent='The service is temporarily unavailable. Your entries are kept — try again.';}finally{if(submit)submit.disabled=false;form.removeAttribute('aria-busy');}});</script>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.denied p{color:var(--text-muted);font-size:.85rem}.head a{color:var(--color-accent-primary-hover)}.form{max-width:900px;display:grid;gap:var(--space-5)}fieldset{padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}legend{padding-inline:.5rem;font-weight:700}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}.hint{color:var(--text-muted);font-size:.78rem}.hint a{color:var(--color-accent-primary-hover)}.wide{grid-column:1/-1}input,select,textarea{min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}input[aria-invalid="true"],select[aria-invalid="true"],textarea[aria-invalid="true"]{border-color:var(--status-danger)}.field-error{margin:.25rem 0 0;color:var(--status-danger);font-size:.8rem}.field-warning{margin:.25rem 0 0;padding:.6rem;border-inline-start:3px solid var(--status-warning);background:var(--surface-panel);font-size:.8rem}.field-warning a{color:var(--color-accent-primary-hover)}textarea{min-height:6rem}.actions{display:flex;justify-content:flex-end;gap:var(--space-3)}button,.secondary{min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.secondary{border-color:var(--border-default);background:var(--surface-raised);color:var(--text-primary);text-decoration:none}button[disabled]{opacity:.6}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}@media(max-width:650px){.head{display:grid}.fields{grid-template-columns:1fr}.wide{grid-column:auto}.actions{display:grid}}
</style>
