---
import PageHeader from "../../../ui/components/PageHeader.astro";
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { classifyReadFailure } from '../../../shared/errors/read-failure.js';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);

const equipmentId = Astro.params.equipmentId ?? '';
const read = assetsReadDependencies();
let equipment: Awaited<ReturnType<typeof read.equipment.get.execute>> | undefined;
let equipmentUnavailable = false;
try {
  equipment = await read.equipment.get.execute({ actor, equipmentId });
} catch (error) {
  equipmentUnavailable = classifyReadFailure(error) === 'UNAVAILABLE';
}
// Missing and denied records share the same outward response to preserve existence secrecy.
if (!equipment && !equipmentUnavailable) return Astro.redirect('/404');
if (equipmentUnavailable) Astro.response.status = 503;

let calibrations: readonly import('../../../modules/assets/calibration/domain/calibration.js').CalibrationRecord[] = [];
let maintenance: readonly import('../../../modules/assets/maintenance/domain/maintenance.js').MaintenanceRecord[] = [];
let statusHistory: readonly import('../../../modules/assets/equipment/ports/repository.js').EquipmentStatusHistory[] = [];
let calibrationReadFailed = false;
let calibrationDenied = false;
let maintenanceReadFailed = false;
let maintenanceDenied = false;
let historyReadFailed = false;
let historyDenied = false;
if (equipment) {
  const [calibrationResult, maintenanceResult, historyResult] = await Promise.allSettled([
    read.calibration.list.execute({ actor, filter: { equipmentId } }),
    read.maintenance.list.execute({ actor, filter: { equipmentId } }),
    read.equipment.history.execute({ actor, equipmentId }),
  ]);
  if (calibrationResult.status === 'fulfilled') calibrations = calibrationResult.value;
  else if (classifyReadFailure(calibrationResult.reason) === 'UNAVAILABLE') calibrationReadFailed = true;
  else calibrationDenied = true;
  if (maintenanceResult.status === 'fulfilled') maintenance = maintenanceResult.value;
  else if (classifyReadFailure(maintenanceResult.reason) === 'UNAVAILABLE') maintenanceReadFailed = true;
  else maintenanceDenied = true;
  if (historyResult.status === 'fulfilled') statusHistory = historyResult.value;
  else if (classifyReadFailure(historyResult.reason) === 'UNAVAILABLE') historyReadFailed = true;
  else historyDenied = true;
}

const item = equipment;
---
<AppLayout title={`${item?.equipmentNo ?? 'Equipment'} · Assets`} locale="en" direction="ltr">
  {equipmentUnavailable ? <ProviderUnavailableState title="Equipment details are temporarily unavailable" description="The equipment source did not confirm this read. No missing-record conclusion or equipment details are shown." retryHref={Astro.url.pathname + Astro.url.search} /> : item && <>
    <div class="crumb"><a href="/assets">Assets</a><span>/</span><a href="/assets/equipment">Equipment</a><span>/</span><span>{item.equipmentNo}</span></div>
    <PageHeader><Fragment slot="heading"><h1>{item.name}</h1></Fragment><p>{item.equipmentNo} · Version {item.version.toString()}</p><Fragment slot="actions"><span class="state">{stateLabel(item.state)}</span></Fragment></PageHeader>
    <section class="facts" aria-label="Equipment identity"><div><span>Manufacturer</span><strong>{item.manufacturer ?? 'Not supplied'}</strong></div><div><span>Model</span><strong>{item.model ?? 'Not supplied'}</strong></div><div><span>Serial number</span><strong>{item.serialNo ?? 'Not supplied'}</strong></div><div><span>Location</span><strong>{item.location ?? 'Not supplied'}</strong></div><div><span>Calibration required</span><strong>{item.calibrationRequired === undefined ? 'Not specified' : item.calibrationRequired ? 'Yes' : 'No'}</strong></div><div><span>Maintenance required</span><strong>{item.maintenanceRequired === undefined ? 'Not specified' : item.maintenanceRequired ? 'Yes' : 'No'}</strong></div></section>
    <div class="grid">
      <section class="panel"><div class="panel-head"><h2>Calibration history</h2><span class="panel-links"><a href={`/assets/calibrations/new?equipmentId=${item.id}`}>Record calibration</a><a href={`/assets/calibrations?equipmentId=${item.id}`}>View all records</a></span></div>{calibrationReadFailed ? <ProviderUnavailableState title="Calibration history is unavailable" description="The equipment record is shown, but its calibration history could not be confirmed." retryHref={Astro.url.pathname + Astro.url.search} /> : calibrations.length ? <table><caption>Authorized calibration records</caption><thead><tr><th scope="col">Calibration number</th><th scope="col">State</th><th scope="col">Date</th><th scope="col">Due date</th></tr></thead><tbody>{calibrations.map((record)=><tr><th scope="row"><a href={`/assets/calibrations/${record.id}`}>{record.calibrationNo}</a></th><td>{stateLabel(record.state)}</td><td>{record.calibrationDate.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})}</td><td>{record.dueDate?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'}) ?? 'Not supplied'}</td></tr>)}</tbody></table> : <p class="muted">No calibration records are available in your authorized scope.</p>}</section>
      <section class="panel"><div class="panel-head"><h2>Maintenance history</h2><span class="panel-links"><a href={`/assets/maintenance/new?equipmentId=${item.id}`}>Record maintenance</a><a href={`/assets/maintenance?equipmentId=${item.id}`}>View all records</a></span></div>{maintenanceReadFailed ? <ProviderUnavailableState title="Maintenance history is unavailable" description="The equipment record is shown, but its maintenance history could not be confirmed." retryHref={Astro.url.pathname + Astro.url.search} /> : maintenance.length ? <table><caption>Authorized maintenance records</caption><thead><tr><th scope="col">Maintenance number</th><th scope="col">State</th><th scope="col">Planned</th></tr></thead><tbody>{maintenance.map((record)=><tr><th scope="row"><a href={`/assets/maintenance/${record.id}`}>{record.maintenanceNo}</a></th><td>{stateLabel(record.state)}</td><td>{record.plannedAt?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'}) ?? 'Not scheduled'}</td></tr>)}</tbody></table> : <p class="muted">No maintenance records are available in your authorized scope.</p>}</section>
    </div>
    <section class="panel history"><h2>Status history</h2>{historyReadFailed ? <ProviderUnavailableState title="Status history is unavailable" description="The equipment record is shown, but its status history could not be confirmed." retryHref={Astro.url.pathname + Astro.url.search} /> : statusHistory.length ? <table><caption>Append-only equipment status history</caption><thead><tr><th scope="col">Action</th><th scope="col">From</th><th scope="col">To</th><th scope="col">Changed</th></tr></thead><tbody>{statusHistory.map((record)=><tr><th scope="row">{record.action}</th><td>{record.fromState ? stateLabel(record.fromState) : '—'}</td><td>{stateLabel(record.toState)}</td><td>{record.changedAt.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})}</td></tr>)}</tbody></table> : <p class="muted">No status history is available in your authorized scope.</p>}<p>Equipment identity changes only through the controlled workflow. Laboratory records created earlier keep the equipment context they were executed with.</p><dl><div><dt>Created by</dt><dd>{item.createdBy}</dd></div><div><dt>Updated</dt><dd>{item.updatedAt.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})}</dd></div></dl></section>
  </>}
</AppLayout>
<style>.crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,.panel-head a{color:var(--color-accent-primary-hover)}.panel-links{display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap}.head,.panel-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.head{margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.muted,.history p{color:var(--text-muted);font-size:.85rem}.state{padding:.45rem .7rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:.75rem;font-weight:700}.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-3);margin-bottom:var(--space-5)}.facts>div{display:grid;gap:.35rem;padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md)}.facts span,dt{color:var(--text-muted);font-size:.75rem}.facts strong,dd{font-size:.86rem}.grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0;font-size:1rem}table{width:100%;margin-top:var(--space-4);border-collapse:collapse}caption{text-align:start;color:var(--text-muted);font-size:.75rem;margin-bottom:.4rem}th,td{padding:.7rem .4rem;border-top:1px solid var(--color-border-subtle);text-align:start;font-size:.8rem}th{font-weight:700}.history{margin-top:var(--space-5)}.history p{line-height:1.6}dl{display:flex;gap:var(--space-6);margin:var(--space-5) 0 0}dd{margin:.3rem 0 0;font-weight:700}@media(max-width:760px){.facts{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}@media(max-width:500px){.head,.panel-head{display:grid}.facts{grid-template-columns:1fr}dl{display:grid}}</style>
