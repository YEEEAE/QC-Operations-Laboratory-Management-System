---
import AppLayout from '../../../ui/layouts/AppLayout.astro'; import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js';
const actor = Astro.locals.actor; if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const equipmentId = Astro.params.equipmentId ?? ''; const read = assetsReadDependencies(); let equipment; try { equipment = await read.equipment.get.execute({ actor, equipmentId }); } catch { return Astro.redirect('/404'); } if (!equipment) return Astro.redirect('/404');
let calibrations: readonly import('../../../modules/assets/calibration/domain/calibration.js').CalibrationRecord[] = [], maintenance: readonly import('../../../modules/assets/maintenance/domain/maintenance.js').MaintenanceRecord[] = []; try { [calibrations, maintenance] = await Promise.all([read.calibration.list.execute({ actor, filter: { equipmentId } }), read.maintenance.list.execute({ actor, filter: { equipmentId } })]); } catch { /* related history may be unavailable */ }
---
<AppLayout title={`${equipment.equipmentNo} · Assets`} locale="en" direction="ltr"><div class="crumb"><a href="/assets">Assets</a><span>/</span><a href="/assets/equipment">Equipment</a><span>/</span><span>{equipment.equipmentNo}</span></div><section class="head"><div><p class="eyebrow">UI-EQP-002 · T7 ASSET WORKSPACE</p><h1>{equipment.name}</h1><p>{equipment.equipmentNo} · Version {equipment.version.toString()}</p></div><span class="state">{equipment.state}</span></section><section class="facts" aria-label="Equipment identity"><div><span>Manufacturer</span><strong>{equipment.manufacturer ?? 'Not supplied'}</strong></div><div><span>Model</span><strong>{equipment.model ?? 'Not supplied'}</strong></div><div><span>Serial number</span><strong>{equipment.serialNo ?? 'Not supplied'}</strong></div><div><span>Location</span><strong>{equipment.location ?? 'Not supplied'}</strong></div></section><div class="grid"><section class="panel"><div class="panel-head"><h2>Calibration history</h2><a href={`/assets/calibrations?equipmentId=${equipment.id}`}>View all</a></div>{calibrations.length ? <table><caption>Authorized calibration records</caption><thead><tr><th scope="col">ID</th><th scope="col">State</th><th scope="col">Date</th><th scope="col">Due date</th></tr></thead><tbody>{calibrations.map((item)=><tr><th scope="row"><a href={`/assets/calibrations/${item.id}`}>{item.calibrationNo}</a></th><td>{item.state}</td><td>{item.calibrationDate.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})}</td><td>{item.dueDate?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'}) ?? 'Not supplied'}</td></tr>)}</tbody></table> : <p class="muted">No calibration records are available in your authorized scope.</p>}</section><section class="panel"><div class="panel-head"><h2>Maintenance history</h2><a href={`/assets/maintenance?equipmentId=${equipment.id}`}>View all</a></div>{maintenance.length ? <table><caption>Authorized maintenance records</caption><thead><tr><th scope="col">ID</th><th scope="col">State</th><th scope="col">Planned</th></tr></thead><tbody>{maintenance.map((item)=><tr><th scope="row"><a href={`/assets/maintenance/${item.id}`}>{item.maintenanceNo}</a></th><td>{item.state}</td><td>{item.plannedAt?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'}) ?? 'Not scheduled'}</td></tr>)}</tbody></table> : <p class="muted">No maintenance records are available in your authorized scope.</p>}</section></div><section class="panel history"><h2>Historical context</h2><p>Equipment identity can change only through the controlled workflow. Existing Laboratory snapshots remain unchanged and continue to represent the equipment context at execution time.</p><dl><div><dt>Created by</dt><dd>{equipment.createdBy}</dd></div><div><dt>Updated</dt><dd>{equipment.updatedAt.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})}</dd></div></dl></section></AppLayout>
<style>.crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,.panel-head a{color:var(--color-accent-primary-hover)}.head,.panel-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.head{margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.muted,.history p{color:var(--text-muted);font-size:.85rem}.state{padding:.45rem .7rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:.75rem;font-weight:700}.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-3);margin-bottom:var(--space-5)}.facts>div{display:grid;gap:.35rem;padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md)}.facts span,dt{color:var(--text-muted);font-size:.75rem}.facts strong,dd{font-size:.86rem}.grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0;font-size:1rem}table{width:100%;margin-top:var(--space-4);border-collapse:collapse}caption{text-align:start;color:var(--text-muted);font-size:.75rem;margin-bottom:.4rem}th,td{padding:.7rem .4rem;border-top:1px solid var(--color-border-subtle);text-align:start;font-size:.8rem}th{font-weight:700}.history{margin-top:var(--space-5)}.history p{line-height:1.6}dl{display:flex;gap:var(--space-6);margin:var(--space-5) 0 0}dd{margin:.3rem 0 0;font-weight:700}@media(max-width:760px){.facts{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}@media(max-width:500px){.head,.panel-head{display:grid}.facts{grid-template-columns:1fr}dl{display:grid}}
</style>
