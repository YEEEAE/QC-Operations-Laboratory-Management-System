---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import AppliedFilters from '../../../ui/components/data/AppliedFilters.astro';
import EmptyTableState from '../../../ui/components/data/EmptyTableState.astro';
import FilterBar from '../../../ui/components/data/FilterBar.astro';
import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fassets%2Fequipment');
const states = [
  'DRAFT',
  'ACTIVE',
  'OUT_OF_SERVICE',
  'UNDER_MAINTENANCE',
  'DECOMMISSIONED',
] as const;
const params = Astro.url.searchParams;
const requested = params.get('state');
const state = states.find((value) => value === requested);
const search = params.get('q')?.slice(0, 200) || undefined;
let equipment: readonly import('../../../modules/assets/equipment/domain/equipment.js').Equipment[] =
  [];
let providerUnavailable = false;
try {
  equipment = await assetsReadDependencies().equipment.list.execute({
    actor,
    filter: { state, search },
  });
} catch {
  providerUnavailable = true;
}
/** One link per filter that drops only that filter and keeps the rest. */
const chipHref = (drop: string) => {
  const next = new URLSearchParams(params);
  next.delete(drop);
  const query = next.toString();
  return `/assets/equipment${query ? `?${query}` : ''}`;
};
const appliedFilters = [
  state && { label: 'Operational state', value: stateLabel(state), href: chipHref('state') },
  search && { label: 'Search', value: search, href: chipHref('q') },
].filter((chip): chip is { label: string; value: string; href: string } => Boolean(chip));
const hasFilters = appliedFilters.length > 0;
---

<AppLayout title="Equipment · Assets" locale="en" direction="ltr">
  <section class="head">
    <div>
      <p class="eyebrow">Equipment</p>
      <h1>Equipment</h1>
      <p>Stable equipment identity and its current operational state.</p>
    </div>
    <a class="button" href="/assets/equipment/new">Add equipment</a>
  </section>
  <FilterBar clearHref={hasFilters ? '/assets/equipment' : undefined}>
    <label for="q">Search<input id="q" name="q" value={search ?? ''} maxlength="200" /></label>
    <label for="state">Operational state<select id="state" name="state">
        <option value="">All states</option>
        {
          states.map((value) => (
            <option value={value} selected={state === value}>
              {stateLabel(value)}
            </option>
          ))
        }
      </select></label>
  </FilterBar>
  <AppliedFilters
    filters={appliedFilters}
    clearHref={hasFilters ? '/assets/equipment' : undefined}
    note="Showing every equipment record in your authorized scope."
  />
  {
    providerUnavailable ? (
      <ProviderUnavailableState
        title="Equipment data is temporarily unavailable"
        description="The equipment read provider did not return a confirmed result, so the register is not treated as empty."
        retryHref="/assets/equipment"
      />
    ) : equipment.length ? (
      <div class="table-wrap">
        <table>
          <caption>
            {equipment.length} authorized equipment record{equipment.length === 1 ? '' : 's'}
            {hasFilters ? ' matching the current filters' : ''}
          </caption>
          <thead>
            <tr>
              <th scope="col">Equipment number</th>
              <th scope="col">Name</th>
              <th scope="col">Model / serial</th>
              <th scope="col">Operational state</th>
              <th scope="col">Location</th>
              <th scope="col">Version</th>
            </tr>
          </thead>
          <tbody>
            {equipment.map((item) => (
              <tr>
                <th scope="row">
                  <a href={`/assets/equipment/${item.id}`}>{item.equipmentNo}</a>
                </th>
                <td>{item.name}</td>
                <td>{[item.model, item.serialNo].filter(Boolean).join(' · ') || 'Not supplied'}</td>
                <td>
                  <span class="state">{stateLabel(item.state)}</span>
                </td>
                <td>{item.location ?? 'Not supplied'}</td>
                <td>{item.version.toString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : hasFilters ? (
      <EmptyTableState
        title="No equipment matches these filters"
        description="Nothing in your authorized scope matches the selected filters."
        clearHref="/assets/equipment"
      />
    ) : (
      <EmptyTableState
        title="No equipment yet"
        description="No equipment record exists in your authorized scope. Create the first draft to start the asset register."
        actionLabel="Create equipment"
        actionHref="/assets/equipment/new"
      />
    )
  }
</AppLayout>
<style>
  .head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:var(--font-size-xs);letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow){color:var(--text-muted);font-size:var(--font-size-sm)}.button{display:inline-flex;align-items:center;justify-content:center;min-height:var(--control-height);padding-inline:1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:var(--color-text-inverse);text-decoration:none;font-weight:var(--font-weight-bold)}.table-wrap{overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:850px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted);font-size:var(--font-size-xs)}th,td{padding:.85rem;border-top:1px solid var(--color-border-subtle);text-align:start;font-size:var(--font-size-sm)}th{font-weight:var(--font-weight-semibold)}a{color:var(--color-accent-primary-hover)}.state{display:inline-flex;padding:.28rem .5rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:var(--font-size-xs);font-weight:var(--font-weight-semibold)}@media(max-width:650px){.head{display:grid}.button{width:max-content}}</style>
