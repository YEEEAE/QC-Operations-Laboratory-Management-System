---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fassets%2Fequipment');
const states = ['DRAFT','ACTIVE','OUT_OF_SERVICE','UNDER_MAINTENANCE','DECOMMISSIONED'] as const;
const requested = Astro.url.searchParams.get('state'); const state = states.find((value) => value === requested); const search = Astro.url.searchParams.get('q')?.slice(0, 200) || undefined;
let equipment: readonly import('../../../modules/assets/equipment/domain/equipment.js').Equipment[] = []; try { equipment = await assetsReadDependencies().equipment.list.execute({ actor, filter: { state, search } }); } catch { /* safe empty state */ }
---
<AppLayout title="Equipment · Assets" locale="en" direction="ltr"><section class="head"><div><p class="eyebrow">UI-EQP-001 · T2 LIST</p><h1>Equipment</h1><p>Stable equipment identity and explicit operational state.</p></div><a class="button" href="/assets/equipment/new">Add equipment</a></section><form class="filters" method="get"><label for="q">Search<input id="q" name="q" value={search ?? ''} maxlength="200" /></label><label for="state">Operational state<select id="state" name="state"><option value="">All states</option>{states.map((value) => <option value={value} selected={state === value}>{value}</option>)}</select></label><button class="button secondary" type="submit">Filter</button></form>{equipment.length ? <div class="table-wrap"><table><caption>{equipment.length} authorized equipment record{equipment.length === 1 ? '' : 's'}</caption><thead><tr><th scope="col">Equipment ID</th><th scope="col">Name</th><th scope="col">Model / serial</th><th scope="col">Operational state</th><th scope="col">Location</th><th scope="col">Version</th></tr></thead><tbody>{equipment.map((item) => <tr><th scope="row"><a href={`/assets/equipment/${item.id}`}>{item.equipmentNo}</a></th><td>{item.name}</td><td>{[item.model, item.serialNo].filter(Boolean).join(' · ') || 'Not supplied'}</td><td><span class="state">{item.state}</span></td><td>{item.location ?? 'Not supplied'}</td><td>{item.version.toString()}</td></tr>)}</tbody></table></div> : <section class="empty"><h2>No equipment in this view</h2><p>There are no authorized records matching the selected filters.</p><a href="/assets/equipment/new">Create a draft equipment record</a></section>}</AppLayout>
<style>.head,.filters{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-end}.head{align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.empty p{color:var(--text-muted);font-size:.85rem}.button{display:inline-flex;align-items:center;min-height:var(--control-height);padding-inline:1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;text-decoration:none;font-weight:700}.secondary{background:var(--surface-raised);border-color:var(--border-default);color:var(--text-primary)}.filters{justify-content:flex-start;margin-bottom:var(--space-5)}label{display:grid;gap:.35rem;color:var(--text-secondary);font-size:.8rem}input,select{min-height:var(--control-height);padding:.55rem .7rem;background:var(--surface-panel);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.table-wrap{overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:850px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted);font-size:.8rem}th,td{padding:.85rem;border-top:1px solid var(--color-border-subtle);text-align:start;font-size:.82rem}th{font-weight:700}a{color:var(--color-accent-primary-hover)}.state{display:inline-flex;padding:.28rem .5rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:.7rem;font-weight:700}.empty{margin-top:var(--space-5);padding:var(--space-8);text-align:center;background:var(--surface-panel);border:1px dashed var(--color-border-strong);border-radius:var(--radius-lg)}.empty h2{margin:0 0 .5rem;font-size:1.1rem}.empty a{font-weight:700}@media(max-width:650px){.head,.filters{display:grid}.button{width:max-content}}
</style>
