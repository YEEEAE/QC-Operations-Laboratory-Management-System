---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import FormErrorSummary from '../../../ui/components/FormErrorSummary.astro';
import { actions } from 'astro:actions';
import {
  detailHref,
  extractDetailId,
  field,
  optionalField,
  toFormFailure,
  type FormFailure,
} from '../../../ui/forms/mutation-post.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fassets%2Fequipment%2Fnew');
const canCreate = actor.permissions.some((permission) => permission.code === 'PERM-EQP-CREATE');

const LIST_HREF = '/assets/equipment';
const REQUIRED_FIELDS = [
  { name: 'equipmentNo', label: 'Equipment ID' },
  { name: 'name', label: 'Name' },
] as const;

let values = { equipmentNo: '', name: '', manufacturer: '', model: '', serialNo: '', location: '' };
let failure: FormFailure | null = null;

// POST baseline (F-05): without JavaScript the form performs a real POST to
// this page. The same Astro Action — with the same server-side
// reauthorization — runs via Astro.callAction. No business payload enters
// the URL: input travels in the POST body, success redirects (303) to the
// new record only.
if (Astro.request.method === 'POST' && canCreate) {
  const formData = await Astro.request.formData();
  values = {
    equipmentNo: field(formData, 'equipmentNo'),
    name: field(formData, 'name'),
    manufacturer: field(formData, 'manufacturer'),
    model: field(formData, 'model'),
    serialNo: field(formData, 'serialNo'),
    location: field(formData, 'location'),
  };
  try {
    const data = await Astro.callAction(actions.assets.createEquipment, {
      equipmentNo: values.equipmentNo,
      name: values.name,
      manufacturer: optionalField(formData, 'manufacturer'),
      model: optionalField(formData, 'model'),
      serialNo: optionalField(formData, 'serialNo'),
      location: optionalField(formData, 'location'),
    });
    const id = extractDetailId(data);
    if (id) return Astro.redirect(detailHref(LIST_HREF, id), 303);
    failure = {
      kind: 'unknown',
      summary: 'The equipment record was received but no record reference came back.',
      recovery: 'Check the equipment register before trying again to avoid a duplicate.',
      fieldErrors: {},
      firstInvalidField: null,
    };
  } catch (error) {
    failure = toFormFailure(error, {
      entity: 'Equipment record',
      requiredFields: REQUIRED_FIELDS,
      values,
      listHref: LIST_HREF,
      listLabel: 'equipment',
    });
  }
}

const describedBy = (name: keyof typeof values): string | undefined =>
  failure?.fieldErrors[name] ? `${name}-error` : undefined;
const invalid = (name: keyof typeof values): 'true' | undefined =>
  failure?.fieldErrors[name] ? 'true' : undefined;
---
<AppLayout title="New equipment · Assets" locale="en" direction="ltr"><section class="head"><div><p class="eyebrow">T3 CONTROLLED MASTER DATA</p><h1>New equipment</h1><p>The server creates a DRAFT. Activation requirements remain policy-controlled.</p></div><a href="/assets/equipment">Back to equipment</a></section>{canCreate ? <form class="form" method="post" data-action="assets.createEquipment">{failure && <FormErrorSummary summary={failure.summary} recovery={failure.recovery} errors={Object.entries(failure.fieldErrors).map(([fieldId, message]) => ({ fieldId, message }))} listHref={LIST_HREF} listLabel="equipment" />}<fieldset><legend>Equipment identity</legend><div class="fields"><div><label for="equipmentNo">Equipment ID<span class="hint" id="equipmentNo-help">Use the equipment number from your approved source. The technical record identifier is generated server-side.</span><input id="equipmentNo" name="equipmentNo" required value={values.equipmentNo} aria-invalid={invalid('equipmentNo')} aria-describedby={failure?.fieldErrors.equipmentNo ? 'equipmentNo-error equipmentNo-help' : 'equipmentNo-help'} /></label>{failure?.fieldErrors.equipmentNo && <p class="field-error" id="equipmentNo-error">{failure.fieldErrors.equipmentNo}</p>}</div><div><label for="name">Name<input id="name" name="name" required value={values.name} aria-invalid={invalid('name')} aria-describedby={describedBy('name')} /></label>{failure?.fieldErrors.name && <p class="field-error" id="name-error">{failure.fieldErrors.name}</p>}</div><div><label for="manufacturer">Manufacturer<input id="manufacturer" name="manufacturer" value={values.manufacturer} /></label></div><div><label for="model">Model<input id="model" name="model" value={values.model} /></label></div><div><label for="serialNo">Serial number<input id="serialNo" name="serialNo" value={values.serialNo} /></label></div><div><label for="location">Location<input id="location" name="location" value={values.location} /></label></div></div></fieldset><div class="actions"><a class="secondary" href="/assets/equipment">Cancel</a><button type="submit" data-submit>Create draft</button></div><p role="status" data-result></p></form> : <section class="denied" role="alert"><h2>Creation is not available</h2><p>Your account does not have the explicit Equipment create permission.</p></section>}</AppLayout>
<script>
import { actions } from 'astro:actions'; const form=document.querySelector<HTMLFormElement>('[data-action="assets.createEquipment"]'); form?.addEventListener('submit',async(event)=>{event.preventDefault();const data=new FormData(form);const submit=form.querySelector<HTMLButtonElement>('[data-submit]');const output=form.querySelector<HTMLElement>('[data-result]');if(submit)submit.disabled=true;form.setAttribute('aria-busy','true');if(output)output.textContent='Saving…';try{const result=await actions.assets.createEquipment({equipmentNo:String(data.get('equipmentNo')),name:String(data.get('name')),manufacturer:String(data.get('manufacturer')||'')||undefined,model:String(data.get('model')||'')||undefined,serialNo:String(data.get('serialNo')||'')||undefined,location:String(data.get('location')||'')||undefined});if(result.data&&typeof result.data.id==='string'){window.location.href=`/assets/equipment/${result.data.id}`;return;}if(output)output.textContent='Unable to create this equipment. Review the fields and try again.';const firstInvalid=form.querySelector<HTMLElement>('input:invalid');(firstInvalid??output)?.focus?.();}catch{if(output)output.textContent='The service is temporarily unavailable. Your entries are kept — try again.';}finally{if(submit)submit.disabled=false;form.removeAttribute('aria-busy');}});</script>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.denied p{color:var(--text-muted);font-size:.85rem}.head a{color:var(--color-accent-primary-hover)}.hint{color:var(--text-muted);font-size:.78rem}.form{max-width:900px;display:grid;gap:var(--space-5)}fieldset{padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}legend{padding-inline:.5rem;font-weight:700}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}input{min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}input[aria-invalid="true"]{border-color:var(--status-danger)}.field-error{margin:.25rem 0 0;color:var(--status-danger);font-size:.8rem}.actions{display:flex;justify-content:flex-end;gap:var(--space-3)}button,.secondary{min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.secondary{border-color:var(--border-default);background:var(--surface-raised);color:var(--text-primary);text-decoration:none}button[disabled]{opacity:.6}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}@media(max-width:650px){.head{display:grid}.fields{grid-template-columns:1fr}.actions{justify-content:stretch;display:grid}}
</style>
