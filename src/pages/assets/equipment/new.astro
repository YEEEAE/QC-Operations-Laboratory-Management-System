---
import PageHeader from "../../../ui/components/PageHeader.astro";
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import FormErrorSummary from '../../../ui/components/FormErrorSummary.astro';
import { actions } from 'astro:actions';
import {
  detailHref,
  extractDetailId,
  field,
  optionalField,
  toFormFailure,
  type FormFailure,
} from '../../../ui/forms/mutation-post.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fassets%2Fequipment%2Fnew');
const canCreate = actor.permissions.some((permission) => permission.code === 'PERM-EQP-CREATE');

const LIST_HREF = '/assets/equipment';
const REQUIRED_FIELDS = [
  { name: 'equipmentNo', label: 'Equipment number' },
  { name: 'name', label: 'Name' },
] as const;

let values = { equipmentNo: '', name: '', manufacturer: '', model: '', serialNo: '', location: '', calibrationRequired: false, maintenanceRequired: false };
let failure: FormFailure | null = null;

// POST baseline (F-05): without JavaScript the form performs a real POST to
// this page. The same Astro Action — with the same server-side
// reauthorization — runs via Astro.callAction. No business payload enters
// the URL: input travels in the POST body, success redirects (303) to the
// new record only.
if (Astro.request.method === 'POST' && canCreate) {
  const formData = await Astro.request.formData();
  values = {
    equipmentNo: field(formData, 'equipmentNo'),
    name: field(formData, 'name'),
    manufacturer: field(formData, 'manufacturer'),
    model: field(formData, 'model'),
    serialNo: field(formData, 'serialNo'),
    location: field(formData, 'location'),
    calibrationRequired: formData.has('calibrationRequired'),
    maintenanceRequired: formData.has('maintenanceRequired'),
  };
  try {
    const data = await Astro.callAction(actions.assets.createEquipment, {
      equipmentNo: values.equipmentNo,
      name: values.name,
      manufacturer: optionalField(formData, 'manufacturer'),
      model: optionalField(formData, 'model'),
      serialNo: optionalField(formData, 'serialNo'),
      location: optionalField(formData, 'location'),
      calibrationRequired: values.calibrationRequired,
      maintenanceRequired: values.maintenanceRequired,
    });
    const id = extractDetailId(data);
    if (id) return Astro.redirect(detailHref(LIST_HREF, id), 303);
    failure = {
      kind: 'unknown',
      summary: 'The equipment record creation result could not be confirmed.',
      recovery: 'Check the equipment register before trying again to avoid a duplicate.',
      fieldErrors: {},
      firstInvalidField: null,
    };
  } catch (error) {
    failure = toFormFailure(error, {
      entity: 'Equipment record',
      requiredFields: REQUIRED_FIELDS,
      values: {
        ...values,
        calibrationRequired: String(values.calibrationRequired),
        maintenanceRequired: String(values.maintenanceRequired),
      },
      listHref: LIST_HREF,
      listLabel: 'equipment',
    });
  }
}

const describedBy = (name: keyof typeof values): string | undefined =>
  failure?.fieldErrors[name] ? `${name}-error` : undefined;
const invalid = (name: keyof typeof values): 'true' | undefined =>
  failure?.fieldErrors[name] ? 'true' : undefined;
---
<AppLayout title="New equipment · Assets" locale="en" direction="ltr">
  <PageHeader>
    <Fragment slot="heading"><h1>New equipment</h1></Fragment>
    <p>Create an equipment draft. Activation follows the approved policy.</p>
    <Fragment slot="actions"><a href="/assets/equipment">Back to equipment</a></Fragment>
  </PageHeader>
  {canCreate ? (
    <form class="form" method="post" data-action="assets.createEquipment">
      {failure && (
        <FormErrorSummary
          summary={failure.summary}
          recovery={failure.recovery}
          errors={Object.entries(failure.fieldErrors).map(([fieldId, message]) => ({ fieldId, message }))}
          listHref={LIST_HREF}
          listLabel="equipment"
        />
      )}
      <section class="source-records" aria-labelledby="source-records-title">
        <div class="source-records-heading">
          <h2 id="source-records-title">Eligibility and source records</h2>
          <a href={LIST_HREF}>View equipment records and history</a>
        </div>
        <p class="source-intro">This new draft has no linked calibration or maintenance records yet. The source-based assessment and history are available from its equipment record after creation.</p>
        <dl class="source-states">
          <div><dt>Equipment eligibility</dt><dd>Not assessed — no equipment record exists yet.</dd></div>
          <div><dt>Calibration status and history</dt><dd>Not available — no calibration record is linked to this draft.</dd></div>
          <div><dt>Maintenance status and history</dt><dd>Not available — no maintenance record is linked to this draft.</dd></div>
        </dl>
      </section>
      <fieldset>
        <legend>Equipment identity</legend>
        <div class="fields">
          <div class="field">
            <label for="equipmentNo">Equipment number
              <span class="hint" id="equipmentNo-help">Use the equipment number from your approved source. Reference numbers are assigned automatically.</span>
              <input id="equipmentNo" name="equipmentNo" required value={values.equipmentNo} aria-invalid={invalid('equipmentNo')} aria-describedby={failure?.fieldErrors.equipmentNo ? 'equipmentNo-error equipmentNo-help' : 'equipmentNo-help'} />
            </label>
            {failure?.fieldErrors.equipmentNo && <p class="field-error" id="equipmentNo-error">{failure.fieldErrors.equipmentNo}</p>}
          </div>
          <div class="field">
            <label for="name">Name
              <span class="hint" id="name-help">Enter the equipment name used by your source records.</span>
              <input id="name" name="name" required value={values.name} aria-invalid={invalid('name')} aria-describedby={failure?.fieldErrors.name ? 'name-error name-help' : 'name-help'} />
            </label>
            {failure?.fieldErrors.name && <p class="field-error" id="name-error">{failure.fieldErrors.name}</p>}
          </div>
          <div class="field">
            <label for="manufacturer">Manufacturer
              <span class="hint" id="manufacturer-help">Optional. Use the value recorded by the source.</span>
              <input id="manufacturer" name="manufacturer" value={values.manufacturer} aria-describedby="manufacturer-help" />
            </label>
          </div>
          <div class="field">
            <label for="model">Model
              <span class="hint" id="model-help">Optional. Use the model recorded by the source.</span>
              <input id="model" name="model" value={values.model} aria-describedby="model-help" />
            </label>
          </div>
          <div class="field">
            <label for="serialNo">Serial number
              <span class="hint" id="serialNo-help">Optional. Enter the serial number shown on the equipment source record.</span>
              <input id="serialNo" name="serialNo" value={values.serialNo} aria-describedby="serialNo-help" />
            </label>
          </div>
          <div class="field">
            <label for="location">Location
              <span class="hint" id="location-help">Optional. Enter the location recorded by the source.</span>
              <input id="location" name="location" value={values.location} aria-describedby="location-help" />
            </label>
          </div>
          <label class="check"><input type="checkbox" name="calibrationRequired" value="true" checked={values.calibrationRequired} />Calibration required</label>
          <label class="check"><input type="checkbox" name="maintenanceRequired" value="true" checked={values.maintenanceRequired} />Maintenance required</label>
        </div>
      </fieldset>
      <div class="actions">
        <a class="secondary" href={LIST_HREF}>Cancel</a>
        <button type="submit" data-submit>Create draft</button>
      </div>
      <p class="result-status" role="status" data-result></p>
    </form>
  ) : (
    <section class="denied" role="alert"><h2>Creation is not available</h2><p>Your account does not have the explicit Equipment create permission.</p></section>
  )}
</AppLayout>
<script>
import { actions } from 'astro:actions';
import { enhanceClassifiedForm } from '../../../ui/forms/enhance-with-classification';
import { guardUnsavedChanges } from '../../../ui/forms/unsaved-changes';
const form=document.querySelector<HTMLFormElement>('[data-action="assets.createEquipment"]');
if(form){enhanceClassifiedForm(form,{
  invoke:(payload)=>actions.assets.createEquipment(payload as Parameters<typeof actions.assets.createEquipment>[0]),
  payload:(data)=>({equipmentNo:String(data.get('equipmentNo')),name:String(data.get('name')),manufacturer:String(data.get('manufacturer')||'')||undefined,model:String(data.get('model')||'')||undefined,serialNo:String(data.get('serialNo')||'')||undefined,location:String(data.get('location')||'')||undefined,calibrationRequired:data.has('calibrationRequired'),maintenanceRequired:data.has('maintenanceRequired')}),
  progressText:'Saving equipment draft…',
  detailBaseHref:'/assets/equipment',
});guardUnsavedChanges(form);}</script>
<style>
  .form{max-inline-size:56rem;display:grid;gap:var(--space-5);min-inline-size:0}
  .source-records,fieldset{padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel);min-inline-size:0}
  .source-records-heading{display:flex;justify-content:space-between;align-items:start;gap:var(--space-4);flex-wrap:wrap}
  .source-records h2{margin:0;font-size:1.125rem;line-height:1.35}
  .source-records a{min-block-size:44px;display:inline-flex;align-items:center;color:var(--color-accent-primary-hover)}
  .source-intro{max-inline-size:70ch;color:var(--text-secondary);font-size:.875rem;line-height:1.55}
  .source-states{display:grid;gap:var(--space-3);margin:var(--space-4) 0 0}
  .source-states div{padding:var(--space-3);border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm);background:var(--surface-raised);min-inline-size:0}
  .source-states dt{font-weight:700;font-size:.875rem}
  .source-states dd{margin:.25rem 0 0;color:var(--text-secondary);font-size:.875rem;line-height:1.5;overflow-wrap:anywhere}
  fieldset{padding-block-start:var(--space-4)}
  legend{padding-inline:.5rem;font-weight:700}
  .fields{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-4)}
  .field{min-inline-size:0}
  label{display:grid;gap:.45rem;color:var(--text-secondary);font-size:.875rem;line-height:1.4;min-inline-size:0}
  .hint{color:var(--text-muted);font-size:.75rem;line-height:1.45}
  input{inline-size:100%;min-block-size:max(var(--control-height),44px);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:var(--text-primary);font:inherit;min-inline-size:0}
  input[type="checkbox"]{inline-size:1.25rem;block-size:1.25rem;min-block-size:1.25rem;accent-color:var(--color-accent-primary)}
  .check{min-block-size:44px;display:flex;align-items:center;gap:.7rem;padding:.5rem 0}
  input[aria-invalid="true"]{border-color:var(--status-danger)}
  .field-error{margin:.3rem 0 0;color:var(--status-danger);font-size:.8125rem;line-height:1.45}
  .actions{display:flex;justify-content:flex-end;gap:var(--space-3);flex-wrap:wrap}
  button,.secondary{min-block-size:44px;padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:var(--text-on-accent);font:inherit;font-weight:700;display:inline-flex;align-items:center;justify-content:center}
  .secondary{border-color:var(--border-default);background:var(--surface-raised);color:var(--text-primary);text-decoration:none}
  button[disabled]{opacity:.6}
  .result-status:empty{display:none}
  .result-status{margin:0;color:var(--text-primary);font-size:.875rem;line-height:1.5;overflow-wrap:anywhere}
  .denied{max-inline-size:56rem;padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}
  .denied p{color:var(--text-secondary);font-size:.875rem;line-height:1.5}
  :where(a,button,input):focus-visible{outline:2px solid var(--color-accent-primary);outline-offset:2px}
  @media(min-width:60rem){.fields{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:30rem){.source-records,fieldset{padding:var(--space-4)}.actions{display:grid;grid-template-columns:1fr}.actions>*{inline-size:100%}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
  @media(forced-colors:active){.source-records,fieldset,.source-states div,input,button,.secondary{border:1px solid CanvasText}.source-states div{background:Canvas;color:CanvasText}button{forced-color-adjust:auto}}
</style>
