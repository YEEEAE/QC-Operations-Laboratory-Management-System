---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fassets%2Fequipment%2Fnew');
const canCreate = actor.permissions.some((permission) => permission.code === 'PERM-EQP-CREATE');
---
<AppLayout title="New Equipment · Assets" locale="en" direction="ltr"><section class="head"><div><p class="eyebrow">T3 CONTROLLED MASTER DATA</p><h1>New equipment</h1><p>The server creates a DRAFT. Activation requirements remain policy-controlled.</p></div><a href="/assets/equipment">Back to equipment</a></section>{canCreate ? <form class="form" data-action="assets.createEquipment"><fieldset><legend>Equipment identity</legend><div class="fields"><label>Equipment ID<input name="equipmentNo" required /></label><label>Name<input name="name" required /></label><label>Manufacturer<input name="manufacturer" /></label><label>Model<input name="model" /></label><label>Serial number<input name="serialNo" /></label><label>Location<input name="location" /></label></div></fieldset><div class="actions"><a class="secondary" href="/assets/equipment">Cancel</a><button type="submit">Create draft</button></div></form> : <section class="denied" role="alert"><h2>Creation is not available</h2><p>Your account does not have the explicit Equipment create permission.</p></section>}</AppLayout>
<script>
// @ts-expect-error Astro generates the action client module during the build.
import { actions } from 'astro:actions'; const form=document.querySelector<HTMLFormElement>('[data-action="assets.createEquipment"]'); form?.addEventListener('submit',async(event)=>{event.preventDefault();const data=new FormData(form);const result=await actions.assets.createEquipment({equipmentNo:String(data.get('equipmentNo')),name:String(data.get('name')),manufacturer:String(data.get('manufacturer')||'')||undefined,model:String(data.get('model')||'')||undefined,serialNo:String(data.get('serialNo')||'')||undefined,location:String(data.get('location')||'')||undefined});if(result.data)window.location.href=`/assets/equipment/${result.data.id}`;else form.setAttribute('aria-invalid','true');});</script>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.denied p{color:var(--text-muted);font-size:.85rem}.head a{color:var(--color-accent-primary-hover)}.form{max-width:900px;display:grid;gap:var(--space-5)}fieldset{padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}legend{padding-inline:.5rem;font-weight:700}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}input{min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.actions{display:flex;justify-content:flex-end;gap:var(--space-3)}button,.secondary{min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.secondary{border-color:var(--border-default);background:var(--surface-raised);color:var(--text-primary);text-decoration:none}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}@media(max-width:650px){.head{display:grid}.fields{grid-template-columns:1fr}.actions{justify-content:stretch;display:grid}}
</style>
