---
import PageHeader from "../../ui/components/PageHeader.astro";
import AppLayout from '../../ui/layouts/AppLayout.astro';
import ProviderUnavailableState from '../../ui/components/feedback/ProviderUnavailableState.astro';
import { assetsReadDependencies } from '../../modules/assets/application/dependencies.js';
import { describeActorScope } from '../../shared/authorization/scope-description.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fassets');
let equipment: readonly import('../../modules/assets/equipment/domain/equipment.js').Equipment[] = [];
let calibrations: readonly import('../../modules/assets/calibration/domain/calibration.js').CalibrationRecord[] = [];
let maintenance: readonly import('../../modules/assets/maintenance/domain/maintenance.js').MaintenanceRecord[] = [];
let providerUnavailable = false;
// P2-6: the scope row is derived from the authenticated actor, not a placeholder.
const scopeLabel = describeActorScope(actor);
try { const read = assetsReadDependencies(); [equipment, calibrations, maintenance] = await Promise.all([read.equipment.list.execute({ actor }), read.calibration.list.execute({ actor }), read.maintenance.list.execute({ actor })]); } catch { providerUnavailable = true; }
---
<AppLayout title="Assets · QC Operations" locale="en" direction="ltr">
  <PageHeader><Fragment slot="heading"><h1>Assets</h1></Fragment><p>Equipment identity, calibration history, and maintenance work in one authorized workspace.</p><Fragment slot="actions"><span class="scope">{scopeLabel}</span></Fragment></PageHeader>
  {providerUnavailable ? <ProviderUnavailableState title="Asset data is unavailable" description="Asset data could not be loaded. Counts are not shown." /> : <section class="workspaces" aria-label="Asset workspaces"><a class="workspace workspace--next" href="/assets/equipment"><span>Equipment register</span><strong>{equipment.length}</strong><small>Identity, operational state, and controlled context</small></a><a class="workspace" href="/assets/calibrations"><span>Calibration records</span><strong>{calibrations.length}</strong><small>History and source-provided dates</small></a><a class="workspace" href="/assets/maintenance"><span>Maintenance</span><strong>{maintenance.length}</strong><small>Planned and completed work history</small></a></section>}
  <section class="note"><strong>Control boundary</strong><p>Asset master changes do not rewrite historical Laboratory snapshots. PASS, calibration status, and release are separate controlled facts.</p></section>
</AppLayout>
<style>
  .scope{display:inline-flex;align-items:center;min-block-size:44px;padding-inline:var(--space-3);border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm);color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.4;overflow-wrap:anywhere}
  .workspaces{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4);align-items:stretch}
  .workspace{position:relative;display:grid;grid-template-rows:auto auto 1fr;align-content:start;gap:var(--space-3);min-inline-size:0;min-block-size:184px;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-default);border-radius:var(--radius-lg);color:var(--text-primary);text-decoration:none;box-shadow:var(--shadow-1);transition:border-color var(--motion-fast) ease,background-color var(--motion-fast) ease,transform var(--motion-fast) ease}
  .workspace--next{border-inline-start:3px solid var(--color-accent-primary);background:linear-gradient(115deg,var(--color-surface-selected),var(--surface-panel) 58%)}
  .workspace span{font-size:var(--font-size-md);font-weight:var(--font-weight-semibold);line-height:1.4;overflow-wrap:anywhere}
  .workspace strong{font-size:2.25rem;line-height:1;font-variant-numeric:var(--numeric-figures);color:var(--color-accent-primary)}
  .workspace small{align-self:end;color:var(--text-muted);font-size:var(--font-size-sm);line-height:1.5;overflow-wrap:anywhere}
  .workspace:hover{border-color:var(--color-accent-primary);background-color:var(--color-surface-hover)}
  .workspace--next:hover{background:linear-gradient(115deg,var(--color-surface-selected),var(--color-surface-hover) 68%)}
  .workspace:focus-visible{outline:2px solid var(--focus-ring);outline-offset:3px;border-color:var(--color-accent-primary)}
  .workspace:active{transform:translateY(1px);background:var(--color-surface-active)}
  .note{max-inline-size:760px;margin-block-start:var(--space-6);padding:var(--space-5);border-inline-start:3px solid var(--status-warning);border-radius:0 var(--radius-sm) var(--radius-sm) 0;background:var(--surface-panel)}
  .note strong{font-size:var(--font-size-md)}
  .note p{margin:var(--space-2) 0 0;color:var(--text-secondary);font-size:var(--font-size-sm);line-height:1.55;overflow-wrap:anywhere}
  @media(max-width:900px){.workspaces{grid-template-columns:repeat(2,minmax(0,1fr))}.workspace--next{grid-column:1/-1;min-block-size:160px}}
  @media(max-width:560px){.workspaces{grid-template-columns:minmax(0,1fr)}.workspace--next{grid-column:auto}.workspace{min-block-size:156px;padding:var(--space-4)}}
  @media(prefers-reduced-motion:reduce){.workspace{transition:none}.workspace:hover,.workspace:active{transform:none}}
  @media(forced-colors:active){.workspace,.workspace--next{border:1px solid CanvasText;background:Canvas;box-shadow:none;color:CanvasText}.workspace--next{border-inline-start:3px solid Highlight}.workspace strong{color:LinkText}.workspace:focus-visible{outline-color:Highlight}.note{border-color:CanvasText;background:Canvas;color:CanvasText}.note p,.workspace small{color:CanvasText}}
</style>
