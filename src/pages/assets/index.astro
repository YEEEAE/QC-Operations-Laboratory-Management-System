---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import { assetsReadDependencies } from '../../modules/assets/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fassets');
let equipment: readonly import('../../modules/assets/equipment/domain/equipment.js').Equipment[] = [];
let calibrations: readonly import('../../modules/assets/calibration/domain/calibration.js').CalibrationRecord[] = [];
let maintenance: readonly import('../../modules/assets/maintenance/domain/maintenance.js').MaintenanceRecord[] = [];
try { const read = assetsReadDependencies(); [equipment, calibrations, maintenance] = await Promise.all([read.equipment.list.execute({ actor }), read.calibration.list.execute({ actor }), read.maintenance.list.execute({ actor })]); } catch { /* render a safe unavailable state */ }
---
<AppLayout title="Assets · QC Operations" locale="en" direction="ltr">
  <section class="hero"><div><p class="eyebrow">T7 ASSET CONTROL ROOM</p><h1>Assets</h1><p>Equipment identity, calibration history, and maintenance work in one authorized workspace.</p></div><span class="scope">Authorized scope</span></section>
  <section class="cards" aria-label="Asset workspaces"><a href="/assets/equipment"><span>Equipment register</span><strong>{equipment.length}</strong><small>Identity, operational state, and controlled context</small></a><a href="/assets/calibrations"><span>Calibration records</span><strong>{calibrations.length}</strong><small>Historical records; no invented intervals</small></a><a href="/assets/maintenance"><span>Maintenance</span><strong>{maintenance.length}</strong><small>Planned and completed work history</small></a></section>
  <section class="note"><strong>Control boundary</strong><p>Asset master changes do not rewrite historical Laboratory snapshots. PASS, calibration status, and release are separate controlled facts.</p></section>
</AppLayout>
<style>.hero{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-7)}h1{margin:.25rem 0 .4rem;font-size:clamp(2rem,5vw,3.2rem)}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.13em;font-weight:700}.hero p:not(.eyebrow){max-width:620px;color:var(--text-muted);font-size:.9rem}.scope{padding:.45rem .7rem;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm);color:var(--text-muted);font-size:.75rem}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4)}.cards a{display:grid;gap:.5rem;min-height:170px;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md);color:inherit;text-decoration:none}.cards a:hover,.cards a:focus-visible{border-color:var(--color-accent-primary);transform:translateY(-2px)}.cards span{color:var(--text-secondary);font-weight:700}.cards strong{font-size:2.6rem;color:var(--color-accent-primary-hover);line-height:1}.cards small{color:var(--text-muted);font-size:.8rem;line-height:1.45}.note{max-width:760px;margin-top:var(--space-6);padding:var(--space-5);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}.note p{margin:.5rem 0 0;color:var(--text-muted);font-size:.85rem;line-height:1.55}@media(max-width:700px){.hero{display:grid}.cards{grid-template-columns:1fr}}
</style>
