---
import AppLayout from '../../../ui/layouts/AppLayout.astro'; import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js';
const actor=Astro.locals.actor; if(!actor)return Astro.redirect('/login?returnTo=%2Fassets%2Fcalibrations'); const states=['DRAFT','SUBMITTED','APPROVED','CURRENT','DUE','OVERDUE','SUPERSEDED','VOID'] as const; const requested=Astro.url.searchParams.get('state'); const state=states.find((value)=>value===requested); const equipmentId=Astro.url.searchParams.get('equipmentId')||undefined; const search=Astro.url.searchParams.get('q')?.slice(0,200)||undefined; let records: readonly import('../../../modules/assets/calibration/domain/calibration.js').CalibrationRecord[] = []; try{records=await assetsReadDependencies().calibration.list.execute({actor,filter:{state,equipmentId,search}});}catch{/* safe empty state */}
---
<AppLayout title="Calibrations · Assets" locale="en" direction="ltr"><section class="head"><div><p class="eyebrow">UI-CAL-001 · T2 LIST</p><h1>Calibration records</h1><p>Historical calibration records linked to equipment. Dates are source-provided; no interval is inferred.</p></div><a class="button" href="/assets/calibrations/new">Add calibration record</a></section><form class="filters" method="get"><label for="q">Search<input id="q" name="q" value={search??''} maxlength="200" /></label><label for="state">State<select id="state" name="state"><option value="">All states</option>{states.map((value)=><option value={value} selected={state===value}>{value}</option>)}</select></label>{equipmentId?<input type="hidden" name="equipmentId" value={equipmentId}/>:null}<button class="button secondary" type="submit">Filter</button></form>{records.length?<div class="table-wrap"><table><caption>{records.length} authorized calibration record{records.length===1?'':'s'}</caption><thead><tr><th scope="col">Calibration ID</th><th scope="col">Equipment</th><th scope="col">State</th><th scope="col">Calibration date</th><th scope="col">Due date</th><th scope="col">Certificate</th></tr></thead><tbody>{records.map((record)=><tr><th scope="row"><a href={`/assets/calibrations/${record.id}`}>{record.calibrationNo}</a></th><td><a href={`/assets/equipment/${record.equipmentId}`}>{record.equipmentId}</a></td><td><span class="state">{record.state}</span></td><td>{record.calibrationDate.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})}</td><td>{record.dueDate?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})??'Not supplied'}</td><td>{record.certificateNo??'Not supplied'}</td></tr>)}</tbody></table></div>:<section class="empty"><h2>No calibration records in this view</h2><p>There are no authorized records matching the selected filters.</p><a href="/assets/calibrations/new">Create a draft record</a></section>}</AppLayout>
<style>.head,.filters{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-end}.head{align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.empty p{color:var(--text-muted);font-size:.85rem}.button{display:inline-flex;align-items:center;min-height:var(--control-height);padding-inline:1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;text-decoration:none;font-weight:700}.secondary{background:var(--surface-raised);border-color:var(--border-default);color:var(--text-primary)}.filters{justify-content:flex-start;margin-bottom:var(--space-5)}label{display:grid;gap:.35rem;color:var(--text-secondary);font-size:.8rem}input,select{min-height:var(--control-height);padding:.55rem .7rem;background:var(--surface-panel);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.table-wrap{overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:900px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted);font-size:.8rem}th,td{padding:.85rem;border-top:1px solid var(--color-border-subtle);text-align:start;font-size:.8rem}th{font-weight:700}a{color:var(--color-accent-primary-hover)}.state{display:inline-flex;padding:.28rem .5rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:.7rem;font-weight:700}.empty{margin-top:var(--space-5);padding:var(--space-8);text-align:center;background:var(--surface-panel);border:1px dashed var(--color-border-strong);border-radius:var(--radius-lg)}.empty h2{margin:0 0 .5rem;font-size:1.1rem}.empty a{font-weight:700}@media(max-width:650px){.head,.filters{display:grid}.button{width:max-content}}
</style>
