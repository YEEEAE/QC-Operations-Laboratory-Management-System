---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import FormErrorSummary from '../../../ui/components/FormErrorSummary.astro';
import { actions } from 'astro:actions';
import {
  detailHref,
  extractDetailId,
  field,
  optionalField,
  toFormFailure,
  type FormFailure,
} from '../../../ui/forms/mutation-post.js';

const actor=Astro.locals.actor; if(!actor)return Astro.redirect('/login?returnTo=%2Fassets%2Fcalibrations%2Fnew'); const canCreate=actor.permissions.some((permission)=>permission.code==='PERM-CAL-CREATE'); const equipmentId=Astro.url.searchParams.get('equipmentId')||'';

const LIST_HREF = '/assets/calibrations';
const REQUIRED_FIELDS = [
  { name: 'calibrationNo', label: 'Calibration ID' },
  { name: 'equipmentId', label: 'Equipment ID' },
  { name: 'calibrationDate', label: 'Calibration date' },
] as const;

let values = { calibrationNo: '', equipmentId, calibrationDate: '', dueDate: '', provider: '', certificateNo: '', result: '' };
let failure: FormFailure | null = null;

// POST baseline (F-05): without JavaScript the form performs a real POST to
// this page. The same Astro Action — with the same server-side
// reauthorization — runs via Astro.callAction. No business payload enters
// the URL: input travels in the POST body, success redirects (303) to the
// new record only.
if (Astro.request.method === 'POST' && canCreate) {
  const formData = await Astro.request.formData();
  const calibrationRaw = field(formData, 'calibrationDate');
  const dueRaw = field(formData, 'dueDate');
  values = {
    calibrationNo: field(formData, 'calibrationNo'),
    equipmentId: field(formData, 'equipmentId'),
    calibrationDate: calibrationRaw,
    dueDate: dueRaw,
    provider: field(formData, 'provider'),
    certificateNo: field(formData, 'certificateNo'),
    result: field(formData, 'result'),
  };
  try {
    const data = await Astro.callAction(actions.assets.createCalibration, {
      calibrationNo: values.calibrationNo,
      equipmentId: values.equipmentId,
      // Always a Date instance for the required field: blank or malformed
      // text becomes Invalid Date, which the Action input schema rejects
      // as a validation failure (highlighted on the field).
      calibrationDate: new Date(calibrationRaw),
      ...(dueRaw ? { dueDate: new Date(dueRaw) } : {}),
      provider: optionalField(formData, 'provider'),
      certificateNo: optionalField(formData, 'certificateNo'),
      result: optionalField(formData, 'result'),
    });
    const id = extractDetailId(data);
    if (id) return Astro.redirect(detailHref(LIST_HREF, id), 303);
    failure = {
      kind: 'unknown',
      summary: 'The calibration record was received but no record reference came back.',
      recovery: 'Check the calibration register before trying again to avoid a duplicate.',
      fieldErrors: {},
      firstInvalidField: null,
    };
  } catch (error) {
    failure = toFormFailure(error, {
      entity: 'Calibration record',
      requiredFields: REQUIRED_FIELDS,
      values,
      listHref: LIST_HREF,
      listLabel: 'calibrations',
    });
  }
}
const describedBy = (name: keyof typeof values): string | undefined =>
  failure?.fieldErrors[name] ? `${name}-error` : undefined;
const invalid = (name: keyof typeof values): 'true' | undefined =>
  failure?.fieldErrors[name] ? 'true' : undefined;
---
<AppLayout title="New Calibration · Assets" locale="en" direction="ltr"><section class="head"><div><p class="eyebrow">T3 CONTROLLED CALIBRATION</p><h1>New calibration record</h1><p>Calibration is always linked to an equipment record. Due date is entered only when supplied by an approved source.</p></div><a href="/assets/calibrations">Back to calibrations</a></section>{canCreate?<form class="form" method="post" data-action="assets.createCalibration">{failure && <FormErrorSummary summary={failure.summary} recovery={failure.recovery} listHref={LIST_HREF} listLabel="calibrations" />}<fieldset><legend>Calibration identity</legend><div class="fields"><div><label for="calibrationNo">Calibration ID<input id="calibrationNo" name="calibrationNo" required value={values.calibrationNo} aria-invalid={invalid('calibrationNo')} aria-describedby={describedBy('calibrationNo')} /></label>{failure?.fieldErrors.calibrationNo && <p class="field-error" id="calibrationNo-error">{failure.fieldErrors.calibrationNo}</p>}</div><div><label for="equipmentId">Equipment ID<input id="equipmentId" name="equipmentId" value={values.equipmentId} required aria-invalid={invalid('equipmentId')} aria-describedby={describedBy('equipmentId')} /></label>{failure?.fieldErrors.equipmentId && <p class="field-error" id="equipmentId-error">{failure.fieldErrors.equipmentId}</p>}</div><div><label for="calibrationDate">Calibration date<input id="calibrationDate" name="calibrationDate" type="date" required value={values.calibrationDate} aria-invalid={invalid('calibrationDate')} aria-describedby={describedBy('calibrationDate')} /></label>{failure?.fieldErrors.calibrationDate && <p class="field-error" id="calibrationDate-error">{failure.fieldErrors.calibrationDate}</p>}</div><div><label for="dueDate">Due date (source-provided)<input id="dueDate" name="dueDate" type="date" value={values.dueDate} /></label></div><div><label for="provider">Provider<input id="provider" name="provider" value={values.provider} /></label></div><div><label for="certificateNo">Certificate number<input id="certificateNo" name="certificateNo" value={values.certificateNo} /></label></div><div class="wide"><label for="result">Result / source note<textarea id="result" name="result">{values.result}</textarea></label></div></div></fieldset><div class="actions"><a class="secondary" href="/assets/calibrations">Cancel</a><button type="submit" data-submit>Create draft</button></div><p role="status" data-result></p></form>:<section class="denied" role="alert"><h2>Creation is not available</h2><p>Your account does not have the explicit Calibration create permission.</p></section>}</AppLayout>
<script>
import{actions}from'astro:actions';const form=document.querySelector<HTMLFormElement>('[data-action="assets.createCalibration"]');form?.addEventListener('submit',async(event)=>{event.preventDefault();const data=new FormData(form);const submit=form.querySelector<HTMLButtonElement>('[data-submit]');const output=form.querySelector<HTMLElement>('[data-result]');if(submit)submit.disabled=true;form.setAttribute('aria-busy','true');if(output)output.textContent='Saving…';try{const calibrationRaw=String(data.get('calibrationDate'));const due=String(data.get('dueDate')||'');const result=await actions.assets.createCalibration({calibrationNo:String(data.get('calibrationNo')),equipmentId:String(data.get('equipmentId')),calibrationDate:new Date(`${calibrationRaw}T00:00:00.000Z`),dueDate:due?new Date(`${due}T00:00:00.000Z`):undefined,provider:String(data.get('provider')||'')||undefined,certificateNo:String(data.get('certificateNo')||'')||undefined,result:String(data.get('result')||'')||undefined});if(result.data&&typeof result.data.id==='string'){window.location.href=`/assets/calibrations/${result.data.id}`;return;}if(output)output.textContent='Unable to create this calibration. Review the fields and try again.';const firstInvalid=form.querySelector<HTMLElement>('input:invalid');(firstInvalid??output)?.focus?.();}catch{if(output)output.textContent='The service is temporarily unavailable. Your entries are kept — try again.';}finally{if(submit)submit.disabled=false;form.removeAttribute('aria-busy');}});</script>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.denied p{color:var(--text-muted);font-size:.85rem}.head a{color:var(--color-accent-primary-hover)}.form{max-width:900px;display:grid;gap:var(--space-5)}fieldset{padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}legend{padding-inline:.5rem;font-weight:700}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}.wide{grid-column:1/-1}input,textarea{min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}input[aria-invalid="true"]{border-color:var(--status-danger)}.field-error{margin:.25rem 0 0;color:var(--status-danger);font-size:.8rem}textarea{min-height:6rem}.actions{display:flex;justify-content:flex-end;gap:var(--space-3)}button,.secondary{min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.secondary{border-color:var(--border-default);background:var(--surface-raised);color:var(--text-primary);text-decoration:none}button[disabled]{opacity:.6}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}@media(max-width:650px){.head{display:grid}.fields{grid-template-columns:1fr}.wide{grid-column:auto}.actions{display:grid}}
</style>
