---
import AppLayout from '../../../ui/layouts/AppLayout.astro'; import JourneyContextPanel from '../../../ui/components/workflow/JourneyContextPanel.astro'; import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro'; import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js'; import { stateLabel } from '../../../shared/copy/ux-vocabulary.js'; import { AppError } from '../../../shared/errors/app-error.js';
const actor=Astro.locals.actor;if(!actor)return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);const read=assetsReadDependencies();let record;let recordUnavailable=false;try{record=await read.calibration.get.execute({actor,calibrationId:Astro.params.calibrationId??''});}catch(error){if(!(error instanceof AppError&&error.code==='RESOURCE_NOT_FOUND'))recordUnavailable=true;}if(!record&&!recordUnavailable)return Astro.redirect('/404');if(recordUnavailable)Astro.response.status=503;let history: readonly import('../../../modules/assets/calibration/ports/repository.js').CalibrationHistory[]=[];let historyUnavailable=false;if(record){try{history=await read.calibration.history.execute({actor,calibrationId:record.id});}catch{historyUnavailable=true;}}
let eligibility: Awaited<ReturnType<typeof read.equipment.assessEligibility.assess>> | undefined;
let eligibilityUnavailable = false;
let equipment: Awaited<ReturnType<typeof read.equipment.get.execute>> | undefined;
if (record) {
  try { eligibility = await read.equipment.assessEligibility.assess(actor, record.equipmentId); }
  catch { eligibilityUnavailable = true; }
  try { equipment = await read.equipment.get.execute({ actor, equipmentId: record.equipmentId }); }
  catch { /* Keep the calibration record available when its related equipment read is denied or unavailable. */ }
}
const nextAction = record && (['DRAFT','SUBMITTED','APPROVED'].includes(record.state) ? record.state === 'DRAFT' ? 'Submit calibration' : record.state === 'SUBMITTED' ? 'Review calibration' : 'Make calibration current' : record.state === 'DUE' || record.state === 'OVERDUE' ? 'Create next calibration record' : undefined);
const nextOwner = record && (['DRAFT','SUBMITTED'].includes(record.state) ? 'Calibration owner / reviewer' : record.state === 'APPROVED' ? 'Calibration owner' : record.state === 'DUE' || record.state === 'OVERDUE' ? 'Calibration owner' : undefined);
---
<AppLayout title={record ? `${record.calibrationNo} · Calibration` : "Calibration · Assets"} locale="en" direction="ltr">{recordUnavailable ? <ProviderUnavailableState title="Calibration record is temporarily unavailable" /> : record ? <><div class="crumb"><a href="/assets">Assets</a><span>/</span><a href="/assets/calibrations">Calibrations</a><span>/</span><span>{record.calibrationNo}</span></div><section class="head"><div><p class="eyebrow">Calibration</p><h1>{record.calibrationNo}</h1><p>Equipment <a href={`/assets/equipment/${record.equipmentId}`}>{equipment ? `${equipment.equipmentNo} · ${equipment.name}` : 'Equipment record'}</a> · Version {record.version.toString()}</p></div><span class="state">{stateLabel(record.state)}</span></section><JourneyContextPanel ownerDomain="Equipment & Calibration" currentState={record.state} nextAction={nextAction} nextOwner={nextOwner} whyUnavailable={record.state === 'OVERDUE' ? 'BR-CAL-004: overdue equipment is not eligible for laboratory or inspection use; submit a new calibration and complete its approved review/current-selection flow' : record.state === 'APPROVED' ? 'policy: approved-to-current activation is explicitly separate and policy-controlled' : undefined} waitingOn={record.state === 'SUBMITTED' ? 'Calibration reviewer' : record.state === 'APPROVED' ? 'Current-calibration activation policy/owner' : record.state === 'DUE' || record.state === 'OVERDUE' ? 'Next calibration execution' : undefined} expectedEvent={record.state === 'APPROVED' ? 'Make current when policy permits' : record.state === 'DUE' || record.state === 'OVERDUE' ? 'New calibration submission' : undefined} controlledContext={`Equipment ${equipment?.equipmentNo ?? 'record'} · calibration ${record.calibrationNo}`} evidenceSummary={`Certificate ${record.certificateNo ?? 'not supplied'} · due date ${record.dueDate?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'}) ?? 'not supplied by source'}`} auditHref={`/audit?subjectType=CALIBRATION_RECORD&subjectId=${encodeURIComponent(record.id)}`} relatedLinks={[{ label: 'Equipment record', href: `/assets/equipment/${record.equipmentId}`, detail: 'Equipment-owned status' }, { label: 'Calibration register', href: '/assets/calibrations', detail: 'Historical calibration records' }]} /><section class="panel eligibility" aria-labelledby="eligibility-heading"><h2 id="eligibility-heading">Laboratory and inspection use</h2>{eligibilityUnavailable ? <p role="status"><strong>Eligibility could not be confirmed.</strong> Do not use this equipment in laboratory work or inspection until the equipment and current-calibration sources are available and eligibility is confirmed. <a href="/assets/equipment">Review equipment</a>.</p> : eligibility?.eligible ? <p role="status"><strong>Eligible based on the current source records.</strong> This reading does not reserve the equipment; use is checked again when recorded.</p> : <p role="status"><strong>Not eligible for laboratory or inspection use.</strong> {eligibility?.reason === 'CALIBRATION_EXPIRED' ? 'The current source due date has passed.' : eligibility?.reason === 'CALIBRATION_NOT_CURRENT' ? 'The source does not identify a current calibration for this equipment.' : eligibility?.reason === 'NO_CURRENT_CALIBRATION' ? 'No current calibration is available in the source.' : eligibility?.reason === 'UNDER_MAINTENANCE' ? 'The equipment is under maintenance.' : eligibility?.reason === 'OUT_OF_SERVICE' ? 'The equipment is out of service.' : 'The equipment is not active.'} Laboratory and inspection submission is blocked until the approved equipment and calibration workflow makes it eligible again.</p>}{eligibility?.dueDate && <p class="muted">Source calibration due date: {eligibility.dueDate.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})}.</p>}</section><div class="grid"><section class="panel"><h2>Calibration information</h2><dl><div><dt>Calibration date</dt><dd>{record.calibrationDate.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})}</dd></div><div><dt>Due date</dt><dd>{record.dueDate?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})??'Not supplied by source'}</dd></div><div><dt>Provider</dt><dd>{record.provider??'Not supplied'}</dd></div><div><dt>Certificate</dt><dd>{record.certificateNo??'Not supplied'}</dd></div><div><dt>Result</dt><dd>{record.result??'Not supplied'}</dd></div><div><dt>Equipment</dt><dd><a href={`/assets/equipment/${record.equipmentId}`}>{equipment ? `${equipment.equipmentNo} · ${equipment.name}` : 'Equipment record'}</a></dd></div></dl></section><section class="panel"><h2>Controlled status</h2><p class="notice">No calibration interval is inferred. The source due date determines whether a current calibration is overdue. BR-CAL-004 blocks laboratory and inspection use whenever equipment is not eligible; no bypass is authorized.</p><p class="muted">Historical calibration records are preserved. A future current-calibration selection remains a separate approved transition.</p></section></div><section class="panel history"><h2>Immutable history</h2>{historyUnavailable ? <p role="status">Calibration history is temporarily unavailable. Retry this record later; the calibration details remain available.</p> : history.length ? <table><caption>Append-only calibration state history</caption><thead><tr><th scope="col">Action</th><th scope="col">State</th><th scope="col">Version</th><th scope="col">Changed</th></tr></thead><tbody>{history.map((item)=><tr><th scope="row">{item.action}</th><td>{stateLabel(item.state)}</td><td>{item.recordVersion.toString()}</td><td>{item.changedAt.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})}</td></tr>)}</tbody></table> : <p class="muted">No calibration history entries are recorded.</p>}<dl><div><dt>Created by</dt><dd>{record.createdBy}</dd></div><div><dt>Created</dt><dd>{record.createdAt.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})}</dd></div><div><dt>Approved</dt><dd>{record.approvedAt?.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})??'Not approved'}</dd></div><div><dt>Version</dt><dd>{record.version.toString()}</dd></div></dl></section></> : <section class="panel"><h1>Calibration record not found</h1><p>This record does not exist or is outside your authorized scope.</p><a href="/assets/calibrations">Return to calibrations</a></section>}</AppLayout>
<style>.crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,.head a{color:var(--color-accent-primary-hover)}.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.muted,.notice{color:var(--text-muted);font-size:.85rem}.state{padding:.45rem .7rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:.75rem;font-weight:700}.grid{display:grid;grid-template-columns:1.2fr .8fr;gap:var(--space-5)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0;font-size:1rem}.eligibility{margin:var(--space-5) 0;border-inline-start:3px solid var(--status-warning)}.eligibility p{line-height:1.55}.eligibility a{color:var(--color-accent-primary-hover)}dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin:var(--space-5) 0 0}dt{color:var(--text-muted);font-size:.75rem}dd{margin:.3rem 0 0;font-weight:700;font-size:.86rem}.notice{padding:var(--space-4);border-inline-start:3px solid var(--status-warning);background:var(--surface-raised);line-height:1.55}.history{margin-top:var(--space-5)}@media(max-width:700px){.head{display:grid}.grid{grid-template-columns:1fr}dl{grid-template-columns:1fr}}
</style>
