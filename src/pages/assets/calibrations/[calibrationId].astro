---
import AppLayout from '../../../ui/layouts/AppLayout.astro'; import { assetsReadDependencies } from '../../../modules/assets/application/dependencies.js';
const actor=Astro.locals.actor;if(!actor)return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);let record;try{record=await assetsReadDependencies().calibration.get.execute({actor,calibrationId:Astro.params.calibrationId??''});}catch{return Astro.redirect('/404')}if(!record)return Astro.redirect('/404');
---
<AppLayout title={`${record.calibrationNo} · Calibration`} locale="en" direction="ltr"><div class="crumb"><a href="/assets">Assets</a><span>/</span><a href="/assets/calibrations">Calibrations</a><span>/</span><span>{record.calibrationNo}</span></div><section class="head"><div><p class="eyebrow">UI-CAL-002 · T7 RECORD WORKSPACE</p><h1>{record.calibrationNo}</h1><p>Equipment <a href={`/assets/equipment/${record.equipmentId}`}>{record.equipmentId}</a> · Version {record.version.toString()}</p></div><span class="state">{record.state}</span></section><div class="grid"><section class="panel"><h2>Calibration information</h2><dl><div><dt>Calibration date</dt><dd>{record.calibrationDate.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})}</dd></div><div><dt>Due date</dt><dd>{record.dueDate?.toLocaleDateString('en-SA',{timeZone:'Asia/Riyadh'})??'Not supplied by source'}</dd></div><div><dt>Provider</dt><dd>{record.provider??'Not supplied'}</dd></div><div><dt>Certificate</dt><dd>{record.certificateNo??'Not supplied'}</dd></div><div><dt>Result</dt><dd>{record.result??'Not supplied'}</dd></div><div><dt>Equipment</dt><dd><a href={`/assets/equipment/${record.equipmentId}`}>{record.equipmentId}</a></dd></div></dl></section><section class="panel"><h2>Controlled status</h2><p class="notice">No calibration interval is inferred here. A due or overdue state must come from an approved source and does not automatically change equipment availability.</p><p class="muted">Historical calibration records are preserved. A future current-calibration selection, if needed, remains policy-controlled.</p></section></div><section class="panel history"><h2>History</h2><dl><div><dt>Created by</dt><dd>{record.createdBy}</dd></div><div><dt>Created</dt><dd>{record.createdAt.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})}</dd></div><div><dt>Approved</dt><dd>{record.approvedAt?.toLocaleString('en-SA',{timeZone:'Asia/Riyadh'})??'Not approved'}</dd></div><div><dt>Version</dt><dd>{record.version.toString()}</dd></div></dl></section></AppLayout>
<style>.crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a,.head a{color:var(--color-accent-primary-hover)}.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.muted,.notice{color:var(--text-muted);font-size:.85rem}.state{padding:.45rem .7rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:.75rem;font-weight:700}.grid{display:grid;grid-template-columns:1.2fr .8fr;gap:var(--space-5)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:0;font-size:1rem}dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin:var(--space-5) 0 0}dt{color:var(--text-muted);font-size:.75rem}dd{margin:.3rem 0 0;font-weight:700;font-size:.86rem}.notice{padding:var(--space-4);border-inline-start:3px solid var(--status-warning);background:var(--surface-raised);line-height:1.55}.history{margin-top:var(--space-5)}@media(max-width:700px){.head{display:grid}.grid{grid-template-columns:1fr}dl{grid-template-columns:1fr}}
</style>
