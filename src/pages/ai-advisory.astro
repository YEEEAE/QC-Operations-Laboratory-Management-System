---
import AppLayout from '../ui/layouts/AppLayout.astro';
import { copy } from '../shared/copy/ux-vocabulary';
import { aiAdvisoryPageAvailability } from '../modules/ai-advisory/application/page-availability.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const canUse = actor.permissions.some((grant) => grant.code === 'PERM-AI-USE' && grant.active !== false);
const canSummarize = actor.permissions.some((grant) => grant.code === 'PERM-AI-SUMMARIZE' && grant.active !== false);
const canSuggest = actor.permissions.some((grant) => grant.code === 'PERM-AI-SUGGEST' && grant.active !== false);
const canDraft = actor.permissions.some((grant) => grant.code === 'PERM-AI-DRAFT' && grant.active !== false);
const aiAvailability = aiAdvisoryPageAvailability();
const configuredProviders = aiAvailability.configuredProviders;
const processingPolicy = aiAvailability.processingPolicy;
---
<AppLayout title="AI Advisory · QC Operations" locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">AI advisory</p><h1>AI Advisory</h1><p class="lede">Suggestions and analysis only — not an approval authority.</p></div></section>
  {canUse ? (
    <>
      <section class="notice" role="note"><strong>Advisory boundary</strong><span>{copy.boundaries.aiNotAuthority} Response actions are limited to copying text or using it as your own draft.</span></section>
      <section class="notice" role="note" aria-label="Human review path"><strong>Human review path</strong><span>AI output is not entered into a QC record. Verify every statement against the cited controlled source, then take uncertainty, missing sources, or suspected incorrect citations to your Supervisor or QCM (Manager) through the normal authorized review workflow.</span></section>
      <section class="notice privacy-notice" role="note" aria-label="AI data use">
        <strong>About your request</strong>
        {configuredProviders && processingPolicy ? (
          <>
            <span>Provider: {configuredProviders}. Processing location: {processingPolicy.processingLocation}. Retention limit in the approved policy: {processingPolicy.retentionDays} days. Deletion terms: {processingPolicy.deletionTerms}. Policy: {processingPolicy.policyId} v{processingPolicy.version} ({processingPolicy.sourceReference}). Provider training is prohibited by the configured policy.</span>
            <span>Permitted content classes: {processingPolicy.permittedDataClasses.join(', ')}. Never submit personal data, credentials, confidential QC information, actual controlled QC records, or content you are not authorized to share. The system checks common sensitive patterns but cannot classify every excerpt.</span>
          </>
        ) : aiAvailability.externalProcessingApproved ? (
          <span>External processing is marked approved, but a complete approved processing-policy source or policy-authorized provider is missing. Your question and excerpt will not be sent. Contact the policy owner.</span>
        ) : (
          <span>External AI processing is disabled because no complete approved processing-policy source is configured. Provider location, retention, permitted data classes, and consent terms must come from that source. Your question and excerpt will not be sent while this notice appears.</span>
        )}
      </section>
      <section class="panel">
        <h2>Request advisory</h2>
        <form class="form" data-advisory-request>
          <label>Output type
            <select name="mode">
              {canSummarize && <option value="SUMMARIZE">Summarize</option>}
              {canSuggest && <option value="SUGGEST">Suggest questions</option>}
              {canDraft && <option value="DRAFT">Draft text</option>}
            </select>
          </label>
          <label>Question for analysis<textarea name="question" required maxlength="4000" placeholder="What should the advisory review?"></textarea></label>
          <fieldset class="context"><legend>Optional context (minimized)</legend>
            <p class="muted">Only text you enter here is submitted after consent. Do not enter actual controlled QC records. Source identity/citation is user supplied and not authenticated here. Missing or unverified sources make the advisory abstain.</p>
            <label>Source label<input name="contextLabel" maxlength="120" placeholder="e.g. synthetic process summary" /></label>
            <label>Source identity<input name="sourceId" maxlength="200" placeholder="e.g. WI-001 v3" /></label>
            <label>Source type<input name="sourceType" maxlength="120" placeholder="e.g. CONTROLLED_DOCUMENT" /></label>
            <label>Citation<input name="citation" maxlength="500" placeholder="e.g. WI-001 §4" /></label>
            <label>Excerpt<textarea name="contextContent" maxlength="4000"></textarea></label>
          </fieldset>
          {configuredProviders && processingPolicy && (
            <>
              <label>Content class in approved policy
                <select name="dataClass" required>
                  <option value="">Select content class</option>
                  {processingPolicy.permittedDataClasses.includes('PUBLIC') && <option value="PUBLIC">Public</option>}
                  {processingPolicy.permittedDataClasses.includes('SYNTHETIC') && <option value="SYNTHETIC">Synthetic</option>}
                  {processingPolicy.permittedDataClasses.includes('AUTHORIZED_NONCONFIDENTIAL_EXCERPT') && <option value="AUTHORIZED_NONCONFIDENTIAL_EXCERPT">Authorized non-confidential excerpt</option>}
                </select>
              </label>
              <label class="consent"><input type="checkbox" name="consentToExternalProcessing" value="true" required /> I consent (version {processingPolicy.consentVersion}) to send this question and any excerpt to {configuredProviders} under policy {processingPolicy.policyId} v{processingPolicy.version}, processed in {processingPolicy.processingLocation} and retained for up to {processingPolicy.retentionDays} days.</label>
            </>
          )}
          <div class="actions"><button type="submit">Request advisory</button></div>
          <p role="status" data-result aria-live="polite"></p>
        </form>
      </section>
      <section class="panel response-panel" data-response-panel hidden>
        <h2>AI response</h2>
        <p class="advisory-label" data-advisory-label>AI-generated advisory content — suggestions and analysis only, not an approval authority.</p>
        <p class="status" data-status></p>
        <div class="advisory-text" data-advisory-text></div>
        <p class="muted" data-source-context hidden></p>
        <p class="muted" data-source-references hidden></p>
        <p class="muted" data-review-guidance hidden></p>
        <p class="muted" data-provenance hidden></p>
        <label class="correction-label">Correction or concern (kept in this page only)<textarea data-correction maxlength="4000" placeholder="Describe what is incorrect or missing. Do not include personal data or credentials."></textarea></label>
        <button type="button" data-prepare-correction disabled>Prepare correction for human review</button>
        <div class="actions">
          <button type="button" data-copy disabled>Copy</button>
          <button type="button" data-use-draft disabled>Use as Draft</button>
        </div>
        <p class="muted">No controlled action can be triggered from an AI response. Any official decision must go through the normal authorized workflow.</p>
      </section>
    </>
  ) : (
    <p class="empty">You are not authorized to use AI advisory.</p>
  )}
</AppLayout>
{/* Page enhancement script. It is intentionally a single top-level hoisted
    script (never nested in a conditional expression): Astro only bundles and
    externalises top-level scripts, and the production CSP forbids inline
    script. Every element below is optional, so the script is inert for an
    account without the advisory permission. */}
<script>
  import { actions } from 'astro:actions';
  const form = document.querySelector<HTMLFormElement>('[data-advisory-request]');
  const panel = document.querySelector<HTMLElement>('[data-response-panel]');
  const statusEl = document.querySelector<HTMLElement>('[data-status]');
  const textEl = document.querySelector<HTMLElement>('[data-advisory-text]');
  const labelEl = document.querySelector<HTMLElement>('[data-advisory-label]');
  const resultEl = document.querySelector<HTMLElement>('[data-result]');
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy]');
  const draftButton = document.querySelector<HTMLButtonElement>('[data-use-draft]');
  const sourceReferencesEl = document.querySelector<HTMLElement>('[data-source-references]');
  const sourceContextEl = document.querySelector<HTMLElement>('[data-source-context]');
  const reviewGuidanceEl = document.querySelector<HTMLElement>('[data-review-guidance]');
  const provenanceEl = document.querySelector<HTMLElement>('[data-provenance]');
  const correctionEl = document.querySelector<HTMLTextAreaElement>('[data-correction]');
  const correctionButton = document.querySelector<HTMLButtonElement>('[data-prepare-correction]');
  const consentCheckbox = form?.querySelector<HTMLInputElement>('input[name="consentToExternalProcessing"]');
  let advisoryText = '';
  const resetButtons = () => {
    if (copyButton) copyButton.disabled = true;
    if (draftButton) draftButton.disabled = true;
  };
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !resultEl) return;
    resultEl.textContent = 'Requesting advisory…';
    resetButtons();
    const data = new FormData(form);
    const contextLabel = String(data.get('contextLabel') || '').trim();
    const contextContent = String(data.get('contextContent') || '').trim();
    const selectedDataClass = String(data.get('dataClass') || '');
    const response = await actions.aiAdvisory.requestAdvisory({
      mode: String(data.get('mode')) as 'SUMMARIZE' | 'SUGGEST' | 'DRAFT',
      question: String(data.get('question') || ''),
      context:
        contextLabel && contextContent
          ? [{
              label: contextLabel,
              content: contextContent,
              ...(String(data.get('sourceId') || '').trim() ? { sourceId: String(data.get('sourceId')).trim() } : {}),
              ...(String(data.get('sourceType') || '').trim() ? { sourceType: String(data.get('sourceType')).trim() } : {}),
              ...(String(data.get('citation') || '').trim() ? { citation: String(data.get('citation')).trim() } : {}),
            }]
          : [],
      consentToExternalProcessing: (form.querySelector<HTMLInputElement>('input[name="consentToExternalProcessing"]')?.checked ?? false),
      ...(selectedDataClass
        ? { dataClass: selectedDataClass as 'PUBLIC' | 'SYNTHETIC' | 'AUTHORIZED_NONCONFIDENTIAL_EXCERPT' }
        : {}),
    });
    if (panel) panel.hidden = false;
    if (statusEl && textEl && labelEl) {
      if (response.error) {
        statusEl.textContent = 'Request blocked or unavailable.';
        textEl.textContent = '';
        labelEl.textContent = 'AI advisory is optional: core QC workflows are unaffected.';
        if (sourceContextEl) {
          sourceContextEl.textContent = 'The request was not returned as an advisory. Check authorization and remove sensitive or unsupported input before trying again.';
          sourceContextEl.hidden = false;
        }
        if (reviewGuidanceEl) {
          reviewGuidanceEl.textContent = 'If the source is missing or uncertainty remains, take the original controlled record to your Supervisor or QCM (Manager) through the normal authorized review workflow.';
          reviewGuidanceEl.hidden = false;
        }
        if (provenanceEl) { provenanceEl.textContent = ''; provenanceEl.hidden = true; }
        resetButtons();
      } else if (response.data) {
        statusEl.textContent = response.data.message;
        advisoryText = response.data.advisory?.text ?? '';
        textEl.textContent = advisoryText;
        if (sourceContextEl) {
          const sourceLabel = String(data.get('contextLabel') || '').trim();
          const sourceIdentity = String(data.get('sourceId') || '').trim();
          const sourceCitation = String(data.get('citation') || '').trim();
          sourceContextEl.textContent = sourceLabel
            ? `User-supplied source provenance: ${sourceLabel}${sourceIdentity ? ` · ${sourceIdentity}` : ''}${sourceCitation ? ` · ${sourceCitation}` : ''}. The form does not verify source authenticity or currency.`
            : 'No source context was supplied. Verify claims against a controlled source before relying on them.';
          sourceContextEl.hidden = false;
        }
        if (sourceReferencesEl) {
          const references = response.data.advisory?.sourceReferences ?? [];
          sourceReferencesEl.textContent = references.length
            ? `Sources preserved: ${references.map((reference) => reference.citation || reference.label || reference.sourceId).join(' · ')}`
            : '';
          sourceReferencesEl.hidden = references.length === 0;
        }
        if (reviewGuidanceEl) {
          reviewGuidanceEl.textContent = response.data.status === 'REFUSED'
            ? 'Reason for abstention: the request lacked a usable controlled source, contained sensitive material, or the answer included an unsafe claim or citation. Verify the source and ask your Supervisor or QCM (Manager) to review through the normal authorized workflow.'
            : response.data.status === 'UNAVAILABLE'
              ? 'Reason: no usable advisory provider response. Continue with the normal human review workflow.'
              : 'Review before use: compare the response and its source details with the controlled record. Ask your Supervisor or QCM (Manager) when uncertain.';
          reviewGuidanceEl.hidden = false;
        }
        if (provenanceEl) {
          const provenance = response.data.advisory?.provenance;
          const provider = response.data.advisory?.providerMetadata;
          provenanceEl.textContent = provenance
            ? `Generated: ${provenance.generatedAt}. Provider/model: ${provider ? `${provider.provider}/${provider.model}` : 'not supplied'}. Prompt: ${provenance.promptVersion}. Confidence: not calibrated. Boundary: advisory only; verify every claim against the controlled source.`
            : 'Provenance is unavailable; verify every claim against the controlled source.';
          provenanceEl.hidden = false;
        }
        if (correctionButton) correctionButton.disabled = !advisoryText;
        labelEl.textContent = response.data.advisoryNotice;
        if (advisoryText) {
          if (copyButton) copyButton.disabled = false;
          if (draftButton) draftButton.disabled = false;
        }
      }
    }
    if (resultEl) resultEl.textContent = '';
  });
  form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input:not([name="consentToExternalProcessing"]), textarea, select[name="dataClass"]').forEach((field) => {
    field.addEventListener('input', () => { if (consentCheckbox) consentCheckbox.checked = false; });
  });
  copyButton?.addEventListener('click', async () => {
    if (advisoryText) await navigator.clipboard.writeText(advisoryText);
  });
  draftButton?.addEventListener('click', () => {
    const questionField = form?.querySelector<HTMLTextAreaElement>('textarea[name="question"]');
    if (questionField && advisoryText) questionField.value = advisoryText;
  });
  correctionButton?.addEventListener('click', () => {
    const questionField = form?.querySelector<HTMLTextAreaElement>('textarea[name="question"]');
    if (!questionField || !advisoryText || !correctionEl?.value.trim()) return;
    questionField.value = `Human correction for review (not an approved QC decision):\n${correctionEl.value.trim()}\n\nOriginal AI advisory for comparison:\n${advisoryText}`;
    if (consentCheckbox) consentCheckbox.checked = false;
    resultEl && (resultEl.textContent = 'Correction prepared locally. Route it through the normal authorized human review workflow; it has not been saved or sent.');
  });
</script>
<style>
.page-head{margin-bottom:var(--space-6)}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}h1{margin:.25rem 0}.lede,.muted,.empty{color:var(--text-muted)}
.notice,.panel{padding:var(--space-5);margin-bottom:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}
.notice{display:grid;gap:.35rem;border-inline-start:3px solid var(--color-accent-primary)}
.notice span{color:var(--text-muted);font-size:.85rem}
.panel h2{margin-top:0;font-size:1rem}
.form{display:grid;gap:var(--space-4);max-width:720px}
.form label{display:grid;gap:.4rem;font-size:.85rem}
.form input,.form select,.form textarea{font:inherit;padding:.7rem;background:var(--surface-page);color:inherit;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}
.form textarea{min-height:6rem}
.consent{display:flex!important;grid-template-columns:auto 1fr;align-items:start;gap:.65rem!important}
.consent input{margin-top:.15rem}
.correction-label{display:grid;gap:.4rem;color:var(--text-muted);font-size:.85rem}
fieldset.context{border:1px solid var(--color-border-subtle);border-radius:var(--radius-md);padding:var(--space-4);display:grid;gap:var(--space-3);margin:0}
fieldset.context legend{font-size:.8rem;font-weight:700;padding:0 .4rem}
.actions{display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap}
button{border:0;padding:.7rem 1rem;background:var(--color-accent-primary);color:#fff;border-radius:var(--radius-md);font-weight:700}
button:disabled{opacity:.5}
.advisory-label{font-size:.75rem;font-weight:700;letter-spacing:.06em;color:var(--status-warning);border:1px solid var(--status-warning);border-radius:var(--radius-sm);padding:.45rem .6rem;display:inline-block}
.status{color:var(--text-muted);font-size:.85rem}
.advisory-text{white-space:pre-wrap;font-size:.88rem;line-height:1.6;border:1px dashed var(--color-border-strong);border-radius:var(--radius-md);padding:var(--space-4)}
</style>
