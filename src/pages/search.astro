---
import AppLayout from '../ui/layouts/AppLayout.astro';
import { getDatabase } from '../shared/database/database.js';
import { PostgresSearch } from '../shared/search/postgres-search.js';
import { SearchService } from '../shared/search/search-service.js';
import type { SearchResult } from '../shared/search/search-result.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(`${Astro.url.pathname}${Astro.url.search}`)}`);
const rawQuery = Astro.url.searchParams.get('q') ?? '';
const q = rawQuery.length <= 200 && !rawQuery.includes('\0') ? rawQuery.trim() : '';
let results: SearchResult[] = [];
if (q && actor.permissions.some((grant) => grant.code === 'PERM-SRCH-USE' && grant.active !== false)) {
  try { results = await new SearchService(new PostgresSearch(getDatabase()), async (actorId) => { if (actorId !== actor.id) throw new Error('unauthorized'); }).search({ actorId: actor.id, q }); } catch { results = []; }
}
const destination = (result: SearchResult) => ({ TASK: `/tasks/${result.entityId}`, RECEIVING_ITEM: `/quarantine/receiving/${result.entityId}`, INSPECTION_REPORT: `/quarantine/inspections/${result.entityId}`, LAB_TEST: `/laboratory/tests/${result.entityId}`, FINDING: `/quality/findings/${result.entityId}`, NCR: `/quality/ncr/${result.entityId}`, CAPA: `/quality/capa/${result.entityId}`, EQUIPMENT: `/assets/equipment/${result.entityId}`, DOCUMENT: `/documents/${result.entityId}`, CHANGE_REQUEST: `/change-requests/${result.entityId}` } as Record<string, string>)[result.entityType] ?? '/dashboard';
---
<AppLayout title="Search · QC Operations" locale="en" direction="ltr">
  <section class="search-page"><p class="eyebrow">GLOBAL SEARCH</p><h1>Find authorized records</h1><form role="search" method="get"><label for="q">Search tasks, inspections, lab tests, findings, NCRs, CAPA, equipment, documents, or change requests</label><div class="search-row"><input id="q" name="q" value={rawQuery} maxlength="200" autocomplete="off" autofocus /><button type="submit">Search</button>{q && <a href="/search">Clear</a>}</div><p class="hint">Press Enter to search. Results are limited to records available in your scope.</p></form>{q ? <p class="result-count" aria-live="polite">{results.length} authorized result{results.length === 1 ? '' : 's'} for “{q}”</p> : <p class="empty">Start with a business ID, document number, lot, or description.</p>}{q && !results.length && <section class="empty" aria-live="polite"><h2>No results found</h2><p>Check the identifier or try a broader term. Unauthorized records are not disclosed.</p></section>}{results.length > 0 && <ul class="results">{results.map((result) => <li><a href={destination(result)}><span class="type">{result.entityType}</span><strong>{result.businessId}</strong><span>{result.descriptor}</span><small>{result.state}{result.context ? ` · ${result.context}` : ''}</small></a></li>)}</ul>}</section>
</AppLayout>
<style>.search-page{max-width:900px;margin-inline:auto}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.search-page h1{margin:.4rem 0 1.5rem}.search-page form{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}label{display:block;color:var(--text-secondary);font-size:.85rem;font-weight:600}.search-row{display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3)}input{flex:1;min-height:48px;padding-inline:14px;border:1px solid var(--color-border-default);border-radius:var(--radius-sm);background:var(--surface-raised);color:var(--text-primary);font:inherit}button{min-height:48px;padding-inline:18px;border:0;border-radius:var(--radius-sm);background:var(--color-accent-primary);color:var(--color-text-inverse);font-weight:700}.search-row a{color:var(--color-accent-primary-hover);font-size:.8rem}.hint,.empty,.result-count{color:var(--text-muted);font-size:.8rem}.results{list-style:none;margin:var(--space-5) 0;padding:0}.results li{border-block-start:1px solid var(--color-border-subtle)}.results a{display:grid;grid-template-columns:140px 1fr;gap:4px 14px;padding:var(--space-4) 0;color:inherit;text-decoration:none}.results .type,.results small{color:var(--text-muted);font-size:.72rem}.results span:not(.type){color:var(--text-secondary);font-size:.85rem}.empty{margin-top:var(--space-5);padding:var(--space-8);text-align:center;border:1px dashed var(--color-border-default);border-radius:var(--radius-lg)}.empty h2{color:var(--text-primary);font-size:1rem}@media(max-width:520px){.search-row{flex-wrap:wrap}.search-row input{flex-basis:100%}.results a{grid-template-columns:1fr}}
</style>
