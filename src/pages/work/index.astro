---
import PageHeader from "../../ui/components/PageHeader.astro";
import AppLayout from '../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import ProviderUnavailableState from '../../ui/components/feedback/ProviderUnavailableState.astro';
import { myWorkDependencies } from '../../modules/dashboard/application/dependencies.js';
import { AppError } from '../../shared/errors/app-error.js';
import { formatDateTime } from '../../shared/copy/format.js';
import { actorRoleLabel } from '../../shared/authorization/scope-description.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fwork');
// Nothing is rendered until the server confirms the queue: a failed read
// withholds the whole workspace instead of drawing an empty "all clear", and an
// authorization refusal is a different fact from a provider outage.
let queue: Awaited<ReturnType<ReturnType<typeof myWorkDependencies>['get']['execute']>> | undefined;
let providerUnavailable = false;
let authorizationUnavailable = false;
try {
  queue = await myWorkDependencies().get.execute(actor);
} catch (error) {
  authorizationUnavailable = error instanceof AppError && error.category === 'AUTHORIZATION';
  providerUnavailable = !authorizationUnavailable;
}
const groups = queue?.groups ?? [];
const unresolved = queue?.unresolvedSources ?? [];
---
<AppLayout title="My work today · QC Operations" locale="en" direction="ltr" scope={queue?.scopeLabel}>
  <PageHeader purpose="Assigned, due, overdue and blocked work.">
    <Fragment slot="heading"><h1>My work today</h1></Fragment>
    <Fragment slot="actions">
      {queue && (
        <p class="snapshot">
          <time datetime={queue.generatedAt.toISOString()}>Server snapshot · {formatDateTime(queue.generatedAt)}</time>
          <span>All windows in {queue.timezone}</span>
          <a href="/work">Refresh</a>
        </p>
      )}
    </Fragment>
  </PageHeader>

  <section class="identity" aria-label="Your authenticated identity">
    <p><span>Signed in as</span> <strong>{actor.loginIdentity ?? 'Your account'}</strong></p>
    <p><span>Role</span> <strong>{actorRoleLabel(actor)}</strong></p>
    <p><span>Scope</span> <strong>{queue?.scopeLabel ?? 'Not confirmed'}</strong></p>
  </section>

  <section class="panel" aria-labelledby="work-help-heading">
    <h2 id="work-help-heading">Quick help</h2>
    <p>Find role guidance and workflow walkthroughs before starting unfamiliar work.</p>
    <a href="/help">Open operating guides</a>
  </section>

  {providerUnavailable ? (
    <ProviderUnavailableState title="Your work queue is temporarily unavailable" description="A register did not return a confirmed read, so every group and count is withheld." retryHref="/work" />
  ) : authorizationUnavailable ? (
    <section class="feedback-denied" role="status"><h2>Your work queue is unavailable</h2><p>This account cannot view the requested queue. No record or count is shown.</p></section>
  ) : null}

  {!providerUnavailable && queue && (
    <>
      <p class="explainer">Group counts can overlap. Each record appears once, in its most urgent group. Do not add group counts to calculate a total.</p>
      <div class="work-groups">
      {groups.map((group, index) => (
        <section class:list={['panel', 'group-panel', { 'group-panel--priority': index === 0 }]} aria-labelledby={`group-${group.definition.category}`}>
          <div class="panel-head">
            <div>
              <h2 id={`group-${group.definition.category}`}>{group.definition.label}</h2>
              <p class="membership">{group.definition.membership}</p>
            </div>
            <p class="group-count">
              {group.count === null ? <span class="no-count">No total for your account</span> : <><strong>{group.count}</strong><span>record{group.count === 1 ? '' : 's'}</span></>}
            </p>
          </div>
          <details class="lineage">
            <summary>Source and group rules</summary>
            <dl class="definition">
              <div><dt>Ownership</dt><dd>{group.definition.ownership}</dd></div>
              <div><dt>Scope</dt><dd>{group.definition.actorScope}</dd></div>
              <div><dt>Time basis</dt><dd>{group.definition.timezone}; {group.definition.sourceTimestamp}</dd></div>
              <div><dt>Included records</dt><dd>{group.definition.predicate}</dd></div>
            </dl>
            {group.registerLinks.length > 0 && (
              <p class="links">
                <span>Source registers:</span>
                {group.registerLinks.map((link) => <a href={link.href}>{link.label} ({link.count})</a>)}
              </p>
            )}
          </details>
          <p class="state-message" role="status">{group.message}</p>
          {group.items.length > 0 ? (
            <ul class="queue">
              {group.items.map((item) => (
                <li>
                  <a class="item" href={item.href}>
                    <span class="item-main">
                      <strong>{item.title}</strong>
                      <small>{item.reason}</small>
                    </span>
                    <span class="item-meta">
                      <small class="next-action">Next: {item.nextAction}</small>
                      <small class="age">{item.ageLabel} · {item.state}</small>
                      <small>Owner: {item.responsibleRole}</small>
                      <small class="source">From: {item.sourceLabel}</small>
                    </span>
                    <StatusBadge status={item.severity} />
                  </a>
                </li>
              ))}
            </ul>
          ) : null}
        </section>
      ))}

      <section class="panel unresolved" aria-labelledby="unresolved-title">
        <div class="panel-head"><div><h2 id="unresolved-title">What this queue cannot answer yet</h2><p class="membership">Each entry names the real missing piece and who owns it.</p></div></div>
        <ul>
          {unresolved.map((source) => (
            <li>
              <strong>{source.label}</strong>
              <span>{source.reason}</span>
              <small>Owner: {source.owner}</small>
            </li>
          ))}
        </ul>
        <p class="unresolved-note">Missing evidence is never converted into completion: a group with no source says so rather than showing a zero.</p>
      </section>

      <section class="panel note"><strong>PASS and RELEASED are separate</strong><p>A scientific PASS is an inspection result, not a release decision. A receiving item on HOLD cannot be released by any of these links.</p></section>

      <!-- INP-01: contextual entry only. In-process controls are a separate
           workspace with their own register; no sidebar group is added and no
           queue assignment is claimed here. -->
      <section class="panel in-process" aria-labelledby="in-process-link-title">
        <h2 id="in-process-link-title">In-process controls</h2>
        <p class="membership">Production checks recorded against a pinned effective work instruction. These are not inspection reports and never release product.</p>
        <a class="in-process-link" href="/in-process">Open in-process controls</a>
      </section>
      </div>
    </>
  )}
</AppLayout>
<style>
  .snapshot{display:grid;gap:.25rem;justify-items:end;text-align:end;color:var(--text-muted);font-size:var(--font-size-xs);margin:0}
  .snapshot a{font-size:var(--font-size-xs);font-weight:600}
  .identity{display:flex;flex-wrap:wrap;gap:var(--space-4) var(--space-8);margin-block-end:var(--space-5);padding:var(--space-4) var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}
  .identity p{margin:0;color:var(--text-muted);font-size:var(--font-size-xs)}
  .identity span{display:block;margin-block-end:2px}
  .identity strong{color:var(--text-primary);font-weight:600;overflow-wrap:anywhere}
  .explainer,.membership,.state-message,.unresolved-note{color:var(--text-muted);font-size:var(--font-size-sm)}
  .explainer{margin:0 0 var(--space-4);padding-inline-start:var(--space-3)}
  .work-groups{display:grid;gap:var(--space-4);grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}
  .panel{min-inline-size:0;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}
  .group-panel--priority{grid-column:1 / -1;background:var(--surface-inset);border-color:var(--border-default)}
  .panel-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}
  .panel h2{margin:0;font-size:var(--font-size-md);line-height:var(--line-height-tight)}
  .membership{margin:.35rem 0 0;max-inline-size:72ch;line-height:1.5}
  .group-count{display:flex;align-items:baseline;gap:.35rem;margin:0;color:var(--text-muted);font-size:var(--font-size-xs);white-space:nowrap}
  .group-count strong{color:var(--color-accent-primary-hover);font-size:24px;font-variant-numeric:tabular-nums}
  .no-count{color:var(--status-warning);font-weight:700}
  .lineage{margin-block-start:var(--space-3);padding-block-start:var(--space-2);border-block-start:1px solid var(--color-border-subtle);font-size:var(--font-size-xs)}
  .lineage summary{min-block-size:44px;display:flex;align-items:center;color:var(--color-accent-primary-hover);cursor:pointer}
  .lineage summary:focus-visible,.item:focus-visible,.links a:focus-visible,.snapshot a:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px;border-radius:var(--radius-sm)}
  .definition{display:grid;gap:var(--space-2);margin:var(--space-2) 0 0;color:var(--text-muted);font-size:var(--font-size-xs);line-height:1.5}
  .definition div{display:grid;grid-template-columns:minmax(7rem,.35fr) minmax(0,1fr);gap:var(--space-2)}
  .definition dt{color:var(--text-secondary);font-weight:700}
  .definition dd{margin:0;min-inline-size:0;overflow-wrap:anywhere}
  .links{display:flex;flex-wrap:wrap;gap:var(--space-2) var(--space-4);align-items:center;margin:var(--space-3) 0 0;color:var(--text-muted);font-size:var(--font-size-xs)}
  .links a{display:inline-flex;align-items:center;min-block-size:44px;color:var(--color-accent-primary-hover);font-weight:600;overflow-wrap:anywhere}
  .state-message{margin:var(--space-3) 0 0;line-height:1.5}
  .queue{list-style:none;margin:var(--space-3) 0 0;padding:0}
  .queue li{border-block-start:1px solid var(--color-border-subtle)}
  .item{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) auto;gap:var(--space-4);align-items:center;min-block-size:64px;padding:var(--space-3);margin-inline:calc(-1 * var(--space-3));border-radius:var(--radius-md);color:inherit;text-decoration:none}
  .item:hover{background:var(--color-surface-hover)}
  .item-main,.item-meta{min-inline-size:0}
  .item-main strong,.item-main small,.item-meta small{display:block;overflow-wrap:anywhere}
  .item-main strong{line-height:1.4}
  .item-main small,.item-meta small{color:var(--text-muted);font-size:var(--font-size-xs);margin-block-start:4px;line-height:1.45}
  .item-meta .next-action{color:var(--text-primary);font-size:var(--font-size-sm);font-weight:700}
  .item-meta .age{color:var(--text-secondary);font-weight:600}
  .item-meta .source{color:var(--text-secondary)}
  .unresolved{grid-column:1 / -1;background:var(--surface-panel)}
  .unresolved ul{list-style:none;margin:var(--space-3) 0 0;padding:0}
  .unresolved li{display:grid;gap:4px;padding-block:var(--space-3);border-block-start:1px solid var(--color-border-subtle);font-size:var(--font-size-sm);color:var(--text-secondary)}
  .unresolved li strong,.unresolved li span,.unresolved li small{overflow-wrap:anywhere}
  .unresolved li small{color:var(--text-muted);font-size:var(--font-size-xs)}
  .unresolved-note{margin:var(--space-3) 0 0}
  .note{grid-column:1 / -1;border-color:var(--status-warning);background:var(--status-warning-bg)}
  .in-process{grid-column:1 / -1}
  .in-process-link{display:inline-flex;align-items:center;min-block-size:44px;margin-block-start:var(--space-2);font-weight:600;overflow-wrap:anywhere}
  .note p{margin:.35rem 0 0;color:var(--text-secondary);font-size:var(--font-size-sm);line-height:1.5}
  .feedback-denied{padding:var(--space-5);background:var(--status-warning-bg);border:1px solid var(--status-warning);border-radius:var(--radius-lg)}
  .feedback-denied h2{margin:0;font-size:var(--font-size-md)}
  .feedback-denied p{margin:var(--space-2) 0 0;color:var(--text-secondary);font-size:var(--font-size-sm)}
  @media(max-width:980px){.work-groups{grid-template-columns:1fr}.group-panel--priority,.unresolved,.note{grid-column:auto}}
  @media(max-width:760px){.snapshot{justify-items:start;text-align:start}.identity{gap:var(--space-3) var(--space-5)}.panel{padding:var(--space-4)}.panel-head{display:grid;gap:var(--space-2)}.group-count{white-space:normal}.definition div{grid-template-columns:1fr;gap:0}.item{grid-template-columns:minmax(0,1fr) auto;align-items:start}.item-meta{grid-column:1 / -1;grid-row:2}.item :global(.status-badge){grid-column:2;grid-row:1}}
  @media print{.work-groups{grid-template-columns:minmax(0,1fr)}.group-panel--priority,.unresolved,.note{grid-column:auto}.panel{break-inside:avoid-page}.lineage:not([open])>:not(summary){display:revert!important}}
</style>
