---
import AppLayout from '../../ui/layouts/AppLayout.astro';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fchange-requests%2Fnew');
const canCreate = actor.permissions.some((permission) => permission.active !== false && permission.code === 'PERM-CHG-CREATE');
---
<AppLayout title="New Change Request · QC Operations" locale="en" direction="ltr">
  <section class="head"><div><p class="eyebrow">GOV-CHG-002 · DRAFT ONLY</p><h1>New change request</h1><p>This records a proposed change and its target snapshot. It does not apply, approve, or release the target.</p></div><a href="/change-requests">Back to register</a></section>
  {canCreate ? <form class="form" data-action="change-requests.create"><fieldset><legend>Request context</legend><div class="fields"><label for="changeNo">Change number<input id="changeNo" name="changeNo" required /></label><label for="targetType">Target type<input id="targetType" name="targetType" placeholder="DOCUMENT_VERSION" required /></label><label for="targetId">Target ID<input id="targetId" name="targetId" type="text" required aria-describedby="targetId-help" /><small id="targetId-help">Use the UUID of the controlled target record.</small></label><label for="targetVersion">Target version<input id="targetVersion" name="targetVersion" type="number" min="1" step="1" required /></label><label class="wide" for="reason">Reason<textarea id="reason" name="reason" rows="3" required></textarea></label><label class="wide" for="targetSnapshot">Target snapshot (JSON)<textarea id="targetSnapshot" name="targetSnapshot" rows="6" required aria-describedby="snapshot-help">{`{}`}</textarea><small id="snapshot-help">Paste the approved current context captured for review; no scientific limits or policy values are inferred here.</small></label></div></fieldset><fieldset><legend>Proposed field change</legend><div class="fields"><label for="fieldPath">Field path<input id="fieldPath" name="fieldPath" placeholder="metadata.owner" required /></label><label for="dataType">Data type<input id="dataType" name="dataType" placeholder="string" required /></label><label for="currentValue">Current value<textarea id="currentValue" name="currentValue" rows="3"></textarea></label><label for="proposedValue">Proposed value<textarea id="proposedValue" name="proposedValue" rows="3"></textarea></label></div></fieldset><p class="error" data-error role="alert" hidden>Unable to create the change request. Check the fields and try again.</p><div class="actions"><a href="/change-requests">Cancel</a><button type="submit">Create draft</button></div></form> : <section class="denied" role="alert"><h2>Creation unavailable</h2><p>Your account does not have the explicit change-request create permission.</p></section>}
</AppLayout>
<script>
// @ts-expect-error Astro generates the action client module during the build.
import { actions } from 'astro:actions';
const form = document.querySelector<HTMLFormElement>('[data-action="change-requests.create"]');
const parse = (value: FormDataEntryValue | null) => { const text = String(value ?? '').trim(); return text ? JSON.parse(text) : undefined; };
form?.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(form); const error = form.querySelector<HTMLElement>('[data-error]'); try { const result = await actions.changeRequests.create({ changeNo: String(data.get('changeNo')), targetType: String(data.get('targetType')), targetId: String(data.get('targetId')), targetVersion: BigInt(String(data.get('targetVersion'))), reason: String(data.get('reason')), targetSnapshot: parse(data.get('targetSnapshot')) ?? {}, changes: [{ fieldPath: String(data.get('fieldPath')), currentValue: parse(data.get('currentValue')), proposedValue: parse(data.get('proposedValue')), dataType: String(data.get('dataType')) }] }); if (result.data) window.location.href = `/change-requests/${result.data.changeRequest.id}`; else if (error) error.hidden = false; } catch { if (error) error.hidden = false; } });
</script>
<style>.head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:start;margin-bottom:var(--space-6)}h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.head p:not(.eyebrow),.denied p,.error,small{color:var(--text-muted);font-size:.85rem}.head a,.actions a{color:var(--color-accent-primary-hover)}.form{max-width:980px;display:grid;gap:var(--space-5)}fieldset{padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}legend{padding-inline:.5rem;font-weight:700}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}label.wide{grid-column:1/-1}input,textarea{width:100%;min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.actions{display:flex;justify-content:flex-end;gap:var(--space-3);align-items:center}.actions button{min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}.error{margin:0;padding:.75rem;border-inline-start:3px solid var(--status-danger);background:var(--surface-panel)}@media(max-width:650px){.head{display:grid}.fields{grid-template-columns:1fr}label.wide{grid-column:auto}.actions{justify-content:stretch;display:grid}}</style>
