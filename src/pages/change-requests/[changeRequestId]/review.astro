---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { changeRequestsReadDependencies } from '../../../modules/change-requests/application/dependencies.js';
import { isUuid } from '../../../shared/id/uuid.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const id = Astro.params.changeRequestId ?? '';
if (!isUuid(id)) return Astro.redirect('/404');
let aggregate;
try { aggregate = await changeRequestsReadDependencies().get.execute({ actor, id }); } catch { return Astro.redirect('/404'); }
if (!aggregate) return Astro.redirect('/404');
const { changeRequest, changes } = aggregate;
const permission = (code: string) => actor.permissions.some((item) => item.active !== false && item.code === code);
const canStartReview = changeRequest.state === 'SUBMITTED' && permission('PERM-CHG-REVIEW') && permission('PERM-APR-REVIEW');
const canDecide = changeRequest.state === 'UNDER_REVIEW' && permission('PERM-CHG-APPROVE') && permission('PERM-APR-APPROVE');
const canReturn = changeRequest.state === 'UNDER_REVIEW' && permission('PERM-CHG-RETURN') && permission('PERM-APR-RETURN');
const canReject = changeRequest.state === 'UNDER_REVIEW' && permission('PERM-CHG-REJECT') && permission('PERM-APR-REJECT');
const stringify = (value: unknown) => { try { return JSON.stringify(value, (_, item) => typeof item === 'bigint' ? item.toString() : item); } catch { return '[unavailable]'; } };
---
<AppLayout title={`Review ${changeRequest.changeNo} · QC Operations`} locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">GOV-CHG-004 · EXPLICIT REVIEW CAPABILITY</p><h1>Review {changeRequest.changeNo}</h1><p class="lede">Version {changeRequest.version.toString()} · target version {changeRequest.targetVersion.toString()}</p></div><a href={`/change-requests/${changeRequest.id}`}>Back to record</a></section>
  <section class="notice" role="note"><strong>Controlled decision boundary</strong><span>Approval records a decision against this request version. It does not silently edit the target record or mean RELEASED.</span></section>
  <section class="panel"><h2>Proposed changes</h2><p>{changeRequest.reason}</p><ul>{changes.map((change) => <li><strong>{change.fieldPath}</strong>: <code>{stringify(change.currentValue)}</code> → <code>{stringify(change.proposedValue)}</code></li>)}</ul></section>
  {canStartReview && <form class="decision" data-action="start-review" data-change-request-id={changeRequest.id} data-change-request-version={changeRequest.version.toString()}><input type="hidden" name="action" value="START_REVIEW" /><button type="submit">Start review</button></form>}
  {(canDecide || canReturn || canReject) && <form class="decision" data-action="decision" data-change-request-id={changeRequest.id} data-change-request-version={changeRequest.version.toString()}><label for="reason">Decision reason (required for return/reject)<textarea id="reason" name="reason" rows="3"></textarea></label><div class="actions">{canReturn && <button type="submit" data-action-value="RETURN">Return</button>}{canReject && <button type="submit" data-action-value="REJECT">Reject</button>}{canDecide && <button type="submit" data-action-value="APPROVE">Approve change request</button>}</div><p class="muted">The server re-checks permission, scope, SoD, state, and version; these controls are only a presentation hint.</p></form>}
  {!canStartReview && !canDecide && !canReturn && !canReject && <section class="denied" role="alert"><h2>Review unavailable</h2><p>Your account lacks the explicit capability and matching generic approval permission for this state, or the request is no longer actionable.</p></section>}
</AppLayout>
<script>
// @ts-expect-error Astro generates the action client module during the build.
import { actions } from 'astro:actions';
const transition = async (form: HTMLFormElement, action: string, reason: string) => { const result = await actions.changeRequests.transition({ id: String(form.dataset.changeRequestId), action, expectedVersion: BigInt(form.dataset.changeRequestVersion ?? '0'), reason: reason || undefined }); if (result.data) window.location.href = `/change-requests/${result.data.changeRequest.id}`; };
const startForm = document.querySelector<HTMLFormElement>('[data-action="start-review"]');
const decisionForm = document.querySelector<HTMLFormElement>('[data-action="decision"]');
const run = async (form: HTMLFormElement, action: string) => { const button = form.querySelector<HTMLButtonElement>('button[type="submit"]'); if (button) button.disabled = true; try { await transition(form, action, String(new FormData(form).get('reason') ?? '')); } finally { if (button) button.disabled = false; } };
if (startForm) startForm.addEventListener('submit', (event) => { event.preventDefault(); void run(startForm, 'START_REVIEW'); });
if (decisionForm) decisionForm.addEventListener('submit', (event) => { event.preventDefault(); const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null; void run(decisionForm, submitter?.dataset.actionValue ?? ''); });
</script>
<style>.page-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:start;margin-bottom:var(--space-6)}h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.muted{color:var(--text-muted);font-size:.86rem}.page-head a{color:var(--color-accent-primary-hover)}.notice,.panel,.decision,.denied{padding:var(--space-5);margin-bottom:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}.notice{display:grid;gap:.35rem;border-inline-start:3px solid var(--status-warning)}.notice span{color:var(--text-muted);font-size:.85rem}.panel h2,.denied h2{margin-top:0;font-size:1rem}.panel li{margin:.6rem 0}.decision{display:grid;gap:var(--space-4)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}textarea{width:100%;padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.actions{display:flex;gap:var(--space-3);flex-wrap:wrap}.actions button,.decision>button{min-height:var(--control-height);padding:.65rem 1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.actions button:first-child{background:transparent;color:var(--color-accent-primary-hover)}.denied{border-inline-start:3px solid var(--status-warning)}code{overflow-wrap:anywhere}@media(max-width:650px){.page-head{display:grid}.actions{display:grid}}</style>
