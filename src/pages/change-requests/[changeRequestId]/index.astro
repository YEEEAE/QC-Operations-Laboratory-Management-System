---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { changeRequestsReadDependencies } from '../../../modules/change-requests/application/dependencies.js';
import { isUuid } from '../../../shared/id/uuid.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const id = Astro.params.changeRequestId ?? '';
if (!isUuid(id)) return Astro.redirect('/404');
let aggregate;
try { aggregate = await changeRequestsReadDependencies().get.execute({ actor, id }); } catch { return Astro.redirect('/404'); }
if (!aggregate) return Astro.redirect('/404');
const { changeRequest, changes, history, applicationAttempts } = aggregate;
const canReview = actor.permissions.some((permission) => permission.active !== false && ['PERM-CHG-REVIEW', 'PERM-CHG-RETURN', 'PERM-CHG-APPROVE', 'PERM-CHG-REJECT'].includes(permission.code));
const stringify = (value: unknown) => { try { return JSON.stringify(value, (_, item) => typeof item === 'bigint' ? item.toString() : item, 2); } catch { return '[unavailable]'; } };
---
<AppLayout title={`${changeRequest.changeNo} · Change Request`} locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">GOV-CHG-003 · CONTROLLED RECORD</p><h1>{changeRequest.changeNo}</h1><p class="lede">Target: {changeRequest.targetType} · {changeRequest.targetId}</p></div><div class="head-actions"><span class="state">{changeRequest.state}</span>{canReview && (changeRequest.state === 'SUBMITTED' || changeRequest.state === 'UNDER_REVIEW') && <a class="button" href={`/change-requests/${changeRequest.id}/review`}>Open review</a>}<a href="/change-requests">All requests</a></div></section>
  <div class="grid"><section class="panel"><h2>Control context</h2><dl><div><dt>Request version</dt><dd>{changeRequest.version.toString()}</dd></div><div><dt>Target version at request</dt><dd>{changeRequest.targetVersion.toString()}</dd></div><div><dt>Requested by</dt><dd>{changeRequest.requestedBy}</dd></div><div><dt>Reason</dt><dd>{changeRequest.reason}</dd></div></dl></section><section class="panel"><h2>Captured target snapshot</h2><p class="muted">This snapshot is review evidence; it is not a live target read and does not authorize a rewrite.</p><pre>{stringify(changeRequest.targetSnapshot)}</pre></section></div>
  <section class="panel"><h2>Proposed changes</h2><div class="table-wrap"><table><caption>Field-level proposed changes</caption><thead><tr><th scope="col">Field path</th><th scope="col">Current</th><th scope="col">Proposed</th><th scope="col">Data type</th></tr></thead><tbody>{changes.map((change) => <tr><th scope="row">{change.fieldPath}</th><td><code>{stringify(change.currentValue)}</code></td><td><code>{stringify(change.proposedValue)}</code></td><td>{change.dataType}</td></tr>)}</tbody></table></div></section>
  <section class="panel"><h2>Audit history</h2>{history.length ? <ol class="timeline">{history.map((event) => <li><strong>{event.action}</strong><span>{event.oldState ?? '—'} → {event.newState ?? '—'} · {event.occurredAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' })}</span><small>Request: {event.requestId}{event.reason ? ` · ${event.reason}` : ''}</small></li>)}</ol> : <p class="muted">No audit events are available for this record.</p>}</section>
  {applicationAttempts.length > 0 && <section class="panel"><h2>Application attempts</h2><p class="muted">Application is an internal controlled operation after approval. It is never triggered by this GET page.</p><ul>{applicationAttempts.map((attempt) => <li>Attempt {attempt.attemptNo}: {attempt.result}{attempt.errorCode ? ` · ${attempt.errorCode}` : ''}</li>)}</ul></section>}
</AppLayout>
<style>.page-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:start;margin-bottom:var(--space-6)}h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.muted{color:var(--text-muted);font-size:.86rem}.head-actions{display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap}.head-actions a{color:var(--color-accent-primary-hover)}.button{border:1px solid var(--color-accent-primary);background:var(--color-accent-primary);color:#fff!important;padding:.65rem 1rem;border-radius:var(--radius-md);text-decoration:none;font-weight:700}.state{padding:.45rem .7rem;border:1px solid var(--color-border-strong);border-radius:999px;font-size:.75rem;font-weight:700}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-5);margin-bottom:var(--space-5)}.panel{padding:var(--space-5);margin-bottom:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}h2{margin-top:0;font-size:1rem}dl{display:grid;gap:var(--space-3);margin:0}dl div{display:flex;justify-content:space-between;gap:var(--space-4);border-bottom:1px solid var(--color-border-subtle);padding-bottom:.55rem}dt{color:var(--text-muted);font-size:.8rem}dd{margin:0;text-align:end;font-size:.8rem;overflow-wrap:anywhere}pre{max-height:360px;overflow:auto;padding:var(--space-4);background:var(--surface-raised);border-radius:var(--radius-sm);font-size:.75rem;white-space:pre-wrap}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse}caption{text-align:start;padding-bottom:var(--space-3);color:var(--text-muted);font-size:.8rem}th,td{padding:.7rem;text-align:start;border-top:1px solid var(--color-border-subtle);font-size:.8rem;vertical-align:top}th{font-weight:700}code{white-space:pre-wrap;overflow-wrap:anywhere}.timeline{display:grid;gap:var(--space-3);padding-inline-start:1.25rem}.timeline li{display:grid;gap:.25rem}.timeline span,.timeline small{color:var(--text-muted);font-size:.78rem}@media(max-width:700px){.page-head,.grid{display:grid}.head-actions{justify-content:start}dl div{display:grid;gap:.2rem}dd{text-align:start}}</style>
