---
import { actions } from 'astro:actions';
import { field } from '../../../ui/forms/mutation-post.js';
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import PolicyBlocker from '../../../ui/components/feedback/PolicyBlocker.astro';
import JourneyContextPanel from '../../../ui/components/workflow/JourneyContextPanel.astro';
import StatusBadge from '../../../ui/components/StatusBadge.astro';
import { rcaReadDependencies } from '../../../modules/quality/rca/application/dependencies.js';
import { ncrReadDependencies } from '../../../modules/quality/ncr/application/dependencies.js';
import { capaReadDependencies } from '../../../modules/quality/capa/application/dependencies.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { formatDateTime } from '../../../shared/copy/format.js';
import { readOutcome } from '../../../shared/errors/read-outcome.js';
import { classifyReadFailure } from '../../../shared/errors/read-failure.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquality%2Frca');
const rcaId = Astro.params.rcaId ?? '';
const validId = /^[0-9a-f-]{36}$/i.test(rcaId);
let rca: Awaited<ReturnType<ReturnType<typeof rcaReadDependencies>['get']['execute']>> | undefined;
let unavailable = false;
if (validId) {
  try { rca = await rcaReadDependencies().get.execute({ actor, id: rcaId }); }
  catch (error) {
    if (classifyReadFailure(error) === 'UNAVAILABLE') unavailable = true;
  }
}
if (!validId || (!rca && !unavailable)) Astro.response.status = 404;
if (unavailable) Astro.response.status = 503;
let ncr: Awaited<ReturnType<ReturnType<typeof ncrReadDependencies>['get']['execute']>> | undefined;
let relatedCapas: Awaited<ReturnType<ReturnType<typeof capaReadDependencies>['list']['execute']>> = [];
let ncrStatus: 'AVAILABLE' | 'NOT_VISIBLE' | 'UNAVAILABLE' = 'NOT_VISIBLE';
let capaStatus: 'AVAILABLE' | 'NOT_VISIBLE' | 'UNAVAILABLE' = 'NOT_VISIBLE';
if (rca) {
  const [ncrResult, capaResult] = await Promise.all([
    readOutcome(() => ncrReadDependencies().get.execute({ actor, id: rca!.ncrId })),
    readOutcome(() => capaReadDependencies().list.execute({ actor })),
  ]);
  ncrStatus = ncrResult.status;
  capaStatus = capaResult.status;
  if (ncrResult.status === 'AVAILABLE') ncr = ncrResult.value;
  if (capaResult.status === 'AVAILABLE') relatedCapas = capaResult.value.filter((capa) => capa.ncrId === rca?.ncrId);
}
let mutationError = '';
let submittedValues: { method: string; analysis: string; rootCause: string; expectedVersion: string } | undefined;
if (Astro.request.method === 'POST' && rca) {
  const form = await Astro.request.formData();
  const expectedVersion = field(form, 'expectedVersion');
  submittedValues = { method: field(form, 'method'), analysis: field(form, 'analysis'), rootCause: field(form, 'rootCause'), expectedVersion };
  try {
    const operation = field(form, 'operation');
    const result = operation === 'UPDATE'
      ? await Astro.callAction(actions.rca.update, { rcaId: rca.id, ...submittedValues, expectedVersion: BigInt(expectedVersion) })
      : await Astro.callAction(actions.rca.transition, { id: rca.id, expectedVersion: BigInt(expectedVersion), action: operation as 'START' | 'SUBMIT' });
    if (!result.error) return Astro.redirect(`/quality/rca/${rca.id}`, 303);
    mutationError = 'The change was not confirmed. Check the saved record before retrying; your submitted values are retained.';
  } catch { mutationError = 'The change was refused. Check access, state and the opened version. Your submitted values are retained.'; }
}
const reference = rca?.rcaNo ?? (ncr ? `RCA for ${ncr.ncrNo}` : 'Root-cause analysis');
const nextOwner = rca?.state === 'DRAFT' || rca?.state === 'IN_PROGRESS' || rca?.state === 'RETURNED' ? 'Assigned RCA analyst' : rca?.state === 'SUBMITTED' ? 'Authorized RCA reviewer' : undefined;
const nextStep = rca?.state === 'SUBMITTED' ? 'Await the authorized review decision' : rca?.state === 'APPROVED' ? 'Return to the linked NCR and review its permitted next step' : rca?.state === 'VOID' ? 'Record is void; history remains available' : 'Continue analysis through the authorized RCA workflow';
---
<AppLayout title={`${reference} · RCA · Quality`} locale="en" direction="ltr">
  {unavailable ? <div class="shell"><h1>RCA details are temporarily unavailable</h1><ProviderUnavailableState title="The record source could not be reached" /><p><a href="/quality/rca">Return to the RCA register</a> and retry when the source is available.</p></div> : rca ? <div class="shell">
    <header class="record-heading">
      <div>
        <p class="eyebrow">Quality record · RCA</p>
        <h1>{reference}</h1>
        <p class="record-identity">Record ID <code>{rca.id}</code></p>
      </div>
      <div class="record-state"><span>Current state</span><StatusBadge status={rca.state === 'APPROVED' ? 'APPROVED' : rca.state === 'VOID' ? 'VOID' : rca.state === 'DRAFT' ? 'DRAFT' : 'REVIEW'} label={stateLabel(rca.state)} /><span>Version {rca.version.toString()}</span></div>
    </header>
    <JourneyContextPanel ownerDomain="Quality / RCA" recordReference={`${reference} · version ${rca.version.toString()}`} currentState={stateLabel(rca.state)} nextOwner={nextOwner} waitingOn={rca.state === 'SUBMITTED' ? 'Authorized RCA review' : undefined} expectedEvent={nextStep} whyUnavailable={rca.state === 'APPROVED' ? 'state: the analysis is approved; NCR closure remains subject to the QMS owner decision (PD-17)' : rca.state === 'VOID' ? 'state: this analysis is void and read-only' : undefined} controlledContext={`${reference} · version ${rca.version.toString()}`} evidenceSummary={`Method ${rca.method ?? 'not recorded'} · analysis ${rca.analysis ? 'recorded' : 'not recorded'} · root cause ${rca.rootCause ? 'recorded' : 'not recorded'}`} auditHref={`/audit?subjectType=RCA&subjectId=${encodeURIComponent(rca.id)}`} relatedLinks={[{ label: ncr ? `NCR ${ncr.ncrNo}` : 'NCR register', href: ncr ? `/quality/ncr/${ncr.id}` : '/quality/ncr', detail: 'Source non-conformance record' }, ...(ncr?.findingId ? [{ label: `Finding ${ncr.findingId}`, href: `/quality/findings/${encodeURIComponent(ncr.findingId)}`, detail: 'Source finding linked by the NCR' }] : []), ...relatedCapas.map((capa) => ({ label: `CAPA ${capa.capaNo}`, href: `/quality/capa/${capa.id}`, detail: stateLabel(capa.state) }))]} />
    {mutationError && <p role="alert">{mutationError}</p>}
    <div class="record-layout">
      <div class="record-content">
    <section class="details" aria-labelledby="analysis-heading"><h2 id="analysis-heading">Analysis facts and evidence</h2><dl><dt>Method</dt><dd>{rca.method ?? 'Not recorded'}</dd><dt>Analysis</dt><dd>{rca.analysis ?? 'Not recorded'}</dd><dt>Root cause</dt><dd>{rca.rootCause ?? 'Not recorded'}</dd><dt>Record ID</dt><dd><code>{rca.id}</code></dd><dt>Record version</dt><dd>{rca.version.toString()}</dd></dl></section>
    <section class="details" aria-labelledby="history-heading"><h2 id="history-heading">Record history</h2><dl><dt>Created</dt><dd>{formatDateTime(rca.createdAt)}</dd><dt>Last updated</dt><dd>{formatDateTime(rca.updatedAt)}</dd><dt>Submitted</dt><dd>{rca.submittedAt ? formatDateTime(rca.submittedAt) : 'Not submitted'}</dd><dt>Approved</dt><dd>{rca.approvedAt ? formatDateTime(rca.approvedAt) : 'Not approved'}</dd></dl></section>
    <section class="related" aria-labelledby="ncr-heading"><h2 id="ncr-heading">Source NCR</h2>{ncr ? <><p><a href={`/quality/ncr/${ncr.id}`}>{ncr.ncrNo}</a> · {stateLabel(ncr.state)} · {ncr.title}</p><dl><dt>NCR ID</dt><dd><code>{ncr.id}</code></dd><dt>Version</dt><dd>{ncr.version.toString()}</dd><dt>Description</dt><dd>{ncr.description}</dd><dt>Affected item</dt><dd>{ncr.affectedItemCode ?? 'Not recorded'}</dd><dt>Affected lot</dt><dd>{ncr.affectedLot ?? 'Not recorded'}</dd></dl>{ncr.findingId ? <p class="relationship"><strong>Source Finding:</strong> <a href={`/quality/findings/${encodeURIComponent(ncr.findingId)}`}><code>{ncr.findingId}</code></a></p> : <p class="relationship"><strong>Source Finding:</strong> Not supplied by the NCR record.</p>}</> : <p>{ncrStatus === 'UNAVAILABLE' ? 'The linked NCR source is temporarily unavailable. Retry this relationship.' : 'The source NCR is not visible in your authorized scope.'}</p>}</section>
    <section class="related" aria-labelledby="capas-heading"><h2 id="capas-heading">Related CAPAs</h2>{capaStatus === 'UNAVAILABLE' ? <p>The CAPA source is temporarily unavailable. Retry this relationship.</p> : capaStatus === 'NOT_VISIBLE' ? <p>Related CAPA details are not available in your authorized scope.</p> : relatedCapas.length ? <ul>{relatedCapas.map((capa) => <li><a href={`/quality/capa/${capa.id}`}>CAPA {capa.capaNo}</a> · {stateLabel(capa.state)} · version {capa.version.toString()}<p>{capa.title}</p></li>)}</ul> : <p>No linked CAPA is visible in your authorized scope.</p>}</section>
    <PolicyBlocker decisions={[
      { id: 'PD-17', owner: 'QMS process owner', consequence: 'The NCR closure decision remains pending. RCA approval does not close the linked NCR.' },
      { id: 'PD-18', owner: 'Quality-policy owner', consequence: 'CAPA effectiveness requirements and acceptance criteria remain undecided. No effectiveness result is inferred.' },
    ]} />
      </div>
      <aside class="action-rail" aria-labelledby="actions-heading">
        <h2 id="actions-heading">Current actions</h2>
        {['DRAFT', 'IN_PROGRESS', 'RETURNED'].includes(rca.state) ? <section class="action-card"><h3>Edit analysis</h3><form method="post"><input type="hidden" name="operation" value="UPDATE" /><input type="hidden" name="expectedVersion" value={submittedValues?.expectedVersion ?? rca.version.toString()} />
      <label for="method">Method<input id="method" name="method" maxlength="200" value={submittedValues?.method ?? rca.method ?? ''} /></label>
      <label for="analysis">Analysis<textarea id="analysis" name="analysis" maxlength="50000">{submittedValues?.analysis ?? rca.analysis ?? ''}</textarea></label>
      <label for="rootCause">Root cause<textarea id="rootCause" name="rootCause" maxlength="10000">{submittedValues?.rootCause ?? rca.rootCause ?? ''}</textarea></label><button type="submit">Save analysis</button></form>
        {['DRAFT', 'RETURNED'].includes(rca.state) && <form method="post"><input type="hidden" name="operation" value="START" /><input type="hidden" name="expectedVersion" value={submittedValues?.expectedVersion ?? rca.version.toString()} /><button type="submit">Start analysis</button></form>}
        {rca.state === 'IN_PROGRESS' && <form method="post"><input type="hidden" name="operation" value="SUBMIT" /><input type="hidden" name="expectedVersion" value={submittedValues?.expectedVersion ?? rca.version.toString()} /><button type="submit">Submit recorded analysis for review</button></form>}
        </section> : <section class="action-card"><h3>Workflow status</h3><p>{rca.state === 'SUBMITTED' ? 'Awaiting the controlled RCA approval policy and electronic signature ceremony. Approval, return and void remain unavailable.' : rca.state === 'APPROVED' ? 'The RCA is approved. Continue in the linked NCR; its closure remains subject to PD-17.' : 'This RCA is void and read-only; its history remains available.'}</p><p><strong>Next step:</strong> {nextStep}</p></section>}
      </aside>
    </div>
  </div> : <div class="shell"><h1>RCA record not found</h1><p>This record does not exist or is outside your authorized scope.</p><p><a href="/quality/rca">Return to the RCA register</a> to find an accessible record.</p></div>}
</AppLayout>
<style>
  form,label{display:grid;gap:.6rem}form{margin-block:var(--space-3)}input,textarea{max-width:100%;width:100%;box-sizing:border-box;background:var(--surface-panel);color:var(--text-primary);padding:.75rem;border:1px solid var(--control-border);border-radius:var(--radius-sm);font:inherit}input,button{min-height:44px}textarea{min-height:8rem;resize:vertical}button{width:max-content;max-width:100%;min-height:44px;padding-inline:var(--space-4);border:1px solid var(--control-border);border-radius:var(--radius-sm);background:var(--surface-raised);color:var(--text-primary);font:inherit;font-weight:700;cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}.shell{max-width:88rem;margin:0 auto;padding:var(--space-6) var(--space-4)}.record-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-5);padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}h1{margin:.25rem 0 var(--space-2);overflow-wrap:anywhere}.eyebrow{margin:0;color:var(--text-muted);font-size:var(--font-size-xs);font-weight:700;letter-spacing:.08em}.record-identity,.record-state{display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-2);color:var(--text-secondary);font-size:var(--font-size-sm)}.record-state{display:grid;justify-items:start;flex:none}.record-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,24rem);align-items:start;gap:var(--space-5)}.record-content{min-width:0}.details,.related{margin-top:var(--space-4);padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md)}h2{margin:0 0 var(--space-3);font-size:var(--font-size-lg)}h3{margin:0 0 var(--space-3);font-size:var(--font-size-md)}dl{display:grid;grid-template-columns:minmax(8rem,max-content) minmax(0,1fr);gap:.65rem 1rem}dt{font-weight:700}dd{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}.relationship{margin-block:var(--space-3) 0;overflow-wrap:anywhere}.related a,.shell a{color:var(--color-accent-primary-hover)}.related ul{display:grid;gap:var(--space-3);padding-inline-start:1.25rem}.related li{min-width:0;overflow-wrap:anywhere}.related li p{margin:.35rem 0 0;color:var(--text-secondary)}.action-rail{position:sticky;inset-block-start:var(--space-4);margin-top:var(--space-4);padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md)}.action-card{padding:var(--space-3);background:var(--surface-raised);border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}.action-card label{font-weight:700}.action-card input,.action-card textarea{font-weight:400}.action-card form+form{padding-top:var(--space-3);border-top:1px solid var(--color-border-subtle)}[role=alert]{padding:var(--space-3);border-inline-start:3px solid var(--status-danger);background:var(--status-danger-bg);color:var(--text-primary);overflow-wrap:anywhere}
  @media(max-width:900px){.record-layout{grid-template-columns:minmax(0,1fr)}.action-rail{position:static;grid-row:1}.record-heading{display:grid}.record-state{grid-template-columns:auto auto;align-items:center}}
  @media(max-width:560px){.shell{padding:var(--space-4) var(--space-3)}.record-heading{padding:var(--space-4)}dl{grid-template-columns:minmax(0,1fr);gap:.25rem}.details dd{margin-bottom:.65rem}.action-rail{padding:var(--space-3)}}
</style>
