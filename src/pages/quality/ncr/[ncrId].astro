---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import JourneyContextPanel from '../../../ui/components/workflow/JourneyContextPanel.astro';
import { ncrReadDependencies } from '../../../modules/quality/ncr/application/dependencies.js';
import { capaReadDependencies } from '../../../modules/quality/capa/application/dependencies.js';
import { rcaReadDependencies } from '../../../modules/quality/rca/application/dependencies.js';
import { listFindingsForActor } from '../../../modules/quality/findings/application/list-findings-for-actor.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { formatDateTime } from '../../../shared/copy/format.js';
import { readOutcome } from '../../../shared/errors/read-outcome.js';
import { classifyReadFailure } from '../../../shared/errors/read-failure.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login');
// F-05 baseline: a read failure renders the unavailable state, never a 500.
const ncrId = Astro.params.ncrId ?? '';
let ncr: Awaited<ReturnType<ReturnType<typeof ncrReadDependencies>['get']['execute']>> | undefined;
let providerUnavailable = false;
if (/^[0-9a-f-]{36}$/i.test(ncrId)) {
  try { ncr = await ncrReadDependencies().get.execute({ id: ncrId, actor }); }
  catch (error) {
    if (classifyReadFailure(error) === 'UNAVAILABLE') providerUnavailable = true;
  }
} else Astro.response.status = 404;
if (!ncr && !providerUnavailable) Astro.response.status = 404;
if (providerUnavailable) Astro.response.status = 503;
// Related records are resolved server-side through each owning domain's own
// scope-limited reads; this page never queries another domain's table directly
// and holds no mutation authority over finding or CAPA state.
const [findingResult, capaResult, rcaResult] = await Promise.all([
  readOutcome(() => ncr?.findingId ? listFindingsForActor(actor).then((findings) => findings.find((f) => f.id === ncr?.findingId)) : Promise.resolve(undefined)),
  readOutcome(() => ncr ? capaReadDependencies().list.execute({ actor }).then((all) => all.filter((capa) => capa.ncrId === ncr?.id)) : Promise.resolve([])),
  readOutcome(() => ncr ? rcaReadDependencies().list.execute({ actor, ncrId: ncr.id }) : Promise.resolve([])),
]);
const sourceFinding = findingResult.status === 'AVAILABLE' ? findingResult.value : undefined;
const relatedCapas = capaResult.status === 'AVAILABLE' ? capaResult.value : [];
const relatedRcas = rcaResult.status === 'AVAILABLE' ? rcaResult.value : [];
---
<AppLayout title={`${ncr?.ncrNo ?? 'NCR'} · Quality`} locale="en" direction="ltr">{providerUnavailable ? <main><h1>NCR details are temporarily unavailable</h1><p role="status">The record source could not be reached. No record was changed. Retry from <a href="/quality/ncr">NCR records</a>.</p></main> : ncr ? <><p class="eyebrow">NCR</p><h1>{ncr.ncrNo}</h1><p>{ncr.title}</p><p class="lede">{ncr.description}</p>
<JourneyContextPanel ownerDomain="Quality / NCR" recordReference={`${ncr.ncrNo} · version ${ncr.version.toString()}`} currentState={stateLabel(ncr.state)} nextOwner={['OPEN', 'UNDER_INVESTIGATION', 'RCA_IN_PROGRESS', 'CAPA_IN_PROGRESS'].includes(ncr.state) ? 'NCR owner / investigation' : ncr.state === 'READY_FOR_CLOSURE' ? 'NCR reviewer' : undefined} whyUnavailable={ncr.state === 'READY_FOR_CLOSURE' ? 'policy: closure requires the approved NCR review authority; direct creation and closure are not enabled here' : ncr.state === 'CLOSED' ? 'state: controlled closure is complete' : undefined} waitingOn={['UNDER_INVESTIGATION', 'RCA_IN_PROGRESS'].includes(ncr.state) ? 'Investigation / RCA progress' : ncr.state === 'CAPA_IN_PROGRESS' ? 'Linked CAPA execution' : undefined} expectedEvent={['OPEN', 'UNDER_INVESTIGATION'].includes(ncr.state) ? 'Investigation progress' : ncr.state === 'CAPA_IN_PROGRESS' ? 'CAPA completion' : ncr.state === 'READY_FOR_CLOSURE' ? 'Controlled closure decision' : undefined} controlledContext={`NCR ${ncr.ncrNo} · record version ${ncr.version.toString()}`} evidenceSummary={`Affected item ${ncr.affectedItemCode ?? 'not supplied'} · lot ${ncr.affectedLot ?? 'not supplied'}`} auditHref={`/audit?subjectType=NCR&subjectId=${encodeURIComponent(ncr.id)}`} relatedLinks={[{ label: 'Findings register', href: '/quality/findings', detail: 'Quality-owned records' }, ...relatedRcas.map((rca) => ({ label: rca.rcaNo ?? `RCA for ${ncr.ncrNo}`, href: `/quality/rca/${rca.id}`, detail: stateLabel(rca.state) })), ...relatedCapas.map((capa) => ({ label: `CAPA ${capa.capaNo}`, href: `/quality/capa/${capa.id}`, detail: stateLabel(capa.state) }))]} />
<dl><dt>State</dt><dd>{stateLabel(ncr.state)}</dd><dt>Version</dt><dd>{ncr.version.toString()}</dd><dt>Opened</dt><dd>{ncr.openedAt ? formatDateTime(ncr.openedAt) : 'Not opened'}</dd><dt>Closed</dt><dd>{ncr.closedAt ? formatDateTime(ncr.closedAt) : 'Not closed'}</dd><dt>Affected item</dt><dd>{ncr.affectedItemCode ?? 'Not supplied'}</dd><dt>Affected lot</dt><dd>{ncr.affectedLot ?? 'Not supplied'}</dd></dl>
<section class="related"><h2>Source finding</h2>{findingResult.status === 'UNAVAILABLE' ? <p role="status">The Finding source is temporarily unavailable. Retry this record.</p> : sourceFinding ? <p><a href={`/quality/findings/${sourceFinding.id}`}>{sourceFinding.findingNo}</a><span>{stateLabel(sourceFinding.state)}</span></p> : <p class="muted">{ncr.findingId ? 'The source finding is not visible in your authorized scope.' : 'No source finding is linked to this NCR.'}</p>}</section>
<section class="related"><h2>Related RCA</h2>{rcaResult.status === 'UNAVAILABLE' ? <p role="status">The RCA source is temporarily unavailable. Retry this record.</p> : relatedRcas.length ? <ul>{relatedRcas.map((rca) => <li><a href={`/quality/rca/${rca.id}`}>{rca.rcaNo ?? `Root-cause analysis for ${ncr.ncrNo}`}</a><span>{stateLabel(rca.state)}</span></li>)}</ul> : <p class="muted">No linked RCA is visible in your authorized scope.</p>}<p class="note">This is a read-only linkage; transitions remain owned by the authorized RCA workflow.</p></section>
<section class="related"><h2>Linked CAPAs</h2>{capaResult.status === 'UNAVAILABLE' ? <p role="status">The CAPA source is temporarily unavailable. Retry this record.</p> : relatedCapas.length ? <ul>{relatedCapas.map((capa) => <li><a href={`/quality/capa/${capa.id}`}>{capa.capaNo}</a><span>{stateLabel(capa.state)}</span></li>)}</ul> : <p class="muted">No CAPA linked to this NCR is visible in your authorized scope.</p>}<p class="note">This is a read-only linkage. PD-17 decision owner: QMS process owner. NCR closure remains unavailable while its workflow and authority decision is unresolved.</p></section></> : <main><h1>NCR record not found</h1><p>This record does not exist or is outside your authorized scope.</p><a href="/quality/ncr">Return to NCR records</a></main>}</AppLayout>
<style>.eyebrow,.lede{color:var(--text-muted)}dl{display:grid;grid-template-columns:max-content 1fr;gap:.65rem 1rem;background:var(--surface-panel);padding:1rem}dt{font-weight:700}dd{margin:0}.related{margin-top:1rem;padding:1rem;background:var(--surface-panel);border:1px solid var(--color-border-subtle)}.related a{color:var(--color-accent-primary-hover)}.related span{color:var(--text-muted);margin-inline-start:.5rem}.note{color:var(--text-muted);font-size:.8rem}</style>
