---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import JourneyContextPanel from '../../../ui/components/workflow/JourneyContextPanel.astro';
import { getDatabase } from '../../../shared/database/database.js';
import { PostgresNcrRepository } from '../../../modules/quality/ncr/infrastructure/postgres-repository.js';
import { PostgresCapaRepository } from '../../../modules/quality/capa/infrastructure/postgres-repository.js';
import { listFindingsForActor } from '../../../modules/quality/findings/application/list-findings-for-actor.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { formatDateTime } from '../../../shared/copy/format.js';
import type { Finding } from '../../../modules/quality/findings/domain/finding.js';
import type { Capa } from '../../../modules/quality/capa/domain/capa.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login');
// F-05 baseline: a read failure renders the unavailable state, never a 500.
const ncrId = Astro.params.ncrId ?? '';
const ncr = /^[0-9a-f-]{36}$/i.test(ncrId)
  ? await new Promise<ReturnType<typeof resolveNcr>>((resolve) => resolve(resolveNcr(ncrId, actor))).catch(() => undefined)
  : undefined;
async function resolveNcr(id: string, a: NonNullable<typeof actor>) {
  const repository = new PostgresNcrRepository(getDatabase());
  return repository.get(id, a);
}
if (!ncr) return Astro.redirect('/404');
// Related records are resolved server-side through each owning domain's own
// scope-limited reads; this page never queries another domain's table directly
// and holds no mutation authority over finding or CAPA state.
const [sourceFinding, relatedCapas] = await Promise.all([
  (async (): Promise<Finding | undefined> => {
    if (!ncr.findingId) return undefined;
    const findings = await listFindingsForActor(actor).catch(() => [] as readonly Finding[]);
    return findings.find((f) => f.id === ncr.findingId);
  })(),
  (async (): Promise<readonly Capa[]> => {
    const repository = new PostgresCapaRepository(getDatabase());
    const all = await repository.list({ actor }).catch(() => [] as readonly Capa[]);
    return all.filter((capa) => capa.ncrId === ncr.id);
  })(),
]);
---
<AppLayout title={`${ncr.ncrNo} · Quality`} locale="en" direction="ltr"><p class="eyebrow">NCR</p><h1>{ncr.ncrNo}</h1><p>{ncr.title}</p><p class="lede">{ncr.description}</p>
<JourneyContextPanel ownerDomain="Quality / NCR" currentState={stateLabel(ncr.state)} nextOwner={['OPEN', 'UNDER_INVESTIGATION', 'RCA_IN_PROGRESS', 'CAPA_IN_PROGRESS'].includes(ncr.state) ? 'NCR owner / investigation' : ncr.state === 'READY_FOR_CLOSURE' ? 'NCR reviewer' : undefined} whyUnavailable={ncr.state === 'READY_FOR_CLOSURE' ? 'policy: closure requires the approved NCR review authority; direct creation and closure are not enabled here' : ncr.state === 'CLOSED' ? 'state: controlled closure is complete' : undefined} waitingOn={['UNDER_INVESTIGATION', 'RCA_IN_PROGRESS'].includes(ncr.state) ? 'Investigation / RCA progress' : ncr.state === 'CAPA_IN_PROGRESS' ? 'Linked CAPA execution' : undefined} expectedEvent={['OPEN', 'UNDER_INVESTIGATION'].includes(ncr.state) ? 'Investigation progress' : ncr.state === 'CAPA_IN_PROGRESS' ? 'CAPA completion' : ncr.state === 'READY_FOR_CLOSURE' ? 'Controlled closure decision' : undefined} controlledContext={`NCR ${ncr.ncrNo} · record version ${ncr.version.toString()}`} evidenceSummary={`Affected item ${ncr.affectedItemCode ?? 'not supplied'} · lot ${ncr.affectedLot ?? 'not supplied'}`} auditHref={`/audit?subjectType=NCR&subjectId=${encodeURIComponent(ncr.id)}`} relatedLinks={[{ label: 'Findings register', href: '/quality/findings', detail: 'Quality-owned records' }]} />
<dl><dt>State</dt><dd>{stateLabel(ncr.state)}</dd><dt>Version</dt><dd>{ncr.version.toString()}</dd><dt>Opened</dt><dd>{ncr.openedAt ? formatDateTime(ncr.openedAt) : 'Not opened'}</dd><dt>Closed</dt><dd>{ncr.closedAt ? formatDateTime(ncr.closedAt) : 'Not closed'}</dd><dt>Affected item</dt><dd>{ncr.affectedItemCode ?? 'Not supplied'}</dd><dt>Affected lot</dt><dd>{ncr.affectedLot ?? 'Not supplied'}</dd></dl>
<section class="related"><h2>Source finding</h2>{sourceFinding ? <p><a href={`/quality/findings/${sourceFinding.id}`}>{sourceFinding.findingNo}</a><span>{stateLabel(sourceFinding.state)}</span></p> : <p class="muted">{ncr.findingId ? 'The source finding is not visible in your authorized scope.' : 'No source finding is linked to this NCR.'}</p>}</section>
<section class="related"><h2>Linked CAPAs</h2>{relatedCapas.length ? <ul>{relatedCapas.map((capa) => <li><a href={`/quality/capa/${capa.id}`}>{capa.capaNo}</a><span>{stateLabel(capa.state)}</span></li>)}</ul> : <p class="muted">No CAPA linked to this NCR is visible in your authorized scope.</p>}<p class="note">CAPA creation and lifecycle remain owned by the CAPA workflow; this list is a read-only linkage.</p></section></AppLayout>
<style>.eyebrow,.lede{color:var(--text-muted)}dl{display:grid;grid-template-columns:max-content 1fr;gap:.65rem 1rem;background:var(--surface-panel);padding:1rem}dt{font-weight:700}dd{margin:0}.related{margin-top:1rem;padding:1rem;background:var(--surface-panel);border:1px solid var(--color-border-subtle)}.related a{color:var(--color-accent-primary-hover)}.related span{color:var(--text-muted);margin-inline-start:.5rem}.note{color:var(--text-muted);font-size:.8rem}</style>
