---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import JourneyContextPanel from '../../../ui/components/workflow/JourneyContextPanel.astro';
import PolicyBlocker from '../../../ui/components/feedback/PolicyBlocker.astro';
import { ncrReadDependencies } from '../../../modules/quality/ncr/application/dependencies.js';
import { capaReadDependencies } from '../../../modules/quality/capa/application/dependencies.js';
import { rcaReadDependencies } from '../../../modules/quality/rca/application/dependencies.js';
import { listFindingsForActor } from '../../../modules/quality/findings/application/list-findings-for-actor.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { formatDateTime } from '../../../shared/copy/format.js';
import { readOutcome } from '../../../shared/errors/read-outcome.js';
import { classifyReadFailure } from '../../../shared/errors/read-failure.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login');
// F-05 baseline: a read failure renders the unavailable state, never a 500.
const ncrId = Astro.params.ncrId ?? '';
let ncr: Awaited<ReturnType<ReturnType<typeof ncrReadDependencies>['get']['execute']>> | undefined;
let providerUnavailable = false;
if (/^[0-9a-f-]{36}$/i.test(ncrId)) {
  try { ncr = await ncrReadDependencies().get.execute({ id: ncrId, actor }); }
  catch (error) {
    if (classifyReadFailure(error) === 'UNAVAILABLE') providerUnavailable = true;
  }
} else Astro.response.status = 404;
if (!ncr && !providerUnavailable) Astro.response.status = 404;
if (providerUnavailable) Astro.response.status = 503;
// Related records are resolved server-side through each owning domain's own
// scope-limited reads; this page never queries another domain's table directly
// and holds no mutation authority over finding or CAPA state.
const [findingResult, capaResult, rcaResult] = await Promise.all([
  readOutcome(() => ncr?.findingId ? listFindingsForActor(actor).then((findings) => findings.find((f) => f.id === ncr?.findingId)) : Promise.resolve(undefined)),
  readOutcome(() => ncr ? capaReadDependencies().list.execute({ actor }).then((all) => all.filter((capa) => capa.ncrId === ncr?.id)) : Promise.resolve([])),
  readOutcome(() => ncr ? rcaReadDependencies().list.execute({ actor, ncrId: ncr.id }) : Promise.resolve([])),
]);
const sourceFinding = findingResult.status === 'AVAILABLE' ? findingResult.value : undefined;
const relatedCapas = capaResult.status === 'AVAILABLE' ? capaResult.value : [];
const relatedRcas = rcaResult.status === 'AVAILABLE' ? rcaResult.value : [];
---
<AppLayout title={`${ncr?.ncrNo ?? 'NCR'} · Quality`} locale="en" direction="ltr">
  <div class="ncr-detail">
    {providerUnavailable ? (
      <div class="panel record-state"><h1>NCR details are temporarily unavailable</h1><p role="status">The record source could not be reached. No record was changed. Retry from <a href="/quality/ncr">NCR records</a>.</p></div>
    ) : ncr ? (
      <>
        <header class="detail-heading">
          <div><p class="eyebrow">NCR</p><h1>{ncr.ncrNo}</h1><p class="record-title">{ncr.title}</p></div>
          <a href="/quality/ncr">NCR records</a>
        </header>
        <!-- READ: available, missing/not visible and provider unavailable follow the existing reads.
             FORM and record DIALOG: N/A — no record form, action or dialog in this route.
             AppLayout's navigation dialog is inherited unchanged. No filter/export is offered.
             Existing functional debt: NCR evidence-dependent transitions remain denied by
             PostgresNcrRepository; linked CAPA state supplies no effectiveness decision. -->
        <JourneyContextPanel ownerDomain="Quality / NCR" recordReference={`${ncr.ncrNo} · version ${ncr.version.toString()}`} currentState={stateLabel(ncr.state)} nextOwner={['OPEN', 'UNDER_INVESTIGATION', 'RCA_IN_PROGRESS', 'CAPA_IN_PROGRESS'].includes(ncr.state) ? 'NCR owner / investigation' : ncr.state === 'READY_FOR_CLOSURE' ? 'NCR reviewer' : undefined} whyUnavailable={ncr.state === 'CLOSED' ? 'state: controlled closure is complete' : undefined} waitingOn={['UNDER_INVESTIGATION', 'RCA_IN_PROGRESS'].includes(ncr.state) ? 'Investigation / RCA progress' : ncr.state === 'CAPA_IN_PROGRESS' ? 'Linked CAPA execution' : undefined} expectedEvent={['OPEN', 'UNDER_INVESTIGATION'].includes(ncr.state) ? 'Investigation progress' : ncr.state === 'CAPA_IN_PROGRESS' ? 'CAPA completion' : ncr.state === 'READY_FOR_CLOSURE' ? 'Controlled closure decision' : undefined} controlledContext={`NCR ${ncr.ncrNo} · record version ${ncr.version.toString()}`} evidenceSummary={`Affected item ${ncr.affectedItemCode ?? 'not supplied'} · lot ${ncr.affectedLot ?? 'not supplied'}`} auditHref={`/audit?subjectType=NCR&subjectId=${encodeURIComponent(ncr.id)}`} relatedLinks={[{ label: 'Findings register', href: '/quality/findings', detail: 'Quality-owned records' }, ...relatedRcas.map((rca) => ({ label: rca.rcaNo ?? `RCA for ${ncr.ncrNo}`, href: `/quality/rca/${rca.id}`, detail: stateLabel(rca.state) })), ...relatedCapas.map((capa) => ({ label: `CAPA ${capa.capaNo}`, href: `/quality/capa/${capa.id}`, detail: stateLabel(capa.state) }))]} />
        <div class="record-layout">
          <div class="record-content">
            <section class="panel" aria-labelledby="facts-heading">
              <p class="eyebrow">Read-only record</p><h2 id="facts-heading">Facts</h2>
              <p class="description">{ncr.description}</p>
              <dl class="facts-grid">
                <div><dt>State</dt><dd>{stateLabel(ncr.state)}</dd></div>
                <div><dt>Version</dt><dd>{ncr.version.toString()}</dd></div>
                <div><dt>Affected item</dt><dd>{ncr.affectedItemCode ?? 'Not supplied'}</dd></div>
                <div><dt>Affected lot</dt><dd>{ncr.affectedLot ?? 'Not supplied'}</dd></div>
              </dl>
            </section>
            <section class="panel related" aria-labelledby="evidence-heading"><p class="eyebrow">Evidence</p><h2 id="evidence-heading">Source finding</h2>{findingResult.status === 'UNAVAILABLE' ? <p role="status">The Finding source is temporarily unavailable. Retry this record.</p> : sourceFinding ? <p><a href={`/quality/findings/${sourceFinding.id}`}>{sourceFinding.findingNo}</a><span>{stateLabel(sourceFinding.state)}</span></p> : <p class="muted">{ncr.findingId ? 'The source finding is not visible in your authorized scope.' : 'No source finding is linked to this NCR.'}</p>}</section>
            <section class="panel" aria-labelledby="history-heading">
              <p class="eyebrow">Recorded dates</p><h2 id="history-heading">History</h2>
              <dl class="facts-grid">
                <div><dt>Opened</dt><dd>{ncr.openedAt ? formatDateTime(ncr.openedAt) : 'Not opened'}</dd></div>
                <div><dt>Closed</dt><dd>{ncr.closedAt ? formatDateTime(ncr.closedAt) : 'Not closed'}</dd></div>
              </dl>
              <p class="note">These are recorded lifecycle dates. The audit history is available in Evidence and trace above.</p>
            </section>
          </div>
          <aside class="record-side" aria-label="Current actions and relationships">
            <section class="panel" aria-labelledby="actions-heading">
              <p class="eyebrow">Current actions</p><h2 id="actions-heading">Read-only context</h2>
              <p class="note">This page offers record and audit links only. Transitions remain in their owning workflows and require server authorization.</p>
            </section>
            <PolicyBlocker title="NCR closure policy" decisions={[{ id: 'PD-17', owner: 'QMS process owner', consequence: 'NCR closure remains unavailable while its workflow and authority decision is unresolved. Closure requires the approved NCR review authority.' }]} />
            <section class="panel related" aria-labelledby="rca-heading"><h2 id="rca-heading">Related RCA</h2>{rcaResult.status === 'UNAVAILABLE' ? <p role="status">The RCA source is temporarily unavailable. Retry this record.</p> : relatedRcas.length ? <ul>{relatedRcas.map((rca) => <li><a href={`/quality/rca/${rca.id}`}>{rca.rcaNo ?? `Root-cause analysis for ${ncr.ncrNo}`}</a><span>{stateLabel(rca.state)}</span></li>)}</ul> : <p class="muted">No linked RCA is visible in your authorized scope.</p>}<p class="note">This is a read-only linkage; transitions remain owned by the authorized RCA workflow.</p></section>
            <section class="panel related" aria-labelledby="capa-heading"><h2 id="capa-heading">Linked CAPAs</h2>{capaResult.status === 'UNAVAILABLE' ? <p role="status">The CAPA source is temporarily unavailable. Retry this record.</p> : relatedCapas.length ? <ul>{relatedCapas.map((capa) => <li><a href={`/quality/capa/${capa.id}`}>{capa.capaNo}</a><span>{stateLabel(capa.state)}</span></li>)}</ul> : <p class="muted">No CAPA linked to this NCR is visible in your authorized scope.</p>}<p class="note">This is a read-only linkage.</p></section>
          </aside>
        </div>
      </>
    ) : (
      <div class="panel record-state"><h1>NCR record not found</h1><p>This record does not exist or is outside your authorized scope.</p><a href="/quality/ncr">Return to NCR records</a></div>
    )}
  </div>
</AppLayout>

<style>
  .ncr-detail { min-inline-size: 0; }
  .detail-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: start; gap: var(--space-4); margin-block-end: var(--space-5); padding-block-end: var(--space-5); border-block-end: 1px solid var(--color-border-subtle); }
  .detail-heading > div { min-inline-size: 0; }
  h1 { margin: 0; overflow-wrap: anywhere; }
  .record-title { margin: var(--space-2) 0 0; color: var(--text-secondary); font-size: var(--font-size-lg); overflow-wrap: anywhere; }
  .eyebrow { margin: 0 0 var(--space-2); color: var(--text-muted); font-size: var(--font-size-xs); }
  .record-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(17rem, 22rem); align-items: start; gap: var(--space-5); margin-block-start: var(--space-5); }
  .record-content, .record-side { display: grid; min-inline-size: 0; gap: var(--space-5); }
  .panel { min-inline-size: 0; padding: var(--space-5); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); background: var(--surface-panel); }
  h2 { margin: 0 0 var(--space-4); font-size: var(--font-size-lg); }
  .description { margin: 0 0 var(--space-5); white-space: pre-wrap; overflow-wrap: anywhere; }
  .facts-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin: 0; }
  .facts-grid > div { min-inline-size: 0; border-block-start: 1px solid var(--color-border-subtle); padding-block-start: var(--space-3); }
  dt { color: var(--text-muted); font-size: var(--font-size-xs); font-weight: 600; }
  dd { margin: var(--space-2) 0 0; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .related li { min-inline-size: 0; padding-block-end: var(--space-2); border-block-end: 1px solid var(--color-border-subtle); }
  .related span { display: block; color: var(--text-muted); font-size: var(--font-size-sm); }
  .muted, .note { color: var(--text-muted); font-size: var(--font-size-sm); line-height: var(--line-height-relaxed); }
  .note { margin-block: var(--space-3) 0; }
  a { display: inline-flex; align-items: center; min-block-size: 44px; max-inline-size: 100%; color: var(--color-accent-primary-hover); overflow-wrap: anywhere; }
  a:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .ncr-detail :global(.journey-panel) { margin-block: var(--space-5); }
  .ncr-detail :global(.journey-panel a), .ncr-detail :global([data-record-index] a) { display: inline-flex; align-items: center; min-block-size: 44px; max-inline-size: 100%; overflow-wrap: anywhere; }
  .ncr-detail :global(.journey-panel a:focus-visible), .ncr-detail :global([data-record-index] a:focus-visible) { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .ncr-detail :global(.owner) { max-inline-size: 100%; white-space: normal; overflow-wrap: anywhere; }
  .record-side :global(.policy-blocker) { margin: 0; border-radius: var(--radius-md); overflow-wrap: anywhere; }
  @media (max-width: 1100px) { .record-layout { grid-template-columns: minmax(0, 1fr); } .ncr-detail :global(.journey-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .panel { padding: var(--space-4); } .facts-grid, .ncr-detail :global(.journey-grid) { grid-template-columns: minmax(0, 1fr); } }
  @media (forced-colors: active) { .panel { border-color: CanvasText; } a:focus-visible { outline-color: Highlight; } }
</style>
