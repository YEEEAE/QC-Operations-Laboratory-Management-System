---
import PageHeader from "../../../ui/components/PageHeader.astro";
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import PolicyBlocker from '../../../ui/components/feedback/PolicyBlocker.astro';
import Pagination from '../../../ui/components/data/Pagination.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import { ncrReadDependencies } from '../../../modules/quality/ncr/application/dependencies.js';
import { rcaReadDependencies } from '../../../modules/quality/rca/application/dependencies.js';
import { findingsReadDependencies } from '../../../modules/quality/findings/application/dependencies.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { readOutcome } from '../../../shared/errors/read-outcome.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquality%2Fncr');
const states = ['DRAFT', 'OPEN', 'UNDER_INVESTIGATION', 'RCA_IN_PROGRESS', 'CAPA_IN_PROGRESS', 'READY_FOR_CLOSURE', 'CLOSED', 'VOID'] as const;
const requestedState = Astro.url.searchParams.get('state');
const state = states.find((value) => value === requestedState);
const ncrResult = await readOutcome(() => ncrReadDependencies().list.executePage({ actor, state, page: { page: Astro.url.searchParams.get('page') ?? 1 } }));
const ncrs = ncrResult.status === 'AVAILABLE' ? ncrResult.value.items : [];
const [rcaResult, findingResult] = await Promise.all([
  readOutcome(() => Promise.all(ncrs.map(async (ncr) => [ncr.id, (await rcaReadDependencies().list.executePage({ actor, ncrId: ncr.id, page: { pageSize: 1 } })).total] as const))),
  readOutcome(() => Promise.all([...new Set(ncrs.flatMap((ncr) => ncr.findingId ? [ncr.findingId] : []))].map(async (id) => {
    const result = await readOutcome(() => findingsReadDependencies().get.execute({ actor, id }));
    if (result.status === 'UNAVAILABLE') throw new Error('Finding source unavailable');
    return result.status === 'AVAILABLE' ? result.value : undefined;
  }))),
]);
const findings = findingResult.status === 'AVAILABLE' ? findingResult.value.filter((finding) => Boolean(finding)) : [];
const unavailable = ncrResult.status === 'UNAVAILABLE';
const primaryNotVisible = ncrResult.status === 'NOT_VISIBLE';
const findingById = new Map(findings.flatMap((finding) => finding ? [[finding.id, finding] as const] : []));
const rcaCount = new Map(rcaResult.status === 'AVAILABLE' ? rcaResult.value : []);
const rows = ncrs.map((ncr) => ({ ncr, finding: ncr.findingId ? findingById.get(ncr.findingId) : undefined, rcaCount: rcaResult.status === 'AVAILABLE' ? (rcaCount.get(ncr.id) ?? 0) : null }));
---
<AppLayout title="NCR · Quality" locale="en" direction="ltr">
  <PageHeader><Fragment slot="heading"><h1>NCR records</h1></Fragment></PageHeader>
  <PolicyBlocker title="Workflow decisions still pending" decisions={[
    { id: 'PD-15', owner: 'QC owner', consequence: 'Approved Finding-to-NCR initiation criteria remain unresolved.' },
    { id: 'PD-16', owner: 'QC / inspection procedure owner', consequence: 'The consequence of an inspection FAIL remains unresolved.' },
    { id: 'PD-17', owner: 'QMS owner', consequence: 'NCR closure authority and workflow remain unresolved.' },
  ]} />
  <p>These actions stay unavailable until their owners approve the governing decision. Existing records remain readable.</p>
  <form class="filters" method="get"><label for="state">State<select id="state" name="state"><option value="">All states</option>{states.map((value) => <option value={value} selected={state === value}>{stateLabel(value)}</option>)}</select></label><button type="submit">Apply filter</button>{state && <a href="/quality/ncr">Clear filter</a>}</form>
  {unavailable ? <ProviderUnavailableState title="NCR records are temporarily unavailable" /> : primaryNotVisible ? <p role="status">NCR records are not available in your authorized scope.</p> : <>{rcaResult.status === 'UNAVAILABLE' && <p role="status">RCA links and counts are temporarily unavailable; NCR records remain available.</p>}{findingResult.status === 'UNAVAILABLE' && <p role="status">Finding links are temporarily unavailable; NCR records remain available.</p>}{ncrs.length ? <div class="table-wrap"><table><caption>{ncrResult.status === "AVAILABLE" ? ncrResult.value.total : 0} authorized NCR record{ncrResult.status === "AVAILABLE" && ncrResult.value.total === 1 ? '' : 's'}</caption><thead><tr><th scope="col">NCR</th><th scope="col">Nonconformance</th><th scope="col">State</th><th scope="col">Source finding</th><th scope="col">RCA</th><th scope="col">Next step</th></tr></thead><tbody>{rows.map(({ ncr, finding, rcaCount: count }) => <tr><th scope="row"><a href={`/quality/ncr/${ncr.id}`}>{ncr.ncrNo}</a></th><td>{ncr.title}</td><td>{stateLabel(ncr.state)}</td><td>{finding ? <a href={`/quality/findings/${finding.id}`}>{finding.findingNo}</a> : findingResult.status === 'UNAVAILABLE' ? 'Finding source unavailable' : ncr.findingId ? 'Not visible in your scope' : 'Not linked'}</td><td>{count === null ? 'Count unavailable' : count ? <a href={`/quality/rca?ncrId=${encodeURIComponent(ncr.id)}`}>{count} analysis{count === 1 ? '' : 'es'}</a> : 'None visible'}</td><td>{ncr.state === 'OPEN' || ncr.state === 'UNDER_INVESTIGATION' ? <a href={`/quality/ncr/${ncr.id}`}>Review record and investigation</a> : ncr.state === 'RCA_IN_PROGRESS' ? <a href={`/quality/rca?ncrId=${encodeURIComponent(ncr.id)}`}>Review linked RCA</a> : ncr.state === 'CAPA_IN_PROGRESS' ? <a href={`/quality/capa?ncrId=${encodeURIComponent(ncr.id)}`}>Review linked CAPA</a> : ncr.state === 'READY_FOR_CLOSURE' ? 'Closure decision — QMS owner approval required' : <a href={`/quality/ncr/${ncr.id}`}>Open record</a>}</td></tr>)}</tbody></table></div> : <section class="empty"><h2>No NCR records in this view</h2><p>{state ? 'Clear the filter to see records in your authorized scope.' : 'No current NCR records are available in your authorized scope.'}</p>{state && <a href="/quality/ncr">Clear state filter</a>}</section>}</>}
  {ncrResult.status === 'AVAILABLE' && <Pagination page={ncrResult.value.page} totalPages={Math.max(1, Math.ceil(ncrResult.value.total / ncrResult.value.pageSize))} total={ncrResult.value.total} itemLabel="NCR records" />}
</AppLayout>
<style>
  .page-head{margin-bottom:var(--space-5)}h1{margin:.25rem 0}.eyebrow,.lede,.policy p{color:var(--text-muted)}.eyebrow{font-size:var(--font-size-xs);font-weight:700;letter-spacing:.12em}.policy{margin-bottom:var(--space-5);padding:var(--space-4);background:var(--surface-panel);border-inline-start:3px solid var(--color-accent-primary)}.policy h2{font-size:1rem;margin:0}.policy ul{padding-inline-start:1.25rem}.policy p{margin-bottom:0}.filters{display:flex;flex-wrap:wrap;align-items:end;gap:var(--space-3);margin-bottom:var(--space-5)}label{display:grid;gap:.35rem}select,button{min-height:var(--control-height);padding:.55rem .75rem;background:var(--surface-panel);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.table-wrap{overflow-x:auto;max-width:100%;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:900px;border-collapse:collapse;background:var(--surface-panel)}th,td{padding:.75rem;text-align:start;border-top:1px solid var(--color-border-subtle);vertical-align:top}th{font-weight:700}a{color:var(--color-accent-primary-hover)}.empty{padding:var(--space-5);background:var(--surface-panel);border:1px dashed var(--border-default)}@media(max-width:650px){.filters{display:grid;grid-template-columns:1fr}.filters button{width:max-content}}
</style>
