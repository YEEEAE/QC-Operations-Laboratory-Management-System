---
import PageHeader from "../../../ui/components/PageHeader.astro";
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import PolicyBlocker from '../../../ui/components/feedback/PolicyBlocker.astro';
import Pagination from '../../../ui/components/data/Pagination.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import { ncrReadDependencies } from '../../../modules/quality/ncr/application/dependencies.js';
import { rcaReadDependencies } from '../../../modules/quality/rca/application/dependencies.js';
import { findingsReadDependencies } from '../../../modules/quality/findings/application/dependencies.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { readOutcome } from '../../../shared/errors/read-outcome.js';
import { authorize } from '../../../shared/authorization/authorize.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquality%2Fncr');
const canCreate = authorize({ actor, permission: 'PERM-NCR-CREATE', action: 'CREATE', entity: { type: 'NCR', id: 'new', state: 'DRAFT', ownerId: actor.id }, scope: { ownerId: actor.id }, currentVersion: 1n, expectedVersion: 1n, businessCondition: true }).allowed;
const states = ['DRAFT', 'OPEN', 'UNDER_INVESTIGATION', 'RCA_IN_PROGRESS', 'CAPA_IN_PROGRESS', 'READY_FOR_CLOSURE', 'CLOSED', 'VOID'] as const;
const requestedState = Astro.url.searchParams.get('state');
const state = states.find((value) => value === requestedState);
const ncrResult = await readOutcome(() => ncrReadDependencies().list.executePage({ actor, state, page: { page: Astro.url.searchParams.get('page') ?? 1 } }));
const ncrs = ncrResult.status === 'AVAILABLE' ? ncrResult.value.items : [];
const [rcaResult, findingResult] = await Promise.all([
  readOutcome(() => Promise.all(ncrs.map(async (ncr) => [ncr.id, (await rcaReadDependencies().list.executePage({ actor, ncrId: ncr.id, page: { pageSize: 1 } })).total] as const))),
  readOutcome(() => Promise.all([...new Set(ncrs.flatMap((ncr) => ncr.findingId ? [ncr.findingId] : []))].map(async (id) => {
    const result = await readOutcome(() => findingsReadDependencies().get.execute({ actor, id }));
    if (result.status === 'UNAVAILABLE') throw new Error('Finding source unavailable');
    return result.status === 'AVAILABLE' ? result.value : undefined;
  }))),
]);
const findings = findingResult.status === 'AVAILABLE' ? findingResult.value.filter((finding) => Boolean(finding)) : [];
const unavailable = ncrResult.status === 'UNAVAILABLE';
const primaryNotVisible = ncrResult.status === 'NOT_VISIBLE';
const findingById = new Map(findings.flatMap((finding) => finding ? [[finding.id, finding] as const] : []));
const rcaCount = new Map(rcaResult.status === 'AVAILABLE' ? rcaResult.value : []);
const rows = ncrs.map((ncr) => ({ ncr, finding: ncr.findingId ? findingById.get(ncr.findingId) : undefined, rcaCount: rcaResult.status === 'AVAILABLE' ? (rcaCount.get(ncr.id) ?? 0) : null }));
---
<AppLayout title="NCR · Quality" locale="en" direction="ltr">
  <PageHeader><Fragment slot="heading"><h1>NCR records</h1></Fragment>{canCreate && <Fragment slot="actions"><a class="button" href="/quality/ncr/new">Create NCR</a></Fragment>}</PageHeader>
  <PolicyBlocker title="Workflow decisions still pending" decisions={[
    { id: 'PD-16', owner: 'QC / inspection procedure owner', consequence: 'The consequence of an inspection FAIL remains unresolved; this register does not create an NCR automatically.' },
    { id: 'PD-17', owner: 'QMS owner', consequence: 'NCR closure authority and workflow remain unresolved.' },
  ]} />
  <p>Authorized users can create a draft NCR from a finding they can access. Creation does not approve the NCR, change the finding, or start a CAPA.</p>
  <section class="register-filters" aria-label="Filter NCR records">
  <form class="filters" method="get" role="search" aria-label="Filter NCR records"><label for="state">State<select id="state" name="state"><option value="">All states</option>{states.map((value) => <option value={value} selected={state === value}>{stateLabel(value)}</option>)}</select></label><button type="submit">Apply filter</button>{state && <a href="/quality/ncr">Clear filter</a>}</form>
  <div class="active-filters" data-applied-filters aria-label="Active filters">{state ? <span class="filter-chip">State: {stateLabel(state)}</span> : <span>All states</span>}</div>
  </section>
  <!-- Source states: READ available/empty/not-visible/unavailable; FILTER uses native GET.
       EXPORT and mutation pending/error: N/A — no export or mutation action on this register. -->
  {unavailable ? <ProviderUnavailableState title="NCR records are temporarily unavailable" /> : primaryNotVisible ? <p role="status">NCR records are not available in your authorized scope.</p> : <>{rcaResult.status === 'UNAVAILABLE' && <p role="status">RCA links and counts are temporarily unavailable; NCR records remain available.</p>}{findingResult.status === 'UNAVAILABLE' && <p role="status">Finding links are temporarily unavailable; NCR records remain available.</p>}{ncrs.length ? <div class="table-wrap" role="region" aria-label="NCR records" tabindex="0"><table><caption>{ncrResult.status === "AVAILABLE" ? ncrResult.value.total : 0} authorized NCR record{ncrResult.status === "AVAILABLE" && ncrResult.value.total === 1 ? '' : 's'}</caption><thead><tr><th scope="col">NCR</th><th scope="col">Nonconformance</th><th scope="col">State</th><th scope="col">Source finding</th><th scope="col">RCA</th><th scope="col">Next step</th></tr></thead><tbody>{rows.map(({ ncr, finding, rcaCount: count }) => <tr><th scope="row"><a href={`/quality/ncr/${ncr.id}`}>{ncr.ncrNo}</a></th><td>{ncr.title}</td><td>{stateLabel(ncr.state)}</td><td>{finding ? <a href={`/quality/findings/${finding.id}`}>{finding.findingNo}</a> : findingResult.status === 'UNAVAILABLE' ? 'Finding source unavailable' : ncr.findingId ? 'Not visible in your scope' : 'Not linked'}</td><td>{count === null ? 'Count unavailable' : count ? <a href={`/quality/rca?ncrId=${encodeURIComponent(ncr.id)}`}>{count} analysis{count === 1 ? '' : 'es'}</a> : 'None visible'}</td><td>{ncr.state === 'OPEN' || ncr.state === 'UNDER_INVESTIGATION' ? <a href={`/quality/ncr/${ncr.id}`}>Review record and investigation</a> : ncr.state === 'RCA_IN_PROGRESS' ? <a href={`/quality/rca?ncrId=${encodeURIComponent(ncr.id)}`}>Review linked RCA</a> : ncr.state === 'CAPA_IN_PROGRESS' ? <a href={`/quality/capa?ncrId=${encodeURIComponent(ncr.id)}`}>Review linked CAPA</a> : ncr.state === 'READY_FOR_CLOSURE' ? 'Closure decision — QMS owner approval required' : <a href={`/quality/ncr/${ncr.id}`}>Open record</a>}</td></tr>)}</tbody></table></div> : <section class="empty"><h2>No NCR records in this view</h2><p>{state ? 'Clear the filter to see records in your authorized scope.' : 'No current NCR records are available in your authorized scope.'}</p>{state && <a href="/quality/ncr">Clear state filter</a>}</section>}</>}
  {ncrResult.status === 'AVAILABLE' && <Pagination page={ncrResult.value.page} totalPages={Math.max(1, Math.ceil(ncrResult.value.total / ncrResult.value.pageSize))} total={ncrResult.value.total} itemLabel="NCR records" />}
</AppLayout>
<style>
  .register-filters{min-inline-size:0;margin-block:var(--space-5);padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--border-default);border-radius:var(--radius-lg)}
  .filters{display:flex;flex-wrap:wrap;align-items:end;gap:var(--space-3)}
  label{display:grid;gap:var(--space-2);min-inline-size:0;flex:1 1 18rem}
  select,button{min-block-size:max(44px,var(--control-height));max-inline-size:100%;padding:var(--space-3);background:var(--surface-panel);border:1px solid var(--control-border);border-radius:var(--radius-sm);color:var(--text-primary);font:inherit}
  button{cursor:pointer}.filters a,.empty a{display:inline-flex;align-items:center;min-block-size:44px}
  .active-filters{display:flex;flex-wrap:wrap;gap:var(--space-2);margin-block-start:var(--space-3);color:var(--text-secondary);font-size:var(--font-size-sm)}
  .filter-chip{padding:var(--space-2) var(--space-3);border:1px solid var(--border-default);border-radius:var(--radius-sm);overflow-wrap:anywhere}
  .table-wrap{overflow-x:auto;max-inline-size:100%;min-inline-size:0;border:1px solid var(--border-default);border-radius:var(--radius-lg)}
  table{inline-size:100%;min-inline-size:64rem;table-layout:fixed;border-collapse:collapse;background:var(--surface-panel)}
  caption{text-align:start;padding:var(--space-4);color:var(--text-secondary);font-weight:var(--font-weight-semibold)}
  th,td{padding:var(--space-4);text-align:start;border-block-start:1px solid var(--border-default);vertical-align:top;overflow-wrap:anywhere;white-space:normal}
  thead{background:var(--surface-inset)}th{font-weight:var(--font-weight-semibold)}
  th:nth-child(1){inline-size:16%}th:nth-child(2){inline-size:25%}th:nth-child(3){inline-size:15%}th:nth-child(4){inline-size:16%}th:nth-child(5){inline-size:10%}th:nth-child(6){inline-size:18%}
  tbody a{display:inline-flex;align-items:center;min-block-size:44px;max-inline-size:100%;overflow-wrap:anywhere}
  a{color:var(--color-accent-primary-hover)}
  a:focus-visible,button:focus-visible,select:focus-visible,.table-wrap:focus-visible{outline:2px solid var(--color-accent-primary);outline-offset:2px}
  .empty{padding:var(--space-5);background:var(--surface-panel);border:1px dashed var(--border-default);border-radius:var(--radius-lg)}
  @media(max-width:650px){.filters{display:grid;grid-template-columns:minmax(0,1fr)}.filters button{inline-size:100%}}
</style>
