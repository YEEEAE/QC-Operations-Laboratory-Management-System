---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import { ncrReadDependencies } from '../../../modules/quality/ncr/application/dependencies.js';
import { rcaReadDependencies } from '../../../modules/quality/rca/application/dependencies.js';
import { findingsReadDependencies } from '../../../modules/quality/findings/application/dependencies.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { readOutcome } from '../../../shared/errors/read-outcome.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquality%2Fncr');
const states = ['DRAFT', 'OPEN', 'UNDER_INVESTIGATION', 'RCA_IN_PROGRESS', 'CAPA_IN_PROGRESS', 'READY_FOR_CLOSURE', 'CLOSED', 'VOID'] as const;
const requestedState = Astro.url.searchParams.get('state');
const state = states.find((value) => value === requestedState);
const [ncrResult, rcaResult, findingResult] = await Promise.all([
  readOutcome(() => ncrReadDependencies().list.execute({ actor, state })),
  readOutcome(() => rcaReadDependencies().list.execute({ actor })),
  readOutcome(() => findingsReadDependencies().list.execute({ actor })),
]);
const ncrs = ncrResult.status === 'AVAILABLE' ? ncrResult.value : [];
const rcas = rcaResult.status === 'AVAILABLE' ? rcaResult.value : [];
const findings = findingResult.status === 'AVAILABLE' ? findingResult.value : [];
const unavailable = ncrResult.status === 'UNAVAILABLE';
const primaryNotVisible = ncrResult.status === 'NOT_VISIBLE';
const findingById = new Map(findings.map((finding) => [finding.id, finding]));
const rcaCount = new Map<string, number>();
for (const rca of rcas) rcaCount.set(rca.ncrId, (rcaCount.get(rca.ncrId) ?? 0) + 1);
const rows = ncrs.map((ncr) => ({ ncr, finding: ncr.findingId ? findingById.get(ncr.findingId) : undefined, rcaCount: rcaResult.status === 'AVAILABLE' ? (rcaCount.get(ncr.id) ?? 0) : null }));
---
<AppLayout title="NCR · Quality" locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">Quality register</p><h1>NCR records</h1><p class="lede">View NCR records, source findings and linked RCA in your authorized scope.</p></div></section>
  <section class="policy" aria-labelledby="policy-heading"><h2 id="policy-heading">Workflow decisions still pending</h2><ul><li><strong>PD-15 · QC owner:</strong> approved Finding-to-NCR initiation criteria.</li><li><strong>PD-16 · QC / inspection procedure owner:</strong> consequence of an inspection FAIL.</li><li><strong>PD-17 · QMS owner:</strong> NCR closure authority and workflow.</li></ul><p>These actions stay unavailable until their owners approve the governing decision. Existing records remain readable.</p></section>
  <form class="filters" method="get"><label for="state">State<select id="state" name="state"><option value="">All states</option>{states.map((value) => <option value={value} selected={state === value}>{stateLabel(value)}</option>)}</select></label><button type="submit">Apply filter</button>{state && <a href="/quality/ncr">Clear filter</a>}</form>
  {unavailable ? <ProviderUnavailableState title="NCR records are temporarily unavailable" /> : primaryNotVisible ? <p role="status">NCR records are not available in your authorized scope.</p> : <>{rcaResult.status === 'UNAVAILABLE' && <p role="status">RCA links and counts are temporarily unavailable; NCR records remain available.</p>}{findingResult.status === 'UNAVAILABLE' && <p role="status">Finding links are temporarily unavailable; NCR records remain available.</p>}{ncrs.length ? <div class="table-wrap"><table><caption>{ncrs.length} authorized NCR record{ncrs.length === 1 ? '' : 's'}</caption><thead><tr><th scope="col">NCR</th><th scope="col">Nonconformance</th><th scope="col">State</th><th scope="col">Source finding</th><th scope="col">RCA</th><th scope="col">Next step</th></tr></thead><tbody>{rows.map(({ ncr, finding, rcaCount: count }) => <tr><th scope="row"><a href={`/quality/ncr/${ncr.id}`}>{ncr.ncrNo}</a></th><td>{ncr.title}</td><td>{stateLabel(ncr.state)}</td><td>{finding ? <a href={`/quality/findings/${finding.id}`}>{finding.findingNo}</a> : findingResult.status === 'UNAVAILABLE' ? 'Finding source unavailable' : ncr.findingId ? 'Not visible in your scope' : 'Not linked'}</td><td>{count === null ? 'Count unavailable' : count ? <a href={`/quality/rca?ncrId=${encodeURIComponent(ncr.id)}`}>{count} analysis{count === 1 ? '' : 'es'}</a> : 'None visible'}</td><td>{ncr.state === 'OPEN' || ncr.state === 'UNDER_INVESTIGATION' ? <a href={`/quality/ncr/${ncr.id}`}>Review record and investigation</a> : ncr.state === 'RCA_IN_PROGRESS' ? <a href={`/quality/rca?ncrId=${encodeURIComponent(ncr.id)}`}>Review linked RCA</a> : ncr.state === 'CAPA_IN_PROGRESS' ? <a href={`/quality/capa?ncrId=${encodeURIComponent(ncr.id)}`}>Review linked CAPA</a> : ncr.state === 'READY_FOR_CLOSURE' ? 'Closure decision — QMS owner approval required' : <a href={`/quality/ncr/${ncr.id}`}>Open record</a>}</td></tr>)}</tbody></table></div> : <section class="empty"><h2>No NCR records in this view</h2><p>{state ? 'Clear the filter to see records in your authorized scope.' : 'No current NCR records are available in your authorized scope.'}</p>{state && <a href="/quality/ncr">Clear state filter</a>}</section>}</>}
</AppLayout>
<style>
  .page-head{margin-bottom:var(--space-5)}h1{margin:.25rem 0}.eyebrow,.lede,.policy p{color:var(--text-muted)}.eyebrow{font-size:var(--font-size-xs);font-weight:700;letter-spacing:.12em}.policy{margin-bottom:var(--space-5);padding:var(--space-4);background:var(--surface-panel);border-inline-start:3px solid var(--color-accent-primary)}.policy h2{font-size:1rem;margin:0}.policy ul{padding-inline-start:1.25rem}.policy p{margin-bottom:0}.filters{display:flex;flex-wrap:wrap;align-items:end;gap:var(--space-3);margin-bottom:var(--space-5)}label{display:grid;gap:.35rem}select,button{min-height:var(--control-height);padding:.55rem .75rem;background:var(--surface-panel);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.table-wrap{overflow-x:auto;max-width:100%;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:900px;border-collapse:collapse;background:var(--surface-panel)}th,td{padding:.75rem;text-align:start;border-top:1px solid var(--color-border-subtle);vertical-align:top}th{font-weight:700}a{color:var(--color-accent-primary-hover)}.empty{padding:var(--space-5);background:var(--surface-panel);border:1px dashed var(--border-default)}@media(max-width:650px){.filters{display:grid;grid-template-columns:1fr}.filters button{width:max-content}}
</style>
