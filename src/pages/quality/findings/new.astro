---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import FormErrorSummary from '../../../ui/components/FormErrorSummary.astro';
import { actions } from 'astro:actions';
import {
  detailHref,
  extractDetailId,
  field,
  optionalField,
  toFormFailure,
  type FormFailure,
} from '../../../ui/forms/mutation-post.js';

const actor=Astro.locals.actor;
if(!actor)return Astro.redirect('/login?returnTo=%2Fquality%2Ffindings%2Fnew');

const LIST_HREF = '/quality/findings';
const REQUIRED_FIELDS = [
  { name: 'findingNo', label: 'Finding number' },
  { name: 'title', label: 'Title' },
  { name: 'description', label: 'Description' },
] as const;

let values = { findingNo: '', title: '', description: '', severity: '' };
let failure: FormFailure | null = null;

// POST baseline (F-05): without JavaScript the form performs a real POST to
// this page. The same Astro Action — with the same server-side
// reauthorization — runs via Astro.callAction. No business payload enters
// the URL: input travels in the POST body, success redirects (303) to the
// new record only.
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  values = {
    findingNo: field(formData, 'findingNo'),
    title: field(formData, 'title'),
    description: field(formData, 'description'),
    severity: field(formData, 'severity'),
  };
  try {
    const data = await Astro.callAction(actions.findings.create, {
      findingNo: values.findingNo,
      title: values.title,
      description: values.description,
      severity: optionalField(formData, 'severity'),
    });
    const id = extractDetailId(data);
    if (id) return Astro.redirect(detailHref(LIST_HREF, id), 303);
    failure = {
      kind: 'unknown',
      summary: 'The finding creation result could not be confirmed.',
      recovery: 'Check the findings register before trying again to avoid a duplicate.',
      fieldErrors: {},
      firstInvalidField: null,
    };
  } catch (error) {
    failure = toFormFailure(error, {
      entity: 'Quality finding',
      requiredFields: REQUIRED_FIELDS,
      values,
      listHref: LIST_HREF,
      listLabel: 'findings',
    });
  }
}

const describedBy = (name: keyof typeof values): string | undefined =>
  failure?.fieldErrors[name] ? `${name}-error` : undefined;
const invalid = (name: keyof typeof values): 'true' | undefined =>
  failure?.fieldErrors[name] ? 'true' : undefined;
---
<AppLayout title="Create finding · Quality" locale="en" direction="ltr"><h1>Create finding</h1><p><a href="/quality/findings">Back to findings</a></p><form method="post" data-action="findings.create">{failure && <FormErrorSummary summary={failure.summary} recovery={failure.recovery} errors={Object.entries(failure.fieldErrors).map(([fieldId, message]) => ({ fieldId, message }))} listHref={LIST_HREF} listLabel="findings" />}<label for="findingNo">Finding number<span class="hint" id="findingNo-help">Use the finding number from your approved source. Reference numbers are assigned automatically.</span><input id="findingNo" name="findingNo" required value={values.findingNo} aria-invalid={invalid('findingNo')} aria-describedby={failure?.fieldErrors.findingNo ? 'findingNo-error findingNo-help' : 'findingNo-help'} /></label>{failure?.fieldErrors.findingNo && <p class="field-error" id="findingNo-error">{failure.fieldErrors.findingNo}</p>}<label for="title">Title<input id="title" name="title" required value={values.title} aria-invalid={invalid('title')} aria-describedby={describedBy('title')} /></label>{failure?.fieldErrors.title && <p class="field-error" id="title-error">{failure.fieldErrors.title}</p>}<label for="description">Description<textarea id="description" name="description" required aria-invalid={invalid('description')} aria-describedby={describedBy('description')}>{values.description}</textarea></label>{failure?.fieldErrors.description && <p class="field-error" id="description-error">{failure.fieldErrors.description}</p>}<label for="severity">Severity (if approved)<input id="severity" name="severity" value={values.severity} /></label><div class="actions"><button type="submit" data-submit>Save draft</button><a href="/quality/findings">Cancel</a></div><p role="status" data-result tabindex="-1"></p></form></AppLayout>
<script>
import { actions } from 'astro:actions'; import { enhanceClassifiedForm } from '../../../ui/forms/enhance-with-classification'; import { guardUnsavedChanges } from '../../../ui/forms/unsaved-changes'; const form=document.querySelector<HTMLFormElement>('[data-action="findings.create"]'); if(form){enhanceClassifiedForm(form,{invoke:async(payload)=>actions.findings.create(payload as Parameters<typeof actions.findings.create>[0]),payload:(data)=>({findingNo:String(data.get('findingNo')??''),title:String(data.get('title')??''),description:String(data.get('description')??''),severity:String(data.get('severity')||'')||undefined}),progressText:'Saving finding…',detailBaseHref:'/quality/findings',unknownRecoveryHref:'/quality/findings'});guardUnsavedChanges(form);}
</script>
<style>form{display:grid;gap:1rem;max-width:42rem}label{display:grid;gap:.35rem}input,textarea{padding:.7rem;background:var(--surface-panel);color:inherit;border:1px solid var(--color-border-subtle)}.hint{color:var(--text-muted);font-size:.8rem}input[aria-invalid="true"],textarea[aria-invalid="true"]{border-color:var(--status-danger)}.field-error{margin:0;color:var(--status-danger);font-size:.8rem}.actions{display:flex;gap:1rem;align-items:center;flex-wrap:wrap}button{width:max-content;padding:.7rem 1rem;background:var(--color-accent-primary);color:#fff;border:0;border-radius:var(--radius-md)}button[disabled]{opacity:.6}a{color:var(--color-accent-primary-hover)}</style>
