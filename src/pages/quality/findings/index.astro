---
import AppLayout from '../../../ui/layouts/AppLayout.astro';import{getDatabase}from'../../../shared/database/database.js';import{PostgresFindingRepository}from'../../../modules/quality/findings/infrastructure/postgres-repository.js';import{ListFindingsUseCase}from'../../../modules/quality/findings/application/list-findings.js';const actor=Astro.locals.actor;if(!actor)return Astro.redirect('/login?returnTo=%2Fquality%2Ffindings');const findings=await new ListFindingsUseCase(new PostgresFindingRepository(getDatabase())).execute({actor});
---
<AppLayout title="Findings · Quality" locale="en" direction="ltr"><section class="page-head"><div><p class="eyebrow">QUALITY / OBSERVATIONS</p><h1>Findings</h1></div><a class="button" href="/quality/findings/new">Create Finding</a></section>{findings.length?<table><caption>Authorized findings</caption><thead><tr><th>Finding ID</th><th>Summary</th><th>State</th><th>Source context</th></tr></thead><tbody>{findings.map(f=><tr><th><a href={`/quality/findings/${f.id}`}>{f.findingNo}</a></th><td>{f.title}</td><td>{f.state}</td><td>{f.sourceContext?'Recorded':'Not provided'}</td></tr>)}</tbody></table>:<p class="lede">No findings in your authorized scope.</p>}</AppLayout>
<style>.page-head{display:flex;justify-content:space-between}.eyebrow,.lede{color:var(--text-muted)}.button{padding:.6rem 1rem;background:var(--color-accent-primary);color:#fff;border-radius:var(--radius-md);text-decoration:none}table{width:100%;border-collapse:collapse;background:var(--surface-panel)}th,td{padding:.75rem;text-align:start;border-top:1px solid var(--color-border-subtle)}caption{text-align:start;padding:.75rem;color:var(--text-muted)}a{color:var(--color-accent-primary-hover)}</style>
