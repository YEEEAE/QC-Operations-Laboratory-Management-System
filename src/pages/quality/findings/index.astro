---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import { findingsReadDependencies } from '../../../modules/quality/findings/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquality%2Ffindings');
const findingStates = ['DRAFT', 'OPEN', 'UNDER_REVIEW', 'CLOSED', 'VOID'] as const;
const requestedState = Astro.url.searchParams.get('state');
const state = findingStates.find((value) => value === requestedState);
let findings: Awaited<ReturnType<ReturnType<typeof findingsReadDependencies>['list']['execute']>> = [];
let providerUnavailable = false;
try { findings = await findingsReadDependencies().list.execute({ actor, state }); } catch { providerUnavailable = true; }
---
<AppLayout title="Findings · Quality" locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">QUALITY / OBSERVATIONS</p><h1>Findings</h1><p class="lede">Record and investigate quality observations in the authorized scope.</p></div><a class="button" href="/quality/findings/new">Create finding</a></section>
  <form class="filters" method="get"><label for="state">State<select id="state" name="state"><option value="">All states</option>{findingStates.map((value) => <option value={value} selected={state === value}>{value}</option>)}</select></label><button class="button secondary" type="submit">Apply filter</button>{state && <a href="/quality/findings">Clear</a>}</form>
  {providerUnavailable ? <ProviderUnavailableState title="Findings are temporarily unavailable" /> : findings.length ? <div class="table-wrap"><table><caption>{findings.length} authorized finding{findings.length === 1 ? '' : 's'}</caption><thead><tr><th scope="col">Finding ID</th><th scope="col">Summary</th><th scope="col">Severity</th><th scope="col">State</th><th scope="col">Owner</th><th scope="col">Created</th><th scope="col">Source context</th></tr></thead><tbody>{findings.map((finding) => <tr><th scope="row"><a href={`/quality/findings/${finding.id}`}>{finding.findingNo}</a></th><td>{finding.title}</td><td>{finding.severity ?? 'Not classified'}</td><td>{finding.state}</td><td>{finding.ownerId ?? 'Unassigned'}</td><td><time datetime={finding.createdAt.toISOString()}>{finding.createdAt.toLocaleDateString('en-SA', { timeZone: 'Asia/Riyadh' })}</time></td><td>{finding.sourceContext ? 'Recorded' : 'Not provided'}</td></tr>)}</tbody></table></div> : <section class="empty-state"><p class="eyebrow">NO MATCHES</p><h2>No findings match this view</h2><p>{state ? 'Clear the state filter or choose another state.' : 'No findings are available in your authorized scope.'}</p>{state && <a href="/quality/findings">Clear filters</a>}</section>}
</AppLayout>
<style>.page-head,.filters{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-end}.page-head{align-items:flex-start;margin-bottom:var(--space-5)}h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.empty-state p{color:var(--text-muted);font-size:.85rem}.button{display:inline-flex;align-items:center;min-height:var(--control-height);padding:.6rem 1rem;background:var(--color-accent-primary);color:var(--color-text-inverse);border:1px solid var(--color-accent-primary);border-radius:var(--radius-md);text-decoration:none;font-weight:700}.secondary{background:var(--surface-raised);border-color:var(--border-default);color:var(--text-primary)}.filters{justify-content:flex-start;margin-bottom:var(--space-5);align-items:end}label{display:grid;gap:.35rem;color:var(--text-secondary);font-size:.8rem}select{min-height:var(--control-height);padding:.55rem .7rem;background:var(--surface-panel);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.filters>a{color:var(--color-accent-primary-hover);align-self:center}.table-wrap{overflow-x:auto;max-width:100%;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:960px;border-collapse:collapse;background:var(--surface-panel)}th,td{padding:.75rem;text-align:start;border-top:1px solid var(--color-border-subtle);vertical-align:top;font-size:.8rem}th{font-weight:700}caption{text-align:start;padding:.75rem;color:var(--text-muted)}a{color:var(--color-accent-primary-hover)}.empty-state{padding:3rem 1.5rem;text-align:center;background:var(--surface-panel);border:1px dashed var(--color-border-strong);border-radius:var(--radius-lg)}.empty-state h2{margin:.5rem 0}.empty-state a{font-weight:700}@media(max-width:650px){.page-head,.filters{display:grid}.button{width:max-content}}</style>
