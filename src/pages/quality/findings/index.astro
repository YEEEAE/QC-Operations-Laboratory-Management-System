---
import PageHeader from "../../../ui/components/PageHeader.astro";
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import PolicyBlocker from '../../../ui/components/feedback/PolicyBlocker.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import { stateLabel, severityLabel } from '../../../shared/copy/ux-vocabulary.js';
import { formatDate } from '../../../shared/copy/format.js';
import { findingsReadDependencies } from '../../../modules/quality/findings/application/dependencies.js';
import { identityAdminReadDependencies } from '../../../modules/identity/application/admin-dependencies.js';
import Pagination from '../../../ui/components/data/Pagination.astro';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquality%2Ffindings');
const findingStates = ['DRAFT', 'OPEN', 'UNDER_REVIEW', 'CLOSED', 'VOID'] as const;
const requestedState = Astro.url.searchParams.get('state');
const state = findingStates.find((value) => value === requestedState);
let findings: Awaited<ReturnType<ReturnType<typeof findingsReadDependencies>['list']['execute']>> = [];
const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
const pageInput = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const pageSize = 25;
let total = 0;
let page = 1;
let providerUnavailable = false;
try {
  const result = await findingsReadDependencies().list.executePage({
    actor,
    state,
    page: { page: pageInput, pageSize },
  });
  findings = result.items;
  total = result.total;
  page = result.page;
} catch { providerUnavailable = true; }
// The register names the owner, never a raw account identifier. Resolution is
// presentation-only and failure-tolerant.
let ownerNames = new Map<string, string>();
try {
  ownerNames = new Map(await identityAdminReadDependencies().listUsers.resolveDisplayNames({
    actor,
    userIds: findings.map((finding) => finding.ownerId).filter((id): id is string => Boolean(id)),
  }));
} catch {
  // Presentation-only; fall back to a named-account label below.
}
const ownerLabel = (ownerId: string | null | undefined) =>
  ownerId ? (ownerNames.get(ownerId) ?? 'Named account') : 'Unassigned';
const totalPages = Math.max(1, Math.ceil(total / pageSize));
// CA-03 source mapping: READ uses authenticated SSR, scoped executePage,
// populated / empty / filtered-empty output, and one provider alert with retry.
// FILTER uses the validated state and native GET; submitting resets pagination.
// READ/FILTER pending and client validation: N/A — no local asynchronous read
// or filter script. Unsupported states already resolve to the unfiltered view.
// EXPORT / page-specific AUTH controls: N/A — none exist on this register;
// the absent-actor redirect and shared shell authentication remain unchanged.
// Previous functional debt, outside this presentation change: the primary
// catch maps all read errors to provider-unavailable, and owner-name failures
// silently retain the existing "Named account" fallback.
// PD-16 notice follows quality/ncr/index.astro. Finding-specific NCR eligibility
// and NCR/RCA/CAPA relationships stay in the existing scoped detail routes.
// Local CAPA A tokens are used; literal visual-reference match is unconfirmed.
---
<AppLayout title="Findings · Quality" locale="en" direction="ltr">
  <div class="findings-register">
    <PageHeader>
      <Fragment slot="heading"><h1>Findings</h1></Fragment>
      <Fragment slot="actions"><a class="button" href="/quality/findings/new">Create finding</a></Fragment>
    </PageHeader>

    <section class="filter-panel" aria-label="Filter findings">
      <form class="filters" method="get" role="search" aria-label="Filter findings by state">
        <label for="state">State
          <select id="state" name="state">
            <option value="">All states</option>
            {findingStates.map((value) => <option value={value} selected={state === value}>{stateLabel(value)}</option>)}
          </select>
        </label>
        <button class="button secondary" type="submit">Apply filter</button>
        {state && <a class="clear-filter" href="/quality/findings">Clear filter</a>}
      </form>
      <div class="active-filters" role="group" aria-label="Applied filters" data-applied-filters>
        {state ? <>
          <span class="filter-label">Filtered by</span>
          <ul><li><span class="filter-label">State:</span> {stateLabel(state)}</li></ul>
        </> : <p>Showing records in your authorized scope.</p>}
      </div>
    </section>

    <PolicyBlocker title="Workflow decision still pending" decisions={[
      { id: 'PD-16', owner: 'QC / inspection procedure owner', consequence: 'The consequence of an inspection FAIL remains unresolved; this register does not create an NCR automatically.' },
    ]} />

    <section class="register-results" aria-label="Findings register">
      {providerUnavailable ? (
        <ProviderUnavailableState title="Findings are temporarily unavailable" />
      ) : findings.length ? (
        <div class="table-wrap" role="region" aria-labelledby="findings-register-caption" tabindex="0">
          <table>
            <caption id="findings-register-caption">{total} authorized finding{total === 1 ? '' : 's'}{state ? ` matching ${stateLabel(state)}` : ''}</caption>
            <colgroup>
              <col class="number-column" /><col class="summary-column" />
              <col class="severity-column" /><col class="state-column" />
              <col class="owner-column" /><col class="created-column" /><col class="context-column" />
            </colgroup>
            <thead>
              <tr>
                <th scope="col">Finding number</th>
                <th scope="col">Summary</th>
                <th scope="col">Severity</th>
                <th scope="col">State</th>
                <th scope="col">Owner</th>
                <th scope="col">Created</th>
                <th scope="col">Source context</th>
              </tr>
            </thead>
            <tbody>
              {findings.map((finding) => (
                <tr>
                  <th scope="row"><a class="record-link" href={`/quality/findings/${finding.id}`}>{finding.findingNo}</a></th>
                  <td class="finding-summary">{finding.title}</td>
                  <td>{severityLabel(finding.severity)}</td>
                  <td><span class="state-pill">{stateLabel(finding.state)}</span></td>
                  <td>{ownerLabel(finding.ownerId)}</td>
                  <td><time datetime={finding.createdAt.toISOString()}>{formatDate(finding.createdAt)}</time></td>
                  <td>{finding.sourceContext ? 'Recorded' : 'Not provided'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <section class="empty-state" aria-labelledby="findings-empty-title">
          <p class="eyebrow">{state ? 'No matches' : 'No records'}</p>
          <h2 id="findings-empty-title">{state ? 'No findings match this view' : 'No findings in this view'}</h2>
          <p>{state ? 'Clear the state filter or choose another state.' : 'No findings are available in your authorized scope.'}</p>
          {state && <a href="/quality/findings">Clear filters</a>}
        </section>
      )}
      {!providerUnavailable && total > 0 && <Pagination page={page} totalPages={totalPages} />}
    </section>
  </div>
</AppLayout>
<style>
  .findings-register { display: grid; gap: var(--space-5); inline-size: 100%; min-inline-size: 0; }
  .findings-register :global(.page-header) { margin-block-end: 0; }
  .filter-panel, .register-results { min-inline-size: 0; }
  .filter-panel { padding: var(--space-4); background: var(--surface-panel); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); }
  .filters { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: end; min-inline-size: 0; }
  label { display: grid; gap: var(--space-2); min-inline-size: 0; color: var(--text-secondary); font-size: var(--font-size-sm); }
  select { min-block-size: 44px; min-inline-size: 12rem; max-inline-size: 100%; padding: .6rem .75rem; background: var(--surface-inset); border: 1px solid var(--control-border); border-radius: var(--radius-sm); color: var(--text-primary); font: inherit; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-block-size: 44px; max-inline-size: 100%; padding: .6rem 1rem; background: var(--color-accent-primary); color: var(--text-on-accent); border: 1px solid var(--color-accent-primary); border-radius: var(--radius-md); text-decoration: none; font: inherit; font-size: var(--font-size-sm); font-weight: 700; overflow-wrap: anywhere; }
  .secondary { background: var(--surface-raised); border-color: var(--control-border); color: var(--text-primary); cursor: pointer; }
  .secondary:hover { background: var(--color-surface-hover); }
  .clear-filter, .empty-state a { display: inline-flex; align-items: center; min-block-size: 44px; font-size: var(--font-size-sm); font-weight: 600; }
  .active-filters { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-block-start: var(--space-3); font-size: var(--font-size-sm); }
  .active-filters p { margin: 0; color: var(--text-muted); }
  .active-filters ul { display: flex; flex-wrap: wrap; gap: var(--space-2); min-inline-size: 0; margin: 0; padding: 0; list-style: none; }
  .active-filters li { min-inline-size: 0; padding: var(--space-2) var(--space-3); border: 1px solid var(--border-default); border-radius: var(--radius-md); background: var(--surface-inset); overflow-wrap: anywhere; }
  .filter-label { color: var(--text-muted); }
  .table-wrap { overflow-x: auto; max-inline-size: 100%; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); }
  table { inline-size: 100%; min-inline-size: 64rem; table-layout: fixed; border-collapse: collapse; background: var(--surface-panel); font-variant-numeric: tabular-nums; }
  .number-column { inline-size: 16%; }
  .summary-column { inline-size: 28%; }
  .severity-column { inline-size: 9%; }
  .state-column, .created-column, .context-column { inline-size: 11%; }
  .owner-column { inline-size: 14%; }
  caption { padding: var(--space-4); text-align: start; color: var(--text-secondary); font-size: var(--font-size-sm); }
  th, td { padding: var(--space-3); text-align: start; vertical-align: top; border-block-start: 1px solid var(--color-border-subtle); color: var(--text-secondary); font-size: var(--font-size-sm); line-height: 1.6; white-space: normal; overflow-wrap: anywhere; }
  th { font-weight: 700; }
  thead th { background: var(--table-header-background); color: var(--text-primary); }
  tbody tr:nth-child(even) { background: var(--table-stripe-background); }
  tbody tr:hover, tbody tr:focus-within { background: var(--color-surface-hover); }
  .record-link { display: inline-flex; align-items: center; min-block-size: 44px; max-inline-size: 100%; overflow-wrap: anywhere; text-underline-offset: 3px; }
  .finding-summary { color: var(--text-primary); }
  .state-pill { display: inline-block; max-inline-size: 100%; padding: .2rem .5rem; border: 1px solid var(--border-default); border-radius: var(--radius-sm); background: var(--status-neutral-bg); color: var(--text-primary); font-size: var(--font-size-xs); overflow-wrap: anywhere; }
  a { color: var(--color-accent-primary-hover); }
  a:focus-visible, button:focus-visible, select:focus-visible, .table-wrap:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .empty-state { padding: var(--space-6); text-align: center; background: var(--surface-panel); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-lg); }
  .eyebrow { margin: 0; color: var(--text-muted); font-size: var(--font-size-xs); font-weight: 700; }
  .empty-state h2 { margin-block: var(--space-2); font-size: var(--font-size-lg); }
  .empty-state p { color: var(--text-muted); font-size: var(--font-size-sm); }
  @media (max-width: 650px) {
    .filters { display: grid; grid-template-columns: minmax(0, 1fr); }
    select { min-inline-size: 0; inline-size: 100%; }
    .filters .button, .clear-filter { justify-self: start; }
  }
  @media (forced-colors: active) {
    .filter-panel, .table-wrap, .active-filters li, .state-pill, .empty-state { border-color: CanvasText; }
    .button, select { border-color: ButtonText; }
    a:focus-visible, button:focus-visible, select:focus-visible, .table-wrap:focus-visible { outline-color: Highlight; }
  }
</style>
