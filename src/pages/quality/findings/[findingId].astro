---
import AppLayout from '../../../ui/layouts/AppLayout.astro';import{getDatabase}from'../../../shared/database/database.js';import{PostgresFindingRepository}from'../../../modules/quality/findings/infrastructure/postgres-repository.js';import{GetFindingUseCase}from'../../../modules/quality/findings/application/get-finding.js';const actor=Astro.locals.actor;if(!actor)return Astro.redirect('/login');const finding=await new GetFindingUseCase(new PostgresFindingRepository(getDatabase())).execute({actor,id:Astro.params.findingId!});
---
<AppLayout title={`${finding.findingNo} · Quality`} locale="en" direction="ltr"><p class="eyebrow">QUALITY / FINDING</p><h1>{finding.findingNo}</h1><p>{finding.title}</p><p class="lede">{finding.description}</p><dl><dt>State</dt><dd>{finding.state}</dd><dt>Version</dt><dd>{finding.version.toString()}</dd><dt>Source context</dt><dd>{finding.sourceContext?'Recorded':'Not provided'}</dd></dl><h2>History and related NCR</h2><p class="lede">Controlled history and related records are resolved by authorized server-side queries.</p></AppLayout><style>.eyebrow,.lede{color:var(--text-muted)}dl{display:grid;grid-template-columns:max-content 1fr;gap:.65rem 1rem;background:var(--surface-panel);padding:1rem}dt{font-weight:700}dd{margin:0}</style>
