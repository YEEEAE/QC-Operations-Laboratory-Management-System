---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import { RunReportUseCase } from '../../modules/reporting/application/run-report.js';
import { reportingDependencies } from '../../modules/reporting/application/dependencies.js';
import { AppError } from '../../shared/errors/app-error.js';
import { parseReportFilters } from '../../modules/reporting/application/parse-report-filters.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const code = Astro.params.reportCode ?? '';
const { registry } = reportingDependencies();
const fallbackDefinition = registry.list()[0]!;
let definition = fallbackDefinition;
let report: Awaited<ReturnType<RunReportUseCase['execute']>> = { definition, columns: [], rows: [] };
let filters: ReturnType<typeof parseReportFilters> = {};
let accessDenied = false;
let providerUnavailable = false;
let invalidFilters = false;
try { definition = registry.get(code); filters = parseReportFilters(Astro.url.searchParams); report = await reportingDependencies().run.execute(actor, code, filters); } catch (error) { if (error instanceof AppError && error.code === 'RESOURCE_NOT_FOUND') Astro.response.status = 404; else if (error instanceof AppError && error.code.startsWith('AUTHZ_')) { accessDenied = true; Astro.response.status = 403; } else if (error instanceof AppError && error.code.startsWith('VALIDATION_')) { invalidFilters = true; Astro.response.status = 400; } else { providerUnavailable = true; Astro.response.status = 503; } }
const hasReportFilters = Object.values(filters).some((value) => value !== undefined);
const generatedAt = new Date();
const filterDescription = Object.entries(filters)
  .filter((entry) => entry[1] !== undefined)
  .map(([key, value]) => `${key}=${String(value)}`)
  .join('; ') || 'No optional filters';
const exportQuery = new URLSearchParams(
  Object.entries(filters).filter((entry): entry is [string, string | number | boolean] => entry[1] !== undefined)
    .map(([key, value]) => [key, String(value)]),
).toString();
---
<AppLayout title={`${definition?.title ?? 'Report'} · QC Operations`} locale="en" direction="ltr">
  {Astro.response.status === 404 ? <section class="empty"><h1>Report not found</h1><p>This report code is not registered.</p><a href="/reports">Back to reports</a></section> : accessDenied ? <section class="empty" role="alert"><h1>Not authorized</h1><p>Your account cannot view this report. No report rows or counts were returned.</p><a href="/reports">Back to reports</a></section> : invalidFilters ? <section class="empty" role="alert"><h1>Filters need attention</h1><p>One or more filter values are invalid. No report was generated.</p><a href={`/reports/${code}`}>Clear filters</a></section> : providerUnavailable ? <section class="empty" role="status"><h1>Report unavailable</h1><p>The report source did not confirm a result. No empty state or row count is shown.</p><a href={`/reports/${code}`}>Retry</a></section> : <><section class="page-head"><div><p class="eyebrow">{definition.code}</p><h1>{definition.title}</h1><p>{definition.description}</p></div><a href="/reports">All reports</a></section><section class="report-provenance" aria-label="Report provenance"><strong>UNAPPROVED REPORT COPY — informational; not a controlled record</strong><dl><div><dt>Source</dt><dd>qc.receiving_items · server report query</dd></div><div><dt>Prepared by</dt><dd>{actor.loginIdentity ?? actor.id}</dd></div><div><dt>Actor scope</dt><dd>Records created by this account (OWN scope)</dd></div><div><dt>Period</dt><dd>{filters.from ?? 'All dates'} to {filters.to ?? 'Present'}</dd></div><div><dt>Filters</dt><dd>{filterDescription}</dd></div><div><dt>Sort</dt><dd>Receiving date descending, then stable record id descending</dd></div><div><dt>Status</dt><dd>{definition.status === 'UNAPPROVED_INFORMATIONAL_COPY' ? 'UNAPPROVED · informational copy' : definition.status}</dd></div><div><dt>Generated at</dt><dd><time datetime={generatedAt.toISOString()}>{generatedAt.toISOString()}</time> (UTC)</dd></div><div><dt>Rows</dt><dd>{report.rows.length} records</dd></div></dl></section><section class="toolbar"><span>{report.rows.length} authorized records</span><span role="status">{report.rows.length === 0 ? hasReportFilters ? 'FILTERED EMPTY — no records match the applied filters' : 'EMPTY — no records in this authorized scope' : 'Filters applied on the server.'}</span><span class="export-links"><a href={`/reports/${definition.code}/export?format=csv${exportQuery ? `&${exportQuery}` : ''}`}>Export CSV</a><a href={`/reports/${definition.code}/export?format=xlsx${exportQuery ? `&${exportQuery}` : ''}`}>Export XLSX</a></span></section><p class="privacy-note" role="note">Export files contain the report data shown here and download through your browser. Keep exported copies in an approved secure location; copies outside the app are not covered by its access or correction controls.</p><div class="report-table-panel"><div class="table-controls"><label class="density-control">Row density<select aria-label="Row density" id="report-density"><option value="comfortable">Comfortable</option><option value="standard" selected>Standard</option><option value="compact">Compact</option></select></label><p class="bulk-note" role="note">Bulk actions: none are available for this report. Report rows are informational and cannot be changed here.</p></div><div class="table-scroll"><table id="report-table" data-density="standard"><caption>{definition.title} — {report.rows.length} authorized records</caption><thead><tr>{report.columns.map((column) => <th scope="col">{column.label}</th>)}</tr></thead><tbody>{report.rows.map((row) => <tr><th scope="row">{row[report.columns[0]?.key ?? ''] === null ? '' : String(row[report.columns[0]?.key ?? ''])}</th>{report.columns.slice(1).map((column) => <td>{row[column.key] === null ? '' : String(row[column.key])}</td>)}</tr>)}</tbody></table></div></div></>}
</AppLayout>
<script>
  const preferenceKey = 'qc.register-density';
  const table = document.querySelector<HTMLTableElement>('#report-table');
  const select = document.querySelector<HTMLSelectElement>('#report-density');
  const allowed = new Set(['comfortable', 'standard', 'compact']);
  if (table && select) {
    try {
      const saved = localStorage.getItem(preferenceKey);
      if (saved && allowed.has(saved)) { table.dataset.density = saved; select.value = saved; }
    } catch { /* Storage may be unavailable; the table still works with its default density. */ }
    select.addEventListener('change', () => {
      if (!allowed.has(select.value)) return;
      table.dataset.density = select.value;
      try { localStorage.setItem(preferenceKey, select.value); } catch { /* Apply for this page view. */ }
    });
  }
</script>
<style>.page-head,.toolbar{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.page-head{margin-bottom:var(--space-5)}h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.page-head p,.toolbar{color:var(--text-muted);font-size:.85rem}.toolbar{padding:var(--space-3) var(--space-4);background:var(--surface-raised);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md);margin-bottom:var(--space-4)}.report-table-panel{overflow:hidden;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}.table-controls{display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);padding:var(--space-3) var(--space-4)}.density-control{display:inline-flex;align-items:center;gap:var(--space-2);font-size:var(--font-size-xs);color:var(--text-muted)}.density-control select{min-height:var(--control-height)}.bulk-note{margin:0;color:var(--text-muted);font-size:var(--font-size-xs)}.table-scroll{overflow:auto}table{width:100%;min-width:980px;border-collapse:collapse;font-size:.8rem}table[data-density="comfortable"] th,table[data-density="comfortable"] td{padding:1rem}table[data-density="standard"] th,table[data-density="standard"] td{padding:.75rem}table[data-density="compact"] th,table[data-density="compact"] td{padding:.4rem .6rem}th{color:var(--text-primary);background:var(--surface-raised)}td{color:var(--text-secondary)}.empty{padding:var(--space-8);text-align:center}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:600px){.page-head{display:block}.toolbar{display:grid;gap:var(--space-2)}}
.export-links{display:inline-flex;gap:var(--space-3)}
.export-links a{color:var(--color-accent-primary-hover);font-size:.8rem;font-weight:600}
.privacy-note{margin:0 0 var(--space-4);padding:var(--space-3) var(--space-4);border-inline-start:3px solid var(--color-accent-primary);background:var(--surface-raised);color:var(--text-muted);font-size:.82rem}
.report-provenance{margin-block:var(--space-4);padding:var(--space-4);border:1px solid var(--color-border-subtle);background:var(--surface-raised);font-size:var(--font-size-xs)}.report-provenance>strong{color:var(--status-warning)}.report-provenance dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:var(--space-3);margin:var(--space-3) 0 0}.report-provenance dl div{min-width:0}.report-provenance dt{font-weight:700;color:var(--text-muted)}.report-provenance dd{margin:.15rem 0 0;overflow-wrap:anywhere}
@media print{.page-head a,.toolbar,.export-links,.privacy-note,.density-control,.bulk-note{display:none!important}body{background:#fff}.report-provenance{break-inside:avoid;color:#000;background:#fff;border:1px solid #777}.report-provenance>strong{color:#000}.report-provenance dt{color:#333}.report-provenance dd{color:#000}.density-control,.bulk-note{display:none!important}.report-table-panel{border:0;overflow:visible}.table-scroll{border:0;overflow:visible}table{min-width:0;font-size:9pt}th,td{border:1px solid #999;padding:4px 6px}th{background:#eee;color:#000}} </style>
