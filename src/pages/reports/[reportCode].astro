---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import { ReportRegistry } from '../../modules/reporting/application/report-registry.js';
import { RunReportUseCase } from '../../modules/reporting/application/run-report.js';
import { PostgresReportQuery } from '../../modules/reporting/infrastructure/postgres-report-query.js';
import { getDatabase } from '../../shared/database/database.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const code = Astro.params.reportCode ?? '';
const registry = new ReportRegistry();
const fallbackDefinition = registry.list()[0]!;
let definition = fallbackDefinition;
let report: Awaited<ReturnType<RunReportUseCase['execute']>> = { definition, columns: [], rows: [] };
try { definition = registry.get(code); report = await new RunReportUseCase(registry, new PostgresReportQuery(getDatabase())).execute(actor, code, { from: Astro.url.searchParams.get('from') ?? undefined, to: Astro.url.searchParams.get('to') ?? undefined }); } catch (error) { if (error instanceof Error && 'code' in error && (error as { code: string }).code === 'RESOURCE_NOT_FOUND') Astro.response.status = 404; else throw error; }
---
<AppLayout title={`${definition?.title ?? 'Report'} · QC Operations`} locale="en" direction="ltr">
  {Astro.response.status === 404 ? <section class="empty"><h1>Report not found</h1><p>This report code is not registered.</p><a href="/reports">Back to reports</a></section> : <><section class="page-head"><div><p class="eyebrow">{definition.code}</p><h1>{definition.title}</h1><p>{definition.description}</p></div><a href="/reports">All reports</a></section><section class="toolbar"><span>{report.rows.length} authorized rows</span><span>Filters are applied on the server.</span></section><div class="table-scroll"><table><caption class="visually-hidden">{definition.title}</caption><thead><tr>{report.columns.map((column) => <th scope="col">{column.label}</th>)}</tr></thead><tbody>{report.rows.map((row) => <tr>{report.columns.map((column) => <td>{row[column.key] === null ? '' : String(row[column.key])}</td>)}</tr>)}</tbody></table></div></>}
</AppLayout>
<style>.page-head,.toolbar{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.page-head{margin-bottom:var(--space-5)}h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.page-head p,.toolbar{color:var(--text-muted);font-size:.85rem}.toolbar{padding:var(--space-3) var(--space-4);background:var(--surface-raised);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md);margin-bottom:var(--space-4)}.table-scroll{overflow:auto;background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:980px;border-collapse:collapse;font-size:.8rem}th,td{padding:12px 14px;text-align:start;border-bottom:1px solid var(--color-border-subtle)}th{color:var(--text-primary);background:var(--surface-raised)}td{color:var(--text-secondary)}.empty{padding:var(--space-8);text-align:center}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:600px){.page-head{display:block}.toolbar{display:grid;gap:var(--space-2)}} </style>
