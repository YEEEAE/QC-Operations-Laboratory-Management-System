---
import PageHeader from "../../ui/components/PageHeader.astro";
import Icon from '../../ui/components/Icon.astro';
import AppLayout from '../../ui/layouts/AppLayout.astro';
import { reportingDependencies } from '../../modules/reporting/application/dependencies.js';
import { authorize } from '../../shared/authorization/authorize.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Freports');
const registry = reportingDependencies().registry;
const reports = registry.list().filter((report) => authorize({ actor, permission: report.viewPermission, action: 'VIEW', entity: { type: 'REPORT', id: report.code, state: 'ACTIVE', ownerId: actor.id, domain: 'REPORTING' }, scope: { domain: 'REPORTING' }, currentVersion: 1, expectedVersion: 1, businessCondition: true }).allowed);
---
<AppLayout title="Reports · QC Operations" locale="en" direction="ltr">
  <PageHeader purpose="Select a report to review its authorized information."><Fragment slot="heading"><h1>Reports</h1></Fragment></PageHeader>
  {reports.length ? <section class="report-grid" aria-label="Available reports">{reports.map((report) => <article class="report-card"><p class="eyebrow">{report.code}</p><h2><a href={`/reports/${report.code}`}>{report.title}</a></h2><p class="description">{report.description}</p><a class="open" href={`/reports/${report.code}`}>Open report <Icon name="arrow-right" /></a></article>)}</section> : <p class="empty">No reports are available for your current permissions and scope.</p>}
</AppLayout>
<style>
  .eyebrow,.description,.empty{color:var(--text-muted)}
  .eyebrow{margin:0;font-size:var(--font-size-xs);font-weight:var(--font-weight-semibold);letter-spacing:.08em;overflow-wrap:anywhere}
  .report-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,22rem),1fr));gap:var(--space-4)}
  .report-card{display:flex;min-inline-size:0;flex-direction:column;align-items:flex-start;padding:var(--space-5);background:var(--surface-raised);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}
  h2{margin:var(--space-2) 0;font-size:var(--font-size-lg);line-height:var(--line-height-tight);overflow-wrap:anywhere}
  h2 a{display:inline-flex;min-block-size:44px;max-inline-size:100%;align-items:center;color:var(--text-primary);text-decoration-color:var(--color-border-subtle);text-underline-offset:.2em}
  h2 a:hover{color:var(--color-accent-primary-hover);text-decoration-color:currentColor}
  .description,.empty{margin:0;font-size:var(--font-size-sm);line-height:var(--line-height-normal)}
  .open{display:inline-flex;min-block-size:44px;align-items:center;gap:var(--space-2);margin-block-start:auto;padding-block:var(--space-2);padding-inline:var(--space-1);color:var(--color-accent-primary-hover);font-size:var(--font-size-sm);font-weight:var(--font-weight-semibold);text-decoration-thickness:1px;text-underline-offset:.2em}
  .open:focus-visible,h2 a:focus-visible{outline:2px solid var(--focus-ring);outline-offset:3px;border-radius:var(--radius-sm)}
  .empty{padding:var(--space-5);background:var(--surface-raised);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}
</style>
