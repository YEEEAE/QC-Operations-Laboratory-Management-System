---
import PageHeader from "../../ui/components/PageHeader.astro";
import AppLayout from '../../ui/layouts/AppLayout.astro';
import { hasAdminCapability } from '../../shared/authorization/admin-workspace.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const canCreateUser = hasAdminCapability(actor, 'createUser');
const canAudit = hasAdminCapability(actor, 'viewAudit');
---

<AppLayout title="Administration · QC Operations" locale="en" direction="ltr">
  <PageHeader><Fragment slot="heading"><h1>Administration</h1></Fragment>
      
      
      <p class="lede">Manage members, roles and access.</p>
    </PageHeader>
  <div class="grid">
        <section class="panel panel-featured">
          <p class="eyebrow">UI-ADM-USR-001</p>
          <h2>Users</h2>
          <p>Create, inspect, update, disable, and reset member accounts within your authority.</p>
          <div class="links">
            <a class="button" href="/admin/users">Open users</a>
            {canCreateUser && <a class="button secondary" href="/admin/users/new">Create user</a>}
          </div>
        </section>
        <section class="panel">
          <p class="eyebrow">UI-ADM-ROLE-001</p>
          <h2>Roles</h2>
          <p>Inspect roles and manage their canonical permission grants with version checks.</p>
          <div class="links"><a class="button" href="/admin/roles">Open roles</a></div>
        </section>
        <section class="panel">
          <p class="eyebrow">UI-ADM-PERM-001</p>
          <h2>Permissions</h2>
          <p>Read-only catalog of canonical permissions. Grants change only through roles.</p>
          <div class="links"><a class="button" href="/admin/permissions">Open permissions</a></div>
        </section>
        <section class="panel">
          <p class="eyebrow">UI-ADM-SCOPE-001</p>
          <h2>Scopes</h2>
          <p>
            Manage member authorization scopes. Self-grants are always blocked and audited.
          </p>
          <div class="links"><a class="button" href="/admin/scopes">Open scopes</a></div>
        </section>
        <section class="panel">
          <p class="eyebrow">DATA-01</p>
          <h2>Master data</h2>
          <p>Review source ownership, pending revisions, and controlled import approval.</p>
          <div class="links"><a class="button" href="/admin/master-data">Open master data</a></div>
        </section>
        {canAudit && (
          <section class="panel">
            <p class="eyebrow">AUDIT</p>
            <h2>Audit history</h2>
            <p>Administration changes are recorded as audit events and survive record changes.</p>
            <div class="links">
              <a class="button secondary" href="/audit">
                Open audit
              </a>
            </div>
          </section>
        )}
  </div>
</AppLayout>
<style>
  .page-head {
    margin-bottom: var(--space-6);
  }
  h1 {
    margin: 0.25rem 0;
  }
  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    letter-spacing: 0.12em;
    font-weight: 700;
  }
  .lede,
  .empty {
    color: var(--text-muted);
    font-size: 0.86rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17.5rem), 1fr));
    gap: var(--space-5);
  }
  .panel,
  .denied {
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }
  .panel-featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding: var(--space-6);
  }
  .panel-featured > :not(.links) {
    grid-column: 1;
    min-inline-size: 0;
  }
  .panel-featured h2 {
    font-size: 1.125rem;
  }
  .panel-featured > .links {
    grid-column: 2;
    grid-row: 1 / span 3;
    justify-content: flex-end;
    margin-block-start: 0;
  }
  .denied p {
    color: var(--text-muted);
    font-size: 0.84rem;
  }
  h2 {
    margin: 0.25rem 0 0;
    font-size: 1rem;
  }
  .panel p {
    color: var(--text-muted);
    font-size: 0.84rem;
  }
  .links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
  .button {
    border: 1px solid var(--color-accent-primary);
    background: var(--color-accent-primary);
    color:var(--text-on-accent);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 700;
  }
  .button.secondary {
    background: transparent;
    color: var(--color-accent-primary-hover);
  }
  @media (max-width: 600px) {
    .panel-featured {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-5);
    }
    .panel-featured > .links {
      grid-column: 1;
      grid-row: auto;
      justify-content: flex-start;
      margin-block-start: var(--space-4);
    }
  }
</style>
