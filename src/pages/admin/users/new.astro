---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { hasAdminCapability } from '../../../shared/authorization/admin-workspace.js';
import { administrationDependencies } from '../../../modules/administration/application/dependencies.js';
import { SCOPE_KINDS, scopeRequiresValue } from '../../../shared/authorization/types.js';
import { AppError } from '../../../shared/errors/app-error.js';
import { uxVocabulary } from '../../../shared/copy/ux-vocabulary.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const canCreate = hasAdminCapability(actor, 'createUser');
const canAssignRoles = canCreate && hasAdminCapability(actor, 'assignUserRole');
const canAssignScopes = canCreate && hasAdminCapability(actor, 'assignUserScope');
let roles: Awaited<ReturnType<ReturnType<typeof administrationDependencies>['listRoles']['execute']>> = [];
let optionsError = false;
if (canAssignRoles) {
  try {
    roles = [...(await administrationDependencies().listRoles.execute({ actor }))].filter((role) => role.active);
  } catch (error) {
    optionsError = error instanceof AppError;
  }
}
---

<AppLayout title="Create user · Administration" locale="en" direction="ltr">
  <section class="page-head">
    <div>
      <p class="eyebrow">New member</p>
      <h1>Create user</h1>
      <p class="lede">New members must change their temporary password at first sign-in.</p>
    </div>
    <a href="/admin/users">Back to users</a>
  </section>
  {
    canCreate ? (
      <form class="form" method="post" action="/admin/users/new" data-admin-create-user>
        <label for="loginIdentity">
          Login identity<span aria-hidden="true"> *</span>
          <input id="loginIdentity" name="loginIdentity" required maxlength="200" autocomplete="username" />
        </label>
        <label for="displayName">
          Display name<span aria-hidden="true"> *</span>
          <input id="displayName" name="displayName" required maxlength="200" autocomplete="off" />
        </label>
        <label for="email">
          Email (optional)
          <input id="email" name="email" type="email" maxlength="320" autocomplete="email" />
        </label>
        <label for="temporaryPassword">
          Temporary password<span aria-hidden="true"> *</span>
          <input id="temporaryPassword" name="temporaryPassword" type="password" required autocomplete="new-password" />
        </label>
        {canAssignRoles ? (
          <fieldset>
            <legend>Initial roles (optional)</legend>
            {roles.map((role) => (
              <label class="check"><input type="checkbox" name="roleCode" value={role.code} /> {role.name} ({role.code})</label>
            ))}
            {optionsError ? (
              <p class="note" role="alert">Role options are unavailable. You can create this member without roles, or reload later and ask an authorized administrator to check role availability.</p>
            ) : roles.length === 0 ? (
              <p class="note">No active roles are available. You can create this member without roles, or ask an authorized administrator to make a role available.</p>
            ) : null}
          </fieldset>
        ) : (
          <p class="note">You can create the member without roles. Initial role assignment requires a separate role-assignment permission; an authorized administrator can add roles later.</p>
        )}
        {canAssignScopes ? (
          <fieldset>
            <legend>Initial scopes (optional)</legend>
            <p class="note" id="scope-instructions">
              Kinds that name a collection require a value; GLOBAL is a whole-system grant and takes none.
            </p>
            {SCOPE_KINDS.map((kind) => (
              <div class="scope-row">
                <label class="check">
                  <input type="checkbox" name="scopeKind" value={kind} aria-describedby="scope-instructions" />
                  {uxVocabulary.scopeKindLabels[kind] ?? kind}
                </label>
                {scopeRequiresValue(kind) ? (
                  <label class="scope-value">
                    <span>{uxVocabulary.scopeKindLabels[kind] ?? kind} value</span>
                    <input
                      name={`scopeValue-${kind}`}
                      maxlength="200"
                      placeholder="Enter a value"
                      aria-describedby="scope-instructions"
                    />
                  </label>
                ) : (
                  <span class="note">No value</span>
                )}
              </div>
            ))}
          </fieldset>
        ) : (
          <p class="note">You can create the member without scopes. Initial scope assignment requires a separate scope-assignment permission; an authorized administrator can add scopes later.</p>
        )}
        <div class="actions">
          <button type="submit" data-submit>Create user</button>
          <a href="/admin/users">Cancel</a>
        </div>
        <p role="status" data-result tabindex="-1" />
      </form>
    ) : (
      <section class="denied" role="alert">
        <h2>User creation is not available</h2>
        <p>
          Creating members requires the explicit user-management permission. Role membership
          alone does not authorize this action. Ask an administrator to review your user-management access.
        </p>
      </section>
    )
  }
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  import { enhanceMutationForm } from '../../../ui/forms/mutation-interaction.js';
  const form = document.querySelector<HTMLFormElement>('[data-admin-create-user]');
  if (form) {
    // A scope kind that names a collection needs its value before submit; the
    // valueless kinds never ask for one. The server re-validates either way.
    for (const checkbox of form.querySelectorAll<HTMLInputElement>('input[name="scopeKind"]')) {
      const valueInput = form.querySelector<HTMLInputElement>(
        `input[name="scopeValue-${checkbox.value}"]`,
      );
      const sync = () => {
        if (valueInput) valueInput.required = checkbox.checked;
      };
      checkbox.addEventListener('change', sync);
      sync();
    }
    enhanceMutationForm({
      form,
      progressText: 'Creating user…',
      copy: {
        VALIDATION_ERROR: 'The user was not created. Review required fields; every selected scope needs a value. Your entries are preserved.',
        CONFLICT_STALE: 'A member with the same login identity may already exist. Change the identity or check the list before trying again. Your other entries are preserved.',
        AUTHORIZATION_CHANGED: 'Your current permissions do not allow all requested account and initial-grant changes. Nothing was saved. Check the requested roles and scopes, or ask an administrator to confirm the needed permissions. Your entries are preserved.',
        DEPENDENCY_UNAVAILABLE: 'A referenced role or scope could not be found. Confirm the requested entry still exists and is active, then ask an authorized administrator if needed. Your entries are preserved.',
        PROVIDER_UNAVAILABLE: 'The user service is unavailable. The save result may be unconfirmed; check the user register before retrying. Your entries are preserved.',
        UNKNOWN_SAFE_ERROR: 'User creation is unconfirmed. Check the user register before deciding whether to try again. Your entries are preserved.',
      },
      invoke: (data) => {
        const email = String(data.get('email') || '').trim();
        return actions.admin.createUser({
          loginIdentity: String(data.get('loginIdentity')),
          displayName: String(data.get('displayName')),
          ...(email ? { email } : {}),
          temporaryPassword: String(data.get('temporaryPassword')),
          roleCodes: data.getAll('roleCode').map(String),
          scopes: data.getAll('scopeKind').map((kind) => {
            const scopeKind = String(kind) as 'OWN' | 'ASSIGNED' | 'TEAM' | 'DEPARTMENT' | 'SITE' | 'DOMAIN' | 'GLOBAL';
            const value = String(data.get(`scopeValue-${String(kind)}`) || '').trim();
            return value ? { kind: scopeKind, value } : { kind: scopeKind };
          }),
        }) as unknown as Promise<{ data?: { id?: string }; error?: unknown }>;
      },
      onSuccess: (outcome) => {
        if (outcome.recordId) window.location.href = `/admin/users/${outcome.recordId}`;
        else window.location.reload();
      },
    });
  }
</script>
<style>
  .page-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: start;
    margin-bottom: var(--space-6);
  }
  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    font-weight: 700;
  }
  h1 {
    margin: 0.25rem 0;
  }
  .lede {
    color: var(--text-muted);
    font-size: 0.86rem;
  }
  .form {
    display: grid;
    gap: var(--space-4);
    max-width: 720px;
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }
  .denied {
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--color-border-subtle);
    border-inline-start: 3px solid var(--status-warning);
    border-radius: var(--radius-lg);
    max-width: 720px;
  }
  .denied p {
    color: var(--text-muted);
    font-size: 0.84rem;
  }
  label {
    display: grid;
    gap: 0.4rem;
    font-size: 0.85rem;
  }
  input {
    min-height: 44px;
    padding: 0.7rem;
    background: var(--surface-page);
    color: inherit;
    font: inherit;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
  }
  .note {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  fieldset {
    display: grid;
    gap: var(--space-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    margin: 0;
  }
  legend {
    padding: 0 0.4rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .scope-row {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) 1fr;
    gap: var(--space-3);
    align-items: center;
  }
  .scope-value {
    display: grid;
    gap: 0.4rem;
  }
  .check {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-direction: row;
  }
  .check input {
    min-height: 0;
    width: 1.1rem;
    height: 1.1rem;
  }
  .actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  button {
    border: 0;
    padding: 0.7rem 1rem;
    background: var(--color-accent-primary);
    color: #fff;
    border-radius: var(--radius-md);
    font-weight: 700;
  }
  a {
    color: var(--color-accent-primary-hover);
  }
  @media (max-width: 600px) {
    .page-head {
      display: grid;
    }
    .scope-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
