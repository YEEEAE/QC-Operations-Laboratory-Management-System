---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import { identityAdminReadDependencies } from '../../../modules/identity/application/admin-dependencies.js';
import { canAccessAdminRoute } from '../../../shared/authorization/admin-workspace.js';
import { AppError } from '../../../shared/errors/app-error.js';
import { classifyReadFailure } from '../../../shared/errors/read-failure.js';
import { administrationDependencies } from '../../../modules/administration/application/dependencies.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const canCreate = canAccessAdminRoute(actor, 'usersNew');
const params = Astro.url.searchParams;
const requestedPage = Number(params.get('page') ?? '1');
let page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const query = (params.get('q') ?? '').trim().slice(0, 120);
const stateParam = params.get('state');
const accountState = stateParam === 'ACTIVE' || stateParam === 'INACTIVE' || stateParam === 'DISABLED' ? stateParam : undefined;
const pageSize = 25;

type UserList = Awaited<ReturnType<ReturnType<typeof identityAdminReadDependencies>['listUsers']['execute']>>;
let users: UserList | undefined;
let roleSummary = new Map<string, string>();
let scopeSummary = new Map<string, string>();
let total = 0;
let pages = 1;
let denied = false;
let providerUnavailable = false;
let relationshipUnavailable = false;
try {
  const result = await identityAdminReadDependencies().listUsers.executePage({
    actor,
    filter: { query, accountState, page, pageSize },
  });
  users = result.items;
  total = result.total;
  page = result.page;
  pages = Math.max(1, Math.ceil(total / pageSize));
  try {
    const auth = administrationDependencies();
    const userIds = users.map((user) => user.id);
    const [roles, scopes] = await Promise.all([
      auth.listUserRoles.executeForUsers({ actor, userIds }),
      auth.listUserScopes.executeForUsers({ actor, userIds }),
    ]);
    for (const row of roles) roleSummary.set(row.userId, row.codes.join(', ') || '—');
    for (const row of scopes)
      scopeSummary.set(
        row.userId,
        row.scopes
          .map((scope) => (scope.value ? `${scope.kind}:${scope.value}` : scope.kind))
          .join(', ') || '—',
      );
    for (const user of users) {
      roleSummary.set(user.id, roleSummary.get(user.id) ?? '—');
      scopeSummary.set(user.id, scopeSummary.get(user.id) ?? '—');
    }
  } catch {
    relationshipUnavailable = true;
  }
} catch (error) {
  const failure = classifyReadFailure(error);
  denied = failure === 'DENIED' || (error instanceof AppError && error.category === 'AUTHORIZATION');
  providerUnavailable = !denied;
}
---

<AppLayout title="Users · Administration" locale="en" direction="ltr">
  <section class="page-head">
    <div>
      <p class="eyebrow">Members</p>
      <h1>Users</h1>
      <p class="lede">Member accounts under your explicit administration authority.</p>
    </div>
    <div class="head-links">
      {canCreate && (
        <a class="button" href="/admin/users/new">
          Create user
        </a>
      )}
      <a href="/admin">Back to administration</a>
    </div>
  </section>
  {providerUnavailable && <ProviderUnavailableState title="User register is temporarily unavailable" description="The user source did not confirm a complete page. Retry after the source is available." retryHref={Astro.url.pathname + Astro.url.search} />}
  {Boolean(stateParam && !accountState) && <p class="rejected" role="status">The account-state filter was not applied because its value is unsupported.</p>}
  {
    denied ? (
      <section class="denied" role="alert">
        <h2>User administration is not available</h2>
        <p>
          Listing members requires an explicit user-administration permission grant. Role
          membership alone does not authorize this view.
        </p>
      </section>
    ) : providerUnavailable || !users ? null : (
      <form class="filters" method="get" aria-label="Filter user accounts">
        <label for="q">Search accounts<input id="q" name="q" type="search" maxlength="120" value={query} placeholder="Login, name, or email" /></label>
        <label for="state">Account state<select id="state" name="state">
          <option value="">All states</option><option value="ACTIVE" selected={accountState === 'ACTIVE'}>Active</option><option value="INACTIVE" selected={accountState === 'INACTIVE'}>Inactive</option><option value="DISABLED" selected={accountState === 'DISABLED'}>Disabled</option>
        </select></label>
        <button type="submit">Apply filters</button>
        {(query || accountState) && <a href="/admin/users">Clear filters</a>}
      </form>
    )}
  {
    denied || !users ? null : users.length ? (
      <div class="table-wrap">
        <table>
          <caption>{total} authorized member account{total === 1 ? '' : 's'}{query || accountState ? ' matching these filters' : ''}; page {page} of {pages}</caption>
          <thead>
            <tr>
              <th scope="col">Login identity</th>
              <th scope="col">Display name</th>
              <th scope="col">State</th>
              <th scope="col">Roles</th>
              <th scope="col">Scopes</th>
            </tr>
          </thead>
          <tbody>
            {users.map((user) => (
              <tr>
                <th scope="row">
                  <a href={`/admin/users/${user.id}`}>{user.loginIdentity}</a>
                </th>
                <td>{user.displayName}</td>
                <td>{user.accountState}</td>
                <td>{relationshipUnavailable ? 'Not confirmed' : roleSummary.get(user.id) ?? '—'}</td>
                <td>{relationshipUnavailable ? 'Not confirmed' : scopeSummary.get(user.id) ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="empty">{query || accountState ? 'No member accounts match these filters.' : 'No member accounts are visible under your authorized scope.'}</p>
    )
  }
  {relationshipUnavailable && <p class="rejected" role="status">Role and scope details could not be confirmed. The user records remain available; retry this page to check these relationships again.</p>}
  {!denied && !providerUnavailable && users && pages > 1 && <nav class="pagination" aria-label="User account pages">
    {page > 1 ? <a href={`/admin/users?${new URLSearchParams({ ...(query ? { q: query } : {}), ...(accountState ? { state: accountState } : {}), page: String(page - 1) })}`} rel="prev">Previous page</a> : <span>Previous page</span>}
    <span aria-current="page">Page {page} of {pages}</span>
    {page < pages ? <a href={`/admin/users?${new URLSearchParams({ ...(query ? { q: query } : {}), ...(accountState ? { state: accountState } : {}), page: String(page + 1) })}`} rel="next">Next page</a> : <span>Next page</span>}
  </nav>}
</AppLayout>
<style>
  .page-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: start;
    margin-bottom: var(--space-6);
  }
  h1 {
    margin: 0.25rem 0;
  }
  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    font-weight: 700;
  }
  .lede,
  .empty {
    color: var(--text-muted);
    font-size: 0.86rem;
  }
  .head-links {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .button {
    border: 1px solid var(--color-accent-primary);
    background: var(--color-accent-primary);
    color: #fff;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }
  .denied {
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--color-border-subtle);
    border-inline-start: 3px solid var(--status-warning);
    border-radius: var(--radius-lg);
  }
  .denied p {
    color: var(--text-muted);
    font-size: 0.84rem;
  }
  .table-wrap {
    overflow-x: auto;
  }
  .filters{display:flex;flex-wrap:wrap;align-items:end;gap:var(--space-4);margin-bottom:var(--space-4)}
  .rejected{padding:var(--space-3);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}
  .filters label{display:grid;gap:.35rem;color:var(--text-secondary);font-size:.8rem}
  .filters input,.filters select,.filters button{min-height:var(--control-height);padding:.45rem .7rem}
  .pagination{display:flex;align-items:center;justify-content:center;gap:var(--space-5);padding:var(--space-5)}
  .pagination span{color:var(--text-muted)}
  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface-panel);
  }
  caption {
    text-align: start;
    padding: var(--space-4);
    color: var(--text-muted);
  }
  th,
  td {
    padding: 0.75rem;
    text-align: start;
    border-top: 1px solid var(--color-border-subtle);
  }
  th {
    font-weight: 700;
  }
  a {
    color: var(--color-accent-primary-hover);
  }
  @media (max-width: 600px) {
    .page-head {
      display: grid;
    }
  }
</style>
