---
import PageHeader from "../../../ui/components/PageHeader.astro";
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { uxVocabulary } from '../../../shared/copy/ux-vocabulary.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
---

<AppLayout title="Scopes · Administration" locale="en" direction="ltr">
  <PageHeader>
    <Fragment slot="heading"><h1>Scopes</h1></Fragment>
    <p class="lede">Manage access scopes. Self-grants are blocked.</p>
    <Fragment slot="actions"><a href="/admin">Back to administration</a></Fragment>
  </PageHeader>

  <div class="page-content">
    <section class="panel next-step" aria-labelledby="next-step-heading">
      <div class="next-step-copy">
        <p class="eyebrow">Next step</p>
        <h2 id="next-step-heading">Review a member’s current scopes</h2>
        <p class="note">
          Choose a member to review their account state and current scopes before assigning or removing a scope.
        </p>
      </div>
      <div class="actions">
        <a class="button" href="/admin/users">Browse members</a>
      </div>
    </section>

    <section class="panel vocabulary" aria-labelledby="vocabulary-heading">
      <p class="eyebrow">Scope kinds</p>
      <h2 id="vocabulary-heading">Canonical vocabulary</h2>
      <ul class="kinds">
        <li>
          <strong>{uxVocabulary.scopeKindLabels.OWN} <small>OWN</small></strong>
          <span>Records owned by the member</span>
        </li>
        <li>
          <strong>{uxVocabulary.scopeKindLabels.ASSIGNED} <small>ASSIGNED</small></strong>
          <span>Records formally assigned to the member</span>
        </li>
        <li>
          <strong>{uxVocabulary.scopeKindLabels.TEAM} <small>TEAM</small></strong>
          <span>Records of the member's team</span>
        </li>
        <li>
          <strong>{uxVocabulary.scopeKindLabels.DEPARTMENT} <small>DEPARTMENT</small></strong>
          <span>Records of the member's department</span>
        </li>
        <li>
          <strong>{uxVocabulary.scopeKindLabels.SITE} <small>SITE</small></strong>
          <span>Records of an operational site</span>
        </li>
        <li>
          <strong>{uxVocabulary.scopeKindLabels.DOMAIN} <small>DOMAIN</small></strong>
          <span>Wide visibility inside one domain only</span>
        </li>
        <li>
          <strong>{uxVocabulary.scopeKindLabels.GLOBAL} <small>GLOBAL</small></strong>
          <span>System-wide visibility for this grant</span>
        </li>
      </ul>
      <p class="note safety-note">
        Scope alone never authorizes an action. Every mutation still requires the matching
        explicit permission plus entity, state, SoD, version, and business rule.
      </p>
    </section>
  </div>
</AppLayout>
<style>
  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    font-weight: 700;
  }
  .lede {
    color: var(--text-muted);
    font-size: 0.86rem;
  }
  .page-content {
    display: grid;
    gap: var(--space-5);
    min-inline-size: 0;
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: max(var(--control-height), 44px);
    padding: 0 var(--space-4);
    border: 1px solid var(--color-accent-primary);
    border-radius: var(--radius-sm);
    background: var(--color-accent-primary);
    color: var(--color-text-inverse);
    font-weight: 700;
    text-decoration: none;
  }
  .button:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }
  .panel {
    min-inline-size: 0;
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }
  .next-step {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);
    border-inline-start: 3px solid var(--color-accent-primary);
  }
  h2 {
    margin: var(--space-1) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-tight);
    overflow-wrap: anywhere;
  }
  .kinds {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-3);
  }
  .kinds li {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-inline-size: 0;
    padding: var(--space-3);
    background: var(--surface-inset);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    overflow-wrap: anywhere;
  }
  .kinds span {
    color: var(--text-muted);
    line-height: var(--line-height-normal);
  }
  .kinds small {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 400;
  }
  .note {
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .safety-note {
    margin: var(--space-4) 0 0;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-inset);
    border-inline-start: 2px solid var(--color-accent-primary);
    border-radius: var(--radius-sm);
    overflow-wrap: anywhere;
  }
  .actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
  }
  @media (max-width: 600px) {
    .next-step {
      display: grid;
      justify-items: start;
      gap: var(--space-4);
    }
  }
</style>
