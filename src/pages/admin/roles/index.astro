---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { administrationDependencies } from '../../../modules/administration/application/dependencies.js';
import { AppError } from '../../../shared/errors/app-error.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);

type RoleList = Awaited<ReturnType<ReturnType<typeof administrationDependencies>['listRoles']['execute']>>;
let roles: RoleList | undefined;
let denied = false;
try {
  roles = await administrationDependencies().listRoles.execute({ actor });
} catch (error) {
  denied = error instanceof AppError && error.category === 'AUTHORIZATION';
  if (!denied) throw error;
}
---

<AppLayout title="Roles · Administration" locale="en" direction="ltr">
  <section class="page-head">
    <div>
      <p class="eyebrow">Roles</p>
      <h1>Roles</h1>
      <p class="lede">Read-only role catalog.</p>
    </div>
    <a href="/admin">Back to administration</a>
  </section>
  {
    denied || !roles ? (
      <section class="denied" role="alert">
        <h2>Role administration is not available</h2>
        <p>
          Role information is temporarily unavailable. Retry this page to read the current records.
        </p>
      </section>
    ) : roles.length ? (
      <div class="table-wrap">
        <table>
          <caption>Configured roles</caption>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Role type</th>
              <th scope="col">Status</th>
              <th scope="col">Version</th>
            </tr>
          </thead>
          <tbody>
            {roles.map((role) => (
              <tr>
                <th scope="row">
                  <a href={`/admin/roles/${role.id}`}>{role.name}</a>
                  <small class="code">{role.code}</small>
                </th>
                <td>{role.isSystemRole ? 'System role' : 'Custom role'}</td>
                <td>{stateLabel(role.active ? 'ACTIVE' : 'INACTIVE')}</td>
                <td>{role.version.toString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="empty">No roles are configured.</p>
    )
  }
</AppLayout>
<style>
  .page-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: start;
    margin-bottom: var(--space-6);
  }
  h1 {
    margin: 0.25rem 0;
  }
  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    font-weight: 700;
  }
  .lede,
  .empty {
    color: var(--text-muted);
    font-size: 0.86rem;
  }
  .denied {
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--color-border-subtle);
    border-inline-start: 3px solid var(--status-warning);
    border-radius: var(--radius-lg);
  }
  .denied p {
    color: var(--text-muted);
    font-size: 0.84rem;
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface-panel);
  }
  caption {
    text-align: start;
    padding: var(--space-4);
    color: var(--text-muted);
  }
  th,
  td {
    padding: 0.75rem;
    text-align: start;
    border-top: 1px solid var(--color-border-subtle);
  }
  th {
    font-weight: 700;
  }
  .code {
    display: block;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 400;
  }
  a {
    color: var(--color-accent-primary-hover);
  }
  @media (max-width: 600px) {
    .page-head {
      display: grid;
    }
  }
</style>
