---
import PageHeader from "../../../ui/components/PageHeader.astro";
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { administrationDependencies } from '../../../modules/administration/application/dependencies.js';
import { hasAdminCapability } from '../../../shared/authorization/admin-workspace.js';
import { AppError } from '../../../shared/errors/app-error.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const roleId = Astro.params.roleId ?? '';

type RoleView = Awaited<ReturnType<ReturnType<typeof administrationDependencies>['getRole']['execute']>>;
type GrantList = Awaited<ReturnType<ReturnType<typeof administrationDependencies>['listRolePermissions']['execute']>>;
type PermissionList = Awaited<ReturnType<ReturnType<typeof administrationDependencies>['listPermissions']['execute']>>;

let role: RoleView | undefined;
let grants: GrantList | undefined;
let catalog: PermissionList | undefined;
let catalogRestricted = false;
let denied = false;
try {
  role = await administrationDependencies().getRole.execute({ actor, roleId });
} catch (error) {
  if (error instanceof AppError && error.code === 'RESOURCE_NOT_FOUND') {
    return Astro.redirect('/404');
  }
  denied = error instanceof AppError && error.category === 'AUTHORIZATION';
  if (!denied) throw error;
}
if (role) {
  try {
    grants = await administrationDependencies().listRolePermissions.execute({ actor, roleId });
  } catch (error) {
    catalogRestricted = error instanceof AppError && error.category === 'AUTHORIZATION';
    if (!catalogRestricted) throw error;
  }
  try {
    catalog = await administrationDependencies().listPermissions.execute({ actor });
  } catch (error) {
    catalogRestricted = catalogRestricted || (error instanceof AppError && error.category === 'AUTHORIZATION');
    if (!(error instanceof AppError && error.category === 'AUTHORIZATION')) throw error;
  }
}

const granted = new Set((grants ?? []).map(String));
const canAssign = hasAdminCapability(actor, 'assignRolePermissions') && (role?.active ?? false);
const version = role?.version.toString() ?? '0';
---

<AppLayout title="Role detail · Administration" locale="en" direction="ltr">
  <PageHeader><Fragment slot="heading"><h1>{role?.name ?? 'Role detail'}</h1></Fragment>
      
      
      <p class="lede">
        {role ? `${role.name} · ${role.code} · ${stateLabel(role.active ? 'ACTIVE' : 'INACTIVE')} · Version ${version}` : ''}
      </p>
    <Fragment slot="actions"><a href="/admin/roles">Back to roles</a></Fragment></PageHeader>
  {
    denied || !role ? (
      <section class="denied" role="alert">
        <h2>Role detail is not available</h2>
        <p>
          Role information is temporarily unavailable. Retry this page to read the current record.
        </p>
      </section>
    ) : (
      <div class="grid">
        <section class="panel">
          <p class="eyebrow">ROLE</p>
          <h2>Configuration</h2>
          <dl>
            <div>
              <dt>Code</dt>
              <dd>{role.code}</dd>
            </div>
            <div>
              <dt>System role</dt>
              <dd>{role.isSystemRole ? 'System role' : 'Custom role'}</dd>
            </div>
            <div>
              <dt>Description</dt>
              <dd>{role.description ?? '—'}</dd>
            </div>
          </dl>
          {!role.active && (
            <p class="note">
              This role is inactive. Permission grants cannot change until it is reactivated
              through the approved workflow.
            </p>
          )}
        </section>
        <section class="panel">
          <p class="eyebrow">PERMISSION GRANTS</p>
          <h2>Canonical grants</h2>
          {catalogRestricted || !catalog ? (
            <p class="note">
              Role grant details are temporarily unavailable. Retry this page to read the current grants.
            </p>
          ) : canAssign ? (
            <form method="post" class="form" data-role-grants data-role={role.id} data-version={version}>
              <p class="note">
                Replacing grants is a high-risk, audited mutation. The current version is
                required; stale versions are rejected without overwriting.
              </p>
              <div class="grants">
                {catalog.map((permission) => (
                  <label class="check">
                    <input
                      type="checkbox"
                      name="permission"
                      value={permission.code}
                      checked={granted.has(permission.code)}
                    />
                    <span>
                      <strong>{permission.description || `${permission.domain} ${permission.action}`}</strong>
                      <code class="code-secondary">{permission.code}</code>
                      <small>
                        {stateLabel(permission.domain)} · {stateLabel(permission.action)} · {stateLabel(permission.riskLevel)}
                      </small>
                    </span>
                  </label>
                ))}
              </div>
              <div class="actions">
              <button type="submit" data-submit>Replace grants</button>
              </div>
              <p role="status" data-result tabindex="-1" />
            </form>
          ) : (
            <div>
              {grants?.length ? (
                <ul class="grants-read">
                  {grants.map((code) => (
                    <li>
                      {catalog?.find((permission) => permission.code === code)?.description ?? code}
                      <code class="code-secondary">{code}</code>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="note">No active grants on this role.</p>
              )}
              <p class="note">
                Changing grants requires the explicit permission-assignment grant on an active
                role.
              </p>
            </div>
          )}
        </section>
      </div>
    )
  }
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  import { classifyActionResult } from '../../../ui/forms/mutation-interaction.js';
  const form = document.querySelector<HTMLFormElement>('[data-role-grants]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || form.getAttribute('aria-busy') === 'true') return;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    let output = form.querySelector<HTMLElement>('[data-result]');
    if (!output) { output = document.createElement('p'); output.setAttribute('data-result',''); output.setAttribute('role','status'); output.setAttribute('tabindex','-1'); form.appendChild(output); }
    form.setAttribute('aria-busy', 'true');
    if (submit) submit.disabled = true;
    output.textContent = 'Replacing grants…';
    try {
      const permissionCodes = [...form.querySelectorAll<HTMLInputElement>('input[name="permission"]')].filter((input) => input.checked).map((input) => String(input.value));
      const result = await actions.admin.updateRolePermissions({ roleId: form.dataset.role ?? '', permissionCodes, expectedVersion: BigInt(form.dataset.version ?? '0') });
      const outcome = classifyActionResult(result as unknown as { data?: { id?: string }; error?: unknown });
      // updateRolePermissions returns grants (no id): SUCCESS means reload.
      if (!result.error) { location.reload(); return; }
      const copy: Record<string,string> = {
        VALIDATION_ERROR: 'Grants were not replaced. Review the selected permissions and try again.',
        CONFLICT_STALE: 'The role changed while you were editing it. Refresh the role detail and try again if still permitted.',
        AUTHORIZATION_CHANGED: 'Your authorization changed. Replacing grants needs the explicit role-administration permission.',
        DEPENDENCY_UNAVAILABLE: 'The role or permission catalog is no longer available. Refresh before trying again.',
        UNKNOWN_SAFE_ERROR: 'Grant replacement is unconfirmed. Review the role and its history before deciding whether to try again.',
      };
      output.textContent = copy[outcome.state] ?? copy.UNKNOWN_SAFE_ERROR;
      output.focus?.();
    } catch {
      output.textContent = 'The service did not confirm the result. Refresh the role and its history before deciding whether to try again.';
      output.focus?.();
    } finally { form.removeAttribute('aria-busy'); if (submit) submit.disabled = false; }
  });
</script>
<style>
  .page-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: start;
    margin-bottom: var(--space-6);
  }
  h1 {
    margin: 0.25rem 0;
  }
  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    font-weight: 700;
  }
  .lede {
    color: var(--text-muted);
    font-size: 0.86rem;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-5);
  }
  .panel,
  .denied {
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }
  .denied {
    border-inline-start: 3px solid var(--status-warning);
  }
  .denied p {
    color: var(--text-muted);
    font-size: 0.84rem;
  }
  h2 {
    margin: 0.25rem 0 0;
    font-size: 1rem;
  }
  dl {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 0.55rem;
  }
  dt {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  dd {
    margin: 0;
    text-align: end;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .note {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .form {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .grants {
    display: grid;
    gap: var(--space-2);
    max-height: 480px;
    overflow-y: auto;
  }
  .check {
    display: flex;
    gap: 0.6rem;
    align-items: start;
    font-size: 0.82rem;
    padding: 0.5rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
  }
  .check small {
    display: block;
    color: var(--text-muted);
  }
  .grants-read {
    list-style: none;
    margin: var(--space-4) 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .code-secondary {
    display: block;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 400;
  }
  .grants-read code {
    padding: 0.2rem 0.45rem;
    background: var(--surface-page);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
  }
  .actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  button {
    border: 0;
    padding: 0.65rem 1rem;
    background: var(--color-accent-primary);
    color: #fff;
    border-radius: var(--radius-md);
    font-weight: 700;
  }
  a {
    color: var(--color-accent-primary-hover);
  }
  @media (max-width: 760px) {
    .page-head,
    .grid {
      display: grid;
    }
  }
</style>
