---
import PageHeader from "../../../ui/components/PageHeader.astro";
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { administrationDependencies } from '../../../modules/administration/application/dependencies.js';
import { AppError } from '../../../shared/errors/app-error.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);

type PermissionList = Awaited<ReturnType<ReturnType<typeof administrationDependencies>['listPermissions']['execute']>>;
let permissions: PermissionList | undefined;
let denied = false;
try {
  permissions = await administrationDependencies().listPermissions.execute({ actor });
} catch (error) {
  denied = error instanceof AppError && error.category === 'AUTHORIZATION';
  if (!denied) throw error;
}
---

<AppLayout title="Permissions · Administration" locale="en" direction="ltr">
  <PageHeader><Fragment slot="heading"><h1>Permissions</h1></Fragment>
      
      
      <p class="lede">Read-only catalog. Manage grants through roles.</p>
    <Fragment slot="actions"><a href="/admin">Back to administration</a></Fragment></PageHeader>
  {
    denied || !permissions ? (
      <section class="denied" role="alert">
        <h2>Permission catalog is not available</h2>
        <p>
          The permission catalog is temporarily unavailable. Retry this page to read the current records.
        </p>
      </section>
    ) : permissions.length ? (
      <div class="table-wrap">
        <table>
          <caption>Active permissions</caption>
          <thead>
            <tr>
              <th scope="col">Permission</th>
              <th scope="col">Domain</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          <tbody>
            {permissions.map((permission) => (
              <tr>
                <th scope="row">
                  <strong>{permission.description || `${stateLabel(permission.domain)} ${stateLabel(permission.action)}`}</strong>
                  <code class="code-secondary">{permission.code}</code>
                </th>
                <td>{stateLabel(permission.domain)}</td>
                <td>{stateLabel(permission.action)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="empty">No active permissions are cataloged.</p>
    )
  }
</AppLayout>
<style>
  .page-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: start;
    margin-bottom: var(--space-6);
  }
  h1 {
    margin: 0.25rem 0;
  }
  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    font-weight: 700;
  }
  .lede,
  .empty {
    color: var(--text-muted);
    font-size: 0.86rem;
  }
  .denied {
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--color-border-subtle);
    border-inline-start: 3px solid var(--status-warning);
    border-radius: var(--radius-lg);
  }
  .denied p {
    color: var(--text-muted);
    font-size: 0.84rem;
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface-panel);
  }
  caption {
    text-align: start;
    padding: var(--space-4);
    color: var(--text-muted);
  }
  th,
  td {
    padding: 0.75rem;
    text-align: start;
    border-top: 1px solid var(--color-border-subtle);
  }
  th {
    font-weight: 700;
  }
  code {
    font-size: 0.78rem;
  }
  .code-secondary {
    display: block;
    color: var(--text-muted);
    font-weight: 400;
  }
  a {
    color: var(--color-accent-primary-hover);
  }
  @media (max-width: 600px) {
    .page-head {
      display: grid;
    }
  }
</style>
