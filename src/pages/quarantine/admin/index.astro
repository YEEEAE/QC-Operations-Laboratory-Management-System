---
import PageHeader from "../../../ui/components/PageHeader.astro";
import { inspectionCatalogDependencies } from '../../../modules/quarantine/catalog/application/catalog.js';
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import FormErrorSummary from '../../../ui/components/FormErrorSummary.astro';
import { field, optionalField, toFormFailure, extractDetailId, type FormFailure } from '../../../ui/forms/mutation-post.js';
import { templateActionDependencies, templateReadDependencies } from '../../../modules/quarantine/templates/application/dependencies.js';
import { readOutcome } from '../../../shared/errors/read-outcome.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { isTemplateAuthority } from '../../../modules/quarantine/templates/application/template-authority.js';
import { isNamedSystemOwner } from '../../../shared/authorization/p05-authority.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquarantine%2Fadmin');

const hasTemplatePermission = actor.permissions.some((p) => p.code === 'PERM-ADM-TEMPLATES' && p.active !== false);
const isAuthority = isTemplateAuthority(actor);
const isSystemOwner = isNamedSystemOwner(actor);

const templateResult = await readOutcome(() => templateReadDependencies().list.executePage({ actor, page: { page: Astro.url.searchParams.get('templatePage') ?? 1 } }));
let templates: readonly import('../../../modules/quarantine/templates/domain/template.js').TemplateVersion[] = templateResult.status === 'AVAILABLE' ? templateResult.value.items : [];
const denied = templateResult.status === 'NOT_VISIBLE';
const listUnavailable = templateResult.status === 'UNAVAILABLE';

const search = (Astro.url.searchParams.get('search') ?? '').slice(0,120);
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const catalogResult = !denied ? await readOutcome(() => inspectionCatalogDependencies().catalog.search({ actor, search, page })) : null;
const catalog = catalogResult?.status === 'AVAILABLE' ? catalogResult.value : [];
const mappingRead = hasTemplatePermission ? await readOutcome(() => templateActionDependencies().manageMappings.list({ actor })) : null;
const itemSourceRead = hasTemplatePermission ? await readOutcome(() => templateActionDependencies().manageMappings.listApprovedItemSources({ actor })) : null;
const itemMappings = mappingRead?.status === 'AVAILABLE' ? mappingRead.value : [];
const approvedItemSources = itemSourceRead?.status === 'AVAILABLE' ? itemSourceRead.value : [];
let mappingError = '';
let values = { catalogId: '', description: '', templateCode: '', versionNo: '', name: '' };
let reauthenticationSecret = '';
let failure: FormFailure | null = null;

if (Astro.request.method === 'POST' && hasTemplatePermission) {
  const formData = await Astro.request.formData();
  values = {
    catalogId: field(formData, 'catalogId'),
    description: field(formData, 'description'),
    templateCode: field(formData, 'templateCode'),
    versionNo: field(formData, 'versionNo'),
    name: field(formData, 'name'),
    // Keep credentials out of the retained form state so they can never be
    // echoed into SSR output after a failed request.
  };
  reauthenticationSecret = field(formData, 'reauthenticationSecret');
  try {
    if (formData.get('intent') === 'submit-item-mapping') {
      await templateActionDependencies().manageMappings.submit({
        actor, itemCode: field(formData, 'itemCode'),
        templateVersionId: field(formData, 'templateVersionId'),
        sourceRevisionId: field(formData, 'sourceRevisionId'),
        requestId: Astro.locals.requestContext?.requestId ?? 'unknown',
      });
      return Astro.redirect('/quarantine/admin?mapping-submitted=1', 303);
    }
    if (formData.get('intent') === 'approve-item-mapping') {
      const expectedVersion = BigInt(field(formData, 'expectedVersion'));
      await templateActionDependencies().manageMappings.approve({
        actor, mappingId: field(formData, 'mappingId'), expectedVersion,
        reason: field(formData, 'reason'),
        requestId: Astro.locals.requestContext?.requestId ?? 'unknown',
      });
      return Astro.redirect('/quarantine/admin?mapping-approved=1', 303);
    }
    if (formData.get('intent') === 'reject-item-mapping') {
      const expectedVersion = BigInt(field(formData, 'expectedVersion'));
      await templateActionDependencies().manageMappings.reject({
        actor, mappingId: field(formData, 'mappingId'), expectedVersion,
        reason: field(formData, 'reason'),
        requestId: Astro.locals.requestContext?.requestId ?? 'unknown',
      });
      return Astro.redirect('/quarantine/admin?mapping-rejected=1', 303);
    }
    if(formData.get('intent')==='import-sources') {
      await inspectionCatalogDependencies().importSources.execute({actor,requestId:Astro.locals.requestContext?.requestId ?? 'unknown'});
      return Astro.redirect('/quarantine/admin',303);
    }
    if (formData.get('intent') === 'create-authored') {
      // In-system authoring: identity + first DRAFT now, design next. No
      // document number is generated — none is defined by an approved rule.
      const authored = await templateActionDependencies().createAuthored.execute({
        actor,
        templateCode: values.templateCode,
        versionNo: values.versionNo,
        name: values.name,
        ...(values.description ? { description: values.description } : {}),
        requestId: Astro.locals.requestContext?.requestId ?? `admin-authored-${Date.now()}`,
      });
      const authoredId = extractDetailId(authored);
      if (authoredId) return Astro.redirect(`/quarantine/admin/${authoredId}`, 303);
    }
    const created = await templateActionDependencies().create.execute({
      actor,
      catalogId: values.catalogId,
      ...(values.description ? { description: values.description } : {}),
      ...(reauthenticationSecret ? { reauthenticationSecret } : {}),
      requestId: Astro.locals.requestContext?.requestId ?? `admin-create-${Date.now()}`,
    });
    const id = extractDetailId(created);
    if (id) return Astro.redirect(`/quarantine/admin/${id}`, 303);
    templates = (await templateReadDependencies().list.executePage({ actor, page: { page: Astro.url.searchParams.get('templatePage') ?? 1 } })).items;
    values = { catalogId: '', description: '', templateCode: '', versionNo: '', name: '' };
    reauthenticationSecret = '';
  } catch (error) {
    if (['submit-item-mapping', 'approve-item-mapping', 'reject-item-mapping'].includes(String(formData.get('intent') ?? ''))) {
      mappingError = 'The mapping could not be saved or approved. Verify the approved item source, pinned template revision, current mapping state and owner authority.';
    } else failure = toFormFailure(error, {
      entity: 'Template',
      requiredFields: [
        { name: 'catalogId', label: 'Inspection Report' },
      ],
      values,
      listHref: '/quarantine/admin',
      listLabel: 'template administration',
    });
  }
  reauthenticationSecret = '';
}
const mappingSuccess = Astro.url.searchParams.has('mapping-submitted')
  ? 'Mapping submitted for named System Owner approval; it cannot resolve inspections while pending.'
  : Astro.url.searchParams.has('mapping-approved')
    ? 'Mapping approved and pinned to the reviewed item source and exact template version.'
    : Astro.url.searchParams.has('mapping-rejected') ? 'Mapping rejected. The submission remains in history and cannot resolve inspections.' : '';

type FieldName = keyof typeof values | 'reauthenticationSecret';
function describedBy(name: FieldName): string | undefined {
  const parts: string[] = [];
  if (failure?.fieldErrors[name]) parts.push(`${name}-error`);
  if (name === 'catalogId') parts.push('catalogId-help');
  return parts.length ? parts.join(' ') : undefined;
}
function invalid(name: FieldName): 'true' | undefined {
  return failure?.fieldErrors[name] ? 'true' : undefined;
}

function disabledReason(state: string, action: 'REVIEW' | 'APPROVE' | 'STOP' | 'VOID' | 'SUPERSEDE' | 'REVISE'): string | null {
  if (!hasTemplatePermission) return 'Missing the explicit template administration permission.';
  if (action !== 'REVISE' && !isAuthority && (action === 'REVIEW' || action === 'APPROVE' || action === 'STOP' || action === 'VOID' || action === 'SUPERSEDE')) {
    return 'Employee accounts cannot review, approve, stop, void, or supersede (P-06).';
  }
  switch (action) {
    case 'REVIEW': return state === 'DRAFT' ? null : `Review is available only from DRAFT (current: ${state}).`;
    case 'APPROVE': return state === 'DRAFT' || state === 'UNDER_REVIEW' ? null : `Approval is available only from DRAFT or UNDER_REVIEW (current: ${state}).`;
    case 'STOP': return state === 'APPROVED' ? null : `Stop is available only from APPROVED (current: ${state}).`;
    case 'VOID': return ['DRAFT', 'UNDER_REVIEW', 'APPROVED', 'STOPPED'].includes(state) ? null : `VOID is unavailable while this template is ${stateLabel(state)}. Its history is preserved.`;
    case 'SUPERSEDE': return state === 'APPROVED' || state === 'STOPPED' ? null : `Supersede is available only from APPROVED or STOPPED (current: ${state}).`;
    case 'REVISE': return state === 'APPROVED' || state === 'STOPPED' ? null : `New revisions start from APPROVED or STOPPED (current: ${state}). Approved content is never edited in place.`;
  }
}
---
<AppLayout title="Quarantine Administration · QC Operations" locale="en" direction="ltr">
  <!-- CA-P-QUARANTINE-ADMIN: READ follows templateResult/catalogResult;
       FILTER is the existing GET search on the catalogue only.
       EXPORT: N/A — no export action or route is wired on this surface.
       Inspection Result / Release System State: N/A — these rows are template
       versions, not inspections or receiving records. No approval here releases
       material or lifts HOLD. Snapshot, notes and equipment on related records
       remain on their existing detail routes.
       Literal visual-reference matching is unconfirmed; local tokens are used.
       Prior functional debt, outside this presentation scope: native authored
       creation can fall through to catalogue creation if no ID is extracted;
       POST failure field mapping is catalogue-oriented for all intents. -->
  <div class="admin-register">
  <PageHeader><Fragment slot="heading"><h1>Quarantine administration</h1></Fragment>
      
      
      <p class="lede">Manage inspection templates. Approved content requires a new revision to change.</p>
    <Fragment slot="actions"><a href="/quarantine">Back to Quarantine</a></Fragment></PageHeader>

  {denied ? (
    <section class="denied" role="alert">
      <h2>Administration is not available</h2>
      <p>This area requires the explicit Quarantine administration permission. Admin role alone is not business authority.</p>
    </section>
  ) : (
    <>
    <section class="panel" aria-labelledby="item-mapping-title">
      <h2 id="item-mapping-title">Item Code to inspection template mapping</h2>
      <p class="note">Authorized QC users submit mappings against an owner-approved item source and one exact approved template version. A named System Owner approves; pending or legacy mappings cannot select an inspection template. Approval records the item source revision and becomes effective on the approval date.</p>
      {mappingSuccess && <p class="success" role="status">{mappingSuccess}</p>}
      {mappingError && <p class="field-error" role="alert">{mappingError}</p>}
      {!hasTemplatePermission ? <p role="alert">Mapping administration requires the explicit Quarantine template permission.</p> : <>
        {mappingRead?.status !== 'AVAILABLE' && <p role="alert">Mapping history: NOT AVAILABLE FOR VERIFICATION.</p>}
        {itemSourceRead?.status !== 'AVAILABLE' && <p role="alert">Approved item-source revisions: NOT AVAILABLE FOR VERIFICATION.</p>}
        <form method="post" class="mapping-form">
          <input type="hidden" name="intent" value="submit-item-mapping" />
          <label for="mappingItemCode">Item Code</label><input id="mappingItemCode" name="itemCode" maxlength="200" required />
          <label for="mappingSourceRevision">Owner-approved item source revision</label>
          <select id="mappingSourceRevision" name="sourceRevisionId" required>
            <option value="">Select a source revision</option>
            {approvedItemSources.map((source) => <option value={source.id}>{source.source_reference} · effective {source.effective_revision} · SHA-256 {source.content_sha256}</option>)}
          </select>
          <label for="mappingTemplateVersion">Exact approved inspection template version</label>
          <select id="mappingTemplateVersion" name="templateVersionId" required>
            <option value="">Select an approved version</option>
            {templates.filter((template) => template.state === 'APPROVED').map((template) => <option value={template.id}>{template.templateCode} · revision {template.versionNo} · {template.id}</option>)}
          </select>
          <p class="hint">Missing approved source or exact template evidence? NOT AVAILABLE FOR VERIFICATION. The mapping will not be created.</p>
          <button type="submit" disabled={!approvedItemSources.length || !templates.some((template) => template.state === 'APPROVED')}>Submit for owner approval</button>
        </form>
        {mappingRead?.status === 'AVAILABLE' && (itemMappings.length ? <div class="table-wrap" role="region" aria-label="Item mapping revisions" tabindex="0"><table>
          <caption>Mapping submissions, exact source and template revisions, and approval history</caption>
          <thead><tr><th scope="col">Item Code</th><th scope="col">Template version</th><th scope="col">Item source</th><th scope="col">Mapping state</th><th scope="col">Decision</th></tr></thead>
          <tbody>{itemMappings.map((mapping) => <tr>
            <th scope="row">{mapping.item_code}</th>
            <td>{mapping.template_version_id ?? 'NOT AVAILABLE FOR VERIFICATION'}</td>
            <td>{mapping.source_reference ?? 'NOT AVAILABLE FOR VERIFICATION'}{mapping.effective_revision ? <span class="cell-detail">Effective revision {mapping.effective_revision}</span> : null}<span class="cell-detail">Source revision {mapping.source_revision_id ?? 'NOT AVAILABLE FOR VERIFICATION'}</span><span class="cell-detail">Source SHA-256 {mapping.source_sha256 ?? 'NOT AVAILABLE FOR VERIFICATION'}</span></td>
            <td>{mapping.state} · {mapping.approval_state}{itemMappings.filter((candidate) => candidate.item_code === mapping.item_code && candidate.approval_state === 'PENDING_SOURCE_APPROVAL').length > 1 ? <span class="cell-detail">Conflict queue: multiple pending revisions for this Item Code</span> : null}</td>
            <td>{mapping.approval_state === 'PENDING_SOURCE_APPROVAL' && isSystemOwner ? <div class="mapping-decisions">
              <form method="post" class="approve-mapping">
                <input type="hidden" name="intent" value="approve-item-mapping" /><input type="hidden" name="mappingId" value={mapping.id} /><input type="hidden" name="expectedVersion" value={String(mapping.version)} />
                <label for={`mapping-approve-reason-${mapping.id}`}>Approval reason</label><input id={`mapping-approve-reason-${mapping.id}`} name="reason" maxlength="500" required />
                <button type="submit">Approve mapping</button>
              </form>
              <form method="post" class="approve-mapping">
                <input type="hidden" name="intent" value="reject-item-mapping" /><input type="hidden" name="mappingId" value={mapping.id} /><input type="hidden" name="expectedVersion" value={String(mapping.version)} />
                <label for={`mapping-reject-reason-${mapping.id}`}>Rejection reason</label><input id={`mapping-reject-reason-${mapping.id}`} name="reason" maxlength="500" required />
                <button type="submit">Reject mapping</button>
              </form>
            </div> : mapping.approval_state === 'PENDING_SOURCE_APPROVAL' ? 'Awaiting named System Owner review' : mapping.approval_state}</td>
          </tr>)}</tbody>
        </table></div> : <p>No submitted mapping revisions are available.</p>)}
      </>}
    </section>
    <section class="panel" aria-labelledby="catalog-title"><h2 id="catalog-title">Inspection Report catalogue · Rev 14</h2>
      <form method="get" class="catalog-filters" role="search" aria-label="Filter Inspection Report catalogue"><label for="catalog-search">Search Doc. Code or official title<input id="catalog-search" name="search" type="search" maxlength="120" value={search} /></label><button type="submit">Search catalogue</button><a href="/quarantine/admin">Clear search</a></form>
      {search && <p class="active-filter">Active catalogue filter: <strong>{search}</strong></p>}
      {catalogResult?.status === 'AVAILABLE' && <p class="register-count" role="status">{catalog.length} identities on catalogue page {page}{search ? ` matching “${search}”` : ''}. Catalogue search does not filter template versions.</p>}
      {catalogResult?.status === 'UNAVAILABLE' ? <p role="alert">Catalogue is temporarily unavailable. Reload before creating a template.</p> : <div class="table-wrap" role="region" aria-label="Inspection Report catalogue" tabindex="0"><table><caption>Master identities, source status and digital readiness</caption><thead><tr><th scope="col">Doc. Code</th><th scope="col">Official title</th><th scope="col">Master Rev</th><th scope="col">Digital template</th><th scope="col">Version</th><th scope="col">Item mappings</th><th scope="col">Source</th></tr></thead><tbody>{catalog.map(c => <tr><th scope="row">{c.doc_code}</th><td>{c.official_title}</td><td>{c.master_revision}</td><td>{c.digitalTemplateStatus ?? 'NOT_DIGITIZED'}</td><td>{c.templateVersion ?? '—'}</td><td>{c.mappingCount}</td><td>{c.source_document_status}</td></tr>)}</tbody></table></div>}
      {!catalog.length && catalogResult?.status === 'AVAILABLE' && <p class="empty">No controlled identities match this search.</p>}
      <nav aria-label="Catalogue pages">{page > 1 && <a href={`?search=${encodeURIComponent(search)}&page=${page-1}`}>Previous</a>} {catalog.length === 50 && <a href={`?search=${encodeURIComponent(search)}&page=${page+1}`}>Next</a>}</nav>
    </section>
    <div class="register-stack">
      <section class="panel">
        <div class="panel-head"><div><p class="eyebrow">TEMPLATE LIFECYCLE</p><h2>Inspection template versions</h2></div></div>
        {!isAuthority && (
          <p class="note" role="note">Employee accounts create DRAFT only and cannot review, approve, stop, void, or supersede (P-06). Supervisor, Manager, and yazeed (SYSTEM_OWNER) act with reauthentication and E-Signature.</p>
        )}
        {isAuthority && (
          <p class="note" role="note">Catalogue authoring creates a draft until matching source evidence and digital content are bound. Supervisor and Manager lifecycle actions retain the configured e-signature ceremony. The named System Owner records internal approval without an e-signature; approval does not establish external company or quality authority.</p>
        )}
        {templateResult.status === 'AVAILABLE' && <p class="register-count" role="status">{templateResult.value.total} template versions · Page {templateResult.value.page} of {Math.max(1, Math.ceil(templateResult.value.total / templateResult.value.pageSize))}</p>}
        {listUnavailable ? (
          <p class="empty" role="alert">The template list is temporarily unavailable. Retry this page before treating the list as empty.</p>
        ) : templates.length ? (
          <div class="table-wrap" role="region" aria-label="Inspection template versions" tabindex="0"><table>
            <caption>Template versions with lifecycle state</caption>
            <thead><tr><th scope="col">Code</th><th scope="col">Version</th><th scope="col">Template lifecycle state</th><th scope="col">Origin / source</th><th scope="col">Open</th></tr></thead>
            <tbody>
              {templates.map((t) => (
                <tr>
                  <th scope="row">{t.templateCode}<span class="cell-detail">{t.name}</span></th>
                  <td>{t.versionNo}</td>
                  <td>{stateLabel(t.state)} · v{t.version.toString()}</td>
                  <td>{t.authoringOrigin}<span class="cell-detail">{t.sourceDocument ?? 'No source bound'}</span><span class="cell-detail">Snapshot hash: {t.contentHash ?? 'Not bound'}</span></td>
                  <td><a href={`/quarantine/admin/${t.id}`} aria-label={`Open ${t.templateCode} revision ${t.versionNo}`}>Open</a></td>
                </tr>
              ))}
            </tbody>
          </table></div>
        ) : (
          <p class="empty">No inspection template versions are available in your authorized scope.</p>
        )}
        {templateResult.status === 'AVAILABLE' && <nav aria-label="Template register pages">{templateResult.value.page > 1 && <a href={`?${new URLSearchParams({ ...Object.fromEntries(Astro.url.searchParams), templatePage: String(templateResult.value.page - 1) })}`}>Previous templates</a>}{templateResult.value.page * templateResult.value.pageSize < templateResult.value.total && <a href={`?${new URLSearchParams({ ...Object.fromEntries(Astro.url.searchParams), templatePage: String(templateResult.value.page + 1) })}`}>Next templates</a>}</nav>}
        <h3>Lifecycle guidance</h3>
        <p class="hint">These preliminary state and permission checks are guidance only. Open a version for server-controlled eligibility, source requirements and signature checks.</p>
        <ul class="states">
          {templates.map((t) => (
            <li>
              <span>{t.templateCode} {t.versionNo} · {t.state}</span>
              <small>
                {(['REVIEW', 'APPROVE', 'STOP', 'VOID', 'SUPERSEDE', 'REVISE'] as const).map((a) => {
                  const reason = disabledReason(t.state, a);
                  return <span class={reason ? 'off' : 'on'}>{a}{reason ? ` — disabled: ${reason}` : ' — subject to server eligibility'}</span>;
                })}
              </small>
            </li>
          ))}
        </ul>
      </section>

      {failure && <FormErrorSummary summary={failure.summary} recovery={failure.recovery} errors={Object.entries(failure.fieldErrors).map(([fieldId, message]) => ({ fieldId, message }))} listHref="/quarantine/admin" listLabel="template administration" />}
      <div class="creation-grid">
      <section class="panel">
        <p class="eyebrow">SOURCE_TRANSCRIPTION</p>
        <h2>Create template</h2>
        {isAuthority && hasTemplatePermission && <form method="post"><input type="hidden" name="intent" value="import-sources"/><p>Import the verified source transcriptions as DRAFT. This records conflicts and source digests; it creates no approval or item mapping.</p><button type="submit">Import source drafts</button></form>}

        {!hasTemplatePermission ? (
          <p class="empty">Creation requires the explicit template administration permission.</p>
        ) : (
          <form method="post" data-template-create>
            <fieldset><legend>Template identity <span class="req-note">All fields marked * are required</span></legend>
            <label for="catalogId">Inspection Report<span aria-hidden="true"> *</span><span class="hint" id="catalogId-help">Choose the exact Rev 14 master identity. Source-conflicted entries cannot be used.</span><select id="catalogId" name="catalogId" required aria-invalid={invalid('catalogId')} aria-describedby={describedBy('catalogId')}><option value="">Choose Inspection Report…</option>{catalog.filter(c => c.catalog_state === 'ACTIVE').map(c => <option value={c.id} selected={values.catalogId === c.id}>{c.doc_code} · {c.official_title} · Rev {c.master_revision}</option>)}</select></label>
            {failure?.fieldErrors.catalogId && <p class="field-error" id="catalogId-error">{failure.fieldErrors.catalogId}</p>}
            <label for="templateDescription">Description<textarea id="templateDescription" name="description" rows="3">{values.description}</textarea></label>
            </fieldset>
            <p class="note">Source document evidence is bound through Document Control. This form does not accept a browser-provided digest or free-text source reference.</p>
            <p class="hint">Creates DRAFT. Approval requires matched source content and the authorized E-Signature ceremony.</p>
            <p class="hint" data-result role="status" aria-live="polite" tabindex="-1"></p>
            <div class="actions"><button type="submit" data-submit>Create template</button></div>
          </form>
        )}
        <p class="note">Actions check the current record version. Each transition preserves its audit history.</p>
      </section>

      <section class="panel">
        <p class="eyebrow">USER_AUTHORED_SPECIFICATION</p>
        <h2>Create a template from scratch</h2>
        <p class="note">
          Starts an in-system authored specification: an identity plus a DRAFT version. You design
          the inspection points next, then it goes through the same review and approval path as any
          other template. Creating never approves.
        </p>
        {!hasTemplatePermission ? (
          <p class="empty">Creation requires the explicit template administration permission.</p>
        ) : (
          <form method="post" data-authored-template-create>
            <input type="hidden" name="intent" value="create-authored" />
            <fieldset>
              <legend>Controlled identity <span class="req-note">All fields marked * are required</span></legend>
              <label for="templateCode">Document code<span aria-hidden="true"> *</span>
                <span class="hint" id="templateCode-help">
                  Use the code assigned by Document Control. The system does not generate or reserve
                  document numbers, and a Rev 14 catalogue code cannot be reused here.
                </span>
                <input id="templateCode" name="templateCode" required maxlength="64" value={values.templateCode} aria-describedby="templateCode-help" />
              </label>
              <label for="versionNo">Revision<span aria-hidden="true"> *</span>
                <input id="versionNo" name="versionNo" required maxlength="64" value={values.versionNo} />
              </label>
              <label for="name">Template name<span aria-hidden="true"> *</span>
                <input id="name" name="name" required maxlength="200" value={values.name} />
              </label>
              <label for="authoredDescription">Description
                <textarea id="authoredDescription" name="description" rows="3">{values.description}</textarea>
              </label>
            </fieldset>
            <p class="note">
              The revision digest is server-owned and completes once a design is saved and a
              controlled document is bound.
            </p>
            <p class="hint" data-authored-result data-result role="status" aria-live="polite" tabindex="-1"></p>
            <div class="actions"><button type="submit" data-submit>Create draft template</button></div>
          </form>
        )}
      </section>
      </div>
    </div>
    </>
  )}

  </div>
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  import { enhanceMutationForm } from '../../../ui/forms/mutation-interaction.js';
  const form = document.querySelector<HTMLFormElement>('form[data-template-create]');
  if (form) {
    enhanceMutationForm({
      form,
      progressText: 'Creating template…',
      copy: {
        VALIDATION_ERROR: 'The template was not created. Review the highlighted fields and try again.',
        CONFLICT_STALE: 'A template with the same code and version may already exist. Check the selected catalogue identity and its existing version before trying again. Your other entries are preserved.',
        AUTHORIZATION_CHANGED: 'Your authorization changed. This action needs the explicit template administration permission. Your entries are preserved.',
        DEPENDENCY_UNAVAILABLE: 'A referenced record could not be found. Verify the source document and try again. Your entries are preserved.',
        UNKNOWN_SAFE_ERROR: 'The creation result could not be confirmed. Your entries are preserved. Check the template list before trying again.',
      },
      invoke: (data) =>
        actions.quarantineTemplates.createTemplate({
          catalogId: String(data.get('catalogId') ?? ''),
          description: String(data.get('description') ?? '') || undefined,
          reauthenticationSecret: String(data.get('reauthenticationSecret') ?? '') || undefined,
        }) as unknown as Promise<{ data?: { id?: string }; error?: unknown }>,
      onSuccess: (outcome) => {
        if (outcome.recordId) location.href = '/quarantine/admin/' + outcome.recordId;
        else location.reload();
      },
    });
  }
  const authoredForm = document.querySelector<HTMLFormElement>('form[data-authored-template-create]');
  if (authoredForm) {
    enhanceMutationForm({
      form: authoredForm,
      progressText: 'Creating draft template…',
      copy: {
        VALIDATION_ERROR: 'The template was not created. Check the document code, revision and name — a Rev 14 catalogue code cannot be reused, and the revision must match the design you will save.',
        CONFLICT_STALE: 'An identity with this code and revision already exists. Open it instead of creating a duplicate.',
        AUTHORIZATION_CHANGED: 'Your authorization changed. This action needs the explicit template administration permission. Your entries are preserved.',
        DEPENDENCY_UNAVAILABLE: 'A referenced record could not be found. Your entries are preserved.',
        UNKNOWN_SAFE_ERROR: 'The creation result could not be confirmed. Your entries are preserved. Check the template list before trying again.',
      },
      invoke: (data) =>
        actions.quarantineTemplates.createAuthoredTemplate({
          templateCode: String(data.get('templateCode') ?? ''),
          versionNo: String(data.get('versionNo') ?? ''),
          name: String(data.get('name') ?? ''),
          description: String(data.get('description') ?? '') || undefined,
        }) as unknown as Promise<{ data?: { id?: string }; error?: unknown }>,
      onSuccess: (outcome) => {
        if (outcome.recordId) location.href = '/quarantine/admin/' + outcome.recordId + '?mode=design';
        else location.reload();
      },
    });
  }
</script>
