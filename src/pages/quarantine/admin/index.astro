---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { quarantineReadDependencies } from '../../../modules/quarantine/application/dependencies.js';
import { AppError } from '../../../shared/errors/app-error.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquarantine%2Fadmin');
let admin: Awaited<ReturnType<typeof quarantineReadDependencies>['admin']['execute']> | undefined;
let denied = false;
try { admin = await quarantineReadDependencies().admin.execute({ actor }); } catch (error) { denied = error instanceof AppError && error.category === 'AUTHORIZATION'; }
---
<AppLayout title="Quarantine Administration · QC Operations" locale="en" direction="ltr">
  <section class="head"><div><p class="eyebrow">CONTROLLED CONFIGURATION</p><h1>Quarantine administration</h1><p class="lede">Read-only operational configuration and approved reference context.</p></div><a href="/quarantine">Back to Quarantine</a></section>
  {denied ? <section class="denied" role="alert"><h2>Administration is not available</h2><p>This area requires the explicit Quarantine administration permission. Admin role alone is not business authority.</p></section> : <div class="grid"><section class="panel"><div class="panel-head"><div><p class="eyebrow">APPROVED TEMPLATES</p><h2>Inspection template versions</h2></div></div>{admin?.templates.length ? <div class="table-wrap"><table><caption>Approved template context</caption><thead><tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col">Active</th><th scope="col">Current approved version</th></tr></thead><tbody>{admin.templates.map((template) => <tr><th scope="row">{template.code}</th><td>{template.name}</td><td>{template.active ? 'Active' : 'Inactive'}</td><td>{template.currentVersion ?? 'No approved version'}</td></tr>)}</tbody></table></div> : <p class="empty">No approved inspection templates are available.</p>}</section><section class="panel"><p class="eyebrow">READ MODEL</p><h2>Receiving state distribution</h2>{admin?.receivingByState.length ? <ul class="states">{admin.receivingByState.map((row) => <li><span>{row.state}</span><strong>{row.value}</strong></li>)}</ul> : <p class="empty">No receiving state data is available.</p>}<p class="note">Configuration changes require a separate approved mutation workflow with permission, audit, and concurrency checks.</p></section></div>}
</AppLayout>
<style>
  .head,.panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-5)}.head{margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.empty,.note,.denied p{color:var(--text-muted);font-size:.84rem}.head a{color:var(--color-accent-primary-hover)}.grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:var(--space-5)}.panel,.denied{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}h2{margin:.25rem 0 0;font-size:1rem}.table-wrap{overflow-x:auto;margin-top:var(--space-4)}table{width:100%;min-width:620px;border-collapse:collapse}caption{text-align:start;padding:.75rem 0;color:var(--text-muted);font-size:.8rem}th,td{padding:.75rem 0;border-top:1px solid var(--color-border-subtle);text-align:start;font-size:.8rem}.states{list-style:none;margin:var(--space-4) 0;padding:0}.states li{display:flex;justify-content:space-between;padding:.8rem 0;border-top:1px solid var(--color-border-subtle);font-size:.82rem}.note{margin-top:var(--space-5);padding-top:var(--space-4);border-top:1px solid var(--color-border-subtle);line-height:1.5}.denied{border-inline-start:3px solid var(--status-warning)}@media(max-width:760px){.head,.grid{display:grid}.panel{padding:var(--space-4)}}
</style>
