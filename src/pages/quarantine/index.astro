---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import KpiCard from '../../ui/charts/KpiCard.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import ProviderUnavailableState from '../../ui/components/feedback/ProviderUnavailableState.astro';
import { quarantineReadDependencies } from '../../modules/quarantine/application/dependencies.js';
import { AppError } from '../../shared/errors/app-error.js';
import { describeActorScope } from '../../shared/authorization/scope-description.js';
import { formatDateTime } from '../../shared/copy/format.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquarantine');
let overview = { generatedAt: new Date(), scopeLabel: describeActorScope(actor), metrics: [], attention: [], distributions: [] } as Awaited<ReturnType<ReturnType<typeof quarantineReadDependencies>['overview']['execute']>>;
// A denied account is not a provider outage, and an unavailable provider is not
// an empty register: each state is named instead of rendering a blank KPI row
// (audit P2 — "provider unavailable must never become empty or zero").
let providerUnavailable = false;
let accessDenied = false;
try {
  overview = await quarantineReadDependencies().overview.execute({ actor });
} catch (error) {
  if (error instanceof AppError && error.category === 'AUTHORIZATION') accessDenied = true;
  else providerUnavailable = true;
}
---
<AppLayout title="Quarantine · QC Operations" locale="en" direction="ltr" scope={overview.scopeLabel}>
  <section class="page-head"><div><p class="eyebrow">Operations</p><h1>Quarantine</h1><p class="lede">Track receiving, inspection decisions, and explicit release state in one authorized scope.</p></div><div class="head-meta"><span>{overview.scopeLabel}</span><time datetime={overview.generatedAt.toISOString()}>Server snapshot · {formatDateTime(overview.generatedAt)}</time></div></section>
  {accessDenied && <section class="denied" role="alert"><h2>Your account cannot read the quarantine overview</h2><p>Reading the quarantine register needs the quarantine view permission. Your authorization was not changed by this request, and nothing is withheld-and-retried.</p><a href="/tasks">Go to your tasks</a></section>}
  {providerUnavailable && <ProviderUnavailableState title="Quarantine data is unavailable" description="The quarantine read provider did not return a confirmed snapshot. Every counter, including zero-looking ones, is withheld." />}
  {!accessDenied && !providerUnavailable && <section class="metrics" aria-label="Quarantine key metrics">{overview.metrics.map((metric) => <KpiCard label={metric.label} value={metric.value} unit={metric.unit} definition={metric.definition} source={metric.source} timeRange={metric.timeRange} numerator={metric.numerator} state={metric.state} actorScope={metric.actorScope} href={metric.href} drilldownLabel={metric.drilldownLabel} tone={metric.tone} />)}</section>}
  {!accessDenied && <div class="grid"><section class="panel" aria-labelledby="attention-title"><div class="panel-head"><div><p class="eyebrow">ATTENTION BOARD</p><h2 id="attention-title">Items needing follow-up</h2></div><a href="/quarantine/receiving">Receiving register</a></div>{providerUnavailable ? <p class="empty">Attention data is unavailable. No follow-up list or empty-state claim is shown.</p> : overview.attention.length ? <ul class="attention">{overview.attention.map((item) => <li><a href={item.href}><span><strong>{item.title}</strong><small>{item.summary}</small></span><StatusBadge status={item.severity === 'CRITICAL' ? 'FAIL' : 'WARNING'} label={item.state} /></a></li>)}</ul> : <p class="empty">No items need attention in this snapshot.</p>}</section><section class="panel" aria-labelledby="distribution-title"><div class="panel-head"><div><p class="eyebrow">STATE DISTRIBUTION</p><h2 id="distribution-title">Receiving workflow</h2></div></div>{providerUnavailable ? <p class="empty">Distribution data is unavailable, so no state breakdown is shown.</p> : overview.distributions.length ? <ul class="bars">{overview.distributions.map((item) => <li><span>{item.label}</span><strong style={`--bar-size:${Math.min(item.value * 10, 100)}%`}>{item.value}</strong></li>)}</ul> : <p class="empty">No receiving item you are allowed to read exists in this snapshot.</p>}<p class="callout"><strong>PASS is not Released.</strong> Inspection result and Release System State remain separate controlled facts.</p></section></div>}
</AppLayout>
<style>
  .page-head,.panel-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.page-head{margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem;font-size:clamp(1.9rem,4vw,2.8rem)}.eyebrow{margin:0;color:var(--text-muted);font-size:var(--font-size-xs);letter-spacing:.12em;font-weight:700}.lede,.head-meta,.empty,.panel p{color:var(--text-muted);font-size:var(--font-size-sm)}.head-meta{display:grid;gap:.45rem;text-align:end}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-3);margin-bottom:var(--space-5)}.grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:var(--space-5)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:.25rem 0 0;font-size:1rem}.panel-head a{color:var(--color-accent-primary-hover);font-size:var(--font-size-xs)}.attention,.bars{list-style:none;margin:var(--space-4) 0 0;padding:0}.attention li,.bars li{border-block-start:1px solid var(--color-border-subtle)}.attention a{display:flex;justify-content:space-between;align-items:center;gap:var(--space-3);padding:.8rem 0;color:inherit;text-decoration:none}.attention strong,.attention small{display:block}.attention small{margin-top:4px;color:var(--text-muted);font-size:var(--font-size-xs)}.bars li{display:grid;grid-template-columns:1fr auto;gap:.6rem;padding:.8rem 0;align-items:center}.bars strong{position:relative;min-width:2rem;text-align:end;color:var(--color-accent-primary-hover)}.bars strong::before{content:'';position:absolute;inset-inline-end:calc(100% + .7rem);top:50%;width:min(120px,var(--bar-size));height:5px;background:var(--color-accent-primary);border-radius:99px}.callout{margin:var(--space-5) 0 0;padding:var(--space-3);border-inline-start:3px solid var(--status-released);background:var(--status-released-bg)}.callout strong{color:var(--status-released)}.denied{margin-bottom:var(--space-5);padding:var(--space-5);background:var(--status-warning-bg);border:1px solid var(--status-warning);border-radius:var(--radius-lg)}.denied h2{margin:0 0 var(--space-2)}.denied p{margin:0 0 var(--space-3)}@media(max-width:1100px){.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.page-head{display:grid}.head-meta{text-align:start}.grid{grid-template-columns:1fr}}@media(max-width:520px){.metrics{grid-template-columns:minmax(0,1fr)}.panel{padding:var(--space-4)}}
</style>
