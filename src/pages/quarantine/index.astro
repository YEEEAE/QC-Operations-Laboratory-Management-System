---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import { quarantineReadDependencies } from '../../modules/quarantine/application/dependencies.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquarantine');
let overview: Awaited<ReturnType<GetQuarantineOverviewUseCase['execute']>> = { generatedAt: new Date(), scopeLabel: 'Authorized scope', metrics: [], attention: [], distributions: [] };
try { overview = await quarantineReadDependencies().overview.execute({ actor }); } catch { /* safe empty state when the read provider is unavailable */ }
---
<AppLayout title="Quarantine · QC Operations" locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">T3 CONTROLLED OPERATIONS</p><h1>Quarantine</h1><p class="lede">Track receiving, inspection decisions, and explicit release state in one authorized scope.</p></div><div class="head-meta"><span>{overview.scopeLabel}</span><time datetime={overview.generatedAt.toISOString()}>Snapshot {overview.generatedAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' })}</time></div></section>
  <section class="metrics" aria-label="Quarantine key metrics">{overview.metrics.map((metric) => <a class:list={['metric', `metric--${metric.tone}`]} href={metric.href}><span>{metric.label}</span><strong>{metric.value}</strong><small>{metric.definition}</small></a>)}</section>
  <div class="grid"><section class="panel" aria-labelledby="attention-title"><div class="panel-head"><div><p class="eyebrow">ATTENTION BOARD</p><h2 id="attention-title">Items needing follow-up</h2></div><a href="/quarantine/receiving">Receiving register</a></div>{overview.attention.length ? <ul class="attention">{overview.attention.map((item) => <li><a href={item.href}><span><strong>{item.title}</strong><small>{item.summary}</small></span><StatusBadge status={item.severity === 'CRITICAL' ? 'FAIL' : 'WARNING'} label={item.state} /></a></li>)}</ul> : <p class="empty">No items need attention in this snapshot.</p>}</section><section class="panel" aria-labelledby="distribution-title"><div class="panel-head"><div><p class="eyebrow">STATE DISTRIBUTION</p><h2 id="distribution-title">Receiving workflow</h2></div></div>{overview.distributions.length ? <ul class="bars">{overview.distributions.map((item) => <li><span>{item.label}</span><strong style={`--bar-size:${Math.min(item.value * 10, 100)}%`}>{item.value}</strong></li>)}</ul> : <p class="empty">No receiving items are available in your authorized scope.</p>}<p class="callout"><strong>PASS is not Released.</strong> Inspection result and Release System State remain separate controlled facts.</p></section></div>
</AppLayout>
<style>
  .page-head,.panel-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.page-head{margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem;font-size:clamp(1.9rem,4vw,2.8rem)}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.head-meta,.empty,.metric small,.panel p{color:var(--text-muted);font-size:.84rem}.head-meta{display:grid;gap:.45rem;text-align:end}.metrics{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:var(--space-3);margin-bottom:var(--space-5)}.metric{display:grid;gap:.35rem;min-height:128px;padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md);color:inherit;text-decoration:none}.metric:hover,.metric:focus-visible{border-color:var(--color-accent-primary);transform:translateY(-1px)}.metric span{color:var(--text-secondary);font-size:.78rem}.metric strong{font-size:2rem;line-height:1}.metric small{line-height:1.45}.metric--warning{border-block-start:3px solid var(--status-warning)}.metric--danger{border-block-start:3px solid var(--status-danger)}.metric--success{border-block-start:3px solid var(--status-pass)}.grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:var(--space-5)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.panel h2{margin:.25rem 0 0;font-size:1rem}.panel-head a{color:var(--color-accent-primary-hover);font-size:.8rem}.attention,.bars{list-style:none;margin:var(--space-4) 0 0;padding:0}.attention li,.bars li{border-block-start:1px solid var(--color-border-subtle)}.attention a{display:flex;justify-content:space-between;align-items:center;gap:var(--space-3);padding:.8rem 0;color:inherit;text-decoration:none}.attention strong,.attention small{display:block}.attention small{margin-top:4px;color:var(--text-muted);font-size:.76rem}.bars li{display:grid;grid-template-columns:1fr auto;gap:.6rem;padding:.8rem 0;align-items:center}.bars strong{position:relative;min-width:2rem;text-align:end;color:var(--color-accent-primary-hover)}.bars strong::before{content:'';position:absolute;inset-inline-end:calc(100% + .7rem);top:50%;width:min(120px,var(--bar-size));height:5px;background:var(--color-accent-primary);border-radius:99px}.callout{margin:var(--space-5) 0 0;padding:var(--space-3);border-inline-start:3px solid var(--status-released);background:var(--status-released-bg)}.callout strong{color:var(--status-released)}@media(max-width:1100px){.metrics{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:760px){.page-head{display:grid}.head-meta{text-align:start}.grid{grid-template-columns:1fr}}@media(max-width:520px){.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.metric{min-height:112px}.panel{padding:var(--space-4)}}
</style>
