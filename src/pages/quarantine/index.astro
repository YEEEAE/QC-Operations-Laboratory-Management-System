---
import PageHeader from "../../ui/components/PageHeader.astro";
import AppLayout from '../../ui/layouts/AppLayout.astro';
import KpiCard from '../../ui/charts/KpiCard.astro';
import StatusBadge from '../../ui/components/StatusBadge.astro';
import ProviderUnavailableState from '../../ui/components/feedback/ProviderUnavailableState.astro';
import { quarantineReadDependencies } from '../../modules/quarantine/application/dependencies.js';
import { AppError } from '../../shared/errors/app-error.js';
import { describeActorScope } from '../../shared/authorization/scope-description.js';
import { formatDateTime } from '../../shared/copy/format.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquarantine');
let overview = { generatedAt: new Date(), scopeLabel: describeActorScope(actor), metrics: [], attention: [], distributions: [] } as Awaited<ReturnType<ReturnType<typeof quarantineReadDependencies>['overview']['execute']>>;
// A denied account is not a provider outage, and an unavailable provider is not
// an empty register: each state is named instead of rendering a blank KPI row
// (audit P2 — "provider unavailable must never become empty or zero").
let providerUnavailable = false;
let accessDenied = false;
try {
  overview = await quarantineReadDependencies().overview.execute({ actor });
} catch (error) {
  if (error instanceof AppError && error.category === 'AUTHORIZATION') accessDenied = true;
  else providerUnavailable = true;
}
---
<!-- READ is server-rendered: available (including empty), authorization denied,
     or provider unavailable. Pending is N/A: no client read request exists.
     FILTER / EXPORT are N/A: this overview only links to existing registers.
     AUTH uses the existing actor redirect and application authorization. -->
<AppLayout title="Quarantine · QC Operations" locale="en" direction="ltr" scope={overview.scopeLabel}>
  <PageHeader>
    <Fragment slot="heading"><h1>Quarantine</h1></Fragment>
    <p class="lede">Receiving, inspections and release status.</p>
    <Fragment slot="actions">
      <div class="head-meta">
        <span>{overview.scopeLabel}</span>
        {!accessDenied && !providerUnavailable && <time datetime={overview.generatedAt.toISOString()}>Server snapshot · {formatDateTime(overview.generatedAt)}</time>}
      </div>
    </Fragment>
  </PageHeader>

  <div class="read-feedback">
    {accessDenied && <section class="denied" role="alert">
      <h2>Your account cannot read the quarantine overview</h2>
      <p>This account needs the quarantine view permission. Ask your administrator to confirm access. Each KPI count is withheld until this account is authorized to read the overview.</p>
      <a href="/tasks">Go to your tasks</a>
    </section>}
    {providerUnavailable && <ProviderUnavailableState title="Quarantine data is unavailable" description="Quarantine data could not be confirmed. No counts are shown. Reload to check again." />}
  </div>

  {!accessDenied && <div class="overview-grid">
    <section class="panel" aria-labelledby="attention-title">
      <div class="panel-head">
        <div><p class="eyebrow">Attention board</p><h2 id="attention-title">Items needing follow-up</h2></div>
        <a class="register-link" href="/quarantine/receiving">Receiving register</a>
      </div>
      {!providerUnavailable && (overview.attention.length ? <ul class="attention">
        {overview.attention.map((item) => <li>
          <a href={item.href}>
            <span class="attention-copy"><strong>{item.title}</strong><small>{item.summary}</small></span>
            <StatusBadge status={item.severity === 'CRITICAL' ? 'FAIL' : 'WARNING'} label={item.state} />
          </a>
        </li>)}
      </ul> : <p class="empty">No items need attention in this snapshot.</p>)}
    </section>

    <section class="panel" aria-labelledby="distribution-title">
      <div class="panel-head">
        <div><p class="eyebrow">State distribution</p><h2 id="distribution-title">Receiving workflow</h2></div>
      </div>
      {!providerUnavailable && (overview.distributions.length ? <ul class="distribution">
        {overview.distributions.map((item) => <li><span>{item.label}</span><strong>{item.value}</strong></li>)}
      </ul> : <p class="empty">No receiving item you are allowed to read exists in this snapshot.</p>)}
      <p class="callout"><strong>PASS is not Released.</strong> Inspection result and Release System State remain separate controlled facts.</p>
    </section>
  </div>}

  {!accessDenied && !providerUnavailable && <section class="metrics" aria-label="Quarantine key metrics">
    {overview.metrics.map((metric) => <KpiCard label={metric.label} value={metric.value} unit={metric.unit} definition={metric.definition} source={metric.source} timeRange={metric.timeRange} numerator={metric.numerator} state={metric.state} actorScope={metric.actorScope} href={metric.href} drilldownLabel={metric.drilldownLabel} tone={metric.tone} />)}
  </section>}
</AppLayout>
<style>
  .lede { margin-block: var(--space-2) 0; color: var(--text-secondary); font-size: var(--font-size-sm); }
  .head-meta { display: grid; gap: var(--space-2); min-inline-size: 0; color: var(--text-muted); font-size: var(--font-size-xs); text-align: end; overflow-wrap: anywhere; }
  .read-feedback:has(> *) { margin-block-end: var(--space-5); }
  .overview-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: var(--space-5); margin-block-end: var(--space-5); }
  .panel { min-inline-size: 0; padding: var(--space-5); background: var(--surface-panel); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); }
  .panel-head { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: var(--space-3); }
  .panel-head > div { min-inline-size: 0; }
  .eyebrow { margin: 0; color: var(--text-muted); font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); }
  .panel h2 { margin-block: var(--space-1) 0; color: var(--text-primary); font-size: var(--font-size-md); }
  .register-link { display: inline-flex; align-items: center; justify-content: center; min-block-size: 44px; padding: var(--space-2) var(--space-3); border: 1px solid var(--control-border); border-radius: var(--radius-sm); color: var(--color-accent-primary-hover); background: var(--surface-inset); font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); overflow-wrap: anywhere; }
  .register-link:hover { background: var(--surface-raised); }
  .attention, .distribution { list-style: none; margin: var(--space-4) 0 0; padding: 0; }
  .attention li, .distribution li { border-block-start: 1px solid var(--color-border-subtle); }
  .attention a { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3); min-block-size: 44px; padding-block: var(--space-4); color: var(--text-primary); text-decoration: none; }
  .attention a:hover strong { text-decoration: underline; }
  .attention-copy { flex: 1 1 14rem; min-inline-size: 0; overflow-wrap: anywhere; }
  .attention strong, .attention small { display: block; }
  .attention strong { font-size: var(--font-size-sm); }
  .attention small { margin-block-start: var(--space-1); color: var(--text-muted); font-size: var(--font-size-xs); }
  .distribution li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-3); padding-block: var(--space-3); align-items: baseline; font-size: var(--font-size-sm); }
  .distribution span { color: var(--text-secondary); overflow-wrap: anywhere; }
  .distribution strong { color: var(--text-primary); font-variant-numeric: tabular-nums; }
  .empty, .callout { color: var(--text-muted); font-size: var(--font-size-sm); line-height: var(--line-height-normal); }
  .empty { margin-block: var(--space-4) 0; }
  .callout { margin: var(--space-5) 0 0; padding: var(--space-3); border-inline-start: 3px solid var(--color-border-default); background: var(--surface-inset); }
  .callout strong { color: var(--text-primary); }
  .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: start; gap: var(--space-3); }
  .metrics :global(.kpi) { min-inline-size: 0; }
  .denied { padding: var(--space-5); background: var(--status-warning-bg); border: 1px solid var(--status-warning); border-radius: var(--radius-lg); }
  .denied h2 { margin: 0 0 var(--space-2); font-size: var(--font-size-md); }
  .denied p { margin: 0 0 var(--space-3); color: var(--text-secondary); }
  .denied a { display: inline-flex; align-items: center; min-block-size: 44px; }
  .register-link:focus-visible, .attention a:focus-visible, .denied a:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  @media (max-width: 1200px) { .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .overview-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 760px) { .head-meta { text-align: start; } }
  @media (max-width: 520px) { .metrics { grid-template-columns: minmax(0, 1fr); } .panel { padding: var(--space-4); } }
</style>
