---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../../ui/components/StatusBadge.astro';
import JourneyContextPanel from '../../../ui/components/workflow/JourneyContextPanel.astro';
import { receivingReadDependencies } from '../../../modules/quarantine/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
let item: Awaited<ReturnType<ReturnType<typeof receivingReadDependencies>['get']['execute']>> | undefined;
try { item = await receivingReadDependencies().get.execute({ actor, id: Astro.params.receivingId ?? '' }); } catch { return Astro.redirect('/404'); }
if (!item) return Astro.redirect('/404');
const canHold = actor.permissions.some((permission) => permission.code === 'PERM-QUAR-HOLD');
const canRelease = actor.permissions.some((permission) => permission.code === 'PERM-QUAR-RELEASE');
const nextAction = item.workflowState === 'READY_FOR_INSPECTION' ? 'Start inspection' : item.workflowState === 'RELEASE_PENDING' ? 'Release item' : item.workflowState === 'HOLD' ? 'Resolve HOLD disposition' : undefined;
const nextOwner = item.workflowState === 'READY_FOR_INSPECTION' ? 'Inspector' : item.workflowState === 'RELEASE_PENDING' ? 'Quarantine release authority' : item.workflowState === 'HOLD' ? 'Quarantine / Quality owner' : undefined;
const whyUnavailable = item.workflowState === 'RELEASE_PENDING' && !canRelease ? 'permission: release authority is not available to this account' : item.workflowState === 'INSPECTION_COMPLETE' ? 'dependency: approved inspection consequence is required before release pending' : undefined;
---
<AppLayout title={`${item.receivingNo} · Quarantine`} locale="en" direction="ltr">
  <div class="crumb"><a href="/quarantine">Quarantine</a><span aria-hidden="true">/</span><a href="/quarantine/receiving">Receiving items</a><span aria-hidden="true">/</span><span>{item.receivingNo}</span></div>
  <section class="record-head" data-record-id={item.id} data-version={item.version.toString()}><div><p class="eyebrow">RECEIVING RECORD</p><h1>{item.receivingNo}</h1><p class="lede">{item.itemCode} · {item.description} · Lot {item.lot}</p></div><div class="version">Version <strong>{item.version.toString()}</strong></div></section>
  <p role="status" data-result tabindex="-1" class="action-status"></p>
   <section class="facts" aria-label="Separate controlled states"><div><span>Receiving state</span><strong>{item.workflowState}</strong></div><div><span>Inspection result</span>{item.inspectionResult === 'PASS' ? <StatusBadge status="PASS" /> : item.inspectionResult === 'FAIL' || item.inspectionResult === 'HOLD' ? <StatusBadge status={item.inspectionResult === 'FAIL' ? 'FAIL' : 'HOLD'} /> : <strong>{item.inspectionResult}</strong>}</div><div><span>Release System State</span>{item.releaseSystem ? <StatusBadge status="RELEASED" label="RELEASED" /> : <strong class="not-released">NOT_RELEASED</strong>}</div></section>
  <JourneyContextPanel ownerDomain="Quarantine" currentState={`${item.workflowState} · Inspection ${item.inspectionResult} · Release ${item.releaseSystem ? 'YES' : 'NO'}`} nextAction={nextAction} nextOwner={nextOwner} whyUnavailable={whyUnavailable} waitingOn={item.workflowState === 'UNDER_INSPECTION' ? 'Inspection executor' : item.workflowState === 'RELEASE_PENDING' ? 'Release decision' : undefined} expectedEvent={item.workflowState === 'READY_FOR_INSPECTION' ? 'Inspection start' : item.workflowState === 'RELEASE_PENDING' ? 'Release transition' : undefined} controlledContext="Receiving identity and current record version" evidenceSummary="Receiving record, inspection result, and release state remain separate" auditHref={`/audit?subjectType=RECEIVING_ITEM&subjectId=${encodeURIComponent(item.id)}`} relatedLinks={[{ label: 'Inspection register', href: '/quarantine/inspections', detail: 'Quarantine-owned workflow' }]} />
  <div class="layout"><main><section class="panel"><h2>Receiving details</h2><dl><div><dt>Document</dt><dd>{item.docNo}</dd></div><div><dt>Quantity</dt><dd>{item.qty}</dd></div><div><dt>Received</dt><dd>{item.receivingDate.toLocaleDateString('en-SA', { timeZone: 'Asia/Riyadh' })}</dd></div><div><dt>Expiry</dt><dd>{item.expiryDate?.toLocaleDateString('en-SA', { timeZone: 'Asia/Riyadh' }) ?? 'Not supplied'}</dd></div></dl></section><section class="panel"><div class="panel-head"><h2>Inspection</h2><a href="/quarantine/inspections">Inspection register</a></div><p class="muted">Inspection execution and approval are separate controlled workflows. No result is accepted from this page.</p></section><section class="panel"><h2>History</h2><p class="muted">Controlled transitions are audited with actor, timestamp, reason, and record version.</p></section></main><aside class="rail"><section class="panel"><h2>Primary actions</h2><div class="actions">{item.workflowState === 'READY_FOR_INSPECTION' ? <button data-action="quarantine.transitionReceiving" data-transition="START_INSPECTION" data-submit>Start inspection</button> : null}{canHold && !['RELEASED','EXPIRED','CANCELLED'].includes(item.workflowState) ? <button class="secondary" data-action="quarantine.holdReceiving" data-submit>Place on HOLD</button> : null}{canRelease && item.workflowState === 'RELEASE_PENDING' ? <button class="controlled" data-action="quarantine.releaseReceiving" data-submit>Release item</button> : null}<a class="secondary link-button" href={`/quarantine/receiving/${item.id}`}>Refresh latest</a></div>{canRelease && item.inspectionResult === 'PASS' && !item.releaseSystem ? <p class="note">PASS is recorded, but this item is not released. Release remains a separate policy-controlled action.</p> : null}</section><section class="panel"><h2>Context</h2><dl class="compact"><div><dt>Created by</dt><dd>{item.createdBy}</dd></div><div><dt>Last updated</dt><dd>{item.updatedAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' })}</dd></div><div><dt>Version</dt><dd>{item.version.toString()}</dd></div></dl></section></aside></div>
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  const context = document.querySelector<HTMLElement>('[data-record-id]');
  const itemId = context?.dataset.recordId ?? '';
  const version = context?.dataset.version ?? '0';
  const output = document.querySelector<HTMLElement>('[data-result]');
  const setBusy = (button: HTMLButtonElement | null, busy: boolean, text?: string) => {
    const region = button?.closest('section, div') ?? document.body;
    if (busy) region.setAttribute('aria-busy', 'true');
    else region.removeAttribute('aria-busy');
    if (button) button.disabled = busy;
    if (busy && text && output) output.textContent = text;
  };
  const fail = (button: HTMLButtonElement | null, message: string) => {
    setBusy(button, false);
    if (output) { output.textContent = message; output.focus?.(); }
  };
  document.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((button) => button.addEventListener('click', async () => {
    if (button.disabled || button.closest('[aria-busy="true"]')) return;
    const action = button.dataset.action;
    setBusy(button, true, 'Applying the controlled action…');
    try {
      const next = action === 'quarantine.holdReceiving'
        ? await actions.quarantine.holdReceiving({ id: itemId, expectedVersion: BigInt(version), reason: 'HOLD requested from the record workspace.' })
        : action === 'quarantine.releaseReceiving'
          ? await actions.quarantine.releaseReceiving({ id: itemId, expectedVersion: BigInt(version) })
          : await actions.quarantine.transitionReceiving({ id: itemId, expectedVersion: BigInt(version), action: (button.dataset.transition ?? 'START_INSPECTION') as 'START_INSPECTION' });
      if (!next.error) { window.location.reload(); return; }
      fail(button, 'The controlled action was not applied. Refresh and review the current state and version before trying again.');
    } catch {
      fail(button, 'The service is temporarily unavailable. Nothing was changed — refresh and try again if permitted.');
    }
  }));
</script>
<style>
  .crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a{color:var(--color-accent-primary-hover)}.record-head,.panel-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start}.record-head{margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.muted,.version,.panel p{color:var(--text-muted);font-size:.84rem}.version{padding:.5rem .75rem;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3);margin-bottom:var(--space-5)}.facts>div{display:grid;gap:.45rem;padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md)}.facts span{color:var(--text-muted);font-size:.75rem}.facts strong{font-size:1rem}.not-released{color:var(--text-muted)}.layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:var(--space-5)}main,.rail{display:grid;gap:var(--space-5);align-content:start}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}h2{margin:0;font-size:1rem}.panel-head a{color:var(--color-accent-primary-hover);font-size:.8rem}dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin:var(--space-5) 0 0}dt{color:var(--text-muted);font-size:.75rem}dd{margin:.3rem 0 0;color:var(--text-primary);font-weight:600}.action-status{margin:0 0 var(--space-4);color:var(--text-secondary);font-size:.85rem;min-height:1.25rem}.actions{display:grid;gap:.6rem;margin-top:var(--space-4)}button,.link-button{min-height:var(--control-height);padding:.65rem .8rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.secondary{border-color:var(--border-default);background:var(--surface-raised);color:var(--text-primary)}.controlled{border-color:var(--status-released);background:var(--status-released-bg);color:var(--status-released)}.link-button{text-align:center;text-decoration:none}.note{padding-top:var(--space-4);border-top:1px solid var(--color-border-subtle);line-height:1.5}.compact{grid-template-columns:1fr;margin-top:var(--space-4)}@media(max-width:820px){.layout{grid-template-columns:1fr}}@media(max-width:560px){.record-head{display:grid}.facts{grid-template-columns:1fr}dl{grid-template-columns:1fr}.panel{padding:var(--space-4)}}
</style>
