---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquarantine%2Freceiving%2Fnew');
const canCreate = actor.permissions.some((permission) => permission.code === 'PERM-QUAR-CREATE');
---
<AppLayout title="New Receiving Item · Quarantine" locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">T3 CONTROLLED INTAKE</p><h1>Create receiving item</h1><p class="lede">Register the material identity. The server assigns the initial PENDING state.</p></div><a href="/quarantine/receiving">Back to register</a></section>
  {canCreate ? <form class="form" method="post" data-action="quarantine.createReceiving"><fieldset><legend>Receiving identification</legend><div class="fields"><label>Receiving ID<input name="receivingNo" required /></label><label>Document number<input name="docNo" required /></label></div></fieldset><fieldset><legend>Item and lot</legend><div class="fields"><label>Item code<input name="itemCode" required /></label><label>Lot / batch<input name="lot" required /></label><label class="wide">Description<textarea name="description" required></textarea></label></div></fieldset><fieldset><legend>Quantity and context</legend><div class="fields"><label>Quantity<input name="qty" type="number" min="0" step="any" required /></label><label>Receiving date<input name="receivingDate" type="date" required /></label><label>Expiry date<input name="expiryDate" type="date" /></label></div></fieldset><div class="actions"><a class="secondary" href="/quarantine/receiving">Cancel</a><button type="submit">Create receiving item</button></div></form> : <section class="denied" role="alert"><h2>Creation is not available</h2><p>Your account does not have the explicit Quarantine create permission.</p></section>}
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  const form = document.querySelector<HTMLFormElement>('[data-action="quarantine.createReceiving"]');
  form?.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(form); const result = await actions.quarantine.createReceiving({ receivingNo: String(data.get('receivingNo')), docNo: String(data.get('docNo')), itemCode: String(data.get('itemCode')), description: String(data.get('description')), lot: String(data.get('lot')), qty: String(data.get('qty')), receivingDate: new Date(String(data.get('receivingDate'))), expiryDate: data.get('expiryDate') ? new Date(String(data.get('expiryDate'))) : undefined }); if (result.data) window.location.href = `/quarantine/receiving/${result.data.id}`; else form.setAttribute('aria-invalid', 'true'); });
</script>
<style>
  .page-head{display:flex;justify-content:space-between;gap:var(--space-5);align-items:flex-start;margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.denied p{color:var(--text-muted);font-size:.85rem}.page-head a{color:var(--color-accent-primary-hover)}.form{max-width:900px;display:grid;gap:var(--space-5)}fieldset{display:grid;gap:var(--space-4);padding:var(--space-5);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);background:var(--surface-panel)}legend{padding-inline:.5rem;color:var(--text-primary);font-weight:700}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.82rem}.wide{grid-column:1/-1}input,textarea{width:100%;min-height:var(--control-height);padding:.65rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}textarea{min-height:7rem;resize:vertical}.actions{display:flex;justify-content:flex-end;gap:var(--space-3)}button{min-height:var(--control-height);padding-inline:1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font-weight:700}.secondary{border-color:var(--border-default);background:var(--surface-raised);color:var(--text-primary)}.denied{padding:var(--space-6);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}@media(max-width:650px){.page-head{display:grid}.fields{grid-template-columns:1fr}.wide{grid-column:auto}.actions{justify-content:stretch;display:grid}}
</style>
