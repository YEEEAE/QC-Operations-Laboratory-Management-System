---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { receivingReadDependencies } from '../../../modules/quarantine/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquarantine%2Freceiving');
const states = ['PENDING','READY_FOR_INSPECTION','UNDER_INSPECTION','INSPECTION_COMPLETE','RELEASE_PENDING','RELEASED','HOLD','EXPIRED','CANCELLED'] as const;
const requested = Astro.url.searchParams.get('state');
const state = states.find((value) => value === requested);
let items: Awaited<ReturnType<typeof receivingReadDependencies>['list']['execute']> = [];
try { items = await receivingReadDependencies().list.execute({ actor, state }); } catch { /* safe empty state */ }
---
<AppLayout title="Receiving Items · Quarantine" locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">T2 OPERATIONAL WORK QUEUE</p><h1>Receiving items</h1><p class="lede">Review authorized receiving records and their separate inspection and release facts.</p></div><a class="button" href="/quarantine/receiving/new">Create receiving item</a></section>
  <form class="filters" method="get"><label for="state">Receiving state<select id="state" name="state"><option value="">All states</option>{states.map((value) => <option value={value} selected={state === value}>{value}</option>)}</select></label><button class="button secondary" type="submit">Apply filter</button></form>
  {items.length ? <div class="table-wrap"><table><caption>{items.length} authorized receiving item{items.length === 1 ? '' : 's'}</caption><thead><tr><th scope="col">Receiving ID</th><th scope="col">Item / description</th><th scope="col">Lot</th><th scope="col">Quantity</th><th scope="col">Receiving state</th><th scope="col">Inspection result</th><th scope="col">Release state</th></tr></thead><tbody>{items.map((item) => <tr><th scope="row"><a href={`/quarantine/receiving/${item.id}`}>{item.receivingNo}</a></th><td>{item.itemCode} · {item.description}</td><td>{item.lot}</td><td>{item.qty}</td><td><span class="state-pill">{item.workflowState}</span></td><td><span class:list={['result', item.inspectionResult.toLowerCase()]}>{item.inspectionResult}</span></td><td><span class:list={['release', { yes: item.releaseSystem }]}>{item.releaseSystem ? 'RELEASED' : 'NOT_RELEASED'}</span></td></tr>)}</tbody></table></div> : <section class="empty-state"><p class="eyebrow">NO MATCHES</p><h2>No receiving items in this view</h2><p>Your authorized scope has no records matching the selected state.</p><a href="/quarantine/receiving/new">Create a receiving item</a></section>}
</AppLayout>
<style>
  .page-head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-5);margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.empty-state p{color:var(--text-muted);font-size:.85rem}.button{display:inline-flex;align-items:center;justify-content:center;min-height:var(--control-height);padding-inline:1rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:var(--color-text-inverse);font-weight:700;text-decoration:none}.button.secondary{background:var(--surface-raised);border-color:var(--border-default);color:var(--text-primary)}.filters{display:flex;align-items:end;gap:var(--space-3);margin-bottom:var(--space-5)}label{display:grid;gap:.35rem;color:var(--text-secondary);font-size:.8rem}select{min-height:var(--control-height);padding-inline:.7rem;background:var(--surface-panel);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit}.table-wrap{overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:880px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted);font-size:.8rem}th,td{padding:.85rem;border-top:1px solid var(--color-border-subtle);text-align:start;font-size:.8rem}th{font-weight:700}a{color:var(--color-accent-primary-hover)}.state-pill,.result,.release{display:inline-flex;padding:.25rem .5rem;border-radius:999px;border:1px solid var(--color-border-subtle);font-size:.7rem;font-weight:700}.result.pass{color:var(--status-pass);background:var(--status-pass-bg)}.result.fail,.result.hold{color:var(--status-danger);background:var(--status-danger-bg)}.result.not_started,.result.in_progress{color:var(--text-muted)}.release{color:var(--text-muted)}.release.yes{color:var(--status-released);background:var(--status-released-bg);border-color:var(--status-released)}.empty-state{padding:3rem 1.5rem;text-align:center;background:var(--surface-panel);border:1px dashed var(--color-border-strong);border-radius:var(--radius-lg)}.empty-state h2{margin:.5rem 0}.empty-state a{font-weight:700}@media(max-width:650px){.page-head,.filters{display:grid}.button{width:max-content}}
</style>
