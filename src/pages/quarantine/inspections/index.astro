---
import PageHeader from '../../../ui/components/PageHeader.astro';
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import Pagination from '../../../ui/components/data/Pagination.astro';
import ProviderUnavailableState from '../../../ui/components/feedback/ProviderUnavailableState.astro';
import AppliedFilters from '../../../ui/components/data/AppliedFilters.astro';
import { inspectionReadDependencies } from '../../../modules/quarantine/application/dependencies.js';
import { FINAL_RESULTS } from '../../../modules/quarantine/inspection/application/inspection-result-options.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { identityAdminReadDependencies } from '../../../modules/identity/application/admin-dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquarantine%2Finspections');
const states = ['DRAFT', 'SUBMITTED', 'UNDER_REVIEW', 'PENDING_QCM_APPROVAL', 'RETURNED', 'APPROVED', 'REJECTED', 'VOID'] as const;
const params = Astro.url.searchParams;
const requestedState = params.get('state') ?? params.get('workflowState');
const stateParam = params.has('state') ? 'state' : params.has('workflowState') ? 'workflowState' : 'state';
const state = states.find((value) => value === requestedState);
const requestedResult = params.get('finalResult') ?? params.get('inspectionResult');
const finalResult = FINAL_RESULTS.find((value) => value === requestedResult);
// Ownership is the same dimension the dashboard KPIs count, so a personal KPI
// drill-down lands on exactly its own set instead of the whole authorized scope.
const ownership = params.get('ownership') === 'mine' ? ('mine' as const) : undefined;

const chipHref = (drop: string) => {
  const next = new URLSearchParams(params);
  next.delete(drop);
  next.delete('page');
  const search = next.toString();
  return `/quarantine/inspections${search ? `?${search}` : ''}`;
};
const appliedFilters = [
  state && { label: 'Workflow state', value: stateLabel(state), href: chipHref(stateParam) },
  finalResult && {
    label: 'Inspection result',
    value: stateLabel(finalResult),
    href: chipHref('finalResult'),
  },
  ownership && { label: 'Ownership', value: 'Only mine', href: chipHref('ownership') },
].filter((chip): chip is { label: string; value: string; href: string } => Boolean(chip));
const hasFilters = appliedFilters.length > 0;

// The register names the inspector, never a raw account identifier. Resolution
// is presentation-only and failure-tolerant.
let inspectorNames = new Map<string, string>();
const inspectorLabel = (inspectorId: string | null | undefined) =>
  inspectorId ? (inspectorNames.get(inspectorId) ?? 'Named account') : 'Not recorded';

let inspections: Awaited<ReturnType<ReturnType<typeof inspectionReadDependencies>['list']['execute']>> = [];
let providerUnavailable = false;
let page = 1;
let total = 0;
let pageSize = 25;
try {
  const result = await inspectionReadDependencies().list.executePage({
    actor,
    state,
    finalResult,
    ownership,
    page: { page: params.get('page') ?? 1, pageSize },
  });
  inspections = result.items;
  ({ page, total, pageSize } = result);
  inspectorNames = new Map(await identityAdminReadDependencies().listUsers.resolveDisplayNames({ actor, userIds: inspections.map((inspection) => inspection.authorId) }).catch(() => new Map<string, string>()));
} catch {
  providerUnavailable = true;
}
---
<AppLayout title="Inspections · Quarantine" locale="en" direction="ltr">
  <div class="inspections-register">
  <PageHeader purpose="Report status and scientific result are shown separately.">
    <Fragment slot="heading"><h1>Inspection reports</h1></Fragment>
    <Fragment slot="actions"><a href="/quarantine/receiving">Open receiving register</a></Fragment>
  </PageHeader>
  <section class="filter-panel" aria-label="Inspection filters">
  <form class="filters" method="get" role="search" aria-label="Filter inspection reports">
    <label for="state">Workflow state<select id="state" name="state">
        <option value="">All states</option>
        {states.map((value) => (
          <option value={value} selected={state === value}>
            {stateLabel(value)}
          </option>
        ))}
      </select></label>
    <label for="finalResult">Inspection result<select id="finalResult" name="finalResult">
        <option value="">All results</option>
        {FINAL_RESULTS.map((value) => (
          <option value={value} selected={finalResult === value}>
            {stateLabel(value)}
          </option>
        ))}
      </select></label>
    <label for="ownership">Ownership<select id="ownership" name="ownership">
        <option value="">All records</option>
        <option value="mine" selected={ownership === 'mine'}>Only mine</option>
      </select></label>
    <button type="submit">Apply filters</button>
  </form>
  <AppliedFilters
    filters={appliedFilters}
    clearHref={hasFilters ? '/quarantine/inspections' : undefined}
  />
  </section>
  {/* READ and FILTER use the server read and native GET contract. EXPORT and
      mutation pending states are N/A: this register has no export or mutation.
      AUTH has a login redirect; read failures currently share the provider
      fallback (pre-existing classification debt, outside presentation scope). */}
  {!providerUnavailable && (
    <p class="register-count" role="status">
      <strong>{total}</strong> inspection report{total === 1 ? '' : 's'}
      {hasFilters ? ' matching the current filters' : ' in your authorized scope'}.
    </p>
  )}
  {
    providerUnavailable ? (
      <ProviderUnavailableState title="Inspection data is temporarily unavailable" />
    ) : inspections.length ? (
      <div class="table-wrap" role="region" aria-label="Inspection reports" tabindex="0">
        <table>
          <caption>
            Inspection reports — workflow state and inspection result
          </caption>
          <thead>
            <tr>
              <th scope="col">Inspection number</th>
              <th scope="col">Receiving item</th>
              <th scope="col">Inspector</th>
              <th scope="col">Workflow state</th>
              <th scope="col">Inspection result</th>
            </tr>
          </thead>
          <tbody>
            {inspections.map((inspection) => (
              <tr>
                <th scope="row">
                  <a href={`/quarantine/inspections/${inspection.id}`}>{inspection.inspectionNo}</a>
                </th>
                <td>
                  {inspection.receiving.receivingNo} · {inspection.receiving.itemCode}
                </td>
                <td>{inspectorLabel(inspection.authorId)}</td>
                <td>
                  <span class="state">{stateLabel(inspection.state)}</span>
                </td>
                <td>{inspection.finalResult ? stateLabel(inspection.finalResult) : 'Not determined'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <section class="empty">
        <h2>{hasFilters ? 'No inspection reports match these filters' : 'No inspection reports yet'}</h2>
        <p>
          {hasFilters
            ? 'Nothing in your authorized scope matches the filters above. Remove a filter to widen the search.'
            : 'Reports appear here once an inspector starts work from a receiving item.'}
        </p>
        {hasFilters ? (
          <a href="/quarantine/inspections">Clear all filters</a>
        ) : (
          <a href="/quarantine/receiving">Open the receiving register</a>
        )}
      </section>
    )
  }
  {!providerUnavailable && <Pagination page={page} totalPages={Math.max(1, Math.ceil(total / pageSize))} />}
  </div>
</AppLayout>
<style>
  .inspections-register { display: grid; gap: var(--space-5); min-inline-size: 0; inline-size: 100%; }
  .filter-panel { padding: var(--space-5); background: var(--surface-panel); border: 1px solid var(--border-default); border-radius: var(--radius-lg); min-inline-size: 0; }
  .filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; align-items: end; gap: var(--space-4); }
  label { display: grid; gap: var(--space-2); min-inline-size: 0; color: var(--text-secondary); font-size: var(--font-size-sm); }
  select, button { min-block-size: max(var(--control-height), 44px); min-inline-size: 0; max-inline-size: 100%; padding: .6rem .8rem; background: var(--surface-panel); border: 1px solid var(--border-default); border-radius: var(--radius-sm); color: var(--text-primary); font: inherit; }
  button { background: var(--color-accent-primary); border-color: var(--color-accent-primary); color: var(--text-on-accent); font-weight: 700; cursor: pointer; }
  a { color: var(--color-accent-primary-hover); }
  a:focus-visible, button:focus-visible, select:focus-visible, .table-wrap:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .filter-panel :global(.applied-filters) { margin-block: var(--space-4) 0; }
  .register-count { margin: 0; color: var(--text-secondary); font-size: var(--font-size-sm); font-variant-numeric: tabular-nums; }
  .register-count strong { color: var(--text-primary); }
  .table-wrap { min-inline-size: 0; max-inline-size: 100%; overflow-x: auto; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); }
  table { inline-size: 100%; min-inline-size: 900px; table-layout: fixed; border-collapse: collapse; background: var(--surface-panel); font-variant-numeric: tabular-nums; }
  caption { text-align: start; padding: var(--space-4); color: var(--text-secondary); font-size: var(--font-size-sm); }
  th, td { padding: var(--space-4); text-align: start; vertical-align: top; border-block-start: 1px solid var(--color-border-subtle); font-size: var(--font-size-sm); line-height: 1.6; white-space: normal; overflow-wrap: anywhere; }
  thead th { overflow-wrap: normal; }
  th:nth-child(1) { inline-size: 22%; }
  th:nth-child(2) { inline-size: 26%; }
  tbody th a { display: inline-flex; align-items: center; min-block-size: 44px; max-inline-size: 100%; text-decoration: underline; }
  .state { display: inline-block; max-inline-size: 100%; padding: .25rem .5rem; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); font-size: var(--font-size-xs); font-weight: 700; }
  .empty { padding: var(--space-8) var(--space-5); text-align: center; background: var(--surface-panel); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-lg); }
  .empty h2 { margin-block: 0 var(--space-3); }
  .empty p { color: var(--text-secondary); }
  .empty a { display: inline-flex; align-items: center; min-block-size: 44px; }
  @media (max-width: 900px) { .filters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .filters { grid-template-columns: minmax(0, 1fr); } .filter-panel { padding: var(--space-4); } }
</style>
