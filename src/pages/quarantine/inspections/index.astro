---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { inspectionReadDependencies } from '../../../modules/quarantine/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fquarantine%2Finspections');
const states = ['DRAFT','SUBMITTED','UNDER_REVIEW','RETURNED','APPROVED','REJECTED','VOID'] as const;
const requested = Astro.url.searchParams.get('state');
const state = states.find((value) => value === requested);
let inspections: Awaited<ReturnType<typeof inspectionReadDependencies>['list']['execute']> = [];
try { inspections = await inspectionReadDependencies().list.execute({ actor, state }); } catch { /* safe empty state */ }
---
<AppLayout title="Inspections · Quarantine" locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">T3 CONTROLLED EXECUTION</p><h1>Inspection reports</h1><p class="lede">Execute, submit, review, and approve inspection reports without collapsing lifecycle and result.</p></div><a href="/quarantine/receiving">Open receiving register</a></section>
  <form class="filters" method="get"><label for="state">Workflow state<select id="state" name="state"><option value="">All states</option>{states.map((value) => <option value={value} selected={state === value}>{value}</option>)}</select></label><button type="submit">Apply filter</button></form>
  {inspections.length ? <div class="table-wrap"><table><caption>{inspections.length} authorized inspection report{inspections.length === 1 ? '' : 's'}</caption><thead><tr><th scope="col">Inspection ID</th><th scope="col">Receiving item</th><th scope="col">Inspector</th><th scope="col">Workflow state</th><th scope="col">Inspection result</th><th scope="col">Version</th></tr></thead><tbody>{inspections.map((inspection) => <tr><th scope="row"><a href={`/quarantine/inspections/${inspection.id}`}>{inspection.inspectionNo}</a></th><td>{inspection.receiving.receivingNo} · {inspection.receiving.itemCode}</td><td>{inspection.authorId}</td><td><span class="state">{inspection.state}</span></td><td>{inspection.finalResult ?? 'Not determined'}</td><td>{inspection.version.toString()}</td></tr>)}</tbody></table></div> : <section class="empty"><p class="eyebrow">NO MATCHES</p><h2>No inspection reports in this view</h2><p>Reports appear here when created from an authorized receiving workflow.</p></section>}
</AppLayout>
<style>
  .page-head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-5);margin-bottom:var(--space-6)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.empty p{color:var(--text-muted);font-size:.85rem}.page-head a,a{color:var(--color-accent-primary-hover)}.filters{display:flex;align-items:end;gap:var(--space-3);margin-bottom:var(--space-5)}label{display:grid;gap:.35rem;color:var(--text-secondary);font-size:.8rem}select,button{min-height:var(--control-height);padding:.6rem .8rem;background:var(--surface-panel);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}button{background:var(--color-accent-primary);border-color:var(--color-accent-primary);color:#fff;font-weight:700}.table-wrap{overflow-x:auto;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}table{width:100%;min-width:760px;border-collapse:collapse;background:var(--surface-panel)}caption{text-align:start;padding:var(--space-4);color:var(--text-muted);font-size:.8rem}th,td{padding:.85rem;text-align:start;border-top:1px solid var(--color-border-subtle);font-size:.8rem}.state{padding:.25rem .5rem;border:1px solid var(--color-border-subtle);border-radius:999px;font-size:.7rem;font-weight:700}.empty{padding:3rem 1.5rem;text-align:center;background:var(--surface-panel);border:1px dashed var(--color-border-strong);border-radius:var(--radius-lg)}@media(max-width:650px){.page-head,.filters{display:grid}}
</style>
