---
import AppLayout from '../../../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../../../ui/components/StatusBadge.astro';
import { inspectionReadDependencies } from '../../../../modules/quarantine/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
let inspection: Awaited<ReturnType<typeof inspectionReadDependencies>['get']['execute']> | undefined;
try { inspection = await inspectionReadDependencies().get.execute({ actor, id: Astro.params.inspectionId ?? '' }); } catch { return Astro.redirect('/404'); }
if (!inspection) return Astro.redirect('/404');
const editable = inspection.state === 'DRAFT' || inspection.state === 'RETURNED';
---
<AppLayout title={`${inspection.inspectionNo} · Inspection`} locale="en" direction="ltr">
  <div class="crumb"><a href="/quarantine">Quarantine</a><span>/</span><a href="/quarantine/inspections">Inspection reports</a><span>/</span><span>{inspection.inspectionNo}</span></div>
  <section class="head"><div><p class="eyebrow">INSPECTION REPORT</p><h1>{inspection.inspectionNo}</h1><p class="lede">{inspection.receiving.receivingNo} · {inspection.receiving.itemCode} · Lot {inspection.receiving.lot}</p></div><div class="version">Version <strong>{inspection.version.toString()}</strong></div></section>
  <section class="facts"><div><span>Workflow state</span><strong>{inspection.state}</strong></div><div><span>Inspection result</span>{inspection.finalResult ? <StatusBadge status={inspection.finalResult} /> : <strong>Not determined</strong>}</div><div><span>Controlled template</span><strong>{inspection.template.versionNo}</strong></div></section>
  <section class="layout"><main><section class="panel"><h2>Receiving snapshot</h2><dl><div><dt>Receiving item</dt><dd>{inspection.receiving.receivingNo}</dd></div><div><dt>Item / lot</dt><dd>{inspection.receiving.itemCode} · {inspection.receiving.lot}</dd></div><div><dt>Quantity</dt><dd>{inspection.receiving.qty}</dd></div><div><dt>Template version</dt><dd>{inspection.template.versionNo} · {inspection.template.templateVersionId}</dd></div></dl></section><section class="panel"><h2>Inspection requirements and evidence</h2><p class="muted">The exact approved template context is retained with this report. Official PASS/FAIL/HOLD is not calculated or accepted by this read-only page.</p></section></main><aside class="rail"><section class="panel"><h2>Next workspace</h2><div class="actions">{editable ? <a class="button" href={`/quarantine/inspections/${inspection.id}/execute`}>Open execution</a> : null}{inspection.state === 'SUBMITTED' || inspection.state === 'UNDER_REVIEW' ? <a class="button controlled" href={`/quarantine/inspections/${inspection.id}/review`}>Open review</a> : null}{!editable && inspection.state !== 'SUBMITTED' && inspection.state !== 'UNDER_REVIEW' ? <p class="muted">This controlled state is read-only.</p> : null}</div></section><section class="panel"><h2>Record context</h2><dl class="compact"><div><dt>Author / executor</dt><dd>{inspection.authorId}</dd></div><div><dt>Created</dt><dd>{inspection.createdAt.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' })}</dd></div><div><dt>Version</dt><dd>{inspection.version.toString()}</dd></div></dl></section></aside></section>
</AppLayout>
<style>
  .crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a{color:var(--color-accent-primary-hover)}.head,.panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-5)}.head{margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.muted,.version{color:var(--text-muted);font-size:.84rem}.version{padding:.5rem .75rem;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3);margin-bottom:var(--space-5)}.facts>div,.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.facts>div{display:grid;gap:.45rem}.facts span,dt{color:var(--text-muted);font-size:.75rem}.layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:var(--space-5)}main,.rail{display:grid;gap:var(--space-5);align-content:start}.panel h2{margin:0;font-size:1rem}dl{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-4);margin:var(--space-5) 0 0}dd{margin:.3rem 0 0;font-weight:600}.compact{grid-template-columns:1fr}.actions{display:grid;gap:.6rem;margin-top:var(--space-4)}.button{display:flex;align-items:center;justify-content:center;min-height:var(--control-height);padding:.6rem .8rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font-weight:700;text-decoration:none}.button.controlled{border-color:var(--status-review);background:var(--status-review-bg);color:var(--text-primary)}@media(max-width:820px){.layout{grid-template-columns:1fr}}@media(max-width:560px){.head{display:grid}.facts{grid-template-columns:1fr}dl{grid-template-columns:1fr}.panel{padding:var(--space-4)}}
</style>
