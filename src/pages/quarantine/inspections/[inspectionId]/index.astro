---
import PageHeader from "../../../../ui/components/PageHeader.astro";
import ControlledInspectionForm from '../../../../ui/components/quarantine/ControlledInspectionForm.astro';
import { controlledFormSchema, type ControlledFormValues } from '../../../../modules/quarantine/inspection/application/save-controlled-form.js';
import { quarantineActionDependencies } from '../../../../modules/quarantine/application/dependencies.js';
import { assetsReadDependencies } from '../../../../modules/assets/application/dependencies.js';
import { authorize } from '../../../../shared/authorization/authorize.js';
import { readOutcome } from '../../../../shared/errors/read-outcome.js';
import { isAqlSamplingResult } from '../../../../modules/quarantine/inspection/application/inspection-aql-equipment.js';
import AppLayout from '../../../../ui/layouts/AppLayout.astro';
import { classifyReadFailure, providerUnavailableResponse } from '../../../../shared/errors/read-failure.js';
import StatusBadge from '../../../../ui/components/StatusBadge.astro';
import { inspectionReadDependencies } from '../../../../modules/quarantine/application/dependencies.js';
import { copy, stateLabel } from '../../../../shared/copy/ux-vocabulary.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
let inspection: Awaited<ReturnType<ReturnType<typeof inspectionReadDependencies>['get']['execute']>> | undefined;
try { inspection = await inspectionReadDependencies().get.execute({ actor, id: Astro.params.inspectionId ?? '' }); } catch (error) { if (classifyReadFailure(error) === 'UNAVAILABLE') return providerUnavailableResponse('Inspection details are temporarily unavailable', Astro.url.pathname + Astro.url.search); return Astro.redirect('/404'); }
if (!inspection) return Astro.redirect('/404');
const digitalPreview=controlledFormSchema.safeParse(inspection.template.templateSnapshot?.digitalForm);
const editable = inspection.state === 'DRAFT' || inspection.state === 'RETURNED';
const canEditDraft=inspection.state==='DRAFT' && authorize({actor,permission:'PERM-INSP-EDIT-DRAFT',action:'EDIT',entity:{type:'INSPECTION_REPORT',id:inspection.id,state:inspection.state,authorId:inspection.authorId,executorId:inspection.authorId},scope:{ownerId:inspection.authorId,assigneeId:inspection.assignedTo ?? inspection.authorId},currentVersion:inspection.version,expectedVersion:inspection.version,businessCondition:true}).allowed;
const equipmentResult=canEditDraft ? await readOutcome(()=>assetsReadDependencies().equipment.list.execute({actor,filter:{state:'ACTIVE'}})) : null;
const equipment=equipmentResult?.status==='AVAILABLE' ? equipmentResult.value.filter(e=>e.currentCalibrationId) : [];
const templateSnapshot = inspection.template.templateSnapshot;
const controlledSources = Array.isArray(templateSnapshot.controlledDocumentVersions)
  ? templateSnapshot.controlledDocumentVersions as Array<Record<string, unknown>>
  : [];
const templateSource = inspection.template.sourceDocument ?? (typeof templateSnapshot.sourceDocument === 'string' ? templateSnapshot.sourceDocument : undefined);
const templateHash = typeof templateSnapshot.contentHash === 'string' ? templateSnapshot.contentHash : undefined;
let metadataError:string|undefined;
if(Astro.request.method==='POST') {
 try {
  const data=await Astro.request.formData(); const text=(key:string)=>String(data.get(key) ?? '');
  if(!/^[1-9]\d{0,18}$/.test(text('expectedVersion')))throw new Error('Invalid version');
  const command={actor,id:inspection.id,expectedVersion:BigInt(text('expectedVersion')),requestId:Astro.locals.requestContext?.requestId ?? 'unknown'};
  if(text('intent')==='record-aql') {
   const samplingResult=text('samplingResult'); if(!isAqlSamplingResult(samplingResult))throw new Error('Invalid sampling result');
   await quarantineActionDependencies().inspection.recordAql.execute({...command,aql:{aql:text('aql'),codeLetter:text('codeLetter'),inspectionLevel:text('inspectionLevel'),sampleSize:text('sampleSize'),acceptNumber:text('acceptNumber'),rejectNumber:text('rejectNumber'),observedDefects:text('observedDefects'),samplingResult,sourceReference:text('sourceReference')}});
  } else if(text('intent')==='link-equipment') {
   const selected=equipment.find(e=>e.id===text('equipmentId'));if(!selected?.currentCalibrationId)throw new Error('No eligible equipment');
   await quarantineActionDependencies().inspection.linkEquipment.execute({...command,usage:{equipmentId:selected.id,calibrationRecordId:selected.currentCalibrationId}});
  } else throw new Error('Invalid action');
  return Astro.redirect(Astro.url.pathname,303);
 }catch{metadataError='The metadata action was not applied. Check source, permissions, calibration and current record version.';}
}

---
<AppLayout title={`${inspection.inspectionNo} · Inspection`} locale="en" direction="ltr">
  <div class="crumb"><a href="/quarantine">Quarantine</a><span aria-hidden="true">/</span><a href="/quarantine/inspections">Inspection reports</a><span aria-hidden="true">/</span><span>{inspection.inspectionNo}</span></div>
  <PageHeader><Fragment slot="heading"><h1>{inspection.inspectionNo}</h1></Fragment><p class="lede">{inspection.receiving.receivingNo} · {inspection.receiving.itemCode} · Lot {inspection.receiving.lot}</p><Fragment slot="actions"><div class="identity-state"><span>Workflow state</span><StatusBadge status={inspection.state as 'DRAFT'} label={stateLabel(inspection.state)} /></div><div class="version">Record version <strong>{inspection.version.toString()}</strong></div></Fragment></PageHeader>
  <section class="result-band" aria-label="Inspection result and release state">
    <div class="result-card"><span>Inspection result</span>{inspection.finalResult ? <StatusBadge status={inspection.finalResult} /> : <strong>{copy.states.notDetermined}</strong>}</div>
    <div class="result-card"><span>Release System State</span><strong>Not available in this inspection read model</strong><small>Inspection result is independent of receiving release status.</small></div>
  </section>
  <div class="layout">
    <main class="workspace-main">
      <section class="panel" id="facts"><div class="panel-heading"><div><p class="eyebrow">Record facts</p><h2>Receiving snapshot</h2></div></div><dl><div><dt>Receiving item</dt><dd><a href={`/quarantine/receiving/${inspection.receiving.receivingId}`}>{inspection.receiving.receivingNo}</a></dd></div><div><dt>Item code</dt><dd>{inspection.receiving.itemCode}</dd></div><div><dt>Description</dt><dd>{inspection.receiving.description}</dd></div><div><dt>Lot</dt><dd>{inspection.receiving.lot}</dd></div><div><dt>Quantity</dt><dd>{inspection.receiving.qty}{inspection.receiving.quantityUnit ? ` ${inspection.receiving.quantityUnit}` : ''}</dd></div><div><dt>Supplier</dt><dd>{inspection.receiving.supplier ?? 'Not recorded'}</dd></div><div><dt>Source document</dt><dd>{inspection.receiving.docNo}</dd></div><div><dt>Purchase order</dt><dd>{inspection.receiving.purchaseOrderNo ?? 'Not recorded'}</dd></div><div><dt>Receiving date</dt><dd>{inspection.receiving.receivingDate.toLocaleDateString('en-GB', { timeZone: 'Asia/Riyadh' })}</dd></div><div><dt>Expiry date</dt><dd>{inspection.receiving.expiryDate?.toLocaleDateString('en-GB', { timeZone: 'Asia/Riyadh' }) ?? 'Not recorded'}</dd></div><div><dt>Author</dt><dd>{inspection.authorId}</dd></div><div><dt>Assigned to</dt><dd>{inspection.assignedTo ?? 'Not assigned'}</dd></div></dl></section>
      <section class="panel" id="evidence"><div class="panel-heading"><div><p class="eyebrow">Evidence</p><h2>Controlled template and source</h2></div></div><dl><div><dt>Template</dt><dd>{inspection.template.templateId}</dd></div><div><dt>Template version</dt><dd>{inspection.template.versionNo} · {inspection.template.templateVersionId}</dd></div><div><dt>Template source</dt><dd>{templateSource ?? 'Not recorded'}</dd></div><div><dt>Template content hash</dt><dd class="long-value">{templateHash ?? 'Not included in the inspection read model'}</dd></div></dl>
        <div class="evidence-list"><h3>Controlled document versions used</h3>{controlledSources.length ? <ul>{controlledSources.map(source => <li><strong>{String(source.documentNo ?? source.title ?? 'Controlled source')}</strong><span>{String(source.revision ?? 'Revision not recorded')} · {String(source.usageType ?? 'Use not recorded')} · effective {String(source.effectiveAt ?? 'date not recorded')}</span><span class="long-value">Document SHA-256: {String(source.contentHash ?? 'Not recorded')} · source file digest: {String(source.sourceFileDigest ?? 'Not recorded')}</span>{typeof source.documentId === 'string' && typeof source.documentVersionId === 'string' ? <a href={`/documents/${encodeURIComponent(source.documentId)}/versions/${encodeURIComponent(source.documentVersionId)}`}>View WI used for this record</a> : <span>Source unavailable for verification</span>}<span>Source file download is unavailable in this application configuration.</span></li>)}</ul> : <p class="muted">Source unavailable for verification — this record has no bound controlled document version snapshot.</p>}</div>
        <div class="evidence-count"><span>Linked evidence items</span><strong>{inspection.evidenceCount ?? 0}</strong><small>File identities and descriptions are N/A; this read model exposes only the active-link count.</small></div>
      </section>
      <section class="panel" id="sampling"><div class="panel-heading"><div><p class="eyebrow">Evidence</p><h2>Sampling record</h2></div></div><p class="muted">N/A — the current inspection read model does not expose the saved AQL fields. Sampling entry remains available below for an eligible draft.</p></section>
      <section class="panel" id="history"><div class="panel-heading"><div><p class="eyebrow">History</p><h2>Record lifecycle</h2></div></div><dl><div><dt>Created</dt><dd>{inspection.createdAt.toLocaleString('en-GB', { timeZone: 'Asia/Riyadh' })}</dd></div><div><dt>Last updated</dt><dd>{inspection.updatedAt.toLocaleString('en-GB', { timeZone: 'Asia/Riyadh' })}</dd></div><div><dt>Submitted</dt><dd>{inspection.submittedAt?.toLocaleString('en-GB', { timeZone: 'Asia/Riyadh' }) ?? 'Not recorded'}</dd></div><div><dt>Audit history</dt><dd>N/A — no record-history projection is exposed by this page read.</dd></div></dl></section>
      <section class="panel" id="relationships"><div class="panel-heading"><div><p class="eyebrow">Relationships</p><h2>Related records</h2></div></div><ul class="relationships"><li><span>Receiving item</span><a href={`/quarantine/receiving/${inspection.receiving.receivingId}`}>{inspection.receiving.receivingNo} · {inspection.receiving.itemCode}</a></li><li><span>Inspection execution</span><a href={`/quarantine/inspections/${inspection.id}/execute`}>Open execution workspace</a></li>{inspection.state === 'SUBMITTED' || inspection.state === 'UNDER_REVIEW' ? <li><span>Inspection review</span><a href={`/quarantine/inspections/${inspection.id}/review`}>Open review workspace</a></li> : null}<li><span>Equipment usage details</span><span>N/A — usage snapshots are not included in this page read.</span></li></ul></section>
      {digitalPreview.success && <section class="form-section" id="controlled-form"><div class="section-intro"><p class="eyebrow">Controlled record</p><h2>Inspection form snapshot</h2><p class="muted">This is the preserved form and its recorded values. Editing is handled in the execution workspace.</p></div><ControlledInspectionForm schema={digitalPreview.data} values={(inspection.formValues as ControlledFormValues | undefined) ?? {headers:{},points:{}}} receiving={{...inspection.receiving}} editable={false} canSubmit={false} inspectionId={inspection.id} version={inspection.version.toString()} /></section>}
    </main>
    <aside class="rail" aria-label="Inspection actions">
      <section class="panel" id="actions"><div class="panel-heading"><div><p class="eyebrow">Actions</p><h2>Current workspaces</h2></div></div><div class="actions">{editable ? <a class="button" href={`/quarantine/inspections/${inspection.id}/execute`}>Open execution</a> : null}{inspection.state === 'SUBMITTED' || inspection.state === 'UNDER_REVIEW' ? <a class="button controlled" href={`/quarantine/inspections/${inspection.id}/review`}>Open review</a> : null}{!editable && inspection.state !== 'SUBMITTED' && inspection.state !== 'UNDER_REVIEW' ? <p class="muted">{copy.states.readOnly}</p> : null}</div><p class="boundary-note">Inspection approval does not release the receiving item or remove a HOLD.</p></section>
      <section class="panel"><div class="panel-heading"><div><p class="eyebrow">Related evidence</p><h2>Equipment and calibration</h2></div></div><p class="muted">Existing usage snapshots are not exposed by this page read. N/A.</p>{canEditDraft && digitalPreview.success && <form method="post" class="action-form"><input type="hidden" name="intent" value="link-equipment"/><input type="hidden" name="expectedVersion" value={inspection.version.toString()}/><label for="equipmentId">Equipment</label><select id="equipmentId" name="equipmentId" required><option value="">Choose controlled equipment…</option>{equipment.map(e=><option value={e.id}>{e.equipmentNo} · {e.name}</option>)}</select>{equipmentResult?.status==='UNAVAILABLE' ? <p role="status">Equipment is temporarily unavailable; linking is unavailable and the inspection record is unchanged.</p> : !equipment.length ? <p class="muted">No equipment with a current calibration is visible to this account.</p> : <button type="submit">Link current calibration evidence</button>}<p class="muted">Eligibility, calibration and certificate are verified and captured by the server.</p></form>}</section>
      <section class="panel"><div class="panel-heading"><div><p class="eyebrow">Record context</p><h2>Provenance</h2></div></div><dl class="compact"><div><dt>Author / executor</dt><dd>{inspection.authorId}</dd></div><div><dt>Created</dt><dd>{inspection.createdAt.toLocaleString('en-GB', { timeZone: 'Asia/Riyadh' })}</dd></div><div><dt>Updated</dt><dd>{inspection.updatedAt.toLocaleString('en-GB', { timeZone: 'Asia/Riyadh' })}</dd></div><div><dt>Record version</dt><dd>{inspection.version.toString()}</dd></div></dl></section>
    </aside>
  </div>
  {canEditDraft && digitalPreview.success && <section class="panel sampling-entry" id="sampling-entry"><div class="panel-heading"><div><p class="eyebrow">Draft-only entry</p><h2>Record sampling facts</h2></div></div><form method="post" class="entry-form"><input type="hidden" name="intent" value="record-aql"/><input type="hidden" name="expectedVersion" value={inspection.version.toString()}/><p class="muted">Enter the supplied sampling facts and approved source reference. This page does not calculate sampling values.</p>{['aql','codeLetter','inspectionLevel','sampleSize','acceptNumber','rejectNumber','observedDefects','sourceReference'].map(key=><label for={`aql-${key}`}>{key}<input id={`aql-${key}`} name={key} maxlength="200" required={['aql','sampleSize','acceptNumber','rejectNumber','sourceReference'].includes(key)}/></label>)}<label for="samplingResult">Sampling result<select id="samplingResult" name="samplingResult" required><option value="">Choose…</option><option value="ACCEPT">Accept</option><option value="REJECT">Reject</option><option value="NOT_APPLICABLE">Not applicable</option></select></label><button type="submit">Record sampling</button></form></section>}
  <div class="feedback">{metadataError && <p role="alert">{metadataError}</p>}</div>
</AppLayout>
<style>
  .crumb{display:flex;flex-wrap:wrap;gap:.5rem;margin-block-end:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a{color:var(--color-accent-primary-hover);min-block-size:44px;display:inline-flex;align-items:center}.lede,.muted,.version{color:var(--text-muted);font-size:.84rem}.version,.identity-state{display:grid;gap:.35rem;align-content:center;padding:.5rem .75rem;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}.identity-state>span,.result-card>span,dt{color:var(--text-muted);font-size:.75rem}.result-band{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-3);margin-block-end:var(--space-5)}.result-card,.panel{min-inline-size:0;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.result-card{display:grid;gap:.45rem;align-content:start}.result-card small,.evidence-count small{color:var(--text-muted);font-size:.75rem}.layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,320px);gap:var(--space-5);align-items:start}.workspace-main,.rail{display:grid;gap:var(--space-5);align-content:start;min-inline-size:0}.panel-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-4);min-inline-size:0}.eyebrow{margin:0 0 .35rem;color:var(--text-muted);font-size:var(--font-size-xs);font-weight:700}.panel h2,.section-intro h2{margin:0;font-size:1rem}.panel h3{margin-block:var(--space-5) var(--space-2);font-size:.9rem}dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin:var(--space-5) 0 0;min-inline-size:0}dl>div{min-inline-size:0}dd{margin:.3rem 0 0;font-weight:600;overflow-wrap:anywhere}.long-value{overflow-wrap:anywhere;word-break:break-word}.compact{grid-template-columns:1fr}.actions{display:grid;gap:.6rem;margin-block-start:var(--space-4)}.button,.action-form button,.entry-form button{display:flex;align-items:center;justify-content:center;min-block-size:max(var(--control-height),44px);padding:.6rem .8rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:var(--text-on-accent);font:inherit;font-weight:700;text-decoration:none;cursor:pointer}.button.controlled{border-color:var(--status-review);background:var(--status-review-bg);color:var(--text-primary)}.boundary-note{padding:.8rem;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm);background:var(--status-warning-bg);font-size:.82rem}.relationships{display:grid;gap:.75rem;margin-block:var(--space-4) 0;padding-inline-start:1.2rem}.relationships li{padding-inline-start:.25rem}.relationships li>span{display:block;color:var(--text-muted);font-size:.78rem}.relationships li a{display:inline-flex;align-items:center;min-block-size:44px;overflow-wrap:anywhere}.evidence-list ul{display:grid;gap:.5rem;padding-inline-start:1.2rem}.evidence-list li{overflow-wrap:anywhere}.evidence-list li span{display:block}.evidence-count{display:grid;gap:.3rem;margin-block-start:var(--space-4);padding-block-start:var(--space-4);border-block-start:1px solid var(--color-border-subtle)}.form-section{display:grid;gap:var(--space-4);min-inline-size:0}.section-intro{max-inline-size:72ch}.sampling-entry{margin-block-start:var(--space-5)}.entry-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-3);margin-block-start:var(--space-4)}.entry-form>p{grid-column:1/-1}.entry-form label,.action-form label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.85rem}.entry-form input,.entry-form select,.action-form select{box-sizing:border-box;inline-size:100%;min-block-size:44px;padding:.6rem;background:var(--surface-raised);color:var(--text-primary);border:1px solid var(--border-default);font:inherit}.entry-form button{justify-self:start}.action-form{display:grid;gap:.75rem;margin-block-start:var(--space-4)}.action-form select{min-inline-size:0}.inline-error{color:var(--status-danger)}.feedback{margin-block-start:var(--space-4)}.feedback:empty{display:none}.feedback [role=alert]{color:var(--status-danger)}@media(max-width:900px){.layout{grid-template-columns:1fr}}@media(max-width:700px){.result-band{grid-template-columns:1fr}dl{grid-template-columns:1fr}.entry-form{grid-template-columns:1fr}.entry-form>p{grid-column:auto}.panel{padding:var(--space-4)}}
</style>
