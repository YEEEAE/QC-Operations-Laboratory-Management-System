---
import AppLayout from '../../../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../../../ui/components/StatusBadge.astro';
import { inspectionReadDependencies } from '../../../../modules/quarantine/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
let inspection: Awaited<ReturnType<typeof inspectionReadDependencies>['get']['execute']> | undefined;
try { inspection = await inspectionReadDependencies().get.execute({ actor, id: Astro.params.inspectionId ?? '' }); } catch { return Astro.redirect('/404'); }
if (!inspection) return Astro.redirect('/404');
const canReview = actor.permissions.some((permission) => permission.code === 'PERM-INSP-REVIEW' && permission.active !== false) && actor.permissions.some((permission) => permission.code === 'PERM-APR-REVIEW' && permission.active !== false);
const canApprove = actor.permissions.some((permission) => permission.code === 'PERM-INSP-APPROVE' && permission.active !== false && actor.permissions.some((p) => p.code === 'PERM-APR-APPROVE' && p.active !== false));
---
<AppLayout title={`${inspection.inspectionNo} · Review`} locale="en" direction="ltr">
  <div class="crumb"><a href="/quarantine">Quarantine</a><span>/</span><a href="/quarantine/inspections">Inspection reports</a><span>/</span><span>Review</span></div>
  <section class="head"><div><p class="eyebrow">T5 APPROVAL / REVIEW WORKSPACE</p><h1>Review inspection</h1><p class="lede">Independent review of {inspection.inspectionNo} for {inspection.receiving.receivingNo}.</p></div><div class="version">Version being reviewed <strong>{inspection.version.toString()}</strong></div></section>
  {!canReview ? <section class="readonly" role="alert"><strong>Review is not available.</strong><span>This workspace does not grant review authority to your account.</span></section> : null}
  <div class="review-grid" data-inspection-id={inspection.id} data-version={inspection.version.toString()}><main><section class="panel"><div class="panel-head"><h2>Inspection snapshot</h2>{inspection.finalResult ? <StatusBadge status={inspection.finalResult} /> : <span class="muted">Result not determined</span>}</div><dl><div><dt>Workflow state</dt><dd>{inspection.state}</dd></div><div><dt>Author / executor</dt><dd>{inspection.authorId}</dd></div><div><dt>Receiving item</dt><dd>{inspection.receiving.receivingNo} · {inspection.receiving.itemCode}</dd></div><div><dt>Template</dt><dd>{inspection.template.versionNo} · approved context</dd></div></dl></section><section class="panel"><h2>Measurements and criteria</h2><p class="muted">Review the preserved controlled context and evidence. Official outcome requires the approved deterministic source gate on the server.</p><div class="evidence-row"><span>Recorded points</span><strong>{inspection.results.length}</strong></div></section><section class="panel"><h2>Previous submission / return history</h2><p class="muted">Prior controlled actions remain in audit history; no return or approval erases the submission path.</p></section></main><aside><section class="panel decision"><h2>Decision rail</h2><p class="muted">Opening review does not grant approval. Each action re-checks scope, current version, SoD, and permission.</p>{inspection.state === 'SUBMITTED' && canReview ? <button data-action="quarantine.reviewInspection">Begin review</button> : null}{inspection.state === 'UNDER_REVIEW' && canApprove ? <button class="controlled" data-action="quarantine.approveInspection">Approve inspection</button> : null}{inspection.state === 'SUBMITTED' || inspection.state === 'UNDER_REVIEW' ? <form method="post" data-action="quarantine.returnInspection"><label>Return reason<textarea name="reason" required></textarea></label><button class="secondary" type="submit">Return for correction</button></form> : null}<p class="note">Approval remains blocked when source/policy evidence is not approved. PASS is never a release command.</p></section></aside></div>
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  const context = document.querySelector<HTMLElement>('[data-inspection-id]');
  const inspectionId = context?.dataset.inspectionId ?? '';
  const version = context?.dataset.version ?? '0';
  document.querySelectorAll<HTMLElement>('[data-action="quarantine.reviewInspection"]').forEach((button) => button.addEventListener('click', async () => { const result = await actions.quarantine.reviewInspection({ id: inspectionId, expectedVersion: BigInt(version) }); if (!result.error) window.location.reload(); else window.alert('Review was not started. Refresh and review the current state.'); }));
  document.querySelectorAll<HTMLElement>('[data-action="quarantine.approveInspection"]').forEach((button) => button.addEventListener('click', async () => { const result = await actions.quarantine.approveInspection({ id: inspectionId, expectedVersion: BigInt(version) }); if (!result.error) window.location.reload(); else window.alert('Approval was not applied. Approved policy/source evidence may be unavailable.'); }));
  document.querySelectorAll<HTMLFormElement>('[data-action="quarantine.returnInspection"]').forEach((form) => form.addEventListener('submit', async (event) => { event.preventDefault(); const reason = new FormData(form).get('reason'); const result = await actions.quarantine.returnInspection({ id: inspectionId, expectedVersion: BigInt(version), reason: String(reason ?? '') }); if (!result.error) window.location.reload(); else window.alert('Return was not applied. Refresh and review the current state.'); }));
</script>
<style>
  .crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a{color:var(--color-accent-primary-hover)}.head,.panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-5)}.head{margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.muted,.version,.readonly span{color:var(--text-muted);font-size:.84rem}.version{padding:.5rem .75rem;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}.readonly{display:grid;gap:.25rem;margin-bottom:var(--space-5);padding:var(--space-4);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}.review-grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:var(--space-5)}main,aside{display:grid;gap:var(--space-5);align-content:start}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}h2{margin:0;font-size:1rem}dl{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-4);margin:var(--space-5) 0 0}dt{color:var(--text-muted);font-size:.75rem}dd{margin:.3rem 0 0;font-weight:600}.evidence-row{display:flex;justify-content:space-between;margin-top:var(--space-5);padding:var(--space-4);background:var(--surface-raised);border-radius:var(--radius-md)}button{width:100%;min-height:var(--control-height);padding:.6rem .8rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.controlled{border-color:var(--status-review);background:var(--status-review-bg);color:var(--text-primary)}.secondary{border-color:var(--border-default);background:var(--surface-raised);color:var(--text-primary)}form{display:grid;gap:.6rem;margin-top:var(--space-3)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.8rem}textarea{min-height:6rem;padding:.6rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.note{padding-top:var(--space-4);border-top:1px solid var(--color-border-subtle);line-height:1.5}@media(max-width:820px){.review-grid{grid-template-columns:1fr}}@media(max-width:560px){.head{display:grid}dl{grid-template-columns:1fr}.panel{padding:var(--space-4)}}
</style>
