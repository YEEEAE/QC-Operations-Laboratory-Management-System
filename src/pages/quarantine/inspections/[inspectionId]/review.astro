---
import AppLayout from '../../../../ui/layouts/AppLayout.astro';
import StatusBadge from '../../../../ui/components/StatusBadge.astro';
import JourneyContextPanel from '../../../../ui/components/workflow/JourneyContextPanel.astro';
import { inspectionReadDependencies } from '../../../../modules/quarantine/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
let inspection: Awaited<ReturnType<ReturnType<typeof inspectionReadDependencies>['get']['execute']>> | undefined;
try { inspection = await inspectionReadDependencies().get.execute({ actor, id: Astro.params.inspectionId ?? '' }); } catch { return Astro.redirect('/404'); }
if (!inspection) return Astro.redirect('/404');
const canReview = actor.permissions.some((permission) => permission.code === 'PERM-INSP-REVIEW' && permission.active !== false) && actor.permissions.some((permission) => permission.code === 'PERM-APR-REVIEW' && permission.active !== false);
const canApprove = actor.permissions.some((permission) => permission.code === 'PERM-INSP-APPROVE' && permission.active !== false && actor.permissions.some((p) => p.code === 'PERM-APR-APPROVE' && p.active !== false));
const canReturn = actor.permissions.some((permission) => permission.code === 'PERM-INSP-RETURN' && permission.active !== false) && actor.permissions.some((permission) => permission.code === 'PERM-APR-RETURN' && permission.active !== false);
---
<AppLayout title={`${inspection.inspectionNo} · Review`} locale="en" direction="ltr">
  <div class="crumb"><a href="/quarantine">Quarantine</a><span>/</span><a href="/quarantine/inspections">Inspection reports</a><span>/</span><span>Review</span></div>
  <section class="head"><div><p class="eyebrow">T5 APPROVAL / REVIEW WORKSPACE</p><h1>Review inspection</h1><p class="lede">Independent review of {inspection.inspectionNo} for {inspection.receiving.receivingNo}.</p></div><div class="version">Version being reviewed <strong>{inspection.version.toString()}</strong></div></section>
  {!canReview ? <section class="readonly" role="alert"><strong>Review is not available.</strong><span>This workspace does not grant review authority to your account. The record remains readable; no action is implied by visibility.</span></section> : null}
  <JourneyContextPanel ownerDomain="Quarantine / Inspection" currentState={`${inspection.state} · Result ${inspection.finalResult ?? 'NOT_DETERMINED'}`} nextAction={inspection.state === 'SUBMITTED' && canReview ? 'Begin review' : inspection.state === 'UNDER_REVIEW' && canApprove ? 'Approve inspection' : inspection.state === 'SUBMITTED' || inspection.state === 'UNDER_REVIEW' ? 'Review or return is unavailable' : undefined} nextOwner={inspection.state === 'SUBMITTED' || inspection.state === 'UNDER_REVIEW' ? 'Reviewer / approver' : inspection.state === 'RETURNED' ? 'Inspection executor' : undefined} whyUnavailable={!canReview && ['SUBMITTED', 'UNDER_REVIEW'].includes(inspection.state) ? 'permission: this account can read the report but lacks the required review action' : inspection.state === 'APPROVED' ? 'state: controlled approval is already complete' : undefined} waitingOn={inspection.state === 'SUBMITTED' ? 'Reviewer' : inspection.state === 'UNDER_REVIEW' ? 'Review decision' : undefined} expectedEvent={inspection.state === 'SUBMITTED' ? 'Begin review' : inspection.state === 'UNDER_REVIEW' ? 'Approve, return, or reject' : undefined} controlledContext={`Receiving ${inspection.receiving.receivingNo} · approved template ${inspection.template.versionNo}`} evidenceSummary={`${inspection.results.length} recorded points; final controlled decision remains server-validated`} auditHref={`/audit?subjectType=INSPECTION_REPORT&subjectId=${encodeURIComponent(inspection.id)}`} relatedLinks={[{ label: inspection.receiving.receivingNo, href: `/quarantine/receiving/${inspection.receiving.receivingId}`, detail: 'Open source receiving item' }, { label: 'Inspection execution', href: `/quarantine/inspections/${inspection.id}/execute`, detail: 'Controlled observations' }]} />
  <div class="review-grid" data-inspection-id={inspection.id} data-version={inspection.version.toString()}><main><section class="panel"><div class="panel-head"><h2>Inspection snapshot</h2>{inspection.finalResult ? <StatusBadge status={inspection.finalResult} /> : <span class="muted">Result not determined</span>}</div><dl><div><dt>Workflow state</dt><dd>{inspection.state}</dd></div><div><dt>Author / executor</dt><dd>Recorded in the controlled audit trail</dd></div><div><dt>Receiving item</dt><dd>{inspection.receiving.receivingNo} · {inspection.receiving.itemCode}</dd></div><div><dt>Template</dt><dd>{inspection.template.versionNo} · approved context</dd></div></dl></section><section class="panel"><h2>Measurements and criteria</h2><p class="muted">Review the preserved controlled context and evidence. Official outcome requires the approved deterministic source gate on the server.</p><div class="evidence-row"><span>Recorded points</span><strong>{inspection.results.length}</strong></div></section><section class="panel"><h2>Previous submission / return history</h2><p class="muted">Prior controlled actions remain in audit history; no return or approval erases the submission path.</p></section></main><aside><section class="panel decision"><h2>Decision rail</h2><p class="muted">Opening review does not grant approval. Each action re-checks scope, current version, SoD, and permission.</p>{inspection.state === 'SUBMITTED' && canReview ? <button data-action="quarantine.reviewInspection" data-submit>Begin review</button> : null}{inspection.state === 'UNDER_REVIEW' && canApprove ? <button class="controlled" data-action="quarantine.approveInspection" data-submit>Approve inspection</button> : null}{inspection.state === 'SUBMITTED' || inspection.state === 'UNDER_REVIEW' ? canReturn ? <form method="post" data-action="quarantine.returnInspection"><label for="inspection-return-reason">Return reason<textarea id="inspection-return-reason" name="reason" required></textarea></label><button class="secondary" type="submit" data-submit>Return for correction</button><p data-result role="status" tabindex="-1" class="action-status"></p></form> : <p class="note">Return for correction is unavailable because your account lacks the review-return permissions. The record is still readable.</p> : null}<p class="note">Approval remains blocked when source/policy evidence is not approved. PASS is never a release command.</p></section></aside></div>
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  const context = document.querySelector<HTMLElement>('[data-inspection-id]');
  const inspectionId = context?.dataset.inspectionId ?? '';
  const version = context?.dataset.version ?? '0';
  const run = async (button: HTMLElement, label: string, call: () => Promise<{ error?: unknown }>) => {
    const btn = button as HTMLButtonElement;
    if (btn.disabled || button.closest('[aria-busy="true"]')) return;
    const scope = button.closest('aside, section') as HTMLElement | null;
    let output = scope?.querySelector?.<HTMLElement>('[data-result]') ?? document.querySelector<HTMLElement>('[data-result]');
    btn.disabled = true;
    scope?.setAttribute('aria-busy', 'true');
    if (output) output.textContent = label;
    try {
      const result = await call();
      if (!result.error) { window.location.reload(); return; }
      if (output) { output.textContent = 'The review action was not applied. Refresh and review the current state and version.'; (output as HTMLElement).focus?.(); }
    } catch {
      if (output) { output.textContent = 'The service is temporarily unavailable. Nothing was changed — refresh and try again if permitted.'; (output as HTMLElement).focus?.(); }
    } finally { btn.disabled = false; scope?.removeAttribute('aria-busy'); }
  };
  document.querySelectorAll<HTMLElement>('[data-action="quarantine.reviewInspection"]').forEach((button) => button.addEventListener('click', () => void run(button, 'Starting review…', () => actions.quarantine.reviewInspection({ id: inspectionId, expectedVersion: BigInt(version) }))));
  document.querySelectorAll<HTMLElement>('[data-action="quarantine.approveInspection"]').forEach((button) => button.addEventListener('click', () => void run(button, 'Applying approval…', () => actions.quarantine.approveInspection({ id: inspectionId, expectedVersion: BigInt(version) }))));
  document.querySelectorAll<HTMLFormElement>('[data-action="quarantine.returnInspection"]').forEach((form) => form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (form.getAttribute('aria-busy') === 'true') return;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit], button[type="submit"]');
    const output = form.querySelector<HTMLElement>('[data-result]');
    form.setAttribute('aria-busy', 'true');
    if (submit) submit.disabled = true;
    if (output) output.textContent = 'Returning for correction…';
    try {
      const reason = new FormData(form).get('reason');
      const result = await actions.quarantine.returnInspection({ id: inspectionId, expectedVersion: BigInt(version), reason: String(reason ?? '') });
      if (!result.error) { window.location.reload(); return; }
      if (output) { output.textContent = 'Return was not applied. Refresh and review the current state before trying again.'; output.focus?.(); }
    } catch {
      if (output) { output.textContent = 'The service is temporarily unavailable. Your reason was kept — try again if permitted.'; output.focus?.(); }
    } finally { form.removeAttribute('aria-busy'); if (submit) submit.disabled = false; }
  }));
</script>
<style>
  .crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a{color:var(--color-accent-primary-hover)}.head,.panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-5)}.head{margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.muted,.version,.readonly span{color:var(--text-muted);font-size:.84rem}.version{padding:.5rem .75rem;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}.readonly{display:grid;gap:.25rem;margin-bottom:var(--space-5);padding:var(--space-4);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}.review-grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:var(--space-5)}main,aside{display:grid;gap:var(--space-5);align-content:start}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}h2{margin:0;font-size:1rem}dl{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-4);margin:var(--space-5) 0 0}dt{color:var(--text-muted);font-size:.75rem}dd{margin:.3rem 0 0;font-weight:600}.evidence-row{display:flex;justify-content:space-between;margin-top:var(--space-5);padding:var(--space-4);background:var(--surface-raised);border-radius:var(--radius-md)}.action-status{margin:.5rem 0;color:var(--text-secondary);font-size:.85rem;min-height:1.25rem}button{width:100%;min-height:var(--control-height);padding:.6rem .8rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.controlled{border-color:var(--status-review);background:var(--status-review-bg);color:var(--text-primary)}.secondary{border-color:var(--border-default);background:var(--surface-raised);color:var(--text-primary)}form{display:grid;gap:.6rem;margin-top:var(--space-3)}label{display:grid;gap:.4rem;color:var(--text-secondary);font-size:.8rem}textarea{min-height:6rem;padding:.6rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.note{padding-top:var(--space-4);border-top:1px solid var(--color-border-subtle);line-height:1.5}@media(max-width:820px){.review-grid{grid-template-columns:1fr}}@media(max-width:560px){.head{display:grid}dl{grid-template-columns:1fr}.panel{padding:var(--space-4)}}
</style>
