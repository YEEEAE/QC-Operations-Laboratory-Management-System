---
import AppLayout from '../../../../ui/layouts/AppLayout.astro';
import { inspectionReadDependencies } from '../../../../modules/quarantine/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
let inspection: Awaited<ReturnType<ReturnType<typeof inspectionReadDependencies>['get']['execute']>> | undefined;
try { inspection = await inspectionReadDependencies().get.execute({ actor, id: Astro.params.inspectionId ?? '' }); } catch { return Astro.redirect('/404'); }
if (!inspection) return Astro.redirect('/404');
const stateEditable = inspection.state === 'DRAFT';
const hasPermission = (code: string) => inspection && actor.permissions.some((permission) => permission.code === code && permission.active !== false);
const canEdit = stateEditable && Boolean(hasPermission('PERM-INSP-EDIT-DRAFT'));
const canSubmit = canEdit && Boolean(hasPermission('PERM-INSP-SUBMIT'));
const canResume = inspection.state === 'RETURNED' && Boolean(hasPermission('PERM-INSP-EDIT-DRAFT'));
---
<AppLayout title={`${inspection.inspectionNo} · Execute`} locale="en" direction="ltr">
  <div class="crumb"><a href="/quarantine/inspections">Inspection reports</a><span>/</span><span>Execute</span></div>
  <section class="head"><div><p class="eyebrow">T3 CONTROLLED EXECUTION</p><h1>Execute inspection</h1><p class="lede">{inspection.inspectionNo} · {inspection.receiving.receivingNo} · {inspection.receiving.itemCode}</p></div><div class="version">Reviewing version <strong>{inspection.version.toString()}</strong></div></section>
  {(!canEdit && stateEditable) ? <section class="readonly" role="alert"><strong>Execution is read-only for this account.</strong><span>The current state allows draft work, but your account does not have the explicit draft-edit permission. Page visibility does not grant mutation authority.</span></section> : null}
  {(!canResume && inspection.state === 'RETURNED') ? <section class="readonly" role="alert"><strong>Resume is unavailable.</strong><span>The inspection was returned for correction, but your account lacks the explicit draft-edit permission.</span></section> : null}
  <form class="workspace" method="post" data-action="quarantine.saveInspectionDraft" data-inspection-id={inspection.id} data-version={inspection.version.toString()}><main><section class="panel"><h2>Receiving snapshot</h2><dl><div><dt>Document</dt><dd>{inspection.receiving.docNo}</dd></div><div><dt>Lot / batch</dt><dd>{inspection.receiving.lot}</dd></div><div><dt>Quantity</dt><dd>{inspection.receiving.qty}</dd></div><div><dt>Template version</dt><dd>{inspection.template.versionNo}</dd></div></dl></section><section class="panel"><h2>Measurements and observations</h2><p class="muted">Enter observations against the approved template. Scientific criteria and official result remain server-controlled.</p><div class="measurement"><span>Template points</span><strong>{inspection.results.length}</strong><small>No client-selected PASS/FAIL is accepted as official result.</small></div></section><section class="panel"><h2>Evidence and notes</h2><label>Execution notes<textarea name="notes" disabled={!canEdit}></textarea></label></section></main><aside><section class="panel"><h2>Submission readiness</h2><ul class="checks"><li>Approved template context captured</li><li>Required points complete — verify before submit</li><li>Required evidence — verify before submit</li><li>Acceptance criteria source — server validation</li></ul><p data-result role="status" tabindex="-1" class="action-status"></p><div class="actions">{canEdit ? <><button type="submit">Save draft</button>{canSubmit ? <button class="controlled" type="button" data-action="quarantine.submitInspection">Submit for review</button> : <p class="note">Submit for review is unavailable because your account lacks the explicit submission permission.</p>}</> : inspection.state === 'RETURNED' && canResume ? <button type="button" data-action="quarantine.resumeInspection">Resume for correction</button> : <a class="secondary" href={`/quarantine/inspections/${inspection.id}`}>Back to record</a>}</div></section></aside></form>
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  const context = document.querySelector<HTMLElement>('[data-inspection-id]');
  const inspectionId = context?.dataset.inspectionId ?? '';
  const version = context?.dataset.version ?? '0';
  const form = document.querySelector<HTMLFormElement>('[data-action="quarantine.saveInspectionDraft"]');
  const statusOf = (scope: ParentNode | null): HTMLElement | null => (scope as HTMLElement | null)?.querySelector?.('[data-result]') ?? document.querySelector<HTMLElement>('[data-result]');
  const guard = (el: HTMLElement | null): boolean => el?.closest?.('[aria-busy="true"]') !== null;
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>('[data-submit], button[type="submit"]');
    const output = form.querySelector<HTMLElement>('[data-result]');
    if (form.getAttribute('aria-busy') === 'true') return;
    form.setAttribute('aria-busy', 'true');
    if (submit) submit.disabled = true;
    if (output) output.textContent = 'Saving draft…';
    try {
      const result = await actions.quarantine.saveInspectionDraft({ id: inspectionId, expectedVersion: BigInt(version), results: [] });
      if (!result.error) { window.location.reload(); return; }
      if (output) { output.textContent = 'The draft was not saved. Refresh and review the current version before trying again.'; output.focus?.(); }
    } catch {
      if (output) { output.textContent = 'The service is temporarily unavailable. Nothing was changed — your entries are preserved.'; output.focus?.(); }
    } finally { form.removeAttribute('aria-busy'); if (submit) submit.disabled = false; }
  });
  const run = async (button: HTMLElement, label: string, call: () => Promise<{ error?: unknown }>) => {
    const btn = button as HTMLButtonElement;
    if (btn.disabled || guard(button)) return;
    const output = statusOf(button.closest('aside, form, section'));
    btn.disabled = true;
    button.closest('aside, form, section')?.setAttribute?.('aria-busy', 'true');
    if (output) output.textContent = label;
    try {
      const result = await call();
      if (!result.error) { window.location.reload(); return; }
      if (output) { output.textContent = 'The inspection action was not applied. Refresh and review the current state and version.'; output.focus?.(); }
    } catch {
      if (output) { output.textContent = 'The service is temporarily unavailable. Nothing was changed — refresh and try again if permitted.'; output.focus?.(); }
    } finally { btn.disabled = false; button.closest('aside, form, section')?.removeAttribute?.('aria-busy'); }
  };
  document.querySelectorAll<HTMLElement>('[data-action="quarantine.submitInspection"]').forEach((button) => button.addEventListener('click', () => void run(button, 'Submitting for review…', () => actions.quarantine.submitInspection({ id: inspectionId, expectedVersion: BigInt(version) }))));
  document.querySelectorAll<HTMLElement>('[data-action="quarantine.resumeInspection"]').forEach((button) => button.addEventListener('click', () => void run(button, 'Resuming for correction…', () => actions.quarantine.resumeInspection({ id: inspectionId, expectedVersion: BigInt(version) }))));
</script>
<style>
  .crumb{display:flex;gap:.5rem;margin-bottom:var(--space-5);color:var(--text-muted);font-size:.8rem}.crumb a{color:var(--color-accent-primary-hover)}.head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-5);margin-bottom:var(--space-5)}h1{margin:.25rem 0 .4rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.muted,.version,.readonly span{color:var(--text-muted);font-size:.84rem}.version{padding:.5rem .75rem;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}.readonly{display:grid;gap:.25rem;margin-bottom:var(--space-5);padding:var(--space-4);border-inline-start:3px solid var(--status-warning);background:var(--surface-panel)}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:var(--space-5)}main,aside{display:grid;gap:var(--space-5);align-content:start}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}h2{margin:0;font-size:1rem}dl{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-4);margin:var(--space-5) 0 0}dt{color:var(--text-muted);font-size:.75rem}dd{margin:.3rem 0 0;font-weight:600}.measurement{display:grid;gap:.35rem;margin-top:var(--space-5);padding:var(--space-4);background:var(--surface-raised);border:1px dashed var(--color-border-strong);border-radius:var(--radius-md)}.measurement span,.measurement small{color:var(--text-muted);font-size:.76rem}label{display:grid;gap:.4rem;margin-top:var(--space-4);color:var(--text-secondary);font-size:.82rem}.action-status{margin:0 0 var(--space-3);color:var(--text-secondary);font-size:.85rem;min-height:1.25rem}textarea{min-height:8rem;padding:.7rem;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-sm);color:inherit;font:inherit}.checks{display:grid;gap:.65rem;margin:var(--space-4) 0;padding-inline-start:1.2rem;color:var(--text-secondary);font-size:.8rem;line-height:1.4}.actions{display:grid;gap:.6rem}button,.secondary{min-height:var(--control-height);padding:.6rem .8rem;border:1px solid var(--color-accent-primary);border-radius:var(--radius-sm);background:var(--color-accent-primary);color:#fff;font:inherit;font-weight:700}.controlled{border-color:var(--status-review);background:var(--status-review-bg);color:var(--text-primary)}.secondary{display:flex;align-items:center;justify-content:center;border-color:var(--border-default);background:var(--surface-raised);color:var(--text-primary);text-decoration:none}@media(max-width:820px){.workspace{grid-template-columns:1fr}}@media(max-width:560px){.head{display:grid}dl{grid-template-columns:1fr}.panel{padding:var(--space-4)}}
</style>
