  .version{font-variant-numeric:tabular-nums}
  .head-actions{display:flex;gap:var(--space-3);flex-wrap:wrap}
  .grid,.detail-support-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-5)}
  .panel{min-width:0;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);margin-bottom:var(--space-5)}
  dl{display:grid;grid-template-columns:minmax(8rem,auto) minmax(0,1fr);gap:.6rem 1.5rem;margin:0}
  dt{color:var(--text-muted)}
  dd{min-width:0;margin:0;font-weight:600;overflow-wrap:anywhere}
  .long-value{white-space:pre-wrap}
  .hint,.empty{color:var(--text-muted);font-size:.86rem;line-height:1.5}
  .hint:last-child{margin-block-end:0}
  .table-wrap{max-width:100%;min-width:0;overflow:auto;overscroll-behavior-inline:contain}
  table{width:100%;min-width:74rem;border-collapse:collapse;font-size:.82rem}
  caption{text-align:start;padding-block-end:var(--space-3);color:var(--text-muted)}
  th,td{padding:.6rem;text-align:start;border-block-start:1px solid var(--color-border-subtle);vertical-align:top;overflow-wrap:anywhere}
  th{font-weight:700}
  tr.over-limit td{background:color-mix(in srgb,var(--status-danger) 8%,transparent)}
