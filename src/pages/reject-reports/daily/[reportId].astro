  label{display:grid;gap:.4rem;font-size:.85rem}
  input,textarea{min-width:0;min-height:44px;font:inherit;padding:.7rem;background:var(--surface-page);color:inherit;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}
  textarea{min-height:5rem}
  .actions{display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap}
  .inline-form{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}
  .inline-form input{min-width:min(12rem,100%)}
  .relationship-list{display:grid;gap:var(--space-3);margin:0;padding-inline-start:1.25rem}
  .relationship-list li{min-width:0;overflow-wrap:anywhere}
  .not-provided{display:block;color:var(--text-muted);font-size:.86rem}
  .mutation-feedback{padding:var(--space-3) var(--space-4);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md);background:var(--surface-panel);overflow-wrap:anywhere}
  .mutation-feedback:empty{display:none}
  .mutation-feedback[role='alert']{border-color:var(--status-danger);color:var(--status-danger)}
  .action-rail{min-width:0}
  .action-rail > h2{margin-block:var(--space-6) var(--space-4)}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  button{min-height:44px;padding:.6rem 1rem;background:var(--color-accent-primary);border:0;border-radius:var(--radius-md);color:var(--text-on-accent);font:inherit;font-weight:700;cursor:pointer}
  button.secondary{background:transparent;color:var(--color-accent-primary-hover);border:1px solid var(--color-accent-primary)}
  button.danger{background:var(--status-danger)}
  button:disabled{cursor:not-allowed;opacity:.6}
  button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,.table-wrap:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}
  .status{font-size:.78rem;padding:.15rem .5rem;border-radius:999px;background:var(--surface-page);border:1px solid var(--color-border-subtle)}
  .status-finalized{color:var(--status-success)}
  .status-void{color:var(--status-danger)}
  a{color:var(--color-accent-primary-hover);text-underline-offset:3px}
  @media(max-width:768px){.page-head{display:grid}.grid,.detail-support-grid,.fields{grid-template-columns:minmax(0,1fr)}.fields .wide{grid-column:auto}}
  .print-copy-watermark{border-block:2px solid #111;padding:4px;text-align:center;font-weight:700}
  @media print{
    @page{size:A4 portrait;margin:12mm}
    .head-actions,form,.actions,.action-rail{display:none!important}
    body{background:#fff}
    .panel{border-color:#999;break-inside:avoid}
    .table-wrap{overflow:visible}
    table{min-width:0;font-size:.75rem}
  }
</style>
