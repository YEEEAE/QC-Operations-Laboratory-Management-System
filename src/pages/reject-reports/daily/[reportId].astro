---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { rejectReportReadDependencies } from '../../../modules/reject-reports/application/dependencies.js';
import ErrorState from '../../../ui/components/feedback/ErrorState.astro';
import { AppError } from '../../../shared/errors/app-error.js';
import { compareRejectDecimalStrings, dailyRejectTotals } from '../../../modules/reject-reports/application/view-model.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { actions } from 'astro:actions';
import { field, parseExpectedVersionField } from '../../../ui/forms/mutation-post.js';
import { randomUUID } from 'node:crypto';

const actor = Astro.locals.actor;
if (!actor)
  return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const reportId = Astro.params.reportId ?? '';
const printMode = Astro.url.searchParams.get('print') === '1';
const deps = rejectReportReadDependencies();
const availability = await deps.availability.execute({ actor });
if (!availability.available) Astro.response.status = 503;
// A missing or unauthorized report is a not-found surface, never a 500: the
// read throws RESOURCE_NOT_FOUND / AUTHORIZATION before a record exists, and
// the page's not-found branch already covers both cases without leaking
// whether the record exists.
let record: Awaited<ReturnType<typeof deps.getDailyReject.execute>> | null = null;
let recordNotFound = false;
if (availability.available) {
  try {
    record = await deps.getDailyReject.execute({ actor, reportId });
  } catch (error) {
    if (
      error instanceof AppError &&
      (error.code === 'RESOURCE_NOT_FOUND' || error.category === 'AUTHORIZATION')
    ) {
      recordNotFound = true;
      Astro.response.status = 404;
    } else {
      throw error;
    }
  }
}
// Operational surfaces show a human identity, never the internal UUID (P1-3).
const creatorLabel = record?.createdBy === actor.id ? 'You' : 'Another authorized user';
const hasPermission = (code: string) =>
  actor.permissions.some((grant) => grant.code === code && grant.active !== false);
const isCreator = record?.createdBy === actor.id;
const canEditDraft = isCreator && record?.status === 'DRAFT';
const canAppend = canEditDraft && hasPermission('PERM-RREJ-EDIT');
const canSubmitForQc = isCreator && record?.status === 'DRAFT' && hasPermission('PERM-RREJ-SUBMIT-QC');
const canQcReview = !!record && record.status === 'SUBMITTED_FOR_QC' && !isCreator && hasPermission('PERM-RREJ-QC-REVIEW');
const qcReviewerId = [...(record?.reviewEvents ?? [])].reverse().find((event) => event.action === 'QC_REVIEW')?.actorId;
const canSupervisorApprove = !!record && record.status === 'QC_REVIEWED' && !isCreator && qcReviewerId !== actor.id && hasPermission('PERM-RREJ-SUPERVISOR-APPROVE');
const canVoid =
  !!record &&
  record.status !== 'VOID' &&
  record.status !== 'COMPLETED' &&
  isCreator &&
  hasPermission('PERM-RREJ-VOID');
let postError = '';
let postedValues: Record<string, string> = {};
if (Astro.request.method === 'POST' && record && !printMode) {
  const form = await Astro.request.formData();
  postedValues = Object.fromEntries([...form.entries()].filter((entry): entry is [string, string] => typeof entry[1] === 'string'));
  const intent = field(form, 'intent');
  try {
    const expectedVersion = parseExpectedVersionField(field(form, 'expectedVersion'));
    let result;
    if (intent === 'append' && canAppend) {
      const value = (name: string) => field(form, name);
      const optional = (name: string) => value(name) || undefined;
      result = await Astro.callAction(actions.rejectReports.appendDailyRejectEntry, {
        reportId, expectedVersion,
        entry: {
          machineName: optional('machineName'), itemCode: optional('itemCode'),
          itemDescription: value('itemDescription'), lotNo: optional('lotNo'),
          buRmProductName: optional('buRmProductName'), rmDescription: optional('rmDescription'),
          rmUnit: optional('rmUnit'), rmLotNo: optional('rmLotNo'), rmType: optional('rmType'),
          pumpOutQty: optional('pumpOutQty'), rejectQty: value('rejectQty'), goodQty: value('goodQty'),
          totalProducedQty: optional('totalProducedQty'), reworkQty: optional('reworkQty'),
          holdQty: optional('holdQty'), quantityUnit: optional('quantityUnit'),
          quantitySourceReference: optional('quantitySourceReference'),
          rejectLimit: optional('rejectLimit'), productionFormula: optional('productionFormula'),
          rejectReason: value('rejectReason'), analysis: optional('analysis'),
        },
      });
    } else if (intent === 'review' && field(form, 'reviewAction')) {
      result = await Astro.callAction(actions.rejectReports.transitionDailyRejectReview, {
        reportId, expectedVersion, idempotencyKey: field(form, 'idempotencyKey'),
        action: field(form, 'reviewAction') as 'SUBMIT_FOR_QC' | 'QC_REVIEW' | 'QC_RETURN' | 'SUPERVISOR_APPROVE',
        reason: field(form, 'reason') || undefined,
      });
    } else if (intent === 'void' && canVoid) {
      result = await Astro.callAction(actions.rejectReports.voidReport, { reportId, expectedVersion, reason: field(form, 'reason') });
    } else {
      postError = 'This action is not available. Refresh the record and review its current state.';
    }
    if (result && !result.error) return Astro.redirect(Astro.url.pathname, 303);
    if (result?.error) postError = 'The action was not accepted. Review the record, current version, and permissions before trying again.';
  } catch {
    postError = 'The result could not be confirmed. Review this report and its history before deciding whether to try again.';
  }
}
const totals = dailyRejectTotals(record?.entries ?? []);
const overLimit = (operationalRejectPct: string | null, rejectLimit?: string) =>
  operationalRejectPct !== null && rejectLimit !== undefined && compareRejectDecimalStrings(operationalRejectPct, rejectLimit) > 0;
const fmtDate = (d?: Date) =>
  d ? d.toLocaleDateString('en-SA', { timeZone: 'Asia/Riyadh' }) : '—';
const fmtDateTime = (d?: Date) =>
  d ? d.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' }) : '—';
---

<AppLayout title={record ? `${record.reportNo} · Daily Reject Record` : 'Daily Reject unavailable'} locale="en" direction="ltr">
  {recordNotFound ? (
    <ErrorState
      title="Reject report not found"
      description="This report does not exist or is outside your authorized scope. No report was changed."
      retryHref="/reject-reports"
    />
  ) : !record ? (
    <ErrorState
      title="Reject Reports are unavailable in this environment"
      description="This report could not be opened. No report was changed. Contact your system administrator, then try opening it again."
      retryHref="/reject-reports"
    />
  ) : (
  <>
  <section class="page-head record-header" aria-labelledby="record-title">
    <div>
      <h1 id="record-title">{record.reportNo}</h1>
      <p class="lede">
        <span>Status</span>
        <strong class={`status status-${record.status.toLowerCase()}`}>{stateLabel(record.status)}</strong>
        <span>Version</span>
        <strong class="version">{record.version.toString()}</strong>
      </p>
    </div>
    <div class="head-actions">
      <a href="/reject-reports">Back to reject reports</a>
      <a href={`${Astro.url.pathname}?print=1`} target="_blank" rel="noopener">Print view</a>
    </div>
  </section>

  {printMode && <p class="print-copy-watermark">UNAPPROVED INFORMATIONAL COPY — NOT A CONTROLLED RECORD</p>}
  <p class="mutation-feedback" role={postError ? 'alert' : 'status'} aria-live={postError ? 'assertive' : 'polite'} tabindex="-1" data-result>{postError}{postError && <> <a href={`${Astro.url.pathname}#entries`}>Review this report</a></>}</p>
  {record.status === 'RETURNED' && <p class="hint">This report is returned for correction. A controlled correction record cannot be created until the applicable correction authority and versioning rules are approved.</p>}
  <div class="grid">
    <section class="panel" aria-labelledby="facts-title">
      <h2 id="facts-title">Record facts</h2>
      <dl>
        <dt>Record date</dt><dd>{fmtDate(record.reportDate)}</dd>
        <dt>Shift</dt><dd>{record.shift ?? '—'}</dd>
        <dt>Recorded by</dt><dd>{creatorLabel}</dd>
        <dt>Department / section</dt><dd>{record.department}</dd>
      </dl>
    </section>
    <section class="panel" aria-labelledby="totals-title">
      <h2 id="totals-title">Calculated totals</h2>
      {totals.byRecordedUnit.length ? (
        <>
          {totals.byRecordedUnit.map((group) => (
            <dl>
              <dt>Reject quantity · {group.unit}</dt><dd>{group.totalRejectQty}</dd>
              <dt>Good production quantity · {group.unit}</dt><dd>{group.totalGoodQty}</dd>
              <dt>Paper-form Reject % · {group.unit}</dt><dd>{group.rejectPct === null ? '—' : `${group.rejectPct}%`}</dd>
              <dt>Entries · {group.unit}</dt><dd>{group.entryCount}</dd>
            </dl>
          ))}
          <p class="hint">Paper-form totals retain the raw-material unit grouping used by existing reports. Different unit labels are never added together.</p>
        </>
      ) : <p class="empty">No quantity totals yet.</p>}
      <p class="hint">Paper-form Reject % = reject quantity ÷ good quantity × 100. Operational Reject-to-Produced % = reject quantity ÷ total produced quantity × 100, rounded to four decimal places. Missing total produced is NOT_AVAILABLE; zero total produced has no percentage. Production balance rules are NOT_CONFIGURED.</p>
    </section>
    <section class="panel" aria-labelledby="operational-totals-title">
      <h2 id="operational-totals-title">Operational Reject-to-Produced totals</h2>
      {totals.byQuantityUnit.length ? totals.byQuantityUnit.map((group) => (
        <dl>
          <dt>Total rejected · {group.unit}</dt><dd>{group.totalRejectQty ?? 'NOT_AVAILABLE (unit not recorded)'}</dd>
          <dt>Total produced · {group.unit}</dt><dd>{group.totalProducedQty ?? 'NOT_AVAILABLE'}</dd>
          <dt>Operational Reject-to-Produced % · {group.unit}</dt><dd>{group.operationalRejectPctStatus === 'ZERO_DENOMINATOR' ? 'NOT_AVAILABLE (zero denominator)' : group.operationalRejectPct === null ? 'NOT_AVAILABLE' : `${group.operationalRejectPct}%`}</dd>
        </dl>
      )) : <p class="empty">No quantity totals yet.</p>}
    </section>
  </div>

  <section class="panel evidence-panel" id="entries" aria-labelledby="entries-title">
    <h2 id="entries-title">Recorded evidence</h2>
    <p class="hint">No controlled/effective Reject Reports source, approver e-signature, or QMS linkage is supplied by this daily-report record.</p>
    <p class="hint">The row highlight compares Operational Reject-to-Produced % with the entered limit for reference only. No approved threshold source is available, so this is not an official limit decision.</p>
    {record.entries.length ? (
      <div class="table-wrap" role="region" aria-label="Production and rejection entries" tabindex="0">
        <table>
          <caption>Production and rejection entries</caption>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Machine</th>
              <th scope="col">Item code</th>
              <th scope="col">Description</th>
              <th scope="col">Lot</th>
              <th scope="col">BU/RM product</th>
              <th scope="col">RM details</th>
              <th scope="col">Pump out</th>
              <th scope="col">Reject qty</th>
              <th scope="col">Good qty</th>
              <th scope="col">Paper-form Reject % (Reject / Good)</th>
              <th scope="col">Total produced</th>
              <th scope="col">Operational Reject-to-Produced %</th>
              <th scope="col">Formula provenance</th>
              <th scope="col">Quantity provenance</th>
              <th scope="col">Limit</th>
              <th scope="col">Reference comparison</th>
              <th scope="col">Approved threshold decision</th>
              <th scope="col">Formula/BOM</th>
              <th scope="col">Reason</th>
            </tr>
          </thead>
          <tbody>
            {record.entries.map((entry) => (
              <tr
                class={overLimit(entry.operationalRejectPct, entry.rejectLimit) ? 'over-limit' : ''}
              >
                <td>{entry.position}</td>
                <td>{entry.machineName ?? '—'}</td>
                <td>{entry.itemCode ?? '—'}</td>
                <td>{entry.itemDescription}</td>
                <td>{entry.lotNo ?? '—'}</td>
                <td>{entry.buRmProductName ?? '—'}</td>
                <td>
                  {[entry.rmDescription, entry.rmType, entry.rmLotNo, entry.rmUnit].filter(Boolean).join(' · ') || '—'}
                </td>
                <td>{entry.pumpOutQty ?? '—'}</td>
                <td>{entry.rejectQty}</td>
                <td>{entry.goodQty}</td>
                <td>{entry.rejectPct === null ? '—' : `${entry.rejectPct}%`}</td>
                <td>{entry.totalProducedQty ?? 'NOT_AVAILABLE'} {entry.quantityUnit ?? ''}</td>
                <td>{entry.operationalRejectPctStatus === 'ZERO_DENOMINATOR' ? 'NOT_AVAILABLE (zero denominator)' : entry.operationalRejectPct === null ? 'NOT_AVAILABLE' : `${entry.operationalRejectPct}%`}</td>
                <td>Paper {entry.paperFormulaId ?? 'NOT_RECORDED'} v{entry.paperFormulaVersion ?? '—'}; operational {entry.operationalFormulaId ?? 'NOT_RECORDED'} v{entry.operationalFormulaVersion ?? '—'}</td>
                <td>{entry.quantityProvenance ?? 'NOT_RECORDED'}{entry.quantitySourceReference ? ` · ${entry.quantitySourceReference}` : ''}; balance {entry.productionBalanceStatus ?? 'NOT_RECORDED'}</td>
                <td>{entry.rejectLimit ?? '—'}</td>
                <td>{entry.rejectLimit === undefined || entry.operationalRejectPct === null ? 'NOT_AVAILABLE' : overLimit(entry.operationalRejectPct, entry.rejectLimit) ? 'Above entered reference limit' : 'At or below entered reference limit'}</td>
                <td>{entry.thresholdDecisionState}{entry.thresholdProfileId ? ` · Profile ${entry.thresholdProfileId}` : ''}</td>
                <td>{entry.productionFormula ?? '—'}</td>
                <td>{entry.rejectReason}{entry.analysis ? ` — ${entry.analysis}` : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : <p class="empty">No entries yet. Add at least one entry before finalizing.</p>}
  </section>

  <div class="detail-support-grid">
    <section class="panel" aria-labelledby="history-title">
      <h2 id="history-title">Recorded history</h2>
      <dl>
        <dt>Created</dt><dd>{fmtDateTime(record.createdAt)}</dd>
        <dt>Last updated</dt><dd>{fmtDateTime(record.updatedAt)}</dd>
        <dt>Finalized</dt><dd>{fmtDateTime(record.finalizedAt)}</dd>
        <dt>Voided</dt><dd>{record.voidedAt ? fmtDateTime(record.voidedAt) : '—'}</dd>
        {record.voidedAt && <><dt>Void reason</dt><dd class="long-value">{record.voidReason ?? '—'}</dd></>}
      </dl>
      {record.reviewEvents?.map((event) => <div class="review-event"><strong>{stateLabel(event.toState)}</strong><span>{event.action.replaceAll('_', ' ')}</span><span>{fmtDateTime(event.occurredAt)}</span><span>{event.actorId === actor.id ? 'You' : 'Another authorized user'}</span>{event.reason && <p>{event.reason}</p>}</div>)}
    </section>

    <section class="panel" aria-labelledby="relationships-title">
      <h2 id="relationships-title">Relationships</h2>
      <ul class="relationship-list">
        <li><a href="/reject-reports">Reject reports register</a></li>
        {record.correctionOf ? (
          <li><a href={`/reject-reports/daily/${encodeURIComponent(record.correctionOf)}`}>Correction of {record.correctionOf}</a></li>
        ) : (
          <li><span>Correction predecessor</span><span class="not-provided">N/A — no predecessor is recorded for this report.</span></li>
        )}
      </ul>
    </section>
  </div>

  {!printMode && (canAppend || canSubmitForQc || canQcReview || canSupervisorApprove || canVoid) && (
    <section class="action-rail" aria-labelledby="actions-title">
      <h2 id="actions-title">Available actions</h2>
      {canAppend && (
      <section class="panel" aria-labelledby="add-entry-title">
        <h3 id="add-entry-title">Add entry</h3>
      <form
        class="form"
        method="post"
        data-add-entry
        data-version={record.version.toString()}
      >
        <input type="hidden" name="intent" value="append" />
        <input type="hidden" name="expectedVersion" value={record.version.toString()} />
        <div class="fields">
          <div><label for="machineName">Machine name<input id="machineName" name="machineName" maxlength="200" value={postedValues.machineName ?? ''} /></label></div>
          <div><label for="itemCode">Item code<input id="itemCode" name="itemCode" maxlength="100" value={postedValues.itemCode ?? ''} /></label></div>
          <div class="wide"><label for="itemDescription">Material / product description<input id="itemDescription" name="itemDescription" required maxlength="1000" value={postedValues.itemDescription ?? ''} /></label></div>
          <div><label for="lotNo">Lot number<input id="lotNo" name="lotNo" maxlength="100" value={postedValues.lotNo ?? ''} /></label></div>
          <div><label for="buRmProductName">BU &amp; RM product name<input id="buRmProductName" name="buRmProductName" maxlength="500" value={postedValues.buRmProductName ?? ''} /></label></div>
          <div><label for="rmDescription">Raw-material description<input id="rmDescription" name="rmDescription" maxlength="1000" value={postedValues.rmDescription ?? ''} /></label></div>
          <div><label for="rmUnit">RM unit<input id="rmUnit" name="rmUnit" maxlength="50" value={postedValues.rmUnit ?? ''} /></label></div>
          <div><label for="rmLotNo">RM lot number<input id="rmLotNo" name="rmLotNo" maxlength="100" value={postedValues.rmLotNo ?? ''} /></label></div>
          <div><label for="rmType">RM type<input id="rmType" name="rmType" maxlength="100" value={postedValues.rmType ?? ''} /></label></div>
          <div><label for="pumpOutQty">Pump out quantity<input id="pumpOutQty" name="pumpOutQty" type="text" inputmode="decimal" pattern="[0-9]+(\.[0-9]+)?" value={postedValues.pumpOutQty ?? ''} /></label></div>
          <div><label for="rejectQty">Reject quantity<input id="rejectQty" name="rejectQty" type="text" inputmode="decimal" pattern="[0-9]+(\.[0-9]+)?" required value={postedValues.rejectQty ?? ''} /></label></div>
          <div><label for="goodQty">Good production quantity<input id="goodQty" name="goodQty" type="text" inputmode="decimal" pattern="[0-9]+(\.[0-9]+)?" required value={postedValues.goodQty ?? ''} /></label></div>
          <div><label for="totalProducedQty">Total produced quantity<input id="totalProducedQty" name="totalProducedQty" type="text" inputmode="decimal" pattern="[0-9]+(\.[0-9]+)?" value={postedValues.totalProducedQty ?? ''} /></label></div>
          <div><label for="quantityUnit">Production quantity unit<input id="quantityUnit" name="quantityUnit" maxlength="50" value={postedValues.quantityUnit ?? ''} /></label></div>
          <div><label for="reworkQty">Rework quantity (optional)<input id="reworkQty" name="reworkQty" type="text" inputmode="decimal" pattern="[0-9]+(\.[0-9]+)?" value={postedValues.reworkQty ?? ''} /></label></div>
          <div><label for="holdQty">Hold quantity (optional)<input id="holdQty" name="holdQty" type="text" inputmode="decimal" pattern="[0-9]+(\.[0-9]+)?" value={postedValues.holdQty ?? ''} /></label></div>
          <div class="wide"><label for="quantitySourceReference">Production quantity source reference<input id="quantitySourceReference" name="quantitySourceReference" maxlength="500" value={postedValues.quantitySourceReference ?? ''} /></label></div>
          <div><label for="rejectLimit">Reject limit (%)<input id="rejectLimit" name="rejectLimit" type="text" inputmode="decimal" pattern="[0-9]+(\.[0-9]+)?" value={postedValues.rejectLimit ?? ''} /></label></div>
          <div><label for="productionFormula">Production formula / BOM<input id="productionFormula" name="productionFormula" maxlength="500" value={postedValues.productionFormula ?? ''} /></label></div>
          <div class="wide"><label for="rejectReason">Reject / defect reason<input id="rejectReason" name="rejectReason" required maxlength="2000" value={postedValues.rejectReason ?? ''} /></label></div>
          <div class="wide"><label for="analysis">Analysis / notes<textarea id="analysis" name="analysis" maxlength="4000">{postedValues.analysis ?? ''}</textarea></label></div>
        </div>
        <div class="actions">
          <button type="submit" data-submit>Add entry</button>
        </div>
      </form>
      </section>
      )}
      {canSubmitForQc && record.entries.length > 0 && (
        <section class="panel" aria-labelledby="finalize-title">
          <h3 id="finalize-title">Submit for QC review</h3>
          <p class="hint">Submission preserves the production entry. QC review and area Supervisor approval are separate decisions.</p>
          <form method="post" data-review-form data-action="SUBMIT_FOR_QC">
            <input type="hidden" name="intent" value="review" /><input type="hidden" name="reviewAction" value="SUBMIT_FOR_QC" />
            <input type="hidden" name="expectedVersion" value={record.version.toString()} />
            <input type="hidden" name="idempotencyKey" value={randomUUID()} />
            <button type="submit">Submit for QC</button>
          </form>
        </section>
      )}
      {(canQcReview || canSupervisorApprove) && <section class="panel" aria-labelledby="review-title"><h3 id="review-title">{canQcReview ? 'QC review' : 'Area Supervisor approval'}</h3><p class="hint">The review reason is retained with the actor, permission, record version, and timestamp.</p>
        {canQcReview && <><form method="post" data-review-form data-action="QC_REVIEW"><input type="hidden" name="intent" value="review"/><input type="hidden" name="reviewAction" value="QC_REVIEW"/><input type="hidden" name="expectedVersion" value={record.version.toString()}/><input type="hidden" name="idempotencyKey" value={randomUUID()}/><label for="qcReviewReason">QC review note<input id="qcReviewReason" name="reason" required maxlength="2000"/></label><button type="submit">Record QC review</button></form>
        <form method="post" data-review-form data-action="QC_RETURN"><input type="hidden" name="intent" value="review"/><input type="hidden" name="reviewAction" value="QC_RETURN"/><input type="hidden" name="expectedVersion" value={record.version.toString()}/><input type="hidden" name="idempotencyKey" value={randomUUID()}/><label for="qcReturnReason">Return reason<input id="qcReturnReason" name="reason" required maxlength="2000"/></label><button type="submit">Return to production</button></form></>}
        {canSupervisorApprove && <form method="post" data-review-form data-action="SUPERVISOR_APPROVE"><input type="hidden" name="intent" value="review"/><input type="hidden" name="reviewAction" value="SUPERVISOR_APPROVE"/><input type="hidden" name="expectedVersion" value={record.version.toString()}/><input type="hidden" name="idempotencyKey" value={randomUUID()}/><label for="supervisorReason">Supervisor decision note<input id="supervisorReason" name="reason" required maxlength="2000"/></label><button type="submit">Approve daily reject report</button></form>}
      </section>}
      {canVoid && (
      <section class="panel" aria-labelledby="void-title">
        <h3 id="void-title">Void record</h3>
        <p class="hint">Voiding never deletes history; the record stays visible as VOID with its reason and audit trail.</p>
        <form class="inline-form" method="post" data-void-form data-version={record.version.toString()}>
          <input type="hidden" name="intent" value="void" />
          <input type="hidden" name="expectedVersion" value={record.version.toString()} />
          <label class="sr-only" for="voidReason">Void reason</label>
          <input id="voidReason" name="reason" required maxlength="2000" placeholder="Void reason (required)" value={postedValues.reason ?? ''} />
          <button type="submit" class="danger">Void record</button>
        </form>
      </section>
      )}
    </section>
  )}
  </>
  )}
</AppLayout>

<script>
  import { actions } from 'astro:actions';
  const reportId = location.pathname.split('/').filter(Boolean).pop() ?? '';
  const output = document.querySelector<HTMLElement>('[data-result]');
  const fail = (message: string) => {
    if (output) {
      output.setAttribute('role', 'alert');
      output.setAttribute('aria-live', 'assertive');
      output.textContent = message;
      output.focus();
    }
  };
  const run = async (work: Promise<{ error?: unknown }>) => {
    if (output) {
      output.setAttribute('role', 'status');
      output.setAttribute('aria-live', 'polite');
      output.textContent = 'Submitting action…';
    }
    try {
      const result = await work;
      if (result.error) fail('The action was not accepted. Refresh the record and check its current state and your permissions before trying again.');
      else location.reload();
    } catch {
      fail('The service did not confirm the result. Refresh the report and its history before deciding whether to try again.');
    }
  };
  const showFieldErrors = (form: HTMLFormElement, error: unknown) => {
    const fields = (error as { fields?: Record<string, string[]> } | null)?.fields;
    if (!fields || Object.keys(fields).length === 0) return false;
    let first: HTMLElement | null = null;
    let rendered = 0;
    for (const [name, messages] of Object.entries(fields)) {
      const fieldName = name.replace(/^entry\./, '').split('.').at(-1) ?? name;
      const field = form.elements.namedItem(fieldName);
      if (!(field instanceof HTMLElement)) continue;
      rendered += 1;
      first ??= field;
      const errorId = `${fieldName}-error`;
      document.getElementById(errorId)?.remove();
      const note = document.createElement('p');
      note.id = errorId;
      note.className = 'field-error';
      note.textContent = messages.join(' ');
      field.setAttribute('aria-invalid', 'true');
      const describedBy = new Set((field.getAttribute('aria-describedby') ?? '').split(/\s+/).filter(Boolean));
      describedBy.add(errorId);
      field.setAttribute('aria-describedby', [...describedBy].join(' '));
      field.closest('div')?.append(note);
    }
    if (output) output.textContent = rendered > 0
      ? 'Check the highlighted fields, then submit the entry again.'
      : Object.values(fields).flat().join(' ');
    first?.focus();
    return true;
  };
  const showRecovery = (message: string) => {
    if (!output) return;
    output.setAttribute('role', 'alert');
    output.setAttribute('aria-live', 'assertive');
    output.replaceChildren(document.createTextNode(`${message} `));
    const link = document.createElement('a');
    link.href = location.pathname;
    link.textContent = 'Refresh record';
    output.append(link);
    output.focus();
  };
  const addForm = document.querySelector<HTMLFormElement>('[data-add-entry]');
  addForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (addForm.dataset.pending === 'true' || addForm.dataset.unresolved === 'true') return;
    addForm.dataset.pending = 'true';
    addForm.setAttribute('aria-busy', 'true');
    if (output) {
      output.setAttribute('role', 'status');
      output.setAttribute('aria-live', 'polite');
      output.textContent = 'Adding entry…';
    }
    const submit = addForm.querySelector<HTMLButtonElement>('[data-submit]');
    if (submit) submit.disabled = true;
    document.querySelectorAll('.field-error').forEach((error) => error.remove());
    addForm.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((field) => {
      field.removeAttribute('aria-invalid');
      const ids = (field.getAttribute('aria-describedby') ?? '').split(/\s+/).filter((id) => !id.endsWith('-error'));
      if (ids.length) field.setAttribute('aria-describedby', ids.join(' '));
      else field.removeAttribute('aria-describedby');
    });
    const data = new FormData(addForm);
    const text = (key: string) => String(data.get(key) ?? '');
    const opt = (key: string) => text(key) || undefined;
    const entry = {
      machineName: opt('machineName'), itemCode: opt('itemCode'),
      itemDescription: text('itemDescription'), lotNo: opt('lotNo'),
      buRmProductName: opt('buRmProductName'), rmDescription: opt('rmDescription'),
      rmUnit: opt('rmUnit'), rmLotNo: opt('rmLotNo'), rmType: opt('rmType'),
      pumpOutQty: opt('pumpOutQty'), rejectQty: text('rejectQty'),
      goodQty: text('goodQty'), totalProducedQty: opt('totalProducedQty'),
      reworkQty: opt('reworkQty'), holdQty: opt('holdQty'), quantityUnit: opt('quantityUnit'),
      quantitySourceReference: opt('quantitySourceReference'), rejectLimit: opt('rejectLimit'),
      productionFormula: opt('productionFormula'), rejectReason: text('rejectReason'),
      analysis: opt('analysis'),
    };
    const submitEntry = async () => {
      try {
        const result = await actions.rejectReports.appendDailyRejectEntry({
          reportId,
          expectedVersion: BigInt(addForm.dataset.version || '0'),
          entry,
        });
        if (result.error) {
          if (!showFieldErrors(addForm, result.error)) {
            addForm.dataset.unresolved = 'true';
            const code = String(result.error.code ?? '');
            const message = code === 'FORBIDDEN' || code === 'UNAUTHORIZED'
              ? 'You are not authorized to add an entry. Refresh the record or ask its owner or an administrator for the approved next step.'
              : code === 'CONFLICT'
                ? 'This record changed or is no longer a draft. Refresh it to review the latest entries before continuing.'
                : code === 'NOT_FOUND'
                  ? 'This record is no longer available. Return to the Reject reports list.'
                  : 'The service could not confirm the entry. Refresh the record and its history before deciding whether to retry.';
            showRecovery(message);
          }
          return;
        }
        location.reload();
      } catch {
        addForm.dataset.unresolved = 'true';
        showRecovery('The service did not confirm the result. Refresh the record and its history before deciding whether to retry.');
      } finally {
        addForm.dataset.pending = 'false';
        addForm.removeAttribute('aria-busy');
        if (submit) submit.disabled = addForm.dataset.unresolved === 'true';
      }
    };
    void submitEntry();
  });
  document.querySelectorAll<HTMLFormElement>('[data-review-form]').forEach((form) => form.addEventListener('submit', (event) => {
    event.preventDefault();
    const values = new FormData(form);
    const reason = String(values.get('reason') ?? '').trim();
    const action = String(values.get('reviewAction') ?? '') as 'SUBMIT_FOR_QC' | 'QC_REVIEW' | 'QC_RETURN' | 'SUPERVISOR_APPROVE';
    run(actions.rejectReports.transitionDailyRejectReview({ reportId,
      expectedVersion: BigInt(String(values.get('expectedVersion') ?? '0')),
      idempotencyKey: String(values.get('idempotencyKey') ?? ''), action, reason: reason || undefined }));
  }));
  document.querySelector<HTMLFormElement>('[data-void-form]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const reason = String(new FormData(form).get('reason') ?? '').trim();
    if (!reason) { fail('A void reason is required.'); return; }
    run(actions.rejectReports.voidReport({ reportId, expectedVersion: BigInt(form.dataset.version || '0'), reason }));
  });
</script>

<style>
