---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { rejectReportReadDependencies } from '../../../modules/reject-reports/application/dependencies.js';
import ErrorState from '../../../ui/components/feedback/ErrorState.astro';
import {
  ISSUE_SLIP_APPROVAL_ROLES,
  nextPendingApprovalRole,
} from '../../../modules/reject-reports/application/view-model.js';
import { stateLabel } from '../../../shared/copy/ux-vocabulary.js';
import { actions } from 'astro:actions';
import { field, parseExpectedVersionField } from '../../../ui/forms/mutation-post.js';

const actor = Astro.locals.actor;
if (!actor)
  return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const reportId = Astro.params.reportId ?? '';
const printMode = Astro.url.searchParams.get('print') === '1';
const deps = rejectReportReadDependencies();
const availability = await deps.availability.execute({ actor });
if (!availability.available) Astro.response.status = 503;
const slip = availability.available ? await deps.getIssueSlip.execute({ actor, reportId }) : null;
// Operational surfaces show a human identity, never the internal UUID (P1-3).
const creatorLabel = slip?.createdBy === actor.id ? 'You' : 'Another authorized user';
const hasPermission = (code: string) =>
  actor.permissions.some((grant) => grant.code === code && grant.active !== false);
const isCreator = slip?.createdBy === actor.id;
const canManage = isCreator && hasPermission('PERM-RREJ-EDIT');
const canConfirm = isCreator && hasPermission('PERM-RREJ-CONFIRM-APPROVAL');
let postError = '';
let postedValues: Record<string, string> = {};
if (Astro.request.method === 'POST' && slip && !printMode) {
  const form = await Astro.request.formData();
  postedValues = Object.fromEntries([...form.entries()].filter((entry): entry is [string, string] => typeof entry[1] === 'string'));
  const intent = field(form, 'intent');
  try {
    const expectedVersion = parseExpectedVersionField(field(form, 'expectedVersion'));
    let result;
    if (intent === 'confirm' && canConfirm) result = await Astro.callAction(actions.rejectReports.confirmApproval, { reportId, expectedVersion, role: field(form, 'role') as 'SUPERVISOR' | 'QC_MANAGER' | 'FACTORY_DIRECTOR', approverName: field(form, 'approverName') || undefined });
    else if (intent === 'reverse' && (canConfirm || hasPermission('PERM-RREJ-ADMIN-CORRECT'))) result = await Astro.callAction(actions.rejectReports.reverseApproval, { reportId, expectedVersion, role: field(form, 'role') as 'SUPERVISOR' | 'QC_MANAGER' | 'FACTORY_DIRECTOR', reason: field(form, 'reason') });
    else if (intent === 'issue' && canManage) result = await Astro.callAction(actions.rejectReports.issueIssueSlip, { reportId, expectedVersion });
    else if (intent === 'void' && isCreator && hasPermission('PERM-RREJ-VOID')) result = await Astro.callAction(actions.rejectReports.voidReport, { reportId, expectedVersion, reason: field(form, 'reason') });
    else postError = 'This action is not available. Refresh the report and review its current state.';
    if (result && !result.error) return Astro.redirect(Astro.url.pathname, 303);
    if (result?.error) postError = 'The action was not accepted. Review the current version, permissions, and approval history before trying again.';
  } catch {
    postError = 'The result could not be confirmed. Review this report and its approval history before deciding whether to try again.';
  }
}
// Checkpoints are sequential (SUPERVISOR -> QC_MANAGER -> FACTORY_DIRECTOR), so
// only the next pending checkpoint is confirmable; the server enforces the
// same rule and denies an out-of-order confirmation.
const nextApprovalRole = nextPendingApprovalRole(slip?.approvals ?? []);
const approvalLabel: Record<string, string> = {
  SUPERVISOR: 'Supervisor',
  QC_MANAGER: 'QC Manager',
  FACTORY_DIRECTOR: 'Factory Director',
};
const fmtDate = (d?: Date) =>
  d ? d.toLocaleDateString('en-SA', { timeZone: 'Asia/Riyadh' }) : '—';
const fmtDateTime = (d?: Date) =>
  d ? d.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' }) : '—';
---

<AppLayout title={slip ? `${slip.reportNo} · Issue Slip` : 'Issue Slip unavailable'} locale="en" direction="ltr">
  {!slip ? (
    <ErrorState
      title="Reject Reports are unavailable in this environment"
      description="This report could not be opened. No report was changed. Contact your system administrator, then try opening it again."
      retryHref="/reject-reports"
    />
  ) : (
  <>
  <section class="page-head">
    <div>
      <p class="eyebrow">Rejected material/product issue slip</p>
      <h1>{slip.reportNo}</h1>
      <p class="lede">
        Status: <strong class={`status status-${slip.status.toLowerCase()}`}>{stateLabel(slip.status)}</strong>
      </p>
    </div>
    <div class="head-actions">
      <a href="/reject-reports">Back to reject reports</a>
      <a href={`${Astro.url.pathname}?print=1`} target="_blank" rel="noopener">Print view</a>
    </div>
  </section>

  {printMode && <p class="print-copy-watermark">UNAPPROVED INFORMATIONAL COPY — NOT A CONTROLLED RECORD</p>}
  {postError && <p role="alert" tabindex="-1" data-post-error>{postError} <a href={`${Astro.url.pathname}#approval-confirmations`}>Review approval history</a></p>}
  <div class="grid">
    <section class="panel">
      <h2>Report</h2>
      <dl>
        <dt>Report date</dt><dd>{fmtDate(slip.reportDate)}</dd>
        <dt>Department / section</dt><dd>{slip.department}</dd>
        <dt>Recorded by</dt><dd>{creatorLabel}</dd>
        <dt>Created at</dt><dd>{fmtDateTime(slip.createdAt)}</dd>
        <dt>Issued at</dt><dd>{fmtDateTime(slip.issuedAt)}</dd>
        <dt>Completed at</dt><dd>{fmtDateTime(slip.completedAt)}</dd>
        {slip.voidedAt && (<><dt>Voided</dt><dd>{fmtDateTime(slip.voidedAt)} · {slip.voidReason}</dd></>)}
      </dl>
    </section>
    <section class="panel">
      <h2>Item &amp; quantity</h2>
      <dl>
        <dt>Item code</dt><dd>{slip.fields.itemCode}</dd>
        <dt>Item name</dt><dd>{slip.fields.itemName}</dd>
        <dt>Goods description</dt><dd>{slip.fields.goodsDescription ?? '—'}</dd>
        <dt>Lot / batch</dt><dd>{slip.fields.lotNo ?? '—'}</dd>
        <dt>Rejected quantity</dt><dd>{slip.fields.rejectedQty} {slip.fields.unit}</dd>
        <dt>Unit cost</dt><dd>{slip.fields.unitCost ?? '—'}</dd>
        <dt>Total value</dt><dd>{slip.fields.totalValue ?? '—'}</dd>
      </dl>
    </section>
    <section class="panel wide">
      <h2>Reject reason &amp; remarks</h2>
      <dl>
        <dt>Reject reason</dt><dd>{slip.fields.rejectReason}</dd>
        <dt>Remarks</dt><dd>{slip.fields.remarks ?? '—'}</dd>
      </dl>
    </section>
  </div>

  <section class="panel approvals" id="approval-confirmations">
    <h2>Approval confirmations</h2>
    <p class="hint">
      The report creator records that each real-world approval was obtained. These are
      confirmations recorded by the creator — not electronic signatures by the approvers.
    </p>
    <ol class="tracker">
      {ISSUE_SLIP_APPROVAL_ROLES.map((role) => {
        const confirmation = slip.approvals.find((a) => a.role === role);
        const state = confirmation?.status ?? 'PENDING';
        return (
          <li class={`step step-${state.toLowerCase()}`}>
            <span class={`dot dot-${state.toLowerCase()}`} aria-hidden="true"></span>
            <div class="step-body">
              <strong>{approvalLabel[role]}</strong>
              <span class="state">
                {state === 'CONFIRMED'
                  ? `Confirmed (recorded ${fmtDateTime(confirmation?.confirmedAt)}${confirmation?.approverName ? ` · approver: ${confirmation.approverName}` : ''})`
                  : state === 'REVERSED'
                    ? `Reversed ${fmtDateTime(confirmation?.reversedAt)} — ${confirmation?.reversalReason}`
                    : 'Pending'}
              </span>
              {confirmation?.note && <span class="note">{confirmation.note}</span>}
            </div>
            {!printMode && <div class="step-actions">
              {state === 'PENDING' && canConfirm && slip.status === 'APPROVAL_TRACKING' && role === nextApprovalRole && (
                <form class="inline-form" method="post" data-confirm-form={role} data-version={slip.version.toString()}>
                  <input type="hidden" name="intent" value="confirm" /><input type="hidden" name="role" value={role} /><input type="hidden" name="expectedVersion" value={slip.version.toString()} />
                  <label class="sr-only" for={`approver-${role}`}>Approver name (optional)</label>
                  <input id={`approver-${role}`} name="approverName" maxlength="200" placeholder="Approver name (optional)" value={postedValues.approverName ?? ''} />
                  <button type="submit">Confirm approval</button>
                </form>
              )}
              {state === 'PENDING' && canConfirm && slip.status === 'APPROVAL_TRACKING' && role !== nextApprovalRole && (
                <span class="hint">Confirm the earlier checkpoint first.</span>
              )}
              {state === 'CONFIRMED' && (canConfirm || hasPermission('PERM-RREJ-ADMIN-CORRECT')) && (
                <form class="inline-form" method="post" data-reverse-form={role} data-version={slip.version.toString()}>
                  <input type="hidden" name="intent" value="reverse" /><input type="hidden" name="role" value={role} /><input type="hidden" name="expectedVersion" value={slip.version.toString()} />
                  <label class="sr-only" for={`reason-${role}`}>Correction reason</label>
                  <input id={`reason-${role}`} name="reason" required maxlength="2000" placeholder="Correction reason (required)" value={postedValues.reason ?? ''} />
                  <button type="submit" class="secondary">Reverse confirmation</button>
                </form>
              )}
            </div>}
          </li>
        );
      })}
    </ol>
    <p role="status" data-result tabindex="-1"></p>
  </section>

  {!printMode && <section class="panel actions">
    <h2>Actions</h2>
    {slip.status === 'DRAFT' && canManage && (
      <form method="post" data-issue-form><input type="hidden" name="intent" value="issue" /><input type="hidden" name="expectedVersion" value={slip.version.toString()} /><button type="submit" data-issue data-version={slip.version.toString()}>Issue slip (start approval tracking)</button></form>
    )}
    {slip.status !== 'VOID' && slip.status !== 'COMPLETED' && isCreator && hasPermission('PERM-RREJ-VOID') && (
      <form class="inline-form" method="post" data-void-form data-version={slip.version.toString()}>
        <input type="hidden" name="intent" value="void" /><input type="hidden" name="expectedVersion" value={slip.version.toString()} />
        <label class="sr-only" for="voidReason">Void reason</label>
        <input id="voidReason" name="reason" required maxlength="2000" placeholder="Void reason (required)" value={postedValues.reason ?? ''} />
        <button type="submit" class="danger">Void report</button>
      </form>
    )}
    {slip.status === 'DRAFT' && !canManage && <p class="hint">Only the creator can issue or edit this draft.</p>}
  </section>}
  </>
  )}
</AppLayout>

<script>
  import { actions } from 'astro:actions';
  const reportId = location.pathname.split('/').filter(Boolean).pop() ?? '';
  const output = document.querySelector<HTMLElement>('[data-result]');
  const fail = (message: string) => {
    if (output) { output.textContent = message; output.focus?.(); }
  };
  const run = async (work: Promise<{ error?: unknown }>) => {
    try {
      const result = await work;
      if (result.error) fail('The action was not accepted. Refresh the record and check its current state and your permissions before trying again.');
      else location.reload();
    } catch {
      fail('The service did not confirm the result. Refresh the report and its history before deciding whether to try again.');
    }
  };
  type Role = 'SUPERVISOR' | 'QC_MANAGER' | 'FACTORY_DIRECTOR';
  document.querySelectorAll<HTMLFormElement>('[data-confirm-form]').forEach((form) =>
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const role = form.dataset.confirmForm as Role;
      const approverName = String(new FormData(form).get('approverName') ?? '').trim();
      run(
        actions.rejectReports.confirmApproval({
          reportId,
          expectedVersion: BigInt(form.dataset.version || '0'),
          role,
          approverName: approverName || undefined,
        }),
      );
    }),
  );
  document.querySelectorAll<HTMLFormElement>('[data-reverse-form]').forEach((form) =>
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const role = form.dataset.reverseForm as Role;
      const reason = String(new FormData(form).get('reason') ?? '').trim();
      if (!reason) { fail('A correction reason is required.'); return; }
      run(
        actions.rejectReports.reverseApproval({
          reportId,
          expectedVersion: BigInt(form.dataset.version || '0'),
          role,
          reason,
        }),
      );
    }),
  );
  document.querySelector<HTMLFormElement>('[data-issue-form]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const button = form.querySelector<HTMLElement>('[data-issue]');
    run(actions.rejectReports.issueIssueSlip({ reportId, expectedVersion: BigInt(button?.dataset.version || '0') }));
  });
  document.querySelector<HTMLFormElement>('[data-void-form]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const reason = String(new FormData(form).get('reason') ?? '').trim();
    if (!reason) { fail('A void reason is required.'); return; }
    run(actions.rejectReports.voidReport({ reportId, expectedVersion: BigInt(form.dataset.version || '0'), reason }));
  });
</script>

<style>
  .page-head{display:flex;justify-content:space-between;gap:var(--space-5);margin-bottom:var(--space-6)}
  h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}
  .lede,.hint{color:var(--text-muted);font-size:.86rem}
  .head-actions{display:flex;gap:var(--space-3);flex-wrap:wrap}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5)}
  .grid .wide{grid-column:1/-1}
  .panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);margin-bottom:var(--space-5)}
  h2{font-size:1rem;margin-top:0}
  dl{display:grid;grid-template-columns:auto 1fr;gap:.6rem 1.5rem}dt{color:var(--text-muted)}dd{margin:0;font-weight:600}
  .tracker{list-style:none;margin:0;padding:0;display:grid;gap:var(--space-3)}
  .step{display:flex;gap:var(--space-3);align-items:center;padding:var(--space-3);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md)}
  .dot{width:.8rem;height:.8rem;flex:0 0 .8rem;border-radius:50%;background:var(--text-muted)}
  .dot-confirmed{background:var(--status-success,#047857)}
  .dot-reversed{background:var(--status-warning,#b45309)}
  .step-body{display:grid;gap:.15rem;flex:1}
  .step-body .state{font-size:.8rem;color:var(--text-muted)}
  .step-body .note{font-size:.78rem}
  button{padding:.6rem 1rem;background:var(--color-accent-primary);border:0;border-radius:var(--radius-md);color:#fff;font-weight:700}
  button.secondary{background:transparent;color:var(--color-accent-primary-hover);border:1px solid var(--color-accent-primary)}
  button.danger{background:var(--status-danger)}
  .inline-form{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}
  .inline-form input{padding:.5rem;background:var(--surface-page);color:inherit;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm);min-width:12rem}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .actions{display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap}
  .actions h2{width:100%}
  .status{font-size:.72rem;padding:.15rem .5rem;border-radius:999px;background:var(--surface-page);border:1px solid var(--color-border-subtle)}
  a{color:var(--color-accent-primary-hover)}
  @media(max-width:768px){.page-head,.grid{display:block}.step{flex-wrap:wrap}}
  .print-copy-watermark{border-block:2px solid #111;padding:4px;text-align:center;font-weight:700}
  @media print{
    @page{size:A4 portrait;margin:12mm}
    .head-actions,.step-actions,.actions,.tabs{display:none!important}
    body{background:#fff}
    .panel{border-color:#999;break-inside:avoid}
  }
</style>
