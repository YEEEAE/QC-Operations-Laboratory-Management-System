---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import PageHeader from '../../ui/components/PageHeader.astro';
import ErrorState from '../../ui/components/feedback/ErrorState.astro';
import AppliedFilters from '../../ui/components/data/AppliedFilters.astro';
import FilterBar from '../../ui/components/data/FilterBar.astro';
import Pagination from '../../ui/components/data/Pagination.astro';
import { rejectReportReadDependencies } from '../../modules/reject-reports/application/dependencies.js';
import { parsePageInput } from '../../shared/pagination/page.js';
import { stateLabel } from '../../shared/copy/ux-vocabulary.js';
import type { RejectReportListFilter } from '../../modules/reject-reports/ports/repository.js';
import { REJECT_REPORT_STATUSES } from '../../modules/reject-reports/application/view-model.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Freject-reports');

const params = Astro.url.searchParams;
const allowedTabs = ['all', 'slips', 'daily', 'awaiting', 'completed'] as const;
const tabValue = params.get('tab') ?? 'all';
const tab = allowedTabs.includes(tabValue as (typeof allowedTabs)[number]) ? tabValue as (typeof allowedTabs)[number] : 'all';
const paging = parsePageInput({ page: params.get('page'), pageSize: params.get('pageSize') });
const dateFilter = (value: string | null) => {
  if (!value || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return undefined;
  const date = new Date(`${value}T00:00:00Z`);
  return Number.isNaN(date.getTime()) || date.toISOString().slice(0, 10) !== value ? undefined : date;
};
const statusValue = params.get('status');
const knownStatuses = REJECT_REPORT_STATUSES;
const filter: RejectReportListFilter = {
  search: params.get('q')?.slice(0, 200) || undefined,
  itemCode: params.get('itemCode')?.slice(0, 100) || undefined,
  itemName: params.get('itemName')?.slice(0, 200) || undefined,
  lot: params.get('lot')?.slice(0, 100) || undefined,
  department: params.get('department')?.slice(0, 200) || undefined,
  unit: params.get('unit')?.trim().slice(0, 40) || undefined,
  unitMissing: params.get('unitMissing') === 'on',
  type: tab === 'slips' || tab === 'awaiting' || tab === 'completed' ? 'ISSUE_SLIP' : tab === 'daily' ? 'DAILY_REJECT' : undefined,
  status: knownStatuses.includes(statusValue as (typeof knownStatuses)[number]) ? statusValue as RejectReportListFilter['status'] : undefined,
  approvalState: tab === 'awaiting' ? 'AWAITING' : tab === 'completed' ? 'COMPLETED' : undefined,
  from: dateFilter(params.get('from')),
  to: dateFilter(params.get('to')),
};
const invalidDateRange = Boolean(filter.from && filter.to && filter.from > filter.to);
if (invalidDateRange) { filter.from = undefined; filter.to = undefined; }
const invalidDate = Boolean((params.has('from') && !dateFilter(params.get('from'))) || (params.has('to') && !dateFilter(params.get('to'))));
const deps = rejectReportReadDependencies();
// Fail closed with an honest availability state when the database behind this
// deployment has not been provisioned for Reject reports. The previous
// behaviour was a generic 500 inviting a retry for a permanent gap (P1-4).
const availability = await deps.availability.execute({ actor });
if (!availability.available) Astro.response.status = 503;
const availabilityError = availability.reason === 'SCHEMA_NOT_READY'
  ? {
      title: 'Reject reports are temporarily unavailable',
      description: 'The system could not confirm that Reject reports are ready to open. No records were changed. Try again later or contact your system administrator.',
    }
  : {
      title: 'Reject reports are temporarily unavailable',
      description: 'The system could not confirm that Reject reports are ready to open. No records were changed. Try again later or contact your system administrator.',
    };
const showSlips = tab !== 'daily';
const showDaily = tab === 'all' || tab === 'daily';
const emptyPage = { items: [], total: 0 } as const;
const [slips, daily, dashboard] = availability.available
  ? await Promise.all([
      showSlips
        ? deps.listIssueSlips.execute({ actor, filter, page: paging })
        : Promise.resolve(emptyPage),
      showDaily
        ? deps.listDailyRejects.execute({ actor, filter, page: paging })
        : Promise.resolve(emptyPage),
      deps.dashboard.execute({ actor, filter }),
    ])
  : ([emptyPage, emptyPage, null] as const);
const { summary, analytics, recent } = dashboard ?? {
  summary: {
    reportsToday: 0,
    reportsThisMonth: 0,
    rejectedByUnit: [],
    totalIssueSlips: 0,
    totalDailyRejects: 0,
    awaitingApprovals: 0,
    completedIssueSlips: 0,
    finalizedDailyRejects: 0,
  },
  analytics: {
    trendByDate: [],
    byItem: [],
    byDepartment: [],
    byReason: [],
    topRejectItems: [],
    approvalStatus: [],
    rejectPctTrend: [],
  },
  recent: [],
};
const drilldownHref = (point: (typeof analytics.trendByDate)[number]) => {
  const next = new URLSearchParams(params);
  next.delete('page');
  next.set('tab', point.reportType === 'ISSUE_SLIP' ? 'slips' : 'daily');
  next.set('from', point.date);
  next.set('to', point.date);
  next.delete('unit');
  next.delete('unitMissing');
  if (point.unit === 'Unit not recorded') next.set('unitMissing', 'on');
  else next.set('unit', point.unit);
  return `/reject-reports?${next.toString()}`;
};
const tabHref = (value: (typeof allowedTabs)[number]) => {
  const next = new URLSearchParams(params);
  next.delete('page');
  next.set('tab', value);
  return `/reject-reports?${next.toString()}`;
};
const canCreate = actor.permissions.some(
  (grant) => grant.code === 'PERM-RREJ-CREATE' && grant.active !== false,
);
const tabs = [
  { id: 'all', label: 'All' },
  { id: 'slips', label: 'Issue slips' },
  { id: 'daily', label: 'Daily reject' },
  { id: 'awaiting', label: 'Awaiting approvals' },
  { id: 'completed', label: 'Completed' },
] as const;
const fmtDate = (d: Date) => d.toLocaleDateString('en-SA', { timeZone: 'Asia/Riyadh' });
const hasAnalytics = Boolean(summary.rejectedByUnit.length || analytics.trendByDate.length || analytics.topRejectItems.length || analytics.byReason.length || analytics.byDepartment.length || analytics.approvalStatus.length || analytics.rejectPctTrend.length);

// Applied filters are the values the server actually applied above. Each chip
// drops one parameter and resets paging while preserving the rest.
const hasFilters = Boolean(
  filter.search ||
    filter.itemCode ||
    filter.itemName ||
    filter.lot ||
    filter.department ||
    filter.unit ||
    filter.unitMissing ||
    filter.status ||
    filter.from ||
    filter.to,
);
const clearFiltersHref = tab === 'all' ? '/reject-reports' : `/reject-reports?tab=${tab}`;
const chipHref = (drop: string) => {
  const next = new URLSearchParams(params);
  next.delete(drop);
  next.delete('page');
  const search = next.toString();
  return `/reject-reports${search ? `?${search}` : ''}`;
};
const dayParam = (value: Date) => value.toISOString().slice(0, 10);
const appliedFilters = [
  filter.search && { label: 'Search', value: filter.search, href: chipHref('q') },
  filter.itemCode && { label: 'Item code', value: filter.itemCode, href: chipHref('itemCode') },
  filter.itemName && { label: 'Item name', value: filter.itemName, href: chipHref('itemName') },
  filter.lot && { label: 'Lot', value: filter.lot, href: chipHref('lot') },
  filter.department && {
    label: 'Department',
    value: filter.department,
    href: chipHref('department'),
  },
  filter.unit && { label: 'Recorded unit', value: filter.unit, href: chipHref('unit') },
  filter.unitMissing && { label: 'Missing unit', value: 'Included', href: chipHref('unitMissing') },
  filter.status && { label: 'Status', value: stateLabel(filter.status), href: chipHref('status') },
  filter.from && { label: 'From', value: dayParam(filter.from), href: chipHref('from') },
  filter.to && { label: 'To', value: dayParam(filter.to), href: chipHref('to') },
].filter((chip): chip is { label: string; value: string; href: string } => Boolean(chip));

// One canonical status region for the register: the server-derived row counts.
const slipsTotalPages = Math.max(1, Math.ceil(slips.total / paging.pageSize));
const dailyTotalPages = Math.max(1, Math.ceil(daily.total / paging.pageSize));
const rangeText = (result: { items: readonly unknown[]; total: number }, noun: string) => {
  if (result.total === 0) return `0 ${noun}`;
  if (!result.items.length) return `0 of ${result.total} ${noun}`;
  const start = (paging.page - 1) * paging.pageSize + 1;
  const end = start + result.items.length - 1;
  return `${start}–${end} of ${result.total} ${noun}`;
};
const countParts = [
  showSlips && rangeText(slips, `issue slip${slips.total === 1 ? '' : 's'}`),
  showDaily && rangeText(daily, `daily reject record${daily.total === 1 ? '' : 's'}`),
].filter((part): part is string => Boolean(part));
const countText = `${countParts.join(' · ')}${hasFilters ? ' matching the applied filters' : ' in your authorized scope'}`;
// One canonical filter-validation region. The server ignored the date filters,
// so the message states exactly that instead of silently dropping input.
const filterNotice = invalidDateRange
  ? 'Start date must be on or before end date. Both date filters were ignored.'
  : invalidDate
    ? 'Enter dates in YYYY-MM-DD format. Invalid date filters were ignored.'
    : undefined;
---

<AppLayout title="Reject reports · QC Operations" locale="en" direction="ltr">
  {
    !availability.available ? (
      <ErrorState title={availabilityError.title} description={availabilityError.description} retryHref="/reject-reports" />
    ) : (
      <div class="reject-register">
        <PageHeader purpose="Issue slips record approval confirmations. Daily rejects need no approval.">
          <Fragment slot="heading"><h1>Reject reports</h1></Fragment>
          <Fragment slot="actions">{canCreate && <a class="button" href="/reject-reports/new">Create report</a>}</Fragment>
        </PageHeader>

        {/* READ and FILTER use the existing server reads and the native GET
            contract. EXPORT is N/A: this register exposes no export action.
            AUTH is the login redirect above; approvals, void, and daily-record
            edits are N/A on this read surface. */}
        <nav class="tabs" aria-label="Report views">
          {tabs.map((t) => (
            <a href={tabHref(t.id)} aria-current={tab === t.id ? 'page' : undefined}>{t.label}</a>
          ))}
        </nav>

        <section class="filter-panel" aria-labelledby="reject-filter-heading">
          <div class="filter-panel-heading">
            <h2 id="reject-filter-heading">Find reject reports</h2>
            <p>
              Filters are applied by the server. Issue slips and daily reject records share the
              same page number.
            </p>
          </div>
          {filterNotice && <p class="filter-notice" role="alert">{filterNotice}</p>}
          <FilterBar
            label="Reject report filters"
            clearHref={hasFilters ? clearFiltersHref : undefined}
          >
            <input type="hidden" name="tab" value={tab} />
            <label for="q">Search<input id="q" name="q" type="search" value={filter.search ?? ''} maxlength="200" placeholder="Report no, item, lot, reason" /></label>
            <label for="itemCode">Item code<input id="itemCode" name="itemCode" value={filter.itemCode ?? ''} maxlength="100" /></label>
            <label for="itemName">Item name<input id="itemName" name="itemName" value={filter.itemName ?? ''} maxlength="200" /></label>
            <label for="lot">Lot<input id="lot" name="lot" value={filter.lot ?? ''} maxlength="100" /></label>
            <label for="department">Department<input id="department" name="department" value={filter.department ?? ''} maxlength="200" /></label>
            <label for="unit">Recorded unit<input id="unit" name="unit" value={filter.unit ?? ''} maxlength="40" /></label>
            <label class="check" for="unitMissing">Include missing unit<input id="unitMissing" name="unitMissing" type="checkbox" checked={filter.unitMissing} /></label>
            <label for="status">Status<select id="status" name="status"><option value="">Any status</option>{knownStatuses.map((status) => <option value={status} selected={filter.status === status}>{stateLabel(status)}</option>)}</select></label>
            <label for="from">From<input id="from" name="from" type="date" value={params.get('from') ?? ''} /></label>
            <label for="to">To<input id="to" name="to" type="date" value={params.get('to') ?? ''} /></label>
          </FilterBar>
        </section>

        <AppliedFilters filters={appliedFilters} clearHref={hasFilters ? clearFiltersHref : undefined} />

        <p class="result-count" role="status" aria-live="polite">{countText}</p>

        {showSlips && (
          <section class="register" aria-labelledby="slips-register-title">
            <h2 id="slips-register-title">Issue slips ({slips.total})</h2>
            {slips.items.length ? (
              <>
                <div class="table-wrap" role="region" aria-label="Issue slip register table" tabindex="0">
                  <table>
                    <caption>
                      Rejected material/product issue slips in your authorized scope. Report
                      numbers, item names, and lots are shown in full.
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">Report no</th>
                        <th scope="col">Date</th>
                        <th scope="col">Item</th>
                        <th scope="col">Lot</th>
                        <th scope="col">Qty</th>
                        <th scope="col">Department</th>
                        <th scope="col">Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      {slips.items.map((slip) => (
                        <tr>
                          <th scope="row" class="report-number"><a href={`/reject-reports/issue-slips/${slip.id}`}>{slip.reportNo}</a></th>
                          <td class="date">{fmtDate(slip.reportDate)}</td>
                          <td class="item"><span class="item-code">{slip.fields.itemCode}</span> · <span class="item-name">{slip.fields.itemName}</span></td>
                          <td class="lot">{slip.fields.lotNo ?? '—'}</td>
                          <td class="quantity">{slip.fields.rejectedQty} {slip.fields.unit}</td>
                          <td class="department">{slip.department}</td>
                          <td class="state-cell"><span class={`status status-${slip.status.toLowerCase()}`}>{stateLabel(slip.status)}</span></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <Pagination
                  page={paging.page}
                  totalPages={slipsTotalPages}
                  total={slips.total}
                  itemLabel="issue slips"
                />
              </>
            ) : <p class="empty">No Issue slips match the current filters.</p>}
          </section>
        )}

        {showDaily && (
          <section class="register" aria-labelledby="daily-register-title">
            <h2 id="daily-register-title">Daily production and rejection records ({daily.total})</h2>
            {daily.items.length ? (
              <>
                <div class="table-wrap" role="region" aria-label="Daily reject register table" tabindex="0">
                  <table>
                    <caption>
                      Daily production and rejection records in your authorized scope. Rejected
                      quantity by recorded unit is shown on each record and is not totalled here.
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">Record no</th>
                        <th scope="col">Date</th>
                        <th scope="col">Department</th>
                        <th scope="col">Entries</th>
                        <th scope="col">Reject qty</th>
                        <th scope="col">Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      {daily.items.map((record) => (
                        <tr>
                          <th scope="row" class="report-number"><a href={`/reject-reports/daily/${record.id}`}>{record.reportNo}</a></th>
                          <td class="date">{fmtDate(record.reportDate)}</td>
                          <td class="department">{record.department}</td>
                          <td class="entries">{record.entries.length}</td>
                          <td class="quantity-note">Open record for exact totals by unit</td>
                          <td class="state-cell"><span class={`status status-${record.status.toLowerCase()}`}>{stateLabel(record.status)}</span></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <Pagination
                  page={paging.page}
                  totalPages={dailyTotalPages}
                  total={daily.total}
                  itemLabel="daily reject records"
                />
              </>
            ) : <p class="empty">No Daily reject records match the current filters.</p>}
          </section>
        )}

        <section class="summary" aria-label="Summary for current filters">
          <div class="cards">
            <div class="card"><span>Reports today</span><strong>{summary.reportsToday}</strong></div>
            <div class="card"><span>Reports this month</span><strong>{summary.reportsThisMonth}</strong></div>
            <div class="card"><span>Issue slips</span><strong>{summary.totalIssueSlips}</strong></div>
            <div class="card"><span>Daily reject records</span><strong>{summary.totalDailyRejects}</strong></div>
            <div class="card warn"><span>Awaiting approvals</span><strong>{summary.awaitingApprovals}</strong></div>
            <div class="card"><span>Completed Issue slips</span><strong>{summary.completedIssueSlips}</strong></div>
            <div class="card"><span>Finalized Daily reject</span><strong>{summary.finalizedDailyRejects}</strong></div>
          </div>
        </section>

        <details class="analytics-disclosure" open={hasAnalytics}>
          <summary>Reject analytics{!hasAnalytics && ' · No matching data'}</summary>
          <section class="panel quantities" aria-labelledby="qty-heading">
            <h2 id="qty-heading">Rejected quantity by report type and recorded unit</h2>
            <p>Units are shown as recorded. Values from different units or report types are not added together.</p>
            {summary.rejectedByUnit.length ? <ul class="rank">
              {summary.rejectedByUnit.map((row) => (
                <li><span>{row.reportType === 'ISSUE_SLIP' ? 'Issue slip' : 'Daily reject'} · {row.unit}</span><strong>{row.rejectedQty} ({row.reportCount} reports)</strong></li>
              ))}
            </ul> : <p class="empty">No quantities match the current filters.</p>}
          </section>

          <section class="analytics" aria-label="Analytics">
            <div class="panel">
              <h2>Reject trend by date, report type and recorded unit</h2>
              {analytics.trendByDate.length ? (
                <div class="table-wrap" role="region" aria-label="Reject trend table" tabindex="0"><table>
                  <caption>Exact recorded quantities; no unit conversion is applied.</caption>
                  <thead><tr><th scope="col">Date</th><th scope="col">Report type</th><th scope="col">Recorded unit</th><th scope="col">Rejected qty</th><th scope="col">Reports</th><th scope="col">Open matching records</th></tr></thead>
                  <tbody>
                  {analytics.trendByDate.map((point) => (
                    <tr><td>{point.date}</td><td>{point.reportType === 'ISSUE_SLIP' ? 'Issue slip' : 'Daily reject'}</td><td>{point.unit}</td><td>{point.rejectedQty}</td><td>{point.reportCount}</td><td><a href={drilldownHref(point)}>Open date and unit filter</a></td></tr>
                  ))}
                  </tbody></table></div>
              ) : <p class="empty">No data in range.</p>}
            </div>
            <div class="panel">
              <h2>Top reject items</h2>
              {analytics.topRejectItems.length ? (
                <ol class="rank">
                  {analytics.topRejectItems.map((item) => (
                    <li><span>{item.reportType === 'ISSUE_SLIP' ? 'Issue slip' : 'Daily reject'} · {item.itemCode} · {item.itemName} · {item.unit}</span><strong>{item.rejectedQty}</strong></li>
                  ))}
                </ol>
              ) : <p class="empty">No data.</p>}
            </div>
            <div class="panel">
              <h2>Reject reasons</h2>
              {analytics.byReason.length ? (
                <ol class="rank">
                  {analytics.byReason.slice(0, 8).map((row) => (
                    <li><span>{row.reason}</span><strong>{row.count}</strong></li>
                  ))}
                </ol>
              ) : <p class="empty">No data.</p>}
            </div>
            <div class="panel">
              <h2>By department</h2>
              {analytics.byDepartment.length ? (
                <ol class="rank">
                  {analytics.byDepartment.map((row) => (
                    <li><span>{row.reportType === 'ISSUE_SLIP' ? 'Issue slip' : 'Daily reject'} · {row.department} · {row.unit}</span><strong>{row.rejectedQty} ({row.reportCount} reports)</strong></li>
                  ))}
                </ol>
              ) : <p class="empty">No data.</p>}
            </div>
            <div class="panel">
              <h2>Issue Slip approval status</h2>
              {analytics.approvalStatus.length ? (
                <p class="big">
                  {analytics.approvalStatus[0].completed} confirmed · {analytics.approvalStatus[0].pending} pending
                </p>
              ) : <p class="empty">No data.</p>}
            </div>
            <div class="panel">
              <h2>Reject % trend (daily records)</h2>
              {analytics.rejectPctTrend.length ? (
                <ol class="rank">
                  {analytics.rejectPctTrend.map((row) => (
                    <li><span>{row.date} · {row.unit}</span><strong>{row.rejectPct === null ? '—' : `${row.rejectPct}%`}</strong></li>
                  ))}
                </ol>
              ) : <p class="empty">No data.</p>}
            </div>
          </section>
        </details>

        <section class="recent-panel" aria-labelledby="recent-heading">
          <h2 id="recent-heading">Recent reports</h2>
          {recent.length ? (
            <ul class="recent">
              {recent.map((report) => (
                <li>
                  <a href={report.reportNo.startsWith('RIS') ? `/reject-reports/issue-slips/${report.id}` : `/reject-reports/daily/${report.id}`}>
                    {report.reportNo}
                  </a>
                  <span>{report.department} · {fmtDate(report.reportDate)} · {stateLabel(report.status)}</span>
                </li>
              ))}
            </ul>
          ) : <p class="empty">No reports yet.</p>}
        </section>
      </div>
    )
  }
</AppLayout>

<style>
  .reject-register {
    min-inline-size: 0;
    inline-size: 100%;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 44px;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-accent-primary);
    border-radius: var(--radius-sm);
    background: var(--color-accent-primary);
    color: var(--text-on-accent);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
  }
  .tabs a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: var(--space-4);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }
  .tabs a[aria-current='page'] {
    background: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    color: var(--text-on-accent);
    font-weight: var(--font-weight-semibold);
  }
  .filter-panel {
    margin-block-end: var(--space-4);
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--border-default);
    border-radius: var(--card-radius);
  }
  .filter-panel-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-block-end: var(--space-4);
  }
  .filter-panel-heading h2 {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--font-size-md);
  }
  .filter-panel-heading p {
    margin: 0;
    max-inline-size: 55ch;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    line-height: 1.5;
  }
  .filter-panel :global(.filters) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    align-items: end;
    gap: var(--space-3);
    margin: 0;
  }
  .filter-panel :global(label),
  .filter-panel :global(input),
  .filter-panel :global(select) {
    min-inline-size: 0;
    max-inline-size: 100%;
  }
  .filter-panel :global(input),
  .filter-panel :global(select) {
    inline-size: 100%;
  }
  .filter-panel :global(.check) {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 44px;
    inline-size: auto;
  }
  .filter-panel :global(input[type='checkbox']) {
    inline-size: auto;
    min-inline-size: 0;
    accent-color: var(--color-accent-primary);
