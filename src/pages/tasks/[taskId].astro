---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import { taskReadDependencies } from '../../modules/tasks/application/dependencies.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const taskId = Astro.params.taskId ?? '';
const task = await taskReadDependencies().get.execute({ actor, taskId });
---
<AppLayout title={`${task.taskNo} · Tasks`} locale="en" direction="ltr"><section class="page-head"><div><p class="eyebrow">T3 RECORD WORKSPACE</p><h1>{task.title}</h1><p class="lede">{task.taskNo} · Version {task.version.toString()}</p></div><a href="/tasks">Back to Tasks</a></section><div class="grid"><section class="panel"><h2>Overview</h2><dl><dt>State</dt><dd>{task.state}</dd><dt>Priority</dt><dd>{task.priority}</dd><dt>Assignee</dt><dd>{task.currentAssigneeId ?? 'Unassigned'}</dd><dt>Due date</dt><dd>{task.dueAt?.toLocaleString('en-SA', { timeZone: 'Asia/Riyadh' }) ?? 'Not set'}</dd></dl><p>{task.description ?? 'No description.'}</p></section><section class="panel"><h2>Checklist</h2>{task.checklist.length ? <ul>{task.checklist.map((item) => <li>{item.completed ? '✓' : '○'} {item.label}{item.required ? ' (required)' : ''}</li>)}</ul> : <p>No checklist items.</p>}</section></div><section class="panel actions"><h2>Authorized actions</h2><p>State changes require a server-side action and the current version.</p>{task.state === 'DRAFT' && <button data-action="ACTIVATE" data-version={task.version.toString()}>Activate</button>}{task.state === 'OPEN' && <button data-action="START" data-version={task.version.toString()}>Start</button>}{(task.state === 'OPEN' || task.state === 'IN_PROGRESS') && <button data-action="HOLD" data-version={task.version.toString()}>Put on hold</button>}{task.state === 'IN_PROGRESS' && <button data-action="COMPLETE" data-version={task.version.toString()}>Complete</button>}{task.state === 'ON_HOLD' && <button data-action="RESUME" data-version={task.version.toString()}>Resume</button>}{task.state === 'COMPLETED' && <button data-action="REOPEN" data-version={task.version.toString()}>Reopen</button>}<p role="status" data-result></p></section></AppLayout>
<script>import { actions } from 'astro:actions'; document.querySelectorAll('[data-action]').forEach((button)=>button.addEventListener('click',async()=>{const b=button; const result=await actions.tasks.transition({taskId:location.pathname.split('/').pop()||'',expectedVersion:BigInt(b.dataset.version||'0'),action:b.dataset.action}); const output=document.querySelector('[data-result]'); if(result.error){if(output) output.textContent='The action was not applied. Refresh and try again if authorized.';} else location.reload();}));</script>
<style>.page-head{display:flex;justify-content:space-between;gap:var(--space-5);margin-bottom:var(--space-6)}h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.panel p{color:var(--text-muted);font-size:.86rem}.grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);margin-bottom:var(--space-5)}h2{font-size:1rem;margin-top:0}dl{display:grid;grid-template-columns:auto 1fr;gap:.6rem 1.5rem}dt{color:var(--text-muted)}dd{margin:0;font-weight:700}li{margin:.6rem 0}.actions{display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap}.actions h2,.actions p{width:100%}button{padding:.65rem 1rem;background:var(--color-accent-primary);border:0;border-radius:var(--radius-md);color:#fff;font-weight:700}a{color:var(--color-accent-primary-hover)}@media(max-width:700px){.page-head,.grid{display:block}}
</style>
