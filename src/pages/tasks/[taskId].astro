---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import { taskReadDependencies } from '../../modules/tasks/application/dependencies.js';
import { priorityLabel, stateLabel } from '../../shared/copy/ux-vocabulary.js';
import { formatDateTime } from '../../shared/copy/format.js';
import { actorHasScope } from '../../shared/authorization/scope-evaluator.js';
import { classifyReadFailure, providerUnavailableResponse } from '../../shared/errors/read-failure.js';
import { actions } from 'astro:actions';
import FormErrorSummary from '../../ui/components/FormErrorSummary.astro';
import { extractDetailId, field, parseExpectedVersionField, toFormFailure, type FormFailure } from '../../ui/forms/mutation-post.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const taskId = Astro.params.taskId ?? '';
const REQUIRED_FIELDS = [{ name: 'reason', label: 'Reason' }] as const;
let transitionValues = { action: '', expectedVersion: '', reason: '' };
let transitionFailure: FormFailure | null = null;
let details;
try {
  details = await taskReadDependencies().get.execute({ actor, taskId });
} catch (error) {
  if (classifyReadFailure(error) === 'UNAVAILABLE') {
    return providerUnavailableResponse('Task details are temporarily unavailable', Astro.url.pathname + Astro.url.search);
  }
  return Astro.redirect('/404');
}
const { task } = details;
const canTaskAction = (code: string) => {
  const grant = actor.permissions.find((item) => item.code === code && item.active !== false);
  return Boolean(
    grant &&
      actorHasScope(
        actor,
        { type: 'TASK', id: task.id, state: task.state, ownerId: task.createdBy, assigneeId: task.currentAssigneeId },
        { ownerId: task.createdBy, assigneeId: task.currentAssigneeId },
        grant,
      ),
  );
};
const nextStep = ({
  DRAFT: canTaskAction('PERM-TASK-CREATE') ? 'Activate when the draft is ready.' : 'Wait for an authorized user to activate this draft.',
  OPEN: canTaskAction('PERM-TASK-EDIT') ? 'Start the work when it is ready to begin.' : 'Wait for an authorized user to start the work.',
  IN_PROGRESS: canTaskAction('PERM-TASK-COMPLETE') || canTaskAction('PERM-TASK-BLOCK') ? 'Complete the work when requirements are met, or place it on hold with a reason.' : 'Wait for an authorized user to complete or hold the work.',
  ON_HOLD: canTaskAction('PERM-TASK-EDIT') ? 'Resume work when the blocker is resolved.' : 'Wait for an authorized user to resume the work.',
  COMPLETED: canTaskAction('PERM-TASK-REOPEN') ? 'Reopen with a reason if more work is needed.' : 'Task complete. Reopening requires separate permission.',
  CANCELLED: 'No further action is available.',
} as const)[task.state];
const actionLabel = (action: string) => ({
  CREATE_TASK: 'Created',
  UPDATE_DRAFT: 'Draft updated',
  ACTIVATE: 'Activated',
  START: 'Started',
  HOLD: 'Placed on hold',
  RESUME: 'Resumed',
  COMPLETE: 'Completed',
  REOPEN: 'Reopened',
}[action] ?? 'Task updated');
const reasonError = () => transitionFailure?.fieldErrors.reason;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  transitionValues = {
    action: field(formData, 'action'),
    expectedVersion: field(formData, 'expectedVersion'),
    reason: String(formData.get('reason') ?? ''),
  };
  try {
    const data = await Astro.callAction(actions.tasks.transition, {
      taskId,
      expectedVersion: parseExpectedVersionField(transitionValues.expectedVersion),
      action: transitionValues.action as 'ACTIVATE' | 'START' | 'HOLD' | 'RESUME' | 'COMPLETE' | 'REOPEN',
      ...(transitionValues.reason.trim() ? { reason: transitionValues.reason.trim() } : {}),
    });
    const id = extractDetailId(data);
    if (id === taskId) return Astro.redirect(`/tasks/${id}`, 303);
    transitionFailure = {
      kind: 'unknown',
      summary: 'The action result could not be confirmed.',
      recovery: 'Review this task and its transition history before deciding whether to try again.',
      fieldErrors: {},
      firstInvalidField: null,
    };
  } catch (error) {
    transitionFailure = toFormFailure(error, {
      entity: 'task action',
      requiredFields: REQUIRED_FIELDS,
      values: transitionValues,
      listHref: `/tasks/${taskId}?reconcile=1#transition-history`,
      listLabel: 'task transition history',
    });
    if (transitionFailure.kind === 'unavailable' || transitionFailure.kind === 'unknown') {
      transitionFailure = {
        ...transitionFailure,
        summary: 'The action result could not be confirmed.',
        recovery: 'Review this task and its transition history before deciding whether to try again.',
      };
    }
  }
}
---

<AppLayout title={`${task.taskNo} · Tasks`} locale="en" direction="ltr">
  <section class="page-head"><div><p class="eyebrow">Task</p><h1>{task.title}</h1><p class="lede">{task.taskNo} · Version {task.version.toString()}</p></div><a href="/tasks">Back to tasks</a></section>
  <div class="grid">
    <section class="panel"><h2>Overview</h2><dl><dt>Owner</dt><dd>{details.ownerDisplayName}</dd><dt>Assignee</dt><dd>{details.assigneeDisplayName}</dd><dt>Priority</dt><dd>{priorityLabel(task.priority)}</dd><dt>Due date</dt><dd>{task.dueAt ? <time datetime={task.dueAt.toISOString()}>{formatDateTime(task.dueAt)}</time> : 'Not set'}</dd><dt>State</dt><dd>{stateLabel(task.state)}</dd><dt>Version</dt><dd>{task.version.toString()}</dd><dt>Next step</dt><dd>{nextStep}</dd></dl><p>{task.description ?? 'No description.'}</p></section>
    <section class="panel"><h2>Related record and recurrence</h2>{task.specializedRecord ? details.specializedRecordHref ? <p><a href={details.specializedRecordHref}>Open related {task.specializedRecord.type.replaceAll('_', ' ').toLowerCase()}</a></p> : <p>{details.specializedRecordUnavailable ? 'The related record could not be checked. Try again later.' : 'The related record is not available in your current view scope.'}</p> : <p>No specialized record reference.</p>}{task.recurrence && <p>Rule: {task.recurrence.ruleId} · UTC occurrence: {task.recurrence.occurrenceKey}</p>}<p>Task completion does not approve or change the related record.</p></section>
    <section class="panel"><h2>Checklist</h2>{task.checklist.length ? <ul>{task.checklist.map((item) => <li><span>{item.completed ? 'Complete:' : 'Pending:'}</span> {item.label}{item.required ? ' (required)' : ''}</li>)}</ul> : <p>No checklist items.</p>}</section>
  </div>
    <section class="panel actions"><h2>Available actions</h2><p>State changes require permission for this task and its current version.</p>{transitionFailure && <FormErrorSummary summary={transitionFailure.summary} recovery={transitionFailure.recovery} errors={Object.entries(transitionFailure.fieldErrors).map(([fieldId, message]) => ({ fieldId, message }))} listHref={`/tasks/${taskId}?reconcile=1#transition-history`} listLabel="task transition history" />}<form method="post" data-task-transition><input type="hidden" name="expectedVersion" value={task.version.toString()} /><input type="hidden" data-action-input value={transitionValues.action} /><label for="reason">Reason <span>(required for hold and reopen)</span></label><textarea id="reason" name="reason" data-reason rows="3" aria-invalid={reasonError() ? 'true' : undefined} aria-describedby={reasonError() ? 'reason-error' : undefined}>{transitionValues.reason}</textarea>{reasonError() && <p class="field-error" id="reason-error">{reasonError()}</p>}{task.state === 'DRAFT' && canTaskAction('PERM-TASK-CREATE') && <button type="submit" name="action" value="ACTIVATE" data-submit>Activate</button>}{task.state === 'OPEN' && canTaskAction('PERM-TASK-EDIT') && <button type="submit" name="action" value="START" data-submit>Start</button>}{(task.state === 'OPEN' || task.state === 'IN_PROGRESS') && canTaskAction('PERM-TASK-BLOCK') && <button type="submit" name="action" value="HOLD" data-submit>Put on hold</button>}{task.state === 'IN_PROGRESS' && canTaskAction('PERM-TASK-COMPLETE') && <button type="submit" name="action" value="COMPLETE" data-submit>Complete</button>}{task.state === 'ON_HOLD' && canTaskAction('PERM-TASK-EDIT') && <button type="submit" name="action" value="RESUME" data-submit>Resume</button>}{task.state === 'COMPLETED' && canTaskAction('PERM-TASK-REOPEN') && <button type="submit" name="action" value="REOPEN" data-submit>Reopen</button>}<p role="status" data-result tabindex="-1"></p></form></section>
  <section class="panel" id="transition-history"><h2>Transition history</h2>{details.history.length ? <ol class="history">{details.history.map((event) => <li><div><strong>{actionLabel(event.action)}</strong><span>{event.oldState || event.newState ? ` · ${event.oldState ? stateLabel(event.oldState) : ''}${event.oldState && event.newState ? ' to ' : ''}${event.newState ? stateLabel(event.newState) : ''}` : ''}</span></div><p><time datetime={event.occurredAt.toISOString()}>{formatDateTime(event.occurredAt)}</time> · {event.actorLabel}{event.reason ? ` · ${event.reason}` : ''}</p></li>)}</ol> : <p>No recorded changes.</p>}</section>
</AppLayout>

<script>
  import { actions } from 'astro:actions';
  import { enhanceClassifiedForm } from '../../ui/forms/enhance-with-classification';
  import { guardUnsavedChanges } from '../../ui/forms/unsaved-changes';
  const validTransitions = ['ACTIVATE', 'START', 'COMPLETE', 'CANCEL', 'RESUME', 'HOLD', 'REOPEN'] as const;
  const currentTaskId = location.pathname.split('/').pop() || '';
  const form = document.querySelector<HTMLFormElement>('[data-task-transition]');
  if (form) {
    const actionInput = form.querySelector<HTMLInputElement>('[data-action-input]');
    const reason = form.querySelector<HTMLTextAreaElement>('[data-reason]');
    form.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[name="action"]');
      if (button) {
        if (actionInput) actionInput.value = button.value;
        if (reason) reason.required = button.value === 'HOLD' || button.value === 'REOPEN';
      }
    });
    enhanceClassifiedForm(form, {
      invoke: async (payload) => actions.tasks.transition(payload as Parameters<typeof actions.tasks.transition>[0]),
      payload: (data) => ({ taskId: location.pathname.split('/').pop() || '', expectedVersion: BigInt(String(data.get('expectedVersion') || '0')), action: String(actionInput?.value || data.get('action') || '') as (typeof validTransitions)[number], ...(String(data.get('reason') || '').trim() ? { reason: String(data.get('reason')).trim() } : {}) }),
      progressText: 'Updating task state…',
      detailBaseHref: '/tasks',
      unknownRecoveryHref: `/tasks/${currentTaskId}?reconcile=1#transition-history`,
    });
    guardUnsavedChanges(form);
  }
</script>

<style>
  .page-head{display:flex;justify-content:space-between;gap:var(--space-5);margin-bottom:var(--space-6)}h1{margin:.25rem 0}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede,.panel p{overflow-wrap:anywhere;color:var(--text-muted);font-size:.86rem}.grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5)}.panel{padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);margin-bottom:var(--space-5)}h2{font-size:1rem;margin-top:0}dl{display:grid;grid-template-columns:auto 1fr;gap:.6rem 1.5rem}dt{color:var(--text-muted)}dd{margin:0;font-weight:700}li{margin:.6rem 0}.actions{display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap}.actions h2,.actions p,.actions label,.actions textarea{width:100%}textarea{font:inherit;resize:vertical;padding:.6rem;background:var(--surface-page);color:inherit;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}button{padding:.65rem 1rem;background:var(--color-accent-primary);border:0;border-radius:var(--radius-md);color:#fff;font-weight:700}a{color:var(--color-accent-primary-hover)}.history{padding-inline-start:1.5rem}.history time{font-variant-numeric:tabular-nums}@media(max-width:700px){.page-head,.grid{display:block}}
</style>
