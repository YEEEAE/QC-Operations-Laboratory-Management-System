---
import PageHeader from "../../ui/components/PageHeader.astro";
import AppLayout from '../../ui/layouts/AppLayout.astro';
import { taskReadDependencies } from '../../modules/tasks/application/dependencies.js';
import { priorityLabel, stateLabel } from '../../shared/copy/ux-vocabulary.js';
import { formatDateTime } from '../../shared/copy/format.js';
import { actorHasScope } from '../../shared/authorization/scope-evaluator.js';
import { classifyReadFailure, providerUnavailableResponse } from '../../shared/errors/read-failure.js';
import { actions } from 'astro:actions';
import FormErrorSummary from '../../ui/components/FormErrorSummary.astro';
import { extractDetailId, field, parseExpectedVersionField, toFormFailure, type FormFailure } from '../../ui/forms/mutation-post.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const taskId = Astro.params.taskId ?? '';
const REQUIRED_FIELDS = [{ name: 'reason', label: 'Reason' }] as const;
let transitionValues = { action: '', expectedVersion: '', reason: '' };
let transitionFailure: FormFailure | null = null;
let details;
try {
  details = await taskReadDependencies().get.execute({ actor, taskId });
} catch (error) {
  if (classifyReadFailure(error) === 'UNAVAILABLE') {
    return providerUnavailableResponse('Task details are temporarily unavailable', Astro.url.pathname + Astro.url.search);
  }
  return Astro.redirect('/404');
}
const { task } = details;
const canTaskAction = (code: string) => {
  const grant = actor.permissions.find((item) => item.code === code && item.active !== false);
  return Boolean(
    grant &&
      actorHasScope(
        actor,
        { type: 'TASK', id: task.id, state: task.state, ownerId: task.createdBy, assigneeId: task.currentAssigneeId },
        { ownerId: task.createdBy, assigneeId: task.currentAssigneeId },
        grant,
      ),
  );
};
const nextStep = ({
  DRAFT: canTaskAction('PERM-TASK-CREATE') ? 'Activate when the draft is ready.' : 'Wait for an authorized user to activate this draft.',
  OPEN: canTaskAction('PERM-TASK-EDIT') ? 'Start the work when it is ready to begin.' : 'Wait for an authorized user to start the work.',
  IN_PROGRESS: canTaskAction('PERM-TASK-COMPLETE') || canTaskAction('PERM-TASK-BLOCK') ? 'Complete the work when requirements are met, or place it on hold with a reason.' : 'Wait for an authorized user to complete or hold the work.',
  ON_HOLD: canTaskAction('PERM-TASK-EDIT') ? 'Resume work when the blocker is resolved.' : 'Wait for an authorized user to resume the work.',
  COMPLETED: canTaskAction('PERM-TASK-REOPEN') ? 'Reopen with a reason if more work is needed.' : 'Task complete. Reopening requires separate permission.',
  CANCELLED: 'No further action is available.',
} as const)[task.state];
const actionLabel = (action: string) => ({
  CREATE_TASK: 'Created',
  UPDATE_DRAFT: 'Draft updated',
  ACTIVATE: 'Activated',
  START: 'Started',
  HOLD: 'Placed on hold',
  RESUME: 'Resumed',
  COMPLETE: 'Completed',
  REOPEN: 'Reopened',
}[action] ?? 'Task updated');
const reasonError = () => transitionFailure?.fieldErrors.reason;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  transitionValues = {
    action: field(formData, 'action'),
    expectedVersion: field(formData, 'expectedVersion'),
    reason: String(formData.get('reason') ?? ''),
  };
  try {
    const data = await Astro.callAction(actions.tasks.transition, {
      taskId,
      expectedVersion: parseExpectedVersionField(transitionValues.expectedVersion),
      action: transitionValues.action as 'ACTIVATE' | 'START' | 'HOLD' | 'RESUME' | 'COMPLETE' | 'REOPEN',
      ...(transitionValues.reason.trim() ? { reason: transitionValues.reason.trim() } : {}),
    });
    const id = extractDetailId(data);
    if (id === taskId) return Astro.redirect(`/tasks/${id}`, 303);
    transitionFailure = {
      kind: 'unknown',
      summary: 'The action result could not be confirmed.',
      recovery: 'Review this task and its transition history before deciding whether to try again.',
      fieldErrors: {},
      firstInvalidField: null,
    };
  } catch (error) {
    transitionFailure = toFormFailure(error, {
      entity: 'task action',
      requiredFields: REQUIRED_FIELDS,
      values: transitionValues,
      listHref: `/tasks/${taskId}?reconcile=1#transition-history`,
      listLabel: 'task transition history',
    });
    if (transitionFailure.kind === 'unavailable' || transitionFailure.kind === 'unknown') {
      transitionFailure = {
        ...transitionFailure,
        summary: 'The action result could not be confirmed.',
        recovery: 'Review this task and its transition history before deciding whether to try again.',
      };
    }
  }
}
---

<AppLayout title={`${task.taskNo} · Tasks`} locale="en" direction="ltr">
  <PageHeader purpose="Task record and current workflow state."><Fragment slot="heading"><h1>{task.title}</h1></Fragment><p class="lede"><span class="record-id">{task.taskNo}</span><span class="record-state">{stateLabel(task.state)}</span><span>Version {task.version.toString()}</span></p><Fragment slot="actions"><a href="/tasks">Back to tasks</a></Fragment></PageHeader>
  <div class="detail-layout">
    <div class="detail-main">
      <section class="panel" aria-labelledby="task-facts-heading">
        <div class="section-heading"><p class="eyebrow">Record</p><h2 id="task-facts-heading">Task facts</h2></div>
        <dl class="facts"><dt>Owner</dt><dd>{details.ownerDisplayName}</dd><dt>Assignee</dt><dd>{details.assigneeDisplayName}</dd><dt>Priority</dt><dd>{priorityLabel(task.priority)}</dd><dt>Due date</dt><dd>{task.dueAt ? <time datetime={task.dueAt.toISOString()}>{formatDateTime(task.dueAt)}</time> : 'Not set'}</dd><dt>Next step</dt><dd>{nextStep}</dd></dl>
        <div class="description"><h3>Description</h3><p>{task.description ?? 'No description.'}</p></div>
      </section>

      <section class="panel" aria-labelledby="checklist-heading">
        <div class="section-heading"><p class="eyebrow">Evidence</p><h2 id="checklist-heading">Checklist</h2></div>
        {task.checklist.length ? <ul class="checklist">{task.checklist.map((item) => <li><span class={item.completed ? 'checklist-state list-complete' : 'checklist-state'}>{item.completed ? 'Complete' : 'Pending'}</span><span class="checklist-label">{item.label}{item.required ? ' (required)' : ''}</span></li>)}</ul> : <p class="muted">No checklist items.</p>}
      </section>

      <section class="panel" id="transition-history" aria-labelledby="history-heading">
        <div class="section-heading"><p class="eyebrow">Record history</p><h2 id="history-heading">Transition history</h2></div>
        {details.history.length ? <ol class="history">{details.history.map((event) => <li><div class="history-event"><strong>{actionLabel(event.action)}</strong><span>{event.oldState || event.newState ? `${event.oldState ? stateLabel(event.oldState) : ''}${event.oldState && event.newState ? ' to ' : ''}${event.newState ? stateLabel(event.newState) : ''}` : ''}</span></div><p><time datetime={event.occurredAt.toISOString()}>{formatDateTime(event.occurredAt)}</time><span aria-hidden="true"> · </span>{event.actorLabel}{event.reason ? <><span aria-hidden="true"> · </span>{event.reason}</> : null}</p></li>)}</ol> : <p class="muted">No recorded changes.</p>}
      </section>
    </div>

    <aside class="detail-rail" aria-label="Task relationships and actions">
      <section class="panel" aria-labelledby="relationships-heading">
        <div class="section-heading"><p class="eyebrow">Linked context</p><h2 id="relationships-heading">Relationships</h2></div>
        {task.specializedRecord ? details.specializedRecordHref ? <p><a href={details.specializedRecordHref}>Open related {task.specializedRecord.type.replaceAll('_', ' ').toLowerCase()}</a></p> : <p class="muted">{details.specializedRecordUnavailable ? 'The related record could not be checked. Try again later.' : 'The related record is not available in your current view scope.'}</p> : <p class="muted">No specialized record reference.</p>}
        {task.recurrence ? <dl class="compact-facts"><dt>Rule</dt><dd>{task.recurrence.ruleId}</dd><dt>UTC occurrence</dt><dd>{task.recurrence.occurrenceKey}</dd></dl> : null}
        <p class="boundary-note">Task completion does not approve or change the related record.</p>
      </section>

      <section class="panel action-panel" aria-labelledby="actions-heading">
        <div class="section-heading"><p class="eyebrow">Current controls</p><h2 id="actions-heading">Available actions</h2></div>
        <p class="muted">State changes require permission for this task and its current version.</p>
        {transitionFailure && <FormErrorSummary summary={transitionFailure.summary} recovery={transitionFailure.recovery} errors={Object.entries(transitionFailure.fieldErrors).map(([fieldId, message]) => ({ fieldId, message }))} listHref={`/tasks/${taskId}?reconcile=1#transition-history`} listLabel="task transition history" />}
        <form method="post" data-task-transition>
          <input type="hidden" name="expectedVersion" value={task.version.toString()} />
          <input type="hidden" data-action-input value={transitionValues.action} />
          <label for="reason">Reason <span>(required for hold and reopen)</span></label>
          <textarea id="reason" name="reason" data-reason rows="3" aria-invalid={reasonError() ? 'true' : undefined} aria-describedby={reasonError() ? 'reason-error' : undefined}>{transitionValues.reason}</textarea>
          {reasonError() && <p class="field-error" id="reason-error">{reasonError()}</p>}
          <div class="action-buttons">
            {task.state === 'DRAFT' && canTaskAction('PERM-TASK-CREATE') && <button type="submit" name="action" value="ACTIVATE" data-submit>Activate</button>}
            {task.state === 'OPEN' && canTaskAction('PERM-TASK-EDIT') && <button type="submit" name="action" value="START" data-submit>Start</button>}
            {(task.state === 'OPEN' || task.state === 'IN_PROGRESS') && canTaskAction('PERM-TASK-BLOCK') && <button type="submit" name="action" value="HOLD" data-submit>Put on hold</button>}
            {task.state === 'IN_PROGRESS' && canTaskAction('PERM-TASK-COMPLETE') && <button type="submit" name="action" value="COMPLETE" data-submit>Complete</button>}
            {task.state === 'ON_HOLD' && canTaskAction('PERM-TASK-EDIT') && <button type="submit" name="action" value="RESUME" data-submit>Resume</button>}
            {task.state === 'COMPLETED' && canTaskAction('PERM-TASK-REOPEN') && <button type="submit" name="action" value="REOPEN" data-submit>Reopen</button>}
          </div>
          <p role="status" data-result tabindex="-1"></p>
        </form>
      </section>
    </aside>
  </div>
</AppLayout>

<script>
  import { actions } from 'astro:actions';
  import { enhanceClassifiedForm } from '../../ui/forms/enhance-with-classification';
  import { guardUnsavedChanges } from '../../ui/forms/unsaved-changes';
  const validTransitions = ['ACTIVATE', 'START', 'COMPLETE', 'CANCEL', 'RESUME', 'HOLD', 'REOPEN'] as const;
  const currentTaskId = location.pathname.split('/').pop() || '';
  const form = document.querySelector<HTMLFormElement>('[data-task-transition]');
  if (form) {
    const actionInput = form.querySelector<HTMLInputElement>('[data-action-input]');
    const reason = form.querySelector<HTMLTextAreaElement>('[data-reason]');
    form.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[name="action"]');
      if (button) {
        if (actionInput) actionInput.value = button.value;
        if (reason) reason.required = button.value === 'HOLD' || button.value === 'REOPEN';
      }
    });
    enhanceClassifiedForm(form, {
      invoke: async (payload) => actions.tasks.transition(payload as Parameters<typeof actions.tasks.transition>[0]),
      payload: (data) => ({ taskId: location.pathname.split('/').pop() || '', expectedVersion: BigInt(String(data.get('expectedVersion') || '0')), action: String(actionInput?.value || data.get('action') || '') as (typeof validTransitions)[number], ...(String(data.get('reason') || '').trim() ? { reason: String(data.get('reason')).trim() } : {}) }),
      progressText: 'Updating task state…',
      detailBaseHref: '/tasks',
      unknownRecoveryHref: `/tasks/${currentTaskId}?reconcile=1#transition-history`,
    });
    guardUnsavedChanges(form);
  }
</script>

<style>
  .lede{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-2) var(--space-4);margin-block:var(--space-3) 0;color:var(--text-secondary);font-size:var(--font-size-sm)}
  .record-id,.history time,.compact-facts dd{font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.record-state{padding:.2rem .65rem;border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);font-weight:var(--font-weight-semibold)}
  .detail-layout{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(17rem,.8fr);align-items:start;gap:var(--space-5)}.detail-main,.detail-rail{min-width:0;min-inline-size:0}.panel{min-width:0;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg);margin-block-end:var(--space-5)}
  .section-heading{margin-block-end:var(--space-4)}.eyebrow{margin:0 0 var(--space-1);color:var(--text-muted);font-size:var(--font-size-xs);font-weight:var(--font-weight-semibold)}h2{margin:0;font-size:var(--font-size-lg);line-height:var(--line-height-tight)}h3{margin:0 0 var(--space-2);font-size:var(--font-size-md)}
  .facts,.compact-facts{display:grid;grid-template-columns:minmax(7.5rem,.7fr) minmax(0,1.3fr);gap:var(--space-3) var(--space-4);margin:0}.facts dt,.compact-facts dt{color:var(--text-muted)}.facts dd,.compact-facts dd{min-width:0;margin:0;font-weight:var(--font-weight-semibold);overflow-wrap:anywhere}.description{margin-block-start:var(--space-5);padding-block-start:var(--space-4);border-block-start:1px solid var(--color-border-subtle)}.description p,.panel p{max-width:72ch;overflow-wrap:anywhere;color:var(--text-secondary);font-size:var(--font-size-sm);line-height:var(--line-height-relaxed)}.description p{margin:0}.muted{color:var(--text-secondary)}.compact-facts{grid-template-columns:minmax(6.5rem,.55fr) minmax(0,1.45fr);margin-block-start:var(--space-4);font-size:var(--font-size-sm)}
  .checklist{display:grid;gap:var(--space-3);margin:0;padding:0;list-style:none}.checklist li{display:grid;grid-template-columns:minmax(5.5rem,auto) minmax(0,1fr);gap:var(--space-3);align-items:start;padding-block-start:var(--space-3);border-block-start:1px solid var(--color-border-subtle)}.checklist-state{font-weight:var(--font-weight-semibold);color:var(--text-secondary)}.list-complete{color:var(--status-success)}.checklist-label{min-width:0;overflow-wrap:anywhere}.history{display:grid;gap:var(--space-4);margin:0;padding-inline-start:1.25rem}.history li{padding-inline-start:var(--space-1);overflow-wrap:anywhere}.history-event{display:flex;flex-wrap:wrap;gap:var(--space-2);align-items:baseline}.history-event span{color:var(--text-secondary)}.history p{margin-block:var(--space-1) 0}.history time{font-variant-numeric:tabular-nums}.boundary-note{margin-block-start:var(--space-4);padding-block-start:var(--space-3);border-block-start:1px solid var(--color-border-subtle)}
  .action-panel form{display:grid;gap:var(--space-3)}.action-panel label{font-weight:var(--font-weight-semibold)}.action-panel label span{font-weight:var(--font-weight-regular);color:var(--text-secondary)}textarea{inline-size:100%;min-block-size:5rem;resize:vertical;padding:var(--space-3);font:inherit;line-height:var(--line-height-normal);background:var(--surface-page);color:var(--text-primary);border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}textarea:focus-visible{outline:2px solid var(--color-accent-primary);outline-offset:2px}.field-error{margin:0;color:var(--status-danger)}.action-buttons{display:flex;flex-wrap:wrap;gap:var(--space-2)}button{min-block-size:44px;padding-inline:var(--space-4);background:var(--color-accent-primary);border:0;border-radius:var(--radius-md);color:var(--text-on-accent);font:inherit;font-weight:var(--font-weight-semibold);cursor:pointer}button:focus-visible,a:focus-visible{outline:2px solid var(--color-accent-primary);outline-offset:2px}a{color:var(--color-accent-primary-hover);overflow-wrap:anywhere}
  @media(max-width:900px){.detail-layout{grid-template-columns:minmax(0,1fr)}}
  @media(max-width:600px){.facts,.compact-facts{grid-template-columns:minmax(0,1fr);gap:var(--space-1)}.facts dd,.compact-facts dd{margin-block-end:var(--space-2)}.checklist li{grid-template-columns:minmax(0,1fr);gap:var(--space-1)}}
  @media print{.detail-layout{grid-template-columns:minmax(0,1fr)}.panel{break-inside:avoid-page}}
</style>
