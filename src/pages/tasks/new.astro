---
import AppLayout from '../../ui/layouts/AppLayout.astro';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Ftasks%2Fnew');
const canCreate = actor.permissions.some((grant) => grant.code === 'PERM-TASK-CREATE' && grant.active !== false);
---
<AppLayout title="Create Task · QC Operations" locale="en" direction="ltr"><section class="page-head"><p class="eyebrow">T2 OPERATIONAL WORK QUEUE</p><h1>Create Task</h1><p class="lede">New tasks start as controlled drafts.</p></section>{canCreate ? <form class="form" data-task-create><label>Task number<input name="taskNo" required /></label><label>Title<input name="title" required /></label><label>Description<textarea name="description"></textarea></label><label>Priority<input name="priority" required value="UNSPECIFIED" /></label><label>Due date<input name="dueAt" type="datetime-local" /></label><div class="actions"><button type="submit">Save Draft</button><a href="/tasks">Cancel</a></div><p role="status" data-result></p></form> : <p class="empty">You are not authorized to create tasks.</p>}</AppLayout>
<script>import { actions } from 'astro:actions'; const form=document.querySelector('[data-task-create]'); form?.addEventListener('submit',async(event)=>{event.preventDefault(); const data=new FormData(form); const result=await actions.tasks.createTask({taskNo:String(data.get('taskNo')),title:String(data.get('title')),description:String(data.get('description')||''),priority:String(data.get('priority')),dueAt:data.get('dueAt')?new Date(String(data.get('dueAt'))):undefined}); const output=form.querySelector('[data-result]'); if(result.error){if(output) output.textContent='Unable to save this task.';} else if(result.data){window.location.href='/tasks/'+result.data.id;}});</script>
<style>.page-head{margin-bottom:var(--space-6)}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}h1{margin:.25rem 0}.lede,.empty{color:var(--text-muted)}.form{display:grid;gap:var(--space-4);max-width:720px;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}label{display:grid;gap:.4rem;font-size:.85rem}input,textarea{font:inherit;padding:.7rem;background:var(--surface-page);color:inherit;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}textarea{min-height:8rem}.actions{display:flex;gap:var(--space-3);align-items:center}button{border:0;padding:.7rem 1rem;background:var(--color-accent-primary);color:#fff;border-radius:var(--radius-md);font-weight:700}a{color:var(--color-accent-primary-hover)}
</style>
