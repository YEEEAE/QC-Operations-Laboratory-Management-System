---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import FormErrorSummary from '../../ui/components/FormErrorSummary.astro';
import { actions } from 'astro:actions';
import {
  detailHref,
  extractDetailId,
  field,
  toFormFailure,
  type FormFailure,
} from '../../ui/forms/mutation-post.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Ftasks%2Fnew');
const canCreate = actor.permissions.some(
  (grant) => grant.code === 'PERM-TASK-CREATE' && grant.active !== false,
);

const LIST_HREF = '/tasks';
const REQUIRED_FIELDS = [
  { name: 'taskNo', label: 'Task number' },
  { name: 'title', label: 'Title' },
] as const;

let values = { taskNo: '', title: '', description: '', priority: '', dueAt: '', recordType: '', recordId: '', recurrenceRuleId: '', occurrenceKey: '' };
let failure: FormFailure | null = null;

// POST baseline (F-05): without JavaScript the form performs a real POST to
// this page. The same Astro Action — with the same server-side
// reauthorization — runs via Astro.callAction. No business payload enters
// the URL: input travels in the POST body, success redirects (303) to the
// new record only.
if (Astro.request.method === 'POST' && canCreate) {
  const formData = await Astro.request.formData();
  const dueRaw = field(formData, 'dueAt');
  values = {
    taskNo: field(formData, 'taskNo'),
    title: field(formData, 'title'),
    description: field(formData, 'description'),
    priority: field(formData, 'priority') || 'UNSPECIFIED',
    dueAt: dueRaw,
    recordType: field(formData, 'recordType'),
    recordId: field(formData, 'recordId'),
    recurrenceRuleId: field(formData, 'recurrenceRuleId'),
    occurrenceKey: field(formData, 'occurrenceKey'),
  };
  try {
    const data = await Astro.callAction(actions.tasks.createTask, {
      ...(values.recordType || values.recordId ? { specializedRecord: { type: values.recordType as 'DOCUMENT' | 'LAB_TEST' | 'CHANGE_REQUEST' | 'FINDING' | 'NCR' | 'RCA' | 'CAPA', id: values.recordId } } : {}),
      ...(values.recurrenceRuleId || values.occurrenceKey ? { recurrenceRuleId: values.recurrenceRuleId, occurrenceKey: values.occurrenceKey } : {}),
      taskNo: values.taskNo,
      title: values.title,
      description: values.description || undefined,
      priority: values.priority,
      ...(dueRaw ? { dueAt: new Date(dueRaw) } : {}),
    });
    const id = extractDetailId(data);
    if (id) return Astro.redirect(detailHref(LIST_HREF, id), 303);
    failure = {
      kind: 'unknown',
      summary: 'The task creation result could not be confirmed.',
      recovery: 'Check the task list before trying again to avoid a duplicate.',
      fieldErrors: {},
      firstInvalidField: null,
    };
  } catch (error) {
    failure = toFormFailure(error, {
      entity: 'Task',
      requiredFields: REQUIRED_FIELDS,
      values,
      listHref: LIST_HREF,
      listLabel: 'tasks',
    });
  }
}

const describedBy = (name: keyof typeof values): string | undefined =>
  failure?.fieldErrors[name] ? `${name}-error` : undefined;
const invalid = (name: keyof typeof values): 'true' | undefined =>
  failure?.fieldErrors[name] ? 'true' : undefined;
---
<AppLayout title="Create task · QC Operations" locale="en" direction="ltr"><section class="page-head"><p class="eyebrow">Work queue</p><h1>Create task</h1><p class="lede">New tasks start as drafts.</p></section>{canCreate ? <form class="form" method="post" data-task-create><div class="actions-top"><a href="/tasks">Back to tasks</a></div>{failure && <FormErrorSummary summary={failure.summary} recovery={failure.recovery} errors={Object.entries(failure.fieldErrors).map(([fieldId, message]) => ({ fieldId, message }))} listHref={LIST_HREF} listLabel="tasks" />}<section class="draft-summary" aria-label="Draft details"><h2>After saving</h2><dl><dt>Owner</dt><dd>You (signed-in account)</dd><dt>Priority</dt><dd>Entered value, or Not specified</dd><dt>Due date</dt><dd>Selected date, or Not set</dd><dt>State</dt><dd>Draft</dd><dt>Version</dt><dd>1</dd><dt>Next step</dt><dd>Activate the draft when it is ready</dd></dl><p>Transition history appears after a state change.</p></section><label for="taskNo">Task number<span class="hint" id="taskNo-help">Use the task number from your approved source. Reference numbers are assigned automatically.</span><input id="taskNo" name="taskNo" required value={values.taskNo} aria-invalid={invalid('taskNo')} aria-describedby={failure?.fieldErrors.taskNo ? 'taskNo-error taskNo-help' : 'taskNo-help'} /></label>{failure?.fieldErrors.taskNo && <p class="field-error" id="taskNo-error">{failure.fieldErrors.taskNo}</p>}<label for="title">Title<input id="title" name="title" required value={values.title} aria-invalid={invalid('title')} aria-describedby={describedBy('title')} /></label>{failure?.fieldErrors.title && <p class="field-error" id="title-error">{failure.fieldErrors.title}</p>}<label for="description">Description<textarea id="description" name="description" aria-invalid={invalid('description')} aria-describedby={describedBy('description')}>{values.description}</textarea></label>{failure?.fieldErrors.description && <p class="field-error" id="description-error">{failure.fieldErrors.description}</p>}<label for="priority">Priority<span class="hint" id="priority-help">Leave blank if no priority is assigned. It will show as “Not specified”.</span><input id="priority" name="priority" placeholder="Not specified" value={values.priority === 'UNSPECIFIED' ? '' : values.priority} aria-invalid={invalid('priority')} aria-describedby={failure?.fieldErrors.priority ? 'priority-error priority-help' : 'priority-help'} /></label>{failure?.fieldErrors.priority && <p class="field-error" id="priority-error">{failure.fieldErrors.priority}</p>}<label for="dueAt">Due date<input id="dueAt" name="dueAt" type="datetime-local" value={values.dueAt} aria-invalid={invalid('dueAt')} aria-describedby={describedBy('dueAt')} /></label>{failure?.fieldErrors.dueAt && <p class="field-error" id="dueAt-error">{failure.fieldErrors.dueAt}</p>}<fieldset><legend>Related specialized record (optional)</legend><p class="hint">A reference keeps ownership and decisions in the original application. Your current permission to view that record is required.</p><label for="recordType">Record type<select id="recordType" name="recordType"><option value="">No reference</option>{['DOCUMENT','LAB_TEST','CHANGE_REQUEST','FINDING','NCR','RCA','CAPA'].map(type => <option value={type} selected={values.recordType === type}>{type.replaceAll('_', ' ')}</option>)}</select></label><label for="recordId">Record identity<input id="recordId" name="recordId" value={values.recordId} /></label></fieldset><fieldset><legend>Recurring occurrence (optional)</legend><p class="hint">Enter both the established rule identity and the exact UTC occurrence to generate one draft. An identical retry returns the same task. Changed input for the same pair is refused.</p><label for="recurrenceRuleId">Rule identity<input id="recurrenceRuleId" name="recurrenceRuleId" maxlength="120" value={values.recurrenceRuleId} /></label><label for="occurrenceKey">UTC occurrence<input id="occurrenceKey" name="occurrenceKey" placeholder="2026-10-08T00:00:00.000Z" value={values.occurrenceKey} /></label></fieldset><div class="actions"><a href="/tasks">Cancel</a><button type="submit" data-submit>Save draft</button></div><p role="status" data-result tabindex="-1"></p></form> : <p class="empty">You are not authorized to create tasks.</p>}</AppLayout>
<script>
  import { actions } from 'astro:actions';
  import { enhanceClassifiedForm } from '../../ui/forms/enhance-with-classification';
  import { guardUnsavedChanges } from '../../ui/forms/unsaved-changes';
  const form = document.querySelector<HTMLFormElement>('[data-task-create]');
  if (form) {
    enhanceClassifiedForm(form, {
      invoke: async (payload) => actions.tasks.createTask(payload as Parameters<typeof actions.tasks.createTask>[0]),
      payload: (data) => {
        const dueAt = String(data.get('dueAt') ?? '');
        return {
          ...(data.get('recordType') || data.get('recordId') ? { specializedRecord: { type: String(data.get('recordType')) as 'DOCUMENT' | 'LAB_TEST' | 'CHANGE_REQUEST' | 'FINDING' | 'NCR' | 'RCA' | 'CAPA', id: String(data.get('recordId') ?? '') } } : {}),
          ...(data.get('recurrenceRuleId') || data.get('occurrenceKey') ? { recurrenceRuleId: String(data.get('recurrenceRuleId') ?? ''), occurrenceKey: String(data.get('occurrenceKey') ?? '') } : {}),
          taskNo: String(data.get('taskNo') ?? ''),
          title: String(data.get('title') ?? ''),
          description: String(data.get('description') ?? '') || undefined,
          priority: String(data.get('priority') || 'UNSPECIFIED'),
          ...(dueAt ? { dueAt: new Date(dueAt) } : {}),
        };
      },
      progressText: 'Saving task draft…',
      detailBaseHref: '/tasks',
      unknownRecoveryHref: '/tasks',
    });
    guardUnsavedChanges(form);
  }
</script>
<style>.page-head{margin-bottom:var(--space-6)}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}h1{margin:.25rem 0}.lede,.empty,.hint,.draft-summary p{color:var(--text-muted)}.form{display:grid;gap:var(--space-4);max-width:720px;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.draft-summary{padding:var(--space-4);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md)}.draft-summary h2{margin:0 0 var(--space-3);font-size:1rem}.draft-summary dl{display:grid;grid-template-columns:minmax(7rem,auto) 1fr;gap:.5rem 1rem;margin:0}.draft-summary dt{color:var(--text-muted)}.draft-summary dd{margin:0;font-weight:600}.draft-summary p{margin-bottom:0}fieldset{min-inline-size:0;display:grid;gap:var(--space-3);border:1px solid var(--color-border-subtle)}label{display:grid;gap:.4rem;font-size:.85rem}input,textarea,select{min-width:0;max-width:100%;font:inherit;padding:.7rem;background:var(--surface-page);color:inherit;border:1px solid var(--color-border-subtle);border-radius:var(--radius-sm)}input[aria-invalid="true"],textarea[aria-invalid="true"]{border-color:var(--status-danger)}.field-error{margin:0;color:var(--status-danger);font-size:.8rem}textarea{min-height:8rem}.actions,.actions-top{display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap}button{border:0;padding:.7rem 1rem;background:var(--color-accent-primary);color:#fff;border-radius:var(--radius-md);font-weight:700}button[disabled]{opacity:.6}a{color:var(--color-accent-primary-hover)}
</style>
