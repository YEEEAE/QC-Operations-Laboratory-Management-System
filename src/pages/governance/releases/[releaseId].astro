---
import AppLayout from '../../../ui/layouts/AppLayout.astro';
import { RELEASE_GATE_KEYS, getReleaseApprovalPageModel } from '../../../modules/release-governance/application/capability.js';
const actor = Astro.locals.actor;
if (!actor) return Astro.redirect('/login?returnTo=%2Fgovernance%2Freleases');
const releaseId = Astro.params.releaseId ?? '';
const model = await getReleaseApprovalPageModel({ actor, releaseId });
const { candidate, evidence } = model;
const reasonCopy = (reason: string) => {
  if (reason === 'AUTHORITY') return 'An active Manager or the named yazeed / SYSTEM_OWNER signer is required.';
  if (reason === 'RELEASE_NOT_FOUND') return 'The release candidate is unavailable.';
  if (reason === 'STATE_NOT_PENDING') return 'This candidate is no longer pending approval.';
  if (reason.startsWith('GATE:')) return `${reason.slice(5)} has no current signed evidence for this exact candidate, or its latest result is not PASS.`;
  if (reason.startsWith('RISK:')) return `Controlled risk ${reason.slice(5)} is unresolved or lacks accepted authority evidence.`;
  return reason;
};
---
<AppLayout title="Production release approval · Governance" locale="en" direction="ltr">
  <main class="release-shell">
    <h1>Production release approval</h1>
    {candidate ? <>
      <p class="lede">Release {candidate.releaseId} · State: {candidate.state} · Version: {candidate.version.toString()}</p>
      <section class="decision" aria-labelledby="decision-heading"><h2 id="decision-heading">Production decision: NO-GO</h2><p>The approved production baseline requires 19/19 mandatory gates on this exact candidate. This page currently reconciles eight release evidence classes; it does not contain an accepted 19-gate register, so these rows cannot produce an overall GO or RELEASED decision.</p><ul><li>Current candidate SHA: <code>{candidate.gitSha}</code></li><li>Current build: <code>{candidate.buildId}</code></li><li>Full 19-gate reconciliation: NOT VERIFIED</li></ul></section>
      <dl class="identity"><div><dt>Git SHA</dt><dd>{candidate.gitSha}</dd></div><div><dt>Build ID</dt><dd>{candidate.buildId}</dd></div><div><dt>Application version</dt><dd>{candidate.applicationVersion}</dd></div><div><dt>Migration head</dt><dd>{candidate.migrationHead}</dd></div><div><dt>UAT cycle</dt><dd>{candidate.uatCycleId}</dd></div></dl>
      {!model.authorized && <p role="alert" class="denied">Your account is not a release authority. Final approval requires Manager or yazeed / SYSTEM_OWNER; Admin alone is denied.</p>}
      {candidate.state !== 'PENDING' && <p role="status" class="denied">This release candidate is not pending approval.</p>}
      <section aria-labelledby="evidence-heading" class="approve-panel">
        <h2 id="evidence-heading">Server-derived release evidence</h2>
        <p class="lede">Gate truth is read-only and comes from trusted evidence for this exact release identity. Browser form data cannot set PASS, UAT, signatures, or risk status.</p>
        <div class="table-wrap"><table><caption>Release gates for {candidate.releaseId} at build {candidate.buildId}</caption><thead><tr><th scope="col">Gate</th><th scope="col">Status</th><th scope="col">Evidence reference</th><th scope="col">Source</th><th scope="col">Observed</th><th scope="col">Exact identity</th></tr></thead><tbody>
          {RELEASE_GATE_KEYS.map((gate) => { const record = evidence?.gateRecords[gate]; const status = evidence?.gates[gate] ?? 'UNVERIFIED'; return <tr><th scope="row">{gate}</th><td><span class={'status status-' + status.toLowerCase()}>{status}</span></td><td>{record?.immutableReference ?? 'No trusted evidence'}</td><td>{record?.source ?? 'UNVERIFIED'}</td><td>{record?.observedAt.toISOString() ?? '—'}</td><td><code>{record ? record.gitSha.slice(0, 12) + '… / ' + record.buildId + ' / ' + record.applicationVersion + ' / ' + record.migrationHead + ' / ' + record.uatCycleId : candidate.gitSha.slice(0, 12) + '… / ' + candidate.buildId + ' / ' + candidate.applicationVersion + ' / ' + candidate.migrationHead + ' / ' + candidate.uatCycleId}</code></td></tr>; })}
        </tbody></table></div>
        <section aria-labelledby="risk-heading" class="risk-summary"><h3 id="risk-heading">Controlled residual risks</h3>{evidence?.risks.length ? <ul>{evidence.risks.map((risk) => <li><strong>{risk.riskId}</strong> · {risk.severity} · {risk.status}</li>)}</ul> : <p>No current controlled residual risk evidence was returned.</p>}</section>
        <p class="disabled-reason">Production decision: NO-GO. The approved 19-gate register is not reconciled to this exact candidate, so signed release approval is disabled.</p>
        {!model.approvable && <ul class="reasons" aria-label="Approval blockers">{(model.disabledReasons.length ? model.disabledReasons : ['SERVER_EVIDENCE_REQUIRED']).map((reason) => <li>{reasonCopy(reason)}</li>)}</ul>}
        <form data-release-approve data-approvable={String(model.approvable)} method="post"><input type="hidden" name="releaseId" value={candidate.releaseId} /><input type="hidden" name="expectedVersion" value={candidate.version.toString()} /><label for="rel-reauth">Reauthentication</label><input id="rel-reauth" name="reauthenticationSecret" type="password" autocomplete="current-password" required /><p class="signature-meaning">I approve the server-derived evidence for release {candidate.releaseId}.</p><button type="submit" data-submit disabled={!model.approvable} aria-disabled={!model.approvable}>Approve release</button><output data-result role="status" tabindex="-1"></output></form>
      </section>
    </> : <p class="lede">The release candidate is unavailable or you are not authorized to view it.</p>}
  </main>
</AppLayout>
<script>
  import { actions } from 'astro:actions';
  const form = document.querySelector<HTMLFormElement>('[data-release-approve]'); const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');
  form?.addEventListener('submit', async (event) => { event.preventDefault(); const output = form.querySelector<HTMLOutputElement>('[data-result]'); if (submit) submit.disabled = true; form.setAttribute('aria-busy', 'true'); if (output) output.textContent = 'Verifying server evidence and signature…'; try { const data = new FormData(form); const result = await actions.releaseGovernance.approveRelease({ releaseId: String(data.get('releaseId') ?? ''), expectedVersion: BigInt(String(data.get('expectedVersion') ?? '0')), reauthenticationSecret: String(data.get('reauthenticationSecret') ?? '') }); if (!result.error) { window.location.reload(); return; } if (output) output.textContent = 'The release was not approved. Refresh the candidate and review current server evidence.'; output?.focus(); } catch { if (output) output.textContent = 'The release could not be approved. Refresh and try again if permitted.'; output?.focus(); } finally { form.removeAttribute('aria-busy'); if (submit) submit.disabled = form.dataset.approvable !== 'true'; } });
</script>
<style>
.release-shell{max-width:78rem;margin:0 auto;padding:2rem 1rem}.eyebrow{margin:0;color:var(--text-muted);font-size:.7rem;letter-spacing:.12em;font-weight:700}.lede{color:var(--text-muted)}.identity{display:grid;gap:.5rem;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));margin:1rem 0}.identity div{padding:.75rem;background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md)}.identity dt{font-size:.7rem;color:var(--text-muted)}.identity dd{margin:.25rem 0 0;overflow-wrap:anywhere}.denied,.disabled-reason{padding:.75rem;border:1px solid var(--color-border-subtle);border-radius:var(--radius-md)}.approve-panel{margin-top:1.5rem;padding:1.25rem;background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.table-wrap{overflow-x:auto;margin:1rem 0}table{width:100%;min-width:70rem;border-collapse:collapse;font-size:.82rem}th,td{padding:.65rem;border-block-start:1px solid var(--color-border-subtle);text-align:start;vertical-align:top}thead th{color:var(--text-muted);font-size:.72rem}.status{font-weight:700}.status-pass{color:var(--status-pass)}.status-fail{color:var(--status-danger)}.status-unverified,.status-partial,.status-not_applicable{color:var(--status-warning)}code{overflow-wrap:anywhere}.risk-summary{border-block-start:1px solid var(--color-border-subtle);padding-block-start:1rem}.risk-summary ul{padding-inline-start:1.2rem}form{display:grid;gap:.6rem;max-width:40rem;margin-top:1rem}button{width:max-content;padding:.7rem 1rem}button[disabled]{opacity:.5;cursor:not-allowed}.signature-meaning{font-weight:600}output{min-height:1.5rem}
</style>
