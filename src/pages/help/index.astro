---
import AppLayout from '../../ui/layouts/AppLayout.astro';
import Icon from '../../ui/components/Icon.astro';
import { HELP_SECTIONS, helpSectionSearchText } from '../../shared/copy/help-sections';
import { navigationMatches } from '../../ui/client/navigation-preferences';
import { getRouteById } from '../../shared/routing/routes.js';
import { pageAccessDecision } from '../../shared/routing/page-access.js';
import {
  HELP_GUIDANCE_MATRIX,
  HELP_ROLE_GUIDES,
  HELP_ROUTE_LINKS,
  HELP_STATE_NOTES,
} from '../../shared/copy/help-content.js';

const actor = Astro.locals.actor;
if (!actor) return Astro.redirect(`/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`);

/**
 * Resolve a canonical route ID to its live path. A missing ID is a build-time
 * defect, not a silent empty link, so the help surface can never drift from the
 * route registry.
 */
const routeHref = (routeId: string): string => {
  const route = getRouteById(routeId);
  if (!route) throw new Error(`Help guide references an unregistered route: ${routeId}`);
  return route.path;
};
const canVisitRoute = (routeId: string): boolean => {
  const route = getRouteById(routeId);
  if (!route) throw new Error(`Help guide references an unregistered route: ${routeId}`);
  return pageAccessDecision(actor, route.path) === 'ALLOWED';
};

const labelFor = (routeId: string): string => {
  const route = getRouteById(routeId);
  if (!route) throw new Error(`Help guide references an unregistered route: ${routeId}`);
  return route.title;
};

const quickLinks = HELP_ROUTE_LINKS.filter((link) => canVisitRoute(link.routeId)).map((link) => ({
  ...link,
  href: routeHref(link.routeId),
}));
const roleGuides = HELP_ROLE_GUIDES.filter((guide) => actor.roles.includes(guide.role));
const guidance = HELP_GUIDANCE_MATRIX.filter((matrix) => canVisitRoute(matrix.routeId));
const query = Astro.url.searchParams.get('q')?.slice(0, 200) ?? '';
const sectionText: Record<string, string> = {
  'start-of-day': helpSectionSearchText('start-of-day', roleGuides.map((guide) => [guide.title, guide.focus, guide.escalateTo, guide.startOfDay.filter(canVisitRoute).map(labelFor)])),
  'quick-links': helpSectionSearchText('quick-links', quickLinks.map((link) => [link.label, link.purpose])),
  'guidance-matrix': helpSectionSearchText('guidance-matrix', guidance.map((matrix) => [matrix.screen, `States and next actions on ${matrix.screen}`, matrix.entries.map((entry) => [entry.state, entry.meaning, entry.nextAction])])),
  troubleshooting: helpSectionSearchText('troubleshooting', HELP_STATE_NOTES),
  escalation: helpSectionSearchText('escalation'),
  interruption: helpSectionSearchText('interruption'),
};
const showSection = (id: string) => navigationMatches(sectionText[id] ?? '', query);
---

<AppLayout title="Operating guides · QC Operations" locale="en" direction="ltr">
  <section class="page-head">
    <div>
      <p class="eyebrow">Support</p>
      <h1>Operating guides</h1>
      <p class="lede">Daily workflows and help with blocked actions.</p>
    </div>
    <button type="button" class="print-button" data-print-guide aria-label="Print this guide" title="Print this guide"><Icon name="reports" /></button>
  </section>

  <div class="help-layout">
  <nav class="toc" aria-labelledby="help-toc">
    <h2 id="help-toc">On this page</h2>
    <form method="get" action="/help" role="search">
      <label for="help-query">Search this guide</label>
      <input id="help-query" name="q" type="search" value={query} maxlength="200" data-help-query />
      <button type="submit" aria-label="Search this guide" title="Search this guide"><Icon name="search" /></button>
    </form>
    <p data-help-search-status role="status" aria-live="polite">{query && !Object.keys(sectionText).some(showSection) ? 'No matching sections' : ''}</p>
    <ul>
      <li hidden={!showSection('start-of-day')}><a href="#start-of-day">Start of day by role</a></li>
      <li hidden={!showSection('quick-links')}><a href="#quick-links">Everyday routes</a></li>
      <li hidden={!showSection('guidance-matrix')}><a href="#guidance-matrix">Screen and state guidance</a></li>
      <li hidden={!showSection('troubleshooting')}><a href="#troubleshooting">Troubleshooting</a></li>
      <li hidden={!showSection('escalation')}><a href="#escalation">Escalation and handoff</a></li>
      <li hidden={!showSection('interruption')}><a href="#interruption">Service interruption</a></li>
    </ul>
  </nav>
  <div class="help-content">

  <section class="panel" id="start-of-day" data-help-section data-help-search-text={sectionText['start-of-day']} hidden={!showSection('start-of-day')} aria-labelledby="start-of-day-h">
    <h2 id="start-of-day-h">{HELP_SECTIONS['start-of-day'].title}</h2>
    <p class="muted">{HELP_SECTIONS['start-of-day'].introduction}</p>
    <div class="role-grid">
      {
        roleGuides.map((guide) => (
          <article class="role-card" aria-labelledby={`role-${guide.role}`}>
            <h3 id={`role-${guide.role}`}>{guide.title}</h3>
            <p class="focus">{guide.focus}</p>
            <ol>
              {guide.startOfDay.filter(canVisitRoute).map((routeId) => (
                <li>
                  <a href={routeHref(routeId)}>
                    {labelFor(routeId)}
                  </a>
                </li>
              ))}
            </ol>
            <p class="escalate">
              <span class="tag">{HELP_SECTIONS['start-of-day'].escalationLabel}</span> {guide.escalateTo}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="panel" id="quick-links" data-help-section data-help-search-text={sectionText['quick-links']} hidden={!showSection('quick-links')} aria-labelledby="quick-links-h">
    <h2 id="quick-links-h">{HELP_SECTIONS['quick-links'].title}</h2>
    <ul class="link-list">
      {
        quickLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
            <span class="purpose">{link.purpose}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel" id="guidance-matrix" data-help-section data-help-search-text={sectionText['guidance-matrix']} hidden={!showSection('guidance-matrix')} aria-labelledby="guidance-matrix-h">
    <h2 id="guidance-matrix-h">{HELP_SECTIONS['guidance-matrix'].title}</h2>
    <p class="muted">{HELP_SECTIONS['guidance-matrix'].introduction}</p>
    {
      guidance.map((matrix) => (
        <div class="matrix-block">
          <h3>{matrix.screen}</h3>
          <table>
            <caption>{`States and next actions on ${matrix.screen}`}</caption>
            <thead>
              <tr>
                {HELP_SECTIONS['guidance-matrix'].columns.map((column) => <th scope="col">{column}</th>)}
              </tr>
            </thead>
            <tbody>
              {matrix.entries.map((entry) => (
                <tr>
                  <th scope="row">{entry.state}</th>
                  <td>{entry.meaning}</td>
                  <td>{entry.nextAction}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))
    }
    <p class="muted">{HELP_SECTIONS['guidance-matrix'].ending}</p>
  </section>

  <section class="panel" id="troubleshooting" data-help-section data-help-search-text={sectionText.troubleshooting} hidden={!showSection('troubleshooting')} aria-labelledby="troubleshooting-h">
    <h2 id="troubleshooting-h">{HELP_SECTIONS.troubleshooting.title}</h2>
    <table>
      <caption>{HELP_SECTIONS.troubleshooting.caption}</caption>
      <thead>
        <tr>
          {HELP_SECTIONS.troubleshooting.columns.map((column) => <th scope="col">{column}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          HELP_STATE_NOTES.map((note) => (
            <tr>
              <th scope="row">{note.situation}</th>
              <td>{note.meaning}</td>
            </tr>
          ))
        }
        {HELP_SECTIONS.troubleshooting.notes.map((note) => <tr><th scope="row">{note.situation}</th><td>{note.meaning}</td></tr>)}
      </tbody>
    </table>
  </section>

  <section class="panel" id="escalation" data-help-section data-help-search-text={sectionText.escalation} hidden={!showSection('escalation')} aria-labelledby="escalation-h">
    <h2 id="escalation-h">{HELP_SECTIONS.escalation.title}</h2>
    <p class="muted">{HELP_SECTIONS.escalation.introduction}</p>
    <ul class="handoff">
      {HELP_SECTIONS.escalation.entries.map((entry) => <li><strong>{entry.label}</strong> {entry.text}</li>)}
    </ul>
    <p class="muted">{HELP_SECTIONS.escalation.ending}</p>
  </section>

  <section class="panel" id="interruption" data-help-section data-help-search-text={sectionText.interruption} hidden={!showSection('interruption')} aria-labelledby="interruption-h">
    <h2 id="interruption-h">{HELP_SECTIONS.interruption.title}</h2>
    <ol class="interruption">
      {HELP_SECTIONS.interruption.entries.map((entry) => <li>{entry}</li>)}
    </ol>
  </section>

  <section class="panel muted-panel" aria-labelledby="limits-h">
    <h2 id="limits-h">What this guide does not claim</h2>
    <p>
      This is a derived operational summary. It does not replace the role matrix, permission matrix,
      state machines or business rules, and a page opening here does not mean an action is allowed.
      <strong>PASS ≠ RELEASED.</strong>
    </p>
  </section>
  </div>
  </div>
</AppLayout>

<script>
  import { navigationMatches } from '../../ui/client/navigation-preferences';
  const printButton = document.querySelector<HTMLButtonElement>('[data-print-guide]');
  printButton?.addEventListener('click', () => window.print());
  const query = document.querySelector<HTMLInputElement>('[data-help-query]');
  const filterGuide = () => {
    let visible = 0;
    document.querySelectorAll<HTMLElement>('[data-help-section]').forEach((section) => {
      section.hidden = !navigationMatches(section.dataset.helpSearchText ?? '', query?.value ?? '');
      document.querySelector<HTMLAnchorElement>(`.toc a[href="#${section.id}"]`)?.closest('li')?.toggleAttribute('hidden', section.hidden);
      if (!section.hidden) visible++;
    });
    const status = document.querySelector<HTMLElement>('[data-help-search-status]');
    if (status) status.textContent = query?.value.trim() ? `${visible} matching sections` : '';
  };
  query?.addEventListener('input', filterGuide);
  filterGuide();
</script>

<style>
  .help-layout { display:grid; grid-template-columns:minmax(12rem,16rem) minmax(0,1fr); gap:var(--space-6); align-items:start; }
  .help-content { min-inline-size:0; }
  .toc { position:sticky; top:var(--space-4); padding:var(--space-3); border-inline-end:1px solid var(--border-default); }
  .toc h2 { font-size:.95rem; margin-block-start:0; }
  .toc form { display:grid; grid-template-columns:minmax(0,1fr) 44px; gap:var(--space-2); margin-block-end:var(--space-4); }
  .toc label { grid-column:1/-1; font-size:.8rem; }
  .toc input { inline-size:100%; min-inline-size:0; min-block-size:44px; padding:var(--space-2); border:1px solid var(--border-default); border-radius:4px; background:var(--surface-raised); color:var(--text-primary); }
  .toc button { inline-size:44px; block-size:44px; display:grid; place-items:center; border:1px solid var(--border-default); border-radius:4px; background:var(--surface-raised); color:var(--text-primary); cursor:pointer; }
  .toc a { display:block; min-block-size:44px; padding-block:var(--space-2); }
  [data-help-section][hidden], .toc li[hidden] { display:none; }
  [data-help-search-status] { font-size:.8rem; color:var(--text-muted); }
  @media(max-width:1000px) { .help-layout { grid-template-columns:minmax(0,1fr); } .toc { position:static; border-inline-end:0; border-block-end:1px solid var(--border-default); } }
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    font-weight: 700;
    text-transform: uppercase;
  }
  h1 {
    margin: 0.25rem 0 0.4rem;
  }
  .lede,
  .muted,
  .focus,
  .purpose {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .print-button {
    display:grid;
    place-items:center;
    inline-size:44px;
    block-size:44px;
    min-height: var(--control-height);
    padding: 0;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--text-primary);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .panel {
    padding: var(--space-5);
    margin-bottom: var(--space-5);
    border-block-end: 1px solid var(--color-border-subtle);
    max-width: 960px;
  }
  .panel h2 {
    margin-top: 0;
    font-size: 1.05rem;
  }
  .matrix-block {
    margin-top: var(--space-4);
  }
  .matrix-block h3 {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }
  .toc ul {
    margin: 0;
    padding-inline-start: 1.1rem;
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
  }
  .role-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-3);
  }
  .role-card {
    padding: var(--space-4);
    background: var(--surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
  }
  .role-card h3 {
    margin-top: 0;
    font-size: 0.95rem;
  }
  .role-card ol {
    margin: 0 0 var(--space-3);
    padding-inline-start: 1.1rem;
    font-size: 0.85rem;
    display: grid;
    gap: 0.3rem;
  }
  .escalate {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .tag {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--color-surface-selected);
    color: var(--text-primary);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .link-list,
  .handoff,
  .interruption {
    margin: 0;
    padding-inline-start: 1.1rem;
    display: grid;
    gap: 0.45rem;
    font-size: 0.85rem;
  }
  .link-list {
    list-style: none;
    padding-inline-start: 0;
  }
  .link-list li {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .link-list li:last-child {
    border-bottom: 0;
  }
  .purpose {
    display: block;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  caption {
    text-align: start;
    color: var(--text-muted);
    font-size: 0.8rem;
    padding-bottom: var(--space-2);
  }
  th,
  td {
    text-align: start;
    vertical-align: top;
    padding: 0.55rem 0.6rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  tbody th {
    font-weight: 600;
    inline-size: 38%;
  }
  .muted-panel p {
    margin: 0;
  }
  @media (max-width: 640px) {
    tbody th {
      inline-size: auto;
    }
    th,
    td {
      display: block;
      border-bottom: 0;
    }
    tbody tr {
      display: block;
      border-bottom: 1px solid var(--color-border-subtle);
      padding-block: var(--space-2);
    }
  }
  @media print {
    :global(.app-sidebar),
    :global(.app-topbar),
    .toc,
    .print-button {
      display: none !important;
    }
    :global(.app-main) {
      width: 100% !important;
      padding-block: 0 !important;
    }
    .panel {
      break-inside: avoid;
      border-color: #999;
      max-width: none;
    }
    a[href]::after {
      content: ' (' attr(href) ')';
      font-size: 0.75em;
      color: #444;
    }
  }
</style>
