---
import BaseLayout from '../ui/layouts/BaseLayout.astro';
// One canonical not-found region. This surface reports a routing outcome only;
// it never reveals whether a controlled record exists and never offers a route
// the visitor was not already entitled to.
const recoveryHref = Astro.locals.user ? '/dashboard' : '/login';
const recoveryLabel = Astro.locals.user ? 'Go to dashboard' : 'Go to sign in';
---
<BaseLayout title="Page not found" visualDirection="capa-a">
  <main class="error-shell error-page" id="main-content">
    <section class="state-card" aria-labelledby="error-title">
      <p class="eyebrow">Page not found</p>
      <h1 id="error-title">We could not find that page</h1>
      <p class="state-card__message">
        The address may be outdated, or you may not have access to the requested record.
      </p>
      <div class="state-card__actions">
        <a href={recoveryHref}>{recoveryLabel}</a>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
  /* The shared state-card layer sets one paragraph role for every `p` inside
     the card. These selectors add one more qualifier so the eyebrow and the
     body message keep their own hierarchy instead of inheriting the layer's
     body role. Tokens and logical properties only. */
  .error-shell {
    min-block-size: 100vh;
    min-block-size: 100dvh;
    display: grid;
    align-content: center;
    justify-items: center;
    padding: var(--space-6);
  }

  /* A grid item defaults to min-width:auto, so long unbreakable copy could
     widen the card past the viewport. The card may shrink and its text may
     break at any point instead. */
  .error-shell .state-card {
    min-inline-size: 0;
  }

  .error-shell .state-card p.eyebrow {
    margin: 0;
    margin-block-end: var(--space-2);
    font-size: var(--font-size-xs);
    font-weight: 600;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .error-shell .state-card h1 {
    margin: 0;
    color: var(--text-primary);
    font-size: 1.75rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .error-shell .state-card p.state-card__message {
    margin: 0;
    margin-block-start: var(--space-3);
    color: var(--text-secondary);
    font-size: var(--font-size-md);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  @media (max-width: 520px) {
    .error-shell {
      padding: var(--space-4);
    }
  }
</style>
