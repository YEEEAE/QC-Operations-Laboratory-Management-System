---
import '../styles/global.css';
import SystemBackground from '../components/SystemBackground.astro';
interface Props { title?: string; locale?: string; direction?: 'ltr' | 'rtl'; density?: 'comfortable' | 'standard' | 'compact'; systemBackground?: boolean; }
const { title = 'QC Operations & Laboratory Management System', locale = 'en', direction = locale.startsWith('ar') ? 'rtl' : 'ltr', density = 'standard', systemBackground = true } = Astro.props;
---
<!doctype html>
<html lang={locale} dir={direction} data-density={density}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    {systemBackground && <SystemBackground />}
    <div class="system-content"><slot /></div>
  </body>
</html>
