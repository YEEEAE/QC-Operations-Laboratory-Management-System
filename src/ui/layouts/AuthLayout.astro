---
import BaseLayout from './BaseLayout.astro';
interface Props { title?: string; locale?: string; direction?: 'ltr' | 'rtl'; systemBackground?: boolean; transparent?: boolean; }
const { systemBackground = true, transparent = false, ...props } = Astro.props;
---
<BaseLayout {...props} systemBackground={systemBackground}>
  <main class:list={["auth-layout", transparent && "is-transparent"]} id="main-content"><slot /></main>
</BaseLayout>
<style>
  .auth-layout { min-height: 100vh; display: grid; place-items: center; padding: var(--space-6); background: rgb(20 23 20 / 94%); }
  .auth-layout.is-transparent { background: transparent; }
</style>
