---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../shell/Sidebar.astro';
import Topbar from '../shell/Topbar.astro';
import { routeBreadcrumbs } from '../navigation/navigation';
interface Props { title?: string; locale?: string; direction?: 'ltr' | 'rtl'; density?: 'comfortable' | 'standard' | 'compact'; }
const props = Astro.props;
const actor = Astro.locals.actor;
const activeCapabilities = Array.isArray(actor?.permissions)
  ? actor.permissions.filter((permission) => permission.active !== false).map((permission) => permission.code)
  : [];
const breadcrumbs = routeBreadcrumbs(Astro.url.pathname);
---
<BaseLayout {...props}>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="app-shell" data-app-shell data-mobile-nav-open="false" data-sidebar-collapsed="false">
    <aside id="primary-navigation" class="app-sidebar" data-sidebar-panel aria-label="Primary navigation"><slot name="sidebar"><Sidebar capabilities={activeCapabilities} /></slot></aside>
    <div class="app-workspace">
      <header class="app-topbar"><slot name="topbar"><Topbar breadcrumbs={breadcrumbs} userName={actor?.id} scope="Authorized operational scope" /></slot></header>
      <main id="main-content" class="app-main"><slot /></main>
    </div>
  </div>
</BaseLayout>
<style>
  .app-shell { min-height: 100vh; display: grid; grid-template-columns: minmax(220px, 264px) minmax(0, 1fr); background: var(--surface-page); transition: grid-template-columns var(--motion-standard) ease; }
  .app-shell[data-sidebar-collapsed='true'] { grid-template-columns: 70px minmax(0, 1fr); }
  .app-sidebar { background: var(--color-sidebar); border-inline-end: 1px solid var(--color-border-subtle); }
  .app-workspace { min-width: 0; display: flex; flex-direction: column; }
  .app-topbar { min-height: 64px; display: flex; align-items: center; padding: var(--space-3) var(--space-6); background: var(--surface-panel); border-block-end: 1px solid var(--color-border-subtle); }
  .app-main { width: min(100% - 2 * var(--space-6), 1600px); margin-inline: auto; flex: 1; padding-block: var(--space-8); }
  @media (max-width: 760px) { .app-shell,.app-shell[data-sidebar-collapsed='true'] { display:block; } .app-sidebar { position:fixed; z-index:20; inset:0 auto 0 0; width:min(86vw,320px); transform:translateX(-105%); transition:transform var(--motion-standard) ease; box-shadow:var(--shadow-3); } [dir='rtl'] .app-sidebar { inset:0 0 0 auto; transform:translateX(105%); } .app-shell[data-mobile-nav-open='true'] .app-sidebar { transform:translateX(0); } .app-main { width: min(100% - 2 * var(--space-4), 1600px); padding-block: var(--space-6); } .app-topbar { padding-inline: var(--space-4); } }
</style>
<script>
  const shell = document.querySelector<HTMLElement>('[data-app-shell]');
  const sidebar = document.querySelector<HTMLElement>('[data-sidebar-panel] .sidebar');
  const collapse = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
  const navigationToggle = document.querySelector<HTMLButtonElement>('[data-navigation-toggle]');
  const storageKey = 'qc-sidebar-collapsed';

  const setCollapsed = (collapsed: boolean) => {
    if (!shell || !sidebar || !collapse) return;
    shell.dataset.sidebarCollapsed = String(collapsed);
    sidebar.dataset.collapsed = String(collapsed);
    collapse.setAttribute('aria-expanded', String(!collapsed));
    collapse.setAttribute('aria-label', collapsed ? 'Expand navigation' : 'Collapse navigation');
    localStorage.setItem('qc-sidebar-collapsed', String(collapsed));
  };

  if (localStorage.getItem(storageKey) === 'true') setCollapsed(true);
  collapse?.addEventListener('click', () => setCollapsed(sidebar?.dataset.collapsed !== 'true'));
  navigationToggle?.addEventListener('click', () => {
    if (!shell) return;
    const open = shell.dataset.mobileNavOpen === 'true';
    shell.dataset.mobileNavOpen = String(!open);
    navigationToggle.setAttribute('aria-expanded', String(!open));
  });
  sidebar?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a') && shell) shell.dataset.mobileNavOpen = 'false';
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      window.location.assign('/search');
    }
    if (event.key === 'Escape' && shell?.dataset.mobileNavOpen === 'true') {
      shell.dataset.mobileNavOpen = 'false';
      navigationToggle?.focus();
    }
  });
</script>
