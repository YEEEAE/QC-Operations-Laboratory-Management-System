---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../shell/Sidebar.astro';
import Topbar from '../shell/Topbar.astro';
import CommandPalette from '../shell/CommandPalette.astro';
import { routeBreadcrumbs } from '../navigation/navigation';
import { actorRoleLabel, describeActorScope } from '../../shared/authorization/scope-description';
interface Props { title?: string; locale?: string; direction?: 'ltr' | 'rtl'; density?: 'comfortable' | 'standard' | 'compact'; scope?: string; approvalCount?: number; notificationCount?: number; userRole?: string; }
const props = Astro.props;
const actor = Astro.locals.actor;
const breadcrumbs = routeBreadcrumbs(Astro.url.pathname);
---
<BaseLayout {...props}>
  <a class="skip-link" href="#main-content" data-skip-link>Skip to main content</a>
  <div class="app-shell" data-app-shell data-preference-account={actor?.id ?? ''} data-mobile-nav-open="false" data-sidebar-collapsed="false">
    <aside id="primary-navigation" class="app-sidebar" data-sidebar-panel aria-label="Primary navigation" aria-hidden="false"><slot name="sidebar"><Sidebar actor={actor} /></slot></aside>
    <div class="app-workspace" data-app-workspace>
      <header class="app-topbar"><slot name="topbar"><Topbar breadcrumbs={breadcrumbs} userName={actor?.loginIdentity ?? 'Signed in'} userRole={props.userRole ?? actorRoleLabel(actor)} scope={props.scope ?? describeActorScope(actor)} approvalCount={props.approvalCount} notificationCount={props.notificationCount} /></slot></header>
      <main id="main-content" class="app-main"><slot /></main>
    </div>
  </div>
  <CommandPalette />
</BaseLayout>
<style>
  .app-shell { min-height: 100vh; display: grid; grid-template-columns: minmax(220px, 264px) minmax(0, 1fr); background: var(--surface-page); transition: grid-template-columns var(--motion-standard) ease; }
  .app-shell[data-sidebar-collapsed='true'] { grid-template-columns: 70px minmax(0, 1fr); }
  .app-sidebar { background: var(--color-sidebar); border-inline-end: 1px solid var(--color-border-subtle); min-width: 0; min-inline-size: 0; }
  .app-workspace { min-width: 0; min-inline-size: 0; max-inline-size: 100%; display: flex; flex-direction: column; }
  .app-topbar { min-height: 64px; display: flex; align-items: center; padding: var(--space-3) var(--space-6); background: var(--surface-panel); border-block-end: 1px solid var(--color-border-subtle); }
  .app-main { width: min(100% - 2 * var(--space-6), 1600px); max-inline-size: 100%; margin-inline: auto; flex: 1; padding-block: var(--space-8); overflow-wrap: anywhere; }
  @media (max-width: 760px) { .app-shell,.app-shell[data-sidebar-collapsed='true'] { display:block; } .app-sidebar { position:fixed; z-index:20; inset-block:0; inset-inline-start:0; inset-inline-end:auto; inline-size:min(86vw,20rem); max-inline-size:calc(100vw - 3rem); visibility:hidden; transform:translateX(-105%); transition:transform var(--motion-standard) ease, visibility var(--motion-standard); box-shadow:var(--shadow-3); } [dir='rtl'] .app-sidebar { transform:translateX(105%); } .app-shell[data-mobile-nav-open='true'] .app-sidebar { transform:translateX(0); visibility:visible; } .app-main { width: min(100% - 2 * var(--space-4), 1600px); padding-block: var(--space-6); } .app-topbar { padding-inline: var(--space-4); flex-wrap:wrap; } }
  @media (prefers-reduced-motion: reduce) { .app-shell,.app-sidebar { transition:none; } }
</style>
<script>
  import { navigationPreferences, navigationMatches, recentRecordPath } from '../client/navigation-preferences';
  import { openDialog, initDialogs } from '../client/dialog';
  const shell = document.querySelector<HTMLElement>('[data-app-shell]');
  const sidebarPanel = document.querySelector<HTMLElement>('[data-sidebar-panel]');
  const workspace = document.querySelector<HTMLElement>('[data-app-workspace]');
  const sidebar = document.querySelector<HTMLElement>('[data-sidebar-panel] .sidebar');
  const skipLink = document.querySelector<HTMLElement>('[data-skip-link]');
  const collapse = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
  const navigationToggle = document.querySelector<HTMLButtonElement>('[data-navigation-toggle]');
  const drawerClose = document.querySelector<HTMLButtonElement>('[data-drawer-close]');
  let preferenceStorage: Storage | undefined;
  try { preferenceStorage = window.localStorage; } catch { /* Storage is optional. */ }
  const preferences = navigationPreferences(shell?.dataset.preferenceAccount ?? '', preferenceStorage);
  const mobileQuery = window.matchMedia('(max-width: 760px)');
  const isMobileDrawer = () => mobileQuery.matches;
  const isDrawerOpen = () => shell?.dataset.mobileNavOpen === 'true';

  const filterPanel = sidebar?.querySelector<HTMLElement>('[data-navigation-filter-panel]');
  const filter = sidebar?.querySelector<HTMLInputElement>('[data-navigation-filter]');
  if (filterPanel) filterPanel.hidden = false;
  const applyNavigationFilter = () => {
    const query = filter?.value ?? '';
    let count = 0;
    sidebar?.querySelectorAll<HTMLElement>('.nav-group').forEach((group) => {
      let matches = 0;
      group.querySelectorAll<HTMLAnchorElement>('.nav-link').forEach((link) => {
        const shown = navigationMatches(link.textContent ?? '', query);
        link.closest('li')?.toggleAttribute('hidden', !shown);
        if (shown) matches++;
      });
      group.hidden = matches === 0;
      count += matches;
      const button = group.querySelector<HTMLButtonElement>('[data-nav-section-toggle]');
      const list = group.querySelector<HTMLElement>('.nav-items');
      const expanded = query.trim() ? matches > 0 : expandedSections.has(group.dataset.navGroup ?? '');
      button?.setAttribute('aria-expanded', String(expanded));
      button?.setAttribute('aria-label', `${expanded ? 'Collapse' : 'Expand'} ${button.dataset.sectionLabel} section`);
      if (list) list.hidden = !expanded;
    });
    sidebar?.querySelectorAll<HTMLAnchorElement>('.nav-utilities .nav-link').forEach((link) => {
      const shown = navigationMatches(link.textContent ?? '', query);
      link.closest('li')?.toggleAttribute('hidden', !shown);
      if (shown) count++;
    });
    const status = sidebar?.querySelector<HTMLElement>('[data-navigation-filter-status]');
    if (status) status.textContent = query.trim() ? `${count} matching pages` : '';
  };
  filter?.addEventListener('input', applyNavigationFilter);
  filter?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') { filter.value = ''; applyNavigationFilter(); }
  });

  const palette = document.querySelector<HTMLDialogElement>('[data-command-palette]');
  const commandQuery = palette?.querySelector<HTMLInputElement>('[data-command-query]');
  const recentList = palette?.querySelector<HTMLElement>('[data-command-recent] ul');
  const currentRecord = recentRecordPath(window.location.pathname);
  if (currentRecord && shell?.dataset.preferenceAccount && !document.querySelector('#main-content .unavailable, #main-content .denied, #main-content .operational-state--error, #main-content .operational-state--denied')) {
    const saved = preferences.read();
    preferences.write({ ...saved, recent: [currentRecord, ...saved.recent.filter((path) => path !== currentRecord)] });
  }
  for (const path of preferences.read().recent) {
    const item = document.createElement('li');
    item.dataset.commandItem = '';
    const link = document.createElement('a');
    link.href = path;
    link.textContent = path;
    item.append(link);
    recentList?.append(item);
  }
  const recentSection = palette?.querySelector<HTMLElement>('[data-command-recent]');
  if (recentSection) recentSection.hidden = !recentList?.childElementCount;
  window.addEventListener('storage', (event) => {
    if (event.key === 'qc-navigation-v2:account' && event.newValue !== shell?.dataset.preferenceAccount) {
      recentList?.replaceChildren();
      if (recentSection) recentSection.hidden = true;
    }
  });
  const filterCommands = () => {
    let count = 0;
    palette?.querySelectorAll<HTMLElement>('[data-command-item]').forEach((item) => {
      item.hidden = !navigationMatches(item.textContent ?? '', commandQuery?.value ?? '');
      if (!item.hidden) count++;
    });
    const status = palette?.querySelector<HTMLElement>('[data-command-status]');
    if (status) status.textContent = count ? `${count} results` : 'No matches';
  };
  commandQuery?.addEventListener('input', filterCommands);
  palette?.addEventListener('keydown', (event) => {
    if (!['ArrowDown', 'ArrowUp'].includes(event.key)) return;
    const links = Array.from(palette.querySelectorAll<HTMLAnchorElement>('[data-command-item]:not([hidden]) a'));
    if (!links.length) return;
    event.preventDefault();
    const index = links.indexOf(document.activeElement as HTMLAnchorElement);
    links[(index + (event.key === 'ArrowDown' ? 1 : links.length - 1) + links.length) % links.length]?.focus();
  });
  initDialogs();
  document.querySelector<HTMLElement>('[data-command-trigger]')?.addEventListener('click', (event) => {
    if (!palette || typeof palette.showModal !== 'function') return;
    event.preventDefault();
    openDialog(palette, event.currentTarget as HTMLElement);
    filterCommands();
  });

  const setCollapsed = (collapsed: boolean) => {
    if (!shell || !sidebar || !collapse) return;
    shell.dataset.sidebarCollapsed = String(collapsed);
    sidebar.dataset.collapsed = String(collapsed);
    collapse.setAttribute('aria-expanded', String(!collapsed));
    collapse.setAttribute('aria-label', collapsed ? 'Expand navigation' : 'Collapse navigation');
    preferences.write({ ...preferences.read(), collapsed });
  };

  const savedSections = preferences.read().sections;
  const expandedSections = new Set<string>(
    Array.isArray(savedSections)
      ? savedSections.filter((section): section is string => typeof section === 'string')
      : [],
  );
  sidebar?.querySelectorAll<HTMLButtonElement>('[data-nav-section-toggle]').forEach((button) => {
    const sectionId = button.dataset.sectionId;
    const sectionLabel = button.dataset.sectionLabel ?? sectionId;
    const listId = button.getAttribute('aria-controls');
    const list = listId ? document.getElementById(listId) : null;
    if (!sectionId || !list) return;
    const isCurrentSection = button.closest('[data-current-section="true"]') !== null;
    const open = isCurrentSection || expandedSections.has(sectionId);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', `${open ? 'Collapse' : 'Expand'} ${sectionLabel} section`);
    list.toggleAttribute('hidden', !open);
    if (open) expandedSections.add(sectionId);
    button.addEventListener('click', () => {
      const nextOpen = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(nextOpen));
      button.setAttribute(
        'aria-label',
        `${nextOpen ? 'Collapse' : 'Expand'} ${sectionLabel} section`,
      );
      list.toggleAttribute('hidden', !nextOpen);
      if (nextOpen) expandedSections.add(sectionId);
      else expandedSections.delete(sectionId);
      preferences.write({ ...preferences.read(), sections: [...expandedSections] });
    });
    button.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || button.getAttribute('aria-expanded') !== 'true') return;
      event.preventDefault();
      button.click();
      button.focus();
    });
  });

  const drawerFocusables = () => {
    if (!sidebarPanel) return [];
    const candidates = Array.from(
      sidebarPanel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ),
    );
    return candidates.filter((element) => element.getClientRects().length > 0);
  };

  const firstDrawerLink = () =>
    drawerFocusables().find((element) => element.matches('a[href]')) ?? drawerFocusables()[0];

  const lockBackgroundScroll = () => {
    document.body.style.overflow = 'hidden';
  };

  const unlockBackgroundScroll = () => {
    document.body.style.overflow = '';
  };

  const isolateBackground = () => {
    workspace?.setAttribute('inert', '');
    // The skip link lives outside the workspace subtree. While the drawer is
    // open it must not remain a keyboard escape hatch (C-09 FAIL).
    skipLink?.setAttribute('inert', '');
    lockBackgroundScroll();
  };

  const releaseBackground = () => {
    workspace?.removeAttribute('inert');
    skipLink?.removeAttribute('inert');
    unlockBackgroundScroll();
  };

  const setMobileNav = (
    open: boolean,
    options: { focusPanel?: boolean; returnFocus?: boolean } = {},
  ) => {
    if (!shell || !sidebarPanel) return;
    shell.dataset.mobileNavOpen = String(open);
    navigationToggle?.setAttribute('aria-expanded', String(open));
    navigationToggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    sidebarPanel.setAttribute('aria-hidden', String(isMobileDrawer() && !open));
    if (!isMobileDrawer()) {
      sidebarPanel.removeAttribute('inert');
      releaseBackground();
      return;
    }
    if (open) {
      sidebarPanel.removeAttribute('inert');
      isolateBackground();
      if (options.focusPanel) firstDrawerLink()?.focus();
    } else {
      const focusInside = sidebarPanel.contains(document.activeElement);
      if (focusInside) {
        (document.activeElement as HTMLElement | null)?.blur?.();
      }
      sidebarPanel.setAttribute('inert', '');
      releaseBackground();
      if (options.returnFocus || focusInside) navigationToggle?.focus();
    }
  };

  const collapsedPreference = String(preferences.read().collapsed);
  if (collapsedPreference === 'true') {
    // Apply the preference without requiring a storage write.
    if (shell && sidebar && collapse) {
      shell.dataset.sidebarCollapsed = 'true';
      sidebar.dataset.collapsed = 'true';
      collapse.setAttribute('aria-expanded', 'false');
      collapse.setAttribute('aria-label', 'Expand navigation');
    }
  }
  // A closed mobile drawer must never keep keyboard focus: park it inert.
  // The workspace is only ever inert while the drawer is open at the mobile
  // breakpoint; every other state releases all temporary isolation.
  if (isMobileDrawer() && !isDrawerOpen()) {
    sidebarPanel?.setAttribute('inert', '');
    sidebarPanel?.setAttribute('aria-hidden', 'true');
    releaseBackground();
  }
  mobileQuery.addEventListener?.('change', (event) => {
    if (!shell || !sidebarPanel) return;
    if (event.matches) {
      if (isDrawerOpen()) {
        sidebarPanel.removeAttribute('inert');
        isolateBackground();
      } else {
        sidebarPanel.setAttribute('inert', '');
        sidebarPanel.setAttribute('aria-hidden', 'true');
        releaseBackground();
      }
    } else {
      // Leaving the mobile breakpoint: drop every temporary drawer state.
      sidebarPanel.removeAttribute('inert');
      sidebarPanel.setAttribute('aria-hidden', 'false');
      releaseBackground();
    }
  });
  collapse?.addEventListener('click', () => setCollapsed(sidebar?.dataset.collapsed !== 'true'));
  drawerClose?.addEventListener('click', () => setMobileNav(false, { returnFocus: true }));
  navigationToggle?.addEventListener('click', () => {
    if (!shell) return;
    if (isDrawerOpen()) {
      setMobileNav(false);
    } else {
      setMobileNav(true, { focusPanel: true });
    }
  });
  sidebar?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a') && shell) setMobileNav(false);
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      if (document.querySelector('dialog[open]:not([data-command-palette])')) return;
      event.preventDefault();
      if (isDrawerOpen()) setMobileNav(false);
      const palette = document.querySelector<HTMLDialogElement>('[data-command-palette]');
      if (palette && typeof palette.showModal === 'function') { openDialog(palette); filterCommands(); }
      else window.location.assign('/search');
    }
    if (event.key === 'Tab' && isDrawerOpen() && isMobileDrawer()) {
      const focusables = drawerFocusables();
      if (focusables.length === 0) {
        event.preventDefault();
        return;
      }
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
    if (event.key === 'Escape' && isDrawerOpen() && isMobileDrawer()) {
      setMobileNav(false, { returnFocus: true });
    }
  });
</script>
