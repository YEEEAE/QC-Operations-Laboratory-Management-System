---
type Status = 'PASS' | 'RELEASED' | 'APPROVED' | 'HOLD' | 'WARNING' | 'FAIL' | 'REJECTED' | 'REVIEW' | 'DRAFT' | 'VOID' | 'SUPERSEDED';
interface Props { status: Status; label?: string; }
const { status, label = status } = Astro.props;
const tone = status === 'PASS' ? 'pass' : status === 'RELEASED' ? 'released' : ['APPROVED'].includes(status) ? 'approved' : ['HOLD', 'WARNING'].includes(status) ? 'warning' : ['FAIL', 'REJECTED', 'VOID'].includes(status) ? 'danger' : ['REVIEW'].includes(status) ? 'review' : 'neutral';
---
<span class:list={['status-badge', `status-badge--${tone}`]}><span class="status-mark" aria-hidden="true"></span><span>{label}</span></span>
<style>
  .status-badge { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 28px; padding-inline: var(--space-2) var(--space-3); border: 1px solid currentColor; border-radius: 999px; font-size: .8125rem; font-weight: 600; }
  .status-mark { width: 7px; height: 7px; flex: 0 0 auto; border-radius: 50%; background: currentColor; }
  .status-badge--pass { color: var(--status-pass); background: var(--status-pass-bg); }
  .status-badge--released { color: var(--status-released); background: var(--status-released-bg); }
  .status-badge--approved { color: var(--status-approved); background: var(--status-approved-bg); }
  .status-badge--warning { color: var(--status-warning); background: var(--status-warning-bg); }
  .status-badge--danger { color: var(--status-danger); background: var(--status-danger-bg); }
  .status-badge--review { color: var(--status-review); background: var(--status-review-bg); }
  .status-badge--neutral { color: var(--status-neutral); background: var(--status-neutral-bg); }
</style>
