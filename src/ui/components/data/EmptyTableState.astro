---
import { copy } from '../../../shared/copy/ux-vocabulary';
import Icon from '../Icon.astro';
interface Props {
  /** Headline. Use the truly-empty wording for an empty register. */
  title?: string;
  description?: string;
  /** Link that removes the applied filters (filtered-empty state only). */
  clearHref?: string;
  /** Optional primary action for a truly empty register. */
  actionLabel?: string;
  actionHref?: string;
}
const {
  title = copy.states.noFilterMatches,
  description = 'Clear a filter or change your search.',
  clearHref,
  actionLabel,
  actionHref,
} = Astro.props;
const filtered = Boolean(clearHref);
---

<div class="empty" role="status">
  <span class="empty-icon" aria-hidden="true"><Icon name="search" /></span>
  <h3>{title}</h3>
  <p>{description}</p>
  {
    filtered && (
      <a class="empty-action" href={clearHref}>
        {copy.actions.clearFilters}
      </a>
    )
  }
  {!filtered && actionLabel && actionHref && <a class="empty-action" href={actionHref}>{actionLabel}</a>}
</div>
<style>
  .empty {
    padding: var(--space-12) var(--space-5);
    text-align: center;
  }
  .empty-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin: 0 auto var(--space-3);
    border-radius: 50%;
    background: var(--color-surface-selected);
    color: var(--color-accent-primary);
    font-size: 20px;
  }
  .empty h3 {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--font-size-lg);
  }
  .empty p {
    margin: 8px auto 0;
    max-width: 380px;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
  }
  .empty-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-height);
    margin-top: var(--space-4);
    padding-inline: var(--space-3);
    color: var(--color-accent-primary-hover);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
  }
</style>
