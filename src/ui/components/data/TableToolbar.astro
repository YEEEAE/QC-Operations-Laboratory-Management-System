---
interface Props { actionLabel?: string; actionHref?: string; }
const { actionLabel, actionHref } = Astro.props;
---
<div class="toolbar"><slot /><div class="toolbar-actions">{actionLabel && actionHref && <a class="action" href={actionHref}>{actionLabel}</a>}</div></div><style>.toolbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space-3);padding:var(--space-3) var(--space-5);border-block:1px solid var(--color-border-subtle);background:var(--surface-raised)}.toolbar-actions{display:flex;gap:8px}.action{padding:8px 12px;border-radius:7px;background:var(--color-accent-primary);color:var(--color-text-inverse);font-size:12px;font-weight:700;text-decoration:none}.action:hover{background:var(--color-accent-primary-hover)}</style>
