---
/**
 * Shared accessible confirmation dialog for controlled/sensitive actions.
 *
 * Native <dialog> provides the modal focus trap, Escape handling, and focus
 * return; `src/ui/client/dialog.ts` adds the pending-state guard, the focus
 * contract, and the pending/error regions this component exposes.
 *
 * Usage: render this component with a stable id, then open it from any control
 * carrying `data-dialog-open="<id>"`.
 */
interface Props {
  id?: string;
  title?: string;
  description?: string;
  subject?: string;
  intent?: string;
  reasonRequired?: boolean;
  confirmLabel?: string;
  cancelLabel?: string;
  danger?: boolean;
  pendingLabel?: string;
}
const {
  id = 'confirm-dialog',
  title = 'Review controlled action',
  description = 'Check the record and action before continuing.',
  subject,
  intent,
  reasonRequired = false,
  confirmLabel = 'Confirm',
  cancelLabel = 'Cancel',
  danger = false,
  pendingLabel = 'Working…',
} = Astro.props;
---
<dialog
  id={id}
  class="confirm-dialog"
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-description`}
  data-dialog
  data-dialog-danger={danger ? 'true' : 'false'}
  data-dialog-pending-label={pendingLabel}
>
  <form method="dialog">
    <button class="close" type="button" aria-label="Close dialog" data-dialog-close>×</button>
    <h2 id={`${id}-title`} data-dialog-title tabindex="-1">{title}</h2>
    <p id={`${id}-description`}>{description}</p>
    {
      subject && (
        <dl>
          <dt>Record</dt>
          <dd>{subject}</dd>
        </dl>
      )
    }
    {
      intent && (
        <dl>
          <dt>Intended action</dt>
          <dd>{intent}</dd>
        </dl>
      )
    }
    {
      reasonRequired && (
        <label for={`${id}-reason`}>
          Reason<span aria-hidden="true"> *</span>
          <textarea id={`${id}-reason`} name="reason" required rows="3"></textarea>
        </label>
      )
    }
    <p class="dialog-status" role="status" aria-live="polite" data-dialog-status></p>
    <p class="dialog-error" role="alert" tabindex="-1" data-dialog-error></p>
    <div class="dialog-stale" hidden data-dialog-stale>
      <button type="button" data-refresh-record>Refresh record</button>
    </div>
    <div class="actions">
      <button type="submit" value="cancel" data-dialog-cancel>{cancelLabel}</button>
      <button class:list={['primary', danger && 'danger']} type="submit" value="confirm" data-dialog-confirm>
        {confirmLabel}
      </button>
    </div>
  </form>
</dialog>
<style>
  .confirm-dialog {
    max-width: 460px;
    width: calc(100% - 32px);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 0;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--surface-popover);
    color: var(--text-primary);
    box-shadow: var(--shadow-3);
  }
  .confirm-dialog::backdrop {
    background: rgb(0 0 0 / 68%);
    backdrop-filter: blur(2px);
  }
  .confirm-dialog form {
    position: relative;
    padding: var(--space-6);
  }
  .confirm-dialog h2 {
    margin: 0;
    font-size: 17px;
  }
  .confirm-dialog p {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.6;
  }
  .close {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-end: 12px;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 22px;
    cursor: pointer;
  }
  .confirm-dialog dl {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 8px;
    margin: 12px 0;
    font-size: 12px;
  }
  .confirm-dialog dt {
    color: var(--text-muted);
  }
  .confirm-dialog dd {
    margin: 0;
    color: var(--text-primary);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .confirm-dialog label {
    display: grid;
    gap: 5px;
    margin-top: 16px;
    color: var(--text-secondary);
    font-size: 12px;
  }
  .confirm-dialog textarea {
    padding: 8px;
    border: 1px solid var(--border-default);
    border-radius: 6px;
    background: var(--surface-panel);
    color: var(--text-primary);
    font: inherit;
  }
  .dialog-status:empty,
  .dialog-error:empty {
    margin: 0;
  }
  .dialog-stale button {
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--border-default);
    border-radius: 6px;
    background: var(--surface-panel);
    color: var(--text-primary);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .dialog-status {
    color: var(--text-secondary);
  }
  .dialog-error {
    color: var(--status-error);
    font-weight: 600;
  }
  .dialog-error:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }
  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 20px;
    flex-wrap: wrap;
  }
  .actions button {
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--border-default);
    border-radius: 6px;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    cursor: pointer;
  }
  .actions .primary {
    border-color: var(--color-accent-primary);
    background: var(--color-accent-primary);
    color: var(--color-text-inverse);
    font-weight: 700;
  }
  .actions .danger {
    border-color: var(--status-error);
    background: var(--status-error);
  }
  .actions button:disabled {
    opacity: 0.7;
    cursor: progress;
  }
</style>
