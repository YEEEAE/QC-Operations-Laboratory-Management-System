---
interface Props { id?: string; title?: string; description?: string; subject?: string; intent?: string; reasonRequired?: boolean; }
const { id = 'confirm-dialog', title = 'Confirm controlled action', description = 'Review the action before continuing.', subject, intent, reasonRequired = false } = Astro.props;
---
<dialog id={id} class="confirm-dialog" aria-labelledby={`${id}-title`} aria-describedby={`${id}-description`} data-dialog><form method="dialog"><button class="close" value="cancel" aria-label="Close dialog">×</button><h2 id={`${id}-title`}>{title}</h2><p id={`${id}-description`}>{description}</p>{subject && <dl><dt>Record</dt><dd>{subject}</dd></dl>}{intent && <dl><dt>Intended action</dt><dd>{intent}</dd></dl>}{reasonRequired && <label>Reason<span aria-hidden="true"> *</span><textarea name="reason" required rows="3"></textarea></label>}<div class="actions"><button value="cancel">Cancel</button><button class="primary" value="confirm">Confirm</button></div></form></dialog><style>.confirm-dialog{max-width:460px;width:calc(100% - 32px);padding:0;border:1px solid var(--border-default);border-radius:var(--radius-lg);background:var(--surface-popover);color:var(--text-primary);box-shadow:var(--shadow-3)}.confirm-dialog::backdrop{background:rgb(0 0 0 / 68%);backdrop-filter:blur(2px)}.confirm-dialog form{position:relative;padding:var(--space-6)}.confirm-dialog h2{margin:0;font-size:17px}.confirm-dialog p{color:var(--text-secondary);font-size:13px;line-height:1.6}.close{position:absolute;inset-block-start:12px;inset-inline-end:12px;border:0;background:transparent;color:var(--text-muted);font-size:22px;cursor:pointer}.confirm-dialog dl{display:grid;grid-template-columns:110px 1fr;gap:8px;margin:12px 0;font-size:12px}.confirm-dialog dt{color:var(--text-muted)}.confirm-dialog dd{margin:0;color:var(--text-primary);font-weight:600}.confirm-dialog label{display:grid;gap:5px;margin-top:16px;color:var(--text-secondary);font-size:12px}.confirm-dialog textarea{padding:8px;border:1px solid var(--border-default);border-radius:6px;background:var(--surface-panel);color:var(--text-primary);font:inherit}.actions{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}.actions button{padding:8px 12px;border:1px solid var(--border-default);border-radius:6px;background:transparent;color:var(--text-secondary);font:inherit;cursor:pointer}.actions .primary{border-color:var(--color-accent-primary);background:var(--color-accent-primary);color:var(--color-text-inverse);font-weight:700}</style>
