---
interface Props { title?: string; description?: string; actionLabel?: string; actionHref?: string; }
const { title = 'Nothing here yet', description = 'There is no operational data to show in this view.', actionLabel, actionHref } = Astro.props;
---
<section class="state" aria-labelledby="empty-title"><div class="state-mark" aria-hidden="true">＋</div><h2 id="empty-title">{title}</h2><p>{description}</p>{actionLabel && actionHref && <a href={actionHref}>{actionLabel}</a>}</section><style>.state{padding:var(--space-12) var(--space-6);text-align:center;border:1px dashed var(--color-border-default);border-radius:var(--radius-lg)}.state-mark{display:grid;place-items:center;width:42px;height:42px;margin:0 auto 12px;border-radius:50%;background:var(--color-surface-selected);color:var(--color-accent-primary);font-size:22px}.state h2{margin:0;color:var(--text-primary);font-size:16px}.state p{max-width:420px;margin:8px auto;color:var(--text-muted);font-size:13px}.state a{display:inline-block;margin-top:8px;color:var(--color-accent-primary-hover);font-size:12px}</style>
