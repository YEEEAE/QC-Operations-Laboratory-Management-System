---
interface Props { title?: string; description?: string; requestId?: string; retryHref?: string; }
const { title = 'We could not load this view', description = 'Please try again. If the issue continues, share the reference below with support.', requestId, retryHref } = Astro.props;
---
<section class="state error" role="alert" aria-labelledby="error-title"><div class="state-mark" aria-hidden="true">!</div><h2 id="error-title">{title}</h2><p>{description}</p><div class="actions">{retryHref && <a href={retryHref}>Try again</a>}<a href="/dashboard">Go to dashboard</a></div>{requestId && <small>Reference: <code>{requestId}</code></small>}</section><style>.state{padding:var(--space-12) var(--space-6);text-align:center;border:1px solid var(--status-danger-bg);border-radius:var(--radius-lg);background:color-mix(in srgb,var(--status-danger-bg) 40%,transparent)}.state-mark{display:grid;place-items:center;width:42px;height:42px;margin:0 auto 12px;border-radius:50%;background:var(--status-danger-bg);color:var(--status-danger);font-weight:800}.state h2{margin:0;color:var(--text-primary);font-size:16px}.state p{max-width:440px;margin:8px auto;color:var(--text-secondary);font-size:13px}.actions{display:flex;justify-content:center;gap:16px}.actions a{color:var(--color-accent-primary-hover);font-size:12px}.state small{display:block;margin-top:16px;color:var(--text-muted);font-size:11px}.state code{font-family:var(--font-mono)}</style>
