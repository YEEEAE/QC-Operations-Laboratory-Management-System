---
interface Props {
  title?: string;
  description?: string;
  retryHref?: string;
}
const {
  title = 'Operational data is temporarily unavailable',
  description = 'The data provider did not return a confirmed result. This is not an empty or zero state.',
  retryHref = `${Astro.url.pathname}${Astro.url.search}`,
} = Astro.props;
---
<section class="unavailable" role="alert" aria-labelledby="provider-unavailable-title">
  <span class="indicator" aria-hidden="true">!</span>
  <div>
    <h2 id="provider-unavailable-title">{title}</h2>
    <p>{description}</p>
    <a href={retryHref}>Try again</a>
  </div>
</section>
<style>
  .unavailable { display:flex; gap:var(--space-4); align-items:flex-start; padding:var(--space-5); background:var(--status-warning-bg); border:1px solid var(--status-warning); border-radius:var(--radius-lg); }
  .indicator { display:grid; place-items:center; flex:none; inline-size:2rem; block-size:2rem; border-radius:50%; background:var(--status-warning); color:var(--text-on-accent); font-weight:800; }
  h2 { margin:0; font-size:var(--font-size-md); color:var(--text-primary); }
  p { margin:var(--space-1) 0 var(--space-3); color:var(--text-secondary); font-size:var(--font-size-sm); }
  a { color:var(--color-accent-primary-hover); font-weight:var(--font-weight-semibold); }
</style>
