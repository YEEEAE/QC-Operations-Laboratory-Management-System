---
interface Props { version?: string | number; reloadHref?: string; compareHref?: string; }
const { version, reloadHref = Astro.url.pathname, compareHref } = Astro.props;
---
<section class="stale" role="alert" aria-labelledby="stale-title"><div class="mark" aria-hidden="true">↻</div><div><h2 id="stale-title">This record changed after you opened it</h2><p>Your action was not applied. Review the latest version before continuing{version ? ` (opened at version ${version})` : ''}.</p><div class="actions"><a class="primary" href={reloadHref}>Reload latest version</a>{compareHref && <a href={compareHref}>Compare changes</a>}</div></div></section><style>.stale{display:flex;gap:14px;padding:var(--space-5);border:1px solid var(--status-hold);border-radius:var(--radius-md);background:var(--status-hold-bg)}.mark{display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:50%;background:rgb(0 0 0 / 15%);color:var(--status-hold);font-size:20px}.stale h2{margin:0;color:var(--text-primary);font-size:14px}.stale p{margin:6px 0;color:var(--text-secondary);font-size:12px}.actions{display:flex;gap:14px;margin-top:12px}.actions a{color:var(--color-accent-primary-hover);font-size:12px}.actions .primary{padding:7px 10px;border-radius:6px;background:var(--color-accent-primary);color:var(--color-text-inverse);text-decoration:none;font-weight:700}</style>
