---
/* Policy/decision state card in the CAPA Variant A language.
   Visual reference: Stitch screen b93297bebbbd41c69aa4bbcbea0e3b6f.
   The card reports an existing server state; it never decides eligibility. */
interface Action {
  href: string;
  label: string;
}
interface Props {
  heading: string;
  owner?: string;
  decisionId?: string;
  decisionNote?: string;
  actions?: readonly Action[];
}
const { heading, owner, decisionId, decisionNote, actions = [] } = Astro.props;
---
<section class="state-card" aria-labelledby="state-card-heading">
  <div class="state-card__head">
    <span class="state-card__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4.5" y="10.5" width="15" height="10" rx="2"></rect>
        <path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7"></path>
      </svg>
    </span>
    <div>
      <h2 id="state-card-heading">{heading}</h2>
    </div>
  </div>
  <slot />
  {decisionId && (
    <div class="state-card__callout">
      <p>
        <strong>{decisionId}{owner ? ` · ${owner}` : ''}</strong>
        {decisionNote ? ` — ${decisionNote}` : ''}
      </p>
    </div>
  )}
  {actions.length > 0 && (
    <div class="state-card__actions">
      {actions.map((action) => <a href={action.href}>{action.label}</a>)}
    </div>
  )}
</section>
