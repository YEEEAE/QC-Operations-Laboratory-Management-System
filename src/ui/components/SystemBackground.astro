---
// Decorative-only treatment for authenticated operational workspaces.
//
// Owner decision (QC-100-FINAL-016 remediation): the dotLottie layer is dropped.
// It could never render under the production CSP (`default-src 'self'` without
// `unsafe-eval` blocks the WASM player), so every authenticated page paid four
// console errors plus ~2.4 MB of discarded transfer. The approved gradient +
// grid treatment below is the whole background: zero script, zero extra
// requests, and it is the same first frame the player used to fall back to.
---
<div class="system-background" data-system-background aria-hidden="true" data-motion="static"></div>

<style>
  .system-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(60% 75% at 18% 14%, rgb(109 158 103 / 8%), transparent 66%),
      radial-gradient(55% 70% at 92% 86%, rgb(80 112 82 / 7%), transparent 72%),
      var(--color-canvas-deep);
  }

  .system-background::before,
  .system-background::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
  }

  .system-background::before {
    opacity: 0.28;
    background-image: linear-gradient(rgb(255 255 255 / 2%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 2%) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  .system-background::after {
    z-index: 2;
    background: rgb(16 19 16 / 72%);
  }

  @media print {
    .system-background { display: none; }
  }
</style>
