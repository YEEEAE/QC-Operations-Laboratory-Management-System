---
/**
 * Visible, keyboard-focusable error summary for server-rendered mutation
 * forms (F-04). Rendered only after a failed POST so `autofocus` moves
 * keyboard and assistive-technology focus straight to the problem.
 * Recovery always names a next step and links back to the safe list.
 */
interface Props {
  summary: string;
  recovery?: string | null;
  listHref: string;
  listLabel: string;
}
const { summary, recovery = null, listHref, listLabel } = Astro.props;
---
<section
  class="form-error"
  role="alert"
  tabindex="-1"
  autofocus
  data-error-summary
  aria-labelledby="form-error-title"
>
  <h2 id="form-error-title">There is a problem</h2>
  <p class="summary">{summary}</p>
  {recovery && <p class="recovery">{recovery}</p>}
  <p class="back"><a href={listHref}>Back to {listLabel}</a></p>
</section>
<style>
  .form-error {
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--color-border-subtle);
    border-inline-start: 3px solid var(--status-danger);
    border-radius: var(--radius-lg);
  }
  .form-error:focus {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }
  .form-error h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .form-error p {
    margin: 0.25rem 0;
    color: var(--text-secondary);
    font-size: 0.85rem;
  }
  .form-error .summary {
    color: var(--text-primary);
    font-weight: 600;
  }
  .form-error a {
    color: var(--color-accent-primary-hover);
  }
</style>
