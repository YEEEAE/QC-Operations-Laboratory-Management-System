---
interface Props { id: string; label: string; name?: string; value?: string; min?: string; max?: string; description?: string; error?: string; required?: boolean; disabled?: boolean; }
const { id, label, name = id, value, min, max, description, error, required = false, disabled = false } = Astro.props;
const describedBy = [description && `${id}-description`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
---
<div class="form-field"><label for={id}>{label}{required ? <span aria-hidden="true"> *</span> : null}{required ? <span class="sr-only"> (required)</span> : null}</label>{description ? <p id={`${id}-description`} class="field-description">{description}</p> : null}<input id={id} name={name} type="date" value={value} min={min} max={max} required={required} disabled={disabled} aria-invalid={error ? 'true' : undefined} aria-describedby={describedBy} />{error ? <p id={`${id}-error`} class="field-error" role="alert">{error}</p> : null}</div>
<style>@import url('../form-control.css');</style>
