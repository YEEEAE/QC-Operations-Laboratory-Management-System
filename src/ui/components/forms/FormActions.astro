---
interface Props { draftLabel?: string; submitLabel?: string; controlledLabel?: string; showControlled?: boolean; disabled?: boolean; }
const { draftLabel = 'Save Draft', submitLabel = 'Submit', controlledLabel = 'Continue to controlled action', showControlled = false, disabled = false } = Astro.props;
---
<footer class="form-actions"><button type="submit" name="intent" value="save-draft" disabled={disabled} class="action action--secondary">{draftLabel}</button>{showControlled ? <button type="submit" name="intent" value="controlled-action" disabled={disabled} class="action action--controlled" data-controlled-action="true">{controlledLabel}</button> : <button type="submit" name="intent" value="submit" disabled={disabled} class="action action--primary">{submitLabel}</button>}</footer>
<style>.form-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: flex-end; padding-block: var(--space-4); border-block-start: 1px solid var(--color-border-subtle); }.action { min-height: var(--control-height); padding-inline: var(--space-4); border: 1px solid transparent; border-radius: var(--radius-sm); font-weight: 600; }.action--primary { background: var(--color-accent-primary); color: var(--color-text-inverse); }.action--secondary { background: var(--surface-raised); border-color: var(--border-default); }.action--controlled { background: var(--status-review-bg); border-color: var(--status-review); color: var(--text-primary); }</style>
