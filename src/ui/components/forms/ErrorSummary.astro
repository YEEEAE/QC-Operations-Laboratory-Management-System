---
interface FieldError { id: string; message: string; }
interface Props { errors: FieldError[]; title?: string; }
const { errors, title = 'Please review the highlighted fields.' } = Astro.props;
---
{errors.length ? <div class="error-summary" role="alert" tabindex="-1"><h2>{title}</h2><ul>{errors.map((error) => <li><a href={`#${error.id}`}>{error.message}</a></li>)}</ul></div> : null}
<style>.error-summary { padding: var(--space-4); background: var(--status-danger-bg); border: 1px solid var(--status-danger); border-radius: var(--radius-sm); color: var(--text-primary); }.error-summary h2 { margin: 0 0 var(--space-2); font-size: 1rem; }.error-summary ul { margin: 0; padding-inline-start: var(--space-6); }.error-summary a { color: var(--text-primary); }</style>
