---
import ControlledScalar from './ControlledScalar.astro';
import type { ControlledForm, ControlledFormValues } from '../../../modules/quarantine/inspection/application/save-controlled-form.js';
interface Props { schema:ControlledForm; values:ControlledFormValues; receiving:Record<string,unknown>; editable:boolean; canSubmit:boolean; inspectionId:string; version:string; error?:string; addedRow?:string }
const {schema,values,receiving,editable,canSubmit,inspectionId,version,error,addedRow}=Astro.props;
const labels={PASS:'Acceptable',FAIL:'Not acceptable',REMARK:'Read remarks',NA:'Not applicable'};
const display=(v:unknown)=>v instanceof Date ? v.toISOString().slice(0,10) : String(v ?? 'Not recorded');
---
<form method="post" class="controlled-form" data-controlled-form data-inspection-id={inspectionId} data-version={version}>
<input type="hidden" name="expectedVersion" value={version} />
<section><h2>{schema.docCode} · {schema.sourceTitle}</h2><p>Report Rev {schema.reportRevision} · source date {schema.sourceDate ?? 'Not recorded'}</p>
{error && <p role="alert" tabindex="-1">{error} Your entries are retained; check the current record and history before retrying.</p>}
<div class="headers">{schema.headerFields.map(field => field.receivingKey ? <div><strong>{field.label}</strong><p>{display(receiving[field.receivingKey])}</p></div> : <ControlledScalar field={field} id={`header-${field.key}`} name={`header:${field.key}`} value={values.headers[field.key]} disabled={!editable} />)}</div>
</section>
{schema.sections.map(section => <section><h2>{section.title}</h2>{section.points.map(point => {
const entry=values.points[point.key] ?? {}; const rows=entry.rows ?? [];
const visibleRows=Array.from({length: Math.max(1,rows.length)+(addedRow===point.key ? 1 : 0)},(_,i)=>rows[i] ?? {});
return <fieldset><legend>{point.label}{point.required ? ' *' : ''}</legend><p>{point.requirementText}</p>{schema.criticalInspectionColumn && <p>Critical Inspection Points: {point.criticalInspectionPoint===null ? 'Not designated in source' : point.criticalInspectionPoint ? 'Critical' : 'Not critical'}</p>}{point.criticalInspectionPoint===true && <p>Critical inspection point</p>}{point.equipmentReference && <p>Equipment: {point.equipmentReference}</p>}{point.accuracyText && <p>Accuracy: {point.accuracyText}</p>}
{point.dataType==='TABLE' ? <div class="table-wrap"><table><caption>{point.label}</caption><thead><tr>{point.columns?.map(c => <th scope="col">{c.label}{c.unit ? ` (${c.unit})` : ''}</th>)}</tr></thead><tbody>{visibleRows.map((row,index)=><tr>{point.columns?.map(c => <td><ControlledScalar field={c} id={`row-${point.key}-${index}-${c.key}`} name={`row:${point.key}:${index}:${c.key}`} value={row[c.key]} disabled={!editable}/></td>)}</tr>)}</tbody></table>{editable && <button type="submit" name="addRow" value={point.key} formnovalidate>Add row to {point.label}</button>}</div> : !['PASS_FAIL_NA','READ_ONLY_SPECIFICATION'].includes(point.dataType) && <ControlledScalar field={point} id={`value-${point.key}`} name={`point:${point.key}:value`} value={entry.value} disabled={!editable}/>}
{!['TABLE','READ_ONLY_SPECIFICATION'].includes(point.dataType) && <div class="headers"><ControlledScalar field={{label:'Sample Level',dataType:'TEXT'}} id={`level-${point.key}`} name={`point:${point.key}:sampleLevel`} value={entry.sampleLevel} disabled={!editable}/><ControlledScalar field={{label:'Sample Size',dataType:'INTEGER'}} id={`size-${point.key}`} name={`point:${point.key}:sampleSize`} value={entry.sampleSize} disabled={!editable}/></div>}
{point.resultRequired && <label for={`result-${point.key}`}>Result<select id={`result-${point.key}`} name={`point:${point.key}:result`} disabled={!editable}><option value="">Choose…</option>{Object.entries(labels).map(([code,label]) => <option value={code} selected={entry.result===code}>{label}</option>)}</select></label>}
{point.remarksAllowed && <label for={`remarks-${point.key}`}>Remarks<textarea id={`remarks-${point.key}`} name={`point:${point.key}:remarks`} maxlength="2000" disabled={!editable}>{entry.remarks ?? ''}</textarea></label>}
</fieldset>;
})}</section>)}
<section><h2>General remarks and disposition</h2><label for="generalRemarks">General remarks<textarea id="generalRemarks" name="generalRemarks" maxlength="4000" disabled={!editable}>{values.generalRemarks ?? ''}</textarea></label><label for="disposition">Inspector disposition<select id="disposition" name="disposition" disabled={!editable}><option value="">Choose…</option>{schema.finalDisposition.map(value => <option value={value} selected={values.disposition===value}>{value}</option>)}</select></label><p>Disposition is recorded for review. Scientific acceptance and Receiving release follow their controlled approvals.</p><p>AQL / sampling fields: {schema.aqlFields.join(', ')}. Record sampling and eligible equipment links on the inspection record before submission.</p><p>Review responsibilities: {schema.reviewResponsibilities.join(' · ')}</p><a href={`/quarantine/inspections/${inspectionId}`}>Open evidence, AQL and equipment links</a>
{editable && <div class="actions"><button type="submit" name="intent" value="save">Save digital form</button>{canSubmit && <button type="submit" name="intent" value="submit" formnovalidate>Submit saved form for review</button>}</div>}
<p role="status" data-result tabindex="-1"></p>
</section>
</form>
<style>.controlled-form{display:grid;gap:1.2rem}section{padding:1.3rem;background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.headers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}fieldset{margin:1rem 0;padding:1rem;border:1px solid var(--color-border-subtle)}legend{font-weight:700}label{display:grid;gap:.4rem;margin:.7rem 0}input,textarea,select{min-height:2.5rem;padding:.6rem;background:var(--surface-raised);color:inherit;border:1px solid var(--border-default);font:inherit}textarea{min-height:4rem}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%}td,th{padding:.4rem;min-width:9rem;vertical-align:top;text-align:start}.actions{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem}button{padding:.7rem;min-height:2.75rem;border:1px solid var(--color-accent-primary);background:var(--color-accent-primary);color:white;border-radius:var(--radius-sm)}[role=alert]{color:var(--status-danger)}@media(max-width:600px){.headers{grid-template-columns:1fr}section{padding:.8rem}}</style>
