---
interface Item { label: string; color: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<ul class="legend" aria-label="Chart legend">{items.map(item => <li><span style={`--legend-color:${item.color}`} aria-hidden="true"></span>{item.label}</li>)}</ul><style>.legend{display:flex;flex-wrap:wrap;gap:var(--space-3);list-style:none;margin:var(--space-3) 0 0;padding:0;color:var(--text-secondary);font-size:var(--font-size-xs)}.legend li{display:flex;align-items:center;gap:var(--space-1)}.legend span{width:var(--space-2);height:var(--space-2);border-radius:var(--radius-sm);background:var(--legend-color)}</style>
