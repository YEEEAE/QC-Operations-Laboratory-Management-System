---
interface Point { label: string; value: number; }
interface Props { title: string; summary: string; points: Point[]; unit?: string; sourceHref?: string; sourceLabel?: string; meta?: Array<{ label: string; value: string }>; }
const { title, summary, points, unit = '', sourceHref, sourceLabel = 'Open data', meta = [] } = Astro.props;
const max = Math.max(...points.map((p) => p.value), 1);
const width = 640;
const height = 240;
const left = 40;
const right = 20;
const top = 20;
const baseline = 194;
const step = points.length > 1 ? (width - left - right) / (points.length - 1) : 0;
const x = (index: number) => left + index * step;
const y = (value: number) => baseline - (value / max) * (baseline - top);
const coords = points
  .map((p, i) => `${x(i)},${y(p.value)}`)
  .join(' ');
---
<figure class="chart">
  <div class="chart-head">
    <div>
      <h2>{title}</h2>
      <p>{summary}</p>
    </div>
    {sourceHref && <a href={sourceHref}>{sourceLabel}</a>}
  </div>
  {
    meta.length > 0 && (
      <dl class="chart-meta">
        {meta.map((entry) => (
          <div>
            <dt>{entry.label}</dt>
            <dd>{entry.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  <svg
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={`${title}: ${summary}`}
    focusable="false"
  >
    <line x1={left} y1={baseline} x2={width - right} y2={baseline} stroke="var(--color-border-strong)" stroke-width="1" />
    <line x1={left} y1={y(max)} x2={width - right} y2={y(max)} stroke="var(--color-border-subtle)" stroke-width="1" stroke-dasharray="4 6" />
    <text x="8" y={baseline + 4} fill="var(--text-secondary)" font-size="12">0</text>
    <text x="8" y={y(max) + 4} fill="var(--text-secondary)" font-size="12">{max}</text>
    <polyline
      points={coords}
      fill="none"
      stroke="var(--color-accent-primary)"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    {
      points.map((point, i) => (
        <circle
          cx={x(i)}
          cy={y(point.value)}
          r="4"
          fill="var(--color-accent-primary)"
        ><title>{point.label}: {point.value} {unit}</title></circle>
      ))
    }
    {points.length > 1 && <><text x={left} y="225" fill="var(--text-secondary)" font-size="12">{points[0].label}</text><text x={width - right} y="225" fill="var(--text-secondary)" text-anchor="end" font-size="12">{points[points.length - 1].label}</text></>}
  </svg>
  <table class="data-alt">
    <caption>Accessible data for {title}</caption>
    <thead>
      <tr>
        <th scope="col">Period</th>
        <th scope="col">Value</th>
      </tr>
    </thead>
    <tbody>
      {
        points.map((point) => (
          <tr>
            <th scope="row">{point.label}</th>
            <td>
              {point.value}
              {unit}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>
<style>
  .chart {
    margin: 0;
    padding: var(--space-5);
    background: var(--surface-panel);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }
  .chart-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .chart h2 {
    margin: 0;
    color: var(--text-primary);
    font-size: 15px;
  }
  .chart p {
    margin: 6px 0;
    color: var(--text-muted);
    font-size: 12px;
  }
  .chart-head a {
    color: var(--color-accent-primary-hover);
    font-size: 12px;
  }
  .chart-meta {
    display: grid;
    gap: 2px;
    margin: 8px 0 0;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.45;
  }
  .chart-meta div {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 8px;
  }
  .chart-meta dt {
    font-weight: 700;
    color: var(--text-secondary);
  }
  .chart-meta dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .chart svg {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 16px;
    background: var(--surface-panel);
  }
  .data-alt {
    width: 100%;
    margin-top: 12px;
    border-collapse: collapse;
    /* 12px readable floor for the accessible data table under the chart. */
    font-size: var(--font-size-xs);
  }
  .data-alt caption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .data-alt th,
  .data-alt td {
    padding: 6px 8px;
    border-block-end: 1px solid var(--color-border-subtle);
    text-align: start;
  }
  .data-alt th {
    color: var(--text-secondary);
  }
  .data-alt td {
    text-align: end;
    color: var(--text-primary);
  }
</style>
<style>
  .chart { border-radius: var(--card-radius); }
  .chart-head { gap: var(--space-4); }
  .chart h2 { font-size: var(--font-size-md); }
  .chart p, .chart-head a { font-size: var(--font-size-xs); }
  .chart-meta, .chart-meta dt, .chart-meta dd { font-size: var(--font-size-xs); }
  .chart svg { margin-top: var(--space-4); }
  .data-alt { margin-top: var(--space-3); font-size: var(--font-size-xs); }
  .data-alt th, .data-alt td { padding: var(--space-2) var(--space-2); }
</style>
