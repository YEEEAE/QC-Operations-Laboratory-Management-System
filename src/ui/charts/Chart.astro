---
interface Point { label: string; value: number; }
interface Props { title: string; summary: string; points: Point[]; unit?: string; sourceHref?: string; }
const { title, summary, points, unit = '', sourceHref } = Astro.props;
const max = Math.max(...points.map(p => p.value), 1); const width = 640; const height = 220; const step = points.length > 1 ? width / (points.length - 1) : width; const coords = points.map((p, i) => `${i * step},${height - (p.value / max) * 170 - 20}`).join(' ');
---
<figure class="chart"><div class="chart-head"><div><h2>{title}</h2><p>{summary}</p></div>{sourceHref && <a href={sourceHref}>Open data</a>}</div><svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${title}: ${summary}`} focusable="false"><polyline points={coords} fill="none" stroke="var(--color-accent-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />{points.map((point, i) => <circle cx={i * step} cy={height - (point.value / max) * 170 - 20} r="5" fill="var(--color-accent-primary)" />)}</svg><table class="data-alt"><caption>Accessible data for {title}</caption><thead><tr><th scope="col">Period</th><th scope="col">Value</th></tr></thead><tbody>{points.map(point => <tr><th scope="row">{point.label}</th><td>{point.value}{unit}</td></tr>)}</tbody></table></figure>
<style>.chart{margin:0;padding:var(--space-5);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-lg)}.chart-head{display:flex;justify-content:space-between;gap:16px}.chart h2{margin:0;color:var(--text-primary);font-size:15px}.chart p{margin:6px 0;color:var(--text-muted);font-size:12px}.chart-head a{color:var(--color-accent-primary-hover);font-size:12px}.chart svg{display:block;width:100%;height:auto;margin-top:16px;background:linear-gradient(to bottom,transparent 49%,var(--color-border-subtle) 50%,transparent 51%)}.data-alt{width:100%;margin-top:12px;border-collapse:collapse;font-size:11px}.data-alt caption{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.data-alt th,.data-alt td{padding:6px 8px;border-block-end:1px solid var(--color-border-subtle);text-align:start}.data-alt th{color:var(--text-secondary)}.data-alt td{text-align:end;color:var(--text-primary)}
</style>
