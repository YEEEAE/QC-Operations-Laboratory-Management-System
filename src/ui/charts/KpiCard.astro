---
interface Props {
  label: string;
  value: string | number;
  unit?: string;
  definition: string;
  source?: string;
  timeRange?: string;
  href?: string;
  drilldownLabel?: string;
  freshness?: string;
  tone?: 'neutral' | 'warning' | 'danger' | 'success';
}
import Icon from '../components/Icon.astro';
const {
  label,
  value,
  unit = 'records',
  definition,
  source,
  timeRange = 'current snapshot',
  href,
  drilldownLabel = 'View records',
  freshness,
  tone = 'neutral',
} = Astro.props;
---
<article class={'kpi kpi-' + tone}>
  <div class="kpi-label"><span>{label}</span><details class="definition"><summary aria-label={'Show definition for ' + label}>i</summary><p>{definition}</p></details></div>
  <div class="kpi-value"><strong>{value}</strong><span>{unit}</span></div>
  <dl class="kpi-context">
    {source && <><dt>Source</dt><dd>{source}</dd></>}
    <dt>Window</dt><dd>{timeRange}</dd>
  </dl>
  {freshness && <small>Updated {freshness}</small>}
  {href && <a href={href}>{drilldownLabel} <Icon name="arrow-right" /></a>}
</article>
<style>
  .kpi{display:grid;gap:var(--space-2);padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md);border-inline-start:3px solid var(--color-border-default)}
  .kpi-label{display:flex;align-items:center;justify-content:space-between;gap:7px;color:var(--text-secondary);font-size:12px;font-weight:600}
  .kpi-value{display:flex;align-items:baseline;gap:var(--space-2)}
  .kpi strong{color:var(--text-primary);font-size:28px;line-height:1;font-variant-numeric:tabular-nums}
  .kpi-value span,.kpi-context{color:var(--text-muted);font-size:10px}
  .kpi-context{display:grid;grid-template-columns:auto 1fr;gap:2px var(--space-2);margin:var(--space-1) 0 0;line-height:1.35}
  .kpi-context dt{font-weight:700;text-transform:uppercase;letter-spacing:.05em}
  .kpi-context dd{margin:0;min-width:0;overflow-wrap:anywhere}
  .kpi small{color:var(--text-muted);font-size:10px}
  .kpi a{display:inline-flex;align-items:center;gap:4px;color:var(--color-accent-primary-hover);font-size:11px;font-weight:600;text-decoration:none}
  .definition{position:relative;flex:none}.definition summary{display:grid;place-items:center;width:17px;height:17px;border:1px solid var(--color-border-strong);border-radius:50%;color:var(--text-secondary);font-size:10px;cursor:pointer;list-style:none}.definition summary::-webkit-details-marker{display:none}.definition p{position:absolute;z-index:2;inset-inline-end:0;top:calc(100% + var(--space-2));width:min(260px,70vw);margin:0;padding:var(--space-3);background:var(--surface-raised);border:1px solid var(--color-border-strong);border-radius:var(--radius-sm);color:var(--text-primary);font-size:11px;font-weight:400;line-height:1.45;box-shadow:var(--shadow-2)}
  .kpi-warning{border-inline-start-color:var(--status-warning)}.kpi-danger{border-inline-start-color:var(--status-danger)}.kpi-success{border-inline-start-color:var(--status-approved)}
</style>
