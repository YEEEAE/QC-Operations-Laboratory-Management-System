---
interface Props { label: string; value: string | number; definition: string; href?: string; freshness?: string; tone?: 'neutral' | 'warning' | 'danger' | 'success'; }
const { label, value, definition, href, freshness, tone = 'neutral' } = Astro.props;
---
<article class={`kpi kpi-${tone}`}><div class="kpi-label">{label}<span class="info" title={definition} aria-label={definition}>i</span></div><strong>{value}</strong>{freshness && <small>Updated {freshness}</small>}{href && <a href={href}>View records <span aria-hidden="true">→</span></a>}</article><style>.kpi{display:grid;gap:7px;padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md);border-inline-start:3px solid var(--color-border-default)}.kpi-label{display:flex;align-items:center;gap:7px;color:var(--text-secondary);font-size:12px}.kpi strong{color:var(--text-primary);font-size:28px;line-height:1;font-variant-numeric:tabular-nums}.kpi small{color:var(--text-muted);font-size:10px}.kpi a{color:var(--color-accent-primary-hover);font-size:11px;text-decoration:none}.info{display:inline-grid;place-items:center;width:15px;height:15px;border:1px solid var(--color-border-strong);border-radius:50%;font-size:10px}.kpi-warning{border-inline-start-color:var(--status-warning)}.kpi-danger{border-inline-start-color:var(--status-danger)}.kpi-success{border-inline-start-color:var(--status-approved)}</style>
