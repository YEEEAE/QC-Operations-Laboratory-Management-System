---
interface Props {
  label: string;
  value: string | number;
  unit?: string;
  definition: string;
  source?: string;
  timeRange?: string;
  /** Exact numerator, state and actor scope behind the number (audit §8). */
  numerator?: string;
  state?: string;
  actorScope?: string;
  href?: string;
  drilldownLabel?: string;
  freshness?: string;
  tone?: 'neutral' | 'warning' | 'danger' | 'success';
}
import Icon from '../components/Icon.astro';
const {
  label,
  value,
  unit = 'records',
  definition,
  source,
  timeRange = 'current snapshot',
  numerator,
  state,
  actorScope,
  href,
  drilldownLabel = 'View records',
  freshness,
  tone = 'neutral',
} = Astro.props;
---
<article class={'kpi kpi-' + tone}>
  <div class="kpi-label">
    <span>{label}</span>
    <details class="definition">
      <summary aria-label={'Show definition for ' + label}><span aria-hidden="true">i</span></summary>
      <p>
        {definition}
        {
          (numerator || state || actorScope) && (
            <span class="definition-meta">
              {numerator && <span><strong>Counts:</strong> {numerator}</span>}
              {state && <span><strong>Condition:</strong> {state}</span>}
              {actorScope && <span><strong>Scope:</strong> {actorScope}</span>}
              <span><strong>Window:</strong> {timeRange}</span>
            </span>
          )
        }
      </p>
    </details>
  </div>
  <div class="kpi-value"><strong>{value}</strong><span>{unit}</span></div>
  <dl class="kpi-context">
    {source && <><dt>Source</dt><dd>{source}</dd></>}
    {actorScope && <><dt>Scope</dt><dd>{actorScope}</dd></>}
  </dl>
  {freshness && <small>Updated {freshness}</small>}
  {href && <a href={href}>{drilldownLabel} <Icon name="arrow-right" /></a>}
</article>
<style>
  .kpi{display:grid;gap:var(--space-2);padding:var(--space-4);background:var(--surface-panel);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md);border-inline-start:3px solid var(--color-border-default)}
  .kpi-label{display:flex;align-items:center;justify-content:space-between;gap:7px;color:var(--text-secondary);font-size:var(--font-size-xs);font-weight:600}
  .kpi-value{display:flex;align-items:baseline;gap:var(--space-2)}
  .kpi strong{color:var(--text-primary);font-size:28px;line-height:1;font-variant-numeric:tabular-nums}
  .kpi-value span,.kpi-context{color:var(--text-muted);font-size:var(--font-size-xs)}
  .kpi-context{display:grid;grid-template-columns:auto 1fr;gap:2px var(--space-2);margin:var(--space-1) 0 0;line-height:1.4}
  .kpi-context dt{font-weight:700}
  .kpi-context dd{margin:0;min-width:0;overflow-wrap:anywhere}
  .kpi small{color:var(--text-muted);font-size:var(--font-size-xs)}
  .kpi a{display:inline-flex;align-items:center;gap:4px;min-block-size:44px;color:var(--color-accent-primary-hover);font-size:var(--font-size-xs);font-weight:600;text-decoration:none}
  /* 44x44 hit area for the definition disclosure (WCAG 2.2 AA 2.5.8 and the
     project 44px target standard) while the visible ring stays compact. */
  .definition{position:relative;flex:none}
  .definition summary{position:relative;display:grid;place-items:center;inline-size:44px;block-size:44px;margin-block:-8px;padding:0;border:0;background:none;color:var(--text-secondary);cursor:pointer;list-style:none}
  .definition summary::-webkit-details-marker{display:none}
  .definition summary::before{content:'';position:absolute;inline-size:22px;block-size:22px;border:1px solid var(--color-border-strong);border-radius:50%}
  .definition summary span{position:relative;font-size:var(--font-size-xs);font-weight:700;line-height:1}
  .definition p{position:absolute;z-index:2;inset-inline-end:0;top:calc(100% + var(--space-2));display:grid;gap:var(--space-2);width:min(280px,70vw);margin:0;padding:var(--space-3);background:var(--surface-raised);border:1px solid var(--color-border-strong);border-radius:var(--radius-sm);color:var(--text-primary);font-size:var(--font-size-xs);font-weight:400;line-height:1.45;box-shadow:var(--shadow-2)}
  .definition-meta{display:grid;gap:2px;color:var(--text-muted)}
  .definition-meta strong{color:var(--text-secondary)}
  .kpi-warning{border-inline-start-color:var(--status-warning)}.kpi-danger{border-inline-start-color:var(--status-danger)}.kpi-success{border-inline-start-color:var(--status-approved)}
</style>
