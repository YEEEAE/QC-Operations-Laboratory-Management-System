---
import { visibleNavigation, visibleNavigationUtilities } from '../navigation/navigation';
import Icon from '../components/Icon.astro';
import type { ActorContext } from '../../shared/authorization/types';

interface Props {
  actor?: ActorContext;
  activePath?: string;
  collapsed?: boolean;
}

const { actor, activePath = Astro.url.pathname, collapsed = false } = Astro.props;
const groups = visibleNavigation(actor);
const utilities = visibleNavigationUtilities(actor);
const isCurrent = (href: string) => activePath === href || activePath.startsWith(`${href}/`);
const hasCurrentDescendant = (items: Array<{ href: string }>) => items.some((item) => isCurrent(item.href));
---

<nav class="sidebar" data-collapsed={collapsed} aria-label="Primary navigation">
  <div class="brand">
    <span class="brand-mark" aria-hidden="true">QC</span>
    <span class="brand-name">QC Operations</span>
  </div>
  <button
    class="collapse-button"
    type="button"
    data-sidebar-toggle
    aria-label="Collapse navigation"
    aria-expanded={!collapsed}
    aria-controls="primary-navigation-list"
  ><Icon name="chevron-left" /></button>
  <button class="drawer-close" type="button" data-drawer-close aria-label="Close navigation">
    <Icon name="close" />
  </button>

  <ul class="nav-groups" id="primary-navigation-list">
    {groups.map((group) => {
      const expanded = hasCurrentDescendant(group.items);
      const listId = `nav-items-${group.id}`;
      return (
        <li class="nav-group" data-nav-group={group.id} data-current-section={expanded ? 'true' : undefined}>
          <div class="nav-group-heading" data-collapsed-tip={group.label}>
            <Icon name={group.items[0]!.icon} />
            <span class="nav-group-name">{group.label}</span>
            <button
              type="button"
              class="nav-group-toggle"
              data-nav-section-toggle
              data-section-id={group.id}
              data-section-label={group.label}
              aria-expanded={expanded}
              aria-controls={listId}
              aria-label={`${expanded ? 'Collapse' : 'Expand'} ${group.label} section`}
            ><Icon name="chevron-down" /></button>
          </div>
          <ul class="nav-items" id={listId} hidden={!expanded}>
            {group.items.map((item) => {
              const current = isCurrent(item.href);
              return (
                <li>
                  <a
                    class:list={['nav-link', { active: current }]}
                    href={item.href}
                    title={item.label}
                    aria-label={item.label}
                    aria-current={current ? 'page' : undefined}
                    data-collapsed-tip={item.label}
                  >
                    <span class="nav-icon"><Icon name={item.icon} /></span>
                    <span class="nav-label">{item.label}</span>
                    {current && <span class="current-indicator">Current page</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </li>
      );
    })}
  </ul>

  {utilities.length > 0 && (
    <section class="nav-utilities" aria-labelledby="nav-utilities-label">
      <h2 id="nav-utilities-label">Workspace tools</h2>
      <ul>
        {utilities.map((item) => {
          const current = isCurrent(item.href);
          return (
            <li>
              <a
                class:list={['nav-link', { active: current }]}
                href={item.href}
                title={item.label}
                aria-label={item.label}
                aria-current={current ? 'page' : undefined}
                data-collapsed-tip={item.label}
              >
                <span class="nav-icon"><Icon name={item.icon} /></span>
                <span class="nav-label">{item.label}</span>
                {current && <span class="current-indicator">Current page</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</nav>

<style>
  .sidebar { position: sticky; top: 0; display: flex; flex-direction: column; gap: var(--space-3); min-height: 100vh; min-inline-size: 0; max-inline-size: 100%; padding: var(--space-5) var(--space-3); background: var(--color-sidebar); border-inline-end: 1px solid var(--color-border-subtle); }
  .brand { display: flex; align-items: center; gap: 10px; min-inline-size: 0; padding: 0 var(--space-2) var(--space-4); font-weight: 700; color: var(--text-primary); }
  .brand-mark { display: grid; place-items: center; width: 32px; height: 32px; flex: none; border-radius: 9px; background: var(--color-accent-primary); color: var(--color-text-inverse); font-size: var(--font-size-xs); letter-spacing: .06em; }
  .brand-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-inline-size: 0; }
  .collapse-button, .drawer-close { position: absolute; inset-block-start: 10px; inset-inline-end: 6px; display: grid; place-items: center; inline-size: 44px; min-inline-size: 44px; block-size: 44px; border: 1px solid transparent; border-radius: 8px; background: transparent; color: var(--text-muted); font-size: 20px; cursor: pointer; }
  .drawer-close { display: none; border-color: var(--border-default); background: var(--surface-raised); color: var(--text-primary); }
  .collapse-button:focus-visible, .drawer-close:focus-visible, .nav-group-toggle:focus-visible, .nav-link:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .nav-groups, .nav-items, .nav-utilities ul { list-style: none; margin: 0; padding: 0; }
  .nav-groups { display: flex; flex-direction: column; gap: 4px; min-inline-size: 0; }
  .nav-group { min-inline-size: 0; }
  .nav-group-heading { display: flex; align-items: center; gap: 9px; min-height: 44px; padding-inline: 10px 4px; border-radius: 8px; color: var(--text-primary); font-size: .8rem; font-weight: 700; }
  .nav-group-heading > :global(svg) { inline-size: 18px; flex: none; }
  .nav-group-name { flex: 1; min-inline-size: 0; overflow-wrap: anywhere; }
  .nav-group-toggle { display: grid; place-items: center; inline-size: 44px; min-inline-size: 44px; block-size: 44px; padding: 0; border: 0; border-radius: 8px; background: transparent; color: inherit; cursor: pointer; }
  .nav-group-toggle :global(svg) { transition: transform var(--motion-standard) ease; }
  .nav-group-toggle[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
  .nav-items { margin: 2px 0 7px; padding-inline-start: 22px; border-inline-start: 1px solid var(--color-border-subtle); }
  .nav-items[hidden] { display: none; }
  .nav-link { position: relative; display: flex; align-items: center; gap: 10px; min-inline-size: 0; min-block-size: 44px; margin-block: 2px; padding: 8px 10px; border-radius: 8px; color: var(--text-secondary); text-decoration: none; font-size: 13px; overflow-wrap: anywhere; }
  .nav-link:hover, .nav-link:focus-visible { background: var(--color-surface-hover); color: var(--text-primary); }
  .nav-link.active { background: var(--color-surface-selected); color: var(--text-primary); box-shadow: inset 3px 0 var(--color-accent-primary); text-decoration: underline; text-underline-offset: 3px; font-weight: 700; }
  [dir='rtl'] .nav-link.active { box-shadow: inset -3px 0 var(--color-accent-primary); }
  .nav-icon { display: grid; place-items: center; inline-size: 20px; flex: none; font-size: 14px; }
  .nav-label { min-inline-size: 0; }
  .current-indicator { margin-inline-start: auto; padding: 1px 5px; border: 1px solid currentColor; border-radius: 4px; font-size: 10px; line-height: 1.4; white-space: nowrap; }
  .nav-utilities { margin-block-start: auto; padding-block-start: var(--space-3); border-block-start: 1px solid var(--color-border-subtle); }
  .nav-utilities h2 { margin: 0 10px 4px; color: var(--text-muted); font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .nav-utilities .nav-link { min-block-size: 44px; }
  .sidebar[data-collapsed='true'] { inline-size: 70px; }
  .sidebar[data-collapsed='true'] .brand-name, .sidebar[data-collapsed='true'] .nav-group-name, .sidebar[data-collapsed='true'] .nav-utilities h2, .sidebar[data-collapsed='true'] .nav-label, .sidebar[data-collapsed='true'] .current-indicator { display: none; }
  .sidebar[data-collapsed='true'] .brand, .sidebar[data-collapsed='true'] .nav-group-heading { justify-content: center; padding-inline: 0; }
  .sidebar[data-collapsed='true'] .nav-group-toggle { position: absolute; inset-inline-start: 0; inline-size: 100%; opacity: 0; }
  .sidebar[data-collapsed='true'] .nav-group-heading { position: relative; }
  .sidebar[data-collapsed='true'] .nav-group-heading::after, .sidebar[data-collapsed='true'] .nav-link::after { position: absolute; inset-inline-start: calc(100% + 8px); inset-block-start: 50%; z-index: 30; padding: 6px 10px; transform: translateY(-50%); border: 1px solid var(--color-border-default); border-radius: 8px; background: var(--surface-popover); color: var(--text-primary); font-size: 12px; font-weight: 500; white-space: nowrap; opacity: 0; visibility: hidden; pointer-events: none; }
  .sidebar[data-collapsed='true'] .nav-group-heading::after { content: attr(data-collapsed-tip); }
  .sidebar[data-collapsed='true'] .nav-link::after { content: attr(data-collapsed-tip); }
  .sidebar[data-collapsed='true'] .nav-group-heading:hover::after, .sidebar[data-collapsed='true'] .nav-group-heading:focus-within::after, .sidebar[data-collapsed='true'] .nav-link:hover::after, .sidebar[data-collapsed='true'] .nav-link:focus-visible::after { opacity: 1; visibility: visible; }
  .sidebar[data-collapsed='true'] .nav-items { padding-inline-start: 0; border: 0; }
  .sidebar[data-collapsed='true'] .nav-link { justify-content: center; min-block-size: 44px; padding-inline: 0; }
  @media (max-width: 760px) {
    .sidebar { position: relative; min-height: 100%; overflow-y: auto; overscroll-behavior: contain; }
    .collapse-button { display: none; }
    .drawer-close { display: grid; }
    .brand { padding-inline-end: 48px; }
    .sidebar[data-collapsed='true'] { inline-size: auto; }
    .sidebar[data-collapsed='true'] .brand-name, .sidebar[data-collapsed='true'] .nav-group-name, .sidebar[data-collapsed='true'] .nav-label, .sidebar[data-collapsed='true'] .current-indicator { display: initial; }
    .sidebar[data-collapsed='true'] .nav-utilities h2 { display: block; }
    .sidebar[data-collapsed='true'] .nav-group-heading { justify-content: flex-start; padding-inline: 10px 4px; }
    .sidebar[data-collapsed='true'] .nav-group-toggle { position: static; inline-size: 44px; opacity: 1; }
    .sidebar[data-collapsed='true'] .nav-items { padding-inline-start: 22px; border-inline-start: 1px solid var(--color-border-subtle); }
    .sidebar[data-collapsed='true'] .nav-link { justify-content: flex-start; padding-inline: 10px; }
  }
  @media (forced-colors: active) { .nav-link.active { outline: 2px solid Highlight; outline-offset: 1px; } .nav-items { border-color: CanvasText; } .sidebar[data-collapsed='true'] .nav-group-heading::after, .sidebar[data-collapsed='true'] .nav-link::after { border-color: ButtonBorder; } }
  @media (prefers-reduced-motion: reduce) { .nav-group-toggle :global(svg) { transition: none; } }
</style>
