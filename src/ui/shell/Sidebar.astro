---
import { visibleNavigation } from '../navigation/navigation';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icon';
interface Props { capabilities?: string[]; activePath?: string; collapsed?: boolean; }
const { capabilities = [], activePath = Astro.url.pathname, collapsed = false } = Astro.props;
const groups = visibleNavigation(capabilities);
---
<nav class="sidebar" data-collapsed={collapsed} aria-label="Primary navigation">
  <div class="brand"><span class="brand-mark" aria-hidden="true">QC</span><span class="brand-name">QC Operations</span></div>
  <button class="collapse-button" type="button" data-sidebar-toggle aria-label="Collapse navigation" aria-expanded={!collapsed}><Icon name="chevron-left" /></button>
  <button class="drawer-close" type="button" data-drawer-close aria-label="Close navigation"><Icon name="close" /></button>
  <div class="nav-groups">
    {groups.map(group => <section class="nav-group" aria-labelledby={`nav-${group.id}`}>
      <h2 id={`nav-${group.id}`}>{group.label}</h2>
      <ul>{group.items.map(item => <li><a class:list={['nav-link', { active: activePath === item.href || activePath.startsWith(`${item.href}/`) }]} href={item.href} title={item.label} aria-label={item.label} data-collapsed-tip={item.label}><span class="nav-icon"><Icon name={item.icon as IconName} /></span><span class="nav-label">{item.label}</span></a></li>)}</ul>
    </section>)}
  </div>
</nav>
<style>
  .sidebar{position:sticky;top:0;min-height:100vh;min-inline-size:0;max-inline-size:100%;padding:var(--space-5) var(--space-3);background:var(--color-sidebar);border-inline-end:1px solid var(--color-border-subtle)} .brand{display:flex;align-items:center;gap:10px;min-inline-size:0;padding:0 var(--space-2) var(--space-6);font-weight:700;color:var(--text-primary)} .brand-mark{display:grid;place-items:center;width:32px;height:32px;flex:none;border-radius:9px;background:var(--color-accent-primary);color:var(--color-text-inverse);font-size:11px;letter-spacing:.06em}.brand-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-inline-size:0}.collapse-button{position:absolute;inset-block-start:14px;inset-inline-end:10px;display:grid;place-items:center;min-width:32px;min-height:32px;border:0;background:transparent;color:var(--text-muted);font-size:22px;cursor:pointer;border-radius:8px}.collapse-button:focus-visible,.drawer-close:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}.drawer-close{display:none;position:absolute;inset-block-start:14px;inset-inline-end:10px;place-items:center;min-width:40px;min-height:40px;border:1px solid var(--border-default);border-radius:8px;background:var(--surface-raised);color:var(--text-primary);cursor:pointer}.nav-group{margin-block-end:var(--space-5);min-inline-size:0} .nav-group h2{margin:0 10px 7px;color:var(--text-muted);font-size:10px;text-transform:uppercase;letter-spacing:.12em}.nav-group ul{list-style:none;margin:0;padding:0}.nav-group a{display:flex;align-items:center;gap:10px;min-inline-size:0;padding:9px 10px;border-radius:8px;color:var(--text-secondary);text-decoration:none;font-size:13px;overflow-wrap:anywhere}.nav-group a:hover,.nav-group a:focus-visible{background:var(--color-surface-hover);color:var(--text-primary)}.nav-group a.active{background:var(--color-surface-selected);color:var(--text-primary);box-shadow:inset 3px 0 var(--color-accent-primary)}[dir='rtl'] .nav-group a.active{box-shadow:inset -3px 0 var(--color-accent-primary)}.nav-label{min-inline-size:0;overflow:hidden;text-overflow:ellipsis}.nav-icon{display:grid;place-items:center;width:20px;flex:none;font-size:14px}.sidebar[data-collapsed=true]{width:70px}.sidebar[data-collapsed=true] .brand-name,.sidebar[data-collapsed=true] .nav-label,.sidebar[data-collapsed=true] .nav-group h2{display:none}.sidebar[data-collapsed=true] .brand{justify-content:center}.sidebar[data-collapsed=true] .nav-group a{justify-content:center;position:relative}.sidebar[data-collapsed=true] .nav-group a::after{content:attr(data-collapsed-tip);position:absolute;inset-inline-start:calc(100% + 10px);inset-block-start:50%;translate:0 -50%;padding:6px 10px;border:1px solid var(--color-border-default);border-radius:8px;background:var(--surface-popover);color:var(--text-primary);font-size:12px;white-space:nowrap;opacity:0;visibility:hidden;pointer-events:none;z-index:30}.sidebar[data-collapsed=true] .nav-group a:hover::after,.sidebar[data-collapsed=true] .nav-group a:focus-visible::after{opacity:1;visibility:visible}.sidebar[data-collapsed=true] .collapse-button{transform:rotate(180deg)} @media(max-width:760px){.sidebar{position:relative;min-height:auto}.nav-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-3)}.collapse-button{display:none}.drawer-close{display:grid}} @media(max-width:380px){.nav-groups{grid-template-columns:minmax(0,1fr)}}
  /* Active navigation keeps a non-color indicator (underline + weight) alongside the accent bar. */
  .nav-group a.active{text-decoration:underline;text-underline-offset:3px;font-weight:700}
  @media (forced-colors: active){
    .nav-group a.active{outline:2px solid Highlight;outline-offset:1px}
    .sidebar[data-collapsed=true] .nav-group a::after{border:1px solid ButtonBorder}
  }
</style>
