---
import Breadcrumbs from './Breadcrumbs.astro'; import ScopeIndicator from './ScopeIndicator.astro'; import UserMenu from './UserMenu.astro'; import Icon from '../components/Icon.astro';
interface Props { breadcrumbs?: Array<{ label: string; href?: string }>; userName?: string; userRole?: string; scope?: string; approvalCount?: number; notificationCount?: number; }
const { breadcrumbs = [], userName, userRole, scope } = Astro.props;
---
<div class="topbar"><div class="context"><button class="navigation-toggle" type="button" data-navigation-toggle aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="false"><Icon name="menu" /></button><Breadcrumbs items={breadcrumbs} /><ScopeIndicator label={scope} /></div><div class="top-actions"><UserMenu name={userName} role={userRole} /></div></div>
<style>.topbar{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);width:100%;min-width:0}.context{display:grid;gap:8px;min-width:0;min-inline-size:0}.navigation-toggle{display:none;align-items:center;justify-content:center;inline-size:44px;min-inline-size:44px;block-size:44px;min-block-size:44px;flex:none;padding:0;border:1px solid var(--border-default);border-radius:var(--radius-sm);background:var(--surface-raised);color:var(--text-primary);cursor:pointer}.navigation-toggle:focus-visible{outline:2px solid var(--color-accent-primary);outline-offset:2px}.top-actions{display:flex;align-items:center;gap:var(--space-3);min-width:0;min-inline-size:0;flex-wrap:wrap;justify-content:flex-end}.context :global(.scope){display:none}@media(min-width:1000px){.context :global(.scope){display:flex}}@media(max-width:760px){.topbar{align-items:flex-start}.context{display:flex;align-items:flex-start;flex:1}.navigation-toggle{display:inline-flex;visibility:visible}.user-copy{display:none}.top-actions{gap:10px;flex:0 1 auto}}
</style>
