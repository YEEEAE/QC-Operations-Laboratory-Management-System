---
import Breadcrumbs from './Breadcrumbs.astro'; import ScopeIndicator from './ScopeIndicator.astro'; import UserMenu from './UserMenu.astro';
interface Props { breadcrumbs?: Array<{ label: string; href?: string }>; userName?: string; userRole?: string; scope?: string; approvalCount?: number; }
const { breadcrumbs = [], userName, userRole, scope, approvalCount = 0 } = Astro.props;
---
<div class="topbar"><div class="context"><Breadcrumbs items={breadcrumbs} /><ScopeIndicator label={scope} /></div><div class="top-actions"><a class="search" href="/search" aria-label="Search (Control K)"><span aria-hidden="true">⌕</span><span>Search</span><kbd>⌘ K</kbd></a><a class="top-link" href="/notifications" aria-label={`${approvalCount} notifications`}><span aria-hidden="true">◌</span><span class="badge" aria-label={`${approvalCount} unread`}>{approvalCount}</span></a><a class="top-link" href="/approvals" aria-label="My approvals"><span aria-hidden="true">✓</span><span class="approvals-label">Approvals</span></a><UserMenu name={userName} role={userRole} /></div></div>
<style>.topbar{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);width:100%}.context{display:grid;gap:8px;min-width:0}.top-actions{display:flex;align-items:center;gap:var(--space-3)}.search{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--border-default);border-radius:8px;color:var(--text-secondary);text-decoration:none;font-size:12px}.search:hover{border-color:var(--color-border-strong);color:var(--text-primary)}kbd{padding:2px 5px;border:1px solid var(--color-border-strong);border-radius:4px;color:var(--text-muted);font-size:10px}.top-link{display:flex;align-items:center;gap:5px;color:var(--text-secondary);text-decoration:none;font-size:12px}.top-link:hover{color:var(--text-primary)}.badge{min-width:18px;padding:2px 5px;border-radius:10px;background:var(--status-danger-bg);color:var(--status-danger);text-align:center;font-size:10px}.context :global(.scope){display:none}@media(min-width:1000px){.context :global(.scope){display:flex}}@media(max-width:760px){.topbar{align-items:flex-start}.search span:nth-child(2),kbd,.approvals-label,.user-copy{display:none}.top-actions{gap:10px}}
</style>
