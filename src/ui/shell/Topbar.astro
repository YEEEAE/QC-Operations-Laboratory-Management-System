---
import Breadcrumbs from './Breadcrumbs.astro'; import ScopeIndicator from './ScopeIndicator.astro'; import UserMenu from './UserMenu.astro'; import Icon from '../components/Icon.astro';
interface Props { breadcrumbs?: Array<{ label: string; href?: string }>; userName?: string; userRole?: string; scope?: string; approvalCount?: number; notificationCount?: number; }
const { breadcrumbs = [], userName, userRole, scope, approvalCount, notificationCount } = Astro.props;
const approvalLabel = typeof approvalCount === 'number' ? `${approvalCount} pending approvals` : 'Pending approvals';
const notificationLabel = typeof notificationCount === 'number' ? `${notificationCount} unread notifications` : 'Notifications';
---
<div class="topbar"><div class="context"><button class="navigation-toggle" type="button" data-navigation-toggle aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="false"><Icon name="menu" /></button><Breadcrumbs items={breadcrumbs} /><ScopeIndicator label={scope} /></div><div class="top-actions"><a class="search" data-global-search href="/search" aria-label="Search authorized records (Control K)"><Icon name="search" /><span>Search</span><kbd>Ctrl K</kbd></a><a class="top-link" href="/notifications" aria-label={notificationLabel}><Icon name="notifications" />{typeof notificationCount === 'number' && <span class="badge" aria-label={`${notificationCount} unread`}>{notificationCount}</span>}</a><a class="top-link" href="/approvals" aria-label={approvalLabel}><Icon name="approvals" />{typeof approvalCount === 'number' && <span class="badge" aria-label={`${approvalCount} pending`}>{approvalCount}</span>}<span class="approvals-label">Approvals</span></a><UserMenu name={userName} role={userRole} /></div></div>
<style>.topbar{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);width:100%;min-width:0}.context{display:grid;gap:8px;min-width:0;min-inline-size:0}.navigation-toggle{display:none;align-items:center;justify-content:center;inline-size:40px;min-inline-size:40px;block-size:40px;min-block-size:40px;flex:none;padding:0;border:1px solid var(--border-default);border-radius:var(--radius-sm);background:var(--surface-raised);color:var(--text-primary);cursor:pointer}.navigation-toggle:focus-visible{outline:2px solid var(--color-accent-primary);outline-offset:2px}.top-actions{display:flex;align-items:center;gap:var(--space-3);min-width:0;min-inline-size:0;flex-wrap:wrap;justify-content:flex-end}.search{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--border-default);border-radius:8px;color:var(--text-secondary);text-decoration:none;font-size:12px;min-width:0;max-width:100%}.search:hover{border-color:var(--color-border-strong);color:var(--text-primary)}kbd{padding:2px 5px;border:1px solid var(--color-border-strong);border-radius:4px;color:var(--text-muted);font-size:10px}.top-link{display:flex;align-items:center;gap:5px;color:var(--text-secondary);text-decoration:none;font-size:12px;min-height:40px}.top-link:hover{color:var(--text-primary)}.badge{min-width:18px;padding:2px 5px;border-radius:10px;background:var(--status-danger-bg);color:var(--status-danger);text-align:center;font-size:10px}.context :global(.scope){display:none}@media(min-width:1000px){.context :global(.scope){display:flex}}@media(max-width:760px){.topbar{align-items:flex-start}.context{display:flex;align-items:flex-start;flex:1}.navigation-toggle{display:inline-flex;visibility:visible}.search span:nth-child(2),kbd,.approvals-label,.user-copy{display:none}.top-actions{gap:10px;flex:0 1 auto}}
</style>
