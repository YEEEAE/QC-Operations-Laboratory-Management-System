---
interface Props { items?: Array<{ label: string; href?: string }>; }
const { items = [] } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/dashboard">Home</a></li>{items.map(item => <li aria-current={!item.href ? 'page' : undefined}>{item.href ? <a href={item.href}>{item.label}</a> : item.label}</li>)}</ol></nav>
<style>.breadcrumbs ol{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:0;color:var(--text-muted);font-size:12px}.breadcrumbs li+li::before{content:'/' ;margin-inline-end:8px;color:var(--color-border-strong)}.breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover{color:var(--text-primary);text-decoration:underline}</style>
