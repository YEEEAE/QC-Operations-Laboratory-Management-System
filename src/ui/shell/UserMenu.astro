---
interface Props { name?: string; role?: string; }
const { name = 'Current user', role = 'Authenticated user' } = Astro.props;
import { actions } from 'astro:actions';
---
<details class="user-menu"><summary><span class="avatar" aria-hidden="true">{name.slice(0,1).toUpperCase()}</span><span class="user-copy"><strong>{name}</strong><small>{role}</small></span><span aria-hidden="true">⌄</span></summary><div class="menu-panel"><a href="/account">Account</a><a href="/account#sessions">Session information</a><form method="post" action={actions.server.logout}><button type="submit">Sign out</button></form></div></details>
<style>.user-menu{position:relative}.user-menu summary{display:flex;align-items:center;gap:8px;cursor:pointer;list-style:none}.user-menu summary::-webkit-details-marker{display:none}.avatar{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--color-accent-primary-muted);color:var(--text-primary);font-weight:700}.user-copy{display:grid;gap:2px}.user-copy strong{font-size:12px}.user-copy small{font-size:10px;color:var(--text-muted)}.menu-panel{position:absolute;z-index:5;inset-inline-end:0;inset-block-start:44px;min-width:180px;padding:6px;background:var(--surface-popover);border:1px solid var(--border-default);border-radius:var(--radius-md);box-shadow:var(--shadow-2)}.menu-panel a,.menu-panel button{display:block;width:100%;padding:9px 10px;border:0;background:transparent;color:var(--text-secondary);text-align:start;text-decoration:none;font:inherit;font-size:12px;border-radius:6px}.menu-panel a:hover,.menu-panel button:hover{background:var(--color-surface-hover);color:var(--text-primary)}</style>
