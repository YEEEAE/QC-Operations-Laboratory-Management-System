{
  "name": "qc-operations-laboratory-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "QC Operations & Laboratory Management System",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --reporter=default --reporter=json --outputFile=.ci-results/integration.json",
    "test:migrations": "vitest run tests/integration/database --reporter=default --reporter=json --outputFile=.ci-results/migrations.json",
    "test:concurrency": "vitest run tests/integration/concurrency --reporter=default --reporter=json --outputFile=.ci-results/concurrency.json",
    "test:security": "vitest run tests/unit/shared/security-headers.test.ts tests/integration/security tests/integration/ai-advisory tests/integration/http --reporter=default --reporter=json --outputFile=.ci-results/security.json",
    "test:architecture": "node scripts/architecture/check-boundaries.mjs",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "release:identity": "node scripts/release/release-id.mjs",
    "release:verify": "node scripts/release/verify-release.mjs --input dist/release-identity.json",
    "release:tech-debt:check": "node scripts/release/check-tech-debt.mjs",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:migrate:status": "tsx scripts/db/migration-status.ts",
    "db:migrate:check": "tsx scripts/db/check-migration-integrity.ts",
    "db:schema:check": "tsx scripts/db/check-schema-integrity.ts",
    "db:preflight": "tsx scripts/db/preflight.ts",
    "recovery:checklist": "tsx scripts/recovery/run-recovery-checklist.ts",
    "recovery:backup:daily": "tsx scripts/recovery/run-daily-backup.ts",
    "recovery:restore:monthly": "tsx scripts/recovery/run-monthly-restore-drill.ts",
    "db:seed:foundation": "tsx scripts/db/seed-foundation.ts",
    "db:seed:foundation:check": "tsx scripts/db/check-foundation-seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap/create-initial-admin.ts",
    "bootstrap:admin:check": "tsx scripts/bootstrap/check-initial-admin.ts",
    "access:grant-system-owner": "tsx scripts/access/grant-system-owner.ts",
    "verify:fixtures:seed": "tsx scripts/verification/seed-verification-fixtures.ts",
    "verify:fixtures:clean": "tsx scripts/verification/cleanup-verification-fixtures.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "8.3.4",
    "@opentelemetry/api": "1.9.1",
    "argon2": "0.44.0",
    "astro": "4.16.19",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.0",
    "ajv": "8.20.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  }
}
