# Variable names only. Values belong in the local secret manager or Render environment.
NODE_ENV=development
DATABASE_URL=
SESSION_SECRET=
SERVICE_VERSION=0.1.0
# Optional sanitized release evidence. Production verification remains UNVERIFIED
# until all six values are injected by the build/deployment system.
RELEASE_ID=
RELEASE_BUILD_ID=
RELEASE_BUILD_TIMESTAMP=
RELEASE_ENVIRONMENT=production
RELEASE_GIT_SHA=
RELEASE_MIGRATION_HEAD=
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW_SECONDS=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Optional backup artifact destination. Configure all four together outside source control.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Initial-admin bootstrap is an explicit one-time operator command. Put production
# values only in Render Environment Variables; never commit them. Remove both
# bootstrap variables after successful use, especially the password.
BOOTSTRAP_ADMIN_IDENTITY=
BOOTSTRAP_ADMIN_PASSWORD=
# Required because the current users schema requires a non-empty display name.
BOOTSTRAP_ADMIN_DISPLAY_NAME=
# Optional only when the operator needs an email identity attribute.
BOOTSTRAP_ADMIN_EMAIL=
# Prompt 13 / C-12 verification fixtures. Names only; values belong in the
# non-production secret manager for the verification run and are never committed.
# QC_VERIFY_BASE_URL points at the exact deployed candidate under test.
QC_VERIFY_BASE_URL=
QC_VERIFY_SYSTEM_OWNER_PASSWORD=
QC_VERIFY_SUPERVISOR_PASSWORD=
QC_VERIFY_MANAGER_PASSWORD=
QC_VERIFY_ADMIN_PASSWORD=
QC_VERIFY_EMPLOYEE_PASSWORD=
QC_VERIFY_LEAST_PASSWORD=
# Non-production guards for the disposable verify-* seed/cleanup scripts.
QC_SEED_ALLOW_NON_PRODUCTION=
QC_VERIFICATION_SEED_ALLOW=
QC_VERIFICATION_OPERATOR_IDENTITY=
