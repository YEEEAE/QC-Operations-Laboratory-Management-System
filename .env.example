# Variable names only. Values belong in the local secret manager or Render environment.
NODE_ENV=development
# Runtime profile is separate from Node's execution mode. Production is set explicitly in Render.
APP_ENVIRONMENT_PROFILE=development
DATABASE_URL=
STAGING_DATABASE_URL=
PILOT_DATABASE_URL=
STAGING_DATABASE_HOST=
PILOT_DATABASE_HOST=
PRODUCTION_DATABASE_HOST=
SESSION_SECRET=
SERVICE_VERSION=0.1.0
# Optional structured-log verbosity (fatal/error/warn/info/debug/trace/silent).
# Approved defaults and fail-closed rules: Documents/CONFIGURATION-REFERENCE.md.
LOG_LEVEL=info
# Both login rate-limit values are required together in production.
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW_SECONDS=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Optional backup artifact destination. Configure all four together outside source control.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional AI advisory providers. Values belong only in the server secret manager.
# Keep false until the external-processing decision has been approved.
AI_EXTERNAL_PROCESSING_APPROVED=false
# Optional server-only approved policy artifact JSON. Without a complete
# APPROVED policy source, provider credentials cannot enable external sending.
AI_PROCESSING_POLICY_JSON=
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=
# Pilot is disabled until approved; shadow mode remains required for all pilot release decisions.
PILOT_ENABLED=false
PILOT_SHADOW_MODE=true
PILOT_SCOPE_SITE=
PILOT_SCOPE_DEPARTMENT=
PILOT_SCOPE_LINE=
PILOT_SCOPE_SHIFT=
PILOT_REAL_MASTER_DATA_ENABLED=false
PILOT_MASTER_DATA_APPROVAL_REFERENCE=
STAGING_R2_ENDPOINT=
STAGING_R2_ACCESS_KEY_ID=
STAGING_R2_SECRET_ACCESS_KEY=
STAGING_R2_BUCKET=
PILOT_R2_ENDPOINT=
PILOT_R2_ACCESS_KEY_ID=
PILOT_R2_SECRET_ACCESS_KEY=
PILOT_R2_BUCKET=
# Optional signer registry for CI/security/database/E2E evidence intake.
# Configure only from an approved signer policy; absence keeps intake closed.
RELEASE_EVIDENCE_SIGNERS_JSON=
